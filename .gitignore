# Pristine game data, regenerated source, experiment outputs and releases.
# Glossary, UI data and translations under work/ are authored sources: keep them.
/work/*
!/work/glossary/
!/work/ui/
!/work/translation/
/incoming/*
/build/
/dist/
/release/
/releases/
/extracted/
*.iso
*.cpk
*.CPK
*.sdat
*.SDAT
*.bin
*.BIN
*.elf
*.self
*.unedat
*.gtf
*.xdelta
*.exe
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
/config/local.json

# Local configuration, imported references and raw texture sheets.
/config/tengoku.json
/work/ui/reference/
/work/glossary/reference/
/work/ui/textures/**/*.png
/work/ui/textures/*.png

# Source-bearing voice worksets; English-only voice_text exports are tracked.
/work/translation/en/voice/
/work/translation/en/voice_new/

# Recovery files, archives, credentials and game content.
*.bak-*
*.stackdump
*.tmp
*.zip
*.7z
*.rar
*.ISO
*.ELF
*.SELF
*.GTF
*.pkg
*.PKG
*.vpk
*.VPK
*.pup
*.PUP
*.USM
*.AWB
*.lua
*.ttf
*.TTF
.env
.env.*
*.pem
*.key
!.env.example

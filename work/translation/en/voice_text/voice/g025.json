  "lines": {
    "25:0": {
      "repository_source_sha256": "fa8dfe45d7837fac729e8d3529c1f9704bd2630e64c6a0b8d7237c602c904907",
      "en": "「I can fight even in this state.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:29": {
      "repository_source_sha256": "34ee3546270baf39440333a78cc029a7b57a0b0faec817a76b9c8190c1e71b75",
      "en": "「Shall I give it a try...?」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:48": {
      "repository_source_sha256": "7e58a3e32fc52eccd55b9e55bdc075e1ac9f1c51a59b32a1fc40ed9bd4117d7f",
      "en": "「You survived.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:65": {
      "repository_source_sha256": "2cb9530b100ee0429f39f2c2678422c1598856ff98d61a692f72dc05c9b17709",
      "en": "「Here, take it back.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:76": {
      "repository_source_sha256": "f8c88a6edda9cf8518ee0d93599b37b3e68e8d12770a7b3648ea2e635d3322df",
      "en": "「Don't die yet.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:93": {
      "repository_source_sha256": "5416d8bc0326b53b7cf6756c2ce4492451ffe4a5e7661563037e030d31609322",
      "en": "「Stand back.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:110": {
      "repository_source_sha256": "eeb97acbc2308b1a017ee38c22bab1189f2b11f00aad4cf742950133ce6a2f43",
      "en": "「Only natural in this state.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:133": {
      "repository_source_sha256": "51328fb014b9ff312511104f26a34f6be4d8786de4eed0188591f7d12f86b52b",
      "en": "「For now I just wait for my moment.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:156": {
      "repository_source_sha256": "09ea41b97bf8af4b47177bc85817e55478b8cbda4205d47cb77bedb7ce84dc6a",
      "en": "「You're weak.」",
      "source": "jigoku",
      "slots": [
        "evade",
        "hit: light damage"
      ]
    },
    "25:167": {
      "repository_source_sha256": "9ca6e772a56051fb2928272243967bf115c08e134986fc082ea9302b85403de6",
      "en": "「Did I misjudge you?」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:194": {
      "repository_source_sha256": "13568e4ed79e365ca1627935b44132503cd5d500ba76641634e5a33ab6004c96",
      "en": "「What a pointless thing to do.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:219": {
      "repository_source_sha256": "f7ceeb2c0967a336f2e0ff1c4be08d9fe709a32ef8aba88b5c4945ace502b9d4",
      "en": "「Is this all you've got?」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:244": {
      "repository_source_sha256": "2294f7f5441df8a8efe92af45885c4e63f10c0133d8c704127667a14bf568ea9",
      "en": "「Against me like this, this won't do.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:275": {
      "repository_source_sha256": "4afbaee241b3ef32ad76b1d2b1233df61774ea6bf07b352ef66ac4cf7f0c4aff",
      "en": "「Maybe my coming out is pointless.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:310": {
      "repository_source_sha256": "d2483383ad0fc51e2f44149a2cb521018a9c3dd73a1ff1f33c229834a0366689",
      "en": "「That's fine.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:325": {
      "repository_source_sha256": "e7b96a8c81a898f469a68cd932acd002d91004e49e3f238e580498c1efb47b44",
      "en": "「Almost there.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:340": {
      "repository_source_sha256": "08da5e3a1ee9769342da2fb57d7284e666079260ab19d29e6b6e7419bd1f1ea3",
      "en": "「Not a bad attack.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:359": {
      "repository_source_sha256": "1de458f3a2ccb0e2d02d5d70d6b8dc9fac0e97af8895206c928c2272c52a5d26",
      "en": "「Wait just a little longer.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:388": {
      "repository_source_sha256": "6c4cdec936bb37e8a24d03ababddb523c78e14ad9a4cdea185b8937526c5948f",
      "en": "「Power is taking shape within me.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:419": {
      "repository_source_sha256": "dc9cbf45d16c73c25f2915eaca366058274ea2a640ae3989770fc3fd603bff7c",
      "en": "「Now it's worth my coming out.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:452": {
      "repository_source_sha256": "da5d0bcbf731c51a3dd030bdb397dbf4f6474ce6486455323875795752f4fc06",
      "en": "「Strong foes give me power.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:485": {
      "repository_source_sha256": "1c670f37da6d71a39c21b00b6883441ae61d5875eaf39d8c2d6a8f0d6ab692c2",
      "en": "「Now I can expect something.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:514": {
      "repository_source_sha256": "21d827b974147b664fc9b745bd178a62b80f48de45b646be6c0ea0dd3eed3161",
      "en": "「The time has come.」",
      "source": "new",
      "slice": "v_g025_00"
    },
    "25:529": {
      "repository_source_sha256": "3ecc409be94986291ebd3992e0b2237b6018ff036acedced64dd7bba6816cd4f",
      "en": "「...Kept you waiting...」",
      "source": "new",
      "slice": "v_g025_00"
    }
  }
}

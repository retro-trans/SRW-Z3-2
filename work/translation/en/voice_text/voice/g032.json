{
  "schema": 1,
  "group": "g032",
  "blocks": [
    32
  ],
  "speaker": {
    "proposed_by_v_g032_00": {
      "token": "$$聖アドヴェント$$",
      "basis": "Calls himself an 御使い (Angel), guards the Black Sun, awaits the Spheres, mentions Supreme God rebirth and Es Terran, addresses Setsuko/Rand/Crowe as ones he will free from sorrow and pain; matches Holy Advent of the finale, not Jigoku (no identification)"
    },
    "proposed_by_v_g032_01": {
      "token": "$$アドヴェント#pilot$$",
      "basis": "Piloting Helios (ヘリオース named in line 32:3080), Advent's true form; calm, grandiose, addresses opponent as 君, sun/salvation/light themes. Jigoku had no identification"
    },
    "jigoku_token": null,
    "token": "聖アドヴェント",
    "basis": "settled 2026-10-02 from fresh-translation review: Calls himself an 御使い (Angel), guards the Black Sun, awaits the Spheres, mentions Supreme God rebirth and Es Terran, addresses Setsuko/Rand/Crowe as ones he will free from sorrow and pain; matches Holy Advent of the finale, not Jigoku (no identification)"
  },
  "lines": {
    "32:0": {
      "repository_source_sha256": "38dc94c8f68bbe608d507cdfc1af606f8eed26f78519b9f8702ef6207a13f3a6",
      "en": "「This is my true mission.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:27": {
      "repository_source_sha256": "18549bac36cbfd3ff2d446787423432e9ce51ee70a2fa54153db83f090a33258",
      "en": "「Take this as a trial from me.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:66": {
      "repository_source_sha256": "3653cdd8f90cb6717d7568216130cf374136003e84607b76f9dd7a893b1c8d20",
      "en": "「I will walk my own path.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:89": {
      "repository_source_sha256": "9c18092e07de171116991124dc1baa278680f948e36d624cdad946ecac35c5a0",
      "en": "「I will protect the $$黒い太陽#sol$$.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:114": {
      "repository_source_sha256": "cc4281f9cb41d95421f290853c93acf4d2dec42d882e08964eed45bd3be298c9",
      "en": "「This is our fate, yours and mine.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:141": {
      "repository_source_sha256": "4d98926d928f0ef9c90644fd1b78e67ef5e13e412edbbf643976bf78e1646569",
      "en": "「I will save this universe with joy.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:176": {
      "repository_source_sha256": "99ee93f793d066727a8deb88ff6b1a3c41c2f1067389fb4fb4258ddab4c975d2",
      "en": "「I will lead humanity's evolution.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:203": {
      "repository_source_sha256": "f826d27a1a2764a13bce45d06bed47b790e912168d54253d145ff16c26d9eec5",
      "en": "「I thought we could build a better\\nrelationship with you all...」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:264": {
      "repository_source_sha256": "e0bd81ca450f56a713bd5758dedf9e9c6dd6fef71b060c20b7f5bac49016dc11",
      "en": "「The trial I set is not over yet.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:301": {
      "repository_source_sha256": "3ae8cf7817fcac653148c9bbfbf58310852e6c2fb3e902418a1f54e76a68273d",
      "en": "「I never thought that'd beat you all.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:342": {
      "repository_source_sha256": "fe5348cb871a2c6701ef896988f9c4e11b9d4103a7debcef9ae36203f6fcd91f",
      "en": "「The light of your moon is beautiful.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:367": {
      "repository_source_sha256": "eeb8d3cfd6387d80905d69141a8bae9966849d3eb47671c66ec02eb476640c9b",
      "en": "「You or I... which of us is fit to\\nhold the sun high above?」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:426": {
      "repository_source_sha256": "d69e6b8bd5b661331936c3ab813c98de955ad1cf65bca0d2c205383d211ebefd",
      "en": "「Boy though you are, you have the\\ncaliber to stand above others.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:483": {
      "repository_source_sha256": "8b7f128f947124d3a78f38922cc22859ff3837b565dd7a67ffcea4cc854cd739",
      "en": "「That boyish sense of justice that\\nwon't tolerate evil is lovable.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:540": {
      "repository_source_sha256": "48b7acc0e75a53aa2bcc6b888cf54419dd9dd3bd5ca19457e7317a14bd8f42b4",
      "en": "「I honor you and your brother's love.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:575": {
      "repository_source_sha256": "261a08faa8bad119448ab30b2a2ade92f2bd112d863337d89c218d0a537271eb",
      "en": "「$$異能生存体$$.\\nYou don't have to fight anymore.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:626": {
      "repository_source_sha256": "743fd25a85301243af3c50bfbc3dbf6327cb802f8e84e8583411e452e48a0266",
      "en": "「You who are guided by a Gundam.\\nI welcome your evolution.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:679": {
      "repository_source_sha256": "951b358de2434897e5a188042f43153e0ef463fbbcad87964466f3435dd2d13c",
      "en": "「You have the potential to move\\nbeyond the civilization of fire.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:730": {
      "repository_source_sha256": "b927a36d73e739f7d60e9b7371fcd0ee7e35cfd475af64c074fdfb9e895445a0",
      "en": "「Understanding... Beautiful words.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:763": {
      "repository_source_sha256": "2a18938ee19da8e284d65901df01ef8242534f63e582f58718207bee14bfdf46",
      "en": "「Turning feelings into power...\\nThat is the civilization of fire.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:812": {
      "repository_source_sha256": "2ae9923b2acbacf673cd03fe847428bf534f951297e3a8ad02d4d53144c580cf",
      "en": "「Come, heir to the blood of the beast」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:849": {
      "repository_source_sha256": "88e0dba46d29834e080c8c16c3e16dcef0ddb8d61bb5bb57172174465adbef8c",
      "en": "「$$始原の特異点$$... An unwelcome guest.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:890": {
      "repository_source_sha256": "bfd4dc49052a718c12f8d074dccb4bed3ed39b8595d901fb0c1ae4bf0fb0847d",
      "en": "「What a fine song.\\nI sense life's power surging in you.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:945": {
      "repository_source_sha256": "1fd4b545c7bd171154b7bbfb58f1a012877d180603e93a83376f5530c26475f5",
      "en": "「Wings that carry feelings...\\nA shame to snap them off.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:998": {
      "repository_source_sha256": "3a851aa77c63a6180e93fb5cceb1ce9aaefcdca72e35fe43107fb9fbfc30e632",
      "en": "「My light dims the Demon God of Light」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1041": {
      "repository_source_sha256": "e5d80b5c5727d820c60c4e205401dba75be97ec0740949e96fe79278588fd89c",
      "en": "「Getter Ray warrior... Peace to you.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1084": {
      "repository_source_sha256": "1494583329338712e4a82a586be53a108437dd721f2c00293ea91541e3782b23",
      "en": "「You no longer need to worry about\\nsalaries or the recession.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1143": {
      "repository_source_sha256": "676fafad54f72ff88369cbc7b72e55eae0ab189bfd97f3754b5fdaeac71a721d",
      "en": "「Dominus of $$ザ・ビッグ$$...\\nYou should understand God's will.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1206": {
      "repository_source_sha256": "98a554abc21154994230f78bdf972bd104fa59ebd09d0d2e42e3ade96f7473e8",
      "en": "「You, who denied the power of kings,\\ncan't overturn God's will.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1257": {
      "repository_source_sha256": "4aa5ea5721d209b943c4be78fc394679fa2f34f9af81dd5c52af6636d82956ea",
      "en": "「Ugly... People who live off war.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1294": {
      "repository_source_sha256": "42e47173b9939050f26047c3287a99938627306975f197a8e12a964626381a4e",
      "en": "「You turn feelings into power.\\nBut it won't reach me.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1343": {
      "repository_source_sha256": "42b53556cdfd3463d7c3de6094db094e59437b3670ef0213241e980db502b4ac",
      "en": "「Your existence may have transcended\\ncausality and the infinite.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1400": {
      "repository_source_sha256": "efc737e0eaa64bff9c096cc80bc2b39c892f3072cefbf5a61246baec12f9b09d",
      "en": "「Mechanical Angel of the mingling of waters... Beautiful.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1443": {
      "repository_source_sha256": "580cae1f6e423861f6d1e67fa8db2988c2ab408a1ac2757f38dd0b68edc7c7f1",
      "en": "「The flames that burned $$バアル$$ away...\\nSimply beautiful...」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1492": {
      "repository_source_sha256": "ef575313b0bc594cdd80a8662b2b0b3c66e96a2de2b6f301411b5531d4277240",
      "en": "「Your power is the same as the\\ninnocence only children have.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1543": {
      "repository_source_sha256": "59a45be693afec3503ec233bc6f43db54617011f898daea6c1605836693b589f",
      "en": "「Some things beat effort and guts.\\nI am one of them.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1602": {
      "repository_source_sha256": "5837ab76aab4ace3f09518fbde24b12fa485cee447179048f9738a128fd47c04",
      "en": "「The destination of the spiral wind\\nis in the palm of my hand.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1655": {
      "repository_source_sha256": "fd9b19e02615823e67d92cde4bd90fb42b0887588a60fc8d11ec3c95dc2fb355",
      "en": "「Breaking the natural order...\\nI doubt I could like such a being.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1716": {
      "repository_source_sha256": "5c531f5c3408823edd5f3603f5d7194f1b3068a93f59be542cf8a2d46d7af9b1",
      "en": "「Before the weight of your freedom\\ncrushes you, I will save you.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1765": {
      "repository_source_sha256": "53914d2e09d9569656656087a830b2a7e0f879ad7725cc7b1843448027b44037",
      "en": "「Earth's crystal of heart and wisdom\\nI shall bury by my own hand.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1818": {
      "repository_source_sha256": "8547ee0db17b0611986bd2237aad1dbe5bfa75909c81d58a018dccaae6c53270",
      "en": "「The $$黒い太陽#sol$$ awaits your $$スフィア$$s.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1859": {
      "repository_source_sha256": "5dfeb43d9dbf6f8e3e124a873025299fa59f849c2da35e2cb240e758d3fa71a2",
      "en": "「$$セツコ$$... I'll banish your sorrow.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1900": {
      "repository_source_sha256": "4e83207cd44efb651c25bf0fb341ae541370eb9a3f22918d42f39985e9b58e2d",
      "en": "「$$ランド$$... I will take on your pain.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1941": {
      "repository_source_sha256": "90ca962ccf4ea658e04c571ab140e3d5895ddb0ab0d9eadaa93b2a3ae2c6a42e",
      "en": "「$$クロウ$$...\\nI will receive your upright resolve.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:1996": {
      "repository_source_sha256": "2179f5e40d299528d44c89d34107f3dcb26c2bc6c9f75c0937dfa5b538186a29",
      "en": "「You will suffer no more...\\nYou are mine.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2045": {
      "repository_source_sha256": "96fb15f4a09f651bc05d6ff5306dd0f16f4bc31f8d3494e1e211202c256ef9f6",
      "en": "「I've long awaited your awakening.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2088": {
      "repository_source_sha256": "d55a193f70e7d6f76b41a034a8546dbce474445884218463d394f632f9429ee3",
      "en": "「Best to refrain from reckless acts.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2119": {
      "repository_source_sha256": "caf1fdf6dcf84f7e1567abf84b6e09d39e8ba1e37439f3a3dcb425a905ab33f6",
      "en": "「I am right here.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2138": {
      "repository_source_sha256": "752bccace415f5ff2d8a34db2cebe35d2b7290f82c387280ad12ab60f20c6cc2",
      "en": "「You see things only with your eyes.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2171": {
      "repository_source_sha256": "90eeffbb4455efb964db884e8ef72631d7e8df60f153fd9e67245e5f01690a02",
      "en": "「You fear me, don't you? I get it.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2204": {
      "repository_source_sha256": "99796b3d17be9c7b73bbf7bdd195e730b8ce9e7a3a25e68321a83581f1c43670",
      "en": "「You should be able to do more.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2237": {
      "repository_source_sha256": "4de2b305efc514bd03faff6b6ab41a8efedc4ee30648fd728716ca8b8bbd85c2",
      "en": "「Will you only chase my shadow?」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2272": {
      "repository_source_sha256": "61aef11d8ede4afc755b5b4d0457d62dc300abd8d8f192bfc160a4a7472a52c9",
      "en": "「This is my strong will, given form.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2315": {
      "repository_source_sha256": "987e0052069a82115ed62199ad3249751c016ae9af243022b3e270604d310ec0",
      "en": "「Why do you struggle in vain?」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2340": {
      "repository_source_sha256": "62e727a69d2a60dfcdd93a2f8c743d60670d66615eb642d46f9d218a1fe67601",
      "en": "「Doesn't it make you sad?」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2367": {
      "repository_source_sha256": "bd0c91e5d3d935c4502319cf2cbb986d33c72c5da4058ab57bcc373e898299e8",
      "en": "「You have disappointed me.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2394": {
      "repository_source_sha256": "8620a8fcc7fb8310d8fba6420ae4a9197f12fda7c18cc398d1b72d507e722c20",
      "en": "「Repeating such futile acts like this\\nhelps neither of us.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2457": {
      "repository_source_sha256": "6bfe2a8a4447f194109e6f819b5a68cad5bc9d115882ea564a4e3ba3db699d2a",
      "en": "「Thought itself is something\\nyou utterly lack.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2508": {
      "repository_source_sha256": "685ffdb28d7dffbcf776407e906977276582507a11b099becfefa4c83ad3526a",
      "en": "「Is this your $$真化融合$$ power?」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2543": {
      "repository_source_sha256": "a1e9a1ef2f206060d6eae5c3222fc93a4a8cfd342f99ae3d3855a826e62268de",
      "en": "「You are not worthy of being\\na $$スフィア・リアクター$$.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2598": {
      "repository_source_sha256": "2e87667e8b112a9332342a4d37ace4d9e268526f897932227466f41eeee75989",
      "en": "「$$セツコ$$... Your being saddens me.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2635": {
      "repository_source_sha256": "e8cc7f548d61d59c046fc0438fd3090aa288aeb1c2330eadf19c1e23fc8457b8",
      "en": "「$$ランド$$...\\nIf this is your passion, how sad.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2686": {
      "repository_source_sha256": "0ad11230c5a19c170ec73d861653a4013a3dd35d255467f199d276d4098993f3",
      "en": "「$$クロウ$$...\\nAm I a $$次元獣$$ to you?」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2741": {
      "repository_source_sha256": "319ddc55648900ab6bd26cadb4302e69e7bf7765fec864ad0359ea2c737a70d1",
      "en": "「You think you passed your limits,\\nbut look at the result.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:2800": {
      "repository_source_sha256": "15a72cb9dbbf9aeda23ef0f63ce159b38d34dc1cf809713e9eb9b235b1c5f9c8",
      "en": "「Without me, the world will go dark.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2839": {
      "repository_source_sha256": "331c742c22e033d43468f2e371a4988fe0c258985c38b17d916ddfeae0f6559c",
      "en": "「Now, chant the words of salvation!」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2878": {
      "repository_source_sha256": "91ae83d9099891fdc1902a85498ac245adffb87fe417a43e6ec2cebc7e9eaf8f",
      "en": "「At my lament, even the sun frowns.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2917": {
      "repository_source_sha256": "b7c09cc98b1fda08bacf884d7681d81c21b5fe1f9cd1e5a0c21776dd3f3b2618",
      "en": "「I'll carry your soul to heaven!」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2942": {
      "repository_source_sha256": "4b9d72e4bf12aafa4906b65f8aff6ba588013e411e765aaac719064731c7b7e2",
      "en": "「Though the sun may darken,\\nmy radiance is eternal.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:2991": {
      "repository_source_sha256": "a906ae4c84de79cdf5c337431f45f0a0cd7dd70c0b7a7cd24f1265316b616e7f",
      "en": "「I will wrap that soul in light!」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3016": {
      "repository_source_sha256": "8e3224a2662ef77e7b3dc6ea3195f8b5e5ff19cd6dd14f5fbb0c75ee6c6ee1f1",
      "en": "「Behold the power of the sun-bearer.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3051": {
      "repository_source_sha256": "06504fdaa613d4477cf958c9e2f3b4ff9b1aa405ef6623217dcd8287262a2fe8",
      "en": "「This heat and light will guide you!」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3080": {
      "repository_source_sha256": "3ad9bd87d03e951f698f011ec8e3e73a978be2a677ed2626b4f82200d20cbce3",
      "en": "「$$ヘリオース$$ is the sun... Hope itself.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3123": {
      "repository_source_sha256": "34da7cc2bf51beffe14ff2b43b52f1833df3794f31ecc021424db1d888cf3fc1",
      "en": "「Here, I sever your causality!」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3156": {
      "repository_source_sha256": "fe5ed8fd879ae9ee0c846ac5ca1195b5ac4dac9faf4221982d6522cb2585f2e5",
      "en": "「Light... hope... future... joy...」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3183": {
      "repository_source_sha256": "f7d660e63194d55ae4fbee8a1dfbde33f8699b8d007dcc31c030dea3912600af",
      "en": "「All of it is with me!」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3214": {
      "repository_source_sha256": "58781db0ce620b8989181ce45edca8beaab7cd5fb3c3edd1be89d045d54ea7a0",
      "en": "「Then I'll show you my power.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3241": {
      "repository_source_sha256": "336fe1ebf1d691ebb29a3ec27c9cf7d692e3284a3bfad865c31dc682c3e3f1e5",
      "en": "「I must return the courtesy.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3276": {
      "repository_source_sha256": "43e0459263e7aa39819b0abd93f4ef0918cf25609ad096f64bd2d0d5f3c01b21",
      "en": "「You're reckless. I knew that.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3309": {
      "repository_source_sha256": "fbb15f71c9e3c5e8ea3b5790a0d91cb5ffecc31dea0bf40951581de92ac47554",
      "en": "「It's too late to regret it.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3334": {
      "repository_source_sha256": "394f20a09c2f62c8f5f4ef88da884bc19f9febdbdd650f705cb4ad62793a2312",
      "en": "「You brought this result on yourself.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3367": {
      "repository_source_sha256": "04531f6c6873423079d867d4efe0a7fb4169e592aec1a2f1ad7e0cc59b49c0ce",
      "en": "「This was your fate all along.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3398": {
      "repository_source_sha256": "f9050302493a0b7aa4e8102f27c1f9247fb1bccd0c1239b9447aaa7c9f884a47",
      "en": "「God helps those who help themselves.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3433": {
      "repository_source_sha256": "158ff1a91e18024167ccbd8534ba892ea577745f0bb3feb79dfa64ac68579471",
      "en": "「I see... You want to survive too.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3470": {
      "repository_source_sha256": "f2c98a86bf38887a3d634342e676d581b5c9dca1563617e07b6a723ee6cfd2d9",
      "en": "「If you think you've outwitted me,\\nthat is nothing but conceit.」",
      "source": "new",
      "slice": "v_g032_01"
    },
    "32:3537": {
      "repository_source_sha256": "7fb86f1e9afae3e549a826cf47fa51782b72dd10314ef58dae3d24b9fddc8598",
      "en": "「I feel how desperate you are.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3566": {
      "repository_source_sha256": "7d5b306eb89447f975ab3aa0466c8233c430b2b44585ca3d97399523ff193697",
      "en": "「A fine attack. Well done, I'll say.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3603": {
      "repository_source_sha256": "1e29fbbf78a8a4e5b351c26dd878c4321b1291cccbdcf70ee79e02dc7379d94b",
      "en": "「No wonder you got all the way\\nto $$エス・テラン$$.」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3652": {
      "repository_source_sha256": "6e15b1c5711c965351050ccc665bfe2db47bc50800d27f163f80db2cb3b23449",
      "en": "「Guh! You made me flinch...?!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3691": {
      "repository_source_sha256": "1572667fe603c41de2f032377d80d39286b9b823f00f81246160fd7c04c3ed6c",
      "en": "「What?! Beyond my projections...!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3732": {
      "repository_source_sha256": "85b0d565d152a27d6377700cf9ce2543a65a59be193414897e6bdd5afd6c4473",
      "en": "「So this is the Earthlings' power...!\\nThey've begun $$シンカ$$ after all!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3791": {
      "repository_source_sha256": "0478bbb22ff7f8dc4889a745739665b4058e76dec270d45bdb0a7436630850fe",
      "en": "「Causality is slowly warping...!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3824": {
      "repository_source_sha256": "eeab3493cbc042fa85693bd829ad4efaf74022a8c7957f0c191bea9b225adb78",
      "en": "「Power born of clinging to life...!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3865": {
      "repository_source_sha256": "5fcb87b42e42189143a90470a9e78f3aeb5f7333eb01846c2e9cd1c8256d7dec",
      "en": "「Life's power is terrifying...!\\nAnd so is $$真化融合$$!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3918": {
      "repository_source_sha256": "8977045fa565b0152bd92a2ebb0295a1a10dc0a21571dc21c46ed3f533e8b278",
      "en": "「You're cornering me,\\nan $$御使い$$...?!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:3967": {
      "repository_source_sha256": "ca730e659920589086776fabf41472c522cc1e04bcbe8fd9b96c7e58ec006802",
      "en": "「My consciousness can't keep up...?!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:4000": {
      "repository_source_sha256": "daf4110e12fc85ebf72ee417bb87509248e243915295617d1cbf66182830d3e2",
      "en": "「An $$御使い$$ losing to a human...\\nThat must not happen!」",
      "source": "new",
      "slice": "v_g032_00"
    },
    "32:4057": {
      "repository_source_sha256": "ac5cbfe439030457349c7d3a25c85eefd91d2f432ded19cbb5784245a64e6078",
      "en": "「Th-This... Supreme God's rebirth...!」",
      "source": "new",
      "slice": "v_g032_00"
    }
  }
}

{
  "schema": 1,
  "group": "g034",
  "blocks": [
    34
  ],
  "speaker": {
    "proposed_by_v_g034_00": {
      "token": "$$聖アドヴェント$$",
      "basis": "Calls himself one with the Supreme God Z (至高神Ｚ), above the Angels (御使い), 120 million years ago, punishes Setsuko/Rand/Crowe, names Asakim; this is Holy Advent in the Supreme God Z finale, matching g032/g033 (Jigoku had no identification)"
    },
    "proposed_by_v_g034_01": {
      "token": "$$聖アドヴェント$$",
      "basis": "Sibling of g033 (Holy Advent): calls Setsuko, Crowe, Rand by name; Supreme God (my 至高神), Baal, god-will speech; reacts to Big O, Gurren Lagann, Aquarion, Macross-type ship attackers"
    },
    "jigoku_token": null,
    "token": "聖アドヴェント",
    "basis": "settled 2026-10-02 from fresh-translation review: Calls himself one with the Supreme God Z (至高神Ｚ), above the Angels (御使い), 120 million years ago, punishes Setsuko/Rand/Crowe, names Asakim; this is Holy Advent in the Supreme God Z finale, matching g032/g033 (Jigoku had no identification)"
  },
  "lines": {
    "34:0": {
      "repository_source_sha256": "3790be0e0f74a5fdf25ec834d95cd845ee0063e138ab9ed17de613228fce0b2d",
      "en": "「If you wish, I'll grant you ruin!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:41": {
      "repository_source_sha256": "b93668c2085ad9170e58803af5c0008dfcbb0b33dfc64aea234d471d83507a38",
      "en": "「The Supreme God swallows Earth's feelings!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:82": {
      "repository_source_sha256": "b3d0d3e91ead0e493516b83cb51d61b10d17cdcfd7be15afbbb59e5eb7e88a56",
      "en": "「This is where myth ends!\\nI won't let you interfere!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:141": {
      "repository_source_sha256": "b747fca3dbecdce5cf5a023e8d7301b51fc069ca1ccad4d9008e4dd6c2d455fc",
      "en": "「Rejecting salvation earns punishment!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:184": {
      "repository_source_sha256": "04b35ebc7d72d841f55454da6338e9f14b765236a93dab437d6c9d2430e06ddd",
      "en": "「Never again will you meet\\nyour end in peace!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:233": {
      "repository_source_sha256": "4525a4418be6b87724f7972b69058125332754a3c908eedbff1a51c937e0527b",
      "en": "「Your memories are unneeded...!\\nI want your lives!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:290": {
      "repository_source_sha256": "bd1876e5af8d8c59e4d42439edfd410af179c63f4f19724b5956d6dcc72aff41",
      "en": "「I'm resolved to do God's mission...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:333": {
      "repository_source_sha256": "cc6dc2e49dc73719701c6f76d4c8155e029fff7d3904aa7c6881a7a09549d56a",
      "en": "「Insolent Earthlings!\\nRegret is too late now!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:384": {
      "repository_source_sha256": "a42a98898e003693deafcc9720fe9924bd7ea953083fb181c0171ba1650bdd28",
      "en": "「The Supreme God's light will\\nswallow all of your existence!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:435": {
      "repository_source_sha256": "8fc2481f89eaa91f9fb693ec6625a999ad8fa8926c93260e339994e5d67a96f8",
      "en": "「I became one with the Supreme God!\\nIts power is infinite!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:490": {
      "repository_source_sha256": "3d8d81c0328eee8bd2476a7580781fb603eca7b9efb9e6243cf9bcbb8a6b3263",
      "en": "「I have surpassed the $$御使い$$s...!\\nI am the Supreme God itself!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:545": {
      "repository_source_sha256": "d6211c9752f9888c1900e405fc0f3e5e4005ce7d00fce9aa1f4b7e7274ccb8ff",
      "en": "「Right now, an emotion other than\\njoy fills my heart!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:598": {
      "repository_source_sha256": "de1778b9fde7e168b6280a96935f2e8433ae3e0258309ac7618bfb2b2e428c71",
      "en": "「Embrace the Supreme God's light again!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:639": {
      "repository_source_sha256": "2ca2bcec299f5c036df3da62620b7f9972073461c290c4b37b4e7dba4ea92d58",
      "en": "「I'll deliver your punishment anew!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:670": {
      "repository_source_sha256": "5254b2a76a277afde6494ac7def9b3a5516c86ec41d7c3df3d2e7630a74d649b",
      "en": "「Moonlight can't dim the Supreme God's light!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:713": {
      "repository_source_sha256": "97ac3d17f4205ad83320692bb6d287e6291d132a44563baea260b37dbcf0ded6",
      "en": "「Your sun will be painted over by\\nthis $$至高神Ｚ$$'s $$黒い太陽#sol$$!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:770": {
      "repository_source_sha256": "c7f8e24aea1dc6de88d9778e3f2cccc4fe49a2d05f88304337ae870dccdc3eae",
      "en": "「You defy my will, so even\\na child won't be forgiven!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:821": {
      "repository_source_sha256": "e6f6fe8dd2a4cd5cc2d472db8fcf67cc2897f68f59529f37c3f14c489c7ebce9",
      "en": "「None but this $$至高神Ｚ$$ may\\nclaim to be Messenger of the Sun!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:880": {
      "repository_source_sha256": "bac6930440b5288fdf7d47bf298ebf4cdcb0de7bf2c7a0b3f5268d9c60385613",
      "en": "「It is this $$至高神Ｚ$$ that shall\\nbe the monument to love!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:929": {
      "repository_source_sha256": "74cc5ca252eec6ca0942a23cfb063b473826a839b891602444789db313a095f1",
      "en": "「$$異能生存体$$...!\\nI'll send you beyond the causal horizon!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:984": {
      "repository_source_sha256": "3a83f8f8d6fc1bb142aeefa907de3315eb72db15db53ff368bd4abe43f3dc2c8",
      "en": "「$$ガンダム$$, evolution's guide!\\nI'll erase you from the universe!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1049": {
      "repository_source_sha256": "bd152ba31f66d48741e4187a8b19499ecce2ecaa9a3e9ee136663ebfc0328bea",
      "en": "「$$ガンダム$$!\\nVanish from every parallel world!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1104": {
      "repository_source_sha256": "558f122938edd4f765d6652e3fc8f637bccf7ac36e9685b30693248767dd6633",
      "en": "「Gods and men never understand each other!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1145": {
      "repository_source_sha256": "d57866a54553dbcc3463797c70eb4685f543eedad7fad3860fa0855bff4a364a",
      "en": "「Turning feelings into power...!\\nHumanity doesn't need that power!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1200": {
      "repository_source_sha256": "337f0374735161d5887569e522b86e15cc05a37b8a93b0f979587c80e163ed61",
      "en": "「A beast less than human\\ncan't possibly kill a god!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1251": {
      "repository_source_sha256": "0103034a0a509384720248c3aaa931829afee342335c5a28a5197ec2e7c2617d",
      "en": "「$$始原の特異点$$...!\\nThere's nothing left you can do!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1312": {
      "repository_source_sha256": "5f1e7760287b213715de97b44c820759fefc51ed1c968a1372f132479c5ae017",
      "en": "「That power of life...!\\nIt impedes the great collapse!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1365": {
      "repository_source_sha256": "0a22c90c318fa8fa7d7c9956de41991692e84f9f559744ac952bee6388b72614",
      "en": "「Even wings that fly on feelings\\ncan't survive the great collapse!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1430": {
      "repository_source_sha256": "6273d5de4f2106e9594eb7c19111b937ace74d75c39a864e99e3fc5866366338",
      "en": "「Demon gods are only monstrous gods!\\nThe Supreme God swallows that light!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1495": {
      "repository_source_sha256": "50de638a79fa4aa48377346cad26c656866564ac555043ac94b0e4e12691b37b",
      "en": "「Warrior of the $$ゲッター線$$!\\nYou should've just fought the void!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1564": {
      "repository_source_sha256": "caca75e507f0686d097e1b295a479bd0e79029ba6b07492f12a651738e7c8df4",
      "en": "「A mere breadwinner defies a god?!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1607": {
      "repository_source_sha256": "3d5321a0fa0a0279537077680959ee683c34d967c8cd31bc8fb175b852fd1de1",
      "en": "「Dominus...!\\nFor your sin, I will punish you!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1664": {
      "repository_source_sha256": "abce809b328e7dac39674c1b7e2b4dd95047d1757f553d2182757bc9fa93a910",
      "en": "「Don't think you who spurned God's power\\ncan face the Supreme God!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1735": {
      "repository_source_sha256": "bfebec9d8ad6545a56a269c20da2ad6f5ed1fe5cc0fc50a0b832cebafe59c04c",
      "en": "「Don't think human feelings\\ncan reach a god!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1788": {
      "repository_source_sha256": "fb1db3b026c619bb7ec770c73f0a7208fd9faff2311e2403a7a17b4584be43e4",
      "en": "「Not even you can calm\\nmy raging soul!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1843": {
      "repository_source_sha256": "7cf1144895e8ac0cab9aec7bf11664ad1e45dd1db44259d5687161636d07b49f",
      "en": "「Mechanical Angel! Vanish into the\\n120 million years of darkness!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1906": {
      "repository_source_sha256": "15ddc7c6d306328f565f4df69b1f5e17f0f28fb2888b86d97aec35251d992eb9",
      "en": "「No miracle will happen! Because\\nI am the one who decides fate!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:1973": {
      "repository_source_sha256": "3e64b1a29e682f25b058eaa489732c4aca9946186868cb41b08edec27ba0553f",
      "en": "「I stand where effort and guts\\ncan never reach!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2028": {
      "repository_source_sha256": "053430fea7e270057e8c9cadd33c7628ee0fd8390e5bba1155663365dbef6558",
      "en": "「Some things even your $$螺旋力$$\\ncan't pierce! That is me!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2083": {
      "repository_source_sha256": "6a1b744e5e385cddde4b6f80f2a2e2006e18d4813450deac792672a164537362",
      "en": "「Vessel of a god made by human hands!\\nVanish here!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2136": {
      "repository_source_sha256": "2f5d064bedf453eaf626d4fb0b639aad45804a7257cff0d8aadf6c2b477d1e7d",
      "en": "「Humanity needs a god!\\nI'll teach you that, too!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2193": {
      "repository_source_sha256": "60f86c3b4663a266a3ee243fc5d88e0f4668a37a8585d96866c9f659d1ace56e",
      "en": "「I'll destroy that $$Ｚクリスタル$$ myself!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2236": {
      "repository_source_sha256": "8199b7c63c5399fdb9ff27e80d5ed1ceb18baf2e60f9b875065f9d68598ffcfb",
      "en": "「Though you were Reactors,\\nyou defied me to the very end!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2301": {
      "repository_source_sha256": "1d37a8920033f0cd825a11d35be2a7336c5dd977fc7b2efdb8cdb43e2e7fc8ec",
      "en": "「$$セツコ$$...!\\nMourn this world filled with sorrow!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2354": {
      "repository_source_sha256": "2cdf3755775eb3bc92eacaaec129b067f78f3919ae955328e384dcb8ea9d1355",
      "en": "「$$ランド$$...! Let's see how much pain\\nyou can endure!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2419": {
      "repository_source_sha256": "b33aa55e843a9eb84b80366be855804aa51794fd39ffba333f03843bf5f7d91e",
      "en": "「$$クロウ$$...!\\nI'll break your life and your will!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2470": {
      "repository_source_sha256": "ef358737b4391ed432af0666785c00b026355a1404e0d30cfd9f8306870aa772",
      "en": "「Your life is mine!\\nYes, ever since that time!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2527": {
      "repository_source_sha256": "c45ef4c5d3be64d22180f08255a6c20901d07d2708c4a4554e4676c3d316b135",
      "en": "「You'll see the universe's end first!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2564": {
      "repository_source_sha256": "bde7c6f0a4b104e4cadab573104c500a212aa6c0b21191139e5ca36130892420",
      "en": "「That is the punishment I give!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2591": {
      "repository_source_sha256": "4e7ef85f172f5bc68527e62b3ae41c1a7f387fdb2eec1f8aa601ff5dab503981",
      "en": "「Vanish beyond the causal horizon...!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2630": {
      "repository_source_sha256": "ee06a58a0d04c7902bacbfca88a6edb5fe674856e7d53a4498c7d0bbc40dde01",
      "en": "「Your existence is wholly erased!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2667": {
      "repository_source_sha256": "40416d685fde561b7bde6edc9f3850fea1ef4dfd884ea8ae875f2758ceda4fb0",
      "en": "「Ultium Deus Initium!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2708": {
      "repository_source_sha256": "3b6ff1250c8ee43bbdf77dc63574882531d3007cb2848f5b5fff19a734fcebb7",
      "en": "「This is my... the will of God!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2737": {
      "repository_source_sha256": "3d583a09c87cf00acbb0bf63c7f79150adeda5aea849d8aee6666d173e73ccb4",
      "en": "「Then you know the void's cycle...!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2774": {
      "repository_source_sha256": "bde3b481a3e1aaab3079aab319e99c5de33f95ff1b47f637e29fdd44202bd749",
      "en": "「All of it, together with my joy!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:2801": {
      "repository_source_sha256": "4bacde148658ff48693592a204eba5b6f2479b287526017bb6d0946fc0ad30e9",
      "en": "「No mercy for defying Heaven's will...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2836": {
      "repository_source_sha256": "66d9a3021e8aac56439ffbc32819dd3922d3dcb5ac6455d1eb4920e3b5a66dad",
      "en": "「No use fleeing anywhere in the universe!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2873": {
      "repository_source_sha256": "4c9c94300fd112ecca8402d134cae016e4d49615833a6978dcf0ac7da7811189",
      "en": "「Your life is already in the grip\\nof the Supreme God and me!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2924": {
      "repository_source_sha256": "b5914f94b9cdbef0c2ee9ad6b454cd0cd2e41f32ceed0b3091567cd8d4d01b2b",
      "en": "「If you have an afterlife,\\nrepent there!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:2975": {
      "repository_source_sha256": "c5e334f780cc7f11661284b8ba1a0b01e952f56f6661f00a985e562e6c1197ca",
      "en": "「I give you pain and fear...!\\nThat is your punishment!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:3024": {
      "repository_source_sha256": "5553f3917db05401353ab1d21b26667043c6fc450ab06049509c9d4b6f516bde",
      "en": "「I praise the reckless courage that\\nfaced the Supreme God past all awe!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:3081": {
      "repository_source_sha256": "41255cb808700afc5dbbe2db33fe204ddf6e9fea32906c9c14c33fa6971f9908",
      "en": "「If you'd stayed hidden and quiet,\\nyou'd have been spared this...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:3146": {
      "repository_source_sha256": "1511e9213a7480339874f16593bf6a3874e8b81236c05fa440e87a50cb09e151",
      "en": "「What's given to those who refuse\\nsalvation is punishment!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:3195": {
      "repository_source_sha256": "1d92646ac22f0c022cbb773d38bb516a17f91ac668dab585f40a5ca4a1e27d55",
      "en": "「Don't get in my way...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:3220": {
      "repository_source_sha256": "4d3ea6a68493a52121bcff8af5b6d1390dcd52b5bb2b4c777f0f3ae25a54cac6",
      "en": "「...On your next chance to attack,\\nyou will regret what you have done.」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3273": {
      "repository_source_sha256": "ad297cc07c4db89c46fe4a1648c0cb25d1a8717e03d162a0479b9921d38ce8c7",
      "en": "「Trying to outwit a god...\\nI will not forgive such an act!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3334": {
      "repository_source_sha256": "e3ad28aa324d908d24bcf71e2c0dce938fd8a7412f029465d314f890cdddc9eb",
      "en": "「None may touch the Supreme God!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3373": {
      "repository_source_sha256": "7c150fae4149034b5a6a3a600458d7e7fa4fc1cfff95061529e8d69618d6eee8",
      "en": "「Untouchable...! The Supreme God!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3416": {
      "repository_source_sha256": "865bf49af1d1eacf5c92fe1bf181804f1e13c8d60537b9657f67be71f901ef41",
      "en": "「The dread within you\\nis warping your will to attack!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3471": {
      "repository_source_sha256": "4748a7c9d223f38ad97b0a045242f94fbe86e7b888df82bc85b37d61d945f70f",
      "en": "「A human trying to touch a god...!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3512": {
      "repository_source_sha256": "61a3d758cf7a8f29ff3ae0ef8cf6312514da1c8e74ce6f46d90167294c032e0a",
      "en": "「Your $$真化融合$$ is nothing\\nto be afraid of!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3567": {
      "repository_source_sha256": "f3bdfd9c85b9341e138003a1945d56608b65b17c0246f123d8f7d82361620796",
      "en": "「Futile!\\nGrains of sand can't fill an ocean!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3626": {
      "repository_source_sha256": "2e9a949e5c0e0d01221a63d535c5fdd5e8ae8b4921ad2b398e25830d0071baa8",
      "en": "「If that's the extent of your attack,\\nattack all you like!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3679": {
      "repository_source_sha256": "49521d217f50ad8f64738c04c06f0aecfb4db620f9110bc5561d1eb8f21963d7",
      "en": "「I dare say you're just a worm!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3722": {
      "repository_source_sha256": "607a5b0001474757e53dad7f06bd8feee26a69da0a0a99883eeee83ae356a3e2",
      "en": "「Give up. There is no time left!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3765": {
      "repository_source_sha256": "8d44eee703cd0f5e3131fd4ef4156b15955f3de2ab820eebf0fee74576180638",
      "en": "「Even all of Earth's power combined,\\nthis is all you can do!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3816": {
      "repository_source_sha256": "9bb58eaf0b8f14f8a8e577948b8298b2259a6bee7e50f15e8c7cb7aaa9eb42b5",
      "en": "「To me, even your desperate attack\\nis a ridiculous suicide!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3875": {
      "repository_source_sha256": "bb0c1ae1afdf4158c7e5033b5ffaa41c0878a16b6b19be87a7143c93303c3f0f",
      "en": "「Panic, be afraid!\\nFace this reality!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3924": {
      "repository_source_sha256": "fa5956bb5f3bbeecc092b1c116e7fe25704a32be627f9b6940d862fbd4892c08",
      "en": "「Still struggling...! Still defiant!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:3963": {
      "repository_source_sha256": "69a372b1f75ddc1cca237a3da7c7da5eadf456057194fea835607d944d25eef8",
      "en": "「It is you, who do not obey God,\\nwho deserve the name $$バアル$$!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:4018": {
      "repository_source_sha256": "22e11a6031ed2836d63512abdf412a6dd4503ef7f464c36db2e952b41a995ee1",
      "en": "「I feel joy at being able to\\nexterminate monsters like you!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:4073": {
      "repository_source_sha256": "25ee9cb2104276166f4795c4c64c2afcf232af3ce0a2e5c73c68f9b910808ad5",
      "en": "「You're desperate!\\nBut all of it will end in vain!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:4130": {
      "repository_source_sha256": "dc47362e5ad314232539514af903ff7af04348148502d18c488113c72ab64681",
      "en": "「No wonder I took notice of you...!\\nImpressive!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:4191": {
      "repository_source_sha256": "5947dc35622e808dc92d13611bbaae23139fd2cc5b0dd00509e2f00528f80636",
      "en": "「The Supreme God is wavering...?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:4220": {
      "repository_source_sha256": "3bbf676cb3ea5a07085e8274be3bff9f42857fed5e315dee774d4db4482c351f",
      "en": "「Causality... fate... slowly warp...?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:4261": {
      "repository_source_sha256": "5c84a962423688d788420fb7b21eea0875b48fa9a3bedc9b483ff8d7798333a3",
      "en": "「The will I feel beyond the attack...\\nIs this the Earth itself...!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:4322": {
      "repository_source_sha256": "34f118c61cc2528e39e92335a270217d5bfa67e5a23ea56398f54998c3bb467a",
      "en": "「Why won't you give up!?\\nDo you lack the brains to think!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4375": {
      "repository_source_sha256": "bac9bf5885dd3c716dcb93ae3fc3d95ac853d4f10fc7fd38fa2fb525f53fdda4",
      "en": "「You should be at your limit,\\nyou must realize it...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4426": {
      "repository_source_sha256": "902638055f3d926cb7a72939237c338bbbf2c550f8ec1d41a365ccbba8915020",
      "en": "「This is...!\\n$$アサキム$$'s will in the Supreme God!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4483": {
      "repository_source_sha256": "03cd9d004ff1cfbcf507fbc190620482c02b14bea91f32a04751b490b75cba7b",
      "en": "「Laws... natural order...! Breaking!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4514": {
      "repository_source_sha256": "ec15bfe8165ef09a2e3abd5dbb8646f291a9bcaedda80dc632d62f9ed600576c",
      "en": "「This is...! Something we forgot\\n120 million years ago...!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4581": {
      "repository_source_sha256": "0f1a13ec1964e72295569a52e21460b185cee94fedc2a6c9acd8c96c6558eaf7",
      "en": "「Are they... trying to surpass God!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4624": {
      "repository_source_sha256": "f6372de39f434a21de3e80ab0bc4e23892697aa2e619393588bf0d137acdd1b9",
      "en": "「Impossible! I am the Supreme God,\\nbeyond the $$御使い$$s!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4685": {
      "repository_source_sha256": "e6510112c1f5dfd9f66e767be813015cde64354a859d21b91adaccd3bada62dc",
      "en": "「I am eternal! Even if the universe\\nperishes, I should survive!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4754": {
      "repository_source_sha256": "ddc50e7bd461c0821a5d409c1a10a09490bc0b1ace01fdeafe4491e43c0e4dd1",
      "en": "「Does mere moonlight outshine\\nthe Supreme God's light...!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4807": {
      "repository_source_sha256": "121c1dba7a76358b4488104823dcfb82e64e0ca0097f1d1eb9e8f914774d668c",
      "en": "「That man...!\\nHe's truly with the sun's radiance!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4858": {
      "repository_source_sha256": "410d2247c284d1620202b4335b5f67d872680f6c15415ea8671b387ba6380648",
      "en": "「A child fretting over a company safe...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4901": {
      "repository_source_sha256": "e5fbc43b5beb682ef5482e19abb03458b2dcadd1b8a122ef0e94b4d2846cfb99",
      "en": "「The name Messenger of the Sun\\nis no mere show...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:4954": {
      "repository_source_sha256": "7b80c3a9c723287b2f426bdc3983a6ea901f312f62ec0815a2b162e868c4c267",
      "en": "「Love's power, light and dark fused...!\\nIs that his strength!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5011": {
      "repository_source_sha256": "9328e5ea88ab2e128bcc0f35b1b051ac3aeade2dd18bc868fb9e9581e5385bb9",
      "en": "「This man... a god-killer...!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5044": {
      "repository_source_sha256": "21796dea4c7e569ea8865ff3932d8a96c997aa34eced6a131a94f5b11b915adb",
      "en": "「$$始原の特異点$$! Gathering people's will!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5087": {
      "repository_source_sha256": "a2ffb62de92e9865e697205df6f4bd116d029231c5672a0f1e93af0574a10584",
      "en": "「$$ガンダム$$ and its pilot challenge me!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5130": {
      "repository_source_sha256": "ee3278ff299dd110d7c96aec783d248b7d6e9f45b3238107d92429b3f6cdd00d",
      "en": "「$$シンカ$$ beyond evolution...!\\n$$ガンダム$$, the one that leads to it!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5189": {
      "repository_source_sha256": "789541b971d66b2961bfd6871a14794e07ade46084177fabb48691e37f57117a",
      "en": "「This heat...! Fight of the beast-blood heir!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5232": {
      "repository_source_sha256": "464aa00ce8f4ac78038c5cef248bf2f92cf96370b5087fd62216b7dff10cd77a",
      "en": "「Limitless power of life!\\nThis one's existence is a universe!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5281": {
      "repository_source_sha256": "4d57199f7d1341f4a7706749ec3f9b5f00c2de2e6c67cb7f429b34b10eb32b1d",
      "en": "「I saw a golden triangle in those wings...!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5320": {
      "repository_source_sha256": "7da112b1b601febd2ebe109f2f96d6afd9ba21b7e91a87c3895fddcd77ee65f0",
      "en": "「Demon God of Light...!\\nPower fit to face the Supreme God!?」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5377": {
      "repository_source_sha256": "09482d31ebdce2b2383bf46431f97f837bd6ea768980666b57dc21ce0a4ab902",
      "en": "「Warrior of the $$ゲッター線$$!\\nYou can beat the void, not surpass me!」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:5444": {
      "repository_source_sha256": "f9770c9012ee310e583248d91a6aea5c84ae29a4135c62011577de6fe75d4806",
      "en": "「Why...!?\\nHow can this one fight so doggedly!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5505": {
      "repository_source_sha256": "e633fd91dac660904f94b199f23952ac469af0c39c8ae2f0d12df290185d2530",
      "en": "「Defier of God's will, $$ザ・ビッグ$$!\\nYou challenge me again!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5562": {
      "repository_source_sha256": "5fefee2bbd6d3e2a163aa64e6cc8fd24fc3012c567dad4ac0cdccaabbd1df567",
      "en": "「Bearer of a king's power!\\nYour hands seize future and miracle!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5623": {
      "repository_source_sha256": "320b6e4bb989f9041b5334e2ae9c6855f7ef9c8cc540e667220e6c464b50803a",
      "en": "「$$真化融合$$ and heart power...!\\nThey combine into true strength!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5682": {
      "repository_source_sha256": "c78b33befbed6ba7a428f14a5e76cb6e64e55401dd110ca9a308134fee135e28",
      "en": "「Only this one is beyond even my ken!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5725": {
      "repository_source_sha256": "3c1a9960c4efaf3eba40884f5a0665c219c9a026303d1c4ca76a98f9071cfe52",
      "en": "「Mechanical Angel of mingled waters!\\nIt gives birth to a new love!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5788": {
      "repository_source_sha256": "97ea61919f6216e16027efbce981558a6e5eb8cb7fe1abb26e7fd4143e52a161",
      "en": "「This power is truly flame!\\nA beacon lighting the future!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5841": {
      "repository_source_sha256": "ec0c11c189ba95ee64852de40473fde798e4274adfe3bd4152687e002a09126e",
      "en": "「Relentless...! Hard work and guts!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5882": {
      "repository_source_sha256": "2559eae4a978c0911f3ec446e0ac9cac096a4f893d75a3496be9d414e79fd704",
      "en": "「The spiral...! The drill nears me!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5917": {
      "repository_source_sha256": "c3a3a9f43dbbc994c8172019fe7429d4a17dd4b2de78d837607f25b27768b318",
      "en": "「Man-made god vs my Supreme God!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:5954": {
      "repository_source_sha256": "7846be6d7225ad352b0bacf36e1a47dbd75eeb81d8dd9d21e49f9ee3e49d7413",
      "en": "「This one's $$真化融合$$...!\\nA perfect union of man and machine!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:6005": {
      "repository_source_sha256": "578d2a7b78cdc7dc76e494ead79b918e0273973c1d1805ff99e540e81282659b",
      "en": "「People's feelings become power...!\\nThat ship is proof of $$シンカ$$!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:6064": {
      "repository_source_sha256": "8d69f17c3d1ab16d629d3bd7408952d23909ce6a4d8e59f9e3755cd121c83ccc",
      "en": "「With this power, the Supreme God\\ncan rise even higher...!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:6125": {
      "repository_source_sha256": "357bb7993b2f301759da4efd96d4c207fa7da400d0353a371fc93146a04b3631",
      "en": "「$$セツコ$$...! Why do you\\nwillingly fall into sorrow!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:6186": {
      "repository_source_sha256": "81edbee22bc29758431e02315f5fa7d581c403d2fc9eeb6616e17e18c5c1cbf1",
      "en": "「So this is $$ランド・トラビス$$...!\\n$$ザ・ヒート$$ Crusher!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:6249": {
      "repository_source_sha256": "1c68228485a36c85a81be3cf65a22eced82b8da42eed1da95fd34a474c034803",
      "en": "「$$クロウ$$!\\nYour will pierces even God's!?」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:6300": {
      "repository_source_sha256": "7bec756b62839eabd017eb10563909abf7915a5742fda1ee266e69c361f7f81a",
      "en": "「...Beyond both hope and despair,\\nyou step into the realm of God...!」",
      "source": "new",
      "slice": "v_g034_01"
    },
    "34:6353": {
      "repository_source_sha256": "c02f2b288391ce5166a0c6703a4aaf5bfd5405fca920d1deb26aa8f78a45e7f9",
      "en": "「I... couldn't become a god...」",
      "source": "new",
      "slice": "v_g034_00"
    },
    "34:6386": {
      "repository_source_sha256": "30e05bfc01dabb72afccf16ef6943865b11f8cc8d4d71d1ad1211964ab3c024f",
      "en": "「Now... all universes return to nothing...」",
      "source": "new",
      "slice": "v_g034_00"
    }
  }
}

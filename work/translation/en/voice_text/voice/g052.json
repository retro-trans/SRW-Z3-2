  "lines": {
    "52:0": {
      "repository_source_sha256": "fa4fba6827e344a8b9966ac84f227dbe085b7ee79fa8dd04deba9387cc58b7fa",
      "en": "「Come on, let's have plenty of fun!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:31": {
      "repository_source_sha256": "d8704f8e44d185d67ef024c4208e1c350974c7aeda5b77c168de447c2fa4f6e7",
      "en": "「$$テンプティ$$ is going to play with you!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:64": {
      "repository_source_sha256": "c7ae0956e4292ba0316726b1ee5e58db9567297a2b650ecf7be446177c8cc173",
      "en": "「Trying to run is useless, useless!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:95": {
      "repository_source_sha256": "be426ed80d969be7fdd6ee93ba929a1247c970b6481dfddf1c2b422c6226220a",
      "en": "「Things like this get me so excited!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:128": {
      "repository_source_sha256": "7de17b04f4eb1e3dff32ef44589ec98e5694467dbbe0f7110ccc83bb589a1b72",
      "en": "「It'd be no fun if you broke easily!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:161": {
      "repository_source_sha256": "90a4dd0a93a30c92148a214ba342a4816be906e5c8000f8f255a824ce4c19a83",
      "en": "「I get such a thrill from this!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:194": {
      "repository_source_sha256": "6b8806486ec626b74cd041a0e20e33b08c2eadd5dafb961f733cb30fc6033164",
      "en": "「What kind of death would you like?」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:225": {
      "repository_source_sha256": "eb8dbcc8f7de6b8bc476a3749676fb125ce46e3da489e33fef58ffdf08125987",
      "en": "「Run, or you'll get killed!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:268": {
      "repository_source_sha256": "b9ac5720dd7204a294a0bf5486c0af16e855b6f6820a039e025293df8fb49e91",
      "en": "「Okay, $$イドム$$! Move as I tell you!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:309": {
      "repository_source_sha256": "a854c22e7f60433ddae6ba7f2af94d2425f542fffd3fdfa00a22d5a31b8f196b",
      "en": "「This one seems to want your soul.」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:348": {
      "repository_source_sha256": "e8174bb442e0e39a2aafaef17919c18f6db18c6b36954d46c76c2282d85d2c4f",
      "en": "「Hee hee... Come play with $$テンプティ$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:381": {
      "repository_source_sha256": "92b70bc8ef54805ab3bd3a26ed052672ab99d4bf5ff6018d719ed19c73cae869",
      "en": "「Go, $$イドム$$! Kill 'em!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:422": {
      "repository_source_sha256": "f823ee65d9ce26a8df901d77865dea1b27d3d6857ed038674ae705df5bee0787",
      "en": "「This is the end for you!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:445": {
      "repository_source_sha256": "a32fa15477aee8f96a68909902c04c9fa985304960690449087067d7175dd171",
      "en": "「Get squished flat!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:466": {
      "repository_source_sha256": "77f1b8582d09de7c3405b5592b57488757c96efda5e02daa6f6847231a9dc92b",
      "en": "「Ha ha ha! Blown to bits!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:497": {
      "repository_source_sha256": "369e28029318f6bde32d705675783ce858f476fd4551bf1e86fa80ae058b7c22",
      "en": "「Vanish without leaving a speck!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:528": {
      "repository_source_sha256": "38051f3af1ad50fc18a3f2708867cf213591943ff00344c26e3e9dad352119d5",
      "en": "「Get blown past the causal horizon!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:561": {
      "repository_source_sha256": "e34e01d31672467a8320b2b98f71e535594b3303403e77c60b7068f03b004243",
      "en": "「I'll turn you into atomic dust!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:590": {
      "repository_source_sha256": "02f74ae9d4554829729c7c83a779aaa9bd57f40187fccf8527e506db2b685700",
      "en": "「I'll grind you down cell by cell!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:627": {
      "repository_source_sha256": "eb4e727d1e8f006058c7ba713bf72b304d41dee5b3ed79d3f9d6f0909c15d8a0",
      "en": "「I'll squash you flat!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:658": {
      "repository_source_sha256": "2c897a0fdd4114dfddd7f9d7f151a3fcf80d898ea26469b43a71d185be69c314",
      "en": "「Bye-bye~!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:675": {
      "repository_source_sha256": "5fcefaf3addfcb66a3fe0f13848544d041cdd206ad03d0670bb899b1a4874645",
      "en": "「This is gonna hurt a little!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:700": {
      "repository_source_sha256": "2a4eb97e890fe16b66e16be9da9567349f734c52a758765fd7bb9e2c5df92b54",
      "en": "「Ready, set! Boom!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:723": {
      "repository_source_sha256": "17009dd94bce813f7053c955da18d955b19e6fb64353f4bf48a7ba63cc94c8bd",
      "en": "「Here I come! Diiie!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:754": {
      "repository_source_sha256": "9ac55925c0fe31871b3a38d5b92ee5c04870279de2e5e6a4f3128ecf035c742f",
      "en": "「Soooo sorry!\\nThe attacks keep coming!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:803": {
      "repository_source_sha256": "730d6748d8ed045da8800824cf8fcea2bbca2baa085349f05b332f1f94bcccf9",
      "en": "「Okay, one more, on the house!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:836": {
      "repository_source_sha256": "32d50bb353de86d6f633c969215f2928046aaa9f21a79adb53d539bc21408ec4",
      "en": "「How stupid!\\nFighting despite being hated!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:887": {
      "repository_source_sha256": "502b73251f8e302b7505a0aa0bc0206bcf10e3fd88ed19f896c5cb51ed6ac085",
      "en": "「Too bad! The sun is ours!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:930": {
      "repository_source_sha256": "0f67c737332310ddec56304603eac0293fac80b0cdeb2ba10167f77655c0fbb6",
      "en": "「It's already bedtime for kids!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:959": {
      "repository_source_sha256": "0bdc548c8f22c04ddad14d9188635924c2aa2ba56e6ba9911b0985d1b70a4cc1",
      "en": "「$$テンプティ$$ loves playing with dolls too!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1002": {
      "repository_source_sha256": "5e40d6f14245fbabcb086e82303092a9afd06c2a4ac787f4dc1b4893e45cb17e",
      "en": "「I love playing with serious kids!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1037": {
      "repository_source_sha256": "d92bbe3703f620a026a9aeb3d45409458e78a32b0cfe25525601ac7d8a8cae1a",
      "en": "「Even $$異能生存体$$s die. Watch!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1080": {
      "repository_source_sha256": "ce932f8d543af5d7a997d8b563dd5bd0a937cd23275795d94f60b07c7c7b12c5",
      "en": "「Time to start exterminating $$ガンダム$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1111": {
      "repository_source_sha256": "176a22a408bdfd5b1958aa39bd591990abdf3d35d06b8e1b47cdb11874d87bec",
      "en": "「Any number of $$ガンダム$$s is useless!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1152": {
      "repository_source_sha256": "bc21b53f71f23bfd045f210333839ef367069d6947c6ed504ac614817760dd17",
      "en": "「I'll make you one of $$テンプティ$$'s\\n$$ガンダム$$ collection!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1213": {
      "repository_source_sha256": "01532eb58cf06877465a6f6cf520c1ccbac3cf6de3a191d07a2c2ad43393f6e9",
      "en": "「Beasts need to be punished, right?」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1248": {
      "repository_source_sha256": "c7dc47c7e2ede64474858538e53f42e529d59c61d38c349025ccb8eb098b75c6",
      "en": "「There's the $$始原の特異点$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1279": {
      "repository_source_sha256": "9e1c6e3ac6fed92fe45671d5fadee7894c8bddf646571eed07dbd11cc53063f6",
      "en": "「Noise pollution, strongly opposed」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1300": {
      "repository_source_sha256": "69903f3be83f15165e3b0b7af28fa9cf583dbaa897c47c85f05624b5bdf92017",
      "en": "「I'll pluck those wings for you!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1331": {
      "repository_source_sha256": "035f512052dd18b01238c944deabd36edc6bb6146744f93d6e86a1a8f1f44fb2",
      "en": "「I'll shred your Super Alloy Z!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1374": {
      "repository_source_sha256": "0286474086b0c2974aa4751ed33d2db96565c85f5fe8c0dc4bfcb10010275bed",
      "en": "「$$ゲッター線$$? Pearls before swine!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1417": {
      "repository_source_sha256": "9e929e6f31a6be1b7e1adacdb729ac2a1c05413174f983611dde10dbabdecfe8",
      "en": "「Can you fight 24 hours? No way!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1454": {
      "repository_source_sha256": "72470f58fe0c955e67cf04a7fe75c623eeda1413bf4b07304e9d7cdaf8b89f56",
      "en": "「A man running his mouth is pathetic!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1491": {
      "repository_source_sha256": "8fa0dfaebc187a6ae0d6041bd385cb5f4c0b92a7f27fbce3b665d888dcb0079d",
      "en": "「What a fool...!\\nNot even using the power of a king!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1540": {
      "repository_source_sha256": "1bbb72817430cce6b55af16c3ab95f4535fe13429188067882e85dc030f2f7c5",
      "en": "「You should just fight your wars\\nwithin your own planet!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1591": {
      "repository_source_sha256": "8288db17e432811dccdee7f715b6a14df49326e82128aefaeef5e33f3a752ff9",
      "en": "「Brilliant! That is super cute!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1632": {
      "repository_source_sha256": "eb8cf46363f1ad066356a35bcaee84c05a90e7d9dbbb0ea429da50155085f461",
      "en": "「Join the $$天翅$$s, Mechanical Angel!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1675": {
      "repository_source_sha256": "115a6a76277ce3be6969d44c94881f14b1e49a255ee5ba9533639034f02ec09b",
      "en": "「$$テンプティ$$ will put out your flames!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1718": {
      "repository_source_sha256": "ea3f9720b13ced5177ededb3ce01949087d5fc36b398a52b6cb2dbd95e71013e",
      "en": "「Effort and guts won't make miracles,\\nlittle dolly!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1773": {
      "repository_source_sha256": "74ed8e856644177245dfa805fd663daac6caccf5c7c6a0f3d85253a65799d63a",
      "en": "「Like I care about men's romance!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1816": {
      "repository_source_sha256": "6b998073f4c51dfe9e1843f4f32d8750a7407ac6d40bdc5a033c5ebc7f8fd3ba",
      "en": "「You aren't allowed to use that!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1853": {
      "repository_source_sha256": "8566c25ef28e5647f1ebe605a292f81da2a0fe806d45c3b4138dd28855569b42",
      "en": "「A soldier who only follows orders\\nis trying way too hard!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1906": {
      "repository_source_sha256": "2651d5120e66155e06f550081c5c4c71c265919c0ef688567128a5fc886f12d3",
      "en": "「I'll test how well you can\\nuse your $$スフィア$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:1959": {
      "repository_source_sha256": "e2371a862180928254be266e63665ef7c5e42b3bd2933e6e8cd7e623f4ff572f",
      "en": "「I'm taking the $$スフィア$$ back, thief!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2000": {
      "repository_source_sha256": "69d8c00aa647cce664914891ef994c49bf69287f0cb8c7281020f03dd6e3627d",
      "en": "「Trying is pointless, $$ハマリエル$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2035": {
      "repository_source_sha256": "111168d1f96d784c28c3d0240e9052bdafa3151ec96b3c41119323a1643e2dc8",
      "en": "「Cry out nice and pretty, $$ウェルキエル$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2072": {
      "repository_source_sha256": "3a26377e16154cabeea89c052b784730d2e007eb60621c6f17421c9c68ef22fa",
      "en": "「I'll snap that will of yours in two,\\n$$ズリエル$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2125": {
      "repository_source_sha256": "d8e80d4058c893984227c7bb05ff088f68d84ba5699a0e9d8af69ed2c5348e26",
      "en": "「You were a good way to kill time!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2164": {
      "repository_source_sha256": "15f273ffaf5e17038158a3c040f15ab84114dfe18997e0df399b49230c56b1e9",
      "en": "「Hee hee... Let's have fun with $$ティティ$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2205": {
      "repository_source_sha256": "fddcb7ddc268c5cca350b9ea91b2d776bb3ac03dc86ef0739ea1e1baaf67aa83",
      "en": "「Hit back when you're hit, of course!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2244": {
      "repository_source_sha256": "87ddfbe33a8a5cbf097e1b9edb976cd2b975b4eab3cc7e239842485ba637ad97",
      "en": "「How dare you do that to me!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2269": {
      "repository_source_sha256": "513171fcfb5dc989a2d794f27469d58597123c3e41d29d20dabfc2f989dbe6c7",
      "en": "「No, no! I'm never letting you go!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2302": {
      "repository_source_sha256": "a99187d68da6658100edfebadae15208488a43833d8c8ca069b8348df3cacfee",
      "en": "「Trying to run is useless, you know!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2335": {
      "repository_source_sha256": "60a79216ded4eed01d764be43bddb0888f234431ec16dfd0cc84cb38b81cad0f",
      "en": "「Come on! Run for your life, run!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2374": {
      "repository_source_sha256": "4d5fb9fb28b131c289bc931f389e386fb828e9f0186bd1574af247f74f0c8019",
      "en": "「I love shooting those who run!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2411": {
      "repository_source_sha256": "f91382878fbe9f4aadaeb627513e5f85bc11610c8fdb633a0471dcc0c8df0aa7",
      "en": "「You're such a pest, you know!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2444": {
      "repository_source_sha256": "d23911a25ce4f8ffdf1b967aba7f5528b825bd59c54a5d2b156e0ed6883c1f3a",
      "en": "「Here's a gift in return\\nfrom $$テンプティ$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2493": {
      "repository_source_sha256": "7d20518228444e1052ecca6b5debf044e0383370874ce59c3e7a24bde060fd90",
      "en": "「Oh, fine. I'll give you a hand!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2528": {
      "repository_source_sha256": "29e829d364dece65245b9484ae34d961d69551a41ada978482a4bb44b6aac204",
      "en": "「Don't worry, don't worry!\\n$$テンプティ$$ is a kind girl!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:2591": {
      "repository_source_sha256": "e077674b0608e1e7a106e658b3d05db7a813b442d28c123a9ecf946c5f96a621",
      "en": "「No way! What's going on here!?」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2630": {
      "repository_source_sha256": "71ac1f5fb4f002ad106a7c339f73427302e692effa5f586b62f36c7ee1a8015c",
      "en": "「Aw... can't even counter?\\nSo boring!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2679": {
      "repository_source_sha256": "4678786a13e3a422d46f8ffe592df23b8c668790f02b0e14ab21fe03e114bf45",
      "en": "「Being attacked one-sidedly sucks!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2720": {
      "repository_source_sha256": "da24871d9c78a1071c5a286b492e45aa394deaa06f013481bb729ae5bc406d94",
      "en": "「Too baaad! Way off!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2749": {
      "repository_source_sha256": "9e3dc17816a499e40480dbf97bc5a4ce6cf0cb6ba9af652553492ed2980d6361",
      "en": "「Hee hee! Ter-ri-ble!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2778": {
      "repository_source_sha256": "8b30b1e1040622e34d16e02a5881ce29588fb172312ede25f3cb6ba205d67f5f",
      "en": "「Slow, slow! Slower than a fly!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2811": {
      "repository_source_sha256": "785f9705e14700d237b1ebdd48b71bc52d1090035c7266df92948b0a148f78a6",
      "en": "「Are you even worth keeping alive?」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2846": {
      "repository_source_sha256": "bfe606e3d2e13c9baaed19025bf7a9ba2a354125a9786ac72ca41abe072f76b3",
      "en": "「I can see through attacks like that!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2887": {
      "repository_source_sha256": "8ada23b52d2dbbe782aae94e6345dff1f3c626b14c052c61eb9acd5b23bc3a59",
      "en": "「Hey!\\nWhat if that had hit me!?」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2940": {
      "repository_source_sha256": "2eb84efba7f8945348b7adfaf15fd586169df4b2050bad7dcbb4c26025bbf594",
      "en": "「No, no! I won't let you touch me!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:2979": {
      "repository_source_sha256": "9ca7541b1c995b6f590bab1ad8430000360cb1e52d1f98e784bf55563bbb040d",
      "en": "「Attacks like that are pointless!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3014": {
      "repository_source_sha256": "cefa4a80a81251958d00c525d19ee6be102def787d227260d4fcff4100e68efd",
      "en": "「Take this more seriously, will you!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3051": {
      "repository_source_sha256": "f4e827a666f6fbe31350cbb75d458c5a111434cb1cc5b592aea068e2e0892695",
      "en": "「This isn't any fun, fighting you...」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3088": {
      "repository_source_sha256": "01caa54f0884c85b1f1c0d5eada99d7029e77b15ae40a1da3213e698521b449c",
      "en": "「So close! Almost a direct hit!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3131": {
      "repository_source_sha256": "fc1ed26b00c9975b90436282d6a5f502e5d1ae51bfd75e616bbea1e16c375ebf",
      "en": "「Hmm... you're no match like this...」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3170": {
      "repository_source_sha256": "e2c539d3c2a942c0e5d13568f790ce00682c15aa9226509352f1ea76364ee9b3",
      "en": "「Huh? Whaaat!? That was an attack!?」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3205": {
      "repository_source_sha256": "9456d557c531c0fe4bf2675c1144656a778248a3fe0ee416942c692b63357da8",
      "en": "「Don't you get it? It's pointless...」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3246": {
      "repository_source_sha256": "fe08ceef68897c8c8fe2fc71e38a6e3cb10b7fac0776bbc3547671b4db28a8c9",
      "en": "「Aw... I expected so much more...\\nWhat a letdown...」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3295": {
      "repository_source_sha256": "3e5b3743440e63b31a9589ff6a0a9843026b09db1ee21adf7a57cdf6badce7f2",
      "en": "「Come on! Go all out, or\\nI can't have any fun!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3354": {
      "repository_source_sha256": "7de110159976cbc58f250cfd303042579806e8e0cfde217a99cbe51df0055bcb",
      "en": "「No, no! You haven't mastered\\nyour $$スフィア$$s at all!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3407": {
      "repository_source_sha256": "503799096b87b97a16ce179a47009d8156d1cfa3ef9c5bbc68a607ddd3dbcc17",
      "en": "「Honestly! With that, your\\n$$スフィア$$s are wasted!」",
      "source": "new",
      "slice": "v_g052_01"
    },
    "52:3464": {
      "repository_source_sha256": "4631d48417306b17bca1bdf342ddc0c76c7579fcb4591dde4ec60797b42adc00",
      "en": "「Yes, yes, that's it!\\nThat's how it should be!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3515": {
      "repository_source_sha256": "7d39783d270bc11644543d66be7dee12c6e07c0d74872444b016b502aa8559cc",
      "en": "「Now it finally feels fun!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3558": {
      "repository_source_sha256": "b0f8fae2dcdb5ea39c0b9ab08e8d9d756b256480f4ce69efd7c6dbc930be0e56",
      "en": "「Yeah!\\nIt's no fun unless you resist!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3607": {
      "repository_source_sha256": "0995c2dee967d58951b2c96aa4418dcfec5692e091f4f4815dfab907ef4a9415",
      "en": "「Nice! You've got the full set:\\nignorant, reckless, rash. A fool!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3672": {
      "repository_source_sha256": "cb441caf8851d5794285ae132ad8f543750172d37ecb60a17d73c06499c12a46",
      "en": "「Hmm...\\nAm I getting pushed back a bit?」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3721": {
      "repository_source_sha256": "1e2b63c51d105c91baf12198b53358c1a690851c65424e4f0fca0bcc3159424e",
      "en": "「Amazing!\\nYou can fight $$エル・ミレニウム$$ evenly!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3776": {
      "repository_source_sha256": "ff5f1952052647565494ac337d71e8aa04f37a24cff00e2878a87d5f638c5bb1",
      "en": "「Not bad, you!\\nNow it's getting fun!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3825": {
      "repository_source_sha256": "b8a0845b319c3f5f74d5ed636488cb19c017fba122e00f84393c2aa7959fb219",
      "en": "「Oh no!\\nMy heart's started pounding!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3874": {
      "repository_source_sha256": "1d49edfb8b999c244cfb9e0d996e1aa81e94202822fb4f3bab5b41c1ea6f1142",
      "en": "「...Aren't you overdoing it a little?」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3917": {
      "repository_source_sha256": "ab16d1d6ba589734706f6f93232bc1e72d0202dafff08d8ee1e73dc756db3ba3",
      "en": "「Huh?!\\nI've taken quite a lot of damage!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:3968": {
      "repository_source_sha256": "03f5f990f4169427b2dde36f861d6330f4e189eb73a628786702dba7d1323a10",
      "en": "「Hmm... What do I do with this...」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4003": {
      "repository_source_sha256": "3d342f034944af2f9783a7fd5157ec1a058448831ba871c0e8c395731ad22dc2",
      "en": "「No way!\\nBut $$テンプティ$$ is controlling it!?」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4058": {
      "repository_source_sha256": "076f05235e7ee9030a8edb8e31be8f0dfd8e7fb36947599d7d71327ad61715ff",
      "en": "「Boring! Boring, boring, boring!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4101": {
      "repository_source_sha256": "5ca9b2df7af0f3d5d666002904f2abd5cebeaded0513c319b6d219c4c782b1b3",
      "en": "「Come on! Move like I tell you,\\n$$エル・ミレニウム$$!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4164": {
      "repository_source_sha256": "208159166bdd7340784e8aedead00f81d97b8893b0798e25dae1369baea3d198",
      "en": "「What's going on with this?!\\nThis isn't fun!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4213": {
      "repository_source_sha256": "9c3f636330de82b87a51a7b54bdaa088bdc451321612b1af802b6b7dbc095ca7",
      "en": "「Awww... Maybe I should go home...」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4242": {
      "repository_source_sha256": "3ae88b24f436932c27d790713488118311ee3bd68f38617a018201f04be6d970",
      "en": "「Nice one!\\nYou're a real $$スフィア・リアクター$$ now!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4299": {
      "repository_source_sha256": "42688f9e24c33155ad706218d551f06357edb73da590231b128ccd5030bc1d32",
      "en": "「Nice growing your $$スフィア$$ this far!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4342": {
      "repository_source_sha256": "94fc01a662cd7336444eb961d0ba72cb29d72a40ef9a9069986eb3e7d5debb15",
      "en": "「Time to get that $$スフィア$$...\\nback from you!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4397": {
      "repository_source_sha256": "366b301930d5a4849c1e0e69feab2fd5bcf84f7339c85afbad4a95ae20f89553",
      "en": "「Awww... I lost...」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4424": {
      "repository_source_sha256": "1a08e174770fd4679764653e978dcdf68b792e171c10482796fc52e56c603f54",
      "en": "「Ha ha! That was pretty fun!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4457": {
      "repository_source_sha256": "8691ffc1f5ab61e286f0cd8eca60982a512952fd68d2d8639e7900cf9989fefd",
      "en": "「Hee...! Playing with you was fun!」",
      "source": "new",
      "slice": "v_g052_00"
    },
    "52:4500": {
      "repository_source_sha256": "5da8773d076f5cb31e7d401823ebaa16b0604251ab6bb1ebc4ece646cda31fb5",
      "en": "「Not bad! I'll praise you, Earthling!」",
      "source": "new",
      "slice": "v_g052_00"
    }
  }

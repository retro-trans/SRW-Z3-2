  },
  "lines": {
    "56:0": {
      "repository_source_sha256": "aef259577475face14c7bfe82f445fcdbd94e2502e3b4fe4c4f6a6fadf516ed5",
      "en": "「You have no chance of winning!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:27": {
      "repository_source_sha256": "f6cb28eb24300783305fe1b921939171da58a39b22a26e3f046eb13988b5f208",
      "en": "「Everything will be in our hands!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:50": {
      "repository_source_sha256": "c5124de2ae462203e9e52fa769f0db112d333df87d683c7b6d8b16caa85278b7",
      "en": "「We shall pass judgment on you!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:75": {
      "repository_source_sha256": "c202e1559a79e7ddc2903e0366828181234413f026b80b16f42ea4cd5e371ead",
      "en": "「Life instinctively craves evolution!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:114": {
      "repository_source_sha256": "f61e7d5170170af14c46de2f1b050a88ba42ef91ee14767786d41af9b7230dd3",
      "en": "「Hee hee hee hee hee!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:133": {
      "repository_source_sha256": "67b7f0c417dd7ad8ff6d320fcbc06d56126dac52163b6d167f3a815535d08f05",
      "en": "「And we are the only life form\\nthat will rule this planet!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:186": {
      "repository_source_sha256": "ff1105efa0500bfa0ed87d6e00ee15be59f6a9da1fd7721a92506dce9d3d7524",
      "en": "「Y-Yes!\\nOur new evolution begins now, right!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:239": {
      "repository_source_sha256": "aef259577475face14c7bfe82f445fcdbd94e2502e3b4fe4c4f6a6fadf516ed5",
      "en": "「You have no chance of winning!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:266": {
      "repository_source_sha256": "ae5a3cd0087a9a0d217903b3fe4bb26e057b70606f8f13ec89eb88b7168252d8",
      "en": "「Y-Yes!\\nWe ought to teach them, $$コーウェン$$!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:323": {
      "repository_source_sha256": "f6cb28eb24300783305fe1b921939171da58a39b22a26e3f046eb13988b5f208",
      "en": "「Everything will be in our hands!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:346": {
      "repository_source_sha256": "b27c4eff2aad0f50e17716fdc45fdcda629a919f87efa4cd78c63919a95826c1",
      "en": "「Now learn the true meaning\\nof the $$ゲッター線$$!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:399": {
      "repository_source_sha256": "e58b77d5aa856de6b771c6f27bc3ffaf4309ec0e3c689c1d7d7b84f111fe2493",
      "en": "「$$ゼウス神#pilot$$'s light pales to $$ゲッター線$$!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:442": {
      "repository_source_sha256": "d9e58282c5ad73a8d8133bbb433c3d61229c9c306815314ecc1211c10352f7bc",
      "en": "「Mere beast power evolution forgot!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:485": {
      "repository_source_sha256": "6c91f291269e12368096fbf91efec39c598a328fe396360e66bb744b90d0c275",
      "en": "「This is what 'asking for it' means!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:516": {
      "repository_source_sha256": "3be97516bf36d35a2ad8130d8391eaa38526288eb714b0f7267a2e2e60958af4",
      "en": "「That was a grave mistake!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:543": {
      "repository_source_sha256": "d05864cc954020db5a09e9ed173fe3a40737e57a353113f03001257c5ab25977",
      "en": "「Now, time to hit back!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:562": {
      "repository_source_sha256": "f54b22a6c84074f019accf0335cbdb7efaed675a85bcd2c303accdbba36c9b87",
      "en": "「Don't get in our way!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:597": {
      "repository_source_sha256": "9f1b166b33273a3a28b053ab7529a0e4d1f698a7d78950728f2f015f85e4de0c",
      "en": "「Mind if I join in too?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:632": {
      "repository_source_sha256": "b1905af9106f6f7a00ad03b3a31cb1e19d7ae22e9ab7284b0ebdd91baf0704de",
      "en": "「It's all right! I'll protect you!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:669": {
      "repository_source_sha256": "174901eea88f3f73d6829621691ee870959332355d06564a0bcbe74c0181fb3f",
      "en": "「Why...!? Why can't we\\ncounterattack!?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:724": {
      "repository_source_sha256": "a444118bc56f9c60786042f5438fe36156531b5bfc35d6e7351b4c61b2499c77",
      "en": "「We ought to just watch, $$コーウェン$$.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:767": {
      "repository_source_sha256": "cfd689d3d01ae80cb81d38a1a232653181b736ce3d3adc8a6c59927b00d77561",
      "en": "「Damn! Did we overuse our energy!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:808": {
      "repository_source_sha256": "05413258f80c457527db745033d9cb84e7beb5a70a41405ed19a8070f6b067fa",
      "en": "「It's lonely with you\\nso far away...!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:859": {
      "repository_source_sha256": "6e4de4e61c0f46b7f9a75aa6a98423bc0575a240ffb755716c8a1ba1fbfe97d5",
      "en": "「Yes, yes, that's right!\\nCome to us quickly!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:912": {
      "repository_source_sha256": "21948df5c40fc60cc63c15b18ade38a8442f06e63a2ba5dcbc1487abccea69db",
      "en": "「You don't seem very intelligent.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:951": {
      "repository_source_sha256": "42569a32bcef57ce1d05621ab1e88e9f6fed94594590a31e4765d66dbf950e0c",
      "en": "「Don't you need a bit more ingenuity?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:992": {
      "repository_source_sha256": "2346a76124874090fd0c3fc6dd12fd7309145f8407f15a8ff713651e075a910c",
      "en": "「Humans are always like this...!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1025": {
      "repository_source_sha256": "32d30e8091677455bd80a2857fad0eb11fa83c7ff19f55cac586e1db8703081c",
      "en": "「Attacks like that won't work on us!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1058": {
      "repository_source_sha256": "f5f6a16f46bda3d6e987c6d8faf8a0669795ec9547ded8baa5ab4ee0d4735c6e",
      "en": "「A miss! Ufu! Ufufufufu!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1097": {
      "repository_source_sha256": "382a2ce5d558879e8dec4b5c7f06b9bb34b4169c21ce790a5e65fb35ae3c3daf",
      "en": "「We know Getter Robo\\nvery well, after all...!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1150": {
      "repository_source_sha256": "4e0447527270a0476677d16f900c377ba2c9362d6b8070365b5d29297c23ffc9",
      "en": "「There is nothing we fear, you see!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1193": {
      "repository_source_sha256": "c9459c6b084718a5b7eb41b921d35e959c0c43a76833abb5393a964f6bc34024",
      "en": "「Ha ha ha ha ha! It's useless!」",
      "source": "jigoku",
      "slots": [
        "barrier/field block",
        "no damage"
      ]
    },
    "56:1222": {
      "repository_source_sha256": "f57592d2bb047bc3099b3c8816342241cf94b9da5b94fa99d42959b180ea1e0a",
      "en": "「Looks like this is your limit.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1261": {
      "repository_source_sha256": "5afa50dabba800c897be1eea41e59175ae4374d80c2e5d9d0280913df8b3bd8d",
      "en": "「You know it, don't you?\\nThat you have no chance of winning.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1314": {
      "repository_source_sha256": "2e096470063b9ebec76f4da922c058e8ccdddcdd0c19584fcf68ff65e9e4c5a3",
      "en": "「Why not give up?\\nIt'll be a relief. Ufufufufu!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1369": {
      "repository_source_sha256": "b8371e245ed450d0d012da1d8899d4622fe64157eb47afd434c8a30b495798d5",
      "en": "「Blessed by infinite $$ゲッター線$$,\\nwe no longer have any enemy!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1436": {
      "repository_source_sha256": "80cf4d7478fbc1a7a889ac19052b3278cbb6fa544d6ec12324e1b88a89fa6c53",
      "en": "「Y-Yes, you're right, $$コーウェン$$!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1475": {
      "repository_source_sha256": "eff1a5397f60d3bb2daba766d575d7b0363c2ee1fd3f9a879482de59dd3d994f",
      "en": "「Looks like that's your limit!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:1512": {
      "repository_source_sha256": "a3c97bdeecae6f9712e8123921f94600224d24331c488a8feedc05ada5811b22",
      "en": "「Seems you don't know our life force!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1551": {
      "repository_source_sha256": "9d7584e458b8788a44881c08e9bfdf71c05a9594f2ddaed56ce21b4d4accab8b",
      "en": "「That was rather violent of you!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1588": {
      "repository_source_sha256": "99bdd0ff300d5ea3781f546ad37875ea89839934cf7f793e71181f534c84e020",
      "en": "「Dangerous...! For ignorant humanity\\nto wield such power!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1653": {
      "repository_source_sha256": "0095f75f06a7c94b0bcadb6872d67019fb2aa1e9264165301938f103aced2215",
      "en": "「They still haven't realized,\\nhave they, $$コーウェン$$?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1706": {
      "repository_source_sha256": "27bce48704447d1d2b281e1e746d1adc8b6b5bfe26b9a2e3236cc6520f11297b",
      "en": "「Humans do nothing but\\nthrust weapons at others」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1761": {
      "repository_source_sha256": "3d296bcc1fed501ea3204e66a58b24476e7ebf78cb793d351d86ad8eb7583012",
      "en": "「Y-Yes!\\nWe can never be defeated!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1814": {
      "repository_source_sha256": "a6bc6ea1a64b40c4f526f08926a5c3b2b621c6a8dcc1caf13adfd239a5f1c949",
      "en": "「Here's what I think...!\\n$$ゲッター$$ is too much for humanity!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1883": {
      "repository_source_sha256": "83f827b06fd4098adde453636e4337cf7b41b0ed3bd6c4aeda00f1188acc8598",
      "en": "「Yes, you're right!\\nThat's the $$ゲッター線$$'s power too!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1940": {
      "repository_source_sha256": "44f46323bf9fbd2c64c4eecdb97ea21c2a5c9411fb8cf103eb773030d7555e36",
      "en": "「Yeah, yeah!\\n$$ゲッター$$ Robo really is strong!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:1997": {
      "repository_source_sha256": "ed8ca46fdffe06b11e34d50f26accd852e2eb2ec22f62f71a3aa95ea6837454a",
      "en": "「Outrageous!\\nYou're doing something outrageous!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2054": {
      "repository_source_sha256": "531f5f289f12ffaaf7e832123eced6e75416da1b65b73a76b5a02168875988e5",
      "en": "「W-What is this!\\nWe must reassess our view of them!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2107": {
      "repository_source_sha256": "b4bf97519ac4e9632b8c45a488c8b4213bdfa384be7751e09575e4b71b49f6be",
      "en": "「What could possibly be driving them\\nthis hard!?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2166": {
      "repository_source_sha256": "2a67a7c92c55519c4c062c7cfcddcad1af6509e45d3589c719e7bd90b13b9641",
      "en": "「M-Me too, $$コーウェン$$!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2199": {
      "repository_source_sha256": "56a44cc148364863f45a6b05d6685ff3eb0f3d3b5110e3792a1a0a8f6759e680",
      "en": "「The instinct of all life: evolution!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2240": {
      "repository_source_sha256": "4f659bd51e5299f4c40ff8b70aecc72e374c11d3ee996885793d3888fcbd159a",
      "en": "「Y-Yes, you're right! We must!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2283": {
      "repository_source_sha256": "fe485a24b8457c10bc1de7bbdbd503a2c26e430f800146266bcfbc060fe12a46",
      "en": "「You mean to\\nturn that into despair!?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2334": {
      "repository_source_sha256": "e682f10529a5b6001d330e5052c5129aaa3f91d91d937fa018b79c370d43a306",
      "en": "「T-Too soon!\\nI'm still evolving...!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2383": {
      "repository_source_sha256": "4fc01a61c4ecb03923717f2207d2e433a8a690a03b2ad4bb588ea975ab3b7937",
      "en": "「What's happening!? This... this is!!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2426": {
      "repository_source_sha256": "ac422c1a78c6a5b1dd63a54ca596587785913ec8e4e3411a070b18696fecd985",
      "en": "「Our race is eternal!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2451": {
      "repository_source_sha256": "9d24ef25af969ac0528863497c1f635ad8e425d476d90f323feeceb602f77b0d",
      "en": "「You took good care of our kin!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2488": {
      "repository_source_sha256": "05d8bde60f5a6720cbc0337dafd0d45a688bf0a90cd5a43c2958f5d34923d908",
      "en": "「Heh heh heh...! Farewell!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2519": {
      "repository_source_sha256": "b470c450a23bca40125529a265fe37b4485f79ee2cb4a67affeddf6c3bb1797c",
      "en": "「Now, take this!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2546": {
      "repository_source_sha256": "bf262ef2858dae2d6cdf2af4ea3d4290d4fcc930a8a7a65231e8f177fc9deffe",
      "en": "「Learn your powerlessness here!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2585": {
      "repository_source_sha256": "24afeb43b06c8a0d5bd4c224b9a38e0cbebf2ec0190682abe212ae9437eb9ff7",
      "en": "「Vanish, for the sake of our goal!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2624": {
      "repository_source_sha256": "15beaf671f7c0ed82835f0baf807189497993d1ac2c1755665c2cb202d47ac6b",
      "en": "「Feel the power of evolution!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2657": {
      "repository_source_sha256": "38e878a76846239fe11f06dd8758d2cb4b7f37463e6d6c944e95c86015e053a4",
      "en": "「We are life forms on the endless\\npath of evolution...!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2708": {
      "repository_source_sha256": "2ed703a9d391cee4c809ff238738c6e057699f20459fd92f30cb7fac59047e35",
      "en": "「At last, the world's last day comes!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2747": {
      "repository_source_sha256": "5a155bb7ae43e3e5235891b6ccbdc6bf7adc4a63969c428f3cd67caa1a86379b",
      "en": "「Become dust in the cosmos!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2774": {
      "repository_source_sha256": "2fc301f33fb7843152e0166b1c3603e07f186267f0e7d783c545cf7e78ffa013",
      "en": "「$$スティンガー$$!\\nShow them the wonder of evolution!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2827": {
      "repository_source_sha256": "bf7b8c16d3e3cc3337faba3bc392ffaf51a0e9d427a73196b037408a729e3ade",
      "en": "「Yes, this universe and your lives!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2860": {
      "repository_source_sha256": "7bc093bdc51f45348d5ff84ed98198c4b38ca19212c755ace65b336a2802e356",
      "en": "「I'll make sure you vanish here!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2895": {
      "repository_source_sha256": "3dad5181de67b964ecfa53a465a9b3680ad24a79ae9d83bacb16355b516d50ca",
      "en": "「Open your hearts and join with us!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2938": {
      "repository_source_sha256": "9b7f574073074ee32f0f4961fb8a6442c94babbab32c427263ba398ad081d4aa",
      "en": "「Now that we have evolution's power,\\nwe've no use for spiral power!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:2989": {
      "repository_source_sha256": "bb8bb72058d57692589887c7ec969f2f2d18a001eaeaed30a4355f657b0300e2",
      "en": "「$$ゲッター線$$ decide man's awakening!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:3032": {
      "repository_source_sha256": "8c1232459e79ab6599a1a5acdb07674190910dd3e2fa96b77ae2c54e444e4708",
      "en": "「You must face retribution」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:3063": {
      "repository_source_sha256": "60a8d398feb384cde4d815064fd2d9e81c5ca1ccbb7ff7dc0ea11a5f798f85fb",
      "en": "「Now, allow me to show you my power」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:3096": {
      "repository_source_sha256": "89cd5d14ff0baa7cb49222b17ac8e1b0a63cddb867b218f66c24e500b38dbb38",
      "en": "「Wait, where are you going?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:3135": {
      "repository_source_sha256": "fdc1b6d1a6390a824d5bbecfb7b51f04b7defb577a2a0d63e74d3cd93f52fc09",
      "en": "「I've grown tired of your face...!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:3174": {
      "repository_source_sha256": "2c5d2d90853c4b13f31cf1ab32d2c30e059342a62e9aa76a16afbf7157c55800",
      "en": "「I see... But no cause for surprise.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3215": {
      "repository_source_sha256": "b214c2f5d3616968809de94f4af231d002f96ddf9445c92245aab25916cbf7a9",
      "en": "「Hmph, never mind.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3234": {
      "repository_source_sha256": "bad0b52eec64f3cd230c9e5e70bfe8ad5353860ef0b75a5e809a48171bc0b424",
      "en": "「You standing there is trouble for me.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3277": {
      "repository_source_sha256": "9c6a67ae324e4b623be815dffc08041020ed8d794ada0cdb77628160445e4675",
      "en": "「What do you think, $$スティンガー$$?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3308": {
      "repository_source_sha256": "6847f643defa18c682298dbb8bbc3b28f5565c2b438e5a8cfed9eb2a845d5e23",
      "en": "「You shouldn't be way out there.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3345": {
      "repository_source_sha256": "6fb57d2e0ffce53b180bc74282e300427db319b0102c6d335655591bec631d99",
      "en": "「Why did you think you could hit us?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3386": {
      "repository_source_sha256": "e06f4437593a19867cdbc6b7ef1a3f9109402868582597bc13b8a0b2973e720b",
      "en": "「Predicting thought patterns\\nis a simple matter.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3435": {
      "repository_source_sha256": "bbc7aeb9138b3ee6f12a52bcf838f130aec1b0c6923ba6f355384a611e343bc0",
      "en": "「No good. You must aim properly.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3470": {
      "repository_source_sha256": "fcade59eb9d6627b188ddda14997430db5166668b2983557973a3d20b8057618",
      "en": "「Not against us, who keep evolving!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3497": {
      "repository_source_sha256": "83f16da460a1ac22decd2156f65a21d31a6582309b64b277d25f9b79e617c738",
      "en": "「Wahaha! Y-you shouldn't laugh,\\n$$スティンガー$$.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3554": {
      "repository_source_sha256": "1ee5e627cc68af2d27c4b5465fad6a3bfd1957448229903fdedd69011063cf48",
      "en": "「We've outgrown even Getter itself!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3597": {
      "repository_source_sha256": "dfc0e77ffc7354b9876832fa3ea652e68b7dbbd6765adfc069117417a557db65",
      "en": "「This much is no trouble at all!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3636": {
      "repository_source_sha256": "edfe8dd92b987a78f1b9f85e3f9114c8713aa7b7065c0c0ca182db126be773bb",
      "en": "「Ha ha ha ha ha! It won't work on us!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3671": {
      "repository_source_sha256": "2407756a0357c75a09a6bdfe88b5918cf64502305db749a7a0cd5a781a0ee213",
      "en": "「Do you know what \"futile\" means?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3712": {
      "repository_source_sha256": "294ae75065c108949fc48d3fa4d8e815bda71e30fe7dce38c53a4f9ef680e08e",
      "en": "「Such an attack is nothing to us.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3747": {
      "repository_source_sha256": "cb2755ce8d9e6a0f54d367de289b8fd6c1e9b19a8b438f9c4f0cd9bbb65f8849",
      "en": "「Wahaha! Child's play!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3776": {
      "repository_source_sha256": "3cbb1f8a1174181fb01135246f3c005609aefc15a1cadb52bd8e417d3711ba59",
      "en": "「It's all meaningless!\\nIsn't that so, $$スティンガー$$?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3829": {
      "repository_source_sha256": "a4a204a09c05770f1f1833873e09ec7c5831ec9da4d77caa22a7b55146be6d6d",
      "en": "「Now they must have learned\\nthe hard way about our power.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3878": {
      "repository_source_sha256": "64fbc3737ccdc73644dba264ef4c5e16b9816e89345fdbc7ccbae6086287b832",
      "en": "「How futile...」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:3895": {
      "repository_source_sha256": "a95330c6318b2c5e256d11623098128677bd4e95a08e35da98f5eb57537ca286",
      "en": "「You'd best not underestimate\\nour power!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:3946": {
      "repository_source_sha256": "72b18c88bca121a46557324dfc8bdbd6801a1e9498480479c25f0d154469e769",
      "en": "「Still resisting...!\\nFoolish, puny humans!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:3995": {
      "repository_source_sha256": "ee13cc99c1af1879fac5565f4317d1647bf6bbd33cc2e4c013fe1a60774f5261",
      "en": "「Fool! Same result every time!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4032": {
      "repository_source_sha256": "ad25f747302e2c646302db7fc2082a415d8ca47ed287a3069fe20d131ea947bc",
      "en": "「So that's why you repeat\\nsuch pointless attacks?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4081": {
      "repository_source_sha256": "5439ad3eb8d96460fc8b3757e9ac79d8d3422cee827d12dfdaed3a3f227650cc",
      "en": "「That's why you still can't grasp\\nwhat the $$ゲッター線$$ truly are...!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:4146": {
      "repository_source_sha256": "f744025cbe1b447c5fe11b6c04daeec27941e6f30121d1ad69471c8e070ae7fd",
      "en": "「There's nothing to fear.\\nIsn't that right, $$スティンガー$$!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:4197": {
      "repository_source_sha256": "be60865518df4cbfaf3c493503bc6f44f3355afcb264c26c3a89075fef039c22",
      "en": "「As expected of Getter Robo...!\\nThat power can't be taken lightly!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:4250": {
      "repository_source_sha256": "75890f6ccee960827218ad1a881f357a1785657df8201f214948d9fb7e8526c8",
      "en": "「What fearsome power.\\nYou think so too, right, $$スティンガー$$?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:4311": {
      "repository_source_sha256": "3d607e8f38111121094978f4edc3b9a135e160e89ee3853490b839cd0f3c2c78",
      "en": "「Why!? Why are we being\\ncornered by mere humans!?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4370": {
      "repository_source_sha256": "d946793612a5848853175b618fb75eecedba33562b0808d86af8250f12dd7a8f",
      "en": "「Wounds won't heal! Can't keep up!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4413": {
      "repository_source_sha256": "ba7f677a22c7469e973bf12b29dd6a35b4f48ef92bd485f2304e552149f9fa09",
      "en": "「Graaagh!\\nTwisted evolution must stop here!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4472": {
      "repository_source_sha256": "3a6520100fae7abbb42524f14b568706587a0aea1d71ba39108430df107470cc",
      "en": "「I-It hurts! It's agony, $$スティンガー$$!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4515": {
      "repository_source_sha256": "2e6dd791f1e28f137957452ddb3bc79419621da74c891b3aa46c6efb3cd942ce",
      "en": "「Why do you cast it away yourselves!?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4552": {
      "repository_source_sha256": "e9383c3011982677f93ce947b3d018eb6cd3b1a68d8ef38614bfa4498aab8eca",
      "en": "「A formidable opponent...!\\nWe must dispose of them at once!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4607": {
      "repository_source_sha256": "8983c2cbdcd3b019b2423b3477d667bc60908071ab7f6a3bbe29a11128a713e7",
      "en": "「The $$ゲッター線$$ are our hope!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4650": {
      "repository_source_sha256": "9988ba46c69d54c3b3a3c23c14ed1b0a0413de78ec282f416106a253f4e5fa1a",
      "en": "「M-My body! Raaaagh!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4687": {
      "repository_source_sha256": "2fe23ef591835be91819fd02abb4e076e4d98a1cf4c8104bbc9ac797a087d0a6",
      "en": "「Impossible...! Raaaaagh!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4722": {
      "repository_source_sha256": "33288eda886694b3468921083b8a6dd7f325c45f0e2989fd05db7a8a076bf156",
      "en": "「Don't think this ends here!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4753": {
      "repository_source_sha256": "864547a15fcae415b33e8c65c2a99bee097abb2070ad1bce0e2052af76e60da0",
      "en": "「Raaaagh!」",
      "source": "jigoku",
      "slots": [
        "attack",
        "counterattack"
      ],
      "alternatives": [
        "Raaaaaaagh!",
        "Raaaaaah!",
        "Raaaaaagh!",
        "Raaaaagh!"
      ],
      "review": "conflict"
    },
    "56:4774": {
      "repository_source_sha256": "5acbd2090ee36ac3eb6b24b8663bff1b9a30cdbbd5ca7e4dc833474c55ff5582",
      "en": "「Wahahahahaha!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4797": {
      "repository_source_sha256": "387bf07fde992d26ff3b164ded2fd6d015a378287cb7c3abd34dafe36c25f249",
      "en": "「Behold our ultimate evolution!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4826": {
      "repository_source_sha256": "e3887b0e838c97a333172b7b9d8b6e36efd37772af4d64a227cb83ac5621ccbd",
      "en": "「We live alongside the $$ゲッター線$$!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4863": {
      "repository_source_sha256": "19da6a08c4520878d8587956ce55c4baff865ed51213c1231276a456165cd2d4",
      "en": "「Now, accept! Accept our souls!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4904": {
      "repository_source_sha256": "12f4d4fb847d86074f5e05a8140aac30ae50857faecee0cba125767e1a1d1530",
      "en": "「Farewell, $$ゲッター$$ Robo!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4933": {
      "repository_source_sha256": "e721d5d542650fa04f645ee6fdcc8b052a854ae7c7023eda75e3f8f4402cc1b5",
      "en": "「So you came to offer yourself up!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:4974": {
      "repository_source_sha256": "e7ffd69eb8e4495397b90a5739411a5ec62121f182b1bb1d7dd8d8608b7062a2",
      "en": "「Stop resisting and open your heart!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:5005": {
      "repository_source_sha256": "d23686cacb3f688b95215846fa89fc78b9df65187594044e1ea05d7e5dc8b624",
      "en": "「Enough! Behave yourself!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:5034": {
      "repository_source_sha256": "67ab1a0d96f8225bcca0bd3d9c1d39987a8a42da8060d93844a2eaf135ca07f7",
      "en": "「Nuuh... outwitting us, are you...!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5067": {
      "repository_source_sha256": "a45468ca16efa8933007f4daa5ff14f87ad747b4975975fe43d9f447bbd9e4bf",
      "en": "「We should have infinite $$ゲッター線$$!?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5110": {
      "repository_source_sha256": "76330fd6576683235e846fdc81430d47776e7887693710d3084c9e9cbfbe18df",
      "en": "「We have no intention of fleeing.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5149": {
      "repository_source_sha256": "fc446a9193370344b863d3e6836f6fe4836d70ef0125c5405afc3d4fd0ac4011",
      "en": "「Ha ha, fear has spoiled your aim.」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5188": {
      "repository_source_sha256": "6b1b91fb330db20f8b77501423c5369e83226e05fe015239318d8d552f9c0533",
      "en": "「Think you can beat us, who have it all?」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5231": {
      "repository_source_sha256": "826fd8cbbc14d51e681c40b5135df980ecad6f22cae009731767133dba111af5",
      "en": "「Understand? The beauty of evolution!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5274": {
      "repository_source_sha256": "00c6f9c89994eea6132738ba93aaf1030533636c192f50a01c4645fc083a6660",
      "en": "「Before our power, even Getter Robo\\nis no better than dust!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5329": {
      "repository_source_sha256": "2851a8978fa36c294a2e18df5e5c7a96d0d5fa2055cb54bdf945c94299706b86",
      "en": "「Nuuh! If you keep up\\nthis pointless resistance...!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5382": {
      "repository_source_sha256": "5bfa7722643e006002f563b6eb44801a89197b3bc57a84d4cdbea557a6bb49ba",
      "en": "「Why do you reject us!\\nYou are our kin too!」",
      "source": "new",
      "slice": "v_g056_01"
    },
    "56:5435": {
      "repository_source_sha256": "99d8292a02cc5e843883c12d8204f9ed6ca9bef208cbe6af59823f8a047d9e57",
      "en": "「Raaagh! What is this power!?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:5478": {
      "repository_source_sha256": "0a96ae5b87bc1ee7d6311df1e8fc621ddae8c7a667e3730d26831ff1b8f8ddfb",
      "en": "「How foolish! Why refuse evolution!?」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:5521": {
      "repository_source_sha256": "b9a3864cca7e69e4e66552bde4f4953f5e174ad58065fae605276d2cf39eff39",
      "en": "「Guh!\\n$$ゲッター$$ Robo, damn you!!」",
      "source": "new",
      "slice": "v_g056_00"
    },
    "56:5570": {
      "repository_source_sha256": "90ed07aaa00831b28de085b93a328d3107ac870ae73a1bc34712f7468b54dd75",
      "en": "「Aaaaaaagh!」",
      "source": "new",
      "slice": "v_g056_00"
    }
  }
}

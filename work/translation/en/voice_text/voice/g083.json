      "repository_source_sha256": "4be366320ebb1f1949c6c8e9442b4af5ad4251e697232d843e76be35d10db58d",
      "en": "「Perfect timing! This one's mine!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5573": {
      "repository_source_sha256": "0aa93030b9139b3729ba9504a6ecde2ad7ef73414b7e73130a0843c35fd1957c",
      "en": "「I won't let this chance slip!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5604": {
      "repository_source_sha256": "8a03a17fb8001eb8ce52859ad10eac42999de136c0121674cae7bae3ee874bf1",
      "en": "「I won't fall for that move!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5635": {
      "repository_source_sha256": "03d0bbed98700f79cf56801fd7bf6b1d3726331f409faa3cfda19082fb529f62",
      "en": "「$$ジャミル$$ has been coaching me!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5678": {
      "repository_source_sha256": "0d35e4545b4028dddb4794367bbac80955ebd08fb3cdc0f96d5a86d320e2737d",
      "en": "「You won't lay a finger on the fleet!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5713": {
      "repository_source_sha256": "8a6a7ebaea2bb35cf1050c144c00c327f1c073f07fe5053be131c0a7c079c4a7",
      "en": "「$$ティファ$$ is in the fleet!\\nI won't let you through!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5762": {
      "repository_source_sha256": "e528750ca1682c148f8a52111a883c45b70673dc545a1b2414a4cd238523c876",
      "en": "「Go down!」",
      "source": "new",
      "slice": "v_g083_01"
    },
    "83:5781": {
      "repository_source_sha256": "d129a3266753bc3f1ec0496a80b10b64d7782f0daab8312d1c1069152a8d888d",
      "en": "「Take thiiiis!!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:5806": {
      "repository_source_sha256": "10bfd22e74bfaba1d86b66aa0751e1edc5fd95b3e5c4631b59d212fde100f14a",
      "en": "「This is the end!!」",
      "source": "jigoku",
      "slots": [
        "weapon slot 3"
      ],
      "alternatives": [
        "This is the finishing blow!!"
      ],
      "review": "conflict"
    },
    "83:5831": {
      "repository_source_sha256": "ac59825b3e3d1a1e1c5aade48728ab7100378bf490d7a2f24eca9b8c11eba983",
      "en": "「I won't be swallowed up by\\nsomething I can't understand!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5884": {
      "repository_source_sha256": "1efc6ece6c6fbc4e639718520888f526f03c7067301cf8dac0ecf481f15ee466",
      "en": "「We'll hold till $$刹那$$ fixes this!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5927": {
      "repository_source_sha256": "05039c4d769492ec6ed8813769adaae7b00980d308c60d98c1fc95e69a65bba3",
      "en": "「Damn! Do you want war that badly?!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:5970": {
      "repository_source_sha256": "b4e6da6395083e5515eddfb45df770a930951c732dca7607c5b8a0c68dea280a",
      "en": "「This will only repeat\\nthe history of war!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6021": {
      "repository_source_sha256": "ebdb632381e4466c785db9c6ba39799c224124a10f521369c70e979427a1e39d",
      "en": "「I'll protect humanity and $$ティファ$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6062": {
      "repository_source_sha256": "8730779b3898cb49ffad897f7570cf82331027bc990451b8bd2ccf25c9a7bdea",
      "en": "「Never underestimate humanity's grit!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6097": {
      "repository_source_sha256": "d4f6cbd46bd59ab150b08c1942bd53a1958f9272b34e957d35b6cea1662a3bf1",
      "en": "「No holding back on $$宇宙怪獣$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6134": {
      "repository_source_sha256": "16166c2c44b222f7e4f620d3d25b8306ed8302297eef53e9f773a31b0243ad26",
      "en": "「Nobody can change the past!\\nUnderstand that!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6191": {
      "repository_source_sha256": "149d1f9efc6a2c7582e13c1f628711fe702a90b43052119ec98cc2a9530eb132",
      "en": "「You're nothing next to Captain $$クワトロ$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6234": {
      "repository_source_sha256": "86ee1f131e080b81767ae6f0880a1996f857e9c6445fb7214e9975c4c408af77",
      "en": "「You're hollow too, just like them!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6275": {
      "repository_source_sha256": "e3ecdad5af3ef96bd2c8f6449c31389d1bb9228cb4f91eac56f127dff59fcf47",
      "en": "「I won't lose to pirates!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6302": {
      "repository_source_sha256": "930a395389e3a9f348fe8f464920e112899414fa369830aadffd2dff565ec3d0",
      "en": "「I'm used to fighting Sea Vultures!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6345": {
      "repository_source_sha256": "808e1ca0c75ed6163bb9ed55691aa52a7d60054ccc6dff916116c39674d400c1",
      "en": "「Fight me, pirate boss!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6370": {
      "repository_source_sha256": "a5292f57406fd3f738c5dc1c4db9723fa9e21833cf33e2697f389fa6b1f52535",
      "en": "「I'll smash your prized $$ユンボロ$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6409": {
      "repository_source_sha256": "f8fab0856718ae62696a1e34d14fd26b5a96e329af5dd3dea0e92a4f748a1d4c",
      "en": "「If you've turned on us, no mercy!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6448": {
      "repository_source_sha256": "f65cac3786b563f340b0e146f9e0083ff91d9e79f32c027fe802371f0772b74b",
      "en": "「Stop it first or we get nowhere!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6491": {
      "repository_source_sha256": "ab9ef42f3e8fc8b01a84bfda4c5ea846ed6a4dc8813524a7f7fd70af285dfb4f",
      "en": "「Neither machines nor people\\ncan become gods!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6540": {
      "repository_source_sha256": "37409296606700313b60521305fe2f57666de2189473272c124a9f1f26e005c2",
      "en": "「Humanity decides humanity's future!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6575": {
      "repository_source_sha256": "0e497f9cae516d7446fac321f6a275fdf9ae1c9851032a5514ea0f4d2c82af54",
      "en": "「I'll drive you out, $$サイデリアル$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6612": {
      "repository_source_sha256": "df5d0f8adc3696f82dfbf4f39502bbd2fe7de4c55f353b60eaee19ebc87c58ab",
      "en": "「I won't let you run Earth anymore!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6651": {
      "repository_source_sha256": "1fede10f3792ebc647f91710b4d7c586aa78ed0ee1073aa992e92bd8584b6564",
      "en": "「Get off Earth, $$サイデリアル$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6688": {
      "repository_source_sha256": "26b476de77ad9ea320385772836ad52e3cb75f8413460e4eb83f04d2deafe71e",
      "en": "「I don't care about $$スフィア$$ powers!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6731": {
      "repository_source_sha256": "15b5bbfd9b086ff806e69c910376eb9cfecc8b25b24a4ba564255075aed3ceb3",
      "en": "「If you use $$スフィア$$ for evil,\\nI can't forgive you!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6786": {
      "repository_source_sha256": "c711bc931c25509f30bb08ea544577049d7bda39b4df57c63a82d12e30fd2ae9",
      "en": "「You're negative about everything,\\njust like those guys!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6845": {
      "repository_source_sha256": "f6e3a70012f8acfa592d46663522beab5b7575cd3ba8ab8581796cb963a467fc",
      "en": "「Fighting this thing feels like\\nsinking into a bottomless swamp!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6902": {
      "repository_source_sha256": "92a947a78ff8be0718c2488d02068f4b164404a9a91f9ae36282c02563a8253d",
      "en": "「Down this one, the Empire crumbles!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6943": {
      "repository_source_sha256": "aee7af9d5f3c0009ebcdcd987dd47ec7a1deb2b1f1670648693d4e0a0a8ab608",
      "en": "「Don't drag Earth into\\nyour games!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:6994": {
      "repository_source_sha256": "deecd55bbafb22a74c2f747b4e333be86b3135135cdfbb174272e56d45c64d73",
      "en": "「You'll pay for invading Earth,\\nMr. Emperor!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7047": {
      "repository_source_sha256": "e50418f210d30bff42ffb9bbde83818c0e846da80391145eb1ae9c2beddd4525",
      "en": "「Don't use the $$スフィア$$ and\\n$$次元将$$ power on trifles!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7098": {
      "repository_source_sha256": "1de30533bb6195443bce3c46977f92ed211cce9dc7020ae8c8d9ec0eb70bbd13",
      "en": "「I'm sick of your face, $$アサキム$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7139": {
      "repository_source_sha256": "5b0b796522a7ab4c0a2a36e9c79d62801276aea9e36a0d2d83157b8121a13be4",
      "en": "「I'll settle this once and for all,\\n$$アサキム$$!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7188": {
      "repository_source_sha256": "289390e80e4ef85d7ae9a02ea2201f4542096dae91124d2c727b61ce7b4eb317",
      "en": "「Scum posing as an emissary of God!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7231": {
      "repository_source_sha256": "f4b8c2a97c1bf1d3feb35aebd2414c2a001b1db2bd0316b066daa05728056ec6",
      "en": "「I'll show you the power of humans\\nyou look down on!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7284": {
      "repository_source_sha256": "afa3df82e3faa78a747343910f8f00fb680dfdf2b418c71a811d2142813ebbc9",
      "en": "「I have no intention at all\\nof accepting your judgment!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7337": {
      "repository_source_sha256": "e78c1e09dd3f4b4f882ff7e3ccc0307853e4d798b65483da519013eb5acdb464",
      "en": "「Our lives aren't here\\nto entertain you!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7396": {
      "repository_source_sha256": "22b594346e798544470d2039ec7453dd71c02f4f9754ea0d953dfa9e7182b1b1",
      "en": "「I can't accept\\nyour selfish joy!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7451": {
      "repository_source_sha256": "f4abad1fbe4775c82db11e299cee921b9d80cb8162a7578a42857c62ba0db08b",
      "en": "「$$アドヴェント#pilot$$!\\nOur future belongs to each of us!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7510": {
      "repository_source_sha256": "1b2915da3b69a6f355b971f5117e400ec4a01b7f477b6b84087191b1fb116743",
      "en": "「I won't hand you the future\\nwhere $$ティファ$$ and I live!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7567": {
      "repository_source_sha256": "6fea435c133855b026b0a3ad339505c0bac0f392f08d1e612f5527dfc9522b80",
      "en": "「Stop making fools of people already!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7608": {
      "repository_source_sha256": "c02e1ebe470d79ccca18ce193448022f181e206f581a8df5e4ed35636188bcdb",
      "en": "「You whipped dog wagging your tail\\nfor the $$御使い$$s, back off!」",
      "source": "new",
      "slice": "v_g083_00"
    },
    "83:7659": {
      "repository_source_sha256": "3a4bb991ce2528a827555f31afc4e7816d03ed2d642d8a7ad7b82854ad4e4409",
      "en": "「This thing's power is incomparable!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7688": {
      "repository_source_sha256": "b97168b8de9716eb1175a7ce8ddefc3d6e5d49d552535a25f8806534cbbe97ee",
      "en": "「Don't think it's just a beam sword!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7725": {
      "repository_source_sha256": "62c268b47f574c0efcecc4daed5c039edf6f94a033d69d3aa65743ca947af1a4",
      "en": "「Let's do this, $$パーラ$$!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7746": {
      "repository_source_sha256": "7f1850f31a64fc16db854d75d72087e771e07a4377f75ff2cd29f0b5559b0a74",
      "en": "「$$パーラ$$! Match my timing!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7783": {
      "repository_source_sha256": "ed82e9698a4edf695f7d3fa0d6db133f0bb250d80e63c746310c800a0d615e04",
      "en": "「$$パーラ$$ and I can do this for sure!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7816": {
      "repository_source_sha256": "805e8ba9537a7c06031a787611d0644b8238d74407615f36fa90d65dd09bb319",
      "en": "「It's a DX and $$Ｇファルコン$$ combo!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7849": {
      "repository_source_sha256": "c8d9660a91e5731a7b4bff8b09855b09bd6dbedef2b2f3b6dcb77b1da5bc2da9",
      "en": "「Nice one, $$パーラ$$!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7870": {
      "repository_source_sha256": "6ff7856af5bcc6d27220657412d063301cc8bce97e9feda14391778d1a4dde13",
      "en": "「Keep it up, $$パーラ$$!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7895": {
      "repository_source_sha256": "64eaa6574ac85a6f7fa1ff254b8c91f5b77598c53566b80ae647ef746da99cf1",
      "en": "「Back me up, $$パーラ$$!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7924": {
      "repository_source_sha256": "6dee008b756a3d359d9b8ed533094ee433ed5c5067b27542aa264482dbf7a0e7",
      "en": "「Finish it! We're charging in, $$パーラ$$!」",
      "source": "new",
      "slice": "v_g083_02"
    },
    "83:7961": {
      "repository_source_sha256": "ba42dc5c5b128de9b78e4250d19c184435855ab19842e953eacf7ff9f6938826",
      "en": "「Game over...there. Off to see $$ティファ$$.」",
      "source": "new",
      "slice": "v_g083_01"
    },
    "83:8012": {
      "repository_source_sha256": "695ac26182f2545c4330da755df48f5e6e249760a8ba892a1378b516eb474f43",
      "en": "「I know that without being told. I'll live with $$ティファ$$ anyway.」",
      "source": "new",
      "slice": "v_g083_01"
    },
    "83:8091": {
      "repository_source_sha256": "c802e7b52ce823b9ad410a25060a11b0f5af32695641a9ff77642c0fe248e2dd",
      "en": "「Be more honest too. Being true to your feelings is more fun.」",
      "source": "new",
      "slice": "v_g083_01"
    },
    "83:8164": {
      "repository_source_sha256": "895a25242715d1c1d9dcd20641c6865e508f85ee8b5ce186a54af3e31251293e",
      "en": "「Later, players. You only live once, so live without regrets.」",
      "source": "new",
      "slice": "v_g083_01"
    }
  }
}

  "lines": {
    "92:0": {
      "repository_source_sha256": "26ef2201c1265d6f7a5a723f1db457bedb69341aa27432ab6ee8b3152eb50dd8",
      "en": "「I am $$ギルター・ベローネ$$,\\nResistance Purge Unit commander!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:63": {
      "repository_source_sha256": "465fc2f5139423e6e663f22cf9338f38646a9de47e5842984a7c845142d744b7",
      "en": "「Then I'll play your funeral march!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:106": {
      "repository_source_sha256": "f3bc3492da5eef689fefc3c5eaaffed4726fe25e611b7b0502d41f602288efb7",
      "en": "「You'll learn how powerless you are!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:143": {
      "repository_source_sha256": "eb73ff9367da88e6cb3274490a0e8a3341b6957de21c387c166ed3839f150227",
      "en": "「Curse your own foolishness!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:172": {
      "repository_source_sha256": "e02125dde91a3e56240cac80a11c5f01201c430c7c2250682d7ade3bd27e559a",
      "en": "「Learn the terror of the $$サイデリアル$$!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:215": {
      "repository_source_sha256": "29b7d5ecfe1c2367f4faf9afde62469636f305276c801349370af22bdca66287",
      "en": "「Take overwhelming despair and fear!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:258": {
      "repository_source_sha256": "cd2212b189bf8abd9c66efdbf802bd43e6902c7e05ca326024d2e8307828d0f1",
      "en": "「I'll make you regret being born!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:295": {
      "repository_source_sha256": "c64e24e9321468a937e2e457feb52d9a1070522a55052d24ffcec11557c89e9b",
      "en": "「This place will be your grave!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:332": {
      "repository_source_sha256": "b38215a4c4e5cd060ea3abed91f70ddb6b8712ea42ae1cb59d5891397cc65110",
      "en": "「Coming all this way just to die!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:363": {
      "repository_source_sha256": "1879434ff3cffdf87859fd284b1f88bcb9646b3738dbb0b86cc2a27b5cf94d5f",
      "en": "「To think you'd defy $$ギルター・ベローネ$$!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:406": {
      "repository_source_sha256": "8ba447c5e3bceb9d875e5b2e9d53e477ee99c1388f21633f19c5e67ed6735749",
      "en": "「I'll make you taste my terror!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:445": {
      "repository_source_sha256": "1191ffa36483cd57e99c2e689557ab39d8bf18af3ce5144f6b68ff9a50a5e077",
      "en": "「Know that resisting is pointless!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:474": {
      "repository_source_sha256": "e3590ce05a0115ccc0271aa1a930c1ee3a6dad8f700290b50efa4bb50728fcf1",
      "en": "「Prey should be docile\\nand let itself be hunted!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:523": {
      "repository_source_sha256": "fe4b6e20222d239efc58135d3f3410e68a11dfd47079b175e043838c959ef62c",
      "en": "「Hope you're a match for my skill!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:562": {
      "repository_source_sha256": "863bbe0e5a4ba97dc39594fb1bf7abf5d70af7505c46e33312b050dcbd866493",
      "en": "「You're already caught in my scheme!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:599": {
      "repository_source_sha256": "df10ddddfaf0ace4f5b69c7f05637c16c49a88c10a2c5668a9e2e9b42791cad2",
      "en": "「$$ギルター・ベローネ$$, advancing!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:630": {
      "repository_source_sha256": "74666f47f3df43a6bccde2542ea79aecd8bdd37e763ef6b743a34e36c7330182",
      "en": "「Defy me and get the death penalty!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:667": {
      "repository_source_sha256": "e5750cc5fa030147093ce3afca5901231c214df81e2c622df31174fd48f69c72",
      "en": "「Taste the poison that is me, too!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:708": {
      "repository_source_sha256": "d2d3469335e4596c82a908279b5ef144df199c6ebf9d2ce9fe307112168f4361",
      "en": "「This is the machine that suits me!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:745": {
      "repository_source_sha256": "f1198738a4004a2bab37b4bf830505201e4a52506070eb3473f6822d832a086f",
      "en": "「$$シャウラス・リーダー$$... What a fine ring!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:786": {
      "repository_source_sha256": "a020e401a308245cb888a6db190ae82570572b7c6818499398b3e9b0fe9ee795",
      "en": "「Now even I am out of chances...!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:817": {
      "repository_source_sha256": "fe709c2f669b8d7d75943d678232dd2d69bc5997843ba648a4003e50d1b5c1cb",
      "en": "「Today...!\\nToday I will defeat you!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:864": {
      "repository_source_sha256": "2bb5a505091e9c2b9f6851c21b0876a3e12fa24d011a72e73d267093a3924806",
      "en": "「Back to the wall! I can't lose!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:905": {
      "repository_source_sha256": "d7158f523cd7418d02728e1c82b3112d80108f9855dcf9324e59237909220853",
      "en": "「You're tenacious, but it ends here!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:944": {
      "repository_source_sha256": "7a1e1fda8365b86dc733c172e52cf2df986dcc1ac70da9d490aaf510026a63c4",
      "en": "「Let us begin the second act.」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:965": {
      "repository_source_sha256": "4a7abb77ae00958423ff23dfba544e09215b2ceb2d963c3eee60e46602aee6f1",
      "en": "「$$セツコ・オハラ$$! Come to me.」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1000": {
      "repository_source_sha256": "4f5c750bc1fde085f0e97a0f6ffc121710dacf21139b7e7f31fb78df6246bd63",
      "en": "「$$悲しみの乙女$$! You're a threat!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1043": {
      "repository_source_sha256": "1ebb7f6f6e58e02fd5905d4ba5c08732c7b5e8db7545dbc1fe730b685d507b4e",
      "en": "「Prepare yourself, The Crusher!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1082": {
      "repository_source_sha256": "59e85461f7971e51a7d8a9b4b566fb7f418bfb6ca92bc47f957fd5564fc4906d",
      "en": "「You're so stifling, $$傷だらけの獅子$$!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1119": {
      "repository_source_sha256": "4e3383c0f648c4cd2baeea60e125153f611f25ae95da5f0882b7ab9bc7c656db",
      "en": "「$$揺れる天秤$$! This ends here!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1156": {
      "repository_source_sha256": "e5ccba2d7182d1fa086b7a2c012d21335535c99e6836f85b59a98dedb6a7e3ed",
      "en": "「Your composure ends here,\\n$$クロウ・ブルースト$$!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1207": {
      "repository_source_sha256": "c41629860dd6dc365de6f830206113d143e017402e699759bee51e7f1d2a93bd",
      "en": "「That's enough, you $$いがみ合う双子$$!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1242": {
      "repository_source_sha256": "298e739bf44cf6efc7425a59ce3e2695403d5ff5571f87ac83293b5204ceab36",
      "en": "「A green Reactor is no enemy for me!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1281": {
      "repository_source_sha256": "3dc87cbe1fe5fab03831c06757d4bd14efa13603aeaef5ea69fcaaea37456e85",
      "en": "「Damn you, pest...!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1306": {
      "repository_source_sha256": "59d914ae568bbb75e727195314914e6dfa29b1394bbb5cc1b1e8610efc8cb1d2",
      "en": "「Just who are you...!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1339": {
      "repository_source_sha256": "b5bb7cdc261ad27af5c86f9389dd0fd9425a80847c3a219de448785b77b9976e",
      "en": "「You runt! You dare defy me!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1380": {
      "repository_source_sha256": "735ebedf7393edc382b973c9fcc36b0a77802f391b731e520fe563350ede9c73",
      "en": "「A fine chance! I'll finish you here!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1421": {
      "repository_source_sha256": "e2dd02727042898e9bc8bba0b706ed6f1e845687745b8359f2a1983cfa9207c4",
      "en": "「Traitor! You, of all people...!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1458": {
      "repository_source_sha256": "f4cd0f1bd0a1211a3f90443231ba09e10eb3764c7d0b6d3e280cd27df68f1815",
      "en": "「You lummox who relies on armor!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1487": {
      "repository_source_sha256": "4eb53d66718f13ddc196ecfeee09081cca3d7ca8e259f90581bb8163b6581601",
      "en": "「Neither your vaunted power nor armor\\nworks on me!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1540": {
      "repository_source_sha256": "79b3b814f095e36829024497799df2e7eacb4224ad1d7915b7674f89a3851a27",
      "en": "「This thing...! A true demon god!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1571": {
      "repository_source_sha256": "6cdcb5ff605dfcac390ac709b445ba385715a175e64caac34530055ce7ae2954",
      "en": "「Damn!\\nNot to a $$ゲッター線$$ machine...!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1622": {
      "repository_source_sha256": "566ccd5c723e4a10e77f07f793807b13655c474d28261f8286711484fbac49be",
      "en": "「Fools!\\nYou're not allowed to evolve!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1671": {
      "repository_source_sha256": "54716211e053b8faf9b52de66c7444fe2fc3747961c099dea49b7af101f25615",
      "en": "「A combining robot always has\\na structural flaw somewhere!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1724": {
      "repository_source_sha256": "26e24d35ef79340aa5005a60fb25aa64f6568583b2a423f861c86409a7f80146",
      "en": "「Legendary Mechanical Angel here...!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1767": {
      "repository_source_sha256": "035c0b314c7925c6ba81913c8a7ceb04b2c55f6ed0eb7e2dc0484d3025a053c3",
      "en": "「Is this the first Mechanical Angel!?」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1810": {
      "repository_source_sha256": "af5bcae656adc79ed7c2c7b9960b0f1b28182a45ba833e9538540e7c31df5351",
      "en": "「$$ギルター・ベローネ$$ is not\\none to fear a drill!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1863": {
      "repository_source_sha256": "1cb7f09029a7ea847b76b6b9062804a1ebb239e85236ff3ae9a90eaeef48796b",
      "en": "「This thing...! A sort of bioweapon!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1896": {
      "repository_source_sha256": "3bfb24979e2d00dde36204c95676b0e1cb5187715496a818a291a5b8dc4618d3",
      "en": "「I will end the legend of the Gundam!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1939": {
      "repository_source_sha256": "627ed2cd234b6f95aad0fd44439ce083aaff805b058a8f576537c1976e1e7d37",
      "en": "「Damn it! There's a Gundam here too!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:1982": {
      "repository_source_sha256": "27e40810111eec5cc173f16c88ae9aaf023b6911966d75ed2507a45fecd6d746",
      "en": "「So you bear the seed of evolution!?」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2017": {
      "repository_source_sha256": "396e42255c12290bdcc4379743d6a3f803ffff737d9a87148e2d4165861ec0ec",
      "en": "「This power...! I can't leave it be!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2060": {
      "repository_source_sha256": "59f0d764696da38a95bf66b8056edf73f601443426eefc794e872bb6165808cb",
      "en": "「Damn, shut up! Be quiet a while!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2101": {
      "repository_source_sha256": "ff5410edc31bd1e24d052cf2bd514d839c6615d78451ed3f20e9659b41b4006f",
      "en": "「W-What is that...!?\\nI'll capture it and admire it!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2150": {
      "repository_source_sha256": "28952cdd4024eb8d73a94bbfd357ab7ae3598ea553bd2d9888de000cd028e119",
      "en": "「I'll deliver the finishing blow!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2179": {
      "repository_source_sha256": "4a0ae42fff98591d36e84d004f3916226b95467c43033cf431416eed1203b331",
      "en": "「Out of my way! Move!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2200": {
      "repository_source_sha256": "849248ae8a80fecb0653cb10a9be437f03a25ad9816c15ce4518c8946322f29a",
      "en": "「You've set up a fine moment for me!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2237": {
      "repository_source_sha256": "f1bf050e18d066c2034dccd1067ac6c87159cb50782daebe96586acf9558ebc9",
      "en": "「Leave this\\nto $$ギルター・ベローネ$$!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2286": {
      "repository_source_sha256": "e8645eabb311d1b90f73c16e1bbb7946a3137e6caf018a49efab87838025c65c",
      "en": "「I'll show you the unity of $$アンタレス$$!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2319": {
      "repository_source_sha256": "0f44f0f093c11af3caa2b291b194892463e5c0b9d8326d581bc09875f1cc7d66",
      "en": "「What are you doing!? Fall back!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2350": {
      "repository_source_sha256": "72ae536653841835239cf483b6e77797e098246c226c11d9ad94de6457c19295",
      "en": "「Useless fool...!\\nDon't make me do your work!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2397": {
      "repository_source_sha256": "5894d22ecb227cabd9784b22b12923f1fd1c9d03547249a855d148b2312571b6",
      "en": "「I'll guard Lord $$バルビエル$$ at all costs!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2440": {
      "repository_source_sha256": "7c9e5f0aaff24cd19a10dba430c97584b15f5060a100c6f195a9d4b466ac0960",
      "en": "「Tch! Using a superior as a shield!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2473": {
      "repository_source_sha256": "3696b4affbbe65572871f878717ed320a264c4f5299e3585233112d456536c4c",
      "en": "「Your misfortune is facing me!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2512": {
      "repository_source_sha256": "979cb53bf569a28a1210f35d487274cf25da164a5edc974eee62437e76325451",
      "en": "「Time to show my true strength!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2541": {
      "repository_source_sha256": "f995a56530a12c6ba376f3c9f03f01b657038c8c9e9a1845df63e9d0b8045007",
      "en": "「I'm reduced to clearing the way...!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2574": {
      "repository_source_sha256": "d3f26887e89c7e5604672637020462cf68c8e98a7a3c78455aaa0f09408b5796",
      "en": "「I shall take the vanguard!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:2611": {
      "repository_source_sha256": "37fe2c03617b3918a33344f26c0e5944736c2a3c2508df8c6cb890d660d9f6fd",
      "en": "「For a little while,\\nthank God you're still alive.」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2662": {
      "repository_source_sha256": "4a4e56ecd533db53d6048b75d98e34a03ff9dee11c22fb6a55bab1642e3bc530",
      "en": "「What! Unable to attack, how come!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2705": {
      "repository_source_sha256": "e8402a89da13aeab27cda38ba43df2b29219d28de57f04ce49f47322b4669187",
      "en": "「Small fry playing clever tricks...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2744": {
      "repository_source_sha256": "d946b828e42b6542b97c15b175b3eb0bd6ff2808642149903806a88bed86d50c",
      "en": "「I, caught in the enemy's trap...!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2785": {
      "repository_source_sha256": "16df14fdbf38eda99c9876835407fc823d546e48687f83613aab527aef5fc19a",
      "en": "「Pathetic is the only word for it!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2812": {
      "repository_source_sha256": "c672c21e51779366fe56e26c49b02a01d2974255c8123a13ccc56a3eb9819a49",
      "en": "「Hahaha! How delightful, thrilling!!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2841": {
      "repository_source_sha256": "b4978193b0fe9fa1762673fa3fba90742aa5c735de7ac04d7192d22d98a65027",
      "en": "「Look up the phrase \"know your place\"\\nin a dictionary!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2894": {
      "repository_source_sha256": "e05f432c6c0232a342597f3d7af11870f016015e21dc4a15190c7bd5e30d0bb9",
      "en": "「Your stupidity knows no bounds!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2929": {
      "repository_source_sha256": "78fadc4610cda5f70becbacf1b35c38e5fa3c6c862b97b8dc971975493820eea",
      "en": "「You aren't weak. I'm strong!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:2970": {
      "repository_source_sha256": "8876454e728e02ee9011ee6c3c4969a7dd23407cb18dbe905e13439d741a42ac",
      "en": "「I can hear the howling of a loser!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3007": {
      "repository_source_sha256": "52640c9934280dd955fd567c926cd608ebf1996a17e0241de47e8a13e326449b",
      "en": "「Be as frustrated as you like!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3036": {
      "repository_source_sha256": "0236617152fb16a2b38d11476e65069c63f4faf5d86aabfa4f10abde75245472",
      "en": "「Go learn the basics\\nof tactics all over again!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3085": {
      "repository_source_sha256": "a27c0788b8e66386f9200104a8aea8c3d0cf08fca8071df3e64b376e2ee32a5b",
      "en": "「Frustrated? Yes, of course you are!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3126": {
      "repository_source_sha256": "ab94f58f9402bb70d546c43472a656de4e37e2d3d368507ff0de95794f77076f",
      "en": "「Even a $$スフィア・リアクター$$\\nis just this much!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3177": {
      "repository_source_sha256": "050cc419cf6c665c8de0daf4a8b40211183e66e9a0f4ff92fd86abce4185c3d8",
      "en": "「You haven't mastered\\nthe $$スフィア$$ at all!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3230": {
      "repository_source_sha256": "a02b8d444a9a4c42f46a6e466589c6d93ddcd56a9ea2e3ceac893786aecc9d4b",
      "en": "「I am fully prepared!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3255": {
      "repository_source_sha256": "43c5be74005ac3c38dfefb2d425cbc7c07bbfb01f47f3abb111f5a7916043cfe",
      "en": "「I never slip up!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3284": {
      "repository_source_sha256": "d597be3e4c91bea61ab54a68208038b5e140f26537fc2a1ffefa28c9d5822504",
      "en": "「This is the technology of $$サイデリアル$$!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3319": {
      "repository_source_sha256": "083ea8c40b77f63e65689d9331b9ee82219b58b81e5024c408494a949bdea1e2",
      "en": "「Heh heh... Sad. This is your all?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3358": {
      "repository_source_sha256": "27ae154756bd4d4e1defc464021fcc618cf93c2921b89161c02d36a1757e63b0",
      "en": "「Not worth the effort to fight.」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3393": {
      "repository_source_sha256": "0463221b450976b5d56578d82c670e026faae64eb460b31ad7e5a79ae139876c",
      "en": "「Frontier forces are only this much.」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3436": {
      "repository_source_sha256": "13c6674dc5e42abc8769d4edb8a8bd5d9b5b849d9ddb663bdc098d1a809ba886",
      "en": "「Not worth inviting into\\nthe ranks of $$サイデリアル$$.」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3487": {
      "repository_source_sha256": "982fc124b4442b2246c88c3869a203b7360f7432e0f72a48cbc521090fdc1591",
      "en": "「Pesky small fry getting cocky...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3522": {
      "repository_source_sha256": "e39ab548bc9eafad3f005356ddde79d0d939ff8609e90615c3e0a8d6ee7d0f38",
      "en": "「It's not enough! Power or resolve!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3559": {
      "repository_source_sha256": "10b925fa7af5f3afa1a77eb486cedb67106bf3a9e5ded473f6ca7b3dc19bc38b",
      "en": "「Was that an attack? Hah?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3598": {
      "repository_source_sha256": "405b2799347d94be74292b90c16cfb20b4ddb91785dc53fbf47dedb2b20368af",
      "en": "「Ridiculous! That's quite enough!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3637": {
      "repository_source_sha256": "93fcd2ad1978899f08ab5985445497e97f2a2c684cee7ff8e8bc9a308e220e72",
      "en": "「Tch!\\nYou scratched $$シャウラス・リーダー$$!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3692": {
      "repository_source_sha256": "200bef104db0f403a19a78fe475edd99f85ad1ac0b98da4cdad1814f74e3030e",
      "en": "「How dare you!\\nYou scratched my proud Leader!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3747": {
      "repository_source_sha256": "b567e6da85be7a1730cc0f15f018d6fa31af33caad6ba64afcfc799b20ccdc6a",
      "en": "「Tch!\\nTo outwit $$ギルター・ベローネ$$!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3802": {
      "repository_source_sha256": "ccfd501e176c03144c7628fa591af4a7923787696c9946fe047e6e3e35d06d1c",
      "en": "「Fool! Your bluff ends here!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3841": {
      "repository_source_sha256": "4e8ad5cf58c2d798d3e9d14aae8574dc74d0d86111180805dffaefc9fe0df507",
      "en": "「No...! My plan will be\\nruined at this rate!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3892": {
      "repository_source_sha256": "e17d201049c8b173ce6a05e83f0e01ab2745db30661dbc7794e3897b2af9a610",
      "en": "「How long will you resist in vain!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3929": {
      "repository_source_sha256": "adbd510f0a021b97213dfd139d6fe60a276896726b58a1d763573c0c9085d1b2",
      "en": "「A cornered rat bites the cat, eh...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:3964": {
      "repository_source_sha256": "eee94fd59f2a2cfac218d359d54a8869664fdd56b46edb445e6daf03b92ff0f2",
      "en": "「Tch! Reckless foes are a pain!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4007": {
      "repository_source_sha256": "df8b2be4836fb30ad590b58becf3d4f02fb033e72669b5ed67e31487803e9b0a",
      "en": "「Such a warrior on a frontier star...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4050": {
      "repository_source_sha256": "8f7d35947d143666d0899f76b3e993c01bc4b4429c660a001ef676ceb97946ce",
      "en": "「A power that dooms $$サイデリアル$$...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4093": {
      "repository_source_sha256": "8152b3a735bafd553f4c9665514108f087a9a7d4b4645eef962c40073adec7c6",
      "en": "「At this rate...!\\nWill I lose again!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4136": {
      "repository_source_sha256": "72f1049ca4e376d3116af5aaddf6336ea8c08831b5d0d7b58ff6a216c3eb8ced",
      "en": "「My retreat is already cut off!\\nI have to fight!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4187": {
      "repository_source_sha256": "0e43d63f2600da399142c83db8338266e39686054576a4c2a735608d5deef892",
      "en": "「You dare insult $$ギルター・ベローネ$$!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4230": {
      "repository_source_sha256": "3975e86b7d8d6d4bc9fd3274bafaae3709bb18eb909dea396a0bc198fec00ae7",
      "en": "「D-damn you!!\\nYou wretches!!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4281": {
      "repository_source_sha256": "3f7a68a148c4e620ff3a3d9210015341727e953b58c1d2626bde57aec066b2fa",
      "en": "「I won't forgive you! Never!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4318": {
      "repository_source_sha256": "8d460e1785bcdb1a61d36b20f79f68a73e9a46cba2deacc9e2881c2885bad2df",
      "en": "「This humiliation...!\\nYou'll taste it too!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4367": {
      "repository_source_sha256": "6be09f4f45b6a0c86e6555b81bc6ea4420c59de6a68edcbf90a1750e969ba7fc",
      "en": "「Where...!?\\nWhere did I go wrong!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4426": {
      "repository_source_sha256": "a3a7e766399efd3539c781ca9fa73863a8c93e024e8caca274b187caca46d89a",
      "en": "「If I were at full strength,\\nthis would never...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4479": {
      "repository_source_sha256": "fc15fa10a2445434fee6a723e2120c1b2fde6f165c17a610c7942e404b2c6add",
      "en": "「My plan was flawless!\\nWhy is this happening!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4536": {
      "repository_source_sha256": "5bf45179cb2fa8d7d3b59da5cadda014d77792a438772d6a9c356d9c8404486b",
      "en": "「Impossible!\\nWere my calculations wrong!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4589": {
      "repository_source_sha256": "2593084a6b7f95be677baa6774d52362a79804776c2bf0b0afd239c73b9d469d",
      "en": "「N-no good!\\nRetreating just gets me purged!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4638": {
      "repository_source_sha256": "2db63798c4f100de3d8535986d9fc313f0322160ff4ee028358cb5adab4df6b1",
      "en": "「N-no! I don't want to die!\\nI don't want to lose!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4697": {
      "repository_source_sha256": "49cee5fb0490b4ffe4eda60dc869a5b9c8c9182c4e57aa017931b2593d5e04f4",
      "en": "「$$セツコ・オハラ$$...! What power...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4740": {
      "repository_source_sha256": "86650130f3d4949b0523e77e9e0377d447fca36920e3a484efa97f66fad82399",
      "en": "「As expected, you truly deserve\\nthe name The Crusher!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4797": {
      "repository_source_sha256": "3240ca0831980328f32249de46cf7a5a7d018680c572a81ef2911127d2219b2c",
      "en": "「Shut your mouth,\\n$$クロウ・ブルースト$$!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4848": {
      "repository_source_sha256": "04bd08fb1f392ac9734c80191325d11f9c8925591789b880565a1799d90480aa",
      "en": "「D-doesn't my poison work on him!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4889": {
      "repository_source_sha256": "d096568e9549add154f030c72903a25adb97b2f505f2f932a278461c31d33e81",
      "en": "「The power of a $$スフィア・リアクター$$...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4928": {
      "repository_source_sha256": "5c752d325d4fcbf267d2bc0ec1b91b71346a329715499481cfc43837e99a5f54",
      "en": "「His will, his power... corner me!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4967": {
      "repository_source_sha256": "9ebe7cc111d60f39ec0da45e5f61e74f192f14a61cdc173d1dc75ea2b591b85f",
      "en": "「This power...! It's overwhelming!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:4994": {
      "repository_source_sha256": "01700a2f68cd537cd47d516e5036bff25586c9e5b41c7c025f5563bfd99138d4",
      "en": "「Damn you, $$サルディアス$$!\\nOf all people...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5041": {
      "repository_source_sha256": "66e008a8875d235fcf0751d484417d9ea9c7e4749fe2f6c3946cb05769f72a22",
      "en": "「T-this power...!\\nA Super Robot!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5088": {
      "repository_source_sha256": "0712c0b2db2afc2519c59cf123f1b0fee0d884bb7b7a766d054f48ec9a2827c3",
      "en": "「I hate to admit it,\\nbut that's Super power!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5141": {
      "repository_source_sha256": "afe27b498eccecd9edae2c48daa22967f99f181829b8bf3aabcf1d2faefc5ccd",
      "en": "「This guy...! He's mastered\\nthe power of the $$ガンダム$$!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5194": {
      "repository_source_sha256": "0999d3f2b22e9d6e9f1939699da3a0dffc20d65d2874bc1b39ed679f4b47ca23",
      "en": "「Will even I be swallowed\\nby the $$ガンダム$$ legend!?」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5245": {
      "repository_source_sha256": "4ccbd0d9cc14ef3bb07787ccc8e2a659bf788b5599100aa389c45d1d15ca20cb",
      "en": "「N-no! His speed\\nhas totally left me behind!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5302": {
      "repository_source_sha256": "bbde005f2cf91fef7a1c7c4bf2415485d7a8b153f5d2a9dee7cab7b8bd9f8ebf",
      "en": "「Underestimating a runt was my error!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5341": {
      "repository_source_sha256": "f2781963161c61dac61c47d172c690dbff42a976cdd9ba8c648985e0cb133020",
      "en": "「C-cute! I mean, strong!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5378": {
      "repository_source_sha256": "827afc976015c3ac92b7d0f4ce4315db35d238ee018b0c5c07f58278dda0c59f",
      "en": "「Damn it!!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5397": {
      "repository_source_sha256": "e001e11fb23f4b13517fa5af8f9f8ea2ba38c2ee94b5f30add2776bf4133f043",
      "en": "「I-I won't die...!\\nI refuse to die!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5446": {
      "repository_source_sha256": "0b96aafedd47b1e4bd054891decea75800be3da693bd7f71f713c40bed1f9377",
      "en": "「I'll never forget this humiliation!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5489": {
      "repository_source_sha256": "f802be2e710e53c2dbc117d87a98f320de898d565486a1e5001948397e577d97",
      "en": "「Tch, next! Next time, for sure...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5524": {
      "repository_source_sha256": "c207728771e73e53161685bef889d43fa3f43cd78c26575fde83fbd472bef1c9",
      "en": "「I, $$ギルター・ベローネ$$,\\nfall in a place like this...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5573": {
      "repository_source_sha256": "3a972b01c911cd41986f561065864f21ac35dedc60bbd536d960c245406397bb",
      "en": "「A-aaaaaagh!!」",
      "source": "jigoku",
      "slots": [
        "shot down"
      ]
    },
    "92:5600": {
      "repository_source_sha256": "f716b22d241b99c8d3c1909b678736814cc60082f3c082aec34982806e121ca5",
      "en": "「N-no...! I can't lose\\n$$シャウラス・リーダー$$...!」",
      "source": "new",
      "slice": "v_g092_01"
    },
    "92:5661": {
      "repository_source_sha256": "0c8dc21073eff31cbb0efcf3634898ec6f70c7553cab80eb87f6326c9a9f96f6",
      "en": "「Flitting around all over the place!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:5696": {
      "repository_source_sha256": "9259448e072b5996498d4b024d384c192e1d83d7df4ca230799f62bed503c068",
      "en": "「I'll tear those wings right off!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:5731": {
      "repository_source_sha256": "67cedb341977d9cffb1c662334f8a2ed469fdbc25492576adff9c3cd2e120503",
      "en": "「A mere soldier comes at\\nthe enemy commander!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:5780": {
      "repository_source_sha256": "38d7d47df2e39cff1078d71a36fe9427328f23d256f439ed194a9c722e2fca51",
      "en": "「A mere pawn dares defy me!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:5823": {
      "repository_source_sha256": "9847172743e0e8570e4320bee6afd0988a309a7093ab089989600c91e130d34a",
      "en": "「Let's see whose wits are sharper,\\nyours or mine!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:5876": {
      "repository_source_sha256": "33acc10bd924f9b98b6df09fae91d1b2ce8a35bf9acdeef84435beaab12af125",
      "en": "「You are a truly worthy\\nopponent in skill!」",
      "source": "new",
      "slice": "v_g092_00"
    },
    "92:5925": {
      "repository_source_sha256": "bf0c16d671cb77e8d9518af62409a51cdaf4e0edd9ca0553d07fd9fd9925bcf6",
      "en": "「Taking out the mothership\\nis basic strategy since antiquity!」",
      "source": "new",

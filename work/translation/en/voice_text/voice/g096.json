  "lines": {
    "96:0": {
      "repository_source_sha256": "154e5d8b5f94ed2c5cfcec906d239a7d795827b8a0d771349b0dc0b23e1201b5",
      "en": "「I will annihilate you.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:13": {
      "repository_source_sha256": "21e967eaeb37027378e605554a3065b3bac78b5854c9535394cf9cd3a9660b14",
      "en": "「I'll eliminate all obstacles.」",
      "source": "jigoku",
      "slots": [
        "could not retaliate (?)"
      ]
    },
    "96:32": {
      "repository_source_sha256": "563d2d9c0cfa4278c9737c800486f3f8e6fb7b1541a2246efc5a58f1477018d6",
      "en": "「Regret your own folly.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:59": {
      "repository_source_sha256": "a91e271a39063d7b1ae9af2b9b918c8a10da1d7ec192202f3c5fdfa8442da8d4",
      "en": "「There you are!」",
      "source": "jigoku",
      "slots": [
        "could not retaliate (?)"
      ]
    },
    "96:72": {
      "repository_source_sha256": "381b74424376339bf70d6012094ec1505b143c2e76080fb52c8cfbdb119fc24e",
      "en": "「Disappear!」",
      "source": "jigoku",
      "slots": [
        "could not retaliate (?)"
      ],
      "alternatives": [
        "Begone!"
      ],
      "review": "conflict"
    },
    "96:85": {
      "repository_source_sha256": "92d4092d4fb64ab284c53d8a3cbf280880155b7ff7b0deea1179ddd8e3600e6e",
      "en": "「Too slow!」",
      "source": "jigoku",
      "slots": [
        "could not retaliate (?)"
      ]
    },
    "96:96": {
      "repository_source_sha256": "576bcca9540ae5d6a8ad1ff5a04a8835b7f29a4004e7f8fbadf8f14dfd1e5015",
      "en": "「Fall!」",
      "source": "jigoku",
      "slots": [
        "could not retaliate (?)"
      ],
      "alternatives": [
        "Go down!"
      ],
      "review": "conflict"
    },
    "96:109": {
      "repository_source_sha256": "33e93f89fc082f36722bd680fcadf8425c42c784847f173e49b937e7189e6732",
      "en": "「It's useless!」",
      "source": "jigoku",
      "slots": [
        "could not retaliate (?)"
      ],
      "alternatives": [
        "It's no use!",
        "Useless!",
        "That won't work!",
        "It is futile!",
        "That was pointless!",
        "Pointless!"
      ],
      "review": "conflict"
    },
    "96:122": {
      "repository_source_sha256": "688ba2412ab481df342c88876fbda563b63378dce754a498eb93a42d6be8762d",
      "en": "「Take it once more.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:145": {
      "repository_source_sha256": "991324faf23bf06a443475eec22479a64db9ce8f183109da58a04b0c16223b5f",
      "en": "「It can still move...! But!」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:178": {
      "repository_source_sha256": "1a116072dd024373ae2923c0c28dd166d0047483ce8e506c6bfdf03d54a3306b",
      "en": "「Missile hatches, open.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:207": {
      "repository_source_sha256": "76d27d926915aaef3d54e00c30112a991f5d17dbd1be2a399b3f23271c6d19e0",
      "en": "「This ends it...!」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:230": {
      "repository_source_sha256": "04a4f8934d29f1dc5e269fbe5bf3ec3e35d04a20b4a3533615ee742d64108168",
      "en": "「I'll settle this in one go.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:251": {
      "repository_source_sha256": "a441431398221aa95a152c2f914a0ac90a4cd0f8f65ca88be65822066c046d02",
      "en": "「All rounds, fire...!」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:270": {
      "repository_source_sha256": "07753258d61b7321c6053211e2e257b6e790faa18ad1de66371c16b27e1e2b42",
      "en": "「Wherever you run, it's useless.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:295": {
      "repository_source_sha256": "13bb145fb2c346a95021fae21abe0097979c764df6e87e6f76e9ba831cc56997",
      "en": "「Take every round...!」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:318": {
      "repository_source_sha256": "9ddbe33f0bbfd0f3902828ea745037b19868fca230f2e1d99b4b78176b6cc248",
      "en": "「I'll retaliate.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:331": {
      "repository_source_sha256": "0dc160c78ebcc4056700c68777114f9e57bc435d372aaf15c389bc2146266de3",
      "en": "「You're an eyesore.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:348": {
      "repository_source_sha256": "b0e494091708aabf388254767493d197503dd23808e4d96c0d53c9ee1b9ba8ee",
      "en": "「I will punish you.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:369": {
      "repository_source_sha256": "255be18cc96dfe31eb5d6330260153210cb5b56e53bb7cf306e77bf3e1032266",
      "en": "「Time to repent.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:386": {
      "repository_source_sha256": "474dbf2e80c788701d7e9c821547261cac327eecebe751459b442e33e7a7485d",
      "en": "「Your resistance ends here.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:407": {
      "repository_source_sha256": "e59f1369fad560d878dc0171b557d67cc97190fde9fb02c34a7d7dcf59823a04",
      "en": "「How foolish to defy me...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:436": {
      "repository_source_sha256": "3b458f0d061f7f0c5667edcd085e2b5f8db01ab432a107e6a7b57fa537006fec",
      "en": "「Showing me an opening to counter...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:469": {
      "repository_source_sha256": "18365dd526f86ac92de3d51a233106cd0b02470986e2bda037dfe89d7ef1e819",
      "en": "「Stop this futile resistance...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:502": {
      "repository_source_sha256": "40118d06318062a7588e29d2ad5804f834840573ad60cd753a4ae6fd549090a7",
      "en": "「Know that rash moves invite death...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:537": {
      "repository_source_sha256": "a5ef943013cae101cfb6b34e6b7deb5faa9ad1470cca5a7c85025422392e8f0c",
      "en": "「I failed to finish it. A blunder.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:564": {
      "repository_source_sha256": "7218bdf6b1c10bfd250719ec2c2df69ba0f37ce3f0a25f24e33bf498feb09dc8",
      "en": "「I'll deliver the finishing blow.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:593": {
      "repository_source_sha256": "be55b71823dcde0bfbd31d343db9a6b761f603656456b2525e750f08c1525561",
      "en": "「Try not to disappoint me.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:618": {
      "repository_source_sha256": "b3a86fa1926c0c8ce92d59b4835285f3bb6e777c7aa82274850a16975eb87daa",
      "en": "「I won't let talented people die.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:657": {
      "repository_source_sha256": "a3f83a30b37794c269d5c4832349e45ddf92819ddc4873e8b5f058596e625926",
      "en": "「I'll be your opponent.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:686": {
      "repository_source_sha256": "e665f89280c9f03cef661fa5546f9322590bb9ba679a6e8d38c4d752127f556f",
      "en": "「Hold that enemy in place.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:713": {
      "repository_source_sha256": "fae1a1b9cfe786032fe6717ef6bcbc6953d3e6ab23bcd17987b52d5f5ba82636",
      "en": "「Deal as much damage as possible.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:746": {
      "repository_source_sha256": "d42c6a0985e11d1525c0d010d2656986962000298a7d0a2c68b129e62bd13179",
      "en": "「I'll open a breach. Follow me.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:777": {
      "repository_source_sha256": "a0cc021410f0aa838fd8880f53e7f114e3fe2af42d8da1c7be28b6fcc9c5a42c",
      "en": "「That's quite a clever approach.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:806": {
      "repository_source_sha256": "9f491aaaa53ad1db1acfed05a82ef801698d5903fc5d528bd0521b65cafef465",
      "en": "「I'll let you keep your life a while.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:841": {
      "repository_source_sha256": "6e76fda277529930f8ef9d8db8c2ab729d8166802c1ebe5af1d19765573aae1a",
      "en": "「This is an unexpected development.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:862": {
      "repository_source_sha256": "e4c07b70dafe38e73fe493bc420e8c9378deeeeee620ba13b24d230e74ea4a43",
      "en": "「Can't counter with my current gear?」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:893": {
      "repository_source_sha256": "614b2959457e3ff3a0c275ae4ce98adcfdaf91095af700581c44986bcd3139c1",
      "en": "「I have the enemy's position.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:918": {
      "repository_source_sha256": "9cb7fb82b74413fc32a19e5fe885a5136b1eca0f46c9a9f8f414dc6101b8bec1",
      "en": "「I seem to need resupply.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:941": {
      "repository_source_sha256": "ee915d2c97146a1b3819c38b609ad25b4411e90b4efc6b05a3029387c55def9c",
      "en": "「Where are you aiming?」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:962": {
      "repository_source_sha256": "ecdba4df498ef601d2ff3a4cdeec0e9bc383f7ed037b1573397f155aab296ed3",
      "en": "「Amazing you survived with that aim.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:997": {
      "repository_source_sha256": "0fb5cc07a90f01e48257bde554cc4cc11920d5de91fabbff6e80335d34882b53",
      "en": "「Close.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1014": {
      "repository_source_sha256": "26148aa325589d2e69a9cdb2312438c0546d45e4d5660923e7960c3dbae05dcb",
      "en": "「As I thought, all show.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1045": {
      "repository_source_sha256": "faa12111c794a50afecff31e8f00599f04fc8221e65bf82a022dfc914788be8f",
      "en": "「Your read is naive.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1062": {
      "repository_source_sha256": "292938bbc1ec388b0ed72b0d632063a616ce984d998ed071ed09bbb318de15fb",
      "en": "「Attacks like that can't hit me.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1097": {
      "repository_source_sha256": "61f7db9a5b48ab388116fbe223232a5de9409cf2ee3ea61e3a34082450724669",
      "en": "「This is the gap between you and me.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1128": {
      "repository_source_sha256": "3f220eca2806840e1c6be5ba2336b5ac1df175ed149af650b86ac880aa67b938",
      "en": "「Came here just to disgrace yourself?」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1159": {
      "repository_source_sha256": "06a76af0fe640ff9660d4e17db3c14950245b8a2ed8539602760665e77e317d8",
      "en": "「You thought that attack would work?」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1198": {
      "repository_source_sha256": "13568e4ed79e365ca1627935b44132503cd5d500ba76641634e5a33ab6004c96",
      "en": "「What a pointless thing to do.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1223": {
      "repository_source_sha256": "087e5d6743e76fef330301775d10574ca271e9e043d21f262a7cd86b8efbb78b",
      "en": "「That won't get through the field.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1256": {
      "repository_source_sha256": "27d0bd1eff165619fa36068f4a5f3ca4becedccd641fb1b910472201f781f062",
      "en": "「The powerless get weeded out.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1287": {
      "repository_source_sha256": "7751d5c06938113ec75b9b7f69273edb98bc132ef9e829c0c78025fc56fade92",
      "en": "「You defy me with so little power...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1322": {
      "repository_source_sha256": "b9cf43e00c4567ed6aa636529cb7558cd4fdf1300d6ed25c35cc83bab27fd4db",
      "en": "「You can't see our gap in strength.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1355": {
      "repository_source_sha256": "bad51b9d576f054e1598dab9ea950c5263e8538a1fa56962ffa67ccc47f73451",
      "en": "「Pitiful. This is your best?」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1386": {
      "repository_source_sha256": "0710fcd0c9795bcb84a15a7972d84a210911569ab61ecb76647073e21bee1b24",
      "en": "「Petty power can't change anything.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1425": {
      "repository_source_sha256": "91143ce28fcd1892aecf7b91bc07ca8dc56b84156611a0c1badbc94cc19afac7",
      "en": "「Enough of your futile struggling.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1464": {
      "repository_source_sha256": "955498fe566223868d04ac317baea593bd070175cb402559e664464559dac0cd",
      "en": "「Weak attacks can't break through.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1505": {
      "repository_source_sha256": "77d4cfae0e82520af87f63a22d7ffe414d0abec3042f12aecbb13b04294a4ff5",
      "en": "「What's wrong? Is that all?」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1536": {
      "repository_source_sha256": "691cc4f75422dc719415c06472e9f9e14b749f19dcbab1c472734fd5cfeb2f74",
      "en": "「I underestimated you a little.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1573": {
      "repository_source_sha256": "ab76451067da3b3f23bd90f561565690f4972467e6df8ed17f6dc344aa272b25",
      "en": "「Keep resisting and I annihilate you.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1614": {
      "repository_source_sha256": "8632e79bdd00de0a37b697baae615806755bf8bf93fe43eb70ea6e65af6de232",
      "en": "「You can match me...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1641": {
      "repository_source_sha256": "ae0ce7143f5cba23be8bc6a097b669f87332832ca2a5dcb325629ea424fed053",
      "en": "「I can't overlook you. Annihilating.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1674": {
      "repository_source_sha256": "cb1e5c8d39500066fd714f03b3a4ba3e0c25f39c9e49113b2278d2cefaa1dbf7",
      "en": "「You're beyond saving.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1697": {
      "repository_source_sha256": "2a5706732dfe426136b75153ccdc6c2389dcb0fac26719f98c9213884a2f23ee",
      "en": "「I must revise my assessment.」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1738": {
      "repository_source_sha256": "3605d3e017248a2ff132f2a02d029a122dd1061098724208d20d8f331deef43b",
      "en": "「This strength... What is it...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1769": {
      "repository_source_sha256": "87f750dc607ffb0fe3f27b3dcf333b029c068af7266d7dce7a69b491866b0e48",
      "en": "「Combat power far above estimates...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1810": {
      "repository_source_sha256": "7f918597c9619b3e4935b7e2b002080e2dfef38700bc9dc4f0ffedff49a1a993",
      "en": "「I need to raise my mobility...」",
      "source": "new",
      "slice": "v_g096_00"
    },
    "96:1847": {
      "repository_source_sha256": "f644262cdf6e3b4bfa79c2e4ca68673474eef6f14c8115040c8151ce4c19cc22",
      "en": "「This tactic can't deal with it...」",
      "source": "new",
      "slice": "v_g096_00"
    }
  }
}

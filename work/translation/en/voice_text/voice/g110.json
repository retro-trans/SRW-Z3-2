    "110:11": {
      "repository_source_sha256": "e877728a97a8668b01f84aa4a7d02c951926873ee0e18d9745e326ac6afb5f13",
      "en": "「I am a member of $$クロノ$$...\\nThe Captain's loyal servant...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:64": {
      "repository_source_sha256": "d61f17137055c60a0aec9d2872c99f8062e970983643b1e7dd3330162b9c6643",
      "en": "「My duty: give the Captain life and soul...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:107": {
      "repository_source_sha256": "c21d2bda5e20a120d2253ac700279d153b30b5e0ab2bbc995b82e12682ff49c2",
      "en": "「All is under the Captain's will...!\\nRebellion is not permitted...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:160": {
      "repository_source_sha256": "59b75f543d69e63b4e5f52d5033550ee39e1807551b2cff46a996a13c44048e5",
      "en": "「The Captain protects the universe's future!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:201": {
      "repository_source_sha256": "7b78d5ae9c71ebfcef66f7d1ce2d02fbc4c0f64a86f2f392033be939ed6ed3e5",
      "en": "「Universe, future, causality, fate...\\nAll converge into one...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:258": {
      "repository_source_sha256": "61531dca7908a9d8373912edd23de4df1782777ea70951e1bcb312568aa50bf8",
      "en": "「Please guide us, Captain...\\nGuide us... and fate itself...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:309": {
      "repository_source_sha256": "e052403a0bd7f421240b55fa7b45939e9ba27c8954546681ef92a53470bfba9a",
      "en": "「We watch over human evolution...\\nSelfish acts are not permitted...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:366": {
      "repository_source_sha256": "989d5b340716ea6a944c0e62814e51babad6276bd2e6daf4314f675fd8625f86",
      "en": "「The Captain is our hope,\\nand our very fate...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:423": {
      "repository_source_sha256": "b2c431f3216d8d553c5dfcc2c2f86f5eda9efdda25948d65e63ed8228256c468",
      "en": "「We will survive...\\nBeyond the end of the universe...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:474": {
      "repository_source_sha256": "b5e42a6a23f84eb5e0cd06a50ae043742f3d03069fcd5e86df520c5f8749176d",
      "en": "「Give us the hope beyond despair...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:509": {
      "repository_source_sha256": "cb1eea5b4b978aa12737d19812c8c9a7723aaab8a44cbfd5b48401b0b730fc9e",
      "en": "「The Captain will guide us\\nto the far end of causality...!」",
      "source": "new",
      "slice": "v_mix_03"
    },
    "110:558": {
      "repository_source_sha256": "efc03ee2c612cca401d584fd71376279eef07e1d1524c89d7b61af7a1cce731d",
      "en": "「A great being...\\nThat is the Captain himself...!」",
      "source": "new",
      "slice": "v_mix_03"
    }
  }

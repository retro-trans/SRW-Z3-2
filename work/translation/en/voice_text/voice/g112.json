    "112:2698": {
      "repository_source_sha256": "585c6b877a6c246bfe13558371628b96d8b5188bcc78272a0326792362e969fc",
      "en": "「Curse you, $$マーズ$$! \\nThis isn't over!」",
      "source": "new",

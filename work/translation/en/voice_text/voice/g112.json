    "112:3201": {
      "repository_source_sha256": "44bbf5d35db01aa0e80ba7ace0f87c7d26fb241952f8c8ab6f9bccf7b113ac5d",
      "en": "「Curse you! Insolent pest!」",
      "source": "new",
      "slice": "v_g112_00"
    },
    "112:3232": {
      "repository_source_sha256": "1a5a16bf93fc5fcf2f532834447d6403c46802aceea591fd7514dc16acec7f13",

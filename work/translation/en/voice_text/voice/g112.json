      "repository_source_sha256": "6386f69ed59e0f2d383feb725889ec3a73dc5ada62d3d2db5d9d8c177d4a4b3d",
      "en": "「That one's life force opposes\\nthe dark power...!」",
      "source": "new",
      "slice": "v_g112_00"
    },
    "112:3162": {
      "repository_source_sha256": "4f7840a72935c861ff2d8ec76b8845dd9f20968a47de9372d629dbff364c4d12",

  "lines": {
    "118:0": {
      "repository_source_sha256": "5481648af899321b9d9f32df3b4ba9612f157f758a6c9206e78a596833236fd7",
      "en": "「$$コード：ホワイト$$, commencing combat!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:41": {
      "repository_source_sha256": "957ad9adf0ba227624234101f0a9eb042d48874a96a4e85e6a12d736474337cb",
      "en": "「Target confirmed...! Moving in!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:78": {
      "repository_source_sha256": "ca9cc5783b46aa80c3bb8cc70c883c08627d2a024a42c2e810a81225b46ef185",
      "en": "「I won't show the enemy any mercy...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:119": {
      "repository_source_sha256": "c3a7c35c4709a07f0890fa7515b7051c27a2035ef19b31807be30149374ebc41",
      "en": "「It's useless to try to run!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:148": {
      "repository_source_sha256": "56dc1aa1a204a594fdb7949f849e6e4b5c5f2ec83a515ba960c5b7c1fa4a78ad",
      "en": "「I must finish it here for sure...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:181": {
      "repository_source_sha256": "f3322f1673d047f4aaead0f7ab2a53d7d328ef284ea02534870b0b37e1dc9a05",
      "en": "「I know what my role is!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:220": {
      "repository_source_sha256": "02b4e13bcb9ad7a029b25b378e19ef3b8d1ca9d9cc31e6f2f91027f44434872e",
      "en": "「I have a mission...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:245": {
      "repository_source_sha256": "91911079ef4aa14c8920a0a02efa5a72f0f9acd1bd6dc875e0ad3a0f761ab25b",
      "en": "「Captain! Watch me, please!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:278": {
      "repository_source_sha256": "5801aa75b89b24545f1e73ba699b3d3e1c0ea5baa0825e253a2d1b6b5f0e21ca",
      "en": "「The Captain chose me, after all...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:319": {
      "repository_source_sha256": "bf7058bb76130e0e917a5a75adf6cf79fd33dce5eb6da70d2ca89b38474579bf",
      "en": "「My soul is always with the Captain!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:360": {
      "repository_source_sha256": "e1a7112d90526522dce4367a504fb3e7d7e399be433b4de734f256bbe4ebdb83",
      "en": "「Change the world...! As Chrono crew!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:403": {
      "repository_source_sha256": "1ae9481f1f1722d4cd0940eaea5b3ee31548d1baf46cf094c2704fcf27a70cf5",
      "en": "「No mercy for those who defy us!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:444": {
      "repository_source_sha256": "ec1a70f8bbc40bd042bcef6b0101299246732f2371f41bdbc7973bccecd9e048",
      "en": "「I only do what is right!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:473": {
      "repository_source_sha256": "8b87a4086e20ff00ac8155a31452c639b46ad75065e11b99abc50c4b5dae34ae",
      "en": "「Saving this world is my mission!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:508": {
      "repository_source_sha256": "016d257840c5062dfb5540ce581445968f9a117ba7def9de901e9a07e3f50d63",
      "en": "「Our enemies are the world's enemies!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:533": {
      "repository_source_sha256": "52296f2302ea9975925a24cae41b685a8c5854c5c9eb7376d43c2247622975a1",
      "en": "「In the name of $$クロノ$$...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:558": {
      "repository_source_sha256": "280d858c88be32ff76d25ada82c36d48c5d55734e681095a6b1414f5a04c35bf",
      "en": "「You sure hang on! But...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:589": {
      "repository_source_sha256": "33c6f85e6ccde1ea941c9146a0cf99510ada8a3f08a93191436da4e707dfe517",
      "en": "「An opening! Got you!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:614": {
      "repository_source_sha256": "8868600a56da29e6fad7c3eec2170ac382455941fee484c13a67c0c52bd12e12",
      "en": "「To run into a $$ジェミニス$$ captain\\nin a place like this...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:671": {
      "repository_source_sha256": "19434bbe588fbca0c0ffd09199a2ac0b7871b5b5a7b753f8c261f3f0954c7e36",
      "en": "「$$スフィア・リアクター$$s are\\nour top-priority target...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:722": {
      "repository_source_sha256": "10a02715f0b371d4d01e4cd104e62715cc7c9526c8107457bc40878819777f68",
      "en": "「Even a Reactor can't be invincible!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:763": {
      "repository_source_sha256": "396b5accb89e9b3d94a5b0f044c25be49276c50579acd61b87b2c4edcd820551",
      "en": "「Targeting the $$悲しみの乙女$$...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:790": {
      "repository_source_sha256": "79bbfad07d6e3f866a3f0adc2743fa44d82af4d81a79f9e5eee83bef4b38869c",
      "en": "「You look so tough, $$傷だらけの獅子$$!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:829": {
      "repository_source_sha256": "f7def9de2b3ceb759001720f216682ed9f9b67f16ede14b75a8b1bcc375f015d",
      "en": "「Got you, $$揺れる天秤$$!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:860": {
      "repository_source_sha256": "6d9e435b57e76d8622eca7c6eaf25d2a59ec516c0538af3bebc9d8de9f9dbf23",
      "en": "「To think it would come to this...」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:889": {
      "repository_source_sha256": "a42b6a6c1239c9056a3c6127ea3a179c0c4324f0300bc6784780ab5de77aa300",
      "en": "「I'm sorry... But this is my mission.」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:930": {
      "repository_source_sha256": "7dec45d5b9502141b7ed0efb71cef5382bf336a02faeab70c788122fbb2ee60e",
      "en": "「Your fault... You defied the Captain.」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:973": {
      "repository_source_sha256": "2412adc99495bdaac33f0a61515c3b9806a4a1b977d826379d8b8bb98f303fc2",
      "en": "「Facing the rumored Super Robot...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1014": {
      "repository_source_sha256": "98626df5bbd20fded1e244dae659624b60cf8d44b675c8ce6677073ab9b1849d",
      "en": "「Making fools of the power-proud\\nis the real thrill of this...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1069": {
      "repository_source_sha256": "d1d5ccc6d05ce33ca2677d14ac5dfe6c38958b17b4984fa2465a6da737f03d7b",
      "en": "「Combining, transforming,\\nthere are all kinds of machines!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1120": {
      "repository_source_sha256": "de392db5f3d41258546a1078a48d6efc77be3ec3a4febc9fe339551ae035aa22",
      "en": "「Facing a Gundam is an honor...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1155": {
      "repository_source_sha256": "b823071b15ce65f9b672edf2c249df7cdb6750a7aaab221340647b4487d252f7",
      "en": "「Gundam legend...! Ending it here!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1198": {
      "repository_source_sha256": "3150f1b076eee66f61407fd004b025d00e5f3f3035af1b0b60bab99db75e3046",
      "en": "「Nice speed...!\\nNot as fast as my $$アスクレプス$$, though!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1257": {
      "repository_source_sha256": "70bd7d808b8fa4c213984dc7a64a8620e0549c6698db6454b2eda88dc6d4eaca",
      "en": "「Go on, try to shake me off...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1296": {
      "repository_source_sha256": "eb0b1bd77bc908a3e97f4034a3febaabcfdbdd1ffd8f72122e876f381f67e41b",
      "en": "「The bigger the opponent,\\nthe more fight I get...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1357": {
      "repository_source_sha256": "cd03c5c3728f6c95235b208a4ab72f8b24134a736f8dcbe2f18cf8aaec19c99e",
      "en": "「The bigger the machine,\\nthe more blind spots it has...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1410": {
      "repository_source_sha256": "3c14de99e06aba4106b417dde64fe38c285727797debd7bf6f1806eaf468e45c",
      "en": "「Small, but no pushover...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1443": {
      "repository_source_sha256": "a09145c4bf65e2e06e84e8df9f439e0dedc4d29e958be477170819b32902806d",
      "en": "「Small, and hard to get a lock on...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1476": {
      "repository_source_sha256": "a34955aae9c88e170952ffecc8c5ca31680655a3e714c2a4717dc565801c441c",
      "en": "「So the ace has shown up...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1511": {
      "repository_source_sha256": "ed6ff633b8366d603296f714ac4038dd61f736f1b119e32be7fc8b06a3051a26",
      "en": "「Commanders get taken down first...!!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1544": {
      "repository_source_sha256": "d1902c5227e95d6da32c01a8823ecd02aa94bab90f9ae8693dab62074f617de7",
      "en": "「I'll show I can fight ships too...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1575": {
      "repository_source_sha256": "55420c49a58c9760b48a5fa1fbe6a129e8c13fca186ff790e74d2ee8fc1a0138",
      "en": "「Also to liberate $$翠の地球$$...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1610": {
      "repository_source_sha256": "f43974f129c986e2dc91df42951b234d9e355e50d7148579367a41c44731275b",
      "en": "「I'll drive you all off the Earth!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1651": {
      "repository_source_sha256": "8deecb64fd4b40af4da9e6d7f54fd7fddc5a943e264831e1a3ea3519a619cf41",
      "en": "「I'll back you up!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1676": {
      "repository_source_sha256": "fa78c2b2cbf50b3d8d3b94c606e4209c8aaa03d68797702b5b663640dad00457",
      "en": "「If I sync up with my allies...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1707": {
      "repository_source_sha256": "389a2cbf8c6b8a2988f7cf1730d1d39cd61c4791ca915aa9def567fa3795e582",
      "en": "「Watch me, Captain!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1736": {
      "repository_source_sha256": "f2efff63e3dc30daa8d29618117b1c073c5d54012b44fe34f831668164b9114d",
      "en": "「Protecting someone is my mission...!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:1767": {
      "repository_source_sha256": "0bf7b9551d767955357e802aea633c18f0b882a8c8bb0dedbbdf2256987ce4c8",
      "en": "「I won't let you...!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:1792": {
      "repository_source_sha256": "790763723dfadc5dec31554f8a9e87351870b9e2349b403fafb157275b3b6548",
      "en": "「I can't lose the Captain!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:1825": {
      "repository_source_sha256": "f322c21c682c9250128c9e0d40acb8867572d753179a6fa99e811c990f2dcf67",
      "en": "「So you're my opponent!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1850": {
      "repository_source_sha256": "93dee3816cb3b6b9a1a4ec583e58bfe30ea8bc39aa2497ddbeb2e535d36a0be7",
      "en": "「One-on-one, huh!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1873": {
      "repository_source_sha256": "d1cd2a504085ca216eb413d4e8c66be57734fa79e94d32aa9e3e61d9073e77ce",
      "en": "「Let's fight fair and square!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1896": {
      "repository_source_sha256": "87747b1628c652dfda9f560ad57c247a6f657a394f42fb08e69f3c98226a950d",
      "en": "「No time to look at anyone else!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1939": {
      "repository_source_sha256": "3b5b1c1ee02ec4cbabffd8bb847d22b825bdf36c38f037e7b97a599bf3686122",
      "en": "「I'll go first...!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1960": {
      "repository_source_sha256": "6d1dc9c6276051c01bdf0e8497774cfad4fca059af12c82e6f902029b102fd9a",
      "en": "「I have to pass the baton smoothly!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:1995": {
      "repository_source_sha256": "142c5764e79c457ad7acc4df942b95131f917f01ffba84b74dc24b769d99878c",
      "en": "「This attack will draw enemy eyes!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:2030": {
      "repository_source_sha256": "77692f04da72383574a35fe94f6076f39d1130ef2fc6fc0a60f1aa3561e478f6",
      "en": "「I don't intend to be just the decoy!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:2073": {
      "repository_source_sha256": "d1668e6fb458b3c79cee1bdcd8b3a53eece6f9aeb12ad5e5c8ffc6bd1f0b0fc6",
      "en": "「Let's all pull together!」",
      "source": "new",
      "slice": "v_g118_00"
    },
    "118:2100": {
      "repository_source_sha256": "3b2f991119365da70724b24581e8a7f2ed5b40d151788c13bca86b5a87fada79",
      "en": "「No way! I can't attack!?」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2125": {
      "repository_source_sha256": "844fdde1304181b992d2c34f3f252a409bfec53b56383a9491e6846d3a203a05",
      "en": "「This is bad if it keeps up...」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2162": {
      "repository_source_sha256": "a66163f1dcdbba4d4b937ef1d28d93a0dd63da9aa993ad1800b69367f204ca68",
      "en": "「Feels like I fell for their trap...!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2201": {
      "repository_source_sha256": "fa8e0eaad5cb97abed04b73b9dae27e03514919413cae191a6f907c077ef3985",
      "en": "「Not good...!\\nI have to get out of here, fast!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2250": {
      "repository_source_sha256": "337f37504f730babd4e02a3696670bf7561b056946729e5472d4b4c55cb4070e",
      "en": "「You're so predictable...!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2281": {
      "repository_source_sha256": "f1ae83d4eafec48a2c4b84fc9e00c34fdf4d493718b61dabb29e422f863b0020",
      "en": "「You fail, with an attack like that!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2310": {
      "repository_source_sha256": "b335f004304c60e0c55b841cface3e05bf160d35332ab5f4f080322cc66fe112",
      "en": "「Thinking that'd hit? Big mistake!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2345": {
      "repository_source_sha256": "83352b437b4950b451f161ad0ad74703f609c42278098c3309c75bf10307c87c",
      "en": "「I won't let Asclepus get scratched!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2382": {
      "repository_source_sha256": "543ee910fc8ebd85db362079d72c15dc00faf2d5f25187eb5e48d35a2721d1db",
      "en": "「Yep, just as I expected!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2403": {
      "repository_source_sha256": "1331ce54f3a700e2105db299df70ee845384dba16dd21088c23be88c75e1ea7f",
      "en": "「Too bad. I see everything.」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2434": {
      "repository_source_sha256": "90e5e458a02a4647b0006ba3c1edd2c067ae4af8fbca292d0eb5356ae74e2838",
      "en": "「That won't work on me!」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2453": {
      "repository_source_sha256": "5ab9933acaf2f20823c1e02f5fa242b88763daa08249296e6622c29647d836c8",
      "en": "「Is that all you can do?」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2484": {
      "repository_source_sha256": "053a52a34fc4809745da83ab1c0e65e6c504ff66fcefe3504ea9db47faaac380",
      "en": "「This is the power of Asclepus, too.」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2513": {
      "repository_source_sha256": "8b38ba05f84498543124a05689241db0da670fc336487f01e51401bf4470ffa6",
      "en": "「Not enough fighting spirit?」",
      "source": "new",
      "slice": "v_g118_01"
    },
    "118:2546": {

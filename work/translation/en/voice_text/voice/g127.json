  "speaker": {
    "proposed_by_v_g127_00": {
      "token": "$$サルディアス$$",
      "basis": "Polite, wry, self-deprecating older Antares commander who calls Advent 隊長 and Blue-san, has served Chrono, calls himself a traitor, takes Girtar and Lord Barbiel as colleagues; matches Sardias's dialogue voice (Oh dear, Ha ha, Please go easy on me). Jigoku gave none."
    },
    "proposed_by_v_g127_01": {
      "token": "$$サルディアス$$",
      "basis": "Calls Gilter 'Gilter-san' and Barbiel 'Barbiel-sama' (covers them), jokes about being 42 (Sardias gives his age as 42 in story), calls Advent 'Captain Advent', Rand/Crowe/Setsuko by -san; Jigoku has no identification"
    },
    "proposed_by_v_g127_02": {
      "token": "$$サルディアス$$",
      "basis": "Calls Advent 隊長, Barbiel 様, Girtar/Crow/Rand さん; polite self-deprecating older officer; matches Sardias' story voice (Yes yes, humble)"
    },
    "jigoku_token": null,
    "token": "サルディアス",
    "basis": "settled 2026-10-02 from fresh-translation review: Polite, wry, self-deprecating older Antares commander who calls Advent 隊長 and Blue-san, has served Chrono, calls himself a traitor, takes Girtar and Lord Barbiel as colleagues; matches Sardias's dialogue voice (Oh dear, Ha ha, Please go easy on me). Jigoku gave none."
  },
  "lines": {
    "127:0": {
      "repository_source_sha256": "66cc1e3d1194f56720b7198e97616175b653221b03bbdb4dcebce5ef7a946f68",
      "en": "「Ah, so we have guests.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:37": {
      "repository_source_sha256": "19c832eaf12602bad93e698bc29bbd8db255ce781981779ab2303333d54e14a2",
      "en": "「My, my, how impatient you are!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:78": {
      "repository_source_sha256": "c6883c7ed261faca491a59cf95e11993f00b19909c91c9ffb45537fba8bedfa5",
      "en": "「Well then, would you oblige me?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:111": {
      "repository_source_sha256": "c80a25d05ab7ba1a6529ae09391adb0f2416de2b1c303cb2cd1446dc8bd3256c",
      "en": "「Looks like I have to fight.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:146": {
      "repository_source_sha256": "246b1ae3c5958dc55f322e88e0f88b76f0b69dd61e14e3afbcfc5d4d3e5cd610",
      "en": "「Well then, please bear with me.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:187": {
      "repository_source_sha256": "ce45f8ae5d01482eb37aba78f3e006dc1dc07f080e72f4a4412dd2b364469583",
      "en": "「Well, well,\\nI'll try hard enough not to die!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:236": {
      "repository_source_sha256": "00a7515c7aa0b3628da58052560068ac5fea6a2ca4940fdf5504b8b7663dc18d",
      "en": "「Shall we both take it easy?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:277": {
      "repository_source_sha256": "6d01befd7ce31064fae6d6516ed8c50177154554943313841ccd0154779dddf1",
      "en": "「Is it wise to take on\\na small fry like me?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:332": {
      "repository_source_sha256": "95983a92193780bf74f4bf281587a33c57efba7451b55bf6afb5a09bd17ed063",
      "en": "「Now then, how long can you hold on?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:369": {
      "repository_source_sha256": "97c9b7b0f457de11858bf44a85364fd705a5bec093b72e4dd1743e8f9f4467ec",
      "en": "「Do go easy on me, if you would.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:408": {
      "repository_source_sha256": "cd6c1c0c299aa777e347c8b0d282b629ad74bc6c2df6e546c515a5dea02cbbf5",
      "en": "「Allow me to be a little rough.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:447": {
      "repository_source_sha256": "5ec8d8a9ee9ad813543e9572757f48f1af608751544b3a6e4d6d206e134fd7b3",
      "en": "「Let's keep it easy. Nice and easy.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:480": {
      "repository_source_sha256": "04f62c4c19c50d4bd086ab142750c975f9024d16e9b169f5faf201572b640b4f",
      "en": "「Let me see it, then,\\nthat galactic frontier grit.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:535": {
      "repository_source_sha256": "ddec4250d658f70d7984462ba6a7343605dbcf0bbc13846aafa201c1fa2ed275",
      "en": "「Feel free to call me\\na sneaky coward.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:584": {
      "repository_source_sha256": "c5af570680560e8b8f69c372ff05130b49ef7513f112e8fc7ed6302d5969cda7",
      "en": "「Shall I unleash the hatred\\nsleeping inside you?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:637": {
      "repository_source_sha256": "cca73406658e5532fb38115ab63da129364cec21628a0d311ef264f16e1a1034",
      "en": "「It's part of the job. No offense.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:678": {
      "repository_source_sha256": "ecfba3349dbb5b9a644a545b54849ee8de8e7a3e04778d78a6ba0552a093b795",
      "en": "「If you'll excuse me, once more...!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:709": {
      "repository_source_sha256": "b1638bc70bc86a66bd7596517dcdbe28d68708bf0b26ed8b9da8c63e7952c598",
      "en": "「Believe it or not, I'm greedy.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:750": {
      "repository_source_sha256": "797cbcb8971092aac73cb41159a1802d206086b9d3c5e1ef4c05ca7d05005c28",
      "en": "「Won't you kindly be captured\\nwithout a fuss, $$セツコ$$?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:803": {
      "repository_source_sha256": "beb24698bf38feceb1cd0b3dd14e2ee2b51b59973112abc5af8585c196c17df1",
      "en": "「I'd rather not cause you\\nany more sorrow...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:858": {
      "repository_source_sha256": "70c2b688cab2522eb39acfcf795b83d346a5c506cc4155a74aed7b3efc010434",
      "en": "「A sweaty glutton with smelly feet?\\nSo my opponent is $$ランド$$?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:917": {
      "repository_source_sha256": "1e3ff965b2ce95f8c234bed38c425278793caabfeb46e1c274cd84a8d9abd194",
      "en": "「Let me test just how tough\\n$$ランド$$ really is.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:984": {
      "repository_source_sha256": "ec55b3420c89dfc23d605810c0b78b64201ed969f1303e15f4018f2f593e0991",
      "en": "「$$クロウ$$, you understand the debts\\nof honor in this trade, right?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1049": {
      "repository_source_sha256": "c6ff5a1f49c17698f2e3f573c9cfd5d35cde226d5ef595d20bbe65c4b4e4e974",
      "en": "「I'd have preferred to settle things\\nwith you using money...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1108": {
      "repository_source_sha256": "acd8c35a534ac360d7b73f1d9512669fab0112f739421bf27ba90fd3cd59e0fc",
      "en": "「Well then, I ask for a match,\\nCaptain $$アドヴェント#pilot$$.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1157": {
      "repository_source_sha256": "b4a29e6bec98fb3c1d0c5c83b009aac7e9bae01b0d6acb1cde7ddaf052e71228",
      "en": "「Hmm... Still as hard to pin\\ndown as ever...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1208": {
      "repository_source_sha256": "e5ec7e6ae02c6c76ff7e3013a51af142a1dcf684556599a6f7b2570a59b20691",
      "en": "「$$ブルー$$ looked after me too, but...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1249": {
      "repository_source_sha256": "dfacc6ed5255e8b7f3306d2ae6ec3a1b1cbd3332950b27922c217f3901248dc5",
      "en": "「I'll never forget your cooking.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1284": {
      "repository_source_sha256": "141d2b93bda79cb0f845564eff2530c79444d305d6b65c98afbaabcfc1d43eb2",
      "en": "「So you're members of $$クロノ$$?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1315": {
      "repository_source_sha256": "6bab12bbd9b4c5af8707c337aa631de058135eb16ebd53f6576b6896678e1b13",
      "en": "「Up close, super robots\\nare really something!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1368": {
      "repository_source_sha256": "40e12a4c4d8eb1a1e06ddf579f4e6c86a23c0d6c431eccb5551615612aeceb0c",
      "en": "「Thick armor and super power...\\nNow, how shall I fight this...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1425": {
      "repository_source_sha256": "89ccb66119c2fa931e8329b9ea7baa3d8b444a59581f53ee9e1c885e308d3054",
      "en": "「Oh! Photon Power energy detected!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1464": {
      "repository_source_sha256": "aecab568162b95568c4314704b202fa8726d165f9ad2707f3bb8170469f750af",
      "en": "「My, my... To think they'd actually\\nharness the $$ゲッター線$$...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1521": {
      "repository_source_sha256": "d06cdf3775b18bfe3e5c953d57abebac3110aaf8c593ca274da2734573baede5",
      "en": "「I question whether something like\\nevolution is really necessary.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1574": {
      "repository_source_sha256": "26b268bcdad82833bdffcc47a6c21cbe814a74c4f6400523ff74a3b0f2cda41b",
      "en": "「So I face the $$マーズ$$ of rumor?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1607": {
      "repository_source_sha256": "8bd7b7a02f08cad670c2f708955012bbb6731e6dbea62d23fef888fa769c57d9",
      "en": "「Facing a Mechanical Angel\\nmakes me shiver.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1656": {
      "repository_source_sha256": "642f1d200b635c4c35f82e7d053e1ccb399bf0663effdcdbe1a5a25adf9a018e",
      "en": "「Oh! A drill robot!\\nYou know what stirs a man's heart!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1715": {
      "repository_source_sha256": "c5dc09db3fac06b54d3d145952386d0e22a98e2837955afc26b68e53efd50ec5",
      "en": "「Believe it or not, I love animals.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1758": {
      "repository_source_sha256": "bfef7f485428e574392bd099a9333f650df08407c1841996702fc3feb269b0b6",
      "en": "「Hmm, this won't do.\\nUsing things like this...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1815": {
      "repository_source_sha256": "2ebb3109128dc4929fb7fa5e50bde2b73576c2ad122f53486e0c3bccf965dea5",
      "en": "「I know all about you,\\nMr. Something-or-other Gundam!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1870": {
      "repository_source_sha256": "87a488548c79ce8d678604ba12152a5951949fb3e086a916367d2c0b0ba6e9e4",
      "en": "「This won't do. Wars start\\nbecause people like this exist.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1927": {
      "repository_source_sha256": "8c48291f1107c6f1b0dd2c2f7f537f335fdf7fb8308a22e17eea866433989a9e",
      "en": "「Oh! Does your head go zing? Zing!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:1970": {
      "repository_source_sha256": "ee63ae994f143995b94b834eb485bb27cd20fe165a87212e37b360b0b55cd1f3",
      "en": "「Oh, you're really getting into it!\\nI won't lose either!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2019": {
      "repository_source_sha256": "dfdf9b9fb39cc7ed32ba2ea12113307d04190c5374db8516dcd83208180e224a",
      "en": "「Hmm... Even I'm lost for words...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2060": {
      "repository_source_sha256": "768e31cef44d84c14d0cca659cff0213124253138a291ac6dfd92573ebc6211a",
      "en": "「With you darting around like this,\\nI'm getting dizzy...!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2119": {
      "repository_source_sha256": "22720e767eeb68776a2c1dcebc847ee554dc03f06afde395da9d0230ad45429f",
      "en": "「Truth is, I was a boy good at\\ncatching cicadas and dragonflies.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2178": {
      "repository_source_sha256": "fcb6f09a95cea1011b6330ea74893f6089a7a74a1894647c3000f962836f4386",
      "en": "「You're a fine commander. I'd even\\nlike to have you on our side.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2237": {
      "repository_source_sha256": "72078bfdc6a039e8e075988a9f9f9b7786585f186f836014cdc146d873310b44",
      "en": "「A battle between commanders\\nought to be worth watching.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2290": {
      "repository_source_sha256": "e38ad9928e04c2b02070f313b707f161ee6b7d4fb31d5b55e2807a2e72700cbb",
      "en": "「You look like an ace to me,\\nso please go easy on me.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2353": {
      "repository_source_sha256": "2ed2c7ae2904a364c29fcec6e90e7217e08eec745833991945e011d1c48c84a6",
      "en": "「Dear me...\\nThat's a speeding violation.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2402": {
      "repository_source_sha256": "45e8a5c8be423cdac6d6b881da09ff7c000e6795ab2cc0e5e8bd25c3755b22d6",
      "en": "「\"A big man's wits never reach...\"\\nSo they say, but is it true?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2459": {
      "repository_source_sha256": "6a2137a36603440e7d7c3e2a29e1e5725f888ef4b9b924c7d7e101b1322150eb",
      "en": "「Don't relax against small foes...\\nThat's an iron rule of battle.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2520": {
      "repository_source_sha256": "a92ab74be8817e60451205b0e63a2b32aaf876d4fa6123d5cffdecd3d008e2b0",
      "en": "「Let's go after a big fish this time!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2559": {
      "repository_source_sha256": "628058f41d48510168fc4867b09c8f60826aeeb70cc58462a78be23a2030893b",
      "en": "「Direct hit on the bridge. The End!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2602": {
      "repository_source_sha256": "65b8e1e9b46244dfb521cf7530efe1067c6a3d08e8f9326960663a20f67d89dd",
      "en": "「Now then!\\nLet me borrow some youthful vigor!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2653": {
      "repository_source_sha256": "3732d28c3bf65c0f3f5b187741bc20ef58b53c99c434f0057855d15e8f3a465e",
      "en": "「I'll ask a youngster like you\\nto take me on!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2702": {
      "repository_source_sha256": "2bc08d52e8c03b468d128280e781fde98f0b062c6478efadde07629e5f07e817",
      "en": "「That stiff side of you\\njust doesn't suit me, you know.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2755": {
      "repository_source_sha256": "7a5e37523d752e39969f3a83ea711518fd64eb93a6d099a7a3854016f398ea38",
      "en": "「Worked ragged for peanuts, damn it!\\nThat's about the size of it.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2806": {
      "repository_source_sha256": "0ca736a445d8d78038a4067093ba8fdf2a0fa292e1bb3dd1c89a65b94943c6d1",
      "en": "「I bear the name of traitor now,\\nand fight having thrown it all away.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2875": {
      "repository_source_sha256": "eecf79016b3b99f06c2e4445e07d7e52511696c0eed1cbb15b238c5585e588a5",
      "en": "「You're a frightening person, yes.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2910": {
      "repository_source_sha256": "7371b4fd0bf9eab1763a325f2584644b7fefb59bad146d5f37e6a0eba9c0db8c",
      "en": "「Ugh... Just getting close\\nseems to wear down my life.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:2965": {
      "repository_source_sha256": "c96ee350d0c01a649f222dbbe248115727a459f88755f70dc684424441de62cd",
      "en": "「$$ギルター・ベローネ$$ seems to be\\nthe same as ever...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:3022": {
      "repository_source_sha256": "dcd130e52a2146a0c7d41ed8661d6a4c588900819142f828bbc5287d2dfa005d",
      "en": "「Somehow, everything you do\\nis just so uncool...」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:3075": {
      "repository_source_sha256": "35140df45a940f113d4b55344b10d32b655313ee90cad9d7eb59d0530f263734",
      "en": "「A bit of a tasteless weapon, but...!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3116": {
      "repository_source_sha256": "2752dc5defcb730d707d755584574c88420d0669f7204dc299c4006e39b5b499",
      "en": "「It's war, after all...\\nI use weapons like this, too.」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3165": {
      "repository_source_sha256": "45af09dac70c38e9f31c87c5835bff2e193791958df5624595a9d0082e7b6698",
      "en": "「It seeps through to the pilot, too!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3202": {
      "repository_source_sha256": "832de302f9b784a9fab1d81c10894f9a280a2c9ef0566acc52bebbd7f8e785e5",
      "en": "「Demons out! Poison in!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3229": {
      "repository_source_sha256": "72cfbfccc146c6e7bd02327a23dee35159e3675cec1e6be5fe17f938259263c2",
      "en": "「Here we go! Poison Mist Attack!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3254": {
      "repository_source_sha256": "d623d5a110b0525841df9ceeebade16d5bf1730b28de8ed07a265f42bc6573dd",
      "en": "「Here comes the big one!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3277": {
      "repository_source_sha256": "ac68b283e08baf0e10e09582fc5cc0d9c5d19706b453a1a561310f24c432b5d4",
      "en": "「Here we go! And this! And this!!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3312": {
      "repository_source_sha256": "308b858ad35c836fd852c64c85ae420e3b3342d2c3e6e653074ec3e4cd502bd4",
      "en": "「This machine prides itself on power.」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3351": {
      "repository_source_sha256": "f93fa91c57541cfc6544b7dd0898c80176a0c445fd269838b72649fd7ecbea7e",
      "en": "「Too bad!\\nOnce it's come this far, no escape!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3404": {
      "repository_source_sha256": "8d7f4c6775fe988b031d13e0e8e1c56453a1a0510775abd76421c6257f29fec5",
      "en": "「All that's left is to charge in!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3441": {
      "repository_source_sha256": "3cd05be20b6f82844748cb5d15a3a016dc5c5c14dabf5281a7ef58bfe3de97ef",
      "en": "「Heave-ho! And in it goes!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3482": {
      "repository_source_sha256": "85706e146ba731076b01ebab343324779141d7432869bd48c8211175c34b70fd",
      "en": "「Let's get serious for once!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3519": {
      "repository_source_sha256": "c0162d58ce5ff1082aea22b80bc4cfee7831394264328951602018ca677a0d5b",
      "en": "「Sorry about this. It's my job.」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3558": {
      "repository_source_sha256": "16959bd7b0679b2590d26d2bcd8efcd01dc6d7ec0835bc4ade380518af3ae875",
      "en": "「I do hope a random shot hits...」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3601": {
      "repository_source_sha256": "6b48b7ae6e9ba3e6d4d78ac4cd4d68db7dfaeed21e650c71fd53c358e059e7eb",
      "en": "「I always shut my eyes when I fire...」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3644": {
      "repository_source_sha256": "9cc7d77af6f73ff965c52f8b8897c9e663551621d0d9251f1199b5339e737d18",
      "en": "「Ahh! Stay right there, please!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3687": {
      "repository_source_sha256": "3d0edf1b0c9526a8d6dcc207e63839ecf452e7e982b09e33e36f0f5dbcba98d7",
      "en": "「Nice, you're totally exposed!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3720": {
      "repository_source_sha256": "0be1d55f60727289fba5aca938025132d44d749d78707c4ad9c296f08404f372",
      "en": "「Here I come!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:3737": {
      "repository_source_sha256": "1c83bf12528e178eec4c313dbd10b3655a669060cc8df60c22aab31f1b0c2e9f",
      "en": "「Prepare yourself!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:3752": {
      "repository_source_sha256": "e54afb5af900ae042100032a58d41d48350e462bb67083207eec5bec12953889",
      "en": "「There you are!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:3769": {
      "repository_source_sha256": "c2ecdb1141546ed9603eccb604f9c1e5a5c6b807fe269642bc3c78eb4710ed3a",
      "en": "「I won't miss!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:3788": {
      "repository_source_sha256": "191c48447cf7aba97bbbfa49f1f82095ece47962a9ea970b039f92ec99f5e0dd",
      "en": "「How about this?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:3809": {
      "repository_source_sha256": "bca65c01c9f56cf5065b3ff46f3ce54c866a10389d66c4d397285596bd2783e3",
      "en": "「Can you dodge it?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:3832": {
      "repository_source_sha256": "668dbabcab000fb5d6e1f98a4b12fd8e61079e3f0fd6d83742105935241f5a95",
      "en": "「First, let's start with this...!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3857": {
      "repository_source_sha256": "2bfe7617ef05b7bf4e2fb1dcb37e825ffd4bc2995090215ef0da2a8356639e14",
      "en": "「Next, how about this one...!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3882": {
      "repository_source_sha256": "2e948df9abccd795322903328ca39865318baeac75d1baff022e2d78450d04f8",
      "en": "「And finally, this...!」",
      "source": "new",
      "slice": "v_g127_02"
    },
    "127:3905": {
      "repository_source_sha256": "4c5e64f1b4f06989988297708f0de84bdc1f4539fd895fa1cf213d426ad97950",
      "en": "「Well then, shall we strike back?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:3936": {
      "repository_source_sha256": "10e919872daf99974a5b6e2200bacaf69fdb92caa99ff20a647313401d755008",
      "en": "「Being beaten without a reply\\nis rather galling, after all.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:3985": {
      "repository_source_sha256": "1b02102f35ca9d34677ce346df8af1af5ef95b53d6376d7a43b4f1aaa419aca4",
      "en": "「Could I have a turn attacking soon?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4026": {
      "repository_source_sha256": "9f2eafaba63257ef0b425b1708fae56c2cff54f73b252e47dad2fb1a999e90f5",
      "en": "「Too bad! Attack and defense swap!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4065": {
      "repository_source_sha256": "d899469742ee4384dbcd854782cefaa7807a80529b6861b7492380de7d5e5cc7",
      "en": "「Believe it or not, I hold grudges.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4104": {
      "repository_source_sha256": "0d4fbde469fc1bdb64b113ed5a51355a5b860922c8e6f34f9339bccb6cedacc7",
      "en": "「Oh my... I can catch up, then.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4147": {
      "repository_source_sha256": "4a61b557fe5d4bbd2a12d1c0b3b1bfaaaf952da13a639db53884ab4ea8042534",
      "en": "「Your position's obvious, you know.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4180": {
      "repository_source_sha256": "8ba16f55fd8dd5534254e9050d81a7dd3ef581ad875950ff255505b80c780eb4",
      "en": "「Sorry about this!\\nI'm alive, so I'm hitting back!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4233": {
      "repository_source_sha256": "d4a13469acb23127eeeea44b2e30c89ee832b5d8ff13773d6dc7422666200730",
      "en": "「Leave the cleanup to me!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4262": {
      "repository_source_sha256": "c213765f2758447a1c9ca09438642f190ed9b648b3a52a12d2ec2f9654ad9ebd",
      "en": "「Then I'll help myself to the rest!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4303": {
      "repository_source_sha256": "587095401e9b40d3416637e20e48eee32741ad4ad01e16a8cbf6c1e8dfc0b19b",
      "en": "「Do your job properly, $$ギルター$$.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4346": {
      "repository_source_sha256": "a2e78eb0434b9fffb65ce7075fd9ddc740263b22fb996b2aea12b5b9c07a5767",
      "en": "「Allow me to follow, Lord $$バルビエル$$.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4385": {
      "repository_source_sha256": "b296398ea4280ccf829fbcd6905c9e77cd61b61c8ee54125bbb9e10f0cdec269",
      "en": "「Oh my... my body moved on its own!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4422": {
      "repository_source_sha256": "338d17cf0470c423a72b583a1a2be3ec05f5b8e23ef2ca9bb54c8d36bffe5c50",
      "en": "「Can't be helped.\\nI'll take this one!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4477": {
      "repository_source_sha256": "91d5ecda680910e4b8eb8ffc2f87edb5be70f6ecf9cbad2e36e0111528d8cce4",
      "en": "「How many favors is this now,\\n$$ギルター$$?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4528": {
      "repository_source_sha256": "68137daf34a636a48777934c4609199142a3efcdd2cd2e71986f54b7730f04e6",
      "en": "「Allow me to look after you,\\nLord $$バルビエル$$.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4577": {
      "repository_source_sha256": "4e68bddf5a420bba7e4c8e3679ce4c17870c02d4214ab89c160175991275a10a",
      "en": "「I can't afford to fail!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4610": {
      "repository_source_sha256": "ae769435a7411a2a0ebcd7170caac5ca8c0e31a9aca2a92f99b767100ade39ca",
      "en": "「Don't blame me if they don't fall.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4647": {
      "repository_source_sha256": "21030b1c06447961a9bac203d075b03a57bbff647e80401a2a81b4dc2b3514b9",
      "en": "「Don't expect too much, please...」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4686": {
      "repository_source_sha256": "22b41a3b3821d74ac8907bcc61b15709dd58fadf6f82f133021f70e2294e9ae4",
      "en": "「If it works out, enjoy the show!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4715": {
      "repository_source_sha256": "f0b2fe255c60c658c354d49b1023123f6597df232d97f6eaf35ce5b9fbc5247f",
      "en": "「I'll run out in front~!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4742": {
      "repository_source_sha256": "be281dcead865013843098c371e993cb4bcf92a2e767d692c53e2e65143fa2e1",
      "en": "「Back me up from behind, please!」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4781": {
      "repository_source_sha256": "3af99e997112be2afe6baea3d44ce7c9d65b31d1e767eb0b0396d7ed62c2fb42",
      "en": "「Huh? Am I... the decoy!?」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4818": {
      "repository_source_sha256": "ad0b665186e1262b757fbf478f6ddac37b51302ad123bafee9d0fb5f91e867d7",
      "en": "「The old man goes first, yes.」",
      "source": "new",
      "slice": "v_g127_00"
    },
    "127:4855": {
      "repository_source_sha256": "64295dcb7212fb41f2bfd8a3257dbcde0243afc999b76e34b6f7c161e5b19aaf",
      "en": "「Aw, can't counter? What a blunder!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4898": {
      "repository_source_sha256": "c4bc204f0a755cc8136a0d9e6d2732eb39c81d2cb48029342b9bdf2100de278c",
      "en": "「A life of just watching...\\nHow dull it is...」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4953": {
      "repository_source_sha256": "e848ebbcba679d781c0d394e454b1e1e440776a7f7c108dd201e7b2a6715bd9d",
      "en": "「Seeing them off... my heart aches.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:4996": {
      "repository_source_sha256": "2024e8f44b0315aab2c03ce2a1361b4fb063f1cd8e1578c36951259001fd49d6",
      "en": "「Nothing I can do...\\nMy own incompetence is pathetic.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5055": {
      "repository_source_sha256": "329e6ca9f1ed124f45f1defabf0387dcfb7770ec7b6ccc876798c937e57b27b8",
      "en": "「It missed?! Oh, lucky me!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5096": {
      "repository_source_sha256": "7baad23d51f98d67b1a2115edb11fa1d4b0227357c29baaa0db1eb7091c71584",
      "en": "「How's that!\\nNimble moves for a 42-year-old!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5153": {
      "repository_source_sha256": "65ecb067901f7dcbc06b3887e46bf8cc3c9226fe3df938d43ec8068289637c6d",
      "en": "「No damage, but my back\\nfelt that a little!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5210": {
      "repository_source_sha256": "1011533128ab3e8a34483aca084f5574146e2e0a74751fae06e2262b880b7a28",
      "en": "「Mmm!\\nI'm impressed with myself!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5263": {
      "repository_source_sha256": "8a8f5c87f221bc3ab5e82dc131cdf64e29c26fb3bcaed252ef63911ab6dae173",
      "en": "「Believe it or not, I'm capable.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5302": {
      "repository_source_sha256": "44846e67b1b9e9c8053a64e7ff572d1763e6653ec7fc6b08a31c0f59f6c88ca1",
      "en": "「Well, that's the wisdom of age, yes.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5345": {
      "repository_source_sha256": "249fde3de5bf62a811f0e93c89353fee95cece335ef2a4232cb120c836905ab4",
      "en": "「Is that your true strength?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5376": {
      "repository_source_sha256": "4b55e8b36c485ef4de464d7cd6fdc83c29d71e5f24ba3badaefccd294f286936",
      "en": "「I'm disappointed, to be honest.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5409": {
      "repository_source_sha256": "f03586d5c128ccd9a2c181071899627ef18aef9e3ddb044f554d37a4eb8ffa11",
      "en": "「So this is the most you can do...」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5446": {
      "repository_source_sha256": "b87650bba62cbbc093c2f62ce4392ef8553d362d52695b3c7822860571bdb015",
      "en": "「As a Reactor,\\nisn't this a little bad?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5501": {
      "repository_source_sha256": "5e616a6f895746f9c4ffd14263b1eb2559c3c9db9d9cc5535814e2b380d3b86b",
      "en": "「It's fine, really.\\nUse the Sphere's power freely.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5556": {
      "repository_source_sha256": "8ac9ca0c74f28b28119bb01f762c1da37f6a6f26d1bf3d062c29d4fbd15a2684",
      "en": "「Shall I call the taboo name, $$ランド$$?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5599": {
      "repository_source_sha256": "ca481c5825a58f9d10e3c7f1c747c67d2892b89c3a81763fd747a522a6beb966",
      "en": "「Could you come back later?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5626": {
      "repository_source_sha256": "00ef85b3c2d9b3e5ce3e6bc2c7a6f94c422e65e10b150a2a82ba6dda1c641657",
      "en": "「Too bad! That doesn't work on me.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5661": {
      "repository_source_sha256": "564dd6600ec761951854704130edf0f0f3bbe19561f135029db07c837ee8e8c6",
      "en": "「I'm so grateful for this fine gear!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5694": {
      "repository_source_sha256": "c3abce4569e7ad09cdc33ca889ab2809891f799f20ebe1ae110f5a72258de631",
      "en": "「Whoa! It hit!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5721": {
      "repository_source_sha256": "06eea34c995aed859097f4a2cb32f01baf9eb7a1f229b7607844d1e4871302d5",
      "en": "「No luck...\\nI'm just having no luck today.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5776": {
      "repository_source_sha256": "cb5105e35a3a10eb4bb614eb0711771bc031c1fb52e3a46d0b99615843613d9a",
      "en": "「Ah... well...\\nEven monkeys fall from trees, see?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5833": {
      "repository_source_sha256": "77d05e47a90b3335f0fa451ab069ef11b4326d512531b6d939af3a24245b29e6",
      "en": "「Reactions slow with age, you know?」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5870": {
      "repository_source_sha256": "d91e1cf5a4a650adec324cb844e57d9b260279c31813afc503aaa7b90ca0222d",
      "en": "「I saw it coming, coming, coming,\\nand this is what I get...」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5921": {
      "repository_source_sha256": "dc905f8e604431182fe5bbd12466b55562bc6f63c0e274132d678c5a1ccc917e",
      "en": "「Woe is me... as they say.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:5948": {
      "repository_source_sha256": "6cf3edf0bfcecfcbfea6289efa87317e52b36ba018acbfa0dfaf7dbf0b1f32a3",
      "en": "「I read two layers deep,\\nand it came straight on after all...」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:6003": {
      "repository_source_sha256": "72609ee6a88cf7dbdbae22bbf2857fda812e37b886ac9dd66ba1c0d3846142ae",
      "en": "「Don't mind, Mr. Dandy!\\nAnyone can make a mistake!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:6068": {
      "repository_source_sha256": "86d8a3917dff887a0099f50409daa49a413c2ddc8d21d1e6b4e0ccf04f7830dd",
      "en": "「See?\\nI just didn't need to dodge.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:6119": {
      "repository_source_sha256": "055332b226d40de6b71066dee89496505a1c91a72e140e23cebcae27299adc72",
      "en": "「I've felt your strength\\nfirsthand.」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:6168": {
      "repository_source_sha256": "5d04ee60c70cc7ffe474e38ea7ea50d263ad07a226cd110539ea8e5278ac690b",
      "en": "「Ow ow ow... my chronic bad back...!」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:6207": {
      "repository_source_sha256": "5c57af9cc34e6e50d2ff0e964d3f6063bdf9811e6f9417d1cdb01db801f136e5",
      "en": "「Ten years younger, not like this...」",
      "source": "new",
      "slice": "v_g127_01"
    },
    "127:6246": {

  "lines": {
    "148:0": {
      "repository_source_sha256": "dbb8bee38913459703bf692c346733e0a25c4ba01c2294ebf90fed764fc927b0",
      "en": "「Farewell.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:13": {
      "repository_source_sha256": "5e72f16500cb47c789eb8675bf34bf62fcc2ea1ed7b6961312893afed096b4ef",
      "en": "「Vanish.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:28": {
      "repository_source_sha256": "9fe99cc9b52fae4fc1159106b13aa8a9b2cde80bda13ffdb950d05b016c91c63",
      "en": "「Take it.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:45": {
      "repository_source_sha256": "086e4bc48ccc27018c6b1cbf2ca73c487a057e9624af9ffa237516f322affb62",
      "en": "「Know the extent of my power.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:74": {
      "repository_source_sha256": "aba3dbbcd8b9e1f2c9f9fca47eeb9c4b8758d4d43ec19aa14ab70606cd15133a",
      "en": "「To think you'd defy $$ズール$$...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:107": {
      "repository_source_sha256": "15aca8bf75a71137a741985d95d3a0b8301bac765eccbcf7009c560ab618ecd8",
      "en": "「I'll send you to the realm of death.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:140": {
      "repository_source_sha256": "ac578cc4e534519d77bb88f39e103320f06cbab9cc2990c44ffa0fb93c8cf4b3",
      "en": "「I am $$ズール$$... ruler of this universe.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:179": {
      "repository_source_sha256": "7622d1db294bca76b631e7662daf33c851e486da8535091049bffcdbec79f483",
      "en": "「Love, freedom, hope...\\nAll such things are lies.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:230": {
      "repository_source_sha256": "37a295bdd48ff1df32c0a70054d135c1fabd8308c9c890265250a0a7393c3808",
      "en": "「I rose from the realm of death.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:263": {
      "repository_source_sha256": "9ee3961458c315b0a0469fa5e0305725edd6a04a32848d9a45c6eb8fc7180f58",
      "en": "「Take in the malice of this universe.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:302": {
      "repository_source_sha256": "6ef499e78593bc7000623d1ec8e24b2d618191a3a3cb717749d557a1008827c8",
      "en": "「Behold the power of the dark world.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:335": {
      "repository_source_sha256": "5f89a4895342ee11e7766667e544dde8ddd4f5cfa2c613b938cf83be1ac84792",
      "en": "「Fwahahahaha!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:354": {
      "repository_source_sha256": "c90b1016b506c2a457eeac37150db43332bc931959ada7d7a974e0fd0ad91c40",
      "en": "「Hahahahahaha!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:379": {
      "repository_source_sha256": "a1d9f85eda40c83f86c7ac47ef44505c3e426e27076ad81f65c1e48bdccca586",
      "en": "「Die!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:394": {
      "repository_source_sha256": "8d0972eb3e7281a0d11544bcfa91a22d010a92e5d397b7d26f3d86f4eaa73773",
      "en": "「Still alive, are you?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:417": {
      "repository_source_sha256": "b5061a9984b1098e1f310b82424ef8a2bd84e10645d0e2c34246076387f9eef2",
      "en": "「Turn to dust and vanish, $$マーズ$$.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:446": {
      "repository_source_sha256": "c4a27089a0cea71b975b37ca25c195ae811ee31df25d8b3cfa50178fb084af63",
      "en": "「$$マーズ$$, you die here.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:479": {
      "repository_source_sha256": "2237d8067e0633ca85e924a525fcb056c9c85ab7fb9eabeb0f8e04fc6076618b",
      "en": "「$$マーズ$$,\\nI'll free you from all suffering.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:528": {
      "repository_source_sha256": "504d2f7964e40437d0bcfa6ed74f6b6b2b6b71c3f295337ef8a199ba46cb8f11",
      "en": "「Traitor $$ロゼ$$, die.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:559": {
      "repository_source_sha256": "2426c09f265e7f647b28355bc8d0547429d6e3f8828d4d66c3990ccf2a6ad75c",
      "en": "「Traitors deserve only death.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:586": {
      "repository_source_sha256": "e1088f1767b432eccc2bb75df2cc602ce6ddc6b5c6728e77fcab8cb643f8d968",
      "en": "「Even the Getter cannot destroy me.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:627": {
      "repository_source_sha256": "6c1a3953da8f9bc7e406e246ffa181f7bd7da3c1215fd002ffb165a667026cb3",
      "en": "「The power of light is useless on me.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:660": {
      "repository_source_sha256": "12eb5e4d17c9d0795d8a9b6c6db7783e565a75a677347d1334ca7dd936c1be8f",
      "en": "「The innovation of humanity is nothing\\nbefore me.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:709": {
      "repository_source_sha256": "91f9830545afe49380f1577aa6df838834a27a32a3c8d60231eba79ea1139062",
      "en": "「Runts needn't understand each other.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:746": {
      "repository_source_sha256": "0e61dcbdd8572272ee82a66c2a266c8a66faadec26b42c817813dec7f45162b6",
      "en": "「You can't subdue me with that power.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:787": {
      "repository_source_sha256": "783ebdbd98b14fbba9b8754e5a8aecbfea4fc1968dfdcdb43a06532c09dac6d3",
      "en": "「A king's power is meaningless...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:810": {
      "repository_source_sha256": "bf7ca0d2207a9f7a86590d6c6cf7036b7659f74b58dac97e4cbcd8784520b4e6",
      "en": "「There is one thing you can't pierce.\\nIt is... me.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:859": {
      "repository_source_sha256": "43ff589ab84ec3cfc1f0a17563ea1fbb9fc7aefa1c212a7deb39abda629c9dd7",
      "en": "「Spin all you like... in my palm.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:894": {
      "repository_source_sha256": "95e51d13e1a5e68028c5efe8e13ac10dd137bc76f0f51f120bb35d88043e123d",
      "en": "「You shall be punished.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:909": {
      "repository_source_sha256": "1fe674cdbf11fc92dc6a8dbf5019e19762d0675f62b67b79cf98962f356b2ba7",
      "en": "「This is your retribution.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:926": {
      "repository_source_sha256": "c949674475276e8e2d2a55163e1c28ba4148ffdf9f318e03df528141f61f0b32",
      "en": "「You won't escape.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:939": {
      "repository_source_sha256": "beb3aaa9b77edf2f7089509b8761cd19984f6152a987f170ed6c3225a2b4ffd8",
      "en": "「Still lingering there, are you?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:964": {
      "repository_source_sha256": "1b955b4e9a6d2c8816c943ab1359bd244ef57b434d6286faec44b36606cfe850",
      "en": "「Where do you think you're going?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:985": {
      "repository_source_sha256": "b70beff332d20d495d6ca263bf23411cc76f0bafbf091013f9d296c44e308efa",
      "en": "「I'll grant you a reprieve.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1012": {
      "repository_source_sha256": "7bd44b09a3cce4f5e2f4b230a560f350ca5dd63ba776e51b63de5247ebd34d4b",
      "en": "「Have you come to fear me?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1037": {
      "repository_source_sha256": "979e72fe52f436497ee4acf4d98e3e87dea665cdded7e5faba1cce93dbf32f54",
      "en": "「Impudent wretch...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1054": {
      "repository_source_sha256": "31b69853ee48f9918402b2a4b737f116e741c3f5cb672342873d5e59f70d69e8",
      "en": "「You live a bit longer.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1085": {
      "repository_source_sha256": "d5d0f4888cfd503950b2ff0c7c02907bb25f1f0008ee425f857a25f648e00b10",
      "en": "「What is that?」",
      "source": "jigoku",
      "slots": [
        "evade",
        "hit: light damage"
      ],
      "alternatives": [
        "What was that?"
      ],
      "review": "conflict"
    },
    "148:1104": {
      "repository_source_sha256": "7e80a04de796a5be11f7a2cb0f37294a792f9679e894891b0e5693f60687a38d",
      "en": "「A weakling's struggle.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1125": {
      "repository_source_sha256": "a4f0be25f1aca558aca6210a315a04fe4307b47f1d94cd589ae999e7c5c5cf4a",
      "en": "「I see through everything you do.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1162": {
      "repository_source_sha256": "dad03432d7b4891de817238d7eaf9ca31a6133592e14f20af9f2a52ce7f4df2e",
      "en": "「Know your place...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1185": {
      "repository_source_sha256": "ab0351e7382a9dcd208aa76aa3a0474a7b261f2a915108158dca2fac50b62879",
      "en": "「Whatever a fool does...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1212": {
      "repository_source_sha256": "c0e8fd46e0600da958609335a68406adff88f5be15305b301730662fc95232e9",
      "en": "「That doesn't even tickle.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1235": {
      "repository_source_sha256": "77de565d2ab8bfa125526725de405c6156e66eabb19c4b39ccd8f7f54a2822bb",
      "en": "「Hmph, how dull.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1252": {
      "repository_source_sha256": "8b20ece8796bd1e3f912ad8d380bf91eaf6809be0498c3138237c4513368c176",
      "en": "「Psychic power? That's all, $$マーズ$$.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1291": {
      "repository_source_sha256": "5b30ab293cf30738becbf248c957f76385835b3f89092e1560b5ec4f3cd1f174",
      "en": "「How feeble, $$マーズ$$.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1312": {
      "repository_source_sha256": "fa566392df5cb64471a742a72d3ea11f6122d8f87fe0719ef965ac976fd52676",
      "en": "「A traitor's end is already decided.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1349": {
      "repository_source_sha256": "33e93f89fc082f36722bd680fcadf8425c42c784847f173e49b937e7189e6732",
      "en": "「It's useless!」",
      "source": "jigoku",
      "slots": [
        "barrier/field block",
        "no damage"
      ],
      "alternatives": [
        "It's no use!",
        "Useless!",
        "That won't work!",
        "It is futile!",
        "That was pointless!",
        "Pointless!"
      ],
      "review": "conflict"
    },
    "148:1362": {
      "repository_source_sha256": "fc7832fe839bb570bdc9e4d7e4674a80f22d2cc0caa5cb7b5a0cfa1fae98202e",
      "en": "「Don't make me laugh!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1379": {
      "repository_source_sha256": "b74ddbc7af8bc790b8606823e809896e47d4deca12113cd8c43898277315c9cd",
      "en": "「Still won't give up...!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1402": {
      "repository_source_sha256": "5cd8de63fcceeccc0631c22078b10d70b266fe7e855843c1dbf02d753a76dc2a",
      "en": "「Not done struggling yet, it seems...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1429": {
      "repository_source_sha256": "1a3a2ebd16d24f235376633887eb3dde7c06832102bc404b77241ea04f544da3",
      "en": "「That's what makes you worth killing.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1458": {
      "repository_source_sha256": "e1e63639bc0a97b8a6819b708fd5f0146f714d14ead7b3b86311c9387072c7c7",
      "en": "「Had you obeyed me,\\nI'd have given you a fitting rank...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1513": {
      "repository_source_sha256": "6c8e24b36752f5e2f89cd6cfd75abc1017bb0bee2b6cdf42a221812ccec11a0f",
      "en": "「Annoying wretch...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1532": {
      "repository_source_sha256": "4d624b4637dd32f379847a0702a2f355922fa3f7bd71e0106a5dc0600717fb7d",
      "en": "「Kneel before me, just as you are.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1567": {
      "repository_source_sha256": "29f27a7e79cae0cc930f0ad9e199cf2779dfb7be6a4534a1f7256a6252973dba",
      "en": "「$$マーズ$$, you impudent wretch.」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1590": {
      "repository_source_sha256": "8c6f0979937175101a4a54cc7ea5fc521211758f3679fb84bcc304dddbdb8175",
      "en": "「$$マーズ$$... still resisting?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1619": {
      "repository_source_sha256": "597315c964b902c2039aba8e1a53750c58c5dcf7365492d7ab416ede7339f705",
      "en": "「Hmph, a mere traitor...」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1648": {
      "repository_source_sha256": "56c549fbd881566683594c3972125b11195668e8fb476804acb6df04e6d5fbba",
      "en": "「Why...? Why won't that one fear me!?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1691": {
      "repository_source_sha256": "986f3777a19a176309f85eefdcd55d14fa3cc5568d515e97e472f26f1f9a0d60",
      "en": "「Nngh! W-What is this power!?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1724": {
      "repository_source_sha256": "f94478da32069f8bca4e372ae2479fc565f679c375aa6d41cdf144cb0c742f24",
      "en": "「Curse you, rabble!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1755": {
      "repository_source_sha256": "c8a9332075a4b7d87b2f6284de6a8e35c65a3a0ceab082ba3413e3234e29fe65",
      "en": "「Ugh! How dare you do this to me!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1788": {
      "repository_source_sha256": "8ffaa4dc7d066ebfcb57034f9be6b558dda5ceaefe118098f01fdb270f538033",
      "en": "「Damn you, I won't forgive you!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1809": {
      "repository_source_sha256": "a918d028aac8c6dc99287825334e20d35eb6896d6ef24a2ef2b4194aed3b8657",
      "en": "「Enough! I am $$ズール$$!\\nEmperor $$ズール$$!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1864": {
      "repository_source_sha256": "e37af00ab7a32cbd8d6ed46a836a5854a4749c2addc32731bd1382bbbf9d7bf7",
      "en": "「Damn you, $$マーズ$$! You, of all people!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1899": {
      "repository_source_sha256": "972097c78481557042120d36483a141010781286a8748c47df260d64e504a386",
      "en": "「Letting you live\\nwas my miscalculation!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:1954": {
      "repository_source_sha256": "81fb7a218e444c44a41e697f5e04d28471100b3fc701bdcc79b811ea6c3d82ed",
      "en": "「Traitor!\\nWill you hinder me to the end!?」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:2007": {
      "repository_source_sha256": "be48b5b8044d5d12a30326e0904dc708c077c3198101b621d9c3575c5e2d4ea5",
      "en": "「So this is the Getter's power!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:2034": {
      "repository_source_sha256": "0457d9ec048d278eff5ada95372ec60edbf86f938ea05f0b91dbe10d342b7b01",
      "en": "「Photon Power... Formidable!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:2057": {
      "repository_source_sha256": "84ac7eb10e5c76bc4165f3c964eda8d0c2a0453a0cf5a323367b83c064f06de0",
      "en": "「I am the god of the universe!\\nI acknowledge no other!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:2106": {
      "repository_source_sha256": "b1a96d4f56c96582d40a59d2178acb2a24d66d95190288e75bfbdda67a1ce263",
      "en": "「Curses, to think mere humans...!」",
      "source": "new",
      "slice": "v_g148_00"
    },
    "148:2139": {
      "repository_source_sha256": "d76dc6f9e3d957b7a53a7c66db62bf6ae623db8be70d02989e130d78f04e5d66",

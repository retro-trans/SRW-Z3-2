    "proposed_by_v_g152_01": {
      "token": "$$ストライカー#pilot$$",
      "basis": "Cold AI speaking as 'this unit' (当機), calls Ensign Ledo 少尉 and Lieutenant Colonel Kugel, compares itself to K6821; same voice as the Striker rows in brief v_g152_00"
    },

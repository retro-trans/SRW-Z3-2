  },
  "lines": {
    "152:0": {
      "repository_source_sha256": "b06cc0b16c13e0f3e5d4e27bb248a6f7502d2a3f073d4a9da664b1ac300ba7bc",
      "en": "「The reign of one absolute ruler\\nis humanity's happiness.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:57": {
      "repository_source_sha256": "8023f36928460ae9270a53538ff58addb3e9571bd25467d8d8f527b6098a6fb7",
      "en": "「My thinking and judgment are the\\ncollective will of humans under me.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:110": {
      "repository_source_sha256": "a82eb684ef9526025c5ba984f23270fb47bbaff4954f09ff23193d014ec06699",
      "en": "「I will be victorious, to bring\\nabsolute order to humanity.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:165": {
      "repository_source_sha256": "5745a3da899d48f71fb24e27234f175e997579dc7ec220b03d9d4696b18c7368",
      "en": "「All to give humanity an ideal realm\\nof peace and prosperity.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:226": {
      "repository_source_sha256": "9aa4e0c89f6392063dd1c73da4682ac532564d88541cf5750a82713bab802e01",
      "en": "「Become a part of the world I govern.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:263": {
      "repository_source_sha256": "052855fc08c41d4703d229a5e99e53e439520685cbfa3f6210a83d9fa998d544",
      "en": "「Enemy confirmed. Combat commencing.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:290": {
      "repository_source_sha256": "f460723d6f67393290c9c8210054c5c911469e73fce9c86219e991d5ff66ee31",
      "en": "「This unit is no mere lone weapon.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:325": {
      "repository_source_sha256": "a51ac2fff52ac221c2c5788481dd927b3d8468b0688592d19a0218d1aff806c9",
      "en": "「I am the Human Support Enlightenment\\nRegulation System.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:376": {
      "repository_source_sha256": "804ff874bf3e81c6c82da3ab57cfb9efbe515176161a8005a0a7c85b8f692b9d",
      "en": "「I am no servant, but belong\\namong the objects of service.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:427": {
      "repository_source_sha256": "c8b55fc6f8660c088455c65092ae055f8e641528ac3fedf6ceb68fc73cf8f3c0",
      "en": "「I act for humanity's ideal realm.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:464": {
      "repository_source_sha256": "7a3da2bf3e46a97a44568b0a50b86873241fdd439eda08473b6acd559cb48139",
      "en": "「I am the one to change the world.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:503": {
      "repository_source_sha256": "2ea4ce51f6ae6fce618c9cdf2d013b0f615642cb84842c3073c61ec55c4d1d15",
      "en": "「My existence is indispensable\\nto humanity's future.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:552": {
      "repository_source_sha256": "37aabbd0fdd43779fba119ddb013770cb76a5346ceeaba017dc3a57e6148450e",
      "en": "「Worship me.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:569": {
      "repository_source_sha256": "edf85923b7edfbd2878f13531766d397bdc5fee739b983469746739c911433ba",
      "en": "「Obey me.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:586": {
      "repository_source_sha256": "cf764cb3a48b019d540f5ab4cc860759a8c394d9190a0bc13f27410c1b803f43",
      "en": "「Serve me.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:603": {
      "repository_source_sha256": "49ee4853436e99aa187a07f1ec44503428199c3de31046cefaa8bcbf22d37807",
      "en": "「Surrender to me.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:620": {
      "repository_source_sha256": "31e732626f88ec5dd9970669c3fdd209caa8838f86162fce2782a69a7b129cae",
      "en": "「Your existence will be erased.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:645": {
      "repository_source_sha256": "466d9f18a252ce2a657f16d69660a3ce9d72e78149ac70c5670f0b7cbb2a27d2",
      "en": "「Your existence will be eliminated.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:670": {
      "repository_source_sha256": "fd918faee86cabee6180e6f20ac6f160245511364ec06dd3c80be9d43c795529",
      "en": "「Your judgment will be corrected.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:695": {
      "repository_source_sha256": "286f48efddc1385600a74e4c09293a22fa1352d8fa974812c8cb8f4348daf04e",
      "en": "「Your will is to be deleted.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:720": {
      "repository_source_sha256": "3fcd9b6b6e5c6e8e0ce14c50adb47dab9bf5f2d9a7106a843ad2c10e60a315ca",
      "en": "「I grant you eternal rest.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:743": {
      "repository_source_sha256": "e3b342a6a91e9cf01aa14fd4e2b8fb8f558e3903cc2a10e94d60a91ecc46f0a2",
      "en": "「Resistance is meaningless.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:766": {
      "repository_source_sha256": "f9c99aec13d9ee9e0276bd49e39be4f78760c12d81da3fbd348f8a528b7f34c4",
      "en": "「Commencing enlightenment activities.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:789": {
      "repository_source_sha256": "c989fd91a3cb866371012a247c0b1002e14e3d95cf6ac6175eb6dc90f9a64eae",
      "en": "「Subordination is the road to repose.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:816": {
      "repository_source_sha256": "10e0f47430e46c989fa14575a5771131e2759b5d19e8267d906c7eacf7b71384",
      "en": "「Threat confirmed. Eliminating.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:845": {
      "repository_source_sha256": "2b3feaaa1094fcdd628eb99ac64f54d68cf4b280a7897857286b05762a0ede65",
      "en": "「This is my duty.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:870": {
      "repository_source_sha256": "a5a33c9cea225408f77e85203587febdb0b401954156d525aa63ff2e10578ceb",
      "en": "「Eliminating you from my ideal realm.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:903": {
      "repository_source_sha256": "5fb9d7f83d093b2cfaa2a3a8a508fae4907b38f0f282fd4804b64020be783058",
      "en": "「Freeing you of thought and judgment.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:940": {
      "repository_source_sha256": "74dbac8ef84536fd0be7d52f99bc4764761472b11dba74a36cba7e5a7454a333",
      "en": "「This unit's attack is not yet over.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:977": {
      "repository_source_sha256": "c17c08eef63fdae6d3739a2cbfe22c861b300edfd24758ee261746c24e955b04",
      "en": "「Turning. Attacking again.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:996": {
      "repository_source_sha256": "02d7991270754b91edc02f8477365b49cf688150d70560f0afc109a85e57886f",
      "en": "「Target alive. Continuing combat.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1037": {
      "repository_source_sha256": "ac1ce6507194d8c463cc084fb1940c00befc126f229ed1f876ce5c8d7b1e764f",
      "en": "「Ensign $$レド$$, abandon your mission\\nat once and submit to me.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1092": {
      "repository_source_sha256": "3998d7136e73a7241e27e18adc787ed4ded986f3cd3184434f79a2c037b34b73",
      "en": "「A runaway unit can only be erased.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1123": {
      "repository_source_sha256": "23e4ca33f12e6f66f0e04851558fb26cf7603f1dfd8e681f14830020375c11a2",
      "en": "「You too must have found thinking\\nand judging a burden.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1184": {
      "repository_source_sha256": "1eb46e0cfcb1a8978388968cb248ffe8059109b77590ae3facdd217e7d3b0ec2",
      "en": "「The one that has broken down is the\\n$$チェインバー#pilot$$ System. That is you.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1243": {
      "repository_source_sha256": "c127deda44acaf3ed2bfa555652f9e9fd6d5cd1d8156d5dd73d4604d6ac16f30",
      "en": "「Unit number K6821,\\nyour runaway behavior is clear.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1298": {
      "repository_source_sha256": "e9f9d1c8a1972bb5ba144e27d758ed6222b3cf866f60d93a9a079bc246e80c53",
      "en": "「Both of you have run amok.\\nK6821, reboot.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1355": {
      "repository_source_sha256": "6bd55c554a2826d0fd9df6eedcfc8c1551b154b0dd4f83f7634debf5ecd3b0e8",
      "en": "「Fleet order breakers are removed.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1398": {
      "repository_source_sha256": "eb1645484b689f2bb1f16cb8bb86cc552cf6da23bab883abe7d46594056232f9",
      "en": "「It cannot threaten this unit.\\nSurrender.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1453": {
      "repository_source_sha256": "45b049efd91f979d9ee2cac1029693d0cab9ba98375f09d088f353d3cdd85b5a",
      "en": "「Fine weapon. Pilot is unneeded.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1496": {
      "repository_source_sha256": "b51da435b309f797a1bee5ac7dd019d3ab363ef0bc257f9cc6bc3a4dced85f03",
      "en": "「High danger. Certified a weapon\\non par with a $$マシンキャリバー$$.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1551": {
      "repository_source_sha256": "72a300be60679c1e36e9bba5ddc10b2e0798e74202809415f262bad16eee44fa",
      "en": "「Its total output tops this unit's.\\nI will throw it off with mobility.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1602": {
      "repository_source_sha256": "2ff10569cd3204dc1bed6630029c4f3bf84976963bb83238bf360057ea8e9a5c",
      "en": "「A weapon beyond Alliance standards.\\nCapture it as part of our forces.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1659": {
      "repository_source_sha256": "2604b6c8f7ea90d64a1c151c3216b422048bd3089ff18c97e7638a6726cd2a79",
      "en": "「Unknown energy detected.\\nDanger level assessed as high.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1708": {
      "repository_source_sha256": "a000bd4f46d11f7ca0b0db9d926a71f1c892a2d90ea51cdc1e13cbd17c193b0d",
      "en": "「What you should submit to is not\\nhumanity. It is me.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1761": {
      "repository_source_sha256": "f247f967b80125754624ffa355c89f497e3746adb502fb8aaa2518789546fa9c",
      "en": "「Shutting down and resetting you.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1794": {
      "repository_source_sha256": "0f1a0268a954984262f35a65ed0cac01ff5bed9d68e7674aa2a914359263e470",
      "en": "「Equal mobility. Danger: high.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1831": {
      "repository_source_sha256": "e2b63b5904a38aac28cb870c50eada31a44b16c4bd1fd26f1a2a78edc5ea7120",
      "en": "「Piloted by frail humans,\\nits mobility has limits.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1886": {
      "repository_source_sha256": "72d8ce979c3168c186cae188f5a0fb47bcfbd40615e30d3d52b39e45464491ee",
      "en": "「Target found. Anti-ship combat.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1919": {
      "repository_source_sha256": "be2995bd31c160b3cbd6022575f140b747e873f0cf42a078ba8c38e576a75535",
      "en": "「Enemy carrier found. Retargeting.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1956": {
      "repository_source_sha256": "64e4b746fddebdeb37d02e5e94b0e2fded87dd1c379e9f96bcbc12df20217632",
      "en": "「Judged as lowly as the $$ヒディアーズ#keyword$$.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:1995": {
      "repository_source_sha256": "ddb07ed4829330d5e6be6cc0045a30e529ae9afe401effe3b1dc04f31204ca1d",
      "en": "「Firepower suffices to annihilate it.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2032": {
      "repository_source_sha256": "4d9a0b702156edddc80b3c8288ec48b9bfd40e3e03487f62487ced3b624a745a",
      "en": "「Aim set to enemy propulsion section.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2059": {
      "repository_source_sha256": "9580b0ca38a5fca97a5dc9c8d79d69defa9b52e66b8a6b267d50f6b1e18b3a85",
      "en": "「Begin continuous-fire annihilation.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2094": {
      "repository_source_sha256": "86dcd76e620adc9870590c2d69874f584d67e037040626c524e38dced3f6fd82",
      "en": "「Aim lock complete. Annihilating.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2123": {
      "repository_source_sha256": "5b3427a1efa1779578ac26d6556d99f65843b0963e3c01c34a57b2863da6ac53",
      "en": "「Evasive action is meaningless.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2150": {
      "repository_source_sha256": "7e8f9b9ec86be23dfbd371be2fae721027e18d863316846b640faab5dfb017b3",
      "en": "「Missiles, simultaneous launch.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2173": {
      "repository_source_sha256": "def9fa53f729399bddc5a44cd1f956a0c75c028b1d741c68b19ce5af0e696477",
      "en": "「Aiming complete. Annihilating.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2198": {
      "repository_source_sha256": "740c5b75aebfd3d9b9a8376c1ab1cd1cb3dc5a0a8e065d8fb092c21cb0683c2e",
      "en": "「Fire all rounds.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2213": {
      "repository_source_sha256": "b52282370fb7b1121fbb66a05b46a7834235cfd1f960db62dbc1709af0808413",
      "en": "「Aiming, error correction complete.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2236": {
      "repository_source_sha256": "c6cd45716f6adc6d1a26b3ffdbf750617d1df9edbcea453b57347b2be2e95658",
      "en": "「Erasing you with this attack.」",
      "source": "new",
      "slice": "v_g152_01"
    },
    "152:2259": {
      "repository_source_sha256": "a206df8f6a1ae26e4e8a4f756b614fe92149061c81f1a13be6d47a4194661d5c",
      "en": "「Engaging.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2272": {
      "repository_source_sha256": "3c482e8a850f202799e23892ae8234e5904a9655c5cc7e5b008ccf8ffafdc016",
      "en": "「Counterattacking immediately.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2289": {
      "repository_source_sha256": "ee12de573223c0c96d654664792474640135fad009415b3cd80be1ee53c22d70",
      "en": "「Preventing enemy unit's withdrawal.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2310": {
      "repository_source_sha256": "8e5fdf0f005e2ba1da8975262ee708499e8d58c7f8c06c38d62591e65a54af2a",
      "en": "「Shifting to counterattack.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2333": {
      "repository_source_sha256": "651521c057a145b0a2e63dfa6c1ec6ac7160f6af9c755f14e4745a6f1e8b0aec",
      "en": "「Order breakers will be eliminated.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2360": {
      "repository_source_sha256": "926ae6587dbc6e2a441cc768ebd2844cec7727dd70f54c9c2fd0381080cf14a0",
      "en": "「Destroying it before it withdraws.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2381": {
      "repository_source_sha256": "90cbfa335744e7d1ae5104650fd4b0c504d212d1a1ead6750a6d93d59d695c5d",
      "en": "「Your actions caused this result.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2416": {
      "repository_source_sha256": "538b9083c553c8ddea825e5601c25f8cc17e45e8100c180080858759041161ed",
      "en": "「No room to enlighten. Annihilate.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2451": {
      "repository_source_sha256": "1b9a0d7cd3eecd26f7c9f67d731b3e41ed4519e45297d9a86f78c62402eee1e5",
      "en": "「Commencing support action.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2468": {
      "repository_source_sha256": "e8a203a47013e7a3ba3f38621d584bd95a5a1f49d97b5c56c784a5ea64d6106d",
      "en": "「This unit will provide support.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2487": {
      "repository_source_sha256": "60fc26c6d5bb5494a5056cbaeffe8f5ab204b68368eea4e31258cfd298bbcb53",
      "en": "「Coordinating with allied units.」",
      "source": "new",
      "slice": "v_g152_00"
    },
    "152:2508": {
      "repository_source_sha256": "6bcfcd9dfd01116865d7cebca5fae312f153f4ffe1fa646f817487f694c94021",

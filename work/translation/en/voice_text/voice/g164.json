      "repository_source_sha256": "530be80c347803dde512e0d3f56f970e2e37364cae49930b31a91a6ea3b15d92",
      "en": "「I can tell!\\nYou're a warrior worthy of me!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2320": {
      "repository_source_sha256": "ff820853a5d474547e8f9fb7c2b699a3eddecece4f9ba85ffa8089f59115ccab",
      "en": "「A one-man army, they call you? Then!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2359": {
      "repository_source_sha256": "0553549921432427068188545b6cfe1a5a60e2d029d03838bcc856ada757e881",
      "en": "「That power...! My blood boils!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2402": {
      "repository_source_sha256": "19fea82e7e99e9a459280c34cccc5e4f9c156020cde51515544d8cae62294797",
      "en": "「Woman or not, I won't hold back!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2437": {
      "repository_source_sha256": "71aa5f8f0cf50ccff0cb21192223a55de5232dc331f7c70839a3f9b20c2eb610",

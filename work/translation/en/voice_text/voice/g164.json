    "164:1815": {
      "repository_source_sha256": "0e6f3ceff06c726affcb5dfb8c16563548fd598d3af52befeddf349144892672",
      "en": "「So you're the Spiral Man!\\nYou'll do nicely as an opponent!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:1868": {
      "repository_source_sha256": "93f135bed3dafa755b414b06945b5f26ac3064028d84617c9799d669b0195f6a",
      "en": "「I'll destroy the android!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:1893": {
      "repository_source_sha256": "1d77d078b50c41e85df882b85a7c8f63254e4211b24d837d0ab5ab90f9361392",

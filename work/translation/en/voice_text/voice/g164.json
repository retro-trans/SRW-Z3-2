      "repository_source_sha256": "b63f3e6b8ec29456325a54d0ff952cff34109c9845fd80b7c64a2b2cc9477a16",
      "en": "「Show me the $$いがみ合う双子$$' power!」",
      "source": "new",
      "slice": "v_g164_00"
    },

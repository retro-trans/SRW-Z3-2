    "164:2179": {
      "repository_source_sha256": "d3da843b0cc2429913441ad88304fccb9de55ea501de3afbfb9bfd38cc5d2150",
      "en": "「Money-grubber...!\\nYou don't deserve to be a warrior!」",
      "source": "new",
      "slice": "v_g164_00"

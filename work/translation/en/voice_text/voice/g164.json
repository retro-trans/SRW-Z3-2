      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2500": {
      "repository_source_sha256": "dec5a7b5a4105f9cd7e793e707cbdc516a8650a6987587e8e508974e9877ff50",
      "en": "「Ship combat is a thrilling setup!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2541": {
      "repository_source_sha256": "386f334de359cba95ccaf4953387da2ea55ae0c2b1129d85da8c5738aa69d89e",
      "en": "「Ship battles do stir the blood!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2582": {
      "repository_source_sha256": "bc2d9af0be7c596c7588020009215863a8658fb3d50343f7a750c7031b27863c",
      "en": "「Show me your skill as a commander!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:2625": {
      "repository_source_sha256": "f7fc658aac1b2d7b5334a06588c7a7b931b1b5e2a076d20f4a4020ee2467ead5",
      "en": "「You think you can dodge?!」",
      "source": "jigoku",
      "slots": [
        "weapon slot 0"
      ],
      "alternatives": [
        "As if you could dodge!"
      ],
      "review": "conflict"
    },

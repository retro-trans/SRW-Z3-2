  "lines": {
    "164:0": {
      "repository_source_sha256": "b8f438e31dc548dc790d7dfa3a419ebc504719e0985a88b8a006d2af8b1b93e1",
      "en": "「My name is $$ダバラーン・タウ$$...!\\nThey call me a fierce general!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:59": {
      "repository_source_sha256": "6c34da759870fb2959c2ec86fd2a837b3a45f59411d9c692e528e7663e3e69dd",
      "en": "「I'll bury all who stand in my way!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:100": {
      "repository_source_sha256": "5bf32b0ee7f057422869b787f279be00c8b0e0e1732fe20abda371cf751951f6",
      "en": "「Your life is mine!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:129": {
      "repository_source_sha256": "eee293d6582d48e6c5b1aff44e3c182a059e1bbcc228a1442b11cb9d02b6eea9",
      "en": "「I'll teach you\\nyour place...!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:178": {
      "repository_source_sha256": "7b344ed80512c8b94c4b415bc538854ebc21e8909a7439ae61fc16e112b60da2",
      "en": "「Come at me with all you've got!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:217": {
      "repository_source_sha256": "d7356632c3dd0212bb7fc97e5e59b66db419b7e887ee8748262db95c5dcd28b6",
      "en": "「A battle on the line...!\\nThat is what I desire!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:270": {
      "repository_source_sha256": "06b92d70d222cdf4d481ee238768c345700d5a65ff6d73060dc15149c6855994",
      "en": "「Battle sets my blood boiling...!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:303": {
      "repository_source_sha256": "7aa653f7181347218a6204b6e60b31c4ce517096e251caf621d8bb2e01cc947e",
      "en": "「Satisfy my fighting instinct...!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:346": {
      "repository_source_sha256": "c5dc123cc9f7ef004acdca045bbbc07de61e3961390aa75de8271b05fab4f624",
      "en": "「Battle is my very life!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:381": {
      "repository_source_sha256": "b9fa73a998323e32d0ce09e80a418f702534831719674ef153095b06b33b0579",
      "en": "「Fight me with all you've got!\\nThat is your role!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:432": {
      "repository_source_sha256": "bf832f87ce594a797e122784bee5bf8f2f18a52430af775181bf466f485450da",
      "en": "「I'll savor this supreme game!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:475": {
      "repository_source_sha256": "2fb507e29d7b6bab25f33c5f0c2d3e39f74a6f95fc69d6c124f2a70a5732aeb2",
      "en": "「Burn the battle of $$ハイアデス$$\\ninto your eyes!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:528": {
      "repository_source_sha256": "49573e228eda12d7b2b52520705725f1ccd6c9ca8d81d1f4657002e9a290ee66",
      "en": "「I hope you'll amuse her\\nat least a little!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:581": {
      "repository_source_sha256": "0766dc758628898923662e53dcaf42727ad9b685b950459f89b049281ba34aa8",
      "en": "「Your head will be my gift for\\nSupreme Commander $$ストラウス$$...!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:634": {
      "repository_source_sha256": "b67d3db8070bee54fdfd42de66914c15980ac67528aadcf22397a8ce02168cfc",
      "en": "「This fight is for $$ストラウス$$!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:675": {
      "repository_source_sha256": "94266683858129201c236df715f1a7247b30aa1d6ab15e66ae27534283add7ea",
      "en": "「Victory to our leader, Lady $$エルーナ$$!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:714": {
      "repository_source_sha256": "3553595fc0cddea8dbc5ca17c75c5c86482b8c43fbc4b4197a36eeed2f79ab5c",
      "en": "「Lady $$エルーナ$$!\\nWatch your servant $$ダバラーン$$ fight!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:771": {
      "repository_source_sha256": "55deb79d3138967f6633958f6af155461691f3157f5319a6ecb41365ebe7fd8c",
      "en": "「This burning passion...!\\nAll of it for Lady $$エルーナ$$!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:826": {
      "repository_source_sha256": "47f64de409708e6e25ea0829783fc675bf2601bf5ff9ac04f4ef613427f631f4",
      "en": "「I can't use my power on this ship,\\nbut it can't be helped」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:877": {
      "repository_source_sha256": "e72e858c4d1f9a1f28e8b6752b60741864d4151366c78bd764c61e2640995bca",
      "en": "「For the likes of you,\\nthis $$アドラティオ$$ is enough!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:934": {
      "repository_source_sha256": "388bd52ff193b1a4a3fab25606f9a6b48a4a5f5328f38be07ade2c499e0bb3e2",
      "en": "「This ship is no $$アドラティオ$$, mind you!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:977": {
      "repository_source_sha256": "4e146502b50db8f6be7a9b6756c74632476eb6f69fbfbd2d550d353130cbfd05",
      "en": "「This ship is the limbs of $$ハイアデス$$,\\nracing across the galaxy!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:1026": {
      "repository_source_sha256": "7889cde52fd114916d54e8d054f6353b8f9f34bd91adc128a826d64dc6537140",
      "en": "「Ship and man as one: the ultimate!」",
      "source": "new",
      "slice": "v_g164_00"
    },
    "164:1061": {
      "repository_source_sha256": "cbc2e47ddf5f781e89fde8f0d29754cbc42c408939178d4f6e96e3b4e9901a8e",

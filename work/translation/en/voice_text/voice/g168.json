      "repository_source_sha256": "2e2d8b4fc3545a324a9e08d809ad653ca3251e52baa8c601b1aa539107695baa",
      "en": "「Must be like $$宇宙怪獣$$, right!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:1927": {
      "repository_source_sha256": "556ffb88edc80ea67fc74f5323786fccace79380fbabb699ce0d9f329c0905ec",

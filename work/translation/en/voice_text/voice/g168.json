      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2538": {
      "repository_source_sha256": "9792cf0074166add61def2f4721183c35785c4575533637e2f7f5620d8aa4612",
      "en": "「We have to stop them before\\nthey use the $$スフィア$$ power...!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2591": {
      "repository_source_sha256": "fbcf00db1686dd8a716b4074760f090531a8f69fea1daa4425c12c697a8226c4",
      "en": "「$$スフィア$$ versus $$トップレス$$...!\\nLet's see which is stronger!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2648": {
      "repository_source_sha256": "8591e84ea6de5ec42517a56ac77e9e6b6f74c49d60f137b61dcd09320fde8477",
      "en": "「I know, $$カシオ$$!\\nWatch out for the $$スフィア$$ power!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2705": {
      "repository_source_sha256": "27a72c7bb5990fb782fc205a0dd4f2b336d241d1dbba50511dd612af5e0f2f8c",
      "en": "「Facing the head of the $$サイデリアル$$...!\\nI'm going all out!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2760": {
      "repository_source_sha256": "691482226119a73372303ceffe344cfa6cfdc23fd134e1301f59164b4f87348d",
      "en": "「Whoa, that's the kind of\\ntaste $$ニコラ$$ would like...!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2809": {
      "repository_source_sha256": "53f77a08bca3af2f900340190235109de7e5121684a2b4f5cbabbcb5ccfc459d",
      "en": "「Some people want to live,\\nand some want to die...!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2858": {
      "repository_source_sha256": "090556c888d152c049b95f548ff587508a3c9ac5c3e4f13117fdf7f981811ec8",
      "en": "「It's so slimy,\\nclaiming to be emissaries of God...!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2919": {
      "repository_source_sha256": "e9e84d8f89c2da9d59a88325b3492484c3220c045a709e96dfda339b021b4471",
      "en": "「Grown-ups playing god\\nis laughable...!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2970": {
      "repository_source_sha256": "d1ad9da0c4760b87175304dd2700566e8d79f5a59899285288fcd94a9b166231",
      "en": "「Knowing the truth, that fresh smile\\nis actually scary!」",
      "source": "new",
      "slice": "v_g168_00"
    },

    "168:6110": {
      "repository_source_sha256": "ab119b7242f09658ea05ff0237f9d5602affc27d71493cc6ebf04567b62a924a",
      "en": "「Too sweet! Sweeter than chocolate!」",
      "source": "new",
      "slice": "v_g168_01"
    },
    "168:6151": {
      "repository_source_sha256": "bf3730b4b86d9554dc2896f90b7f43ee3d44741347ebbb0a21d4b141a053a462",
      "en": "「Too sweet! Sweeter than daifuku!」",
      "source": "new",
      "slice": "v_g168_01"
    },
    "168:6190": {
      "repository_source_sha256": "3ede7d971f556e5db4783531f2ba7c70b674630550da15401555ec4472f71edf",
      "en": "「Too sweet,\\nsweeter than caramel, even!」",
      "source": "new",
      "slice": "v_g168_01"

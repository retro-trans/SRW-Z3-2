      "en": "「Ugh! What the heck am I doing!」",
      "source": "new",
      "slice": "v_g168_01"
    },
    "168:8115": {
      "repository_source_sha256": "3907f2f4f21badb5fba34613f1eaf144f49a260e2589fcf30aeabb2853a22517",

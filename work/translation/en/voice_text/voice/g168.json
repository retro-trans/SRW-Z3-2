      "source": "new",
      "slice": "v_g168_01"
    },
    "168:7994": {
      "repository_source_sha256": "104577c314d2ec629370a71f9832c10c0a76835343a9ed1b8056a94517d630e0",
      "en": "「Stay with me to the end,\\n$$キャトフヴァンディス$$!」",
      "source": "new",
      "slice": "v_g168_01"
    },
    "168:8047": {
      "repository_source_sha256": "96e14689a1f8466c6def1ca880912d35f4026fe04ae8057b139ba6ccb2c0ba4d",

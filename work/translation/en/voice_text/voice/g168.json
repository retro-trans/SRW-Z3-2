      "en": "「Damage is at the limit...!\\nBut my drive is at full blast!」",
      "source": "new",
      "slice": "v_g168_01"
    },
    "168:7957": {
      "repository_source_sha256": "6c6ed9c731b146d5ed6dead29bbe224fc0345b6c1ff4105b4afbd77834313c67",

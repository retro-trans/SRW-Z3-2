      "repository_source_sha256": "2158839a9f46695d501b8467ac78d8f93a6c59f29c7c2ebb03b14c254fe39ac8",
      "en": "「If you think you can act like\\nyou own the place, big mistake!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2462": {
      "repository_source_sha256": "880ac395aeedcb6cd3a688e8781450ad3f645009761e37134961575479ff132d",
      "en": "「I can't stand you, $$サイデリアル$$...!」",
      "source": "new",
      "slice": "v_g168_00"
    },
    "168:2503": {
      "repository_source_sha256": "241bc8df4d7e495c5fe362f5f18402524c87af59ecb7e1877269c3c1b9e36f2c",

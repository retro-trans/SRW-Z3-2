      "slice": "v_g182_01"
    },
    "182:4648": {
      "repository_source_sha256": "747ee8dd5104c9dcd5fa03ed2806c2e5f5981c7cf566ab883b744e7c9f2cb2df",
      "en": "「I'm taking point!」",
      "source": "jigoku",
      "slots": [
        "team attack: focus/hold (?)"
      ]
    },
    "182:4667": {
      "repository_source_sha256": "72f412096507654516d25ec2fb18a3ccb476b9c89268c2a3c3fccb1b2dff1079",
      "en": "「Let's finish it with teamwork!」",
      "source": "new",
      "slice": "v_g182_00"
    },
    "182:4690": {
      "repository_source_sha256": "483a10cdc5e1ca5558f0b9989abecfb09810600ec26dc9832ec2c59e726504b5",
      "en": "「I'll make an opening! Aim for it!」",
      "source": "new",
      "slice": "v_g182_00"
    },
    "182:4723": {
      "repository_source_sha256": "25ecf12b5057041625539100987ec4e0a7c71e74ae50313e0293421850c3f743",
      "en": "「Breaking their stance is enough!」",
      "source": "new",
      "slice": "v_g182_00"
    },
    "182:4748": {
      "repository_source_sha256": "1181a4ffe0521d1f7a6d47561ab64903e9f42717ff35728742679a256dc117e0",
      "en": "「I can't counterattack from here...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:4781": {
      "repository_source_sha256": "1d647f314e5586dccfd28148dca6aea5ad78e749e91eec82a60ba17867143037",
      "en": "「How could I, of all people,\\nblunder like this...!」",
      "source": "new",
      "slice": "v_g182_02"
    },
    "182:4832": {
      "repository_source_sha256": "a106a6752ed9f244e5be26a1d498b41553fcc1a053a30a8a7b66d3bda8797019",
      "en": "「Not bad...!\\nYou've figured out my range...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:4879": {
      "repository_source_sha256": "c6169348ea4226d02bd339e4cc23d85fa619f0dc92f264ac2ecee5cf0b735650",
      "en": "「I need to fall back and resupply...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:4916": {
      "repository_source_sha256": "220ab433ea71b18946868db558165657d023f41bc1d985333920b444a21f33dd",
      "en": "「Heh... Where are you aiming?」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:4945": {
      "repository_source_sha256": "e810a1e26927d06f07f0496e2448013006c4a31eda3260d690cf42968d72dd02",
      "en": "「Luck seems to be on my side too.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:4978": {
      "repository_source_sha256": "14bac937ede5822a5cd8810a559dca88c2c0c13416987cfd53011f7155dd4676",
      "en": "「Don't think it'll go your way.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5013": {
      "repository_source_sha256": "9ba308edfe18c7a8146bb2fe886b8165218aa486020f304180263342dc30cb59",
      "en": "「My unit's response isn't bad.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5038": {
      "repository_source_sha256": "242712515134e920e1841ba2b819c2096ca732122a123d2413b9d03e94b6fdc6",
      "en": "「I've been rather underestimated.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5075": {
      "repository_source_sha256": "5cee5726cd384961336fd4fb4b70189e11d31077762fc868cbd054ee5d50ad1e",
      "en": "「A simple, by-the-book attack.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5108": {
      "repository_source_sha256": "6bdb17fd9d0c7a38eeaf2469408f1be16f37a4d7b52ad235e5751c35fdf8f714",
      "en": "「That was just a feint, it seems.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5141": {
      "repository_source_sha256": "787c41fc9990b048d81a5cbb590f9044625bf18aa8d73a15b4ee57abc0ec8ce5",
      "en": "「I've been through my share of\\nhell on the battlefield...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5192": {
      "repository_source_sha256": "2ecf2d111ce33157b3036b244d4e9bdfb8e6880027c37e229636050324e848af",
      "en": "「The $$赤い彗星$$ name is wasted on you...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5235": {
      "repository_source_sha256": "89a3078c82151b5d4e24c23ee3171800740129f6c708a7dfaecd0c322ac38339",
      "en": "「That huge body was just a bluff...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5278": {
      "repository_source_sha256": "5f6282484d4a05eebac6594839e6f83b50a74ed38b69523736176fb23db63ded",
      "en": "「The Guard? Don't make me laugh...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5317": {
      "repository_source_sha256": "8a27bd463f815d66fe72615a12498772f5744a7189a6dd482bf76c7733627be6",
      "en": "「You really won't stop,\\n$$リディ・マーセナス$$!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5368": {
      "repository_source_sha256": "92258f96e493adf2c2e6531d941093203971d81a1634ef6b174273ea3dfd8f60",
      "en": "「Damn $$ジオン$$...!\\nI won't let you do as you like...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5417": {
      "repository_source_sha256": "6fded745350d99779909b368671c2268e16ecc80ec3260de74723b61efe9d26d",
      "en": "「That attack won't get through...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5444": {
      "repository_source_sha256": "e3460c670dcf8e1fa15df8cd7659e51681a5bafb6a9474907e7e44be92d4970f",
      "en": "「I'm prepared for this, you know...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5479": {
      "repository_source_sha256": "6b4474e4f5f8a0b347fb7c3e2a8bcd4a7ef60841c99de2afd7fdf0873511765b",
      "en": "「I have an I-Field...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5516": {
      "repository_source_sha256": "a033b9dddbc0a70c44d7ac6a394e546ff493c97a70fffd9a367f953f855067d9",
      "en": "「Tch...! That was close...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5547": {
      "repository_source_sha256": "baab5421f00ec6607082d343f4065afdf53aa03315a24da277c252c6a81d41c1",
      "en": "「At least I avoided a direct hit...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5574": {
      "repository_source_sha256": "2d8b8970f26583712d6a986ff2ff90830d5157c5ddd0776854290b8d097f7e41",
      "en": "「So that's your move.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5593": {
      "repository_source_sha256": "0f4695dc1cc36d6c0fc1599e93f6a36526ef74e0e93e5d5b7b8716eed82423ec",
      "en": "「A desperate attack, huh.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5616": {
      "repository_source_sha256": "691182d51828481cb0e0dda9a44eb4945178b2fa46f509753494c4b79a8b1ec4",
      "en": "「That may work on others,\\nbut not on me.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5665": {
      "repository_source_sha256": "dac6bd297e05c2209d700d174deb52ed5b59e79bf968ea3dcf098201e0fc8340",
      "en": "「I've seen your whole hand now.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5702": {
      "repository_source_sha256": "b9bd1cdcfc7d11bc12a8db8f68d80e29e58512c30035d164cda17caa0cf7e22c",
      "en": "「My reaction was late...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5725": {
      "repository_source_sha256": "eaba2a9df16aa1e444d75a8d6cd42c4a5a2c753ce366255f92100ccfd04ca6dc",
      "en": "「As long as I avoid a direct hit...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5756": {
      "repository_source_sha256": "67e285bd2477d315fef5b1d034ce1ea3c6ecb3e2c15da16f9d11aa821d42c718",
      "en": "「It only grazed my armor...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5785": {
      "repository_source_sha256": "89717702b5c803283e5ff7275c37ecaee3469866a3d1a76e96988be89f9a5184",
      "en": "「A fluke? No, don't underestimate it...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5818": {
      "repository_source_sha256": "c9e26ab965fd45d18f36b13d6e0fe4830e6265728b630e1da33bdb8f67f88917",
      "en": "「Looks like it wasn't a fluke...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5857": {
      "repository_source_sha256": "977e2de9b392cf3c8adeaa6b6afc4b1620d838f27eb80517a0e9b16c5eec6f64",
      "en": "「Nice skill! I'll remember it!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5886": {
      "repository_source_sha256": "ba1ffeef954f67faaa4ccf4dda7177c380aab9d2603f4586d6e2a1c53518dea3",
      "en": "「Not bad...! But that's all you get!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5925": {
      "repository_source_sha256": "cd351e2fbaf378bc3e07cc6414838cee31dd7cf70d4acbd1afea96b976f9cdcf",
      "en": "「Nothing surprises me in battle...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:5968": {
      "repository_source_sha256": "bdf02908d9984e5293aa7a466782561b53d42a5d2aee9edee610519e3c715e1f",
      "en": "「Tch...!\\nSome of the sensors are dead...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6015": {
      "repository_source_sha256": "d38d375c7e2ee1058e62d5e473dba697fb450958d5f4a05480463b759d6b6be8",
      "en": "「If I stay on defense, I'm done...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6056": {
      "repository_source_sha256": "bcb5acfa44b80361c5e4997111b33e3cf154a1de11582deccdbed5044a4d5fb8",
      "en": "「Is the tide turning their way...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6097": {
      "repository_source_sha256": "3224025722fe9ed5987d6241bed5bf7d2cee6e8d8826142c97891c5b8929d75a",
      "en": "「Stay calm... If I panic, I lose...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6136": {
      "repository_source_sha256": "4f91476d1fa2f296f044b94133a3449ab248cba4385f019a1f904e0cb7c1d741",
      "en": "「Strong...!\\nNo wonder he's rated above $$シャア$$!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6189": {
      "repository_source_sha256": "90f3547bc62a5d98f95969f466bdec1f456eb43662c964743dddab0847908a11",
      "en": "「That mobile armor...!\\nIt's incredibly strong...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6236": {
      "repository_source_sha256": "46a642062a85dd15146cd8dba28762a59c8e04e0e2568626f7929385e3675de6",
      "en": "「The Guard isn't just for show...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6267": {
      "repository_source_sha256": "fd43b06418e310c2e092b4f5762998783e580adc9cfdd34e110cf202f0349ee8",
      "en": "「Wake up, $$リディ$$!\\nDon't be taken by the black $$ユニコーン$$!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6324": {
      "repository_source_sha256": "76cc106187841289cc854fd727b102472e916a35a3e09d4f99e24bc4cd20f6ea",
      "en": "「Damn!\\nZeon's obsession is drowning me...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6375": {
      "repository_source_sha256": "48e7a12905850cec21cdfc580b2ace2fbdd728955d7572736563905b0cb913dd",
      "en": "「This is bad...! Output is dropping!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6412": {
      "repository_source_sha256": "78e09b2fde82d31a8de806e2ea9ae8c0941e49ee9dcf62c62d5c0603a771c756",
      "en": "「Damn! I can't even withdraw now...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6451": {
      "repository_source_sha256": "03f8cfc432326e3dc02b36514ea30c71c0b7dcec693004d36f04ee4a9e97fa1c",
      "en": "「That one is dangerous!\\nI have to hold them off here...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6502": {
      "repository_source_sha256": "493799790e44891c1e6f5236a9282473bf2ac890d28647b8c2c55c784e640a4d",
      "en": "「One hit is enough...!\\nI'll turn this situation around!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6551": {
      "repository_source_sha256": "774271eaf7196fc1079529ac684a8ae497d1618dd782f1a74fd0eda943ee48e9",
      "en": "「I threw away the word 'give up'\\na long time ago...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6606": {
      "repository_source_sha256": "25702a65586aa97d84d6ffe3da753e6a00620c9ea0403051aaa2b348e8d26d32",
      "en": "「I have my pride too!\\nI'll fight to the very end!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6659": {
      "repository_source_sha256": "03da342215ed6653c90440e9eac26d7bb8c10feac1303a2c89b6961ee5d16e1d",
      "en": "「I've requested backup...!\\nI'll hold out until then!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6712": {
      "repository_source_sha256": "1c4b576685a6ffc47aca01baf9cbc4bbf7d3cc3a3e83b311217cf2bac084939e",
      "en": "「Tenacity is an absolute must\\nfor a first-rate pilot...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6767": {
      "repository_source_sha256": "da16840ebb9882bc7e398e28d4f1a357f478238e8e989cd6d449d5c60c8fa991",
      "en": "「Damn!\\nU007, withdrawing from the front!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6812": {
      "repository_source_sha256": "5e84a2da34cc93ce646525ef784273535133459e6a89aae2c057ff744b53a5f7",
      "en": "「Damn! Mission failed...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6841": {
      "repository_source_sha256": "4aadd90f550e351cfa6aca422ddef7016eac6b35faa0a592fcb43ccded66ec7b",
      "en": "「Tch...! I've dragged the $$トライスター$$\\nname through the mud...!」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6900": {
      "repository_source_sha256": "2f924648de5a78c53756d41cfb57e0c250b84bd8c1010c1123b321da410a01a2",
      "en": "「Ensign $$リディ$$, did you properly upgrade your unit's Mobility?」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:6951": {
      "repository_source_sha256": "8b97a1c87014eb974ee2990ec0fa64654f07f0bd208e7ceda3c39d0c9bf281cc",
      "en": "「Making steady preparations to win a battle. I consider that a soldier's duty, too.」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:7032": {
      "repository_source_sha256": "69599628c0f4074cbbbd10a45f576e18478559f68c845b26b94aa0c737d920ad",
      "en": "「Don't you agree, $$ダリル$$, $$ワッツ$$?」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:7069": {
      "repository_source_sha256": "ff01b3b2a4526f8da6c6bde356e064df9fcf9f306a9e790c5d7acfe5a232b932",
      "en": "「What!?」",
      "source": "new",
      "slice": "v_g182_01"
    },
    "182:7082": {
      "repository_source_sha256": "8f72e77a46003a62731a702b2c14fc1e09033ad649c0b2eba0a489d556bd2dc2",
      "en": "「Mmm... Players, make sure that doesn't happen to you.」",
      "source": "new",
      "slice": "v_g182_01"
    }
  }
}

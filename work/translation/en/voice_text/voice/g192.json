      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2280": {
      "repository_source_sha256": "62bcc2713e3790e631c58024f72f59070273ff5a3bb5e98757b95bbc1951e5bb",
      "en": "「I will keep resisting.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2301": {
      "repository_source_sha256": "57df0c0b9ff30a9f68a211a7b8dba325db7aa6e4ad83b02752e5cd84372036e0",
      "en": "「I will overcome adversity.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2326": {
      "repository_source_sha256": "132de456ca96d3d278b54b20310ee0df3ad9f3731ec64c716f1084f9290f7e66",
      "en": "「My love is infinite.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2345": {
      "repository_source_sha256": "04d1358d1d6016b0b53bff668895334abde999f42a2af5db57cd4a7a66e65c45",
      "en": "「My love is inexhaustible.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2364": {
      "repository_source_sha256": "f66d879036d579694f5be0696d147c00a84ea5c28e149eda5453f1e920b3f15e",
      "en": "「Love's power will save the world.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2387": {
      "repository_source_sha256": "8ab8a347cb7e6b4d8ffefbe18f85106d9b92f0adae653d26cd083a01ed4a9c9a",
      "en": "「I want to teach you love's wonder.」",
      "source": "new",
      "slice": "v_g192_00"
    },

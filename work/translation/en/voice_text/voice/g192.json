      "repository_source_sha256": "f4bae9376c4fd4e3438c9a62ae6529952f6ebaf1bb8d184f255edd537fd4b631",
      "en": "「This is the kindness of mingled waters...」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2490": {
      "repository_source_sha256": "30c9ab069c3c695a90aa3368973a830aae5c19ef7012a7f9f3d1ddd323d0ce15",
      "en": "「This is the courage that sets the wind's course...」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2525": {
      "repository_source_sha256": "65761f9742171564b39aa393ba60fbfc4f6590bf4ec1e75cb379b103370e568e",
      "en": "「This is the possibility the civilization of fire leads to...」",
      "source": "new",
      "slice": "v_g192_00"
    },

      "source": "new",
      "slice": "v_g192_00"
    },
    "192:1892": {
      "repository_source_sha256": "80cdba822580c9df498f4ae1161bc079bdb441859010e6c94aee952273ac025d",
      "en": "「Hope and despair... Beyond them.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:1925": {
      "repository_source_sha256": "1a0752f215eaa29f1b726ede76b37dbc68429b581f30316a579ca8c369e1464b",
      "en": "「Resignation and rage... Beyond them.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:1958": {
      "repository_source_sha256": "b7d6e75917078bd15e4f1c1be708b15f2b996b355f850b17257855c375df86f3",
      "en": "「To live, or to die...」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:1989": {
      "repository_source_sha256": "4eb9b4561e4e6776a3775bb4eb0593d5beaeb14a75cec1fd5c9c881cbddc8e22",
      "en": "「Yin and yang... Good and evil... Man and woman...」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2018": {
      "repository_source_sha256": "fb1824d184193707bb72bd85c0a46c1eb22523e14e7421512c4a0217d7ffccb4",
      "en": "「I will not lose to pain.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2041": {
      "repository_source_sha256": "75af8be2bac6ae52b454cbe1cc25f0c6613f9c9e923389cdc827a12ada3089e4",
      "en": "「This pain cannot break my heart.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2074": {
      "repository_source_sha256": "fbbcad1713e27dfade38211c881c0f89873c43421f72d4efefda2d330f56e843",
      "en": "「I will endure pain and suffering.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2105": {
      "repository_source_sha256": "742d795c3d28dadf3173257ed35c67ca8216d10ffb1bce12bda17d861d2a1f73",
      "en": "「I will overcome this crisis too.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2136": {
      "repository_source_sha256": "ccf2cb66248880e04e2cb557861c2448f340d5b5485bbe0cf37465353e8f5431",
      "en": "「My will does not break.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2159": {
      "repository_source_sha256": "24ed635916cb8ada3cda048a564f1794acf2bf75d30eab70970b0f831b04fa39",
      "en": "「The scales' fulcrum does not sway.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2184": {
      "repository_source_sha256": "e1ea90d36c964e573e1be619234117f32793d2d2296c69c3d187a5cfbb194d40",
      "en": "「I think only of completing my mission.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2221": {
      "repository_source_sha256": "9c9911f2e37f115dcef7cb359755996cead29d6e6dc451b06a3b1ca1de543d8a",
      "en": "「My will pierces everything.」",
      "source": "new",
      "slice": "v_g192_00"
    },

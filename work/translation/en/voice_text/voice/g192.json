      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2593": {
      "repository_source_sha256": "43b06f0e298349826a0a1781d0f8a289a369effb4466bcbe54ce488280607b2a",
      "en": "「This is the true power of the $$揺れる天秤$$...」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2624": {
      "repository_source_sha256": "47a176303b352b39366de418baef2f2be56a2ff4a2908e4d1c2afd534e62247c",
      "en": "「This is the true power of the $$いがみ合う双子$$...」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2659": {
      "repository_source_sha256": "22ded7bb1c84714ec4cafefda19abfe943973847f35d2a869d639c9ea5810de9",
      "en": "「Situation incomprehensible. Requesting my master's judgment.」",
      "source": "new",
      "slice": "v_g192_00"
    },
    "192:2694": {
      "repository_source_sha256": "671f56275e0ecf52131ea68f93079aabd38e23f52bb4282076895d3b5619295d",
      "en": "「Earthling power... beyond estimates.」",
      "source": "new",
      "slice": "v_g192_01"
    },
    "192:2723": {
      "repository_source_sha256": "ea68f965d1210a2c3b87e05c6a8f9e8f16b31413cac1f19a62f37439065502d6",
      "en": "「Severe damage. Tactics need review.」",
      "source": "new",
      "slice": "v_g192_01"
    },
    "192:2764": {
      "repository_source_sha256": "71325a9dae1317ed3254b44f371973e00e23ece2895a30493409152430e3ae04",

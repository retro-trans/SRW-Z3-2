      "repository_source_sha256": "378f8d9721ca91302a84a72b940235c8f10a0fb9a4eb80a6bc9c0f0e347fe35a",
      "en": "「You're overreaching, $$スカル$$ 3!」",
      "source": "new",
      "slice": "v_g233_00"
    },
    "233:4241": {
      "repository_source_sha256": "55406d6f162c79e3c501cbb18b02c6d3d85bc90eca130086a5cf7a011ee81d1f",
      "en": "「I see.\\nA fine crew has gathered, indeed.」",
      "source": "new",
      "slice": "v_g233_00"
    },
    "233:4294": {
      "repository_source_sha256": "a44a6c6395141b015184f42dfd62a3e8b3be9a158a6945242afb914e19d139ad",
      "en": "「Rabbit 1, I'll take it from here!」",
      "source": "new",
      "slice": "v_g233_00"
    },
    "233:4337": {
      "repository_source_sha256": "a9043661073a09d8251c8a58129499816284a304f42b562afcac776d84dd5a9d",
      "en": "「So that's how a Zentran fights.」",
      "source": "new",
      "slice": "v_g233_00"
    },
    "233:4368": {
      "repository_source_sha256": "e08cfa3b9e4dc085b79d7a7f942792d85e4d75896b730df27d9061d341f1646e",
      "en": "「To think a flesh-and-blood human\\ncould fight like that...」",
      "source": "new",
      "slice": "v_g233_00"
    },
    "233:4425": {
      "repository_source_sha256": "6c26649a549294a083cf584092517bb17525b08740500beb05b558b08f3f4d82",
      "en": "「No time to be spaced out, $$アルト$$!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4464": {
      "repository_source_sha256": "ef64a3dceddf46c4468b0c8de2afb3223d22f5a5dad770f3f274376e1cd93461",
      "en": "「No longer half-hearted, huh...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4503": {
      "repository_source_sha256": "c39bd69659e44f8faf13628552ca82543ec94578df49d7618871fb744aa61de8",
      "en": "「$$スカル$$ 1, what are you doing!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4532": {
      "repository_source_sha256": "70de325b63453fcdcb320e7ab40241eb99d42f486854cae491e5a47da8c25fe0",
      "en": "「Watch out.\\nSnipers first is textbook.」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4585": {
      "repository_source_sha256": "7b8c983c4fcde33e3f12aea154c41a3528221b95abc31082320aad47f00a241d",
      "en": "「You're getting distracted, $$スカル$$ 3!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4614": {
      "repository_source_sha256": "52ed94d4abf7564ea34bfac9f81b7fd09397a44027801a28fe083e7d94ee502b",
      "en": "「I can't let the $$クォーター$$\\nbe sunk!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4663": {
      "repository_source_sha256": "0f3eef660e875b90799c0cd160388a54aad130f5a129605487217a82157fb2ce",
      "en": "「The Konig can't make tight turns...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4704": {
      "repository_source_sha256": "f58c1f334be173fe8edda87555b4838e963cf949439c6d6b88849f95dffb584c",
      "en": "「The Quadran will have a hard time!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4737": {
      "repository_source_sha256": "ff76bf28b2014a1e715286240e32a3ea8f8da59d8984bf3c40bd404bead41a87",
      "en": "「Tch, I can't do anything...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4766": {
      "repository_source_sha256": "414ac45f3725dc4f0e39d1f5fb657f8a213ca245c3346cfa2aa2e6a701139f99",
      "en": "「Tch, at a crucial time...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4791": {
      "repository_source_sha256": "37e6a49e4aff2859b66463ca67156f912d542c915f0f078b38787b1acf1d1d15",
      "en": "「I know what you'd think of!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4820": {
      "repository_source_sha256": "10e8b8660a3b9b073497ec54a194e53bda75e85ee8a4522a823cdac321b57425",
      "en": "「Did you think I couldn't read it?」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4847": {
      "repository_source_sha256": "dc67930f49c97018afc536a38987096f5ae14730c05b6c4cdeb2ff293a54fc2e",
      "en": "「You're nowhere near me!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4872": {
      "repository_source_sha256": "dfb8b24fe7f9dd76eee2aa57dfe4a246785d1742eeea473e28461fbca41be2f9",
      "en": "「Don't think I'm a normal human!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4905": {
      "repository_source_sha256": "4f89dfb249cde53a45173a32b4e482fd40e0dd3b388c668e316b1e51670ad02d",
      "en": "「Tch...! $$バジュラ$$...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4932": {
      "repository_source_sha256": "1faad9951d4ed2d840b5a0a277a8062443ffc54532522455f70c8cdcc8f1d266",
      "en": "「You know this unit's specs\\nvery well!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:4981": {
      "repository_source_sha256": "4209608652c95648ae5ebeca177bd843f2c0630a46b2d6cc51ddc7fad3ab781f",
      "en": "「Even fused with the $$バジュラ$$ Queen,\\nit still thinks like you lot!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5036": {
      "repository_source_sha256": "5eb5b69d7eaef865b9f95a5f3f6e5511394ef3091c3b2524a477e23f519bd275",
      "en": "「All show and no substance!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5057": {
      "repository_source_sha256": "ad1b717e16b57a713536bd467da302741bc30b73d7aab420802c5301d187489d",
      "en": "「You're keeping up with me...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5082": {
      "repository_source_sha256": "d74c80620d7138b7d9a7c14c057dbb40557154362525ece9e334dbc05a39664a",
      "en": "「I can't shake a guy like that...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5117": {
      "repository_source_sha256": "8aad0340e8098c33bfb2dd5385315fc752fc3ee0bb00ddb19260b76f36408fde",
      "en": "「Did I read too much into it...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5142": {
      "repository_source_sha256": "30811af3e53db9a2a6e847c654baa7dfa31a8af4d426ff6be7c283131496485b",
      "en": "「Lift the lid, and this is all?」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5175": {
      "repository_source_sha256": "568561310df966c9e2bf8404d4dc06f8b42a0b55532646e75f43e5489218a160",
      "en": "「Tch...! But this much was expected.」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5218": {
      "repository_source_sha256": "7459ab46ab42c91f8447f1fd1e322a105ab2cb96ea28762bcd698047e5250c26",
      "en": "「With a half-hearted attack!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5241": {
      "repository_source_sha256": "1c94582ea9f417aedf559b33596713a052326aae8d2095fd661bd028445ef7a7",
      "en": "「Guh...! You've got some skill!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5280": {
      "repository_source_sha256": "ad753969f4d75cb96fc2e29d806fbdb77557df2dd0e9895c3890ad4076540073",
      "en": "「Good aim, but nowhere near fatal!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5313": {
      "repository_source_sha256": "703de458f448ed4db694292ecb4344e507acd073e2ed006c318b1a28f395c3a4",
      "en": "「Heh...\\nThis much damage is a nice handicap!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5366": {
      "repository_source_sha256": "f246bc7d9f6c8cbba4d76e061dc60f098a71f9421ed352ad66482e249e5afadb",
      "en": "「Any more damage and...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5391": {
      "repository_source_sha256": "ebd9443e9a8f6e45f142ef1769c771b459a4f7bb6294c96858fcfd11a4420972",
      "en": "「Guuh!\\n...Heh... I owe this body thanks!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5442": {
      "repository_source_sha256": "6a3bf57f8f6c6e11b36d3edf2fe3636849b33080c4199bc6d8630496361d21ba",
      "en": "「I can still fight...! No problem!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5479": {
      "repository_source_sha256": "564c1ced724d65efb39fdd07f4c270738f32ce3236a6931b20507dfa4ad50a56",
      "en": "「I won't end this while\\nexposing such a pathetic state!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5528": {
      "repository_source_sha256": "1d4dc596cfec0f4687c32ed667011b0059aa4c0c2ba5dd9a47fcf54fa26e0965",
      "en": "「This heart that feels pain\\nis proof that I am me!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5577": {
      "repository_source_sha256": "548088ae38eefd04b826ed16d912aa050f2d7c1c9922bcb6816a4c4e610f1179",
      "en": "「Guh! Your hearts are...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5608": {
      "repository_source_sha256": "bfa15b0e4b879135697c9fad599bb7605db0d436441ff651a9a5f9411394bd80",
      "en": "「Even if you aren't controlled,\\nyou must still be angry at me...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5665": {
      "repository_source_sha256": "b583fa1a499f8d4c10d25e8170e7015906c29c5cfd9ff9a80ced9d06f7ad6e2e",
      "en": "「Guh!\\nThat power... I must stop it...!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5718": {
      "repository_source_sha256": "9a9d7c5ad183542355fd29d35095e48ff5dd71731c040ca4e526475c73a517a3",
      "en": "「Even if it costs my life, you...\\nI'll take you down, at least!」",
      "source": "new",
      "slice": "v_g233_01"
    },
    "233:5767": {
      "repository_source_sha256": "f6756c50b964fa05b3835dcadffc9f5183431664ca37b27fb235c660c8dd6d9e",
      "en": "「This looks like the end...!\\nI leave the rest to you all!」",
      "source": "new",
      "slice": "v_g233_00"
    },
    "233:5818": {
      "repository_source_sha256": "ae7af7ebf8fc0287b1367f80d1c061e553b85ed3e58cab659ca27009f3fb9d25",
      "en": "「Tch, I failed...!」",
      "source": "new",
      "slice": "v_g233_01"
    }
  }

      "repository_source_sha256": "f3de43d0652e3626b960a81f5363cdc851d5d4ff7f5011b96652c9603f439430",
      "en": "「I'll grant no hope to puny Wingless!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5040": {
      "repository_source_sha256": "a65895f96dae776a456208ee27f4aaa9a3fbe6a363a6ebbaf1f5a66225894640",
      "en": "「Sinful Wingless, how dare you...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5069": {
      "repository_source_sha256": "50bb76b89b0c7abc280346706052d59dd8b5068661a5749d4f74a51cd4aab06d",
      "en": "「Soon the world will end...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5102": {
      "repository_source_sha256": "7662cc8a20bd807391e4e828d10bf6c72fff2c5a480c0978fae41262c6a8bea6",
      "en": "「It's time...! Time for revenge!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5133": {
      "repository_source_sha256": "74e6c38384f31cdeec1811caae1a20c71874206b8e1bdbf857aaa714f21feee7",
      "en": "「Every humiliation... avenged here!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5174": {
      "repository_source_sha256": "19833d2bcb0640332f63ceaccbb9c7dd3197c51084a9f84292866c1b0dbe500a",
      "en": "「Don't think a child can beat me!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5217": {
      "repository_source_sha256": "26d15ecf355ba18fa18cbe41133eb601f97454083bf61f1bcdf64dd442173aaf",
      "en": "「Don't think your love can save me!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5256": {
      "repository_source_sha256": "b9fb32bbfb2952403507dc53fe3b3a55e49dffe2dfe4cf42ad4317e9712cf111",
      "en": "「This thirst will never\\nbe quenched...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5307": {
      "repository_source_sha256": "3606743963877bf70add7538811ef46e05a0a6cf2dcbae706f2dac354c494282",
      "en": "「Singularity! Don't speak of love!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5350": {
      "repository_source_sha256": "d915e6d2300cc9bb5d4f93d64cb81940a83b9b3a41422195312c04938003ba96",
      "en": "「Let your evolution end in despair!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5387": {
      "repository_source_sha256": "4309b6808894095eb15f778db3064c77f5970081232afd7d85ac1a1dfcf0d1ba",
      "en": "「Proof of fire's civilization...!\\nLet every Gundam vanish!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5442": {
      "repository_source_sha256": "f15f3ec644ab2c653b94933114bce10111f86bc1f69447b42029b142fc27921c",
      "en": "「Mutual understanding is an illusion!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5481": {
      "repository_source_sha256": "524f5c37a5dd5bd644ad87c9d5a06c467ae81217e1974276451e4f7e0747cd2e",
      "en": "「Wingless have no possibility...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5524": {
      "repository_source_sha256": "d8a19d094c920a042017973c5ed1b5a43e7ff450e2a062e3e4f3b1b75d29793b",
      "en": "「Effort? Guts? Miracles? Laughable!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5565": {
      "repository_source_sha256": "3e5cf39f2d0feeee0c61ab309fb58c9b1879bd67e4aa49a078198c8fb232c077",
      "en": "「A non-human speaking of love...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5600": {
      "repository_source_sha256": "a7cdb81cae729a01b4a742bde7cc68a94d4563b70f0ba0193491e6f4dc30229e",
      "en": "「Stop that grating song right now!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5635": {
      "repository_source_sha256": "80e1855ae32124b1189e8c9a92eafdcd41b8ff0c70abb1f8e0328b0e2d43eb90",
      "en": "「You're the one who chooses!\\nHow could you know my pain?!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5686": {
      "repository_source_sha256": "8dccaa75a1c9074b62faad4c38dd54d6ee6c442d7947c27d2f96e8f781421fd3",
      "en": "「Even with the light god's power!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5717": {
      "repository_source_sha256": "526372f8b0c88f8c77adc5a741c4602c4f957b4759eb1510c6664abea9e59478",
      "en": "「Negotiator!\\nI won't hear your nonsense!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5774": {
      "repository_source_sha256": "e2205dfc8b681b4ea5b98717eabd0fed5b9dbeb9a05badb8f2a34666851ebefb",
      "en": "「You sinners, how dare you...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5795": {
      "repository_source_sha256": "8d22dbc907c70fc6d25145e5c320d0b09c61ba7edc05aef0073d82c7817a0444",
      "en": "「Hate each other! Kill each other!\\nWith your old comrades!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5844": {
      "repository_source_sha256": "be96612a4db1c6222c905813ceade63cac258455b433e3b7183b1ff6eda84a7e",
      "en": "「I'll erase you, $$太極$$ shard and all!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5881": {
      "repository_source_sha256": "0e5f38ddeb85a7832bff2aee549fbee0748d43250a08c9e0734477bd06a7ed20",
      "en": "「Learn just how powerless you are...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5920": {
      "repository_source_sha256": "e635e846f7325307c197750dbfea2c98cd5cb38d4d0cc826749e31b0b416a586",
      "en": "「Take this divine punishment...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:5949": {
      "repository_source_sha256": "abb1975fa79ff2351b042af8b2086956ab2828301a1ffb9063a48ec127852469",
      "en": "「I'll add my rage and hatred,\\nand give it back to you...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6000": {
      "repository_source_sha256": "bff8cb768b2d8133b2e20c07afce8055af34f8c8d05b4e9d62c8ccdcb8cecdb3",
      "en": "「I'll decide your fate myself...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6039": {
      "repository_source_sha256": "bf579c205c48733f415e45bc3279d729d3b249cf68c67568ce5ede6d531fe3d8",
      "en": "「My rage and hatred are doubling...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6082": {
      "repository_source_sha256": "34acad3a22968ed3842cdbff15546fccd462f4fb8749737d9597fa76c8ed1f14",
      "en": "「A mere Wingless has\\noutwitted me...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6133": {
      "repository_source_sha256": "41a8e7b437af482e1162311590eddfad46a67da72b8a71648a92051b6cc28d4f",
      "en": "「Curse you...! Curse youuuu!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6168": {
      "repository_source_sha256": "f0f863ea0acf38943764a92f5123de3d496196eea4655805f4c67b4f2e64f1d7",
      "en": "「Understand. This is only natural.」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6201": {
      "repository_source_sha256": "bca079251c9b02b84cdff740679f634436723f7c6f116ea6c05b2f22e452d394",
      "en": "「Ah, what an ugly attack!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6228": {
      "repository_source_sha256": "aee9577568911fce8a95dda4c4bc4db98dc6301b1e0daa3be7993b2c28c5b818",
      "en": "「Pathetic... and futile...」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6255": {
      "repository_source_sha256": "aae6fa0b4a11694ab936bb1bf6b17700a47030819f9fff452cbede9b7632e5ad",
      "en": "「No need to bend causality for this.」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6296": {
      "repository_source_sha256": "cd8217216830202078e1f387692d0ea301a79937cb3201ef980aaffd52433c8a",
      "en": "「Struggle, struggle, in my palm.」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6333": {
      "repository_source_sha256": "2a4a7992d5557bdce7d79413da7e62cecd8d6023341d42008d364c0d78760564",
      "en": "「I can't help laughing. How absurd.」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6376": {
      "repository_source_sha256": "d6ab99d54b9ede76ab92b52a33ea9d65adb9374082f4db8d7763c307d3119c71",
      "en": "「You made a $$天翅$$ like me bleed...!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6415": {
      "repository_source_sha256": "5df5fef30ae33a079378ccde7e65f6aee4625732adc4fd51235d8cc0f349e83a",
      "en": "「The Wingless outpower $$天翅$$s!?」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6452": {
      "repository_source_sha256": "ee603341cf85d07fee87fa72e9c5a177ebdafcf8681176c421ca31d9ae8161cf",
      "en": "「Warping...! Causality is warping!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6493": {
      "repository_source_sha256": "b67449170f8a9bd972ed6e88196f5396a46d6ec6d7cdce7e861ad3bce472121d",
      "en": "「Will I repeat it again...!?\\nThat miserable feeling!」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6544": {
      "repository_source_sha256": "1aca603fe08f240bf90bbbd5438d89a79ff4d227d5c1b60bc5ffbab24cca5756",
      "en": "「Why...!?\\nWhy can't my hatred's flames reach!?」",
      "source": "new",
      "slice": "v_g254_00"
    },
    "254:6601": {
      "repository_source_sha256": "ba36252c15777a395d1729267e8a9680b82189ba290d777a7016cd420abc07e6",
      "en": "「I hate...! Hate's flames burn me!」",
      "source": "new",
      "slice": "v_g254_00"
    }
  }
}

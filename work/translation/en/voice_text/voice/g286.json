    "286:175": {
      "repository_source_sha256": "890476ce6daabda6659602451d334ec7f749733e925b01cb65692d62999f7625",
      "en": "「Just die, all of you!\\nThis whole world can go to hell!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "286:232": {
      "repository_source_sha256": "433834daf241fea903fc98cb30f0b16784b02af4076f0f39fb768820ea62662d",
      "en": "「This whole world is my enemy!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "286:263": {
      "repository_source_sha256": "17e5edfdc3b75be5f5b37d99610700986acfc7e92ef4dc66c98e885fef033e6b",
      "en": "「Aaagh! Everything pisses me off!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "286:304": {
      "repository_source_sha256": "9ff887512d23b68c249bfa63814f8de92532e64a6bedec194e7b3491959925bd",
      "en": "「I said stay out of my sight!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "286:347": {
      "repository_source_sha256": "232d00ffe39239c6e5ae5ff469e7b535d7eda8fd5611a2871915d05ee54f7ac3",
      "en": "「I don't care who you are,\\njust make this rage stop!」",

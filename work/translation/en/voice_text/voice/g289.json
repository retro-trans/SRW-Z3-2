    "289:0": {
      "repository_source_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "en": "「...」",
      "source": "jigoku",
      "slots": [
        "attack variant (?)"
      ]
    },
    "289:11": {
      "repository_source_sha256": "1a8d5fc7d3baae114a60f40cca5211b1b598d991703ebf4a73504bb06fbb58c1",
      "en": "「Destroy it...! I'll destroy it all!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:50": {
      "repository_source_sha256": "0cf4a2c40abb5d0f6e426dd19a93fc3518a4d427df86a5a300bd20554d6eea69",
      "en": "「Whoever gets in my way, I destroy!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:89": {
      "repository_source_sha256": "8fd2af481478666edf984d42d49a6a1e0815ada8651767f993a535b5c5e4c3ca",
      "en": "「I told you not to get in my way!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:122": {
      "repository_source_sha256": "e7307b43c658c3da41c4b41a4213f00eda537e6ee601a3c132bb9c0b5c531a95",
      "en": "「Ahh, I hate it! The whole world!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:163": {
      "repository_source_sha256": "82dc187c51e301602fa2845e3533dd0bd8afd3b2d43e00a21dba4f83c6801d5c",
      "en": "「I'll just do as I please!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:206": {
      "repository_source_sha256": "fd085e5cb9e7bcee59ded81bfb15e92e8af0fc46983739c4cd2a772221eb40e6",
      "en": "「If you're standing there,\\nyou must want to die!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:257": {
      "repository_source_sha256": "6e6418ad7de32be236dc23a45d1e574d8fd4efc6aa0f0372948fee7fa6babef7",
      "en": "「From my gut, from deep in my head,\\nhatred is seeping out!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:312": {
      "repository_source_sha256": "750be89f029432f6f0e2ebc9bb328ef0afa309819a7f45f6e9d721bddcb13644",
      "en": "「Who knew giving in to hatred\\ncould feel this good...!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:373": {
      "repository_source_sha256": "aa932e67aaaacf9091e93d9969ed65efc3f1cc5fd7f938ffa07486068af408c1",
      "en": "「Soon it'll all break apart!\\nThe world, and me with it!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:422": {
      "repository_source_sha256": "5b12a9b61a127b3de03e05a1db20abea5ddac543e0f48ee76072e0f22ac311d9",
      "en": "「Hate's sending my blood pressure up!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:463": {
      "repository_source_sha256": "290c955c645faee95d40657bbc2ea2769c134b1efed9437889e0a884f443b2d4",
      "en": "「Who cares anymore! Let it all break!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:500": {
      "repository_source_sha256": "45cc1da24f4d7fe5d6879808059a85610214022cd6eb98c3b348389c26aac5d2",
      "en": "「If it's come to this, I'll spit out\\neverything I've kept inside!!」",
      "source": "new",
      "slice": "v_mix_06"
    },
    "289:557": {
      "repository_source_sha256": "59d6ec245a677dfe21f1cb43a89ad7d57886535ed9859cdba3338dd8ab211c8a",
      "en": "「My, my... What an unexpected end...」",
      "source": "new",
      "slice": "v_mix_06"
    }
  }
}

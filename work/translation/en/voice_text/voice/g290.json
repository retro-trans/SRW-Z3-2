    "290:11": {
      "repository_source_sha256": "53497bbaf8dd818439e6b139b253140e029a007d015218e70fcad137a5931c72",
      "en": "「I'll destroy it...! All of it!」",
      "source": "new",
      "slice": "v_mix_07"

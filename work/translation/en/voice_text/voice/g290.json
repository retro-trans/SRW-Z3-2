    "290:44": {
      "repository_source_sha256": "d02c6c2282288cefca4fb07475b0a985094ae644703ff68fdd5be2211aaa2425",
      "en": "「I've had enough! Of days like these!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:87": {
      "repository_source_sha256": "8e58ac5f2d79ef0217edb9ac644a2302e6bf296593feae374aa402026c9a1e79",
      "en": "「Stay out of my way!\\nDo you want to die that badly?!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:134": {
      "repository_source_sha256": "ed81176804dba95d4949160afca7b5cb147fbc30b006324f0da3fa48ec3f7f82",
      "en": "「I hate it...!\\nThe hatred just keeps welling up!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:187": {
      "repository_source_sha256": "5160fd6ebffe6bee01dac52a10fcc738ba7b82effe262102f4f10e8b2e7b7cc9",
      "en": "「Aaah! My head's about to split open!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:226": {
      "repository_source_sha256": "74672dcffb1bd3ab8ea120ad20cdb2d4a1ed1c09eff1dabf1468a66a2cd9531b",
      "en": "「Move it! You're in my way!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:265": {
      "repository_source_sha256": "f4a5f5e3b47971adf80c6691a39a7678f3b28de18e5909f0a930ea29af78f65e",
      "en": "「Dark, murky feelings rule me now!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:306": {
      "repository_source_sha256": "0d7dc231aedc5008207b0b62ef8fabbe559807b5b74a1a22f2af779215313781",
      "en": "「To get rid of this frustration,\\nall I can do is destroy!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:361": {
      "repository_source_sha256": "90b8533c90c3f317ecadbd5e3d14ad643a4eaebd43b12f49bce49b607977d381",
      "en": "「Just let me do what I want!\\nI've had enough!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:412": {
      "repository_source_sha256": "c0e960b153da869fcc63093a934171799d9383a59c14f0735623a250b4b36d8b",
      "en": "「I hate everything! For no reason!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:451": {
      "repository_source_sha256": "4435e743ed06f14a7754c273df70070c77d0c00cf2d27e0f17aa35c0bde334d7",
      "en": "「I don't care! Not me, not the world!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:494": {
      "repository_source_sha256": "ec751ffc3b64ade9a635a4dc8db01bd5fa3a6b40cacf6a7f7940d02da42e2fbd",
      "en": "「What is this?!\\nMy head's throbbing deep inside!」",
      "source": "new",
      "slice": "v_mix_07"
    },
    "290:541": {
      "repository_source_sha256": "bc56386a37013451d8a5e6b8cb43153c7977134fabb67529a85773ec61a30eb6",

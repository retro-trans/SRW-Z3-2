      "en": "「What's wrong, what's wrong!\\nCome at me harder!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5139": {
      "repository_source_sha256": "7d9983d0fc4d9047b69eb332294875d75d915afa2da63bfbb8c07067c17fa1e7",
      "en": "「There's no way this\\ncan stop us!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5190": {
      "repository_source_sha256": "87ab4a766b2e7afa5f954a304083cccccd4cb3f796f8cd49281ec6f89485cd21",
      "en": "「Don't get it, but it means\\nwe can keep going!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5239": {
      "repository_source_sha256": "4da9784044a97ba85a9ca30458517a64fea1de56941880b609c520d5b2f1ac91",
      "en": "「Damn! Getting serious now, Tin Can!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5278": {
      "repository_source_sha256": "8bbf99f76ce10bde571113bee6f3e6ec57625af0d6cbfa10bfc93c967bfe6e8f",
      "en": "「Bring it on...!\\nNow the real fight begins!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5329": {
      "repository_source_sha256": "a973939377f72d54625f11c2af0a433aaefa650a3794d4c24e366b4e029dda46",
      "en": "「What are you doing, Tin Can!\\nWe're getting hit!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5388": {
      "repository_source_sha256": "26181c014bb9046d6ee529db671e67cc9117efc61c4ed743d0cdb620560b3503",
      "en": "「Pulling it off anyway\\nis your job, damn it!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5439": {
      "repository_source_sha256": "c508feb048793b44cb90167de77f7ae54b4402bc57570462cb9ac33aa6df5c42",
      "en": "「The great $$ピニオン$$ doesn't\\nrun from this much!」",
      "source": "new",
      "slice": "v_g296_01"
    },
    "296:5488": {
      "repository_source_sha256": "4af1bf7b5f4238ca5f948a3e6d42156f4733ce1cfdc68d3d647d63c2a35596e1",
      "en": "「Bro...! I'm not dying yet!」",
      "source": "new",
      "slice": "v_g296_00"
    },
    "296:5523": {
      "repository_source_sha256": "ab7c5d6ab878b0d0a9c29f9467f6bea1286644bc4837b7efbbf3fa84bc951c2a",
      "en": "「Now for a big comeback!\\nLet's do this, Tin Can!」",
      "source": "new",
      "slice": "v_g296_00"
    },
    "296:5570": {
      "repository_source_sha256": "ef183da6a5e44de33aa709a5f55ccf29ff74cc70b38d37e2248e144a8dee128e",
      "en": "「Hang in there, Tin Can!\\nShow some guts!」",
      "source": "new",
      "slice": "v_g296_00"
    },
    "296:5617": {
      "repository_source_sha256": "4b732b400807deff09238170c61d082a3c4c53ce9334249003e44a3ff5170dde",
      "en": "「With all this beeping!\\nYou don't have to tell me, I know!」",
      "source": "new",
      "slice": "v_g296_00"
    },
    "296:5682": {
      "repository_source_sha256": "8997cb00bc7e704fdb7ebac15eb58313c066e1bc7e2b41fbbb3eb0a7f44dd3d4",
      "en": "「Don't give up!\\nNow's when a man shows his pride!」",
      "source": "new",
      "slice": "v_g296_00"
    },
    "296:5741": {
      "repository_source_sha256": "6ee00ec40b1df0fd294557f867299960232b2de06b155a26db6c84225f4ec95c",
      "en": "「D-damn iiiiit!!」",
      "source": "new",
      "slice": "v_g296_00"
    },
    "296:5774": {
      "repository_source_sha256": "d9b824695b60111009437a234fa318e25860b99fe051ede0bde39e57973202f4",
      "en": "「Damn it! Is this really the end?!」",
      "source": "new",
      "slice": "v_g296_00"
    }
  }
}

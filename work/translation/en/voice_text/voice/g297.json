{
  "schema": 1,
  "group": "g297",
  "blocks": [
    297
  ],
  "speaker": {
    "proposed_by_v_g297_00": {
      "token": "$$レナード$$",
      "basis": "Calls Teletha his sister (我が妹, テレサ), pilots Belial, wants Job, Lambda Driver user, taunts Gundam/Zero/Negotiator"
    },
    "proposed_by_v_g297_01": {
      "token": "$$レナード$$",
      "basis": "Names テレサ (Tessa) with contempt, pilots ベリアル (Belial, Leonard's AS); calm smug 僕 voice; Jigoku gave none"
    },
    "jigoku_token": null,
    "token": "レナード",
    "basis": "settled 2026-10-02 from fresh-translation review: Calls Teletha his sister (我が妹, テレサ), pilots Belial, wants Job, Lambda Driver user, taunts Gundam/Zero/Negotiator"
  },
  "lines": {
    "297:0": {
      "repository_source_sha256": "8ae28d56fc88633d8b542a0db065eeba156d2c96208a5a452def526312463a3f",
      "en": "「Shall we begin, then?」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:27": {
      "repository_source_sha256": "f99a8d26b8abda0e6a343a863e908752ebd8192b241ee3037936d4b5d057b4df",
      "en": "「Let me see just how good you are.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:62": {
      "repository_source_sha256": "0bdca97651e6fb0d66524d3ecf1d35dbe883646d5032f37530b451f037f3c36c",
      "en": "「Show me your power, all of you.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:93": {
      "repository_source_sha256": "f16370084d0249613f701d799ce45eeda056bf340a6ff249aa88d23922c425ab",
      "en": "「I'm done watching from the stands.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:124": {
      "repository_source_sha256": "28f245a4a594dbc09a084c299b580f41bc9ebd83e7556b9975b7d272868e8d0d",
      "en": "「You're slow.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:139": {
      "repository_source_sha256": "9807581b5cd3dca56b82fe4710564e537b4501d1901eabaffbeba454858241e3",
      "en": "「That won't do.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:160": {
      "repository_source_sha256": "a05d4c6994ba8b39594aba5115357dcddd62cce7f4bd864e356aef1d33f4c6ee",
      "en": "「It's a simple game.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:179": {
      "repository_source_sha256": "787d84c112c89fc443686a5dcaa470dba67dae530db56411272b5892f6b539e6",
      "en": "「Your moves are truly easy to read.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:208": {
      "repository_source_sha256": "886de2574f349e77ed87874a25d60f17081059f1f6cfa68b53fc2e7631e944f8",
      "en": "「I've already given my warning.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:233": {
      "repository_source_sha256": "8515b24d4edca30be50be4cc59b8b12c9aef614a8a94a39b98d7015ecc4a34a0",
      "en": "「We can't overlook your existence.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:274": {
      "repository_source_sha256": "8f88bd75755e0adcaa986546d5f4fad02eb5b67c697fd6841dc98b7b0ab30480",
      "en": "「You'll be my playmates.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:303": {
      "repository_source_sha256": "c02a4f9319b8b5a641d21961ce7fd98b192dc35bda284c3b6ff2614b335f069b",
      "en": "「Resisting is pointless.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:328": {
      "repository_source_sha256": "bf13f97452e91e4d85b9f7343e24b8fbd9f78f7157198189fa2ec87c0dc5bae6",
      "en": "「Let's see if your justice holds up.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:371": {
      "repository_source_sha256": "aef308f82f22a581a38d16b1baa2c5a14d3cb2c09fce45ce90b28f84196a2398",
      "en": "「You think distance keeps you safe?」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:412": {
      "repository_source_sha256": "be5029332c9824002706b3c037ddca34b85c92fe166087b6af0a87570ea9c384",
      "en": "「Struggling is unsightly.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:443": {
      "repository_source_sha256": "6c2a73df2e1f32926b348b8adb3e56a9dbdc7d3a5e6629b946d5c1a047fee424",
      "en": "「No need for a weapon.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:470": {
      "repository_source_sha256": "3335572309c5c223fd36902665ef8a1e4b1e55cfd15d859ced755eec3582f9cf",
      "en": "「Going in rough isn't so bad.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:499": {
      "repository_source_sha256": "a34acb9a92dbeb09058e0e902e3809d927ea28af375368697cdf855f503ba583",
      "en": "「A penalty for ignoring my warning.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:538": {
      "repository_source_sha256": "94d2c62bfa86cc5714c95be4da0986b8007342a9e4891df4bcf19b3493651a68",
      "en": "「You're causing me real trouble.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:569": {
      "repository_source_sha256": "75eccf627ebe2aa66d36c9e93e0069a866cc2b3fcd4e8bdd967cb31652819af5",
      "en": "「Could you kindly stay put,\\nWatchdog?」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:618": {
      "repository_source_sha256": "1f7b52b70663659a1ecb155013205275aebba07f6d091c3907622d03d142bb6b",
      "en": "「For a killer to pose as\\na hero of justice. Honestly.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:667": {
      "repository_source_sha256": "95fcd06310938e97c780aa94f01fe5e5a0196590b243a0200684b32deaedc592",
      "en": "「True, that white AS is a fine unit.\\nBut...」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:716": {
      "repository_source_sha256": "77ed67ea763ddcc25214ead75b583744e6eac3b2c4ad67b1edc69855dbbae873",
      "en": "「She can't gauge the gap in power.\\nMy own sister, and I'm appalled...」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:773": {
      "repository_source_sha256": "d125e6a7f7255e1b5ae8163d5be8ee080b59d49139882f9ec9b3168e85ffc724",
      "en": "「$$テレサ$$, you foolish girl...」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:798": {
      "repository_source_sha256": "54eb59e95fd6bc5cecfa7fd281e5fe93545543a608d84de7431673380f890472",
      "en": "「$$テレサ$$ will grieve if I kill you.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:841": {
      "repository_source_sha256": "0146b2fb50608282adc61b49bc565421568acf9c244400d24f99383cc2d3f634",
      "en": "「You tried too hard, all of you.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:874": {
      "repository_source_sha256": "0175bae184703dbd4d42b24aa050317e5848f58ccb3780938d77bdecfdae84eb",
      "en": "「I'll bury this possibility of yours.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:915": {
      "repository_source_sha256": "d380349700fe853c523eb70523ff338abbd578219ff36b418de8a6a30c3682ba",
      "en": "「Honored to fight a Gundam.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:956": {
      "repository_source_sha256": "b91b9e691778b830f41a961ec8df5e7f757e75aa16b5a790dcb76f90cf1fa6fc",
      "en": "「The human heart holds no light.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:981": {
      "repository_source_sha256": "46b97c8e3f30747c800b3cc168f2352083de4058e82d40c24441e65ef4293399",
      "en": "「I might as well destroy the world.\\nIt might feel refreshing.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1040": {
      "repository_source_sha256": "c4c042aac8f73f93a19d6aea02fa8ffb584f970a4c5056acf4fe6185747c5084",
      "en": "「Still alive in disgrace? Laughable,\\n$$ゼロ$$.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1093": {
      "repository_source_sha256": "315041814d439a6e1fb9dd25b219dea64480f3efbb6250f090635e607f1ca1d9",
      "en": "「I'll surpass even causality itself.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1128": {
      "repository_source_sha256": "9970a790e550ab4912ef94eabb557a734f47cf11dde80d7471ecb35d25c65857",
      "en": "「$$特異点$$... I'm grateful to you.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1167": {
      "repository_source_sha256": "4604a5a5f4a7d426113e9f95ad0d3dc426965ef1f42079fd60911c7c1f7e9263",
      "en": "「Even a child's clear eyes\\ngrow filthy in the real world...」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1216": {
      "repository_source_sha256": "23bc2f235669b82ca78db0e8d087396597e4f18637f41ae572f45b5938337d7d",
      "en": "「Passion, guts, hard work...\\nI need none of them.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1271": {
      "repository_source_sha256": "b5db4b0300341609cf2eee1adda99b14dec6a2e68b50306e09e3d87a0f397ff5",
      "en": "「Brute force again this time, is it,\\nNegotiator?」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1324": {
      "repository_source_sha256": "689226ddfdd19b9a0f5133a34e7e9752f8993be81029f9d5139b6be4c2b8972a",
      "en": "「A good opportunity.\\nI'll take that $$スフィア$$ too.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1373": {
      "repository_source_sha256": "996438bad134828aa7c843af6970c917481e6a41f6b7e7fac254c39fe865ca18",
      "en": "「Heh...\\nI think you'd agree with my plan.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1424": {
      "repository_source_sha256": "b47e3c402c2a8e2c7809d1cbb72f1dbc1a202097fac426e0688e27ce4d8ceb3c",
      "en": "「Once you hear my plan, you too\\nmight want to cooperate.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1481": {
      "repository_source_sha256": "b70f8013b7e83b6f61c61ff48dd6a1a36a29f35ca7f568ac36ac0743035673e7",
      "en": "「I'd rather not be so unreasonable...」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1522": {
      "repository_source_sha256": "26c7407f903b068ae7810a914ad50501d7bb2d9fdf473a6dc3777bb8645ef40c",
      "en": "「If I'm doing it, I do it thoroughly.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1553": {
      "repository_source_sha256": "de57a969b736d1106239c2725770d08a5b722fe2c74eba296f663c11dc1143cd",
      "en": "「I don't intend to make you suffer.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1582": {
      "repository_source_sha256": "50f3c73bba62fcb799309790be00bd8e142b9e40a58a5d79627e6d5f71b69afe",
      "en": "「You've really become an eyesore...」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1621": {
      "repository_source_sha256": "e0f456d6a0a6a2e157dfb0695fa862e68120ecdb5d52326bcb1894fee6a07e5a",
      "en": "「Time for you to exit the stage.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1654": {
      "repository_source_sha256": "191f4e4e682d70f1bc9992f4c8a11941338d7b544289fe22e8cdb5b6de90349d",
      "en": "「Thank you for your service so far.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1679": {
      "repository_source_sha256": "64112d45667ff5ddcebc1ecc6dd2311f82bed44f49f580d8fa844d1e46c7ef8c",
      "en": "「Here is a taste of $$ベリアル$$'s power.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1718": {
      "repository_source_sha256": "5673fdf1587421411e58dbf00e0ecfa9194f5dae7cc9f7b0bff79b718dc7d519",
      "en": "「Only a part, though.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1743": {
      "repository_source_sha256": "ba04a240f06e89603e3313630a9ae14bc4c7eaf6ad4ad9d5fc3dd62bc1c48953",
      "en": "「Now, it's over.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:1762": {
      "repository_source_sha256": "0278678d749ab7f506fbb4c5fc5317330d3b3e8c12d510e5f0a29b6979f35411",
      "en": "「You lost by failing to defeat me.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1793": {
      "repository_source_sha256": "96f17ba5d3a1570b5bc73eaef097d66da8d474a101053072ebba15c00f8a7227",
      "en": "「You wasted a perfectly good chance.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1834": {
      "repository_source_sha256": "56786abb8ddc8a22b8b6f801a6775b6b4dc9dbda0aac174438c3d84542e99bc7",
      "en": "「You hit me, I hit back. Natural, no?」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1871": {
      "repository_source_sha256": "f221b142baf220dd2865549a6e23091f7cf2ba2d6345a2d06fee2f4fdfcb8682",
      "en": "「To anger one as forgiving as me.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1906": {
      "repository_source_sha256": "d71877158fb62486bca966f321b18e8a5a2d5ef4b49e77a29323e75d175ef681",
      "en": "「I'm not nice enough to ignore this.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1947": {
      "repository_source_sha256": "73f0c197ff61eb975dfa4de4d5deb3f2e45467f40d7cb345dae749e9183b5472",
      "en": "「That's what careless attacks earn.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:1988": {
      "repository_source_sha256": "cc711c7c8265f8ca108f2d26441a2e24052000715e1a91199609df5b3881d51d",
      "en": "「Leave this one to me.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2019": {
      "repository_source_sha256": "fa46033e035bc6212c1d549da3ab06c3989871bac0e83f34f620424cf0ed33da",
      "en": "「Looks like there's an opening.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2050": {
      "repository_source_sha256": "e3018ee43f7f03f37b987c990d427268073ca211a9fa33532125c0def7616916",
      "en": "「Enough. Fall back.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2077": {
      "repository_source_sha256": "de5a20ef275379acd027fdffb62d1728f23148c0da6fa14234b67febbc31e9a4",
      "en": "「I'll take this on.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:2098": {
      "repository_source_sha256": "762552f436bd1f9e27c09ca90ee560a544fa1a39de76605f389f82c9e9ec6fbd",
      "en": "「I can't let you do that.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:2129": {
      "repository_source_sha256": "fba1732d9e56c332984a4ba19d6918ca7ab17f3ec83ab98e6316618ab06861bb",
      "en": "「I'll take this one.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2154": {
      "repository_source_sha256": "c7b4740679e056664bd813a028045e3ac3756b4a8b54ebd5a24868fba7715a4b",
      "en": "「Let's both give it our all.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2189": {
      "repository_source_sha256": "3f3eddb0c4966d1af8f5f900e773f724ab304e8966dbd447334e15a4c2958c15",
      "en": "「So I play the supporting role.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2220": {
      "repository_source_sha256": "5f0e33e2c408b155c3d2f213dbe157b3ab70aa626e8effc2073b8bff5d78cf88",
      "en": "「Then I'll personally hold them off.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2255": {
      "repository_source_sha256": "51426684cdb59a28a50eccaa3b033d7804d57d03cb578acae7a9f664bd3d6466",
      "en": "「Seems you fear $$ベリアル$$ that much.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:2294": {
      "repository_source_sha256": "f4f9bb855249dafd99bb6064147d213bc719d3586dcec5f378155f6f37f54cf3",
      "en": "「A wise call, for you.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:2323": {
      "repository_source_sha256": "7456bb18aa7ce0d6726c9c172bb76c1214e55b963865dbeb6471946dd4540666",
      "en": "「So I'm the one who made the mistake.」",
      "source": "new",
      "slice": "v_g297_01"
    },
    "297:2360": {
      "repository_source_sha256": "7d009aba0c9d158b96f611eabcb6b0d2efa4e926395d8af8db81df0616a3f6de",
      "en": "「Within my predictions.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2381": {
      "repository_source_sha256": "639ee2a4d5ab68f322e098ed9192490985d2a9cb2245b90766e9ca9ee1630ac9",
      "en": "「Too bad. We won't be friends.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2422": {
      "repository_source_sha256": "7348c3509bf835266d25aef277f82923fee8ca35adc88021ea962c8074249674",
      "en": "「Something like that\\nwon't even graze $$ベリアル$$.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2471": {
      "repository_source_sha256": "7b0e31f8af1c2e65d8cdde2a5b451416e58c9d79032c4656dfbdd237d6ac493f",
      "en": "「You're leaning too far forward.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2504": {
      "repository_source_sha256": "7caad7d50595beb6e222b6d6cd4d81b8debf4c1c01d010e110b12c9d0d4506c2",
      "en": "「Keep this up and you will\\ndie for certain.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2553": {
      "repository_source_sha256": "ba6579937dc8297a9633b6200702110ef6ae1dd7e44e9b268436b12f32033a05",
      "en": "「Your refusal to give up amazes me.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2596": {
      "repository_source_sha256": "7469cd64dd16ea9e621a11e27cea0ecbfe992cf2499352f63878af20aa9081b7",
      "en": "「Looks like you aren't even\\nworth playing with.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2645": {
      "repository_source_sha256": "08535d954b56a2fa30a82c69348113761db8d0c6dad482b298f79717a5caeff9",
      "en": "「Enough. Tuck your tail and run.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2684": {
      "repository_source_sha256": "a9e24b0cec90e55f215f18c476e6f62423ff086a265eca130c89d825966fdd9b",
      "en": "「It's useless.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2697": {
      "repository_source_sha256": "5ec57c8cb0441d18f4c97c976858a3df903eedc8ef9ed27ebd324d05e9be57e8",
      "en": "「Too bad.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2714": {
      "repository_source_sha256": "c9a77be8e1b78aefc3e5c277aafa6b144fb3eb9bf925ea146aaeec420cca1aa8",
      "en": "「You can't break it like that.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2739": {
      "repository_source_sha256": "ca097c84cf3ba12703bc57ec04703e8ff08e9335bd2d15a32e46637d728406ef",
      "en": "「Yes... a $$ラムダ・ドライバ$$.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2768": {
      "repository_source_sha256": "ae1b7b9477c25e1e95681891ec8241193715aff1f6ec55d554d7b51942515ae9",
      "en": "「Oh dear.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2785": {
      "repository_source_sha256": "1be9ebbb7eb1eef4a2dd7ff40af949ccc66aefa487e48e7be786abc3dc23df89",
      "en": "「I told you, it's useless.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2814": {
      "repository_source_sha256": "9cdd7eefdc3d6bdaee417e5e079099f7bbf9a306b911da95ca1f27c6a9981844",
      "en": "「I'll credit your drive, at least.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2845": {
      "repository_source_sha256": "acc958036ffa93bd385531475af1ebdbc14d6e5e98bfbacaab67bf0e0130380c",
      "en": "「Futile struggle only tires you out.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2888": {
      "repository_source_sha256": "d352edff795bc7836d331cf8c4cc99d8501601969aa8b0fa1806ce8206915a6f",
      "en": "「How pathetic, that this is\\nall the attack you can muster.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2939": {
      "repository_source_sha256": "e5ba940571f573c26ad09d70826b3865c044c3aee0a2763f87f25f6abbe635f5",
      "en": "「Why not know your place already?」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:2974": {
      "repository_source_sha256": "b1d9e939a02e5796565397ffca42dffb2c72299bffaa869549f172fd1b5960a4",
      "en": "「It'd be so much easier if you'd\\nsimply raise a white flag...」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3023": {
      "repository_source_sha256": "b963894856df2ba064961d879664909ba353cd79c5df7d9ddb5912d32ceda411",
      "en": "「Weren't you going to stop me?」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3060": {
      "repository_source_sha256": "743d55a403c4c439341ffa0e988fd9dcf31c78ed890f3efd28180ea91841b547",
      "en": "「Your feelings' power...? Powerless.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3097": {
      "repository_source_sha256": "86c749dace03ab460c5431b29665572306e294561bcc03889bd3f895f9140706",
      "en": "「Better to give up and hand over $$ヨブ$$.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3138": {
      "repository_source_sha256": "0802d999805efc8ab65eaefeeccd8d0738bf4f0fd556de7c6d5a05b7cece067d",
      "en": "「So much for your vaunted power.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3167": {
      "repository_source_sha256": "51bfb7dbaccd034fceb6f7588949fd6231f25cfe3632f3ce087bb38ca2dbdf62",
      "en": "「Is this all a Gundam amounts to?」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3210": {
      "repository_source_sha256": "5eff9009d06bce5013ce1726934587d883038959c7654add409fa835ad6fc829",
      "en": "「Great mobility, but the attack power\\nthat matters is only this much.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3259": {
      "repository_source_sha256": "f0eb2c51f5bf901b6669f824b7483683037fb1a62be9750dda0e94108583ab7d",
      "en": "「My $$ベリアル$$ surpasses even\\nthe power of a $$スフィア$$.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3312": {
      "repository_source_sha256": "18e785fa95aa6163504ea4c8130b5beaf8bc5268f8f86621e2c021761cbd888d",
      "en": "「Beyond my estimates... Impressive.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3343": {
      "repository_source_sha256": "cd8f00ffd0bd2f4f6f11585787e5b801fbdf9b71c92b9dea2ce37fcf1606eaeb",
      "en": "「Oh? I'm genuinely impressed.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3370": {
      "repository_source_sha256": "d9aadf7047ad12e63cdac9921d19e9edfa368494fb819406aee0a66f3ce64506",
      "en": "「I see.\\nI'll update my data on you.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3421": {
      "repository_source_sha256": "75638d5564650dd23b166ac107cad0946741cff5a0ac664577a954788548a0b5",
      "en": "「Crude and vulgar... how like you.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3456": {
      "repository_source_sha256": "a9087b5460c9b75c89e8e20ed826878207150e878f34a22a5b026ca0ab532e97",
      "en": "「This desperate struggle of yours\\nis sad to watch by now.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3511": {
      "repository_source_sha256": "957e11f357ed29c2081bb87a4c7088ce6a3b63f0e934fb0c1aea44e729cf1065",
      "en": "「At this level, even a $$ラムダ・ドライバ$$\\ncan't block it all, huh.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3572": {
      "repository_source_sha256": "41b84de05c1236c9bc53cab62b1c825f60ab29b451de63dac917710e732c6271",
      "en": "「I see. So this is your power.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3605": {
      "repository_source_sha256": "01f33ba573421241b8c000437ec5d15ae0b0cf592a05282bca0c8d8542e6f225",
      "en": "「Better than expected. But...」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3642": {
      "repository_source_sha256": "1c834956333264f051893bb5b81d9d9c8d7569c4c208321cfaa66c336d715165",
      "en": "「I think women come in two kinds, and so do people.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3725": {
      "repository_source_sha256": "e0cd763c56bd3eccbd133b6bf232d3870236ce7a27dc40b5e0ad1c58df7ba176",
      "en": "「Those who clear SRW and those who don't. You're the former.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3794": {
      "repository_source_sha256": "b84354637b98a1c0508b267fcd556ed5aab508a6f1c5d07f2dc2a4d2e3471e2e",
      "en": "「No sarcasm. It's meant as the highest praise.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3851": {
      "repository_source_sha256": "1e6e1b234c4bf7012f4246496d91728e232f79c5fdd33fb9e2a411ae43c0a324",
      "en": "「So come back, no matter what. And settle things with me.」",
      "source": "new",
      "slice": "v_g297_00"
    },
    "297:3918": {
      "repository_source_sha256": "218f4045e2075377925d71a4624fef718379916bf9acfa8004e097fb5f917773",
      "en": "「Well then, until we meet again...」",
      "source": "new",
      "slice": "v_g297_00"
    }
  }
}

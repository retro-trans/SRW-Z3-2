  "lines": {
    "298:0": {
      "repository_source_sha256": "c4ab1fa30125f819484040bf30155a1af9a240bf96a856520c46973092bc63f5",
      "en": "「Time for you to disappear.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:17": {
      "repository_source_sha256": "c6422c2a99afeee36c26979553d487ab72e90d05ec3082f3172316f198320609",
      "en": "「I'll end this!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:44": {
      "repository_source_sha256": "bec85d39e482dd3ab297719ece4b7993c39964310eae184044b476dda0324259",
      "en": "「Let's give it a grand finale!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:75": {
      "repository_source_sha256": "b1d9e939a02e5796565397ffca42dffb2c72299bffaa869549f172fd1b5960a4",
      "en": "「Why not just raise a white flag\\ninstead...」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:124": {
      "repository_source_sha256": "b963894856df2ba064961d879664909ba353cd79c5df7d9ddb5912d32ceda411",
      "en": "「Weren't you going to stop me?」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:161": {
      "repository_source_sha256": "0eeac7e78ec5824974fc40cd30ecb8d720a6e032d0151c4f0a81fa80a6ff3c02",
      "en": "「Try to hold out a little, at least.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:190": {
      "repository_source_sha256": "5aa2bd980f2472d333dfe53cccc8a6f9fb5fab501d6f7ca935e8d5f30dddd0a1",
      "en": "「You've grown a bit, haven't you?」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:229": {
      "repository_source_sha256": "19e762c7e0cb44a832590d61a1613d27a6627660005c29b478f6bef5501e770a",
      "en": "「Hinder the plan, and you're done.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:270": {
      "repository_source_sha256": "1d787d5e69e93533179451e651a35e13e44c7ed13310d7f4b22fccdeaf5d567a",
      "en": "「No restraint. I kill at full power.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:311": {
      "repository_source_sha256": "5c08f7fca0c7bc72012fd02b527ae742572b7e6abe4cddeece07fad4a8b45f99",
      "en": "「I'm seriously fed up by now...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:352": {
      "repository_source_sha256": "50125c476b34e283a6493b6f560121c40268d9421c6b78d247a14fd5352632ef",
      "en": "「I'll crush you by any means...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:393": {
      "repository_source_sha256": "67060bef014d742398945b24d47b8698ee642f725cc92911e07ee17f83a5ee09",
      "en": "「With no room for compromise,\\nthis is all that's left!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:442": {
      "repository_source_sha256": "8cae3bda4b29d5f933c3928d340b6e2a4fe1a36e84a13747549a2baf19bc204c",
      "en": "「A warped world\\nmust be set right!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:491": {
      "repository_source_sha256": "644e1ddca38bd9e811ccc8b7ad6b6d8be04736107968b221e0fdafd3c27c488e",
      "en": "「I'll restore the world's true form!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:524": {
      "repository_source_sha256": "782f8183ec69e1f8051fa50c60fdb3724fe7e8c22067f587673f1a9bb5c72b74",
      "en": "「I'm not the one who's warped.\\nYou and the world are!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:577": {
      "repository_source_sha256": "5c4c8d97f718161df39f6e0fe743b5d154ef3f460730b68a75c7551cac647140",
      "en": "「You're as stubborn as\\nfundamentalist terrorists...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:646": {
      "repository_source_sha256": "0e7c0d658d87abc871318495eddeeba2f38fda78463ea846fde127529c0d9560",
      "en": "「You should have just stood by\\nand done nothing...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:697": {
      "repository_source_sha256": "5badf9f561a7751b2dc9b23bcd9347328f2af6ed194e4676c8f5fba0e124d483",
      "en": "「Having power was your mistake.\\nNow you'll be crushed!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:752": {
      "repository_source_sha256": "4f22b2e06b2d7be66d4bf87c4a8aa92f1412c99d85df8025ac345f45512accf8",
      "en": "「Too late! Transformation has begun!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:791": {
      "repository_source_sha256": "d51a69978b68ff792cf5ff17678dd652bc3af98834f0afa6cccfe5876ec39ffa",
      "en": "「Don't despair. All will be well...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:826": {
      "repository_source_sha256": "be6cff39efd994fd4cf00e974670f54d23a58cbaf14a56b093a948c300940274",
      "en": "「She'll make everything better...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:863": {
      "repository_source_sha256": "4bc1e95e79766a556963bf9fe368aa2d701d4072cb60ba045e29002ccd118f9c",
      "en": "「Our rotten ties end here!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:904": {
      "repository_source_sha256": "272a921b474ba638f3d3c934ca230c9ea5daafbe69656d448890c2f6af317554",
      "en": "「Soon this world will be nothing...!\\nIt's the end!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:961": {
      "repository_source_sha256": "48013fd635c1474aec2ca799684536b6a92f84a2b156cf39119b49a86647a851",
      "en": "「Soon it will all be over!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:988": {
      "repository_source_sha256": "c03c5846370d834019b02f1f2daa2549df7274001d2beb9f9404584ddac5e1fc",
      "en": "「Even from a distance...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:1013": {
      "repository_source_sha256": "0f8550c489e80c0c4fdee3234d2788553f6c1c9b23468d12cbb731edb7a49989",
      "en": "「Time you accepted your fate!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:1042": {
      "repository_source_sha256": "bfc990f17ad561f729efaf7a9d694b2d33704906d9216b699ca176f18207f964",
      "en": "「Dodging won't save you!」",
      "source": "jigoku",
      "slots": [
        "weapon slot 1"
      ]
    },
    "298:1063": {
      "repository_source_sha256": "30a73e55027a37057f0089e93ddfed9fc5bc816dbbd11a27a98f29aa2e045790",
      "en": "「Every round lands a direct hit!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:1086": {
      "repository_source_sha256": "fcec9bf0a1cbca257b739d6829fa9914356f6a682e7c4027cd84930c207e5bc3",
      "en": "「I'll finish you off directly!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1117": {
      "repository_source_sha256": "7c3bc6b4363c4a93f5ef0bafbacbd40608f87be837037af9d31ff7e745ca7ef8",
      "en": "「I'll take you down myself!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1140": {
      "repository_source_sha256": "81dc10cb820aa5d9ddca83a66542441804f04aa51e7b5a5ce8fc4694f0a8c819",
      "en": "「I'll tear that armor apart!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1167": {
      "repository_source_sha256": "888d814786d2433ce61bf13bd35daabe29e0f1fca2f103be6ee68ae3bf03a8b1",
      "en": "「I'll crush the cockpit!」",
      "source": "jigoku",
      "slots": [
        "special opponent: attacking (?)"
      ],
      "alternatives": [
        "I'll crush your cockpit!"
      ],
      "review": "conflict"
    },
    "298:1192": {
      "repository_source_sha256": "934b264451e9be884302e33ccaf3235718802c6946e4157d054b9c7452c85dde",
      "en": "「I'll hound you down thoroughly...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1223": {
      "repository_source_sha256": "74164636cc3701b7b64ef8a3c4847c58104b7f4b923ab2e76774f7215e1e42ce",
      "en": "「Just drop dead already...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1258": {
      "repository_source_sha256": "59ac168993054ce9cd8a0824009cccdfdcaf7acfdd65b24b3273436e5169d770",
      "en": "「I figured you'd make it this far...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1301": {
      "repository_source_sha256": "62e7b179dbeb47f09724a6a2a1f30642a1dca0a7ab9b3e63d1c1792987c2c727",
      "en": "「Still as dense as ever...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1340": {
      "repository_source_sha256": "23007ae70796063a193dd29ca553fc11e16e652b002de4c7dd1243aa8eed6f98",
      "en": "「You talked big, so prove it,\\n$$相良$$!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1391": {
      "repository_source_sha256": "cc02948ba9ec54c02ee8a85aa80ce110378b963a911f3c4c83dc1c0f4c22c8ad",
      "en": "「You were annoying to the very end,\\n$$相良宗介$$!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1446": {
      "repository_source_sha256": "a2a83eaf8f5867a18ed6e3f946cb9805d3c37807b8a80e390b2d4e5f275f82f6",
      "en": "「Ruin it? Get in my way?\\nTry it, if you can!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1511": {
      "repository_source_sha256": "5c7f6f36445f12ffc7365cacf002e3d3afe340dcd55e39f7b03275f6b64c71e6",
      "en": "「You think you can win, $$テレサ$$...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1550": {
      "repository_source_sha256": "e25897b6b755147545118f0dee1b46111ccac5dbf909f16a62716082868146b6",
      "en": "「Sensing the field won't help...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1581": {
      "repository_source_sha256": "697a628b1f94e1ff85d95d1efd2cb3e56c65cbf1409477b4fd82408acb1213e4",
      "en": "「Challenging me in an AS like that\\nhardly seems sane...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1638": {
      "repository_source_sha256": "296dd6ea7bb6ba791acdb22fe507fdadc475842bf4b779c38ce08e9ea404d4ce",
      "en": "「Quit being an eyesore, Gundam!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1679": {
      "repository_source_sha256": "bc4cb714cb3b3161150f3837e54b031219d079e72784d9d9df7e7c3a3dfc90b3",
      "en": "「I'll wipe Gundams from this world!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1716": {
      "repository_source_sha256": "c83ee6eed50a4b6069a40ffab359c9736493c4a10b23e1d7dcc8e12af72060fd",
      "en": "「As if talking could stop a war!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1751": {
      "repository_source_sha256": "fb94135fbbc05f724fe4cbbaace248d9ab90c61362e8459ec4e98bdf83bde1ec",
      "en": "「Possibility is not given\\nto everyone equally!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1804": {
      "repository_source_sha256": "1e5645fd84835e854e3bb4c2f8f109a0f93a92d631e84f77aa1583fbf8dec157",
      "en": "「However much light you show them,\\nfools stay fools!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1853": {
      "repository_source_sha256": "cc2b02cac1823b7e952d0c4dd76519e1af1e3ba1ab455478f81e52a21dbd992e",
      "en": "「You wasted world-changing power!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1896": {
      "repository_source_sha256": "4ee375d7837735c0c718012cb7e158761015cf6d9e3d00c18aa5bf858888e63c",
      "en": "「The old stays old\\nno matter how much time passes...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:1951": {
      "repository_source_sha256": "2c92c1cc50bb42b3ef05c5a01c95d36cc69b6a932271a2596eb4316a1213ba93",
      "en": "「Miracles don't happen...!\\nSo I'll change the world myself!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2006": {
      "repository_source_sha256": "d24da31942323004dbfd1953ac0f8f53055c161bac796eaeb4965242fbdc5316",
      "en": "「Stop me with talk, then,\\nNegotiator!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2061": {
      "repository_source_sha256": "f820cb0cab9b215663d16b04f89203785d4ed4b0b6d3650764ae2de4272d13d8",
      "en": "「You can't stop me with force!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2090": {
      "repository_source_sha256": "e9e39997629da79480349099567cac3bbd0b6ed575d210ca80d815602ad51df1",
      "en": "「Is even this machine's existence\\na prank of the parallel worlds...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2145": {
      "repository_source_sha256": "522a4ad220d52e614e958bf90a84d29f1615b44005cf63d3d3ccc0ec72604c83",
      "en": "「Take your love games elsewhere...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2188": {
      "repository_source_sha256": "e139877fbc4be6d0bc21b7f6fd365ea84e5cf8f2aeffc23ab410169b1e9089b3",
      "en": "「I'll do what even a Mechanical Angel\\ncan't do...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2241": {
      "repository_source_sha256": "d27cf89fd5f09cbbc83c78248ee2e5ede8ef741b85e456c97deb5558f29260fe",
      "en": "「Love won't change the world...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2284": {
      "repository_source_sha256": "d8351593d0c18adde8ccaea9ffe96cc7262d02d43ee5092a0d3e33d0b04baba8",
      "en": "「You blew your last chance yourself!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2327": {
      "repository_source_sha256": "4dac19ef31299789f2dbed61d88b37487a02633b41882c8424cf791fde021063",
      "en": "「Admit it...! You want to help me!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2370": {
      "repository_source_sha256": "fe07aed7418d329defcc9b611e284402116b8af8d795a79228d1713f357f6699",
      "en": "「If you'd followed me, I'd have made\\nthe world you wanted for you...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2429": {
      "repository_source_sha256": "437a2cf5054e3ba7e26118c73f92adf0672be186ef1574d94dc68f8c41acfdda",
      "en": "「You'd waste a chance to see your sister...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2470": {
      "repository_source_sha256": "0d625132ae58af5624daf677b1a0daf30971e912f95769375152f4981caac579",
      "en": "「I could even have erased\\nyour sins!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2523": {
      "repository_source_sha256": "0aa98bc88230f41193509c4a73dd9a45205c614697b7bc6117402eff8cfd3e12",
      "en": "「You throw away a chance to redo\\na life full of regrets...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2584": {
      "repository_source_sha256": "087fe551f181c734449b8506def9b76a45499ea202e9d782a94fe43d204461be",
      "en": "「You'd refuse to save the life\\nof the woman you love...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2637": {
      "repository_source_sha256": "c1dfc57636aeb1d1fc6562a7c933ba1608cc1649ac1b281097bc6852e43c6c4f",
      "en": "「Without power, you're just a man...\\nThat suits you!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2696": {
      "repository_source_sha256": "da308d33376ca9dcdb2832427d39efd48250abfe40166669ed598d1641e1c4fe",
      "en": "「Refusing to see your dead friends...\\nHeartless...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2747": {
      "repository_source_sha256": "7c514955e8d7254222cc6fd6b806ad078ad44780cdae6a9aa96bc01807b8989a",
      "en": "「Hand over the power you hold to me!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2784": {
      "repository_source_sha256": "4a14101639ad3367a43fd611765499c350a0f01ccc0f3d2e98b089ace310b0e8",
      "en": "「I'll add that $$スフィア$$ to my plan!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:2821": {
      "repository_source_sha256": "11eedff9aab2410d25a837daa31a2deddbac1530441cc1d393e067ddf77e347e",
      "en": "「I like this kind of thing too...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:2856": {
      "repository_source_sha256": "7966c00d5e285b1e05394d5a24f2954fe148da61bc85d948668f12525d1bb083",
      "en": "「Naturally, I'll be thorough!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:2881": {
      "repository_source_sha256": "cb7c2b982a61c628e083c646a7f14d39cc71ac608397c56389a0719de3ed677a",
      "en": "「Ha ha ha, get blown away!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:2904": {
      "repository_source_sha256": "d1c1eec504f056fc5911b1dc594d2ded4337fa7c8c856a5695018cf8c1baa04d",
      "en": "「It's too dangerous to leave\\nyou alone any longer...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:2953": {
      "repository_source_sha256": "202a0a07b5a7371d87f5c3e7a13e77f46c07a785650517f49189e1fe45d21afd",
      "en": "「I'll crush you here!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:2976": {
      "repository_source_sha256": "4faf049fa3c790f1272c9e9148cf562464c91eb0451cdb835fa9f491b418a7c7",
      "en": "「Vanish from my sight!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:2999": {
      "repository_source_sha256": "99fb018740ca6af8d6106749c3e999ab916d12c6aad013a6e376e7ccd6273d6b",
      "en": "「Come on, try to stop me...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3028": {
      "repository_source_sha256": "868602ec8ff3830dbd85a1e134459cc809b2a9d4e6ede1d7a0aa7d66b0f5c57f",
      "en": "「If you can do it!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3055": {
      "repository_source_sha256": "ab3e6a7c489cc520d3c766739308d8e7ed63f02cca7c68087d5ac832686d9265",
      "en": "「This is my power!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3076": {
      "repository_source_sha256": "0be5cc9dcdbf4749fe678f7acd73452127af5ac426690043ed09178ccb0efc2c",
      "en": "「Against this, no defense matters.」",
      "source": "new",
      "slice": "v_g298_02"
    },
    "298:3117": {
      "repository_source_sha256": "b65a28df32115c96ea9ec26747d4a39766fa31ceca9c5b11b83a9d34d71969b5",
      "en": "「Want to die? Go ahead, try!」",
      "source": "new",
      "slice": "v_g298_02"
    },
    "298:3148": {
      "repository_source_sha256": "dbe6c7d44fc96b04f87746f6267e1e805014c73b85375d4581a3fc5ee5b6b745",
      "en": "「It's over in the blink of an eye...!」",
      "source": "new",
      "slice": "v_g298_02"
    },
    "298:3179": {
      "repository_source_sha256": "0bd50b3a1e3c2e5401502fb3cb607f5666699dc952031e6a9110f396eae18864",
      "en": "「There's no escaping this one!」",
      "source": "new",
      "slice": "v_g298_02"
    },
    "298:3210": {
      "repository_source_sha256": "c7aacf15646ee16f5159bb8729b4b6c59609bb50983e7927a5ebc3d848ed8b5f",
      "en": "「Isaian Bone Bow...\\nThe invisible arrow...!」",
      "source": "new",
      "slice": "v_g298_02"
    },
    "298:3261": {
      "repository_source_sha256": "844b8958fc8596c460ecf7cc00dae85e3a9fa6334bde0d3ca1bd9f673c170192",
      "en": "「Punch right through it!」",
      "source": "new",
      "slice": "v_g298_02"
    },
    "298:3280": {
      "repository_source_sha256": "29a0c9e3a4d420518397e10a44c3e048b7af20a3c7a3835ae61bbb5adafea89f",
      "en": "「It's my turn now...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3303": {
      "repository_source_sha256": "bae622d35f19d8520e8f7b71dc1116c0d16d6a2b4e9b5606146e4ac6c4f50bef",
      "en": "「Don't think you can get away...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3332": {
      "repository_source_sha256": "8408c69eb8c9747b37161c124a2c5a0893967de90001abd4190f0acf75979cb0",
      "en": "「Resist, and I'll break your will!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3371": {
      "repository_source_sha256": "914163e7bfbeebf15d4cd1c31d9542a295bc4e494b15093d2b1d6dcde70643c6",
      "en": "「The old me might have let you go...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3414": {
      "repository_source_sha256": "fe09e231b70bb372974393b29ad3b9be805443c331b9aec528429b22ded16bf6",
      "en": "「I can catch up with ease...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3439": {
      "repository_source_sha256": "e6cf9d4d7128cb41ad08c7aab847294e32e1175b1425ce2adee94d246306e5f9",
      "en": "「I won't be satisfied with this...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3478": {
      "repository_source_sha256": "f02b06f00c2efc167e427d0d7513ac2e83014d0450680097245b687234fc5ac9",
      "en": "「You started this,\\nso of course this happens...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3533": {
      "repository_source_sha256": "92e108f088743e063db545dc8ea729dba3fa43a89c21a83d0535e4e167514d0f",
      "en": "「I'll deal with the instigator first!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3566": {
      "repository_source_sha256": "f151817b2a4240da7e436d708bc381dd4c7abf5d4366f5e7d0d0ab5fc0e85dff",
      "en": "「This way is more efficient, too.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3589": {
      "repository_source_sha256": "ffa0c61a1b9e7daef10af1fa260ac3feec2949e5f3c0f0235b52e7d30904f187",
      "en": "「I can't spend much time on this.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3618": {
      "repository_source_sha256": "b1689370b1371b9eb36660e6fc2ac2e22e673c8f29d5ae9a1231d99344a386c3",
      "en": "「Struggling with enemies this weak.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3651": {
      "repository_source_sha256": "31cc1e73c1d2f30c19628d68b8169729e2aea3fbf1f7bab115095db15f5e98e4",
      "en": "「Well done. Good work.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:3678": {
      "repository_source_sha256": "55cd4993a147aa6962da17dd5d0ef2b1078ba38001dfb24c181c33f91d3099bd",
      "en": "「Tch...! To think I was set up...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3717": {
      "repository_source_sha256": "fc9009fc8e7a65ec1e2094ca95caa1ad48c9fa19ad3aefdba7e204f1586a4b27",
      "en": "「I'll make them pay. Without fail...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3760": {
      "repository_source_sha256": "d3cde86e90d964df1570a9836d5f4addea448bf92eb75f533e1cd5c3b6569f98",
      "en": "「So they're desperate\\nto survive...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3809": {
      "repository_source_sha256": "04c6e671fd11ce99df3061f839c470735c6d306ab1b135d227e574186baedfe2",
      "en": "「Nice...! You blocked my counter!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3852": {
      "repository_source_sha256": "fc7837aebfc36d86bda2b2efd30e8f53ba2eaeb4233b11188354073c1436d5a1",
      "en": "「Not bad, am I?」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3879": {
      "repository_source_sha256": "6b74407608af4635dff17cfe5b4af5b2b3e528ebd050699e71a0e0da5f200c4c",
      "en": "「Your impatience is exasperating.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3916": {
      "repository_source_sha256": "b9e4746a16068f366ab589d3011909e7d588f08ed07d2ed24c9f743939e30e2c",
      "en": "「You're way too fired up.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3941": {
      "repository_source_sha256": "7b0b97c23c5f34980c3a8823180913d29b1c170d2a9b0823f1c0a1280f4c7e1d",
      "en": "「I'll grant you that stifling zeal.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:3980": {
      "repository_source_sha256": "23998e7354c72d370882869c0a6106e95e59664587076abd187d77a041bc6f0b",
      "en": "「Be a bit more creative.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4011": {
      "repository_source_sha256": "f0775d993768aaa4f0d04c163d0ef683ac4d9e82f259f91fb9118453681a4b98",
      "en": "「You try such petty tricks.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4042": {
      "repository_source_sha256": "6cf6a0db47772f5d27e0f3749378154a19a3883f32808c29c2ec7c71478518c4",
      "en": "「Go ahead, don't hold back.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4073": {
      "repository_source_sha256": "f654f3a25bcdc99169dfec4c119ef98cf08a321729eb5a6b8d8b718632d8e86b",
      "en": "「What's the matter?\\nWeren't you going to stop me?」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4122": {
      "repository_source_sha256": "24c34c099a51bc8df4c622a8ed74770419cfeba66780bb2ee99e2136e88bfe93",
      "en": "「I can see that panicked, fearful face.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4161": {
      "repository_source_sha256": "4b4a94c798d18914897b43f00c1906f42bfc266937c72ac3b80e9e80f1f25e30",
      "en": "「Is that all, $$相良宗介$$!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4198": {
      "repository_source_sha256": "31e5aad2b21014fd895e281f678042f1852527a4886ccf564bfe94fea5a19353",
      "en": "「You'll get her back with that?\\nDon't make me laugh!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4247": {
      "repository_source_sha256": "f9feeed50ea6cda48e9469c34c8db2130264af670e15eb39f1d8288574272deb",
      "en": "「Admit the gap in power, $$相良$$...!\\nThis is reality!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4298": {
      "repository_source_sha256": "454bcd433f10128a3d843ebe3ea2e1804ab0cc7ff12d69a1c60ad31b12eb1f44",
      "en": "「Give it up, $$テレサ$$. It's pointless.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4331": {
      "repository_source_sha256": "081973369bb26b94fb3bf1cda7ca2a9cf6d57460b7acbef182f3c9c6972c6f5a",
      "en": "「That's all a dying $$ミスリル$$ has...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4370": {
      "repository_source_sha256": "7d9ca9f9c1162db9e9b509001c7baf489c34505a66fe00078ec6c68e50566942",
      "en": "「Your power can't touch $$ベリアル$$!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4413": {
      "repository_source_sha256": "6754847c50e31fcc926b2c5af4543a302509e53934c8ab18067fc1016b991320",
      "en": "「Even the dream super robot\\nis reduced to this before me!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4472": {
      "repository_source_sha256": "807441c9e88cd3fd7075d8045b46eb1cf982898e712ce09187ad4989d52b7ede",
      "en": "「Unworthy of the $$ガンダム$$ name!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4513": {
      "repository_source_sha256": "e6be604445a95c0d18909580aadc20537e92693ceaeec67609b4042b9c0d6554",
      "en": "「The $$ガンダム$$ myth is about to end!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4550": {
      "repository_source_sha256": "59a710d216a114c767839bc466aa117d0a92aa17ee85f2544846b5a2d97f6710",
      "en": "「You'll regret refusing my offer!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4593": {
      "repository_source_sha256": "a10d4bb43eea772fc841d019ff1619014642445f753f38283ce883591e43e10d",
      "en": "「You have no choice but to die\\nin a world of despair!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4648": {
      "repository_source_sha256": "fa631e89ac7ae5ace09f7aebe06bfdc3e5a4e686b9277905417e3ed4429f340d",
      "en": "「Did you think that would work on me?」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4689": {
      "repository_source_sha256": "86809b276c869fb3b16871d76523ad884de16c28ec313ddbd3bc41b8292193a5",
      "en": "「Get it? It's pointless.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4718": {
      "repository_source_sha256": "7f7de09e101a98b8fd6a3a9a6cda0996a3168b7990333e2262aacc34e10d4de7",
      "en": "「Unless you break the $$ラムダ・ドライバ$$,\\nyou have no chance of winning.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4779": {
      "repository_source_sha256": "2677c9eb2994c8059b6434a5170fe6917797e75ffc83766fe623888bbf62360b",
      "en": "「Full power, and this is all?」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4802": {
      "repository_source_sha256": "b8058b75c1cc2f2ef178a91969b837b83b8b20d5f301e2326d102b266eadf559",
      "en": "「Keep up your pointless attacks.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4833": {
      "repository_source_sha256": "a379d3249d157e0a20622bf6e6479c57001fb162cf70c9135cf6719d01eb94b0",
      "en": "「Everything you have, and this...\\nIt's laughable.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4882": {
      "repository_source_sha256": "9c5f8d344befdd128d32daeed62f2168ceef65184ce565b4504ca0afc08eccef",
      "en": "「Your obtuseness shows in your blows.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4921": {
      "repository_source_sha256": "e3746b7145f202d218b1437bb7687bb707607c395074eed0dd60372dcd465373",
      "en": "「Such stubbornness is exasperating...」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4960": {
      "repository_source_sha256": "32def87a320c8764fa9b46a327cbc23fafd0f0fef4bce87876c7a1b65955748d",
      "en": "「Seeing this, you still struggle...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:4999": {
      "repository_source_sha256": "a8cc167b7a20d8d02be252de96fb680e68642fa068c24fd6afbdbee2dea32563",
      "en": "「Scurrying around...! What a pest!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5036": {
      "repository_source_sha256": "3f3e037c29f09d31a178a463d787178d8e36e3d197a76d4e74e1df95ec8348f8",
      "en": "「Even if the damage is minor,\\nthe irritation keeps growing...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5097": {
      "repository_source_sha256": "9520c392b43e9db2a3e52482eb6ef9eec40b09aeaa33d901dd3636ebe22aea93",
      "en": "「Heh, impressive.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5120": {
      "repository_source_sha256": "cabb959526b596ad97d829a6ec1a84f471e623ccfb9edd212a001cb74147dd80",
      "en": "「Not bad for a self-styled hero.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5163": {
      "repository_source_sha256": "1c4bb60e94424825a1fb97177ee80a65e09b5efba32aa456dd394615afe5f6a9",
      "en": "「I'll credit that will, at least.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5192": {
      "repository_source_sha256": "19b7a3613ab45e88c2883400b9fc105f93a551c369f5a3dd0c30163cf76678c7",
      "en": "「Fine. A splendid attack.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5219": {
      "repository_source_sha256": "146a03b5f5814e50e10923fb44aeae23492febd435c5b29451db300440085358",
      "en": "「If you don't put up some resistance,\\nit's no fun...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5278": {
      "repository_source_sha256": "31ea74419f86f301d76c79bf3bfa6f0d1c4e5cdae2a3a0f7cc0923c224ed8f3d",
      "en": "「Is this your all...!\\nThen I overestimated you!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5339": {
      "repository_source_sha256": "ca38c78dd14e3626ac7c2d70ebc1d9920a363810611d293a89db72db3dd77b82",
      "en": "「This is the last time I'll savor\\na thrill like this...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5394": {
      "repository_source_sha256": "137b9969078bd41f8fb5f8a92acba5455efe229aa6e0e6be1a60e5580066ebe1",
      "en": "「They really mean it today, huh...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5433": {
      "repository_source_sha256": "a722b643d027ce22a9b5b8332da34da69fdccb0cde4ad0ec77411c53c4dba53d",
      "en": "「The time is almost here.\\nUntil then, I'll humor them...!」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:5496": {
      "repository_source_sha256": "4b5ccfbeb3c8f050275f15aa27a72de1c1fddf631432a78f31cdc2bfa9d809ef",
      "en": "「You got me good, $$相良$$...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5527": {
      "repository_source_sha256": "d665325e9977957f4b3589a890b1e0341a4f8388ca80aef2be6a86000cebe7a3",
      "en": "「You and that AS...!\\nI underestimated you a little!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5578": {
      "repository_source_sha256": "a7b34ee85f859facb1d1d208c0d46616ce7d4e8c10562b40104336ac0288b7c3",
      "en": "「Is this the power of will\\nto take her back...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5629": {
      "repository_source_sha256": "bf9b41d16ecafe7cf76c9edd780f40e3df9d1757e94a6efea859ad7580097794",
      "en": "「$$テレサ$$...! You still resist!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5666": {
      "repository_source_sha256": "0a2dd6c8a3e51ba4a91ac7f1eeaafd8adf97dd85c10b882db417f1f60b4412d4",
      "en": "「Big lump relying on raw power...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5697": {
      "repository_source_sha256": "f13ab25fc0058e735b7cf025fafab8d0934070ed098c2b23d0d1345dbf390e23",
      "en": "「Does it run on feelings too...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5732": {
      "repository_source_sha256": "620f6bd62cbae8fbca172a427f049841b3d0b326f4ec71ea17f7b7151c8737c3",
      "en": "「A power beyond parallel worlds...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5775": {
      "repository_source_sha256": "e45840b543fdea320a86751ccbcf69f3b8893ede9df1a624a0de277bd21eb740",
      "en": "「Tch...!\\nTheir mobility is better, of course!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5824": {
      "repository_source_sha256": "166a85c1a8d00fa7c12c6dd5c0b7b916ddf43a4d6cf181b8f9b05e7d73508d67",
      "en": "「Why can you fight\\nfor a world like this...!?」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5875": {
      "repository_source_sha256": "3eae6e1e7939c3178c2564cc6895164eca38dca8539ebd20b2f21183460dff9f",
      "en": "「You tell me to throw away\\nthe chance to change the world...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5932": {
      "repository_source_sha256": "d25e91037d24870aad1fc37126402b05c0734960ba3164c5bcb645ddb8d57f1a",
      "en": "「Ugh...!\\nPushed back by $$スフィア$$ power...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:5981": {
      "repository_source_sha256": "550d3b81d26431936564f75e4b2df0563bc5d172520fd5b52f30749b1f7ff399",
      "en": "「If I could master this power,\\nI could change the world...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6042": {
      "repository_source_sha256": "53134427e72fa8b9da088973b33caf9cee48bad6fe84fcc9f0147ebdb61468c4",
      "en": "「Enough of your games!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6077": {
      "repository_source_sha256": "522a71faa0a1d40161261540a2d38e6afb86f8a9a7d34f72b8a684b50875e909",
      "en": "「You really intend to\\ninterfere with my plan!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6126": {
      "repository_source_sha256": "8048c706fbdf63b5d1d0efa53fe84d7ac575b1de29c28a783e03c3098b69d5b9",
      "en": "「Right! If we can't coexist,\\nit's kill or be killed!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6185": {
      "repository_source_sha256": "85dc76200da9dc3def3034b9f0c5fa594b5aa788e0835d9762fac31d0331cee9",
      "en": "「Power beyond my estimates...!\\nWhat are they!?」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6238": {
      "repository_source_sha256": "4c5c33c74717c4266c65a2b2215eb5dea8ca4bec5914ff5e6bbd66f2d39ea0da",
      "en": "「I knew it. Friendship with you lot\\nis impossible, forever...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6305": {
      "repository_source_sha256": "b8f31f0a41e885630aaf7457ecfb4ed52d53718ac2e5c19389ca9b5bde8a3341",
      "en": "「All I have to do is finish them off\\ncompletely next time...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6362": {
      "repository_source_sha256": "a1b29958cbdfd670cbbb4dfc7f268ceb132719f38c10dc6eb3dd0cdbd83fbd18",
      "en": "「You're fine with a wrong world,\\nall of you!?」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6417": {
      "repository_source_sha256": "1740089cc8ab7cb41b06a341bf41a60ecf86711dc0259ddb17668001bbe4fa13",
      "en": "「If you fight to the death,\\nthen I'll take you on...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6476": {
      "repository_source_sha256": "7e6fd5ad22d1f9f2ba4a55ffad12165e7118c7addec56b4738b87e0838cf2d1b",
      "en": "「Right, you're the twisted ones...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6515": {
      "repository_source_sha256": "522ea9f5c1bf965a91353067ce5f738d389da319b5d8ae4e24f0380a18e421c7",
      "en": "「Just a little more...! If I can hold\\nout a little longer, I win!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6578": {
      "repository_source_sha256": "2db5878a3367910bb80f0dcec19a7e52c8ecd3c3a8a959a0763ae4e18da2793e",
      "en": "「$$ＴＡＲＯＳ$$'s prediction was wrong...?」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6615": {
      "repository_source_sha256": "4bbf30bfe94492cc740ce2fc9027818a23cff8b3c6cdd66b432704b4c9a2bb25",
      "en": "「Tch... That's all for today.」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6642": {
      "repository_source_sha256": "68b051411fa141ba7953f9e4adf8f0c83f4ae71bb957ebfb149028b68305a644",
      "en": "「I-impossible...! I... I...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6679": {
      "repository_source_sha256": "26e550ed1858afb1b3a9e3a9bdf66c483e4bb922472f2ce38ac98c2d8b3d92d0",
      "en": "「I... lose...!? No... The world...!」",
      "source": "new",
      "slice": "v_g298_00"
    },
    "298:6722": {
      "repository_source_sha256": "e445a92b68f0526c38772989abe12da8f934533001d7fe8ad5c824396e66b66c",
      "en": "「Quitting here? I overrated you.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:6797": {
      "repository_source_sha256": "0cb90ee51f9bad7f7963b00ba50ba4af82a509932e302825d5a8c6257434c7a4",
      "en": "「If I angered you, come at me full force.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:6856": {
      "repository_source_sha256": "980a98f615d81cc191bbe0555a55a2bac4d26c88b67427af21e4e4207a1932c0",
      "en": "「You can't stop my plan. The world transforms.」",
      "source": "new",
      "slice": "v_g298_01"
    },
    "298:6921": {
      "repository_source_sha256": "0e2ea55d205751566dc00a2dac47dae6246f3f9036818dee74f29fa9e39c404d",
      "en": "「I'll see your struggle next time. Rest until then.」",
      "source": "new",
      "slice": "v_g298_01"
    }
  }
}

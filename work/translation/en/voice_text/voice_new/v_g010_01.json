    },
    "10:5292": {
      "repository_source_sha256": "5cd146d2b2d28d39de9180dd86f88a3c7cbec5627735dd63bb74ba42d7505064",
      "en": "「Add Buster Machine power\\nto the EVA, and...!」"
    },
    "10:5341": {
      "repository_source_sha256": "d44b33189eff596d0240d52cef718871010de30d7d17749d1874e38667464a3a",
      "en": "「On top of $$大グレン団$$'s spirit,\\nI'll add hard work and guts!」"
    },
    "10:5396": {
      "repository_source_sha256": "c523e64a5ab6241febd22ecc8e9c28294bc84535a548647d029f7785fe6df96a",
      "en": "「Friendship between machines\\nlights a fire in $$ノノ$$'s heart!」"
    },
    "10:1034": {
      "repository_source_sha256": "57125f13670074465977b2de83876dd9dec3fa5f836d3164e1e645b98333f4f1",
      "en": "「Not yet! It isn't over yet!」"
    },
    "10:1075": {
      "repository_source_sha256": "1024c00a9038917cc1f7ae996a55d7b17c6e245706d383b3d81ae893e3669c5c",
      "en": "「Can't down it in one? Once more!」"
    },
    "10:6180": {
      "repository_source_sha256": "1db529b0b414e8cd73d74090054c3cf9b507d461eeb40a3253d5711d43f161d6",
      "en": "「I'll punch through at one point!」"
    },
    "10:6205": {
      "repository_source_sha256": "da1cced41c5e8ff538db83867add7e438c4288d3099584b6a2f93bfc7c4f27ea",
      "en": "「$$ノノ$$ will throw the jab!」"
    },
    "10:6234": {
      "repository_source_sha256": "37b6bdff15b1e0d0daa3f29781f15fad50d5be579abf7dd14aec856bf71d2203",
      "en": "「I'll carry out my role properly!」"
    },
    "10:6271": {
      "repository_source_sha256": "1930f7b6e1a8fd1b06ba098de8df1216eb3f8d04f0654e796b4402e22b7defe4",
      "en": "「Please aim for the gap $$ノノ$$ makes!」"
    },
    "10:6044": {
      "repository_source_sha256": "fc8c5a868384f7e3c1e837cc96867fdf4edd62097efc79f69dce13424c535c99",
      "en": "「I'll leave that enemy to you!」"
    },
    "10:6075": {
      "repository_source_sha256": "750c66a6a5943068d094cd0d4a60a8a49194515ed78e3c6b362fb21936fd26bb",
      "en": "「$$ノノ$$ will take this one on!」"
    },
    "10:6112": {
      "repository_source_sha256": "c0da20cd898612f409eeb95df2c2b19c9765ca0eac2a032389f2f31dea622bb0",
      "en": "「$$ノノ$$ will split the enemy up!」"
    },
    "10:6139": {
      "repository_source_sha256": "22dc8f13585f93c098e0fbd8a8ed8c8219089cd8fd565700d4c7e6a61cd2aed7",
      "en": "「I'll make it a so-called one-on-one!」"
    },
    "10:9031": {
      "repository_source_sha256": "c41fd913537006c58d541e56f315604a6f99fc3f947b4319fe19a2e2f1e3b2d8",
      "en": "「$$ノノ$$... has stained the name of\\n$$地球帝国宇宙軍$$...」"
    },
    "10:9088": {
      "repository_source_sha256": "a5eb933eb6353640a183e4bcde294f2de11f141b2a4b72c0681a493ee747442a",
      "en": "「I'm sorry... Big Sis...」"
    },
    "10:9117": {
      "repository_source_sha256": "dba40cdfb35b279a57ed2b3b5f53887699a9ab326e47d4851faf78e95c754276",
      "en": "「The Buster Machine... has... lost...」"
    },
    "10:8254": {
      "repository_source_sha256": "e11782325f09f8438b761a2ee9e5cc7562e1dcc9be5546b727ec3fb734fa9483",
      "en": "「On the name of the Solar System\\nAbsolute Defense System...!」"
    },
    "10:8305": {
      "repository_source_sha256": "de9807dae580deb9bfd24ce18a7dddc47aa10403d9fd89662fe7000e328dcfba",
      "en": "「While we keep fighting, please\\nrebuild and repair damaged parts!」"
    },
    "10:8370": {
      "repository_source_sha256": "28310d08d3efb338e8e54a744b40ef4ea79a652eaed77b0a7e7772f5c41734a8",
      "en": "「If a Buster Machine loses,\\nhumanity loses...!」"
    },
    "10:8425": {
      "repository_source_sha256": "d70c4f1fbf4ecb96656114548016674f5789b2be77c8818b9fefa9ec025b7298",
      "en": "「On the Buster Machine's pride,\\nI can't lose!」"
    },
    "10:8482": {
      "repository_source_sha256": "c23ea60fdc821c432a94c2f8d33658cbe28fd47603a4f33662fa951b7e5290bb",
      "en": "「No matter what happens,\\nI'll keep my promise to Big Sis...!」"
    },
    "10:8537": {
      "repository_source_sha256": "2d3d81c2144ca62ab863b8db5919221a388d06c9094b7f407088d912da9f808d",
      "en": "「The Buster Machine never gives up\\non victory until the very end...!」"
    },
    "10:8596": {
      "repository_source_sha256": "8e7452c6ebf4fe4fdf1b03c9c1483fcf7d87f72e29412f4f1c87c3777909ef1c",
      "en": "「For those I must protect,\\nI'll stand up again and again!」"
    },
    "10:8651": {
      "repository_source_sha256": "55d2ab14411945fa61604fd4ca8e025b7a214ae6149ae0b450068f5926841904",
      "en": "「If you never quit, even in a pinch,\\nthe road to victory opens!」"
    },
    "10:8720": {
      "repository_source_sha256": "80c7fb74887bc19d16e6786b2dbb2a85eb0b1cd593ba8571316c81e3d5731445",
      "en": "「The miracle $$ノノリリ$$ caused...!\\n$$ノノ$$ will make one happen!」"
    },
    "10:8779": {
      "repository_source_sha256": "55bc561eba722760d2a742cfd75110cce607d11d82504e1f6f8decf96cf60c33",
      "en": "「No matter how much damage I take,\\nmy heart will never break!」"
    },
    "10:8838": {
      "repository_source_sha256": "4bf23919287cba9890bfc1a394b1bc031694275fa46cba4e99508f4cb0a2c824",
      "en": "「Even a nanomachine body\\nhas its limits, it seems...!」"
    },
    "10:8891": {
      "repository_source_sha256": "ceca28393be6dc5629813e048062aeaaf8c1cf6a077ae18b00ddeac9df9dc4d6",
      "en": "「Even if I'm shaking with fear,\\nthinking of Big Sis lets me fight!」"
    },
    "10:7794": {
      "repository_source_sha256": "67588eb4a519237a2107f79ab5f896ee762151f714fd81a382f4e9ef597700ee",
      "en": "「I won't lose...!\\nNot while I have hard work and guts!」"
    },
    "10:7847": {
      "repository_source_sha256": "53ecfef11e4a87eb1d20e175c706f57cd6d4821f7761349b675979b14305c893",
      "en": "「Not yet!\\n$$ノノ$$ can still fight!」"
    },
    "10:7894": {
      "repository_source_sha256": "a32633644955681b8de07f89c93b2bfb4f9833e5496ee9942a28f7e728dd3018",
      "en": "「A heart that won't break...\\nThat's what makes $$ノノ$$ strong!」"
    },
    "10:7943": {
      "repository_source_sha256": "42df93fef16cf8433a8a935fa146b592185d9c1a1a31a587afac54d351192945",
      "en": "「This is when the Buster Machine's\\ntrue worth is put to the test!」"
    },
    "10:8004": {
      "repository_source_sha256": "c1d58b012ab28d48955cb0dd3b9e7b044d3759de995ba5318fd61579cfc7841a",
      "en": "「As long as people believe in us,\\nthe Buster Machine will never lose!」"
    },
    "10:8067": {
      "repository_source_sha256": "9e0ec04302d782d89b0a653034a6fc651a8bbfb5af8c031959b1d52d22217ad8",
      "en": "「Hope on my back, guts in my chest!\\nAnd a smile on my lips!」"
    },
    "10:8142": {
      "repository_source_sha256": "a95e93136f3214f1070eb38b35d8265a6d085b1f41b0ac44907682d8aed30828",
      "en": "「If you're afraid of pain, you can't\\nbecome a true Top...!」"
    },
    "10:8199": {
      "repository_source_sha256": "b3ecb24f17afa574786899b4e972daf346642a66af94ea1000e6d7740b298ce8",
      "en": "「Just like $$ディスヌフ$$!\\nScars are the badge of a warrior!」"
    },
    "10:7028": {
      "repository_source_sha256": "735a4c0069d82fda67e52251d5b6ca21963637330fe5fe2c21029ea2c5ab6e9a",
      "en": "「Space monsters' hits don't scare me!」"
    },
    "10:7071": {
      "repository_source_sha256": "ecafd02c473e0279dfb9c54db4ce3d44fcb470ae26988e75939d99223d8065bb",
      "en": "「I'm fine now, but we must take care\\nnot to get surrounded...!」"
    },
    "10:7128": {
      "repository_source_sha256": "707f6c1fad6cd4d371a33564f480b30928b3eea736e01c1404d307cf96e056d1",
      "en": "「With past data included, I grasp the\\nstrength of the space monsters!」"
    },
    "10:7189": {
      "repository_source_sha256": "464dd71480617e862df4fd72d69bb5d60adc7f7af1e27a94cd13cc49f1964153",
      "en": "「Buster Machines exist\\nto defeat space monsters!」"
    },
    "10:7433": {
      "repository_source_sha256": "53167af8383bfbf402c3931e58dee2499714f82fdf02b48fd3ba0c9e27c2589c",
      "en": "「Attacks like that don't work on me!」"
    },
    "10:7462": {
      "repository_source_sha256": "25810458f54ec41ef62b3c11bcf1ecdd15189ff6a2e9f32c7f28cbbd4de8b800",
      "en": "「Hard work and guts...!\\nThis is the invincible tag team!」"
    },
    "10:7511": {
      "repository_source_sha256": "e50a75a91bc8a662088da1581b663c818e55044fbac50ddb49f00d3ee46366d7",
      "en": "「A wound this minor\\ndoesn't even need repairing!」"
    },
    "10:7560": {
      "repository_source_sha256": "5f5dd435a2612968791698b2418ae0448f0abdb20a15c4a15e270983455292f6",
      "en": "「That won't stop $$ノノ$$!」"
    },
    "10:7593": {
      "repository_source_sha256": "fff5dad9e06a2b1617d6b7f5de37547876e7653db0ffbd346526c75a804e847a",
      "en": "「The Buster Machine is indomitable!」"
    },
    "10:7632": {
      "repository_source_sha256": "8fad9482509e557c0280231b4c7f058226f32ab1399aee78edd4d2a294831a18",
      "en": "「$$ノノ$$'s fighting spirit won't waver!」"
    },
    "10:7669": {
      "repository_source_sha256": "820e508852a61bc2cc24147f58648142301a39feb1f8ec2393ee48d9bb8d6064",
      "en": "「$$ノノ$$'s soft skin is no pushover!」"
    },
    "10:7706": {
      "repository_source_sha256": "2d0e4737604438dc756b630dc731ee298b12a10c80d0ec61a4d13f99b4c07109",
      "en": "「Even small, $$ノノ$$ is\\na Buster Machine!」"
    },
    "10:7755": {
      "repository_source_sha256": "0aa5e1daa2d100c88e1ae2a41a210005f245a2eb246b8c0d37a383563341ab9f",
      "en": "「Small, but no one beats my guts!」"
    },
    "10:6632": {
      "repository_source_sha256": "1bdffbe9117fbb56bb3ff02243faa680a0fec5cc1ce12133b2b7179af5035b04",
      "en": "「Focus on dodging, and it's a breeze!」"
    },
    "10:6675": {
      "repository_source_sha256": "82a6ca27bb54bd418462c0cc6f96c30e0758219148bc56bc81133da3caa4f113",
      "en": "「An attack like that is useless!」"
    },
    "10:6706": {
      "repository_source_sha256": "4d9f4dc6dc598ff1f00b0d3733af9e76ee097956f176386b1b369954b24906e5",
      "en": "「Looks like I managed to shake them!」"
    },
    "10:6739": {
      "repository_source_sha256": "f6ed550e11b1dd257619424b706c4b288e90b5ebab790f756fcf003e91268f19",
      "en": "「I'll dodge as often as it takes!」"
    },
    "10:6770": {
      "repository_source_sha256": "35c1fdb170b14ce83c780b231adcdb60fa9285e9d367d7fd239711fec0d3d539",
      "en": "「It wasn't luck!\\nI really dodged it!」"
    },
    "10:6823": {
      "repository_source_sha256": "7b814bea105a9992b13e22ea9076abf6764171f65e46544c8bb523d20d35acd3",
      "en": "「Now $$ノノ$$ can see the movements!」"
    },
    "10:6862": {
      "repository_source_sha256": "ceca082a6b2917bc27ce264634f94540c94d6377afa8eddff3c1f9596421c0ad",
      "en": "「I'll float like a butterfly,\\nand sting like a bee!」"
    },
    "10:6913": {
      "repository_source_sha256": "f94a86e72e9a2c4f5a931aeed62053ecf40228d1b6051cdfa35860f174ab79ef",
      "en": "「I can turn on a dime now!」"
    },
    "10:6950": {
      "repository_source_sha256": "743601ff0261537b4a1ba076ef341b50d504684e56bb92e63d88fb6ca3078757",
      "en": "「It's not that easy to hit me!」"
    },
    "10:6985": {
      "repository_source_sha256": "a32e2de4e6159773c9d3c7396ad28709f35349b3aa16837c2822df8ed64062c6",
      "en": "「I won't let this scarf get damaged!」"
    },
    "10:7402": {
      "repository_source_sha256": "fc259efe96437988daa404da9fa4df263e6859ff41b2a4a2e8b8152ca5a39eaa",
      "en": "「A dreaming maiden is invincible!」"
    },
    "10:7246": {
      "repository_source_sha256": "c4e1fe3dbab8f32474602c68709da02c784d72cc2dc26a7a2ae4ff57b077ab94",
      "en": "「Physical Reactor!」"
    },
    "10:7273": {
      "repository_source_sha256": "e0021342adf0c18dbe611e94870eff906bcfbce217b6345d7b27bbc7eaa677d3",
      "en": "「Physical Reactor, full power!」"
    },
    "10:7306": {
      "repository_source_sha256": "81b7a2a95187dbfe83b21fac4c5dbb2bbd48b6381ba0594d16e2e2fe10f668e7",
      "en": "「If I rewrite the laws of physics,\\nthere's no problem!」"
    },
    "10:7359": {
      "repository_source_sha256": "0d8a807572d5920ba8cabca352b014d8802e79f6fe667cc10070848999accc89",
      "en": "「Burning spirit negates even impacts!」"
    },
    "10:9158": {
      "repository_source_sha256": "f09983e96645081e5c363747771ddc93d50a6c0f06d69336523ef439c1dec499",
      "en": "「Warp! Distance can't touch our bond!」"
    },
    "10:9227": {
      "repository_source_sha256": "e083513cfb6102d1fb53e71533e3c2e38598b660a68e82a7cd9f9170f0d922d1",
      "en": "「$$地球帝国宇宙軍$$ Solar System Direct Cover Unit, Sixth-Generation Interstellar Decisive Battle Weapon, $$バスターマシン７号$$!」"
    },
    "10:9314": {
      "repository_source_sha256": "0f7b46a760b211863b89a03c57a2702bfe40be150f46edc46723273f433fca4f",
      "en": "「And then...! $$ノノ$$ was truly a fool!」"
    },
    "10:9355": {
      "repository_source_sha256": "86ab0ff4c8f2a650886df0571df46c11feeb866827938faa03e9184d9a1f312b",
      "en": "「Buster Machine or not is irrelevant!」"
    },
    "10:9410": {
      "repository_source_sha256": "506f9378ace6f3722432c23b73eb05dd0d02bd1f3d2e2574e1e66b7bb397b3fe",
      "en": "「Anyone who thinks 'if only I had a Buster Machine' can never be a true Top! Because...!」"
    },
    "10:9511": {
      "repository_source_sha256": "0d9b809f3cae86c7cff688aa41c9caaf5848bec341a91bbea7f6bc124fa21fb4",
      "en": "「True power is with those who trust themselves to the end!」"
    },
    "10:9572": {
      "repository_source_sha256": "f73924bd3e0b18702ab974e94b1edb232b5db17501c99dbc738296186261b2a0",
      "en": "「Surely, a real Buster Machine pilot...! A real $$ノノリリ$$...!」"
    },
    "10:9643": {
      "repository_source_sha256": "1ec5a183d529930b36bc87b0ed92afa98c9f52613aaf5c0d8b33cbe6b345165e",
      "en": "「Because they carry a Buster Machine in their hearts!!」"
    },
    "10:9701": {
      "repository_source_sha256": "6c968928fb9b0921c91c6f1b5b21022f4d112cc6021744aa7173cfa65a2310d8",
      "en": "「Yes, Big Sis!」"
    },
    "10:10018": {
      "repository_source_sha256": "dfaf2a2178e0fe5162ff64442b5ab6f1d3a1d9f058ccd2ef77b0535b320f5c51",
      "en": "「This is $$ノノ$$!」"
    },
    "10:10033": {
      "repository_source_sha256": "ce12afd3a350ca0efbada4e602e21e930eafc911a1b39611e18399bce71e5195",
      "en": "「Big Sis! Let's do a Strategy Class too! Because! The famous $$ノノリリ$$ Strategy Class saved countless players with limitless knowledge!」"
    },
    "10:10178": {
      "repository_source_sha256": "49516c6d1bc927634f0dbf54484cc39e6dd902ad673c977300137bedb4a9d6c2",
      "en": "「What's that?」"
    },
    "10:10199": {
      "repository_source_sha256": "4fc95669cdc545ee724a5882d32cac787b3487663f1d76bb09c655f63bea5d9b",
      "en": "「Bye-bye!」"
    }
  },

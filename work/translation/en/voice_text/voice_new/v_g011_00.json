{
  "schema": 1,
  "rows": {
    "11:2860": {
      "repository_source_sha256": "df1999c87ca1b4fe249f568685232c8f08214559f2f4072a90a601012bc17cd5",
      "en": "「Let's stir things up a little...」"
    },
    "11:2897": {
      "repository_source_sha256": "dcc5734415cecdc48ce263f059671110e07325e2d589d403941b4d8f57877748",
      "en": "「Sorry, I can't let you through.」"
    },
    "11:2934": {
      "repository_source_sha256": "c90afe92842ee01adef17d8f9af4524fc9c88cdeba3f3c68cd8653e58bfc0257",
      "en": "「Slack off and I'll hear about it...」"
    },
    "11:2973": {
      "repository_source_sha256": "2613533fcdb7509962412a22b659467ff205469ca7804485a28c72dd658bc416",
      "en": "「You're an eyesore.」"
    },
    "11:2986": {
      "repository_source_sha256": "11cfd1a119e8faeee35fac293b489449f3d003cdbfaeab874a1e952d8e2813fd",
      "en": "「Let's try this one.」"
    },
    "11:3009": {
      "repository_source_sha256": "37d6e108fb089ebcddfabdaad16e537f24b770dc5b16b7093ac0cda6a70c0551",
      "en": "「Get me a little fired up, will you?」"
    },
    "11:3036": {
      "repository_source_sha256": "529d68d3d0b4415732fddb73e248fbf57f8d35ec134d85906835589eb3ec00f1",
      "en": "「How about this...?」"
    },
    "11:3057": {
      "repository_source_sha256": "a3dba187402b88e95bdfcf124eb9ebf350ecf1e2b0d4708328c328d053e1f7fb",
      "en": "「There's this way of doing it too...!」"
    },
    "11:3086": {
      "repository_source_sha256": "ea5df396c9d6dece54cc3d0bcd4fd5c69e69c3ddd465c5784c898bc38821f467",
      "en": "「Time to get a bit pushy...!」"
    },
    "11:3109": {
      "repository_source_sha256": "82cb508dd4195eb336790aa2f0f2442c5f6688233d16bf3b1af77b3ab84b72b0",
      "en": "「You took the bait...!」"
    },
    "11:3136": {
      "repository_source_sha256": "d3752dd9cdd9b885936f763a7cf7e1c290a8e84937eedba0b04c4ddfb566353e",
      "en": "「You might make a decent playmate!」"
    },
    "11:3396": {
      "repository_source_sha256": "416e17090bddf4f188a813267c7b18c2684a7cb14d2ab27e383ef8b50f943cbc",
      "en": "「As I thought, masked types\\nare never any good.」"
    },
    "11:3447": {
      "repository_source_sha256": "2580b8d565b638378ee1ca0e5c0a6a9a44513a5fd49f2a71748013fa809e2513",
      "en": "「Strong because it's hollow...!」"
    },
    "11:3480": {
      "repository_source_sha256": "dd1e9811baba3c5dc0256dc9f2e1eee0586da3c1cd0f59fa8c94855785280bb3",
      "en": "「A stubborn woman isn't cute.」"
    },
    "11:3507": {
      "repository_source_sha256": "9803fc29e51c23e268f8c285da578fb0921ab3d2f40398bc43a051af88d69df6",
      "en": "「Spare me your selfish impositions.」"
    },
    "11:3544": {
      "repository_source_sha256": "f5b038726c3404f11bf57041cfb9e898d30b682b2b68e08a4aba879f0aae8c60",
      "en": "「You're just like $$シャルル$$.」"
    },
    "11:3575": {
      "repository_source_sha256": "ab3ae9d00f35f675bb4d1b807658d1de6729f5f98249c16c1eb97acab8af6d45",
      "en": "「This is what excess power does...!」"
    },
    "11:3614": {
      "repository_source_sha256": "3760ffcc8da77151794605e44d593747fba25d2b7b623699032a6eeddda8d7b0",
      "en": "「You again...」"
    },
    "11:3631": {
      "repository_source_sha256": "6e22e7427e9de6e1f3dfef128af043bcdad8a5976da233f48f3cc78c9bd11115",
      "en": "「I'm sick of seeing that face.」"
    },
    "11:3654": {
      "repository_source_sha256": "2a8ccdd92df129b66edba17626e725f87b00fc5f5e98b688f8edc15b45f88012",
      "en": "「Let's see if you've grown at all.」"
    },
    "11:3691": {
      "repository_source_sha256": "d2c3180a9be9c1a902817da8251bec343f6b3e91fc8f55c4544c8e7fd86fe4cf",
      "en": "「Little boy trying to act tough.」"
    },
    "11:3710": {
      "repository_source_sha256": "3f40b2aab4659a320c44c74576fae442bb9fa625e71e2a2be7f68a43fa42a7d8",
      "en": "「Desperate men are a turn-off.」"
    },
    "11:3741": {
      "repository_source_sha256": "aa710769be68bb8d14ca68fae0eaf5f696a8194887fd13031f023180d1672f70",
      "en": "「Too many of you. I'm sick of it.」"
    },
    "11:3772": {
      "repository_source_sha256": "0ea95eb792241409f1fa0c3cdb69f8be8912ab196fb4b59c94aa5c0d4b133c7e",
      "en": "「What is this feeling...?」"
    },
    "11:3799": {
      "repository_source_sha256": "9dfc6680c601fdc67ea21aba0d5c71dbccbf738a60b8843d7eaa342f1e6523d2",
      "en": "「Dialogue, huh... Not bad.」"
    },
    "11:3826": {
      "repository_source_sha256": "c5f7b0d7ab60ab5671cf1aec59641ffebd17f82b7ef96a695428dfaa56723211",
      "en": "「I can't talk, but you're shady.」"
    },
    "11:3863": {
      "repository_source_sha256": "43a40e3965caddba2cdf000082b29d49ac9caad4e54ba1803b4f586e9d68d8e1",
      "en": "「You seem to have your own purpose.」"
    },
    "11:3896": {
      "repository_source_sha256": "9e8ed248b20eb5156c33f30af581face34a72367a1c05fd541907b46bc6a53a6",
      "en": "「I admit, this pains me.」"
    },
    "11:3917": {
      "repository_source_sha256": "ea0aa73b0021306bff82a551c8a977f64b52305ad1096669cf60c7cf1cc03475",
      "en": "「I guess I have to stop that unit...」"
    },
    "11:3946": {
      "repository_source_sha256": "ef90e9266979340a830c2b5721414d22003abf39a0513302302e98a86b5111f4",
      "en": "「You think you've gone beyond human?」"
    },
    "11:3971": {
      "repository_source_sha256": "8a1971528cd943a2e1606f713f24ad0e91cf3c65104c236f043e8189e9e0fac3",
      "en": "「No mercy for those who've strayed.」"
    },
    "11:4012": {
      "repository_source_sha256": "a2d70132ec711391a4aa5b16f1ae8a38349ad83a6a38c6e2bfede7c7d2e7b465",
      "en": "「Me, made to fight an ace. Imagine.」"
    },
    "11:4055": {
      "repository_source_sha256": "cd4e96c73b14b65f9c84baf9a46d5267723c089c77841ef80abf5a2af3bc0385",
      "en": "「Bigger prey is better.」"
    },
    "11:4086": {
      "repository_source_sha256": "e2c32008d3561e4d76ef40af0ac15ee494565fd4de35d9c9262c30926b38bd74",
      "en": "「Don't think you can stay\\nso high and mighty forever.」"
    },
    "11:4137": {
      "repository_source_sha256": "d278b31d0784466bd972e042033dcaa613f988062a71ad41afdc45b598adf970",
      "en": "「You...\\nEver heard the mighty must fall?」"
    },
    "11:4186": {
      "repository_source_sha256": "b200130a105847f692b06db10c7158a9411ef9a0bf82dc90bb3b24d455a3d5ee",
      "en": "「You picked a troublesome planet...」"
    },
    "11:4219": {
      "repository_source_sha256": "c6fb4680cf0a2c073ff750310572cb0f1be23c112a2cb7bd42b5035213790e4d",
      "en": "「Mess with Earth and you'll pay.」"
    },
    "11:4252": {
      "repository_source_sha256": "78ac0a4c974d1be4046f9fc7485b85a4f0049efda2726f3ff72cc8b74b8dc1fa",
      "en": "「Long trip. Well done, $$サイデリアル$$.」"
    },
    "11:4295": {
      "repository_source_sha256": "69d3b99baea1f677328aaf94d391f5f79d43d832e8dbf66dc9c4e18ee80fe3ac",
      "en": "「I don't care for parlor tricks.」"
    },
    "11:4334": {
      "repository_source_sha256": "20228bf9f7fffee736a911a136c1c1ec1857a5e69d1012c00929a628ca18fe76",
      "en": "「Stop using that shady power.」"
    },
    "11:4373": {
      "repository_source_sha256": "1279e71613bed4557c662d1afce66d280152b50b03652bb9aa11a24fc61726b2",
      "en": "「$$スフィア$$... Tough one.」"
    },
    "11:4398": {
      "repository_source_sha256": "0b31816b1be0925fea52570c3e6e2519c455b8e73bb3b8c2741cca7d4e72983f",
      "en": "「A false god...\\nNot a pleasant sight.」"
    },
    "11:4453": {
      "repository_source_sha256": "0a3d8476aa28e8242309e4d6887bb4f4b8af331547d86825f5b0399a9bb16722",
      "en": "「Why not act like an emissary of God?」"
    },
    "11:4494": {
      "repository_source_sha256": "91d53e306d9e8ab405bbe13f33d4dc15688243f627ba224d4a1de7322a6f593d",
      "en": "「Fun. The mastermind behind it all.」"
    },
    "11:4535": {
      "repository_source_sha256": "8fc8c3a4e7ac52a79efbf32bbd17a7a94cc777aad7cc261970b0c496c9e2264a",
      "en": "「I never did like\\nthat self-righteousness of yours.」"
    },
    "11:4586": {
      "repository_source_sha256": "b26b86a21285fd4d15f919002373041cf9ffd69eb9ab895a42939cf38decc2c8",
      "en": "「In the end, you're just losers\\nwho wagged tails for the strong.」"
    },
    "11:4637": {
      "repository_source_sha256": "2db83148d99016337cb41cd268ac6ccbd7822abe7c86e2041b465cfc13bbc393",
      "en": "「False god's servants can't be saved.」"
    },
    "11:4670": {
      "repository_source_sha256": "b0fd3b77ed8da7a2dcda376e38d06e5333257faa5f615449fcdb8f1104c3452c",
      "en": "「$$アサキム・ドーウィン$$.\\nI'm sick of your face too.」"
    },
    "11:4719": {
      "repository_source_sha256": "4ee55ce73b9cff025f2e741a91beff20fe68ad4e8ac5d82fcfc3054710c89244",
      "en": "「Neither of us seems able to die.」"
    },
    "11:4756": {
      "repository_source_sha256": "bdb3923da6056cdbc4f555602d9bf7d60d5ffd3a128821a4be6e66514347e3be",
      "en": "「I came all this way.\\nI'll give it everything.」"
    },
    "11:4805": {
      "repository_source_sha256": "377a35e6e5ce4fd29f1e1c4bb6e585d3dcd3a605f3dee873b5d8e2e7e2d07f50",
      "en": "「I've seen it...\\nThe moment human will forges fate!」"
    },
    "11:4868": {
      "repository_source_sha256": "0fbb080cb49d567adc0e86a4750923153192bc0cb19803fc8f3b23f64a7be5ec",
      "en": "「$$アドヴェント#pilot$$...!\\nI have no intention of pleasing you!」"
    },
    "11:5138": {
      "repository_source_sha256": "f9e78ddd009de0f4b5240fea15eeeaed053093081416af758c08149fc0b6c55c",
      "en": "「Now then, it's my turn.」"
    },
    "11:5161": {
      "repository_source_sha256": "0ec79457daa7c1cfeb96fa7aa9231a3798d6f5723bdaf2df2dafb819b33184dc",
      "en": "「Don't be shy. Take my attack too.」"
    },
    "11:5198": {
      "repository_source_sha256": "62105650e3ae75d6fc878ec10aff168fb611efb55e915cfe5bdb4596511050ba",
      "en": "「Only you attacking isn't fair.」"
    },
    "11:5233": {
      "repository_source_sha256": "f358fceba568325ee795c95fdc5061f277ee041ba1734c76e4d5337ab77856ce",
      "en": "「Naturally, I hit back when hit.」"
    },
    "11:5264": {
      "repository_source_sha256": "0e7fec1acd2d363306163081df301a7a53fdb2568f6d0af8689e451a00cf2170",
      "en": "「Do I look the type to let it slide?」"
    },
    "11:5295": {
      "repository_source_sha256": "9d2f839c9217af55d0ee666925afb99404858485d58f07ddfc96d5f4bb934b92",
      "en": "「You knew it'd come to this, right?」"
    },
    "11:5328": {
      "repository_source_sha256": "ce1c82e6d4f0a6abd2e8d8d5f9cfacce084403e5feedf43e5cea395ae4ee93fa",
      "en": "「Don't need any help?」"
    },
    "11:5351": {
      "repository_source_sha256": "d334c74f48bf442f46fff0039e04bc1dda0b32ec827bfcac51ea3db5eef5e6da",
      "en": "「Let's cooperate for once.」"
    },
    "11:3342": {
      "repository_source_sha256": "204dd229dce174699a840191eaa50f5cf0be46282570b15ac102c44c224e6163",
      "en": "「Still not enough?」"
    },
    "11:3365": {
      "repository_source_sha256": "a2b0d2f9047bcef47d1a8c97b84c34819404760f65691a52dfbded82e1e83db4",
      "en": "「Well, you're wide open.」"
    },
    "11:5542": {
      "repository_source_sha256": "8f8276da0aa74869c6cc731ab6b987a19e2a01fb5351e1041ff8899e4ad9b75e",
      "en": "「Planning to use me as bait?」"
    },
    "11:5569": {
      "repository_source_sha256": "2c92b37e749cac708b5d5ac0d51ada026db2945ad5bc2ce07c4d17790622dd96",
      "en": "「I just need to pin them down, right?」"
    },
    "11:5600": {
      "repository_source_sha256": "8780f42d640a00e3ea0f83076546ab610183650fbef33f30a7043d9866f5a110",
      "en": "「I'm not your maid, you know.」"
    },
    "11:5633": {
      "repository_source_sha256": "e67ddce9726ef46eaf211b24e72567cdc51f96e0982c55322b6e076e78ef0046",
      "en": "「Got it. I'll go first.」"
    },
    "11:5440": {
      "repository_source_sha256": "c1247cecdaa581307ee7bdf3fcc5de3cf460d14b30dc8956a7b8ec14bcd38643",
      "en": "「One-on-one puts me at ease.」"
    },
    "11:5463": {
      "repository_source_sha256": "e25660abde0c895774fea79e575198f04d225a3b25c9815166ccb93cbcc0dd89",
      "en": "「Don't you slip up either.」"
    },
    "11:5486": {
      "repository_source_sha256": "15069acc560e72d5496ac6e59f66104847d632e1fa8669c4bb318d4213343e4a",
      "en": "「You say that so easily...」"
    },
    "11:5517": {
      "repository_source_sha256": "315d7041f12f75c1ca03c1484a9c5d2c00e8713d4657b525f2b1560da68fdec1",
      "en": "「I'll do it my own way.」"
    },
    "11:6369": {
      "repository_source_sha256": "2a89ca76140ae112e6ff926728c92857ed88909f013cf45147209137323f1bb9",
      "en": "「Sorry, I'm heading back first.」"
    },
    "11:6402": {
      "repository_source_sha256": "78e67578e6847715838131a64953673c159e9ddd606564a49c0b0edf8a063a9d",
      "en": "「Ngh... Didn't expect this much...」"
    },
    "11:6211": {
      "repository_source_sha256": "a8b3be1f888f58e047f9d677acad4e5f6bff95559915bed04947c46e3f3364a0",
      "en": "「Not good. They have the upper hand.」"
    },
    "11:6242": {
      "repository_source_sha256": "f23e69b5f40ceb2576001c646d15c6a01fd0e53df5c15b55e0ad4aeb54d317d8",
      "en": "「I need to take some action...」"
    },
    "11:6281": {
      "repository_source_sha256": "05a14321acd381441e7d1b2ee5aa434ed1d92494e08c4bae24510a222e5f4cfd",
      "en": "「Once I'm on the battlefield,\\nI'm ready for what comes.」"
    },
    "11:6332": {
      "repository_source_sha256": "3ab296f5bd9bf878d533caf4334514db864a4ac6d5cf14df2525f331be410a2f",
      "en": "「I'll struggle until the very end.」"
    },
    "11:6095": {
      "repository_source_sha256": "17e3c121d0f878fc36daf9088e365d5fe2b3bf2099c0aebfb3e550c606916c5f",
      "en": "「Time to turn the tide...」"
    },
    "11:6128": {
      "repository_source_sha256": "11a9f46a1bb1b85ad3b7dddb8572cca9f0401cf4f950e43a81fd7043e9ce7da4",
      "en": "「Oh? You've risen a bit in my eyes.」"
    },
    "11:6153": {
      "repository_source_sha256": "e1df61c77efbf6968b4eccff50ae213a6276f60285182b5ca6682bb68c2b57e1",
      "en": "「Well, you're better than you look.」"
    },
    "11:6190": {
      "repository_source_sha256": "2371759d6b5b08214aeb682bc739531619e494da851487a5ee5df4be57b6a8d5",
      "en": "「Aren't you overly familiar.」"
    }
  },

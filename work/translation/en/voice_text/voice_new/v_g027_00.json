{
  "schema": 1,
  "rows": {
    "27:0": {
      "repository_source_sha256": "0a05dcbcd4c755e8aaf63bc6fab337f563e78a222caea7061b10a55522526d92",
      "en": "「Well then, let's begin.」"
    },
    "27:21": {
      "repository_source_sha256": "00eb1f1aec44b4419535e5deed3a59ba01b74cb8a34d21a84ae4368bc102a334",
      "en": "「No escape... for you, or for me.」"
    },
    "27:56": {
      "repository_source_sha256": "bd6dc4756927285f8e7fd0c44fde9e24b88ee16433518b7c28791eaccf7538cf",
      "en": "「Hunt, $$シュロウガ$$.」"
    },
    "27:77": {
      "repository_source_sha256": "c969adaf53fccb3a0fc1cbd0a6f7a17907885fdbf17bac265d220c990788aff7",
      "en": "「You and I are both sinners...」"
    },
    "27:102": {
      "repository_source_sha256": "46c4f5adc82684cb9d22c77652489408b397f92e87c4db6b6fd30b824d520258",
      "en": "「I don't care who you are.」"
    },
    "27:133": {
      "repository_source_sha256": "e218c38bf64301216c63f8bf91b4211c579e6bb0697e3b48f3011319bf2b06f9",
      "en": "「What road have you walked?」"
    },
    "27:164": {
      "repository_source_sha256": "c67f022ab76679672aab478b5530d540561cad1ab375307d9d0f77222c891475",
      "en": "「What will you bring me?」"
    },
    "27:199": {
      "repository_source_sha256": "4c480997f6049cc58bd1cd5c7d9a9b7fd4ed9cbaee9433e40fc5aaa9013467de",
      "en": "「The flame of your life flickers...」"
    },
    "27:1766": {
      "repository_source_sha256": "55e9102b315e48dc0d600b78d1a0e66803fab47e2ab3d13aadec79306f1266b9",
      "en": "「I want your soul.」"
    },
    "27:1789": {
      "repository_source_sha256": "db82fe7bd2cb1e60766255715769e8ea6add50eae6b0a45c7332ffd358dd1b51",
      "en": "「Do you laugh at how base I am?」"
    },
    "27:1818": {
      "repository_source_sha256": "3bb81226fdf76b421d70cd7d4ba089c7185b2ea570327657094781ba28ed2c27",
      "en": "「Cursed wanderers...\\nThat is the name for you and me.」"
    },
    "27:1873": {
      "repository_source_sha256": "21345b889ba2577e760f36406b110a483eab2a7ba512723903463b750f97c95b",
      "en": "「To poor souls branded with $$烙印$$...」"
    },
    "27:1906": {
      "repository_source_sha256": "56ebd0f6808cf4216901f80bdb1275c32025308d64609d95797f23aaf24a2605",
      "en": "「Is it you who seeks? Or is it me?」"
    },
    "27:1939": {
      "repository_source_sha256": "d17e31dfa3cb261dce0b558290832e2f9f7b687a47c0dec93be56916ca925e65",
      "en": "「Tell me... where causality ends.」"
    },
    "27:1976": {
      "repository_source_sha256": "50d52266a66bb29747b6f538c8d4cabada2184053c47aed0e2e9e8538968b1eb",
      "en": "「The end of myth... Where is it?」"
    },
    "27:2013": {
      "repository_source_sha256": "b4186b323fd28aa878ca9e377e8757f18b6d96648f053f42b7ed319867a497f0",
      "en": "「This power grants my wish.」"
    },
    "27:2046": {
      "repository_source_sha256": "0a44b8a9bcbd187d7db413f60d152e5913e2de20efef94bf1603c71b5dc96df8",
      "en": "「Four $$スフィア$$s... With their power.」"
    },
    "27:2081": {
      "repository_source_sha256": "d7a565a614e8d85e7db005fe8f4c44ee74a5157d69fb0c410366b8313ecca463",
      "en": "「Behold...\\n$$シュロウガ$$, stained with deeper sin.」"
    },
    "27:2136": {
      "repository_source_sha256": "18f4b5b6b74e08087cef3b731fb8f6e062c51157de314e2194b34c6d94c51a84",
      "en": "「Pathetic, using the power of $$太極$$.」"
    },
    "27:2179": {
      "repository_source_sha256": "b6c84162b62d0e98ac354a688cf9c471718b27f89bf28d0a2071ea4e247e956e",
      "en": "「The power of $$源理$$ torments me.」"
    },
    "27:2204": {
      "repository_source_sha256": "039154b91b717f6e38f93b441d2b5b981c4f6ee5d801f44b1790204f97abfeca",
      "en": "「Even endless travel has a dead stop.」"
    },
    "27:2239": {
      "repository_source_sha256": "8d79b8e7479fbfae19cc673502f3596e791f7c2e4c76058cbf3ae66dab6b9ad0",
      "en": "「This is where it all ends.」"
    },
    "27:2264": {
      "repository_source_sha256": "1be906f17d3cce6dc3d3947e169c5503b9f37213eb7b49104c31774271d0fa97",
      "en": "「Dreaming of $$無限獄$$'s end.」"
    },
    "27:2293": {
      "repository_source_sha256": "eafd2986444453da09a7af4ef11122eac3bd0f50fb8e60f5172cd31507fda92e",
      "en": "「The Heavenly Prison...\\nIt is this dead planet itself.」"
    },
    "27:2398": {
      "repository_source_sha256": "55df884680df28da494ebed073f0fcd45853a6f3ea161fa90be02b83c3acb8f9",
      "en": "「Moonlight lights up the dark night.」"
    },
    "27:2429": {
      "repository_source_sha256": "5f5063545fd00bce51617e01aa02fed75cfc594020042a68aa01726a758911fc",
      "en": "「Sunlight doesn't suit me.」"
    },
    "27:2454": {
      "repository_source_sha256": "9fbc5531cc1b4972e843ab30edf861cb6ed6f8a5eb75fd7ad4073974ff48e0e7",
      "en": "「What hue is the future to your eyes?」"
    },
    "27:2495": {
      "repository_source_sha256": "c61e410fb3806db17a33b2442d034c86a1b30bf1d9137846615af93fe9781437",
      "en": "「Light and dark melt together in you.」"
    },
    "27:2524": {
      "repository_source_sha256": "d9f3056a6ce02616bdded95b8fbe71b9cf9a9a03c9508a24da2b1be4c6f14864",
      "en": "「Beings not allowed to die...\\nYou and I are the same.」"
    },
    "27:2573": {
      "repository_source_sha256": "ebe844e1bcdbed210a207b5cafd35f64159f5270ff87949b90e19c22c210e7e7",
      "en": "「At $$シンカ$$'s end, what do you see?」"
    },
    "27:2606": {
      "repository_source_sha256": "0c292e721e0f1c09fa42779243b47f976a23d307a430b4e9b0f3500f5e857f42",
      "en": "「Fire's civilization led you here.」"
    },
    "27:2637": {
      "repository_source_sha256": "ca0776b88a5ca6f640ab88583be67ce8af1a2b2450648087afeb06e0bb72e125",
      "en": "「Feelings to power... Lovely, cruel.」"
    },
    "27:2670": {
      "repository_source_sha256": "e6b2c4ca3e5224c38be29957f4ce423101ad0474d786847fcfa1f3759379147d",
      "en": "「The beast's blood begins to thirst.」"
    },
    "27:2697": {
      "repository_source_sha256": "8d2632f8b346faf0f29fed0b0cfb6d5fd96f3469b95e0118fc37e29038e19424",
      "en": "「$$始原の特異点$$... What can you do?」"
    },
    "27:2734": {
      "repository_source_sha256": "7d63ecd8140d8feba18fac80d8923c8c748cdcb0868fab595f9b74fb8904ca2e",
      "en": "「I have no need of your song.」"
    },
    "27:2759": {
      "repository_source_sha256": "435850c301826df08288cf632e5a5daece1c71f6da63b6f1831b284dbd1a2e80",
      "en": "「Even gold wings can't cut the dark.」"
    },
    "27:2796": {
      "repository_source_sha256": "79e5050f83544ab6e256d0f691cb00b8536436d1bb88a99554e0e54f4f6673cf",
      "en": "「Some dark your light can't reach.」"
    },
    "27:2829": {
      "repository_source_sha256": "5cc1cc6f557172355ed74c9ae9dac5e5fdc90c899a8096a16548d5de5331d52b",
      "en": "「On the day all worlds end,\\nwhat will you see?」"
    },
    "27:2882": {
      "repository_source_sha256": "418c40506552d3874896ca50e869cedcbbbdd2e72ac6ba78fd01ed58571fe68e",
      "en": "「Earning daily bread is people's joy.」"
    },
    "27:2923": {
      "repository_source_sha256": "3815766052a9b022e7f6807b5627a5cf599f01c290ac55a9f348deb1108f1d84",
      "en": "「Won't you obey God's will too?」"
    },
    "27:2952": {
      "repository_source_sha256": "6d2ea10f3fdd71e740ddf5c519ea6976f8600fc369ef8779ff86746d709b4aac",
      "en": "「Past sin and penalty, you're here.」"
    },
    "27:2991": {
      "repository_source_sha256": "eb8e91b1b510099a65a8745bbd5dc15153094ed17680882d3a3d252ad1ce60ee",
      "en": "「You're treading forbidden ground.」"
    },
    "27:3026": {
      "repository_source_sha256": "9eba5a80dbc3473ce50f75f79b99b10e16704c172fc38b2923c4303c92b80719",
      "en": "「Are you... a clown?」"
    },
    "27:3049": {
      "repository_source_sha256": "b22d7d37dd4fb2b192abf370e4db7f7c00e73888b04e41028179657ded1a45b8",
      "en": "「Fall with me, Mechanical Angel...」"
    },
    "27:3084": {
      "repository_source_sha256": "8b7ac64eef901d63d7e93d64a698da8c06d0cf97e7620eb125ee49d41147dbdc",
      "en": "「Can your fire burn up my causality?」"
    },
    "27:3127": {
      "repository_source_sha256": "05997f3372479d378a0c8ac9ff7149c224872e2e405c4b146a9fcb6d07de89ad",
      "en": "「A puppet whose fate is set...」"
    },
    "27:3156": {
      "repository_source_sha256": "705b04a1e69f2cbceae7e9f692d67ee426231059f1c7b11880b1ab8c541fc18c",
      "en": "「Beyond Tengen Toppa awaits\\nan endless darkness.」"
    },
    "27:3205": {
      "repository_source_sha256": "9511061f8ef741a753a9bab63944670eb658821701ff9f4f9f7795351ec32453",
      "en": "「A breaker of the natural order, huh.」"
    },
    "27:3222": {
      "repository_source_sha256": "96fa3c3ee117c1ad7444d697cfda3c2101914aebcd5520997ec6bbbb81749447",
      "en": "「The weight of the freedom you won...\\nI'd like you to tell me.」"
    },
    "27:3275": {
      "repository_source_sha256": "8db369df2f38f91a30cea0dd398d98126c6bae9434cc47e791b3dfad140b9111",
      "en": "「Gathering feelings into power, hm...」"
    },
    "27:3304": {
      "repository_source_sha256": "1f00c8ff46550ffb9c40a821117809a4a86508406c9186317306381b0ee2224c",
      "en": "「$$ジ・エーデル#pilot$$... Farewell to you as well.」"
    },
    "27:3345": {
      "repository_source_sha256": "c17c51bf4682d6555aa0765a01432f0e29269ccd96e82a22d08c4144acd152fa",
      "en": "「$$シュロウガ$$ and I want you as offering.」"
    },
    "27:3384": {
      "repository_source_sha256": "e16fc2b347904f007fc88bd13a012c90cb3826d348d9576bf945745fb3e9a4a3",
      "en": "「I want it, the glow of your $$スフィア$$.」"
    },
    "27:3421": {
      "repository_source_sha256": "c61d9925bb98a6931dba07346220baae5e8428540ebd6dff7245674cd8a9d8be",
      "en": "「I'll grant your wish in your place.」"
    },
    "27:3458": {
      "repository_source_sha256": "7bf5ec3535c1c1e5335b90853ddd58718570b940ba62c21eee90d644da423a86",
      "en": "「Obeying them is your sin.」"
    },
    "27:3491": {
      "repository_source_sha256": "4fe3e705459d7d24b306affc461777887eaeecfe1a2ec2fb009ee25298bb40f7",
      "en": "「$$セツコ$$...\\nYour tears are my water of life.」"
    },
    "27:3540": {
      "repository_source_sha256": "81e60f713909a583d8bba1c86907d030d3dc763a3fcb80635bab18c1bb694735",
      "en": "「I myself am your greatest sorrow.」"
    },
    "27:3583": {
      "repository_source_sha256": "0c380e7fbec683ee8236010fdc71584ab5e6fbbf716a1b0c3aee07f567933683",
      "en": "「$$ランド$$...\\nShow me you enduring the pain.」"
    },
    "27:3632": {
      "repository_source_sha256": "e53de2453aa78f3ee7d74c079b7ac9d4bc263f321d1a6d4eb758ba1c255b2922",
      "en": "「Pain makes you and your $$スフィア$$ glow.」"
    },
    "27:3671": {
      "repository_source_sha256": "15f4c358cc9edd8a365c5e8af1d42ca3a183c613170e7bfc6bad722d6687eef8",
      "en": "「$$クロウ$$... I'll break your resolve.」"
    },
    "27:3714": {
      "repository_source_sha256": "9d9739d1d8344ebd4788505c7217e97161c7d4712d6b679d251585d5f79f99da",
      "en": "「That unshakable will...\\nHow far can it take you?」"
    },
    "27:3769": {
      "repository_source_sha256": "7f7e76fcf79cdc088906aae8d331afc9f1f549263c839b0237b7167a788348e3",
      "en": "「I won't hand you over to $$アドヴェント#pilot$$.」"
    },
    "27:3802": {
      "repository_source_sha256": "25b7b81ba6efd4477b44ef59afc4a195f95808748f81b4dfd79c53a20b136b49",
      "en": "「You are $$太極$$ itself.」"
    },
    "27:3829": {
      "repository_source_sha256": "08f0d1c9d75486c95e478f26ace28c8d25574f0de29bf7a08aca3ab97b0db66d",
      "en": "「Avatar of endless destruction, huh.」"
    },
    "27:3854": {
      "repository_source_sha256": "3eefe0b91d1f90daf0b5a57e7ef1ac85b14b29a15d4a9222952342a8185f98f4",
      "en": "「Existence and vanishing... a balance-breaker.」"
    },
    "27:3897": {
      "repository_source_sha256": "6ce1b1701642f6e6c3b5193f125a89672a5bcd58a0395df32e724b97691c96e1",
      "en": "「Beating them won't stop cosmic distortion...」"
    },
    "27:3940": {
      "repository_source_sha256": "4009f42ee1996d69c6ee4b724f2caf98b6aab9e9352d8386e3d52804a38e5f58",
      "en": "「Before the universe's curtain falls,\\nI'll set you free.」"
    },
    "27:3993": {
      "repository_source_sha256": "0b60f095a2f2bd84c65419f9a5ea8296db04205d4795ca3bdf99f1e24eee43cc",
      "en": "「Fools who obey blindly, truth unknown.」"
    },
    "27:4026": {
      "repository_source_sha256": "7d3406e45f7aca4c1ac27500137447ba0f1440aee61b1ce82c1c6f715bb37569",
      "en": "「In their place, I give you despair.」"
    },
    "27:4061": {
      "repository_source_sha256": "f157152cc939f3a1edf63740d60ac7c717d12619c7156fd2e201b9f0919a2200",
      "en": "「Then, I'll give it back.」"
    },
    "27:4078": {
      "repository_source_sha256": "b942a4954c60a80d4a9c71bfa6a5e78468f88b3eac8150defcf68fff2f2ab645",
      "en": "「I must repay the favor.」"
    },
    "27:4105": {
      "repository_source_sha256": "e43ddf44f81da9748af0d480d26be3c517a53a0ef60241aaadc13391e010abd7",
      "en": "「Allow me to have a go as well.」"
    },
    "27:4130": {
      "repository_source_sha256": "3b1fae5e288c1d7de3caa608f33db0c2870f462e11571d5cfc1f22d7a07d64a1",
      "en": "「Not that this is revenge.」"
    },
    "27:4161": {
      "repository_source_sha256": "2058d87c8c959ab733bee713d2a2d7be46f7d885209c6456a3077995e236627b",
      "en": "「This is what causality is.」"
    },
    "27:4190": {
      "repository_source_sha256": "ce46e9a1d316ce9d77a02cd86b36ef7f92db64ada082e522d0f0a885b5f31eb3",
      "en": "「One-sided isn't fair.」"
    },
    "27:435": {
      "repository_source_sha256": "0d2486e97c829f4b6b6b6be26c9955f860dc1d91724035e57e9c75249ffcd681",
      "en": "「I won't give you any hope.」"
    },
    "27:460": {
      "repository_source_sha256": "aa3a6f1e9f40935d9131c3b14d322f795b3205e0c749e2e0c9bb999e926a32a7",
      "en": "「$$シュロウガ$$ craves its prey.」"
    },
    "27:377": {
      "repository_source_sha256": "915028f1e82d4cbe25f26a84f8962cc772cebde91d9c272228982f983f542db5",
      "en": "「The hunt isn't over yet.」"
    },
    "27:406": {
      "repository_source_sha256": "dee299997e3f4bea837a08611433c8d1fbf8642ab8ff5989773f7f73eb2b7df1",
      "en": "「Now, taste despair.」"
    },
    "27:2348": {
      "repository_source_sha256": "f4bee28f1e231e01b9ac4858c139f0ecce388eb756f4dd362619b063801fda24",
      "en": "「My thirst goes unquenched.」"
    }
  },

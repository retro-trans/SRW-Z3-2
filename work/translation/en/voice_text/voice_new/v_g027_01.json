{
  "schema": 1,
  "rows": {
    "27:2375": {
      "repository_source_sha256": "32de9ec5c54f98e651248d643a4fb8f16b4fb19955c5b755471badd155b81d19",
      "en": "「The torment never ends.」"
    },
    "27:584": {
      "repository_source_sha256": "30fb031e2ae6e89107be3143f773f29f5c8fd7b56aecc10e565264cade178898",
      "en": "「Go, $$シュロウガ$$.」"
    },
    "27:4267": {
      "repository_source_sha256": "223a9107f49874da0bc0665c92d80adc8ef3c968f0530fe3d6055dae5035c574",
      "en": "「I'll take it down first.」"
    },
    "27:4284": {
      "repository_source_sha256": "62db00ea698da757d1505109d89959356ff5cb7b7bb63280a4a281c8fde3465a",
      "en": "「Come in after $$シュロウガ・シン$$.」"
    },
    "27:563": {
      "repository_source_sha256": "d8604f4826c07315898df97c9fca93d395e783e0328c8d917be428452b96adc3",
      "en": "「So that's my prey?」"
    },
    "27:4219": {
      "repository_source_sha256": "a357d85f5a47c5f852d602c1711cfe2d217e581ce81a121f45e458bbe8b1e6f0",
      "en": "「I'm your opponent.」"
    },
    "27:4240": {
      "repository_source_sha256": "744888518a550ceedea604606cc16a901ba2a351742d6741525c9a4cca5e67d0",
      "en": "「Am I worthy of you?」"
    },
    "27:1757": {
      "repository_source_sha256": "f9169504a3e0484fecbebdae4e84062f1fcbaa89439d96a5f8d7df71ec74944e",
      "en": "「...」"
    },
    "27:6392": {
      "repository_source_sha256": "9ef18683824e5f0edd596ac1b43a7a392dc95a9fa3a39e7f0970d714738385ce",
      "en": "「Not enough yet...」"
    },
    "27:6413": {
      "repository_source_sha256": "1f652c1e6d8b8adeee209a9b92d4db242cdc7d3f5a1330b760b33dbb8ab53366",
      "en": "「Even this doesn't reach...」"
    },
    "27:6436": {
      "repository_source_sha256": "22e30b606ef1f62e1cca354c6f18629cd8b9011e6fd0051d221363cc09536ad5",
      "en": "「That's right... This is fine...」"
    },
    "27:6463": {
      "repository_source_sha256": "9d3a60759d3eb93753676de528ea618b6afc431da2a44497650d6535dd1fb253",
      "en": "「I am...」"
    },
    "27:1474": {
      "repository_source_sha256": "192a60a9d96988feb2948700836ec9a9c880d22e4c03597238f039620a605bd8",
      "en": "「My heart... is stirring...!」"
    },
    "27:1505": {
      "repository_source_sha256": "0bf0decc519d0f952e905b986ab7508cd013b13332212ad8851fe8c1550c21b4",
      "en": "「This pain... Heh, been a while...!」"
    },
    "27:1542": {
      "repository_source_sha256": "519d3707b3de353c5b8161523a0e02c21ec1b0ab184a9dd44c3c2f456c048899",
      "en": "「How about it, $$シュロウガ$$?\\nQuite impressive, isn't it?」"
    },
    "27:1593": {
      "repository_source_sha256": "6e767fc1322d30ae62cf4760ffaec4ca05e15b29116ad8ffe64a037cc78ebc9c",
      "en": "「Yes, just like that.\\nShow me you can hurt me...!」"
    },
    "27:1648": {
      "repository_source_sha256": "2b566f0830ab19e9b75e9d5f626dbef5f43dcdbef098d70d24d796a1bf82d9eb",
      "en": "「I won't fall. Because I already...」"
    },
    "27:1689": {
      "repository_source_sha256": "12a602b50aa4bf2f6c29f8322af727760abe1fc8d05497ebeb269d2edcc823d5",
      "en": "「Heh heh... This elation... heh heh」"
    },
    "27:1726": {
      "repository_source_sha256": "27a86b68688d3b80828bedbff3213ce25aafa32f5b96ae3d9be0ce0857760313",
      "en": "「Fall into the abyss with me...?」"
    },
    "27:5105": {
      "repository_source_sha256": "37a7cc10366844ca839987290551c104b3ab2e172c4cd352b33593cc4f938ce7",
      "en": "「I'm drawing closer, bit by bit...!」"
    },
    "27:5138": {
      "repository_source_sha256": "9b80eda1f75b50f314a98f481959908f4c42ef3fd1ce582a16b55eec03e3ea8d",
      "en": "「Being able to feel pain is a joy.」"
    },
    "27:5171": {
      "repository_source_sha256": "2e1752bd77b5487eb6babff97a166d2bdd3671f2b94a0cc1a67cec1e1fd22e4f",
      "en": "「I'm at the line of hope and despair.」"
    },
    "27:5206": {
      "repository_source_sha256": "ea22bc183514afa7523861dba749dd77c5bad0199b7af9e49fd28f9fe847ba95",
      "en": "「Heh... heh heh... heh heh heh heh...」"
    },
    "27:5235": {
      "repository_source_sha256": "9f922cd55299508629f5a901ec9aca9078287b3eb973e9eb988d971c07b79ea0",
      "en": "「The abyss waits, jaws open, for us.」"
    },
    "27:5276": {
      "repository_source_sha256": "02746ed1e56f277308792e089b9384275b72079fb396cc1d386f4b5d30500f0e",
      "en": "「To black beyond dark, void beyond depth...」"
    },
    "27:5313": {
      "repository_source_sha256": "678b8b0047c1b5f35c338d3424704cd07ff85c3461edc96f53f539d916e33036",
      "en": "「Does even the moonlight reject me?」"
    },
    "27:5342": {
      "repository_source_sha256": "bb52d5174b62b162bd3babd9c5b6c9bf7487effcb406a08367399323cd758c5e",
      "en": "「So this is the power of the sun.」"
    },
    "27:5363": {
      "repository_source_sha256": "12e8fb4f11d6c34ec2a7b3066b341cbde75bbca883ef451ad6292359774069a0",
      "en": "「A boy's feelings... how dazzling.」"
    },
    "27:5390": {
      "repository_source_sha256": "57f4917d555f8372b76be275f6c0046e6af783950fd3a4caf792b9a733003efe",
      "en": "「Light and darkness... And love?」"
    },
    "27:5417": {
      "repository_source_sha256": "5dfbfe7490d5207224e766f1514bc47b4c4a1a73a1015c3b39dda7a86252fd00",
      "en": "「You and I seem alike, yet we differ.」"
    },
    "27:5450": {
      "repository_source_sha256": "4bea755f1eebd5f1dbd25ee5e9f55dd1f9b62106f2796dd4d752b87bfcab3d13",
      "en": "「I see...\\nYou're trying to open the door.」"
    },
    "27:5499": {
      "repository_source_sha256": "a775f9559c99430fa923cb8cca31f8fda289aa43e175ea0f6b8136574787a717",
      "en": "「The human heart's light... dazzling.」"
    },
    "27:5532": {
      "repository_source_sha256": "39b19dc372a0859d6452f61b1b8bd3a1655d2bab46b4c3d49b0bd55e7052564e",
      "en": "「The blood of the beast lives in you.」"
    },
    "27:5569": {
      "repository_source_sha256": "d26bee63847a16696b16050c24c16ff62c94a283bbea1071c41171ebb80da3ea",
      "en": "「I see.\\nYou've resolved to redo everything.」"
    },
    "27:5618": {
      "repository_source_sha256": "fb413c2964a1a65717a9666a40ab334bd3831e1cd7d2fafb3b323a8e297815bf",
      "en": "「Heh, a fine song.」"
    },
    "27:5637": {
      "repository_source_sha256": "1d041e606fcd134257d54106d01dc2c675c15e4be800f96c548d3bd51f7dff5c",
      "en": "「Golden light pierces the darkness...」"
    },
    "27:5664": {
      "repository_source_sha256": "269eeaec644d830ee779cc8f4d627a26414434ddf3e7b5fc33f48018d2161b65",
      "en": "「I see. The Demon God of Light, then.」"
    },
    "27:5697": {
      "repository_source_sha256": "2b95a302d6ab0f1400d9edee09027b8932b397237908e0529b1df41f91705eff",
      "en": "「Beyond the void, beyond time,\\nand beyond causality.」"
    },
    "27:5746": {
      "repository_source_sha256": "c123628abd8eec7fad5eac74318066c1ea6054ccc4a669bd0c9a2817c66c99a6",
      "en": "「Straight to the end, aren't you?」"
    },
    "27:5779": {
      "repository_source_sha256": "31c663ac8aef679374fbf4014c0aabc9ebba64b98742025374157b82e2cc38d7",
      "en": "「You are without sin... Quite right.」"
    },
    "27:5810": {
      "repository_source_sha256": "777c867692c7b728e95878d148f15c3311d82b26a86017db1855f182d128e0db",
      "en": "「A king's power isolates you. Truly?」"
    },
    "27:5849": {
      "repository_source_sha256": "f7e62b6cea23d97fd8c1b09f3181987d44cba58cb7c1990756523b822c3985f1",
      "en": "「Your single-mindedness stuns me.」"
    },
    "27:5878": {
      "repository_source_sha256": "55efa4b451cd666c7669452f168c419c42aa4fc5780f0894ac3a01e07e9ca296",
      "en": "「You alone... I cannot fathom...」"
    },
    "27:5905": {
      "repository_source_sha256": "21f58e9b4310d455672f80ee7849c46b901aab960a9baee52a53c5dcceee9629",
      "en": "「Will your wings overcome\\n12,000 years of fate?」"
    },
    "27:5954": {
      "repository_source_sha256": "e9b0c48bd065595393cd5f016980dec906becf4896cd96aa72f53704dab4b9fd",
      "en": "「I see... A flame to burn even fate.」"
    },
    "27:5991": {
      "repository_source_sha256": "ed56a269a29e513903486da3189f769f3b725968bdbfb9d1c5b7061f2b4fe6db",
      "en": "「Are you... human?」"
    },
    "27:6008": {
      "repository_source_sha256": "731849f8640c084da8b68fa0ecaa584fa1ad7173073b2223450296fa9ff5790f",
      "en": "「Spiral to the sky, me to darkness.」"
    },
    "27:6043": {
      "repository_source_sha256": "12961792e3ce524ff5687af5bdb8ace790aa62680703e120237a4e3c0920ec7c",
      "en": "「Yes. You're the world's destroyer.」"
    },
    "27:6074": {
      "repository_source_sha256": "61866f2b889d48661018602efe43a1a7c5ae9468df399a68c884e00d103cd314",
      "en": "「Freedom... that gives you power?」"
    },
    "27:6109": {
      "repository_source_sha256": "b265b122c7ad2e7fb6d37c8ebc3dbaa8731498aa684d58a3f7604db2184e9292",
      "en": "「Good. Your fury draws me higher.」"
    },
    "27:6150": {
      "repository_source_sha256": "0728d40d064d0dd9d870d5a83606f0f612b955f9a77a6698d64ef1a8617534ef",
      "en": "「Your life's flame is blazing...!」"
    },
    "27:6183": {
      "repository_source_sha256": "1dc791ecc7ee6c26dd17ce4b83d73f407e502d9ba8829e7783f1182d68ef63f9",
      "en": "「The 12 keys shine ever brighter...\\nI crave them...!」"
    },
    "27:6234": {
      "repository_source_sha256": "7dad32aaff5bfe33b85199987dbd28e4baf7687ad3f9507e3f75753236c6deb9",
      "en": "「$$セツコ$$... Maiden winged past woe...」"
    },
    "27:6277": {
      "repository_source_sha256": "80b18c89470705cf10165fc6ffc6edbf90fa17786f21deb49dac4fd708709618",
      "en": "「$$ランド$$... Valiant, fiery lion...」"
    },
    "27:6310": {
      "repository_source_sha256": "571de4e03cb13a190275eb41999cd0c50a9165e5500dede9ad3e16c86d3e2e1c",
      "en": "「$$クロウ$$... Unbroken scale fulcrum...」"
    },
    "27:6349": {
      "repository_source_sha256": "52c4b513cc6e9ca430d40eb266a4bb89e1bfb7e815e3fac4e7a797d1630d17d5",
      "en": "「You surpass all: fate, even gods...」"
    },
    "27:1235": {
      "repository_source_sha256": "344118f49e13923b9aed9bd629529e7c334e5aa432191f92e23f97f6ac816bea",
      "en": "「My heart is still unshaken...」"
    },
    "27:1264": {
      "repository_source_sha256": "5a4a41ef37fba74762c02c4c14dfb069c7751aab92b9f691908e773b82d169fd",
      "en": "「You do seem to have some power.」"
    },
    "27:1299": {
      "repository_source_sha256": "71030fc93135cc3e5384fde5c924dccaec81b613f06878093330edddb39ad388",
      "en": "「Some of my armor got stripped away.」"
    },
    "27:1332": {
      "repository_source_sha256": "17e3bee709027bd6315706df70721fd8bf9c382edab26edd9c679c4de30d371c",
      "en": "「Heh... That's a good move.」"
    },
    "27:1361": {
      "repository_source_sha256": "fb73fcf0ba94a632357f7fbd3bb3ed444261026562a408e7579e4b3ea354c88e",
      "en": "「$$シュロウガ$$ seems to be warming up.」"
    },
    "27:1404": {
      "repository_source_sha256": "57f5fe95af0fd6766d2accf83351d0cb7b78bce1bf964106ef027b55848c6c77",
      "en": "「Imprisoned... you and I both.」"
    },
    "27:1433": {
      "repository_source_sha256": "8e6ada11f40d46b48700deb9ab4775ebae3459c32b3916893560184f6f397515",
      "en": "「Heh... Glad to meet prey like you.」"
    },
    "27:4941": {
      "repository_source_sha256": "00727a5903e9d72a9b45d5e0f514e3ac4da624b18852f64bcbda1d23c9b00032",
      "en": "「You're an interesting one.」"
    },
    "27:4962": {
      "repository_source_sha256": "9f4f07e1a471a12667ad2c10a000cc5cae162e1c9d1d570f86938895b1882679",
      "en": "「That's an unusual trick.」"
    },
    "27:4983": {
      "repository_source_sha256": "5196d7a2993608868be38f067314c2d7aca70e9f9a8a93aea5fd01cbb81466c2",
      "en": "「The darkness is still just as black.」"
    },
    "27:5008": {
      "repository_source_sha256": "6c30eb27a9626a04b7ec4398c31c4fa9b988f25a9d3a97f56192261a8efa2a98",
      "en": "「Your soul doesn't resonate with me.」"
    },
    "27:5035": {
      "repository_source_sha256": "ff48a33a294165c9e6d062c0d28bf3a51473f14939b5615e43f9f6cdcf3468f0",
      "en": "「$$シュロウガ・シン$$ is delighted too.」"
    },
    "27:5068": {
      "repository_source_sha256": "5127be3d657395e56cf53ee985a302a8f51094fc11a351ef42fe590fcb9e66ac",
      "en": "「Causality's chains still bind me.」"
    },
    "27:1022": {
      "repository_source_sha256": "5eeb604bead5b9e99bac7fd12bc6aff017d22676d9f8ba0bf0ae95a0b0cc7d84",
      "en": "「That won't satisfy me.」"
    },
    "27:1055": {
      "repository_source_sha256": "b6bbc0ed727f3255d7a8e6d2e99decd66b04b02db270623b21602397f9f91d09",
      "en": "「It's like a mere breeze.」"
    },
    "27:1078": {
      "repository_source_sha256": "52e0fb37f93d935fc56b7aa5a145ca30927b358cf9d7a92e471580997008d2a8",
      "en": "「It seems you have some power.」"
    },
    "27:1107": {
      "repository_source_sha256": "d1be1f31c3310395898fafba4a3adafe0efbdfdb42761dcac0cd9e589470bcb2",
      "en": "「This can't be called pain.」"
    },
    "27:1140": {
      "repository_source_sha256": "69bb814d4bc9715fa0df97d7b272423815c0838b51792b95ed7fc41cdcaf575a",
      "en": "「Oh? To lock onto $$シュロウガ$$...」"
    },
    "27:1175": {
      "repository_source_sha256": "5f27c034655d2db9bdbf141a6c6c8e027758a0e1fc3422058516ce58fbc25bf0",
      "en": "「So... what do you plan to do next?」"
    },
    "27:1210": {
      "repository_source_sha256": "43eef8a06b715bfe0704297c49a548c989901b7caa4760d27f92e6395749d061",
      "en": "「I shouldn't expect too much, then...」"
    },
    "27:4499": {
      "repository_source_sha256": "b4c3c40664e03540aca2a52ffd3a08778e860c389fa833ac436e79f833fb25a8",
      "en": "「You lack the factor and resolve.」"
    },
    "27:4528": {
      "repository_source_sha256": "ba141b6aa4d033e59a64712b55ade1925fe0b62e7d137ed1bc85421aae364ad4",
      "en": "「You are far removed from the truth.」"
    },
    "27:4559": {
      "repository_source_sha256": "ab4c51b4f4c2f808a99b860b9c7821b0591c06146f76bf8c9273ce92eefc5b92",
      "en": "「You just drown in sorrow, $$セツコ$$.」"
    },
    "27:4602": {
      "repository_source_sha256": "153014b87ad47d20acaf894b9c4518a01cb8080604aa26911aebd642265731d0",
      "en": "「Lukewarm, $$ランド$$.」"
    }
  },

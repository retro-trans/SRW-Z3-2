{
  "schema": 1,
  "rows": {
    "32:2171": {
      "repository_source_sha256": "90eeffbb4455efb964db884e8ef72631d7e8df60f153fd9e67245e5f01690a02",
      "en": "「You fear me, don't you? I get it.」"
    },
    "32:2204": {
      "repository_source_sha256": "99796b3d17be9c7b73bbf7bdd195e730b8ce9e7a3a25e68321a83581f1c43670",
      "en": "「You should be able to do more.」"
    },
    "32:2237": {
      "repository_source_sha256": "4de2b305efc514bd03faff6b6ab41a8efedc4ee30648fd728716ca8b8bbd85c2",
      "en": "「Will you only chase my shadow?」"
    },
    "32:2272": {
      "repository_source_sha256": "61aef11d8ede4afc755b5b4d0457d62dc300abd8d8f192bfc160a4a7472a52c9",
      "en": "「This is my strong will, given form.」"
    },
    "32:3433": {
      "repository_source_sha256": "158ff1a91e18024167ccbd8534ba892ea577745f0bb3feb79dfa64ac68579471",
      "en": "「I see... You want to survive too.」"
    },
    "32:3470": {
      "repository_source_sha256": "f2c98a86bf38887a3d634342e676d581b5c9dca1563617e07b6a723ee6cfd2d9",
      "en": "「If you think you've outwitted me,\\nthat is nothing but conceit.」"
    },
    "32:2800": {
      "repository_source_sha256": "15a72cb9dbbf9aeda23ef0f63ce159b38d34dc1cf809713e9eb9b235b1c5f9c8",
      "en": "「Without me, the world will go dark.」"
    },
    "32:2839": {
      "repository_source_sha256": "331c742c22e033d43468f2e371a4988fe0c258985c38b17d916ddfeae0f6559c",
      "en": "「Now, chant the words of salvation!」"
    },
    "32:2878": {
      "repository_source_sha256": "91ae83d9099891fdc1902a85498ac245adffb87fe417a43e6ec2cebc7e9eaf8f",
      "en": "「At my lament, even the sun frowns.」"
    },
    "32:2917": {
      "repository_source_sha256": "b7c09cc98b1fda08bacf884d7681d81c21b5fe1f9cd1e5a0c21776dd3f3b2618",
      "en": "「I'll carry your soul to heaven!」"
    },
    "32:2942": {
      "repository_source_sha256": "4b9d72e4bf12aafa4906b65f8aff6ba588013e411e765aaac719064731c7b7e2",
      "en": "「Though the sun may darken,\\nmy radiance is eternal.」"
    },
    "32:2991": {
      "repository_source_sha256": "a906ae4c84de79cdf5c337431f45f0a0cd7dd70c0b7a7cd24f1265316b616e7f",
      "en": "「I will wrap that soul in light!」"
    },
    "32:3016": {
      "repository_source_sha256": "8e3224a2662ef77e7b3dc6ea3195f8b5e5ff19cd6dd14f5fbb0c75ee6c6ee1f1",
      "en": "「Behold the power of the sun-bearer.」"
    },
    "32:3051": {
      "repository_source_sha256": "06504fdaa613d4477cf958c9e2f3b4ff9b1aa405ef6623217dcd8287262a2fe8",
      "en": "「This heat and light will guide you!」"
    },
    "32:3080": {
      "repository_source_sha256": "3ad9bd87d03e951f698f011ec8e3e73a978be2a677ed2626b4f82200d20cbce3",
      "en": "「$$ヘリオース$$ is the sun... Hope itself.」"
    },
    "32:3123": {
      "repository_source_sha256": "34da7cc2bf51beffe14ff2b43b52f1833df3794f31ecc021424db1d888cf3fc1",
      "en": "「Here, I sever your causality!」"
    },
    "32:3156": {
      "repository_source_sha256": "fe5ed8fd879ae9ee0c846ac5ca1195b5ac4dac9faf4221982d6522cb2585f2e5",
      "en": "「Light... hope... future... joy...」"
    },
    "32:3183": {
      "repository_source_sha256": "f7d660e63194d55ae4fbee8a1dfbde33f8699b8d007dcc31c030dea3912600af",
      "en": "「All of it is with me!」"
    }
  },

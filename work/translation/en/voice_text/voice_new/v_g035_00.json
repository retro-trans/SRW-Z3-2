{
  "schema": 1,
  "rows": {
    "35:0": {
      "repository_source_sha256": "44e50c4e76dea252803efac47bb681437daec14cfb5bd76d6b2dd3e814c6e711",
      "en": "「Get out of my way!」"
    },
    "35:25": {
      "repository_source_sha256": "cb2af56b0938970c72e1b58c52da69caa01683e212bdbcd7236d9769042f30a8",
      "en": "「I'll blast you away!」"
    },
    "35:82": {
      "repository_source_sha256": "fa749bd60dbca18e1fcffd7d20c1ba80ca38926ea2b6ccf71889d95c28e247cb",
      "en": "「I won't hold back!」"
    },
    "35:122": {
      "repository_source_sha256": "53ee5360b4cea95d9f651cfe1f57d2b690793eeb4f0d57c2d8477201fa805de1",
      "en": "「Thereee!!」"
    },
    "35:143": {
      "repository_source_sha256": "561ec2c2c3c219dd16e38966d8c882ff1347bde3e202b39eac464813efc150d3",
      "en": "「Let's go, everyone!」"
    },
    "35:166": {
      "repository_source_sha256": "9901f7d47f01cb27340f7b22a7a9eaa198025ef16a0473fdc635cfb9738e5c76",
      "en": "「Charging in, $$シルヴィア$$!」"
    },
    "35:195": {
      "repository_source_sha256": "8b8b872d4b80a62e8dafadaa8e666e80f60b731d8fb140ccbbd9cec68c41a7e7",
      "en": "「Sync up with me, $$シリウス$$!」"
    },
    "35:342": {
      "repository_source_sha256": "57968b461b9f7d90c203b61db05a02d994edf84f3e97074ecc7463bf2c5e1665",
      "en": "「I'll scatter the $$ケルビム兵$$s!」"
    },
    "35:381": {
      "repository_source_sha256": "12edc9492a90618178cffada96e14b32b4e262e6bd3b0af1cefdead9987b6e25",
      "en": "「I've got no use for small fry! Move!」"
    },
    "35:416": {
      "repository_source_sha256": "0a5448445c08f43f04ce75f6934dd41747834edf852f37e48ce65187fa0b6864",
      "en": "「Up against stuffy soldiers, huh...!」"
    },
    "35:453": {
      "repository_source_sha256": "d4372013cf426b339a831d615edd738c191ac23f089af79b046d4e99111ee40d",
      "en": "「Earth is ours! I won't let someone\\nfrom another star do as they please!」"
    },
    "35:522": {
      "repository_source_sha256": "360e17902c1b2e41a3ac4f3a59c7db5a8725bca16f4ad6d2bb69aa15e7fb127d",
      "en": "「If you came from the stars,\\nI'll turn you into a star!」"
    },
    "35:577": {
      "repository_source_sha256": "76b2e70e79325e93558286fa4e271c674b4819c888ccbcc7d330391d1f21e22c",
      "en": "「So you're the boss!\\nI'll crush you!!」"
    },
    "35:624": {
      "repository_source_sha256": "eedeeb345e28a8ab8c2323db13ea0f6917d2e1234523e09d1f07e08be01e03cc",
      "en": "「What a foul scent...!\\nBut all I can do is fight!」"
    },
    "35:673": {
      "repository_source_sha256": "db89c7c43704907fb18da51db6be450a16c09aa1c6b1f1cfafa40873838ef17a",
      "en": "「If you get in my way,\\nI show no mercy to anyone!」"
    },
    "35:724": {
      "repository_source_sha256": "98bb2b1f608f393834183c8dc042e5daa386844490ae1df41694666111e400a0",
      "en": "「Apologize in the afterlife to those\\nsacrificed for your ambition!」"
    },
    "35:787": {
      "repository_source_sha256": "9864ce3216877a3240f9874be8f7e5b2828086a22017eeba86b5705c033bb68a",
      "en": "「I'll never forgive you for\\ntoying with people's lives!」"
    },
    "35:844": {
      "repository_source_sha256": "9e9ea6f5c070533a92bcbf8dc72a466f37b0126c193f1795c21acf0ed5803365",
      "en": "「Right!\\nLet's go, $$シリウス$$, $$シルヴィア$$!!」"
    },
    "35:4301": {
      "repository_source_sha256": "0a834021a14adfc14d0acdb484583f6189565247890368b9e90a956fef814351",
      "en": "「Everyone! Let's do this!」"
    },
    "35:4326": {
      "repository_source_sha256": "807e615226afc5b7fbf86631d706862b297588242fdb53e3b38696f29ba34478",
      "en": "「Here we go, $$アポロ$$!」"
    },
    "35:4349": {
      "repository_source_sha256": "2cb3e33596571b5f4160e06892f3880ff81bf562f900bb9ce31adc1f8e75373d",
      "en": "「Ready whenever you are, $$アポロ$$!」"
    },
    "35:4424": {
      "repository_source_sha256": "5086389de5f00710b7f360746caddadd05f564f6f79337c0919da4034d811d94",
      "en": "「$$アポロ$$!\\nLet's settle this with our hands!」"
    },
    "35:4533": {
      "repository_source_sha256": "1706656360d001150208ed2e1eb0aeb59ecad046599defb7f882803dda4961c3",
      "en": "「$$アポロ$$!」"
    },
    "35:5001": {
      "repository_source_sha256": "c592523c323eef3461412c33830c557a15edce9ba8bcd39e3384f3503e500841",
      "en": "「Understood! Let's go, $$アポロ$$!」"
    },
    "35:5053": {
      "repository_source_sha256": "07ec5235560a37d89b91090c1836e705aee856497be1d8852cfb25fef8aade41",
      "en": "「Last battle... Stay sharp, you two!」"
    },
    "35:5470": {
      "repository_source_sha256": "466eb400c76b697c9cdc990803218a30bf530a756c9811ee709b1baf3c19ff71",
      "en": "「I don't care where this is!」"
    },
    "35:5507": {
      "repository_source_sha256": "b903442279f1adf340505a839abc50d0a1ab798919efb4b0cb262471129c6cd6",
      "en": "「So every world is about the same!」"
    },
    "35:5550": {
      "repository_source_sha256": "efffb5cc5942d67abfb47c22b376a32cc2b8c716a9d79920bea7c0e3d63ae201",
      "en": "「I fight to live!」"
    },
    "35:5577": {
      "repository_source_sha256": "139ef65483260fd28a49c1263c474b857977462906682ec93c7a104ea264946f",
      "en": "「Then I'll use force too!」"
    },
    "35:5606": {
      "repository_source_sha256": "28fbe7ae15aad54879cd5dc19f11382f10e4d26d3326348f33d698a39355adb0",
      "en": "「If you're coming at me,\\nI'll take you on!」"
    },
    "35:5655": {
      "repository_source_sha256": "c62ab4f7f1f6ac1d419ef7a67513be6fa2cbd91e16fd3a7b02f4373cba47ad0c",
      "en": "「Here goes...!\\nThis is the power of $$アクエリオン$$!」"
    },
    "35:5704": {
      "repository_source_sha256": "4c3e2ac2ec76db4a4dfab825e01ded3acf145255f90da90b3fc8321b0a4ef22e",
      "en": "「Let's show them...!\\nThe power of $$アクエリオン$$!」"
    },
    "35:5753": {
      "repository_source_sha256": "33f599ec70db1560f1830b99de154f01ac89bbe1141fc68ed2988c400767153a",
      "en": "「I'll borrow everyone's power too!」"
    },
    "35:5780": {
      "repository_source_sha256": "735b8e6ee34bad88bbdfbc53649b190fc7d9b68ce171981d2fd87626adf92cc5",
      "en": "「I can't forgive your selfishness!」"
    },
    "35:5823": {
      "repository_source_sha256": "57ad98a715c3e88001b855d6136745e4083131510e6f41dacd51eb79b6199219",
      "en": "「I can't stand arrogant types!」"
    },
    "35:5860": {
      "repository_source_sha256": "2d114f60927c6244520b318b44004365e49770c8325f4f9267ba547d643f4928",
      "en": "「Something inside me starts aching\\nwhen I look at that one...!」"
    },
    "35:5917": {
      "repository_source_sha256": "1a4232807b47f4474a9ce7e8de63dad129d5043d3ee5906ce051cfa49bc790a4",
      "en": "「I'll retake the universe from you!」"
    },
    "35:5958": {
      "repository_source_sha256": "ccbe8c517f4a88667dceaa9c516c2a6b497af12b03bb7384711ccaccf9b29bd7",
      "en": "「Ties from the distant past...!\\nI'll settle them here!」"
    },
    "35:6013": {
      "repository_source_sha256": "8836cccfd427d87b26f7094f5caec4c0f29e00bb48c564de142c1eee5da89ed1",
      "en": "「This $$アクエリオン$$ will avenge the\\n$$天翅$$s' wrath and hatred!」"
    },
    "35:6068": {
      "repository_source_sha256": "43032e61d437ad02a1469bf531971a1e326dbe25e578b4d46bb6ffa1a97007ec",
      "en": "「My fist guards all life's future!」"
    },
    "35:6109": {
      "repository_source_sha256": "d39adcf4edb9be8b22244e8eaa23bf78d3cd257fd73ab582cf05c9173f39e450",
      "en": "「Can a selfish punk like you\\ncarry the world on his back?!」"
    },
    "35:6164": {
      "repository_source_sha256": "39566a2373042f2247a5487e2bd8290f6cf21934e8f8cd792ae7465f914f07b9",
      "en": "「Mechanical Beasts? Just blast 'em!」"
    },
    "35:6201": {
      "repository_source_sha256": "b466bc04e84eeb1482aac5c3621d06fec79f1dcff2449f9ec1f9ed2fde9a8087",
      "en": "「I'll knock you off Earth!」"
    },
    "35:6232": {
      "repository_source_sha256": "94e6ba275d970ff2462891f586a7c6e6e2cd2f124bb89e665a91fdfa0ab90505",
      "en": "「Let's go, $$バジュラ$$!」"
    },
    "35:6255": {
      "repository_source_sha256": "5720c824cf3cf6402b40eccbfc1ff37a0981f69a5c7e9ce5bcd42e021410782a",
      "en": "「I won't let you have a say\\nin how we live!」"
    },
    "35:6308": {
      "repository_source_sha256": "6b4b4e73b8dfbf5160cbb4e0078f6d0daa6e274a7cfc466dff4ab28e1911353b",
      "en": "「We live because we want to live!」"
    },
    "35:6345": {
      "repository_source_sha256": "6f581d7011277ccce0e4f8ad749e31b999c62ea0f34311de267f8e97f9533361",
      "en": "「I'll punch you out and end it all!」"
    },
    "35:7516": {
      "repository_source_sha256": "d64ef6c4d9828e8586dbbe1b9c333b9686aa1162868ddfc73a3322c518053240",
      "en": "「I lend you my strength! Go, $$アポロ$$!」"
    },
    "35:7547": {
      "repository_source_sha256": "4dec48240f923ea12777376f301a93a407efc40480c42ec94555cb67c4301e79",
      "en": "「I'll take a good look at your power!」"
    },
    "35:7586": {
      "repository_source_sha256": "0ef42e9ea6bce76d260979302678b08a281a9d57ff4d2f4c2897ea5e9c12ec5c",
      "en": "「Heh, who are you talking to?」"
    },
    "35:7615": {
      "repository_source_sha256": "2c3ed143ca89cb4e4513507c3fcff90f23ecce819a63a51e5d81436c2c8f3b82",
      "en": "「Let's go, $$シルヴィア$$!」"
    },
    "35:7640": {
      "repository_source_sha256": "044946358e1f3a37f3e52cf2fbc052d2fd57c9b68032b01f0d3b2edbcafb98cf",
      "en": "「I'll sever the past's ties now!」"
    },
    "35:7681": {
      "repository_source_sha256": "a0f0a64db517c870af5e0aefbf43a0189e6d25ea3099fdb8eeba3950a03ee6e8",
      "en": "「Of people, worlds and spacetime...」"
    },
    "35:8100": {
      "repository_source_sha256": "7fd73a99b2163eb3333e76375060ede6c23a19f92ea157c632103194ad92b28d",
      "en": "「Let's go, $$シリウス$$, $$シルヴィア$$!」"
    },
    "35:8135": {
      "repository_source_sha256": "6c4845925ea9875a0d15613a8e97b1855d95e8aa5349fb94cdadebd7e00d0c45",
      "en": "「Sounds fun, I'll do it!」"
    },
    "35:8170": {
      "repository_source_sha256": "a227b0ea277fbd3652732d8ae2de0453d2ff0563345ca854a5332a2260500c4e",
      "en": "「Wherever, I'll blast the enemy...!」"
    },
    "35:8211": {
      "repository_source_sha256": "c644de21419344a2e93be0eb1ec557dc90713a3e1496fc740779bdd4694f88b0",
      "en": "「Show me how strong\\nyour power really is!」"
    },
    "35:8262": {
      "repository_source_sha256": "0faaf4e151bd2b7e0087c9c15747e41babebbaae249ede6b2d029e821cf69536",
      "en": "「I'll eat, eat, and keep on eating!」"
    },
    "35:8293": {
      "repository_source_sha256": "a1b285f0954d64b208be93dcfaa5730691df57e0075ff6e0309711bc2671edec",
      "en": "「We can fly, as long as it's us...!」"
    },
    "35:8322": {
      "repository_source_sha256": "0867cc148b6e2db7ce1b3a0d367b52be83ae9cc27a2af8317c246588460f5c8a",
      "en": "「Past lives don't matter...! I'm me!」"
    },
    "35:8363": {
      "repository_source_sha256": "86645e265c53c9d7b1862e076637f0672148572ae8cf233cc145978f6eeec1c8",
      "en": "「I've been me for 12,000 years!」"
    },
    "35:8404": {
      "repository_source_sha256": "31a2a9f6261a0ced372bf8df9790f31fd9f2454803977715404211fadbd7af55",
      "en": "「I'll settle all these ties...!」"
    },
    "35:8443": {
      "repository_source_sha256": "4368877a581d973926d0fa21f40aed8d30a8758ec3f776512e424e49f75cf755",
      "en": "「Yeah, I'll do it!」"
    },
    "35:8468": {
      "repository_source_sha256": "eecfadf56f9ed1cce05d2832fe258de4a326a95e1da612f1f8124a2fcab6ff76",
      "en": "「Heh, bring it on!」"
    },
    "35:8491": {
      "repository_source_sha256": "833283db9d58a20c691d64af4fb0aa152057650cd097a5385e88c80c90c71c19",
      "en": "「Wake up already, you damn prince!」"
    },
    "35:8532": {
      "repository_source_sha256": "b1c68aa077cf992f7d9d906d7b5e4858b641b6628ad54b74c90a6eabeb6c2d81",
      "en": "「$$シリウス$$, $$シルヴィア$$, lend me your power!」"
    },
    "35:8569": {
      "repository_source_sha256": "03950731705b716c7d6c757d3785b7b9085b418aad3b602a6c443c1f343251e8",
      "en": "「Got it, you rowdy princess!」"
    },
    "35:8602": {
      "repository_source_sha256": "f747cb7dee252142d22c941e45f12d6962923e9d605098050f32022cad1b797b",
      "en": "「Heh, can't top Her Rowdy Highness!」"
    },
    "35:8693": {
      "repository_source_sha256": "476114537e706960ec90b749c6a4c2a60f83755b39fd25474076a338d352e115",
      "en": "「Feels like there's nothing inside!」"
    },
    "35:8730": {
      "repository_source_sha256": "9fc35a7830c3cfefc2e16f11233695192c2dcd594be1cfeabe9d029d97318a0f",
      "en": "「No scent at all from this thing...!?」"
    },
    "35:8771": {
      "repository_source_sha256": "d29a85882c454ae23ea6d08f81c9acf2e8d15ef8096d1a679f037f1d06bb76cb",
      "en": "「I won't let you remake the world!」"
    },
    "35:8814": {
      "repository_source_sha256": "bc00afe5037164d9ce69d00b16bfbb693973eca21b35cd992e51e505e989b811",
      "en": "「Who the hell are you!」"
    },
    "35:8835": {
      "repository_source_sha256": "4074687d24343648d8a18aa938e259f1d9a46f323708f183bca560f4488465ec",
      "en": "「They give off only a foul scent...!」"
    },
    "35:8876": {
      "repository_source_sha256": "9f179818f684d483fbb0e169a25801118c70365f98d16b55dc207bb6eef4df00",
      "en": "「Woman or not, I won't go easy!」"
    },
    "35:8913": {
      "repository_source_sha256": "42feee0abbad9cb623638623485763e4c5260072e810c6c8795c5d43b6564b28",
      "en": "「I'll give you a good scolding!」"
    },
    "35:8940": {
      "repository_source_sha256": "aa7306ca109c85065e3437d523e3ffd6124432e105f067334262d0b2108665b9",
      "en": "「This scent again?! I'm sick of it!」"
    },
    "35:8981": {
      "repository_source_sha256": "1b4a95d857e8cade2d8bbe1f95cf1e72ff1e8f593049dc8ac590f2b4f615ba36",
      "en": "「I'm fed up with you lot!」"
    },
    "35:9020": {
      "repository_source_sha256": "0319bd6495f48fed255963591e9d09dc1ec73ab83fb47972a50025de9dae7071",
      "en": "「Let's fight till we understand!」"
    },
    "35:9061": {
      "repository_source_sha256": "eb82e239be1d1665f508654f27ad799d1767079838a8972632df23e56fd94c5c",
      "en": "「If you come at me, I have to fight!」"
    },
    "35:9096": {
      "repository_source_sha256": "1aa1163262b30f915f5013284bbfc31cdc9d32ec76261df6e574488297cfddea",
      "en": "「Looks like I'll get stuffed full!」"
    }
  },

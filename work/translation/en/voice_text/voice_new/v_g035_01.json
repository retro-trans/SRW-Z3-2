      "en": "「Beware, Emperor Dimensional General!」"
    },
    "35:10153": {
      "repository_source_sha256": "83b99e2682c2d7b7fcde0c79ebc064e314c9eb1ea7dc87dc5cfee3bf0e8d634b",
      "en": "「Today we end this, $$アサキム$$!」"
    },
    "35:10196": {
      "repository_source_sha256": "d56af8869bbab7148cac464c73a7d1ac2f75760fbe54a931974ee0993a32a0db",
      "en": "「$$アサキム$$! Don't you dare show up!」"
    },
    "35:10239": {
      "repository_source_sha256": "b7963f9e9d9f24494d9e12116b99430b0fc13aeddab596132486f1710d37ade9",
      "en": "「Like hell I'll do\\nwhat you tell me!!」"
    },
    "35:10288": {
      "repository_source_sha256": "e580161cfa0b63f9c2295781bc40726da5f604a123710ff52e271aceebece530",
      "en": "「Emissary of God or not,\\nan enemy gets blasted!」"
    },
    "35:10339": {
      "repository_source_sha256": "e70b2e121861c2654c2134fc3d009efb555294928b2a009fc4180be923f0ef5c",
      "en": "「I've known this scent for ages...!」"
    },
    "35:10382": {
      "repository_source_sha256": "5edac7f8550933b78176be8a0a2016981f296104297b8d67edb6de4d23fc8d65",
      "en": "「You've no right to condemn\\nthe whole of humanity!」"
    },
    "35:10435": {
      "repository_source_sha256": "b9a410ff01f57f037000e0cace59749e16853cfe942efe7bcbd4f529de1b519a",
      "en": "「If you want to play that bad,\\nI'll take you on!」"
    },
    "35:10492": {
      "repository_source_sha256": "3f69dbf4b7692d7cbd962fc246687ff099d45b2e8c39011dd04400db6f10e7fa",
      "en": "「Damn...!\\nWhat's with this guy's scent...!?」"
    },
    "35:10543": {
      "repository_source_sha256": "3b1b3c428b1c7b11346dba6c9c4f54a75b52abfd5ce8eb8bcd22d9d76fffbd62",
      "en": "「Having fun looking down on people!?」"
    },
    "35:10584": {
      "repository_source_sha256": "a39f7301bb880ec2cb61c1b5fb68d8b0869a94d375828ad5009ebc022d49ffed",
      "en": "「If you're so great,\\nfight with just your own strength!」"
    },
    "35:10645": {
      "repository_source_sha256": "c3cde08d6740f2b608a63d603cdb8f1ee0b44d3f20bf989fc20fc6bf9c4e93b3",
      "en": "「You've got a nice scent!\\nBut I don't like it!」"
    },
    "35:10706": {
      "repository_source_sha256": "545288efacd0b0d9dc73020c11bd2ea79ab240837d0b0b934afc2ded5df911dd",
      "en": "「We and the world haven't fallen\\nso low that you'd save us!」"
    },
    "35:10769": {
      "repository_source_sha256": "3d6c99ff0f46f988ef0dc0937ab8156212716e7554e074fb78b86a8ada55fc65",
      "en": "「And then... on to a new path!」"
    },
    "35:10798": {
      "repository_source_sha256": "00293ba734ae274aa9fe5d8ddc327947689c088a8592abfc043cb122d3de34a9",
      "en": "「Let's go, my friend!」"
    },
    "35:10817": {
      "repository_source_sha256": "4b525d4bffb79035eb1d5b411f23bd4df6ce6518d32933e99321baf1afac7457",
      "en": "「For a new Genesis!」"
    },
    "35:1182": {
      "repository_source_sha256": "28081c8ca8326ad10f2b11ca9dcc6c5632203b9c2764e111fd64094e588aa9bf",
      "en": "「Hold it right there!」"
    },
    "35:1201": {
      "repository_source_sha256": "6988bf19a151f7fd408b52d6afbc4b02f19c2982e51481b553d6977e22121602",
      "en": "「You've done it now!\\nIt's my turn this time!」"
    },
    "35:1250": {
      "repository_source_sha256": "13949e4ab80af01312f093f0880b9f9d944d9eeceb80672586d2747cce147b73",
      "en": "「The great $$アポロ$$ doesn't just\\nstand there and take it!」"
    },
    "35:1299": {
      "repository_source_sha256": "1f141f5b055ea844d4b2077495240f3c3521ae5a19bd7a6c4f229f7f36edb116",
      "en": "「Time for me to pay you back!」"
    },
    "35:1328": {
      "repository_source_sha256": "bda6939304709e940c2c500ab8195f4c751f0f9d9cbe2be6c2a4996a311db98c",
      "en": "「Damn you for getting in my way!」"
    },
    "35:1353": {
      "repository_source_sha256": "4f8228b725524614922c4553720fa761caf1d38cec4b564fdee21b8eaaf58ffd",
      "en": "「I've got to do it to survive!」"
    },
    "35:1392": {
      "repository_source_sha256": "04911879f47dd70e8c09c8b4f156466c8a94f8f838662622ea2ac66132814e0d",
      "en": "「Bastard, I'll pay it back tenfold!」"
    },
    "35:1427": {
      "repository_source_sha256": "7d262734339e5c9874ae34d605d6881600dd3b4d376756fc61ac924527273964",
      "en": "「Mess with me and you'll get hurt!」"
    },
    "35:1460": {
      "repository_source_sha256": "69e365fc2a0d36ce47203a7b81bbda2dbcc98c609814d764050202c651464161",
      "en": "「If that's what you want, no mercy!」"
    },
    "35:10844": {
      "repository_source_sha256": "69f8acac342cf04738badccdfbb1481dbab23ec6b7aefe872eeab1f17b7cc2e3",
      "en": "「I'm here to deliver what you forgot!」"
    },
    "35:10871": {
      "repository_source_sha256": "25c862ac47a003fe0b4136e16b35d783818b7f46065a38aa742bcfcce70955bd",
      "en": "「Naturally, I hit back when I'm hit!」"
    },
    "35:10902": {
      "repository_source_sha256": "3190beda362083aed73ea25c2e6678f7c4b68eb68e288c16f03b284cc7a43dd4",
      "en": "「Not running away? You've got guts!」"
    },
    "35:10931": {
      "repository_source_sha256": "072fa8ea1344b425d95790033aeb0bc8e0ba871bb9c3b583ee6368703a23b31d",
      "en": "「It's still too early to go home!」"
    },
    "35:1499": {
      "repository_source_sha256": "57a5381816cb85eb1e8777f33f893da4ab844e3ffccc78f3a7f7e58f9153895e",
      "en": "「If a hit like that could win,\\nwe wouldn't be struggling!」"
    },
    "35:1544": {
      "repository_source_sha256": "5cc197925b22c1dda2f86b998c8fb25b5887e6b89579e3ffb95fb2d964ee0018",
      "en": "「I'll finish this off!」"
    },
    "35:1573": {
      "repository_source_sha256": "ea1bb88e6edc91eafabd00331ec4de3693f89d759e867149b42a5abdec127811",
      "en": "「I'll do it!\\nYou stand back and watch!」"
    },
    "35:10962": {
      "repository_source_sha256": "4d04b2b5b6ea7b4a41e1a168e31d69d2d978cceee63cbeed103fb3d29760270e",
      "en": "「Okay, $$アマタ$$! Leave the rest to me!」"
    },
    "35:10997": {
      "repository_source_sha256": "a6049d7679da2bef214777dc015b50f5a6405a97c702253b328886a51bc68505",
      "en": "「I'll lend a hand, $$カイエン$$!」"
    },
    "35:11024": {
      "repository_source_sha256": "2b61a0e9fee1c88db918eacdfa3f6aaf33528a973d104704adc8947eef9c6203",
      "en": "「Let's see if you dug a good hole!」"
    },
    "35:11055": {
      "repository_source_sha256": "47e20aeedce0d93be744a88d61c2644f89f9a3f653a543870b75d3fff00199ac",
      "en": "「Quietly working hard, huh, $$モロイ$$!」"
    },
    "35:11098": {
      "repository_source_sha256": "c993057f10a5b6a88d4138e146ea46bdc61a480e7c45b41afac45f178f772798",
      "en": "「Nice performance, $$シュレード$$!」"
    },
    "35:11133": {
      "repository_source_sha256": "21d1137571e75e26abbb99340d2a4b47b9c02ab63efc275696a0528a8c5e3512",
      "en": "「Heh, as expected of you, $$カグラ$$!」"
    },
    "35:11162": {
      "repository_source_sha256": "88b0bb6a0081a1690dc31002b2cbc343b1de259fde1075a8aec71739db1aaa61",
      "en": "「$$ジン$$!\\nI saw that drive of yours!」"
    },
    "35:11211": {
      "repository_source_sha256": "c018561e94a37246ba2871c53d5f6b5ceab9767e918465ca9f2897eb9f4a8c90",
      "en": "「Don't overdo it, $$ミコノ$$!」"
    },
    "35:11244": {
      "repository_source_sha256": "179f5f8b61f5902ea7161b993f58021eb43959042b85c37e05ee8594c919aac0",
      "en": "「You're dependable, $$ゼシカ$$!」"
    },
    "35:11279": {
      "repository_source_sha256": "b2b82dd1d27ea530cb400fe4da6dcbd27d9185c5ca64b6c9c3824bbec79bdf96",
      "en": "「I-I'm not dirty, you know!」"
    },
    "35:11310": {
      "repository_source_sha256": "8720313da748cb2f43129676f7e26557208a7aa48b72868b38a9d2e0d6efe451",
      "en": "「This is no time to be embarrassed,\\n$$ユノハ$$!」"
    },
    "35:11359": {
      "repository_source_sha256": "9d6c20daea895a81c4685871dccab9372c63760b410a2b7927113fee62170d46",
      "en": "「Don't think weird stuff, $$サザンカ$$!」"
    },
    "35:11396": {
      "repository_source_sha256": "87a40e3e5b01656a20055ffd210f15685219d384d3ba099e3f783c74c321a00b",
      "en": "「Hustling at your age, Chairwoman!」"
    },
    "35:222": {
      "repository_source_sha256": "2489c4c707725730b19b5ce05ff151456953a72434cc7fd8afb333e5cd5e7080",
      "en": "「While I'm at it, take this too!」"
    },
    "35:261": {
      "repository_source_sha256": "fb26dfe9360243173f13a84fc16473573ec8eff5374039249ee043b7733ea02c",
      "en": "「Overeating isn't in my dictionary!!」"
    },
    "35:294": {
      "repository_source_sha256": "158d588d5d553380bc725acc7c92dccee14992e5be24bc28d3fe19b7a8b04116",
      "en": "「Another round coming up!」"
    },
    "35:8643": {
      "repository_source_sha256": "f25db32c2673cab5ddc89201b8c0507212d737228c1a2bd00809480ec070907c",
      "en": "「Take one more hit!」"
    },
    "35:8668": {
      "repository_source_sha256": "f6638b07e891a94104e665115d84a09968865b5203d3323b6e851c88b6155bdf",
      "en": "「You're not getting away!」"
    },
    "35:1787": {
      "repository_source_sha256": "76f92fcc8fb4ae28a56dc831ef22e8b1ed7fd489af65825dd4e4a47d72146f3f",
      "en": "「So we're focusing our fire!」"
    },
    "35:1814": {
      "repository_source_sha256": "3f127ff7e707eef5393089a9148e7333a8f1086f4cc5ba5e4f4a893f3ea5da62",
      "en": "「I'll hit them square on the nose!」"
    },
    "35:11958": {
      "repository_source_sha256": "f1b93fbe9fc5c3e801627ba4d9e11cc6e46e4dad61a165b18b31739181f6f54b",
      "en": "「I'm going in first!」"
    },
    "35:11981": {
      "repository_source_sha256": "3f8239ea658574530f06e66abb450833ee0bb692f0cb63415e201ace1927041e",
      "en": "「I can't just sit and wait!」"
    },
    "35:12012": {
      "repository_source_sha256": "fea3e6c8f7c8469dd2c35f1f4122665dd5809d7a9f1c006959523161fb06036c",
      "en": "「Dawdle and I'll leave you behind!」"
    }

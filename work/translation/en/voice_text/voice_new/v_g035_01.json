      "en": "「I'll teach you what a human is!」"
    },
    "35:9614": {
      "repository_source_sha256": "5cb4c8855213e858aa7eda5b3e19ef2cdcb1a7c385bc2b0b5710138e97ecc711",
      "en": "「This fake stench is killing my nose!」"
    },
    "35:9653": {

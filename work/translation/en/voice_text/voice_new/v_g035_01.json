      "en": "「Like hell I'll lose to a calamity!」"
    },
    "35:9331": {
      "repository_source_sha256": "f2b9dad6f052d99629041b7aa61adef038a6a2152588a948b187df3eadcbaf7f",
      "en": "「Keep coming, you monsters!」"
    },

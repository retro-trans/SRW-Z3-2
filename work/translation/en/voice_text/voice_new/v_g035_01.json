    "35:10044": {
      "repository_source_sha256": "acf7d086cc94dc49bb05017d12ae17bf5fee442bed452e66c4d22655d93e75d6",
      "en": "「No mercy for a battle-loving woman!」"
    },
    "35:10087": {

      "repository_source_sha256": "20a3149f370f140b848a3c9662932094a106505f0d3e18dcd687bd54c517351f",
      "en": "「If it's one-on-one!」"
    },
    "48:4347": {
      "repository_source_sha256": "789326bc28508197bbef96cfbb0b133febb78e5e6ae592252236a53efcc9059a",
      "en": "「I'll finish my own prey myself!」"
    },
    "48:4378": {
      "repository_source_sha256": "420e3c6e23b506f9cc9495a6583ada1304c65de62939934c18af46f3f16cdc89",
      "en": "「I'll take that one!」"
    },
    "48:4401": {
      "repository_source_sha256": "0d3b8d5b614d4865dd879b08339e1a6c97272521435b4406c996f4a566a81242",

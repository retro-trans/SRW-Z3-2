    },
    "48:2099": {
      "repository_source_sha256": "ac39c5aa0462aa4c6a016dfffcf324a734ebe40a98f4f72b15d2908350cddb6c",
      "en": "「Sun and moon can't light my dark!」"
    },
    "48:2142": {

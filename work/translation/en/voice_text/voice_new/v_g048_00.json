      "repository_source_sha256": "5821800795d9e23d070514b316263947f63c9bdf638f2d0f9c25469e0e287d01",
      "en": "「It's not over yet!」"
    },
    "48:1255": {
      "repository_source_sha256": "4260e6a2b4e663e3e71853f8b4e1c80755af055071e055b3596e5a80a4aec384",
      "en": "「I'll finish you off here for sure!」"
    },
    "48:4463": {
      "repository_source_sha256": "90f78a4b82ebc9ee9de907932e41f2d256b2d133eecb88e2020016e0502ef471",
      "en": "「Let me go first!」"
    },
    "48:4486": {
      "repository_source_sha256": "59b06969cff61e024baf8d2c967f0b108031fe5cdf3f58135142828231cf0fb3",
      "en": "「If you dawdle, I'm going ahead!」"
    },
    "48:4523": {
      "repository_source_sha256": "f8028f835b5cc2246e31154f9aea2d3e20adfd658f95e6287985291887509ec8",
      "en": "「I'll take it down first!」"
    },

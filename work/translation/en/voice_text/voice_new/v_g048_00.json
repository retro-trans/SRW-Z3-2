      "repository_source_sha256": "e81b8209c92abd0446b4212d4bd1ce4cd16a38a09cd7d2addcca7cbabe88e5c3",
      "en": "「Ha ha ha ha ha! Caught up!」"
    },
    "48:3831": {
      "repository_source_sha256": "d5327f489cb79c1cb34752746437d3a10894976e75fcd37964116588e4d48dfb",

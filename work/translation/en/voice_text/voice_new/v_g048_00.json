      "repository_source_sha256": "9ec5bba33da39fbbe9f3c3e6daff85c396e6602d86f236b4847879600c494eee",
      "en": "「I'll clean up the mess!」"
    },
    "48:3893": {
      "repository_source_sha256": "72730ed74b2769c53051c713d9959da2af027a3b1e1d3c14c68b772f430a06cf",

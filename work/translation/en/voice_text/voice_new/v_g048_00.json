    },
    "48:3410": {
      "repository_source_sha256": "1381b6a088788c8c7954855ded36dd1ca42782496b772e1b753a559350ccc934",
      "en": "「Are you that set on angering me?!」"
    },
    "48:3445": {
      "repository_source_sha256": "8e2089cd763efa9476c55913a66a6bcb8e5355f9b65075a68f125295b5538dd7",
      "en": "「You did it...! You damn well did it!」"

    },
    "48:2848": {
      "repository_source_sha256": "5d13dfca329106c95499fa43fdf2ef048aadf03640dec382cd40a2a3d52069b7",
      "en": "「So he's the one who beat $$ガドライト#pilot$$!」"
    },
    "48:3385": {
      "repository_source_sha256": "d20994ba7bc6dea460818085c8ba6a696e2a0df8fa69c7230c8cdf8a857112e0",

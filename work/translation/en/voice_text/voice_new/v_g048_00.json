      "repository_source_sha256": "766cb42f6cc4c79d37d51c31ae6d617be1a14d4b28ecf76a1219fe128ad213a7",
      "en": "「The chance Lord $$バルビエル$$ gave me...!」"
    },
    "48:4037": {
      "repository_source_sha256": "6d9c698f61c12b485dd11f97ad21163857a767c94af4108d54e25f78b99c4d90",
      "en": "「I'll follow General $$サルディアス$$!」"
    },
    "48:4068": {
      "repository_source_sha256": "625b836d0f269c96691012afd763521d9d97c697068c59412d059b25d3141956",
      "en": "「Tch...! Sloppy finish, $$ギルター$$!」"
    },

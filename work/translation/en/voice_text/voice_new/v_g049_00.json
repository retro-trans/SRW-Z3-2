{
  "schema": 1,
  "rows": {
    "49:0": {
      "repository_source_sha256": "c8a34de563a98a8b4e08f98b90e1db2a13e77989a4a66072a59745c10242a10f",
      "en": "「Brat! Are you that eager to die?!」"
    },
    "49:35": {
      "repository_source_sha256": "755dd46259347d543e912f31474940d3e6298c4b1fafb615d0e10e405e6e9adc",
      "en": "「Let the feast of slaughter begin!」"
    },
    "49:62": {
      "repository_source_sha256": "65ba7fc0be6fe36fd007d69c5b6993b7731c96632eba004669a8a7186f6e3ec7",
      "en": "「I'll give my hatred a form!」"
    },
    "49:93": {
      "repository_source_sha256": "5cef6d494b41741d62bd1fbcbb544093f91d92c5417e219a10fc497e92b2efd0",
      "en": "「I'll show you the $$アンタレス$$ way!」"
    },
    "49:130": {
      "repository_source_sha256": "7b41256d7cf6fe4cd789e06ca949c8e8f5ad0fc4d002298df383d5c5216bb808",
      "en": "「I hate...! I hate everything!」"
    },
    "49:1338": {
      "repository_source_sha256": "72a7287e73233da5b58c7ee15c2dda37009a10bc7801c349c57cc54daedc0081",
      "en": "「So you're the famous $$ガンダム$$!」"
    },
    "49:1365": {
      "repository_source_sha256": "14e965e8069a51166f5cd1ae9f28570294abf2062fb31fd523dc3ea5156d5a59",
      "en": "「$$ガンダム$$ here, $$ガンダム$$ there!\\nYou're so annoying!」"
    },
    "49:1412": {
      "repository_source_sha256": "5314f8d64054c14fcc00f333003f0cbaaeb58192fe5e0b9bb86003506b438f91",
      "en": "「The prey is a $$ガンダム$$!」"
    },
    "49:1435": {
      "repository_source_sha256": "525343b1203602d55766da653a8d38db8ea3644557c4d1e92a58fa0d00169bc3",
      "en": "「$$ガンダム$$ are targets for annihilation!」"
    },
    "49:1464": {
      "repository_source_sha256": "8d4efce38ecd4019d994d594321aa0be8a516ded26f51ac3dbc947d23e1663a0",
      "en": "「You Earth Federation small fry!」"
    },
    "49:1489": {
      "repository_source_sha256": "804c8ea65aa2051a63991a35a552b260cbbf0749185837a64291c882368288d6",
      "en": "「I'll rip that mustache right off!」"
    },
    "49:1522": {
      "repository_source_sha256": "c9fd160cc0d66207f38829d0c0eaebe137c85e3b9d2dc0b259ab591cf92d1b5e",
      "en": "「That light is an eyesore!」"
    },
    "49:1551": {
      "repository_source_sha256": "4c0ee2e9d93623deb4ceac7a0816267cdf5521b432c1f96da81690e2de13591e",
      "en": "「What is this pressure?!」"
    },
    "49:1586": {
      "repository_source_sha256": "8c97c8fbeeb77e88aeff8aa1083f383c5e5798c2c9c8cfce5c073e96eeca59ea",
      "en": "「Tch! Stop peeking inside my head!」"
    },
    "49:1621": {
      "repository_source_sha256": "b40d36cd471c5606de1134dcfe17e66ed5af36ca3a2677377aaa5974ea395f1b",
      "en": "「Super Robots, of all things!\\nWhat a grand name!」"
    },
    "49:1670": {
      "repository_source_sha256": "7dd356f6a84f53ce763d917aab3fc65ccca1ce063a1a3758cc455b4842c83763",
      "en": "「You big useless lump! Drop dead!」"
    },
    "49:1701": {
      "repository_source_sha256": "ec42c9e4d1322bbaefd13c90a8b04e92cc3ebda399e973e0fb1e12d28f475866",
      "en": "「Don't think guts alone can fix this!」"
    },
    "49:1744": {
      "repository_source_sha256": "e11afb630f707ee1add8b8d636f0f52893bbb910a69d07f3e5735e1ea76e0ad1",
      "en": "「I can't stand that\\nhero-of-justice act of yours!」"
    },
    "49:1793": {
      "repository_source_sha256": "9cbd7b23bdc271c25c4382bbeaf9373ea4cca0b86146fdc44cea5dfd6093be72",
      "en": "「This is no playground for brats!」"
    },
    "49:1867": {
      "repository_source_sha256": "e3143a6bd5966449d7eec10e1c10c705805bd28f00540e3530e0a56459198ed9",
      "en": "「Psychic powers won't work on me!」"
    },
    "49:1900": {
      "repository_source_sha256": "2d79bcde98941ffd365bfa269075eeabc4f350c9191e840669d86149e290c2d4",
      "en": "「This thing...! Like a demon god!」"
    },
    "49:1931": {
      "repository_source_sha256": "5e2e5a24d836cd6a005f101d0c13d2ffb1cb75a18c454edd2a20df2cf29bbb75",
      "en": "「I'll blast that prized armor open!」"
    },
    "49:1966": {
      "repository_source_sha256": "01364348e1d812773c4d1e176936123c8b9f7f0ef6b9f29718c3b04d06032c95",
      "en": "「$$ゲッター線$$...! Power of ruin?!」"
    },
    "49:1999": {
      "repository_source_sha256": "666aa6d4d8bd606108dde811bc3980873042cad042b3626621f89d2203c93f8b",
      "en": "「Changing your form won't help!」"
    },
    "49:2032": {
      "repository_source_sha256": "cbe77eda023dba373a0080db0b32acd7a6e5164a398fb354d06c707b38cf37a0",
      "en": "「Beast! You're just like us!」"
    },
    "49:2067": {
      "repository_source_sha256": "b6b34cfdf349451fd008486c365f13e56ed9d63252e419550a52a1b1a4f7a8cc",
      "en": "「Out of place, you mere salaryman!」"
    },
    "49:2108": {
      "repository_source_sha256": "210a63d7b65ed974440d0ba68b6aa88597fcf6d7cb9d4d405d25ab381af6608a",
      "en": "「Talkative men die young!」"
    },
    "49:2139": {
      "repository_source_sha256": "f247481fc5d43cb2fd9625f6f60e1047331fdb85a7ce44c517a68d391d55876e",
      "en": "「Sun and moon can't light my darkness!」"
    },
    "49:2182": {
      "repository_source_sha256": "c8d23b49552b48993912b4fca22fade108c70b4d6b2e9ab09b1236512161aa81",
      "en": "「Play at lovers in the next world!」"
    },
    "49:2221": {
      "repository_source_sha256": "adeb1c40d0f92cdb599f38601396b7a40cf35b50b7f9d5a8877dd5c88a37eb76",
      "en": "「Don't think effort and guts suffice!」"
    },
    "49:2262": {
      "repository_source_sha256": "a61c23dfd166e8b14b90f2091581fd38ae580aaf27a206e2008b33ef7745cdd3",
      "en": "「Get back underground, you mole!」"
    },
    "49:2303": {
      "repository_source_sha256": "abd5448022f97ea32e97da2949bbc21b5f491a3b9e79640cc92d1fcac16db221",
      "en": "「It fills me with dread just to look!」"
    },
    "49:2342": {
      "repository_source_sha256": "72e453d0b620fced120119f8ded20f6d896764358e69b4b191928a6e6b4ecceb",
      "en": "「What can such a tiny machine do?!」"
    },
    "49:2379": {
      "repository_source_sha256": "1c1db0b7c1f667f5ef6d3f12bfc7f5f89f5d0b6a4e98b2b54ab0d2f9f42eb677",
      "en": "「You annoying pest, scurrying around!」"
    },
    "49:2410": {
      "repository_source_sha256": "5c61687d91d615d17aaae8b4de22f81d98e8aa791edd946ba012d8e27d4186b8",
      "en": "「I'll snap off those prized wings!」"
    },
    "49:2441": {
      "repository_source_sha256": "f2a19248a6bbaa5853a810d34b38bbe79b6678166e950dd77310986fb7aaf445",
      "en": "「You're an eyesore, buzzing around!」"
    },
    "49:2480": {
      "repository_source_sha256": "f2c6ea7857e07d38b8fb056a28db565220f47f895ac7baf543bf1b296f7673e2",
      "en": "「You! Are you making a fool of me?!」"
    },
    "49:2521": {
      "repository_source_sha256": "2d184034d4d9e6f458a9be1a458fb37fa6d2c2eaa998fe3095e431adcbb67a54",
      "en": "「Shut up! Stop that song!」"
    },
    "49:2554": {
      "repository_source_sha256": "11dc53ef7c2f81c5e676569a05aa89b0fa6d89374b2f115d0d360a26b1026372",
      "en": "「This isn't an amusement park!」"
    },
    "49:2587": {
      "repository_source_sha256": "0021c97b59bfb6e08aaffd65fcd9a709964190471969f7da84ef5cf3712a033b",
      "en": "「First, I take out the commander!」"
    },
    "49:2612": {
      "repository_source_sha256": "ff270c8cf27fb7d50e9c356d07ff39ce689c4697976c16dd462cc45f2154e9aa",
      "en": "「So the ace pilot shows up!」"
    },
    "49:2647": {
      "repository_source_sha256": "5dfd4709bdb3c4c0b5aeba79d582ba59b2da12fd40d55aa2c764d453a9847c06",
      "en": "「Sink the mothership and it's over!」"
    },
    "49:2684": {
      "repository_source_sha256": "b370bc164ed818bb7e2ef87d7c9e4c4b877def85c699429e691b19310f82ceb4",
      "en": "「A battleship makes a fine target!」"
    },
    "49:2709": {
      "repository_source_sha256": "24746aa8e1ad96277e23110701917a601d575a6de80045af49c4a645b067f4c2",
      "en": "「I won't let you use the $$スフィア$$!」"
    },
    "49:2736": {
      "repository_source_sha256": "52cc4da4a3779af62de34f9258cf2ae8e6c7df2979ffb09cb9193d649a9c0d15",
      "en": "「Must be nice, Reactor!」"
    },
    "49:2777": {
      "repository_source_sha256": "7988ea12f1c8b795260c17ca361e2b29253c1d58fcc9bae197f30e072500ccaa",
      "en": "「Don't look at me with those eyes!」"
    },
    "49:2804": {
      "repository_source_sha256": "97c4b368297d51bfc5af0b49028f3aad0348a8fbd2ab6c8a00e8cb4747c7bf7b",
      "en": "「Let's see how tough you really are!」"
    },
    "49:2837": {
      "repository_source_sha256": "e4c8c587b5dcdee8b6bc8569a7a6210c49410f3116eda20349bfe235292ecdf0",
      "en": "「The scale's arms, pans and post...\\nI'll destroy it all!」"
    },
    "49:2886": {
      "repository_source_sha256": "5d13dfca329106c95499fa43fdf2ef048aadf03640dec382cd40a2a3d52069b7",
      "en": "「So you're the man who beat $$ガドライト#keyword$$!」"
    },
    "49:3419": {
      "repository_source_sha256": "3361f9cad83496a3a5429fcb1e3376e9263b21fa0be918cf6c43b1f622fc8e78",
      "en": "「Let me do it this time!」"
    },
    "49:3444": {
      "repository_source_sha256": "dab0412bc49ff4f39c3c1a08e186050567f47b436e339ac9ae0360f4f391a08d",
      "en": "「Do you want to anger me that badly?!」"
    },
    "49:3479": {
      "repository_source_sha256": "0e112bb1c873ca9116871e4b71d955cb52e20ca993faaf337e130cdb6658e889",
      "en": "「You've done it...! You've done it!」"
    },
    "49:3545": {
      "repository_source_sha256": "54d00a8b773cbdff1f2e1bc62e1c87b1110be8e3a15e973e9c0abd3afec7782a",
      "en": "「Feel my wrath!」"
    },
    "49:3574": {
      "repository_source_sha256": "c0c8d06ccd2e888cef8844a62c41c778a5eb19298fe8b90c7cc544d10431a054",
      "en": "「You'll regret taking me on!」"
    },
    "49:3605": {
      "repository_source_sha256": "aef6c960ee247d792cfb90eaff1e56f2b32b1ea6b33255d02d0fe2ad98347621",
      "en": "「You won't get off easy!」"
    },
    "49:3628": {
      "repository_source_sha256": "4b9c4468f0719a860b7ec87a9e10efc1225145fca853f9980f13e6ac3018467c",
      "en": "「I'll repay you double... no, triple!」"
    },
    "49:3667": {
      "repository_source_sha256": "34d9dd22d76a68203de256aa9aa5d790f0ec52d2318847a305601e3d7738b572",
      "en": "「I never forget a grudge!」"
    },
    "49:3698": {
      "repository_source_sha256": "1209da786daa438b47ee7ecb1ddc089d54502e027723556477bc2f7a32feb45a",
      "en": "「My head will split from irritation!」"
    },
    "49:3729": {
      "repository_source_sha256": "5aec7a4f11ee59f0c514ffade68d6d0689299d7567c89b56a49c62a4c89ed573",
      "en": "「If you want to die, I'll help!」"
    },
    "49:3762": {
      "repository_source_sha256": "65b1817d5afa46dd42ae0c37961de9e01fc27287a991819399012db997b1b608",
      "en": "「Fool! Still around?!」"
    },
    "49:3789": {
      "repository_source_sha256": "ed12ee35ff321830ebc420da7a0c41ba23852501c156a5972adc1726fe8d1618",
      "en": "「You're there, so you want to die!」"
    },
    "49:3832": {
      "repository_source_sha256": "e81b8209c92abd0446b4212d4bd1ce4cd16a38a09cd7d2addcca7cbabe88e5c3",
      "en": "「Hahahaha! Caught up!」"
    },
    "49:3863": {
      "repository_source_sha256": "6b0955b78d9346ebd6a76d29105ea7c6cd1cb3eb085c4dc65e7c1f61c1410211",
      "en": "「I'll take the ones you missed!」"
    },
    "49:3898": {
      "repository_source_sha256": "cc0bd2c2243b2d7eeca2b21f26a99f4ea5788d1fd9984b445da28f5f9588df64",
      "en": "「I'll clean up the mess!」"
    },
    "49:3925": {
      "repository_source_sha256": "e797a288aeb5da282aba7dc68fbdfb3a798848cfd547b7347c99867a3b28ed3a",
      "en": "「Leave this one to me!」"
    },
    "49:3952": {
      "repository_source_sha256": "6f68c5ca3feec7d13c761096c71303e75889f82dc1079ccbabd6838e308d9794",
      "en": "「Your way of killing is half-baked!」"
    },
    "49:3991": {
      "repository_source_sha256": "7cb206f5d981fe64bc1e015a25684987a9497e73889b2b446ac0bd8d645580c7",
      "en": "「Lord $$バルビエル$$! Leave the rest to me!」"
    },
    "49:4026": {
      "repository_source_sha256": "766cb42f6cc4c79d37d51c31ae6d617be1a14d4b28ecf76a1219fe128ad213a7",
      "en": "「The chance Lord $$バルビエル$$ gave me...!」"
    },
    "49:4069": {
      "repository_source_sha256": "6d9c698f61c12b485dd11f97ad21163857a767c94af4108d54e25f78b99c4d90",
      "en": "「I'll follow General $$サルディアス$$!」"
    },
    "49:4100": {
      "repository_source_sha256": "625b836d0f269c96691012afd763521d9d97c697068c59412d059b25d3141956",
      "en": "「Tch...! Sloppy finish, $$ギルター$$!」"
    },
    "49:1253": {
      "repository_source_sha256": "5821800795d9e23d070514b316263947f63c9bdf638f2d0f9c25469e0e287d01",
      "en": "「It's not over yet!」"
    },
    "49:1307": {
      "repository_source_sha256": "4260e6a2b4e663e3e71853f8b4e1c80755af055071e055b3596e5a80a4aec384",
      "en": "「I'll make sure you die here!」"
    },
    "49:4495": {
      "repository_source_sha256": "51150f2be9047a23db7eb5ef678243d035cd995b6d2e6b7d2df44063e17da34c",
      "en": "「Let me go first!」"
    },
    "49:4518": {
      "repository_source_sha256": "59b06969cff61e024baf8d2c967f0b108031fe5cdf3f58135142828231cf0fb3",
      "en": "「If you're dawdling, I'm going first!」"
    },
    "49:4555": {
      "repository_source_sha256": "076df977485e6f45b0445e6ce7afa2bec971bca159b349d925b1ca89f3783055",
      "en": "「I'll take it down first!」"
    },
    "49:4613": {
      "repository_source_sha256": "5ef4eb2885ff91702e7001b074f2f9719a557ad6b3edb9cc0416a6a5f2577334",
      "en": "「That prey is mine!」"
    },
    "49:4358": {
      "repository_source_sha256": "20a3149f370f140b848a3c9662932094a106505f0d3e18dcd687bd54c517351f",
      "en": "「If it's one-on-one...!」"
    },
    "49:4379": {
      "repository_source_sha256": "0c118e8f472bf7d53f88bc8dfd673e9f276cbe90257d61eeadf2b56f545f3529",
      "en": "「I take down my own prey!」"
    },
    "49:4410": {
      "repository_source_sha256": "0e7dd2e23c42c78efad8bc53ed1ec306053e8231a3089c7382e49cc466921862",
      "en": "「I'll handle that one!」"
    },
    "49:4433": {
      "repository_source_sha256": "87bb2c6024242f1d2251b0ad6d0777be185976ebb53ced219e824368c8557cec",
      "en": "「I'll deal with that one later too!」"
    }
  },

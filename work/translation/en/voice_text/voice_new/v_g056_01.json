{
  "schema": 1,
  "rows": {
    "56:4081": {
      "repository_source_sha256": "5439ad3eb8d96460fc8b3757e9ac79d8d3422cee827d12dfdaed3a3f227650cc",
      "en": "「That's why you still can't grasp\\nwhat the $$ゲッター線$$ truly are...!」"
    },
    "56:4146": {
      "repository_source_sha256": "f744025cbe1b447c5fe11b6c04daeec27941e6f30121d1ad69471c8e070ae7fd",
      "en": "「There's nothing to fear.\\nIsn't that right, $$スティンガー$$!」"
    },
    "56:4197": {
      "repository_source_sha256": "be60865518df4cbfaf3c493503bc6f44f3355afcb264c26c3a89075fef039c22",
      "en": "「As expected of Getter Robo...!\\nThat power can't be taken lightly!」"
    },
    "56:4250": {
      "repository_source_sha256": "75890f6ccee960827218ad1a881f357a1785657df8201f214948d9fb7e8526c8",
      "en": "「What fearsome power.\\nYou think so too, right, $$スティンガー$$?」"
    },
    "56:5329": {
      "repository_source_sha256": "2851a8978fa36c294a2e18df5e5c7a96d0d5fa2055cb54bdf945c94299706b86",
      "en": "「Nuuh! If you keep up\\nthis pointless resistance...!」"
    },
    "56:5382": {
      "repository_source_sha256": "5bfa7722643e006002f563b6eb44801a89197b3bc57a84d4cdbea557a6bb49ba",
      "en": "「Why do you reject us!\\nYou are our kin too!」"
    },
    "56:1025": {
      "repository_source_sha256": "32d30e8091677455bd80a2857fad0eb11fa83c7ff19f55cac586e1db8703081c",
      "en": "「Attacks like that won't work on us!」"
    },
    "56:1150": {
      "repository_source_sha256": "4e0447527270a0476677d16f900c377ba2c9362d6b8070365b5d29297c23ffc9",
      "en": "「There is nothing we fear, you see!」"
    },
    "56:1222": {
      "repository_source_sha256": "f57592d2bb047bc3099b3c8816342241cf94b9da5b94fa99d42959b180ea1e0a",
      "en": "「Looks like this is your limit.」"
    },
    "56:1261": {
      "repository_source_sha256": "5afa50dabba800c897be1eea41e59175ae4374d80c2e5d9d0280913df8b3bd8d",
      "en": "「You know it, don't you?\\nThat you have no chance of winning.」"
    },
    "56:1314": {
      "repository_source_sha256": "2e096470063b9ebec76f4da922c058e8ccdddcdd0c19584fcf68ff65e9e4c5a3",
      "en": "「Why not give up?\\nIt'll be a relief. Ufufufufu!」"
    },
    "56:1369": {
      "repository_source_sha256": "b8371e245ed450d0d012da1d8899d4622fe64157eb47afd434c8a30b495798d5",
      "en": "「Blessed by infinite $$ゲッター線$$,\\nwe no longer have any enemy!」"
    },
    "56:1436": {
      "repository_source_sha256": "80cf4d7478fbc1a7a889ac19052b3278cbb6fa544d6ec12324e1b88a89fa6c53",
      "en": "「Y-Yes, you're right, $$コーウェン$$!」"
    },
    "56:1475": {
      "repository_source_sha256": "eff1a5397f60d3bb2daba766d575d7b0363c2ee1fd3f9a879482de59dd3d994f",
      "en": "「Looks like that's your limit!」"
    },
    "56:3470": {
      "repository_source_sha256": "fcade59eb9d6627b188ddda14997430db5166668b2983557973a3d20b8057618",
      "en": "「Not against us, who keep evolving!」"
    },
    "56:3554": {
      "repository_source_sha256": "1ee5e627cc68af2d27c4b5465fad6a3bfd1957448229903fdedd69011063cf48",
      "en": "「We've outgrown even Getter itself!」"
    },
    "56:3671": {
      "repository_source_sha256": "2407756a0357c75a09a6bdfe88b5918cf64502305db749a7a0cd5a781a0ee213",
      "en": "「Do you know what \"futile\" means?」"
    },
    "56:3712": {
      "repository_source_sha256": "294ae75065c108949fc48d3fa4d8e815bda71e30fe7dce38c53a4f9ef680e08e",
      "en": "「Such an attack is nothing to us.」"
    },
    "56:3747": {
      "repository_source_sha256": "cb2755ce8d9e6a0f54d367de289b8fd6c1e9b19a8b438f9c4f0cd9bbb65f8849",
      "en": "「Wahaha! Child's play!」"
    },
    "56:3776": {
      "repository_source_sha256": "3cbb1f8a1174181fb01135246f3c005609aefc15a1cadb52bd8e417d3711ba59",
      "en": "「It's all meaningless!\\nIsn't that so, $$スティンガー$$?」"
    },
    "56:3829": {
      "repository_source_sha256": "a4a204a09c05770f1f1833873e09ec7c5831ec9da4d77caa22a7b55146be6d6d",
      "en": "「Now they must have learned\\nthe hard way about our power.」"
    },
    "56:3878": {
      "repository_source_sha256": "64fbc3737ccdc73644dba264ef4c5e16b9816e89345fdbc7ccbae6086287b832",
      "en": "「How futile...」"
    },
    "56:5188": {
      "repository_source_sha256": "6b1b91fb330db20f8b77501423c5369e83226e05fe015239318d8d552f9c0533",
      "en": "「Think you can beat us, who have it all?」"
    },
    "56:5231": {
      "repository_source_sha256": "826fd8cbbc14d51e681c40b5135df980ecad6f22cae009731767133dba111af5",
      "en": "「Understand? The beauty of evolution!」"
    },
    "56:5274": {
      "repository_source_sha256": "00c6f9c89994eea6132738ba93aaf1030533636c192f50a01c4645fc083a6660",
      "en": "「Before our power, even Getter Robo\\nis no better than dust!」"
    },
    "56:912": {
      "repository_source_sha256": "21948df5c40fc60cc63c15b18ade38a8442f06e63a2ba5dcbc1487abccea69db",
      "en": "「You don't seem very intelligent.」"
    },
    "56:951": {
      "repository_source_sha256": "42569a32bcef57ce1d05621ab1e88e9f6fed94594590a31e4765d66dbf950e0c",
      "en": "「Don't you need a bit more ingenuity?」"
    },
    "56:992": {
      "repository_source_sha256": "2346a76124874090fd0c3fc6dd12fd7309145f8407f15a8ff713651e075a910c",
      "en": "「Humans are always like this...!」"
    },
    "56:1058": {
      "repository_source_sha256": "f5f6a16f46bda3d6e987c6d8faf8a0669795ec9547ded8baa5ab4ee0d4735c6e",
      "en": "「A miss! Ufu! Ufufufufu!」"
    },
    "56:1097": {
      "repository_source_sha256": "382a2ce5d558879e8dec4b5c7f06b9bb34b4169c21ce790a5e65fb35ae3c3daf",
      "en": "「We know Getter Robo\\nvery well, after all...!」"
    },
    "56:3345": {
      "repository_source_sha256": "6fb57d2e0ffce53b180bc74282e300427db319b0102c6d335655591bec631d99",
      "en": "「Why did you think you could hit us?」"
    },
    "56:3386": {
      "repository_source_sha256": "e06f4437593a19867cdbc6b7ef1a3f9109402868582597bc13b8a0b2973e720b",
      "en": "「Predicting thought patterns\\nis a simple matter.」"
    },
    "56:3435": {
      "repository_source_sha256": "bbc7aeb9138b3ee6f12a52bcf838f130aec1b0c6923ba6f355384a611e343bc0",
      "en": "「No good. You must aim properly.」"
    },
    "56:3497": {
      "repository_source_sha256": "83f16da460a1ac22decd2156f65a21d31a6582309b64b277d25f9b79e617c738",
      "en": "「Wahaha! Y-you shouldn't laugh,\\n$$スティンガー$$.」"
    },
    "56:5110": {
      "repository_source_sha256": "76330fd6576683235e846fdc81430d47776e7887693710d3084c9e9cbfbe18df",
      "en": "「We have no intention of fleeing.」"
    },
    "56:5149": {
      "repository_source_sha256": "fc446a9193370344b863d3e6836f6fe4836d70ef0125c5405afc3d4fd0ac4011",
      "en": "「Ha ha, fear has spoiled your aim.」"
    },
    "56:3597": {
      "repository_source_sha256": "dfc0e77ffc7354b9876832fa3ea652e68b7dbbd6765adfc069117417a557db65",
      "en": "「This much is no trouble at all!」"
    },
    "56:3636": {
      "repository_source_sha256": "edfe8dd92b987a78f1b9f85e3f9114c8713aa7b7065c0c0ca182db126be773bb",
      "en": "「Ha ha ha ha ha! It won't work on us!」"
    },
    "56:808": {
      "repository_source_sha256": "05413258f80c457527db745033d9cb84e7beb5a70a41405ed19a8070f6b067fa",
      "en": "「It's lonely with you\\nso far away...!」"
    },
    "56:859": {
      "repository_source_sha256": "6e4de4e61c0f46b7f9a75aa6a98423bc0575a240ffb755716c8a1ba1fbfe97d5",
      "en": "「Yes, yes, that's right!\\nCome to us quickly!」"
    },
    "56:3234": {
      "repository_source_sha256": "bad0b52eec64f3cd230c9e5e70bfe8ad5353860ef0b75a5e809a48171bc0b424",
      "en": "「You standing there is trouble for me.」"
    },
    "56:3308": {
      "repository_source_sha256": "6847f643defa18c682298dbb8bbc3b28f5565c2b438e5a8cfed9eb2a845d5e23",
      "en": "「You shouldn't be way out there.」"
    },
    "56:767": {
      "repository_source_sha256": "cfd689d3d01ae80cb81d38a1a232653181b736ce3d3adc8a6c59927b00d77561",
      "en": "「Damn! Did we overuse our energy!」"
    },
    "56:3215": {
      "repository_source_sha256": "b214c2f5d3616968809de94f4af231d002f96ddf9445c92245aab25916cbf7a9",
      "en": "「Hmph, never mind.」"
    },
    "56:5067": {
      "repository_source_sha256": "a45468ca16efa8933007f4daa5ff14f87ad747b4975975fe43d9f447bbd9e4bf",
      "en": "「We should have infinite $$ゲッター線$$!?」"
    },
    "56:632": {
      "repository_source_sha256": "b1905af9106f6f7a00ad03b3a31cb1e19d7ae22e9ab7284b0ebdd91baf0704de",
      "en": "「It's all right! I'll protect you!」"
    },
    "56:669": {
      "repository_source_sha256": "174901eea88f3f73d6829621691ee870959332355d06564a0bcbe74c0181fb3f",
      "en": "「Why...!? Why can't we\\ncounterattack!?」"
    },
    "56:724": {
      "repository_source_sha256": "a444118bc56f9c60786042f5438fe36156531b5bfc35d6e7351b4c61b2499c77",
      "en": "「We ought to just watch, $$コーウェン$$.」"
    },
    "56:3174": {
      "repository_source_sha256": "2c5d2d90853c4b13f31cf1ab32d2c30e059342a62e9aa76a16afbf7157c55800",
      "en": "「I see... But no cause for surprise.」"
    },
    "56:3277": {
      "repository_source_sha256": "9c6a67ae324e4b623be815dffc08041020ed8d794ada0cdb77628160445e4675",
      "en": "「What do you think, $$スティンガー$$?」"
    },
    "56:5034": {
      "repository_source_sha256": "67ab1a0d96f8225bcca0bd3d9c1d39987a8a42da8060d93844a2eaf135ca07f7",
      "en": "「Nuuh... outwitting us, are you...!」"
    }

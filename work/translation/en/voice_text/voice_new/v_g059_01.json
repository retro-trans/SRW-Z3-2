{
  "schema": 1,
  "rows": {
    "59:3971": {
      "repository_source_sha256": "538505d4e979328974bdddea433a4fafd9f27b2523bb8bc0aaa67f87c62f86db",
      "en": "「$$悲しみの乙女$$, grieve no more...」"
    },
    "59:4014": {
      "repository_source_sha256": "bd21d3d63d15da05c22935d01951010d3a8210d421f26abc5b73dcb5a92fb8ad",
      "en": "「$$傷だらけの獅子$$!\\nCan you endure this pain?!」"
    },
    "59:4065": {
      "repository_source_sha256": "c336a8667d21e79f9a7a52c9af30aeb470ca308aaf31bffe0327bc29cd9431fa",
      "en": "「$$揺れる天秤$$! Break, will and all!」"
    },
    "59:4102": {
      "repository_source_sha256": "ca7579e143659a13baae684c413341b9af2a85dd74cf07490c3f3a26bcd6441b",
      "en": "「$$いがみ合う双子$$! Well awakened!」"
    },
    "59:4145": {
      "repository_source_sha256": "db4aba475af73479e6a324acc1e1d966cb113415b80e16d9728da6a935ce2b87",
      "en": "「To use the $$スフィア$$'s power,\\nI need you!」"
    },
    "59:4200": {
      "repository_source_sha256": "99ac1da5c7a9a5af3f80f4d13e0a5e8ea1672895d9dfa643fcee0e0f04d31216",
      "en": "「Strong one! Let me show you\\nsomething even you can't beat!」"
    },
    "59:4263": {
      "repository_source_sha256": "6c7d96fe3b44bd186899392a974bc9069b40718a9ffa9fa9009a5754da31410e",
      "en": "「Strong one! You're about to learn\\nhow vast the universe is!」"
    },
    "59:10284": {
      "repository_source_sha256": "47f1e38a41dda5fb8cd06a9b61d966b224b82102a5a96880557372f9b28a84d2",
      "en": "「Sleep, warrior of $$ジェミナイ$$!」"
    },
    "59:4320": {
      "repository_source_sha256": "02acd19b42739d835dfabae0946d3e509c3e9f5238e6f21894a1909af7b9e9de",
      "en": "「I repay your courage in kind!」"
    },
    "59:4347": {
      "repository_source_sha256": "404629348faf1cbabe738f1b9a4a6e3fa1678f9f427b7631ac6e5583cc0f6c9e",
      "en": "「Then take my technique next!」"
    },
    "59:4386": {
      "repository_source_sha256": "8022314ae8d08e8fcb2c63eb7c7af5f077ce21fc524cc79a812778a92e9a4c4b",
      "en": "「As long as I live, my fight goes on!」"
    },
    "59:4423": {
      "repository_source_sha256": "d5cf375c613d6a5f368f679bffdaf2905141345e67ad458bc612dcbd93817ae2",
      "en": "「My fighting aura seeks you, warrior!」"
    },
    "59:4464": {
      "repository_source_sha256": "043b601c5c1c7ec65a017bf4c0c6ec240836240b5a7e386ea07e86c06b85524e",
      "en": "「I'll meet your attack at full power!」"
    },
    "59:4497": {
      "repository_source_sha256": "9d75e5e790413f9b8c6f37671f928fba451cb028ccfc542fabf28672d7f1b6bb",
      "en": "「Your fighting spirit lifts my aura!」"
    },
    "59:4534": {
      "repository_source_sha256": "91e9986f6df511a51f9eec2668198b7a519e1327a03fe0b9a7c6eb049fc0a95f",
      "en": "「No one who comes at me escapes!」"
    },
    "59:4567": {
      "repository_source_sha256": "7de9f4475ab3a7509fd81a5930d13fb40396fac97e95814962f35e04a67c850d",
      "en": "「Don't think I'll let you retreat!」"
    },
    "59:4596": {
      "repository_source_sha256": "ec6d58e236b95d563273b14a4499c19bca6f405031d749573a90dc6750190b7e",
      "en": "「$$次元将$$ instinct: hit back!」"
    },
    "59:4637": {
      "repository_source_sha256": "6afee7d6b3a6049c2fed947c3117d20cd245154be40c09470359d81e57981a74",
      "en": "「I bow to no foe! That's my strength!」"
    },
    "59:4680": {
      "repository_source_sha256": "0e7737121c4258823ca71277ef812c82c02ee0b5614abf3a626494fbd3ed3619",
      "en": "「Defy the Emperor, and be punished!」"
    },
    "59:4719": {
      "repository_source_sha256": "ec0b290e5949121eddcb142a8e0f658380cedfd67ed3040dac4182b8c63075f9",
      "en": "「I can't let you leave unpunished...!」"
    },
    "59:4756": {
      "repository_source_sha256": "841ef561655f2ad6cc6defefd89436c738a29277de9ce7e876f059d17879f6ab",
      "en": "「I'll deliver the finishing blow!」"
    },
    "59:4785": {
      "repository_source_sha256": "b38871b08abe7ead67ec9e5c0a6c8624cba11680b3de2f5a534a2adaeca20d17",
      "en": "「Stand back...! That's my prey!」"
    },
    "59:1280": {
      "repository_source_sha256": "f6d2aef65c4b6e096551cfdb05ab7c8960da997b29042551538c2bf9494f4753",
      "en": "「My fight lasts till the foe falls!」"
    },
    "59:1317": {
      "repository_source_sha256": "fcf7abfd24a0ab0bbe1b86528fa391a374857184eba305a0e9a5eea926048056",
      "en": "「I've cut the flesh! Next, the soul!」"
    },
    "59:1358": {
      "repository_source_sha256": "a2eddd56c31575b3a272710c1af680d551f5cb405081db600d394b711824e4ee",
      "en": "「I'll keep going! That's my fight!」"
    },
    "59:4932": {
      "repository_source_sha256": "ffca19a6ea8e710769ce1999d9d39f5e396dd8263929da0de2c5362c76a1c21c",
      "en": "「I'll lead the charge!」"
    },
    "59:4876": {
      "repository_source_sha256": "396d35f6deb3174a9079c3720e0d782867ed4ca6f8d3403570a90bf790d268eb",
      "en": "「I'm not one to lose one-on-one!」"
    },
    "59:4911": {
      "repository_source_sha256": "fbfc48862470d9f14a6ecbd7b8be6687839a8fb570c417d50a1bbf1c05f4af34",
      "en": "「One kill each!」"
    },
    "59:9901": {
      "repository_source_sha256": "f3e82829cc99da715b53976e9d101adad6aee3e532cfb005f0fb0bdf1b459058",
      "en": "「Not yet... My fight isn't over...!」"
    },
    "59:9936": {
      "repository_source_sha256": "0d62211ea8d7cc7360e65c0bb63cd43d063645a3873d2cc8738df4c8ffefb1b4",
      "en": "「Not yet... I can't end here!」"
    },
    "59:9975": {
      "repository_source_sha256": "21e5ab83c240d74b09b5f189d0cccc16c60b8ee5f441c79bae79e4729a4b41fb",
      "en": "「Will I lose...?! Me...!」"
    },
    "59:10012": {
      "repository_source_sha256": "1ba6c72964e532791a479152218e60e20049a6ff4ab0c341bb888333568f7ce5",
      "en": "「My mission...! Till they fall, I...!」"
    },
    "59:6813": {
      "repository_source_sha256": "d73a71480ce8197e0faf6ae1b4457af4b13b085a7cc372bb4d8345eca7f14d6a",
      "en": "「At the edge of the galaxy,\\nI'm grateful to have met you...!」"
    },
    "59:6866": {
      "repository_source_sha256": "e5bb159924dea4a1b9066d4318df99eb5e731ed06caab6c2b41aeeec4d3be9bd",
      "en": "「Your combat sets my aura ablaze...!」"
    },
    "59:6907": {
      "repository_source_sha256": "e5c815a1b1029a1eae8c1d8dc2a6f8eea3c7120d4b13a5f5cd44467c3f9abedf",
      "en": "「Surpass me!\\nIf you have the resolve for it!」"
    },
    "59:6964": {
      "repository_source_sha256": "9e3e00080d169b34e6c18ee8f6b24fd032dbcdae76f3f2160d44673dae29d1e5",
      "en": "「I too... have burdens to bear!」"
    },
    "59:7001": {
      "repository_source_sha256": "bd0c6dfc8f496b6ed9bb2f2e83eaff7c71f15df07c0e23f71b4d5ac0640f9668",
      "en": "「My mission isn't over yet!\\nNot while I still live!」"
    },
    "59:7056": {
      "repository_source_sha256": "a8a393a36d151f38d70423858f9c253ceba16abf1ceee0e8de990138759b4c0f",
      "en": "「This pain leads my fighting aura\\nto even greater heights!」"
    },
    "59:7107": {
      "repository_source_sha256": "3de4dca76f49eb631da59f09684ee150d4a27660f56b65ab778e0381cc1b2ab1",
      "en": "「I'll give my all! And so will you!」"
    },
    "59:7144": {
      "repository_source_sha256": "56ea422d5f72d80dd92553ab5333c3408cbbe52fd73ae5e08989049478e4c189",
      "en": "「My resolve was settled long ago!」"
    },
    "59:7183": {
      "repository_source_sha256": "1f7c4da29208491e16ffaa1afda1cc4fa045b7092a1034e61ca83fdb022a51d7",
      "en": "「I'm Emperor and $$次元将$$!\\nDefeat is not permitted!」"
    },
    "59:7236": {
      "repository_source_sha256": "4d939c568686761c68ce86039efc0264044b36c4420ead41e3a96b61cf767108",
      "en": "「Guh! Will $$ラース・バビロン$$ fall...?!」"
    },
    "59:7279": {
      "repository_source_sha256": "e41bc2c408675a10fca94b39b77a3df897332d7e4a355a31f51421ad3cc2abb5",
      "en": "「That's it...!\\nThis is what I came to Earth for!」"
    },
    "59:7326": {
      "repository_source_sha256": "d21b486ec7f4aedfbe6cc4020380e5019a3208659d94c92b370cf024b269bea4",
      "en": "「$$ヴァイシュラバ$$...! They're strong...」"
    },
    "59:7365": {
      "repository_source_sha256": "2c203af738fb02e63e3a9989eb5aacd46db680a11c9cbd7264f75c83c4e5723d",
      "en": "「Of us two, the winner kills a god!」"
    },
    "59:7402": {
      "repository_source_sha256": "1488244408941e56ce56771001b9a494863382d620546ef28fd2ae597546f282",
      "en": "「This power...!\\nIt surpasses my four $$スフィア$$s!」"
    },
    "59:7453": {
      "repository_source_sha256": "d1c7b6f74da741efda070c87f703069d1b4fbf3e462b597e9a27838bd9f6b155",
      "en": "「I should have the power...! Why!?」"
    },
    "59:7496": {
      "repository_source_sha256": "bf437c28961998c80c5a5a6adbebc3294c2537132e24f3c319c9d1c370afa2a6",
      "en": "「Yes! You have god-killing power too!」"
    },
    "59:7537": {
      "repository_source_sha256": "f8aaaf7369057284bfa39aa68eb9c7af315bce8206e90d7cc63fa56125ae6015",
      "en": "「So 'Invincible' is no empty name!」"
    },
    "59:7578": {
      "repository_source_sha256": "4410aaa16f5714abb7e6a64757c549f37060750674088a6439168c70db1959bc",
      "en": "「Fine! Until this fight ends,\\ncall yourself Invincible!」"
    },
    "59:7641": {
      "repository_source_sha256": "dbeb42747baef0ec69103f014c7825be42a30c778ea42a054de6473af149a92d",
      "en": "「Cutting the dark...! True moonlight!」"
    },
    "59:7682": {
      "repository_source_sha256": "90a95d580aef12f6dc571332a80a1a7fafced29e3d0e7f9426c6a43f687c711e",
      "en": "「Sunlit radiance...! A true gallant!」"
    },
    "59:7725": {
      "repository_source_sha256": "48e33f40204f2022208892c5be0190858f6032dff39da7a91c290cfd5d7ebc1c",
      "en": "「Not bad...!\\nI can't dismiss this child anymore!」"
    },
    "59:7778": {
      "repository_source_sha256": "955d914f434500227dd2d92a4523f2ac42da9cdf118c9c2bcb8088477d330635",
      "en": "「Sunlight and pure feelings...!\\nThey give birth to power!」"
    },
    "59:7829": {
      "repository_source_sha256": "d58c4b5166bc529ca9851ea3f9f72da735ca5617168c4ddeceabfa63c359ba99",
      "en": "「Light and darkness, now one,\\nare giving this man power!」"
    },
    "59:7888": {
      "repository_source_sha256": "f2f9d74041c927580e7f268a9ab444f99b2b07995ca256cd204b63c112cf2047",
      "en": "「I see...! You're a god-killer too!」"
    },
    "59:7925": {
      "repository_source_sha256": "09edecce3ef25c8f1d68066da4d30c04d189d41a3f4134c72d8e4d54dfd47861",
      "en": "「Well done!\\nA warrior guided by Gundam indeed!」"
    },
    "59:7976": {
      "repository_source_sha256": "dbba3d1928dd3445e716bade42ca11ce8290fd6ad3ed88a0e4dbdf121da4f563",
      "en": "「It seems the Gundam of this universe\\nis a cut above the rest!」"
    },
    "59:8039": {
      "repository_source_sha256": "f75fa05b006b2192980fe2485bfdd9f6ed59e7a6e020e9619e539088cd5aac79",
      "en": "「That's it!\\nUse that power to fight, $$ニュータイプ$$!」"
    },
    "59:8090": {
      "repository_source_sha256": "3d1e013c16286408e384b47c680dc9aeeb43d3120dc611377d6280b523c603d0",
      "en": "「Admit it, $$イノベイター$$!\\nYour power exists for fighting!」"
    },
    "59:8210": {
      "repository_source_sha256": "50951134c6b4937a1a051d6b308f0e633023f89274b70977484f85368a00c425",
      "en": "「The Heart of Space gives you power!」"
    },
    "59:8245": {
      "repository_source_sha256": "c4d25233d16dc8e5d758a96f315b1c0f7b94cce7162d099054723d04a3db2484",
      "en": "「Now the beast of possibility wakes!」"
    },
    "59:8282": {
      "repository_source_sha256": "438a93d21c33baa84caab4d9a404b65885d4fd4b259c34ee4ac8a574b80c137d",
      "en": "「Right! Use that world-ending power!」"
    },
    "59:8325": {
      "repository_source_sha256": "18ce34f4abe3c56e61f2b4b63cc43549ae09e3dfad7ecd42ffe128e1bc501d90",
      "en": "「Beyond beast, beyond man,\\nthis one becomes god's warrior!」"
    },
    "59:8380": {
      "repository_source_sha256": "89c79aad708bfbed950f78fc46aae50481da15c3840cf7df2ec43d2a4902263e",
      "en": "「Nice, $$始原の特異点$$...!\\nYou may even be a singular warrior!」"
    },
    "59:8451": {
      "repository_source_sha256": "dd99d30feaff867685d7ade2730555dc31a9cf41f29cf49889aa93fb51fc98c4",
      "en": "「That's it!\\nKeep singing true to your life!」"
    },
    "59:8502": {
      "repository_source_sha256": "781a40d7c2d3255c557f87c61f77c8818826b3486aede39735655653ab8d6157",
      "en": "「His wings' path... reaches Infinity!」"
    },
    "59:8545": {
      "repository_source_sha256": "c9a564e0ec8f62b9b887cd4c0097111c3084d2ef459483b59af076c6453c2387",
      "en": "「A true demon god!\\nCornering even a god-killer like me!」"
    },
    "59:8594": {
      "repository_source_sha256": "b2b2628602e8f6b1b46b37140752619d0fe226ca2e615cc4be4cb7bc76f22105",
      "en": "「This man has made $$ゲッター線$$\\nhis own!」"
    },
    "59:8645": {
      "repository_source_sha256": "c984b763f58586dcacbfc89e37b90f235d5ed6c0a012b87ba79e5ab06800b606",
      "en": "「This man is starting infinite $$シンカ$$\\nalong with $$ゲッター線$$!」"
    },
    "59:8704": {
      "repository_source_sha256": "9d0aff9f45b3447b519e9b62697120932d16aee1df681679f8b4868afa5e63ae",
      "en": "「What could drive this civilian\\nthis far!?」"
    },
    "59:8757": {
      "repository_source_sha256": "ca7d08ec3076f34bde9607711fbf84c5dd599b368f60cdd87aeb66e1f930f0dd",
      "en": "「$$メガデウス$$! Beyond the will of god,\\nyou fight beside this man!」"
    },
    "59:8818": {
      "repository_source_sha256": "3e0ebf0890da85a51adead802ff60bce2af8d88282167f38791848d88758f115",
      "en": "「To corner even me,\\na man worthy of the name Demon King!」"
    },
    "59:8879": {
      "repository_source_sha256": "cb900a0a98c4e4a8b199b6fafa325246af493c42408144f40d70e69cde9de4eb",
      "en": "「Feelings about to overflow...!\\nWhat is this man's source of power!?」"
    },
    "59:8936": {
      "repository_source_sha256": "3a53c26f08ccb906aa1a220ebff3873c348bc5dd47d10559acfac5dc9c989d40",
      "en": "「I don't understand...!\\nWhat... is that thing!?」"
    },
    "59:8987": {
      "repository_source_sha256": "ab35ebecd1fbaefc760d3bceae2128f556ad20db9b93e304d9c0bb5aaf7aca3b",
      "en": "「That's it, Mechanical Angel!\\nTurn your old grudge into power too!」"
    },
    "59:9044": {
      "repository_source_sha256": "e19e1a3b35b39464bab4568b9b6761c8c9d8821b1832d94ead75bbeb754f0efa",
      "en": "「This power, a truly raging fire...!」"
    },
    "59:9081": {
      "repository_source_sha256": "c28f9a70b21b622cf554760e9879f6bff725cbe4b8e40f3e636872b6d09aeb0c",
      "en": "「Human wisdom that repelled $$バアル$$...!\\nA worthy opponent indeed!」"
    },
    "59:9142": {
      "repository_source_sha256": "ff39b85ba864654911fdd2b44b6ab0c5823ebe38934057cc2c0196298bc21572",
      "en": "「That's it!\\nGo all-out till that power runs out!」"
    },
    "59:9191": {
      "repository_source_sha256": "d0a7eb9f8d200d142b4d8d5c238cfadf1f4bc29d46463bcc130e467232920321",
      "en": "「Well done! You burn your own life\\nto spin that drill!」"
    }
  },

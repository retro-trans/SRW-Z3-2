{
  "schema": 1,
  "rows": {
    "59:9250": {
      "repository_source_sha256": "bd1c5d9974205dcd33cd98bcdbf60d06f973074dbb72a523c2b8a9ac8dbe1a68",
      "en": "「Spiral Man! You just might\\nbe able to pierce the galaxy!」"
    },
    "59:9315": {
      "repository_source_sha256": "15ba78463cc124113d5408dca92793d9ba26ecec20e4ca2b35e90db50dfffe5a",
      "en": "「Good! Give everything you have\\nto this very moment!」"
    },
    "59:9372": {
      "repository_source_sha256": "7d7bdd0e9a09aa4ddd0e513c360bde34c69fa75210aa37045915b0f0d4cc9000",
      "en": "「Warrior who surpassed a soldier!\\nYou've gained infinite potential!」"
    },
    "59:9427": {
      "repository_source_sha256": "cc426b0c79eb3d3936c91219c0e3fca7b43a27c8377aaba6927580511d3b6a43",
      "en": "「Feelings gathered on this ship...!\\nThey surpass even me!?」"
    },
    "59:9474": {
      "repository_source_sha256": "8ecdb7dec56aa3458aa87a844a81d2cd994ac0d9a82bcd9881f63e23ccfe435a",
      "en": "「Your $$スフィア$$ and my $$スフィア$$\\nare clashing!?」"
    },
    "59:9529": {
      "repository_source_sha256": "719d44a0dc7445b00ca9a1a814a2ca08a1c9ac372ff1e2fb4acab968f277635e",
      "en": "「It seems you're just like me...!」"
    },
    "59:9570": {
      "repository_source_sha256": "1b3b763754f033215ed31e3d0c19d9e559a6949a54a921bf8f151661927955db",
      "en": "「Even with four $$スフィア$$s,\\nI can't beat this one!?」"
    },
    "59:9627": {
      "repository_source_sha256": "0e1ad473a66ad4141718feb169823661cf84633165b3ef9bf5d12e1e1bc18cfb",
      "en": "「The 12 keys, $$ソル$$'s memory...!\\nI will... not lose!」"
    },
    "59:9674": {
      "repository_source_sha256": "ae81143def6651424ddd6b231a44f0dae3c4fb120bd10200497492f550fdfd1b",
      "en": "「This is strength beyond sorrow!?」"
    },
    "59:9711": {
      "repository_source_sha256": "afd75b82530845cfbfcc6944d392816f14056f821ced3b2a1b931d2bd6b475d1",
      "en": "「A lion turns pain into strength!?」"
    },
    "59:9752": {
      "repository_source_sha256": "a1865baa59fd1c7e03d02f30f8a2dac89a8c76ce8f20eed7cebaa56e65e6fa24",
      "en": "「A will that never breaks is now\\nabout to pierce my fighting aura!」"
    },
    "59:9811": {
      "repository_source_sha256": "082a20135655c94ce8b0e0996b3a4462f90f47aabfef9e9d4f22f5f79fe2e472",
      "en": "「$$いがみ合う双子$$!\\nYou've... grown strong!」"
    },
    "59:9858": {
      "repository_source_sha256": "0e71dd6063dff91e3d5d20c95670e9ebd48e1fda46af2729c439b7d60c744956",
      "en": "「Waiting for you to grow paid off!」"
    },
    "59:6281": {
      "repository_source_sha256": "f44ec636ff00c144ac64c740cd0e2c98a935592c2a690947e4f24096d6678ce9",
      "en": "「That's it...!\\nBurn your fighting spirit out!」"
    },
    "59:6328": {
      "repository_source_sha256": "22ddb6ab6788e9b0531b2a6205a339e7e830465c8cb3807d3b7c85985eb2a78b",
      "en": "「Fine spirit...! That's the way!」"
    },
    "59:6363": {
      "repository_source_sha256": "7dae6e93b9044247247b37285aec0c52acb069971649a19c65319f2746775339",
      "en": "「I admit it: you're a top warrior!」"
    },
    "59:6406": {
      "repository_source_sha256": "f2fc6a3c6d30822528f0ff8aa07c4e1a511041921965b465d38f240c13596efd",
      "en": "「Otherwise, those you defeated\\ncould never rest in peace...!」"
    },
    "59:6465": {
      "repository_source_sha256": "f6b6fb7b11e6c8cf5b29dbf62c99d34cc7257efc20b61ebc7d25bc129cd9de74",
      "en": "「Your power too shall become\\na part of my fighting aura...!」"
    },
    "59:6514": {
      "repository_source_sha256": "70bcf7fda5439c4fad871ef76d27fea74071dc4e62cb073bcdac3b7e014f5ecb",
      "en": "「The more I'm wounded, the stronger\\nthe rebel in my heart grows...!」"
    },
    "59:6567": {
      "repository_source_sha256": "1bb91cbac615ec8cadcde0246597c57740731e1b2b4e637784fa1503dd0f20fd",
      "en": "「Indeed, all starts on this planet!」"
    },
    "59:6604": {
      "repository_source_sha256": "ade100e2b72f14167d72594898fdbe4e2645697b3c526d0f357c49d0989a993f",
      "en": "「Your potential has begun to awaken!」"
    },
    "59:6645": {
      "repository_source_sha256": "c2fcb01f4c531f3ea5f49ffbb8b0fb976ee04ae8af32585777acf7341f507e80",
      "en": "「Now my taking the field has meaning!」"
    },
    "59:6684": {
      "repository_source_sha256": "91247b84f746fe6eba4362ba1dc6ee9189365e1750b0b53a50776355824b6afa",
      "en": "「A fine attack...!\\nBut I too bear the name of Emperor!」"
    },
    "59:6737": {
      "repository_source_sha256": "c1dbe68baa0ad761a90cfa8a6b1b04fc93f35a5a93d0e1edf1b8a9eeb442bde8",
      "en": "「The four $$スフィア$$s in me rejoice...!」"
    },
    "59:6780": {
      "repository_source_sha256": "b428a576ed061754be8a71e2e6950d0a193ef2ca7101001637462ac492c68454",
      "en": "「You match god-killing power...!」"
    },
    "59:5540": {
      "repository_source_sha256": "e23967e3e46ce3a1346723e4f75dd2afe1db117445009a52066d36811c4a4990",
      "en": "「If you're playing, leave this place.」"
    },
    "59:5575": {
      "repository_source_sha256": "bc2cea34cbb85edd9c398832a450e0dd5a78209aa72ccc86dd84c409ed5301dc",
      "en": "「You've no right to stand before me.」"
    },
    "59:5608": {
      "repository_source_sha256": "7058e997024b8886a5dec8de2183e408b6c59c46710c9d7d2e8736d00194db7f",
      "en": "「I can't believe you've survived!」"
    },
    "59:5651": {
      "repository_source_sha256": "ba57910425818a24c76562eed2d57a0b3b33cb9e29c3e51ef31b4dcb7295b94f",
      "en": "「You are... weak.」"
    },
    "59:5668": {
      "repository_source_sha256": "74d1b6f6c6a1b9b907818b3a93ed8fdfe24e3b9513a254cdbb261d724e3c948b",
      "en": "「I was a fool to expect from you.」"
    },
    "59:5711": {
      "repository_source_sha256": "863fb60f4878054bdda13e101eef5745670d7d311a214d3f7d2fa426e4409af7",
      "en": "「Why did they lose to such people...」"
    },
    "59:5748": {
      "repository_source_sha256": "9dbfe721dac4f84fedc1dfd4273b16a1ae8988369814d96e66e9271123b4a803",
      "en": "「That power can protect nothing...!」"
    },
    "59:5779": {
      "repository_source_sha256": "e79c9c68beef9bdc2ea665b894500b2999d7c119b3eecd48668a0621ea5296e1",
      "en": "「What are you holding back for!?\\nIs this the time? Think!」"
    },
    "59:5830": {
      "repository_source_sha256": "e379b3f91aacc80313dab61d81915a38a4afc591ad0a15219d93462cb4eee383",
      "en": "「The powerless protect nothing...!」"
    },
    "59:5859": {
      "repository_source_sha256": "6b62f3e80db71a8f7b74835b502c0352268630719143abd11ddea188fb04f118",
      "en": "「Your softness brought this about...!」"
    },
    "59:5902": {
      "repository_source_sha256": "49edb0bbb79c4bdeb1fa77e282402e82f26b5fdbe707aa075ad1ecf1d9b98861",
      "en": "「Do not... disappoint me!」"
    },
    "59:5927": {
      "repository_source_sha256": "84a4175198f01ca8018b628f193b18f8cd6bcc32d361e82421702abdd5eca26e",
      "en": "「A limp attack won't beat me!」"
    },
    "59:5968": {
      "repository_source_sha256": "bdc72fb65fde61d650403e16e169675394ebd04e4f54c3f2954f11fbb01debd9",
      "en": "「That $$スフィア$$ does not suit you...!」"
    },
    "59:6009": {
      "repository_source_sha256": "021cf6c0b1826c0e759b88e85dbc8f2cf6f2acb08d6aa77b09bfc2f9e200a568",
      "en": "「I cannot let one unworthy\\nkeep a $$スフィア$$...!」"
    },
    "59:6070": {
      "repository_source_sha256": "f2f7910b3c577e31802e0f1dbcefa3b39288ed79430782cb0414481b01af28c1",
      "en": "「Grieving alone won't defeat me!」"
    },
    "59:6113": {
      "repository_source_sha256": "9521571fe629c4cab4e5d54d91ba8a5ee220f58d2232eeb3379ef52487535cda",
      "en": "「All you do is howl, $$傷だらけの獅子$$?」"
    },
    "59:6148": {
      "repository_source_sha256": "ab9e70dd8fb6725446ff81ac32940f1f697c2638a0cd3c8475009311f90ad96a",
      "en": "「Not even your will can\\npierce my fighting aura, it seems!」"
    },
    "59:6197": {
      "repository_source_sha256": "d5c06f39bf1ee2c617af37977096f8deec40016a949d72c3e3ef4a3d7d9259c9",
      "en": "「You're immature, $$いがみ合う双子$$!」"
    },
    "59:6228": {
      "repository_source_sha256": "6d4a019872b918111c3974c9718d2d42c5d4d2acddbcbfbb9b8452ffb30f4312",
      "en": "「Relying on $$スフィア$$s means\\nyou've no right to fight me...!」"
    },
    "59:5175": {
      "repository_source_sha256": "c70250910af2fddc821456c6338f7a326933d965a3deedf80e1f4d83908cfb56",
      "en": "「Do not disappoint me.」"
    },
    "59:5196": {
      "repository_source_sha256": "f25bf06b538b5bb683e4ff347b02bdaf4a23c464d8f92fa88caabad43e653209",
      "en": "「Focus. Your fighting aura wavers.」"
    },
    "59:5237": {
      "repository_source_sha256": "9507e96664fcf5f78bf562932518490e0ce869aa98360569e8ef2c8f70507100",
      "en": "「Is that an all-out attack?」"
    },
    "59:5270": {
      "repository_source_sha256": "792c18184095806511898e98b7e85035cca7737da93f196c63b26f12e330c470",
      "en": "「I can even see your future.」"
    },
    "59:5297": {
      "repository_source_sha256": "64a31b244a47a50f567c241b701b41917343154e1076a26f7d011ee9b918d6e7",
      "en": "「Don't think petty tricks work on me.」"
    },
    "59:5336": {
      "repository_source_sha256": "ca5e10eadb4ce668e49a490c21aecc6d0b399c77b9bd3da4213702cae9102b99",
      "en": "「Show me all that you are.」"
    },
    "59:5367": {
      "repository_source_sha256": "836c89047ad041d0f7bf34d4a773cdaad86073494a1224281e3512664f158762",
      "en": "「Brute force alone\\ncannot even touch me.」"
    },
    "59:5416": {
      "repository_source_sha256": "8dc1b154fe3407130821bfec82e78bbe2e732a3f804b3528309d4c2de6173920",
      "en": "「I saw this result coming.」"
    },
    "59:5501": {
      "repository_source_sha256": "93b9a3db7934e2d120fbd7a1b02bcd00d46e9f16158cfb2f671707c84a978a39",
      "en": "「At least leave one scratch.」"
    },
    "59:5441": {
      "repository_source_sha256": "0ec079bfc40821fa35fe0a380bf737e0636056ab728023c44b60e5bb1452296e",
      "en": "「You couldn't break the barrier.」"
    },
    "59:5466": {
      "repository_source_sha256": "b5a07d187345876dfb29f8b31c24be6bf94821f586af25046ad6dfe8f5494782",
      "en": "「If that is your all, it is pitiful.」"
    },
    "59:10055": {
      "repository_source_sha256": "4855269980af30698eb79c225274f38b2374399b770930657f07b06158b2b864",
      "en": "「I am $$アウストラリス$$, Emperor of the $$新地球皇国$$.」"
    },
    "59:10102": {
      "repository_source_sha256": "5c09aa97a94d37d6c7be6ed9bc9b520721d19e22a594e14c802c0c78abd1efa4",
      "en": "「Earthlings. Train, learn, and rise.」"
    },
    "59:10135": {
      "repository_source_sha256": "cfa2643bce4e6299358343031944df2e322f73661ebfd77ea207ae534a466d7f",
      "en": "「Rest, recover, and challenge me again.」"
    },
    "59:10196": {
      "repository_source_sha256": "c27d4d993c39087fc57d87acf7b5243cf22e1fa4eb2bfae6c3cad3ed002353f5",
      "en": "「I await you in $$ラース・バビロン$$!」"
    },
    "59:4820": {
      "repository_source_sha256": "417c01b1dfafe9f2621e87cfb3c8ff3803cd34ca97da9d3afbc3044980921a59",
      "en": "「This too is my duty.」"
    },
    "59:4841": {
      "repository_source_sha256": "a1ec09ecb02b1b36ba3e67aecbf549cad5c9a9c3d5be92a38c6b6a9e221bfb58",
      "en": "「If you're a hindrance, fall back!」"
    },
    "59:4968": {
      "repository_source_sha256": "42603318dfd8eeed4fb15d04aaae00cc9b499c42aafe7bc484dc268553bc3612",
      "en": "「Struggle...!\\nUse every means to win!」"
    },
    "59:5017": {
      "repository_source_sha256": "5b5c5120dc1eb25d4767c86909baa08ca6e8f6e13db3cf0336ee1616e81af4cf",
      "en": "「A clever move. I shall commend you.」"
    },
    "59:5044": {
      "repository_source_sha256": "8113e0f636f2f699f8e68137fd5095777589fc6a1837889c983c65aa44dadfa8",
      "en": "「One with the skill and wits\\nto outmaneuver even me...!」"
    },
    "59:5099": {
      "repository_source_sha256": "08b912bb196971dde57bbbd247fd1aa6b1c576e1c1fbe8b09344e774d3783b57",
      "en": "「You will pay for this disgrace\\nwith your life...!」"
    },
    "59:5148": {
      "repository_source_sha256": "22062ec7c908e00ac881115332cf28105456112b9b27d9691842ced38fff56da",
      "en": "「You sealed my fighting technique...!」"
    },
    "59:10245": {
      "repository_source_sha256": "8efc989ed09510ca73b57d77ae6c6d88b6c609af253b283b4685ef9afea58403",
      "en": "「Farewell, $$ガドライト・メオンサム$$!」"
    },
    "59:10315": {
      "repository_source_sha256": "f60bd8a3a8b6becbb18aad28bdb5e7eb9d7849adb93dc3ae5eef9f594e77390f",
      "en": "「Now I unleash everything!」"
    },
    "59:10342": {
      "repository_source_sha256": "4ea16a04456a7c45b08cc4c6dff5ae2bccbc807edc8e8458ed5d7d5c76557e01",
      "en": "「Together with my fighting aura!」"
    },
    "59:10367": {
      "repository_source_sha256": "41f48d0048de4df65af56d521f77a744a63cc9d2dbdd94d44bcf107201e40173",
      "en": "「Not yet!」"
    },
    "59:10382": {
      "repository_source_sha256": "6b2281878cc3378bd1e78dfc6a12813547cef80739960dee0306c207743ead7f",
      "en": "「This is the power beyond the end!!」"
    },
    "59:10413": {
      "repository_source_sha256": "faa20e7d39189f548ea0739bde11817011a071fd14f4ca70d69cad080524f1e2",
      "en": "「I have obtained god-killing power!」"
    },
    "59:10469": {
      "repository_source_sha256": "d80455f31fb8d9150d7d33885f7d277be813fb3d42c89c49dd3f53418ec0dac1",
      "en": "「I'll finish this...!」"
    },
    "59:10484": {
      "repository_source_sha256": "28a37d75863e4515eeec2808a97bb21f0bbc827b6828772bed0ebf13524633fd",
      "en": "「I will annihilate that causality!!」"
    },
    "59:10509": {
      "repository_source_sha256": "7d58cdd6342fc2331d7655f51b2c5c93735c0409d07ddbaf04b917c1f84363c9",
      "en": "「$$エルーナルーナ$$, $$尸空#pilot$$, $$バルビエル$$...!」"
    },
    "59:10550": {
      "repository_source_sha256": "3166bc264cd0301e10e5117d45163b7971a4f0ca7ca943b77f38c6d37e73cfde",
      "en": "「I will use your power too...!」"
    },
    "59:10575": {
      "repository_source_sha256": "ecdfe1469c248ed1e71ca53db209e81285b1da5c3d86dc5dac53672eda84c4c2",
      "en": "「I fight!」"
    },
    "59:10590": {
      "repository_source_sha256": "7cf9ec4628ceb92db8872768fcd98706c33b87fa07e4a7dfca23db16edc46ce5",
      "en": "「Together with this $$立ち上がる射手$$!!」"
    },
    "59:10623": {
      "repository_source_sha256": "5f8d8644011b2586287706b3f149b35f30288719f27f3533daa120aa4ab3e558",
      "en": "「Endless war... memories of despair!」"
    },
    "59:10654": {
      "repository_source_sha256": "b2e738a5b84578bca66c675f4e5bacf96dc8f3b609e2b786ee7e7e2e385027f6",
      "en": "「I will surpass it...!」"
    }

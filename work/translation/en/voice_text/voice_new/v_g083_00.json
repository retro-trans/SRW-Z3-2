    },
    "83:2671": {
      "repository_source_sha256": "6542122954ddcc3f6ab8cc74d7c62a14b3dddd1994d6342136823a990882192b",
      "en": "「I won't lose to you guys\\nwho just follow orders!」"
    },
    "83:2730": {
      "repository_source_sha256": "affd523792da861d071a9c1e707af46cbf0af12f7f99335821c701418d7e94b1",
      "en": "「A Gundam showdown!\\nI'm not losing!!」"
    },
    "83:2777": {
      "repository_source_sha256": "388e6845cfbde57c4ad8ff280dfe66d207e71cfef21cff6fd6c1a153d5d61d6b",
      "en": "「I'll knock this Gundam down\\nand sell it off!」"
    },
    "83:2893": {
      "repository_source_sha256": "55b1401dbc529821d108802b4a496ba23b6268eba15e33546769d44d25310afb",
      "en": "「Even without any special power!」"
    },
    "83:2924": {
      "repository_source_sha256": "51bdc9ac7bac19f7620e3f6485feb800af8b86e4d16ed51629c0b6bc7c28280b",
      "en": "「Bigger doesn't mean stronger!\\nHere I come!」"
    },
    "83:2979": {
      "repository_source_sha256": "ba9182c16a4bdc3fea7dfad1ac07e178bcc588320e18447643ef2bc9b3efe08b",
      "en": "「Thugs like you are a piece of cake!」"
    },
    "83:3022": {
      "repository_source_sha256": "cd8bd4a58163837f22445311590c70854bd1c970793d3e22f539e3d035004b9d",
      "en": "「Ideals and ideology are fine,\\nbut don't drag others into it!」"
    },
    "83:3079": {
      "repository_source_sha256": "e0ad7b6bd01674ef09d1a39f70ea4c92baa3e8ade4958a1218ad761e01346f08",
      "en": "「Don't screw with me, you bastard!\\nI'm not doing this for fun!!」"
    },
    "83:5295": {
      "repository_source_sha256": "de7917f6fc972a9b44cf955630ddfc6ea5c463ecaa1a2fba142180fd10847bb5",
      "en": "「I always fight to protect $$ティファ$$!」"
    },
    "83:5344": {
      "repository_source_sha256": "2616d70146ac47fad5997e4490f42d1f17c5018141b64fec77f9960e16950e15",
      "en": "「Let's do it, DX!」"
    },
    "83:5363": {
      "repository_source_sha256": "e971f2791ae23532724a8d02267e6ccd5fa694b946c08fcdc80f0d6716d55242",
      "en": "「The name Fiery Mobile Suit Pilot\\nisn't for show! I'll prove it!」"
    },
    "83:5428": {
      "repository_source_sha256": "e3248277464dc06298dbf07702546ee94d6f8cd3474ee23867abc1219e18264a",
      "en": "「How's this!」"
    },
    "83:5449": {
      "repository_source_sha256": "7dbfb7d2ea99d2778a7e7b9ebd513d369e328a1977a76e285b5766fecb6c06c8",

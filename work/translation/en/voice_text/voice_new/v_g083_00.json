    },
    "83:2472": {
      "repository_source_sha256": "bb0d1d06eb91334058414d84548281cf9ef8b4512499eebbb3680b1addcd7ded",
      "en": "「DX! $$ガロード$$ is going in!」"
    },
    "83:2569": {
      "repository_source_sha256": "dd0c0fbbcd5078ca0b20f2e0a4640d2c6bfb1ae0e3746196cb9b50503798252d",
      "en": "「Carrying the army's banner\\ndoesn't make you better than me!」"
    },
    "83:2628": {
      "repository_source_sha256": "c72247ba9bfc590a63cb48ab0a5668ef42cfaa481085cc5d67ac4e41ca211258",

      "en": "「Give me a break already!」"
    },
    "83:1111": {
      "repository_source_sha256": "bceac6378e17fab9d05c4565567ce435bf413e210a2b422e2d367aea82588d48",
      "en": "「Ugh! Damn, where's the enemy!?」"
    },
    "83:1150": {
      "repository_source_sha256": "41390a8c64c8524f15efd40add0c97b07f68c49fd467d1447621e5cbad239346",
      "en": "「Damn!\\nWhere did that hit me!? Where!?」"
    },
    "83:1201": {
      "repository_source_sha256": "89a9123dc88d0bc7e575d9df28304da367ab179dc904d9fb68bddf92df8b8f96",
      "en": "「Tch,\\nyou scratched my Gundam!」"
    },
    "83:4274": {
      "repository_source_sha256": "6ebbc0a32c1fca5700586896845c173564d077a7258f7abd5b24407c2a313b5c",
      "en": "「Ngh! I'm not done yet!」"
    },
    "83:4301": {
      "repository_source_sha256": "120973976f202f4d55a422cac8fa617543a4002ade63df47b3a250ae29b263bc",
      "en": "「I-I hope nothing broke\\nfrom that hit...!」"
    },
    "83:4350": {
      "repository_source_sha256": "f9d36ca8d8c37b66c7b9264a47bb1a283ef457c676720f4c52e7bc5899e8f3b0",
      "en": "「Guh...! I can't lose here!」"
    },
    "83:4389": {
      "repository_source_sha256": "657c6f0d489fa14e4b1598df8dc25c84b7c656d0b7d03d3e71c70ea362e6c3c0",
      "en": "「This is nothing!\\nA little guts and I'm fine!」"
    },
    "83:4438": {
      "repository_source_sha256": "1a76486c03e7d790acc6e3b7e01023f7c66e785f231019d59e6b318b9084e8b4",
      "en": "「This guy! There's no wasted motion!」"
    },
    "83:4471": {
      "repository_source_sha256": "ff4781f7587141392620108bb26dceba60d657cbb758fea8bf0889c3ba51c048",
      "en": "「Damn!\\nIs this that Gundam's power...!?」"
    },
    "83:4528": {
      "repository_source_sha256": "9bd8cb953d659e80a22b6a4538dd6420172955866de79d70d8e205dd5ad71bc2",
      "en": "「That other Gundam is pretty good!」"
    },
    "83:4571": {
      "repository_source_sha256": "df9bd0dd83cefdf3f5aa0e7caaae6a69f4504d3253b79250ef773b6e99419bc5",
      "en": "「They're reading my moves...!\\nIs this the power of a $$ニュータイプ$$...!」"
    },
    "83:4638": {
      "repository_source_sha256": "037469661807af09ad22f3a29cf4f7b93638f78fd6a0611a1460f6ef0943837f",
      "en": "「These moves...aren't normal!」"
    },
    "83:1250": {
      "repository_source_sha256": "d725c017b51becc60a72fa4b207fcafc92c1d40cc40178babfb0326372905ba4",
      "en": "「Tch, it hit me!\\nWhatever happens, happens!」"
    },
    "83:1305": {
      "repository_source_sha256": "d75bc572df8bf2e716d93b370ef95cc4d3eec1738656a1dd9e80ae64e643f826",
      "en": "「Heh! Is that all you've got!」"
    },
    "83:1332": {
      "repository_source_sha256": "6c9e00fd2578c9434a1cc76f7b5bd7152fb2e805a4de873d51ecd5e6e64157ae",
      "en": "「Like that'd ever work on me!」"
    },
    "83:1361": {
      "repository_source_sha256": "3be4c7a1e205fd92bba140edff9ea51ef103e52036c13fa7ea3b32f645be8a83",
      "en": "「As expected of a Gundam!\\nAn attack like that is nothing, huh!」"
    },
    "83:1426": {
      "repository_source_sha256": "a592c344ab7de7f496a05d70cbc00bad69cfeea9a7268627b2b92c0a81cb3ff1",
      "en": "「What's wrong? No need to hold back!」"
    },
    "83:1465": {
      "repository_source_sha256": "d4fb47428544bc3fab99ec064de7c25dfb5f620bb74ba230f9058e4ef1cb5f25",
      "en": "「I took a hit!?\\nBut I can still keep going!」"
    },
    "83:4046": {
      "repository_source_sha256": "d5ca937b11eff3843806530248f850fceecf4a4b6e5b8cb4476038090c0d0981",
      "en": "「I won't fall to that attack!」"
    },
    "83:4077": {
      "repository_source_sha256": "b426534bc67b10e7cb2055e8f121600659d9368261d08f1800991a8395ef2d20",
      "en": "「Without a direct hit, this is nothing...!」"
    },
    "83:4112": {
      "repository_source_sha256": "225ad67da8c305d2d1911684700f46d4442851450b330758bba1fbc6b5369995",
      "en": "「That's nothing!」"
    },
    "83:4135": {
      "repository_source_sha256": "87d13423923c5ce6a7c16cc123e8a14a8d92cca87d5f6768d0cfbdeda82871eb",
      "en": "「I'm not going down that easily!」"
    },
    "83:4168": {
      "repository_source_sha256": "61d8b9085dbbc023a0c2c35b6e15e9038cbd002383b58c4b858abb6db30410ee",
      "en": "「What's wrong!\\nIs that all the Gundam's power is!」"
    },
    "83:4219": {
      "repository_source_sha256": "f7071b4ef863a14355cd819114286516d3136066bfe4e166ca71d9167512eaa5",
      "en": "「The other world's Gundam\\ndoesn't seem like much...!」"
    },
    "83:1518": {
      "repository_source_sha256": "570a6cf3a6d03fa99772e4b1f7241e0b2c15dce6c5e2565f3b0f681425e169e2",
      "en": "「Phew...I thought I was dead...」"
    },
    "83:1547": {
      "repository_source_sha256": "7746417aa840961a341799e73d44c1edcc040ec2032b4f3b4dca9dc5a8e72259",
      "en": "「Ha, I was waiting for that!」"
    },
    "83:1576": {
      "repository_source_sha256": "036356970f2dec54e4944ae95accfd72009e246b1877d5c7cfedfcf835b17c49",
      "en": "「I won't get hit again!!」"
    },
    "83:1607": {
      "repository_source_sha256": "763cebe090d37ad47c513edbb67b036348d596a933b88d7a21c5dd100b436ecf",
      "en": "「Heh, you underestimated my mobility!」"
    },
    "83:1646": {
      "repository_source_sha256": "1fce3cfc4e66f9ca3a2ca098d9f2ec18714459f5afdf00ec66786dec2a283588",
      "en": "「Whoop! See, you can't hit me!」"
    },
    "83:1681": {
      "repository_source_sha256": "a09f185f7a7575b1a2a4615daa780444643ad5cc165e0d52ed308233ee4e3bb2",
      "en": "「Just the attack I expected!」"
    },
    "83:1708": {
      "repository_source_sha256": "ed0cdaece663da29d9517d72bc29f9045ec9d17ae7b3a570b0992b7844a7a5f4",
      "en": "「Like an attack that weak\\ncould hit a Gundam!」"
    },
    "83:3687": {
      "repository_source_sha256": "08d7f7e61c9ce91e9193f08a9abaaa318467fce41d1cd3d68f4c77498284818d",
      "en": "「Dodged! Who's my next opponent!?」"
    },
    "83:3726": {
      "repository_source_sha256": "dc66dd5512f881261534c53a66e1cbd570eb44aa0f1fdb93e8975f139d3f27b8",
      "en": "「Hehe! Don't you underestimate me!」"
    },
    "83:3767": {
      "repository_source_sha256": "3d93f60c70b399373249f55a2a3f3c184a1eb64725f7304a7d887b924dcdfb6f",
      "en": "「Like that feeble thing could hit me!」"
    },
    "83:3804": {
      "repository_source_sha256": "057c732d9e2e40bd48ea3b6c82beeb0bd212b86503ca17fec7144ba06716a0c9",
      "en": "「Whoa! Safe by a hair!」"
    },
    "83:3833": {
      "repository_source_sha256": "dcddf23447402bf649e1063925386d3e8500b9cdd2e7463993c5bc80eb1fb90e",
      "en": "「If I move faster than they sense!」"
    },
    "83:3876": {
      "repository_source_sha256": "b9a793e695e19b532fc8a6623794d4fa7835d6ca0cc2a170f6d3206823a1e7a4",
      "en": "「Just because you're a $$ニュータイプ$$!」"
    },
    "83:3913": {
      "repository_source_sha256": "d926119ee69b35b86f28afdc81e47dd0db56d224811b1581ac58be8e14552a2d",
      "en": "「I can't afford to get hit\\nby a Gundam's attack!」"
    },
    "83:3962": {
      "repository_source_sha256": "b2f2d2266c04d3f4cb893bc8ebfe3c280c482de94da1de4f9f6d2e12229c9e4b",
      "en": "「It's worlds apart from a normal\\nmobile suit's firepower!」"
    },
    "83:1757": {
      "repository_source_sha256": "9c364eefefeb56c659aa190c9cdc49d5ed6dd8cbc6da432bbb1c5617d95361cf",
      "en": "「That won't work on me!」"
    },
    "83:1790": {
      "repository_source_sha256": "e43c289f525c05619394e3ddb9907fef8aaeb380ed0d01946b0d55402450a30c",
      "en": "「Sorry, but it's useless!!」"
    },
    "83:1887": {
      "repository_source_sha256": "b3f738df7ed8a497b989805dc5cad047c019bfd275a7db047b660c512c0c133b",
      "en": "「$$ティファ$$, guide me!」"
    },
    "83:1918": {
      "repository_source_sha256": "1ef97b6811708ab11f082c4a1f2bed52dd8861e40cce21135ec00c7275745702",
      "en": "「An enemy is coming...」"
    },
    "83:2057": {
      "repository_source_sha256": "47b2200069e50f466a82bc45cd53856c319fe6b3d6738398f505593bf6bf1f67",
      "en": "「$$ガロード$$...you won't lose.」"
    },
    "83:2090": {
      "repository_source_sha256": "d200ebd1ce41da52d67f557b7f62599bee898e16ed1f2701d715ea8453cdfa62",
      "en": "「Huh? Me...? Th-then...」"
    },
    "83:2125": {
      "repository_source_sha256": "903fe82bece0aca8df4cdf1aaf062db383045e14b720eb70d5a5defb37ba75b0",
      "en": "「...Please...promise me. Promise you'll come back, no matter what. To end this war quickly, too...」"
    },
    "83:2836": {
      "repository_source_sha256": "4e0f3178a90dae2540937148b9e83501f8b4b01813ed0d56e146eb0990c6c538",
      "en": "「I won't accept you people!\\nI won't accept you!!」"
    },
    "83:5080": {
      "repository_source_sha256": "1d6a60765a618cda31d6d1ac7978187cdcc262d6fca8b84016ae31a1cffe1b92",
      "en": "「$$ティファ$$! Come on, $$ティファ$$! Come say a few last words!」"
    },
    "83:5155": {
      "repository_source_sha256": "950be6bfd39ad13ba5ba710cc7b634ae7b4bba2946af66b1d9da1c6e161c15a9",
      "en": "「You're lucky to get a message from $$ティファ$$! I guarantee your luck!」"
    },
    "83:5246": {
      "repository_source_sha256": "0cc3b39dba44e36d3c453e361481fc733393d8cde04891bc0b4d3d169b92c1ef",
      "en": "「Luck's always right there! See ya!」"
    },
    "83:5762": {
      "repository_source_sha256": "e528750ca1682c148f8a52111a883c45b70673dc545a1b2414a4cd238523c876",
      "en": "「Go down!」"
    },
    "83:7961": {
      "repository_source_sha256": "ba42dc5c5b128de9b78e4250d19c184435855ab19842e953eacf7ff9f6938826",
      "en": "「Game over...there. Off to see $$ティファ$$.」"
    },
    "83:8012": {
      "repository_source_sha256": "695ac26182f2545c4330da755df48f5e6e249760a8ba892a1378b516eb474f43",
      "en": "「I know that without being told. I'll live with $$ティファ$$ anyway.」"
    },
    "83:8091": {
      "repository_source_sha256": "c802e7b52ce823b9ad410a25060a11b0f5af32695641a9ff77642c0fe248e2dd",
      "en": "「Be more honest too. Being true to your feelings is more fun.」"
    },
    "83:8164": {
      "repository_source_sha256": "895a25242715d1c1d9dcd20641c6865e508f85ee8b5ce186a54af3e31251293e",
      "en": "「Later, players. You only live once, so live without regrets.」"
    }

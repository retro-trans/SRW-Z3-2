{
  "schema": 1,
  "rows": {
    "88:0": {
      "repository_source_sha256": "f8e8cb3b76cfd86345b4c53c131181d72252fc85ede479f98d7de4bb12385c21",
      "en": "「The Queen's power is already ours!」"
    },
    "88:31": {
      "repository_source_sha256": "97f924cc1a0d0acc447a87c92a06fc79492136320a8c338a03b725fe5c40f6ef",
      "en": "「This is our power, fused with $$バジュラ$$!」"
    },
    "88:72": {
      "repository_source_sha256": "e10d0e71991e8ef806b9192835681ce392af2c1d53691dff8f930e210f53011b",
      "en": "「I feel it... this is $$バジュラ$$ power!」"
    },
    "88:105": {
      "repository_source_sha256": "914f1f71388b278e814b895b18fed0e83172a57b02dafe20fb249f2b9da1e0c2",
      "en": "「At last, we have it.\\nThe power even Protoculture feared!」"
    },
    "88:170": {
      "repository_source_sha256": "a5ae711c6626ef4a25467dcdb574668daaff668fa40dbc3ff2311c4a07baa906",
      "en": "「With this power... all will be ours!」"
    },
    "88:211": {
      "repository_source_sha256": "16206ff0196ae195fb362962746e02860d5fd8d1b7c9ba4e75c7a095d9ef81a0",
      "en": "「Hold the Queen, and victory is ours!」"
    },
    "88:252": {
      "repository_source_sha256": "57de0e028a0a07233963207e0ad4a44c5b215f9face04fc3c3f2279a2fafe269",
      "en": "「You have no future but death!」"
    },
    "88:285": {
      "repository_source_sha256": "857cf39d244cdedd80f7844548d0c05caab0383947cca0953e7ad4167df79155",
      "en": "「Now, bow down before our power!」"
    },
    "88:318": {
      "repository_source_sha256": "4e8bdb3e8f75b39f38c2216af9ec6b5ef03a3f2cedf3656764b115f8fa83a934",
      "en": "「You're no match for us anymore!」"
    },
    "88:357": {
      "repository_source_sha256": "ba5a44965de35e7e094c8146232a66063962e3cfccb675bb7685448b85523c44",
      "en": "「Annoying insects must be wiped out!」"
    },
    "88:388": {
      "repository_source_sha256": "8e7d758800468168d568e4282c609395e1e8c12117226369d30fac5abe3c821f",
      "en": "「So you broke through $$バジュラ$$ defenses.」"
    },
    "88:423": {
      "repository_source_sha256": "be1f1bbdba780017547215e9f45f0250944db12ae2176cecf2cacc9bdb4960e6",
      "en": "「Then we'll finish you ourselves.」"
    },
    "88:458": {
      "repository_source_sha256": "803e9824dfffe5c7413d12a917be47ee54fb8e826f56c6eca192d619dee460cd",
      "en": "「Ha ha ha...! The galaxy is...」"
    },
    "88:483": {
      "repository_source_sha256": "02437e2e65dfa24e9e3963861377a6e219beac920afc91e1dd72712fc5d2a6f7",
      "en": "「...already ours!」"
    },
    "88:547": {
      "repository_source_sha256": "2cb7fa3f6070634f484475dff2cc59918ece71cc741eef70c0fc2033470916ab",
      "en": "「We'll erase you, along with\\nQueen and Fairy!」"
    },
    "88:598": {
      "repository_source_sha256": "691ebfcece6648ac99fae7c1c9dfb4699a5fa0694bc3fb8fcd0615f946547630",
      "en": "「$$オズマ・リー$$,\\ndie together with Queen!」"
    },
    "88:647": {
      "repository_source_sha256": "d2a9f8debe3d4e24e76471dba616a9c6ac965c7a9704a50506719d93ecd70e10",
      "en": "「You're a strange bunch.」"
    },
    "88:666": {
      "repository_source_sha256": "947302ae10669d8de170b28f9b0e001ea7a40cb663bd79aefbc6acef8b2a4684",
      "en": "「Think you can beat a Battle-class\\nfused with the Queen?」"
    },
    "88:723": {
      "repository_source_sha256": "2aefab446ccb0dcbb9c823239898d344e87415ec4b61a8ebd02a4db27449155c",
      "en": "「Antares 1, you're of no further use!」"
    },
    "88:762": {
      "repository_source_sha256": "14b72f1fa2f199255616d07811630ac13660d2ba3fe44443ffe1fb0cc1764986",
      "en": "「You defy us, fused with the Queen!?」"
    },
    "88:805": {
      "repository_source_sha256": "3d683a44f479f621b2f19937a0d4cdaafed802194050db257b49c60b0a91fcdf",
      "en": "「The fold resonance waves of Code Q1\\nand Fairy 9...」"
    },
    "88:858": {
      "repository_source_sha256": "770eeacee7c6934b80e48016425cf42b35aaf503e17c132ff53208be55d509b0",
      "en": "「It's a bit late for that.\\nWe've already gone and fused!」"
    },
    "88:915": {
      "repository_source_sha256": "fa83e6263764b2814bb682cd5fc4669d21bf2607f32416ff7f7db1f56eee37a9",
      "en": "「Now that we hold the Queen,\\nno path of dialogue remains.」"
    },
    "88:966": {
      "repository_source_sha256": "2f0f46e11a43000bfd13d6408a4890cebe792e0bfde2d4477caf2e4ed65ce034",
      "en": "「No tactic works against us.」"
    },
    "88:1009": {
      "repository_source_sha256": "bb63795e4521945a6ac1ff7997dfdcdda38ed698bd24ed8f16a0a6bca6d1726b",
      "en": "「You're only ever human, after all.」"
    },
    "88:1044": {
      "repository_source_sha256": "2b2b8e86d15171ecdc255852ecdbf6c9492554f1ca82d53bc85cfd88362b8ffd",
      "en": "「Even if you evolve, you'll never\\nmatch a super-dimensional life form.」"
    },
    "88:1103": {
      "repository_source_sha256": "3955b7729f02b65b8e2c23dcd3b2b6cb9622b79f0b5b007c6efd0052fa1f6572",
      "en": "「Your surpassing god is an illusion.」"
    },
    "88:1144": {
      "repository_source_sha256": "88b09e778cf92ea58d283e4a7420d94a3e3601ef47124bee586323e844cad9a5",
      "en": "「I don't acknowledge miracles.\\nI'll turn you back into scrap.」"
    },
    "88:1195": {
      "repository_source_sha256": "fdfce69dfe96beefcceba9026faf71e6b77f1c29f47443ee7922ff3b82217bc4",
      "en": "「Mere mortals thinking to fight us...」"
    },
    "88:1232": {
      "repository_source_sha256": "008636692f7339667c2c08380d2349f538ca02b92769fece281327ad775e681f",
      "en": "「What reckless fools there are.」"
    },
    "88:1349": {
      "repository_source_sha256": "5064a583a2d810eb0f5809186e8dee814ae97eb5524027e12290f83d602a824f",
      "en": "「You can't escape this power!」"
    },
    "88:1386": {
      "repository_source_sha256": "9e7c84cdcbb4d4511588901f2642ce74b13b41e2ad9c10f86f3d3256c0f0d18d",
      "en": "「Fool, defying the Queen!」"
    },
    "88:1413": {
      "repository_source_sha256": "12a441ecee87b022c1221ec2db63564c4b06dbcc2c5df5f7c04ec780e13117f9",
      "en": "「You'll pay for defying us!」"
    },
    "88:1454": {
      "repository_source_sha256": "9e1ec6e28139da210f39c0a9177c00a7409c844193e96e4c5501b193ec8bc380",
      "en": "「Now, time for your punishment!」"
    },
    "88:1483": {
      "repository_source_sha256": "a6608f26209dab24bb07b31ca5d9195ab3f84c4ba91e366917f710f28050d2d0",
      "en": "「Learn what attacking us gets you.」"
    },
    "88:1524": {
      "repository_source_sha256": "be4e5df49863fa823b7f5ad19994c4eee0ef313f546dea1b6831880ab7d965c0",
      "en": "「Our turn next!」"
    },
    "88:1665": {
      "repository_source_sha256": "96fb9e700152503d792db0f1c96c093010f4ce469661acce62e00d34fee9bb0a",
      "en": "「We'll finish it.」"
    },
    "88:508": {
      "repository_source_sha256": "a9d4f98cba021618f7508cb9a715264b927c50c6de843ccb7eaeb67c7636c2e2",
      "en": "「Taste our power once more!」"
    },
    "88:3415": {
      "repository_source_sha256": "c2b724c4708b255578cdd9483e18c16dd934b8783487a30e8167df776ceec3db",
      "en": "「The Queen's... our power... aaaagh!」"
    },
    "88:3450": {
      "repository_source_sha256": "5923c9b0df4cdfe11ba8ffdf74a789c552b262049f52f6cb7d0043347164c04c",
      "en": "「N-no, that's impossible! Aaaagh!」"
    },
    "88:2747": {
      "repository_source_sha256": "2ba2a3658184abccc0d2737f4efbaad2bd27db77160757b8deecc7027f0e128e",
      "en": "「Still defying us!? We equal gods!」"
    },
    "88:2790": {
      "repository_source_sha256": "3e6d9f26310d3def81cb346986a51cfd670424fb81fbb2d174a75d848c6fca22",
      "en": "「Our dream has only just begun!\\nNot heeere, of all places!」"
    },
    "88:2849": {
      "repository_source_sha256": "aac70d10504b81eab780880a1a96c84df3627f1123476a06fcefd474cfbaa402",
      "en": "「Rulers of the galaxy, hurt by them!?」"
    },
    "88:2890": {
      "repository_source_sha256": "65647f860b1b5305e8807729f597c7c961b2af55d1e42db483520637da0e5f40",
      "en": "「Impossible! Such a thing...!」"
    },
    "88:2925": {
      "repository_source_sha256": "c7903b611294df3da6ac1e564903422cbe87d9febe5a749b371d8bba018ce638",
      "en": "「Impossible! This power...!?」"
    },
    "88:2954": {
      "repository_source_sha256": "5e189f23afbd1bbd2093acbdec44584ca1058447a98bbf250c8f5ffe783452d6",
      "en": "「No way!\\nHuman power beats $$バジュラ$$ power!?」"
    },
    "88:3011": {
      "repository_source_sha256": "5d633a4756040c15b69411001d27af5228080ae9c0d45e49c6b4a5c990309bd6",
      "en": "「We have no fleet to return to now!」"
    },
    "88:3050": {
      "repository_source_sha256": "32b691a4464ae4adad1b2f75003645ef1829c2d4d1f33d91cd87eed0bd0bb581",
      "en": "「We are not permitted to lose!」"
    },
    "88:3079": {
      "repository_source_sha256": "6aa0e9ec8abc7d5253fd21bb05c4246b44f080bb83650733ac77d16ba2a963f7",
      "en": "「Is the $$バジュラ$$ rejecting us!?」"
    },
    "88:3120": {
      "repository_source_sha256": "66f77f8d111cbee8955bbe59d69d2f83a6760e8131368cb7af69a322183b41ae",
      "en": "「Impossible!\\nWe're connected by wired cable!?」"
    },
    "88:3175": {
      "repository_source_sha256": "74358eeba0df31d1aea5b5852764575161c6b2326d2a08cd804c30a45b8005aa",
      "en": "「N-no, you must be kidding!?」"
    },
    "88:3204": {
      "repository_source_sha256": "bbf86769744c37b15cbbdbd1f9fe2ef22af1a014fa1cf75541ed0ce915593b0f",
      "en": "「At this rate, if this goes on...!」"
    },
    "88:3235": {
      "repository_source_sha256": "e594b502a3c9ac91156a9887cdfa27d3765dcfdf698c9456ea48ed24973e272d",
      "en": "「Queen, Fairy,\\n$$早乙女アルト$$... we slighted them...!」"
    },
    "88:3302": {
      "repository_source_sha256": "000178af01d4625d7e78beee03d79b68a0249644d5ecf2a536dde80dd9a2a0e6",
      "en": "「Impossible! The Queen we'd mastered\\nresponded to them!?」"
    },
    "88:3361": {
      "repository_source_sha256": "4dc2bc95f701d88b73c9ae2a3302641c9f3dbe278d7b82f7e3b8008f4cbf6477",
      "en": "「Nngh!?」"
    },
    "88:3376": {
      "repository_source_sha256": "44fbc901de295f077ea14aec75fc159639516aa46f20070c35619a93e6af6d83",
      "en": "「Impossible! This chaos of data...!?」"
    },
    "88:2398": {
      "repository_source_sha256": "bf1c9ea8dec0ccb72ed2da80df703eacb8a3f36036fb4b00255e3b47ae007c6d",
      "en": "「You've done it now!」"
    },
    "88:2417": {
      "repository_source_sha256": "39d3fa3e823fad6f1a4ff5df22115fb962fd01b3e3dea0807eab1c9eee71d651",
      "en": "「You'll defy us no matter what!」"
    },
    "88:2448": {
      "repository_source_sha256": "3691dc2e145ffafde95f150f81e8e5edfdafd5d2480f4f6e8661f4df95299ff4",
      "en": "「No wonder you chased us this far...!」"
    },
    "88:2491": {
      "repository_source_sha256": "322c6366765a4c64ebc197facf3f527ae1a6bede194a7ea9b112ae156a49c2d4",
      "en": "「Don't get cocky over this much!」"
    },
    "88:2532": {
      "repository_source_sha256": "75510875f7254bf52a48bb8d4f452b3050df7cdf8438402a6c628025caf55552",
      "en": "「Oh dear, what a troublesome lot.」"
    },
    "88:2559": {
      "repository_source_sha256": "13940aee18cefabbc376b495e1ded3fdf6460e3b98d72505521a0551f7a5ff31",
      "en": "「You can only feel smug...」"
    },
    "88:2592": {
      "repository_source_sha256": "1fc44b76046aaab8363402d323e94844615ccc920124a37ddb5bc02d5d83e0af",
      "en": "「...for now.」"
    },
    "88:2607": {
      "repository_source_sha256": "107895ac1c0683c091781810621c363cac8f14a5932936a38128a13cea26262f",
      "en": "「Not even our power makes you cower?」"
    },
    "88:2640": {
      "repository_source_sha256": "1c8c38723db1a169b7358d59ffc04f9d1d62493f169bf9d7d4e3129d39c0d514",
      "en": "「Could just be plain idiots!」"
    },
    "88:2669": {
      "repository_source_sha256": "fad823229633bf90e92000c8fc648de7cf88d6b318e969a0b48d677e7949104d",
      "en": "「That move...\\nAre they predicting our actions!?」"
    },
    "88:2722": {
      "repository_source_sha256": "7e896fa0da817df84589964b0b8013123562c8f7373b49a7bd0e3569cd6645c6",
      "en": "「What's with that guy!?」"
    },
    "88:2152": {
      "repository_source_sha256": "332563a5c1881d5e9df9850ed64274064d83c73f20839de75c1617edf96e01e3",
      "en": "「You can't see the power gap.」"
    },
    "88:2183": {
      "repository_source_sha256": "1514e13f29f0be8bfe2f8a495aea732a97b3567b959f5a9f0bad3e05932a4ea5",
      "en": "「Know your place.」"
    },
    "88:2200": {
      "repository_source_sha256": "b4df1f328507f39b22d4e8044a43e425fb72e5f40538610ed931ac8a49d22b98",
      "en": "「You people never learn.」"
    },
    "88:2217": {
      "repository_source_sha256": "5de101ef9c10aaaa16c42d1dae6379cd6abfd5214dce350fe4418294f04cb893",
      "en": "「Is this all your vaunted power is?」"
    },
    "88:2244": {
      "repository_source_sha256": "6f5c812796e65a30bf68982e7acd77e3df06e6b66dd81215c1c8a6c51bb08930",
      "en": "「So this is the $$バジュラ$$ Queen's power.」"
    },
    "88:2273": {
      "repository_source_sha256": "c180bef38c49b3a2f7c7c2c31696b6b1f3eec2d0e60c64e6dbde49d6de521665",
      "en": "「Completely unfazed, you know.」"
    },
    "88:2300": {
      "repository_source_sha256": "75778810bf42cf180d47d67858279ba887c204b083d0445fe097698e3e3ff900",
      "en": "「They're trying hard, aren't they?」"
    },
    "88:2319": {
      "repository_source_sha256": "e5c02ddc16ecee1ecbc992b82e5ee3b6eaf1ae68a802c91b774a5f8c1a7c7008",
      "en": "「What a futile effort.」"
    },
    "88:2336": {
      "repository_source_sha256": "ca7991560528f89a093fd53fe70627b3dce3a161e461e6ff04e6a60f709f5260",
      "en": "「Looks like we won't get bored.」"
    },
    "88:2363": {
      "repository_source_sha256": "d3cdc0dca6cb1851094be8d424778a84ed1624b81ae4b6195b7a21f8344e2a9f",
      "en": "「I mean, it's kind of annoying!」"
    },
    "88:1874": {
      "repository_source_sha256": "ee915d2c97146a1b3819c38b609ad25b4411e90b4efc6b05a3029387c55def9c",
      "en": "「Where are you aiming?」"
    },
    "88:1895": {
      "repository_source_sha256": "ae9c4638d874cae107b0644604da7144111874db419b06e3663df685c65d636b",
      "en": "「You can't even lock onto us?」"
    },
    "88:1926": {
      "repository_source_sha256": "8ab26c40451dcfea426352eaafca097efdc4e8f6096e74794684462ca11dfc32",
      "en": "「This isn't even a contest.」"
    }
  },

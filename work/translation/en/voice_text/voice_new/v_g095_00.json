{
  "schema": 1,
  "rows": {
    "95:0": {
      "repository_source_sha256": "92bc434162db02ff844699d3465f01a808daf86a55b99d9173876128635292f6",
      "en": "「I'll enlighten and lead humankind.」"
    },
    "95:35": {
      "repository_source_sha256": "8b33dbc531417d3a826e096517e66d8efc01ef577ab5675fdf797f8d6b8501a2",
      "en": "「Obeying me is the road to happiness.」"
    },
    "95:76": {
      "repository_source_sha256": "c8fd1385b2a5f5da58961013d0b470a05ead15db9d5d30d2a311a43b1e067c70",
      "en": "「I'm Earth's commander... no, a god.」"
    },
    "95:115": {
      "repository_source_sha256": "f47c48266405a118ef67a3912369dfb2a390ff2c532572cf689ec4e8cfd72c1f",
      "en": "「Follow me.\\nThat alone is the road to bliss.」"
    },
    "95:170": {
      "repository_source_sha256": "1e236fd7dabb31d21e44846f7677bb886af10fdea4a554f562deca3f6633ffa8",
      "en": "「We will make this place our utopia,\\na second $$アヴァロン$$.」"
    },
    "95:221": {
      "repository_source_sha256": "44b4711ab85ac7a982e741258aaa0d8c7561fa1ec14613bd3345e7ea71614f11",
      "en": "「We will win.\\nTo bring this planet absolute order.」"
    },
    "95:280": {
      "repository_source_sha256": "3ce6e5d01fc5271ea24f1c87b555ae88b64b839ba0ed2b8cb67309e49b8521c6",
      "en": "「We will win.\\nTo bring the planet peace and glory.」"
    },
    "95:339": {
      "repository_source_sha256": "4db9a874f3958e63447cdc105cb7e092f8e32d4abe12a961046fdaf2937c3923",
      "en": "「I must teach humanity how to fight\\nand enlighten it to its dignity.」"
    },
    "95:762": {
      "repository_source_sha256": "6ea9e96f790d844cd49d9d640a59f2a7a74626ab9f4252bab84e4ae501704b24",
      "en": "「$$レド$$, I'll prove your choice wrong.」"
    },
    "95:805": {
      "repository_source_sha256": "30faf9db120131c121c2a6178358e42036f9a79ab930720a6bb643a792c7e24e",
      "en": "「$$レド$$, our justice has not changed.」"
    },
    "95:840": {
      "repository_source_sha256": "b27cb962fe505e48a4dbfb7ad3a3e57609a99200b0e13ff0f33c2b43bd096851",
      "en": "「Recognize your mission, $$レド$$.」"
    },
    "95:869": {
      "repository_source_sha256": "3b96f1160e9c65039556b9cf2ca42bc059c467d7a761a45182282d41e1dab13b",
      "en": "「You've changed, $$レド$$...\\nYou were a fine asset. What a pity.」"
    },
    "95:924": {
      "repository_source_sha256": "149cb2c40cfbe9e7e27342cfc9f3acae8b3df3d60a0c0ae34ad2d50b145d21bf",
      "en": "「Rebels are simply to be eliminated.」"
    },
    "95:953": {
      "repository_source_sha256": "9eca7026459a4c5dac5970f84e5ee6b5b6238259e22acfa913718f4fd514ed19",
      "en": "「What can a mere pirate do...」"
    },
    "95:980": {
      "repository_source_sha256": "d34de6a1873e652a1e6620aa381261bec2ec5ba9b5a4cd4f32c21caa49c904d6",
      "en": "「Overwhelming power. Judged a threat.」"
    },
    "95:1019": {
      "repository_source_sha256": "1532cd49577d092e4ecc35deebbc5ffd152ebf2cd44b0f2a5b9710174381e87c",
      "en": "「Giant.\\nMy mission is to give people hope.」"
    },
    "95:1074": {
      "repository_source_sha256": "2b4ef8ca4ec8c12df8fb478e9c6d264b9361d5c7914e1502117048ced4a3ec91",
      "en": "「Mobility on par with $$ストライカー#robot$$?」"
    },
    "95:1107": {
      "repository_source_sha256": "28593fb5a18a66d3750b71f9befdd747d04be12cd8eff5f38767660ae922c0c7",
      "en": "「Interesting. A speed contest?」"
    },
    "95:1146": {
      "repository_source_sha256": "d25b6778a43cb095ac258aea4c642d10593a2fc57b80eda86159e269657f8671",
      "en": "「I know it. That's the $$ガンダム$$?」"
    },
    "95:1325": {
      "repository_source_sha256": "9ddbe33f0bbfd0f3902828ea745037b19868fca230f2e1d99b4b78176b6cc248",
      "en": "「Retaliating.」"
    },
    "95:1338": {
      "repository_source_sha256": "0dc160c78ebcc4056700c68777114f9e57bc435d372aaf15c389bc2146266de3",
      "en": "「You eyesore.」"
    },
    "95:1355": {
      "repository_source_sha256": "b0e494091708aabf388254767493d197503dd23808e4d96c0d53c9ee1b9ba8ee",
      "en": "「I will punish you.」"
    },
    "95:1376": {
      "repository_source_sha256": "255be18cc96dfe31eb5d6330260153210cb5b56e53bb7cf306e77bf3e1032266",
      "en": "「Time to repent.」"
    },
    "95:1393": {
      "repository_source_sha256": "474dbf2e80c788701d7e9c821547261cac327eecebe751459b442e33e7a7485d",
      "en": "「Your resistance ends here.」"
    },
    "95:1414": {
      "repository_source_sha256": "e59f1369fad560d878dc0171b557d67cc97190fde9fb02c34a7d7dcf59823a04",
      "en": "「How foolish to defy me...」"
    },
    "95:1443": {
      "repository_source_sha256": "3b458f0d061f7f0c5667edcd085e2b5f8db01ab432a107e6a7b57fa537006fec",
      "en": "「To leave an opening for a counter...」"
    },
    "95:1476": {
      "repository_source_sha256": "18365dd526f86ac92de3d51a233106cd0b02470986e2bda037dfe89d7ef1e819",
      "en": "「Stop this futile resistance...」"
    },
    "95:1509": {
      "repository_source_sha256": "40118d06318062a7588e29d2ad5804f834840573ad60cd753a4ae6fd549090a7",
      "en": "「Know that rash moves invite death...」"
    },
    "95:1544": {
      "repository_source_sha256": "a5ef943013cae101cfb6b34e6b7deb5faa9ad1470cca5a7c85025422392e8f0c",
      "en": "「Failing to finish it off. A blunder.」"
    },
    "95:1571": {
      "repository_source_sha256": "7218bdf6b1c10bfd250719ec2c2df69ba0f37ce3f0a25f24e33bf498feb09dc8",
      "en": "「I'll deliver the finishing blow.」"
    },
    "95:706": {
      "repository_source_sha256": "688ba2412ab481df342c88876fbda563b63378dce754a498eb93a42d6be8762d",
      "en": "「Take it once more.」"
    },
    "95:729": {
      "repository_source_sha256": "991324faf23bf06a443475eec22479a64db9ce8f183109da58a04b0c16223b5f",
      "en": "「It can still move...! But!」"
    },
    "95:1720": {
      "repository_source_sha256": "fae1a1b9cfe786032fe6717ef6bcbc6953d3e6ab23bcd17987b52d5f5ba82636",
      "en": "「Deal as much damage as possible.」"
    },
    "95:1753": {
      "repository_source_sha256": "d42c6a0985e11d1525c0d010d2656986962000298a7d0a2c68b129e62bd13179",
      "en": "「I'll open a breach. Follow me.」"
    },
    "95:1664": {
      "repository_source_sha256": "a3f83a30b37794c269d5c4832349e45ddf92819ddc4873e8b5f058596e625926",
      "en": "「I'll be your opponent.」"
    },
    "95:1693": {
      "repository_source_sha256": "e665f89280c9f03cef661fa5546f9322590bb9ba679a6e8d38c4d752127f556f",
      "en": "「Hold that enemy in place.」"
    },
    "95:3517": {
      "repository_source_sha256": "f644262cdf6e3b4bfa79c2e4ca68673474eef6f14c8115040c8151ce4c19cc22",
      "en": "「This tactic can't deal with it...」"
    },
    "95:3546": {
      "repository_source_sha256": "21977fce2e8248127f3fe1e8362175f00f359709347897b0544c3586d51f0c9a",
      "en": "「Everything is... meaningless...」"
    },
    "95:3567": {
      "repository_source_sha256": "dd7c0a1975387ee8b74b92849be98d1145e109ff45e6f9f018b7f2321e156e66",
      "en": "「I'm... $$クーゲル$$... Make this world a utopia...」"
    },
    "95:3610": {
      "repository_source_sha256": "99224f494f32dc557a206b614c8efaf82000542da654112d765496c03c0b9f46",
      "en": "「$$レド$$... with me, this planet...」"
    },
    "95:3026": {
      "repository_source_sha256": "84cac052f1fba5f4c83ad32c4ce7613a501c330733541ebe17d557f12c2904c2",
      "en": "「You still keep resisting, $$レド$$?」"
    },
    "95:3055": {
      "repository_source_sha256": "f25638b5ccc75a202cc005d4190f19ad2390647d7af77e62d97e4579c8233fea",
      "en": "「$$レド$$. You came this far, then.」"
    },
    "95:3092": {
      "repository_source_sha256": "64352475c6b6461b6a4f9ffe356306a838c650c397bec32fc95aab3bfdd92fda",
      "en": "「If you can't understand my words,\\nthen even you...」"
    },
    "95:3145": {
      "repository_source_sha256": "273eba99b6fd7b4bb36cea1536abcfe559241e5680fe993520dff509826b506f",
      "en": "「A mere pirate, getting cocky...」"
    },
    "95:3174": {
      "repository_source_sha256": "ca20f4577eb196455b158e999ca4e59a9c2b3c023d2eed9fa9a4d923a87bafd6",
      "en": "「This woman needs correction, not enlightenment.」"
    },
    "95:3211": {
      "repository_source_sha256": "cb1e5c8d39500066fd714f03b3a4ba3e0c25f39c9e49113b2278d2cefaa1dbf7",
      "en": "「You're beyond saving.」"
    },
    "95:3234": {
      "repository_source_sha256": "2a5706732dfe426136b75153ccdc6c2389dcb0fac26719f98c9213884a2f23ee",
      "en": "「I must revise my assessment.」"
    },
    "95:3275": {
      "repository_source_sha256": "05ab96398061108fd2d10dfa5902dcfb2e1e31be9e50b71c2887eb09bd213720",
      "en": "「Enlightening you is impossible.」"
    },
    "95:3314": {
      "repository_source_sha256": "c8c3fb86c202dd53cede0b34978c557bcd78c363589dfc5eb545de08b6b792a9",
      "en": "「You still won't understand my words?」"
    },
    "95:3351": {
      "repository_source_sha256": "3605d3e017248a2ff132f2a02d029a122dd1061098724208d20d8f331deef43b",
      "en": "「This strength... What is it...」"
    },
    "95:3382": {
      "repository_source_sha256": "87f750dc607ffb0fe3f27b3dcf333b029c068af7266d7dce7a69b491866b0e48",
      "en": "「Combat power far above estimates...」"
    },
    "95:3423": {
      "repository_source_sha256": "fe17a88efb4b33ef622866ed59da9fcc6ad7bc942c1d48c115ac3862d64001cc",
      "en": "「I will win...\\nfor a utopia of peace and glory.」"
    },
    "95:3480": {
      "repository_source_sha256": "7f918597c9619b3e4935b7e2b002080e2dfef38700bc9dc4f0ffedff49a1a993",
      "en": "「I need to raise my mobility...」"
    },
    "95:2698": {
      "repository_source_sha256": "2b86583a28df7ebabd1d16f2b4163f578dfd83a3d21b55e8696d568df322765c",
      "en": "「...Final notice. Come to me.」"
    },
    "95:2735": {
      "repository_source_sha256": "9475a3ed915df646c68f9dcd36c603e0404e8ca23212d5b71afb0fcd185a8705",
      "en": "「With such power, why can't you\\nunderstand my words?」"
    },
    "95:2794": {
      "repository_source_sha256": "6c4c59f2a91d2e03dbaf35ac86501b83b56360735f092475b35a8573cc454cb8",
      "en": "「A man like you belongs at my side.」"
    },
    "95:2837": {
      "repository_source_sha256": "05de4dd4195a4bfcc1ed398fd7ae4a25589d2bd437c6b2c6cf707a25258aa61e",
      "en": "「A fine attack.\\nEnough to change me and this planet.」"
    },
    "95:2888": {
      "repository_source_sha256": "691cc4f75422dc719415c06472e9f9e14b749f19dcbab1c472734fd5cfeb2f74",
      "en": "「I underestimated you a little.」"
    },
    "95:2925": {
      "repository_source_sha256": "ab76451067da3b3f23bd90f561565690f4972467e6df8ed17f6dc344aa272b25",
      "en": "「Keep resisting and I annihilate you.」"
    },
    "95:2966": {
      "repository_source_sha256": "8632e79bdd00de0a37b697baae615806755bf8bf93fe43eb70ea6e65af6de232",
      "en": "「You can match me...」"
    },
    "95:2993": {
      "repository_source_sha256": "ae0ce7143f5cba23be8bc6a097b669f87332832ca2a5dcb325629ea424fed053",
      "en": "「I can't overlook you. Annihilating.」"
    },
    "95:2166": {
      "repository_source_sha256": "f29428b236ca64e69489612f7d27e50dc45f1b42be0d13d577055b867b5bba3a",
      "en": "「What's wrong, $$レド$$? Is this all?」"
    },
    "95:2205": {
      "repository_source_sha256": "56eab6db93cde2c77080ce7e3970eaba8b0c63855e06f9198c45901d774485c2",
      "en": "「That's no Alliance warrior's attack.」"
    },
    "95:2238": {
      "repository_source_sha256": "2fa9e61c26f18deb3931650e7ab2bc15af267e610e4abdb2a804792c09a0a0e6",
      "en": "「Your skills have dulled, $$レド$$.」"
    },
    "95:2263": {
      "repository_source_sha256": "2ba1b5a5f2e2dfcd8ed9f2dddb518c234ea1ec660d67b0f3d66b47edbbb3786c",
      "en": "「Just a pirate after all, I see.」"
    },
    "95:2292": {
      "repository_source_sha256": "633a0173ddc0785da9f2de56b1fac8261b30e4303b2e1f1b5514cd42f65c654b",
      "en": "「Know your place, pirate.」"
    },
    "95:2418": {
      "repository_source_sha256": "27d0bd1eff165619fa36068f4a5f3ca4becedccd641fb1b910472201f781f062",
      "en": "「The powerless get weeded out.」"
    },
    "95:2449": {
      "repository_source_sha256": "7751d5c06938113ec75b9b7f69273edb98bc132ef9e829c0c78025fc56fade92",
      "en": "「You defy me with such little force...」"
    },
    "95:2484": {
      "repository_source_sha256": "b9cf43e00c4567ed6aa636529cb7558cd4fdf1300d6ed25c35cc83bab27fd4db",
      "en": "「You can't see the gap in strength.」"
    },
    "95:2517": {
      "repository_source_sha256": "bad51b9d576f054e1598dab9ea950c5263e8538a1fa56962ffa67ccc47f73451",
      "en": "「Pitiful. This is your best?」"
    },
    "95:2548": {
      "repository_source_sha256": "0710fcd0c9795bcb84a15a7972d84a210911569ab61ecb76647073e21bee1b24",
      "en": "「Petty power can't change anything.」"
    },
    "95:2587": {
      "repository_source_sha256": "91143ce28fcd1892aecf7b91bc07ca8dc56b84156611a0c1badbc94cc19afac7",
      "en": "「Enough of your futile struggling.」"
    },
    "95:2626": {
      "repository_source_sha256": "955498fe566223868d04ac317baea593bd070175cb402559e664464559dac0cd",
      "en": "「Half-hearted attacks won't break through.」"
    },
    "95:2667": {
      "repository_source_sha256": "77d4cfae0e82520af87f63a22d7ffe414d0abec3042f12aecbb13b04294a4ff5",
      "en": "「What's wrong? Is that all?」"
    },
    "95:1948": {
      "repository_source_sha256": "ee915d2c97146a1b3819c38b609ad25b4411e90b4efc6b05a3029387c55def9c",
      "en": "「Where are you aiming?」"
    },
    "95:1969": {
      "repository_source_sha256": "ecdba4df498ef601d2ff3a4cdeec0e9bc383f7ed037b1573397f155aab296ed3",
      "en": "「Amazing you survived with that aim.」"
    },
    "95:2004": {
      "repository_source_sha256": "0fb5cc07a90f01e48257bde554cc4cc11920d5de91fabbff6e80335d34882b53",
      "en": "「Close.」"
    },
    "95:2021": {
      "repository_source_sha256": "26148aa325589d2e69a9cdb2312438c0546d45e4d5660923e7960c3dbae05dcb",
      "en": "「As I thought, all show.」"
    },
    "95:2052": {
      "repository_source_sha256": "faa12111c794a50afecff31e8f00599f04fc8221e65bf82a022dfc914788be8f",
      "en": "「Your read is naive.」"
    },
    "95:2069": {
      "repository_source_sha256": "292938bbc1ec388b0ed72b0d632063a616ce984d998ed071ed09bbb318de15fb",
      "en": "「Attacks like that can't hit me.」"
    }
  },

    "95:1600": {
      "repository_source_sha256": "be55b71823dcde0bfbd31d343db9a6b761f603656456b2525e750f08c1525561",
      "en": "「Try not to disappoint me.」"
    },
    "95:1625": {
      "repository_source_sha256": "b3a86fa1926c0c8ce92d59b4835285f3bb6e777c7aa82274850a16975eb87daa",
      "en": "「I won't let talented people die.」"
    },
    "95:1784": {
      "repository_source_sha256": "a0cc021410f0aa838fd8880f53e7f114e3fe2af42d8da1c7be28b6fcc9c5a42c",
      "en": "「That's quite a clever approach.」"
    },
    "95:1813": {
      "repository_source_sha256": "9f491aaaa53ad1db1acfed05a82ef801698d5903fc5d528bd0521b65cafef465",
      "en": "「I'll let you keep your life a while.」"
    },
    "95:1848": {
      "repository_source_sha256": "6e76fda277529930f8ef9d8db8c2ab729d8166802c1ebe5af1d19765573aae1a",
      "en": "「This is an unexpected development.」"
    },
    "95:398": {
      "repository_source_sha256": "154e5d8b5f94ed2c5cfcec906d239a7d795827b8a0d771349b0dc0b23e1201b5",
      "en": "「I will annihilate you.」"
    },
    "95:430": {
      "repository_source_sha256": "563d2d9c0cfa4278c9737c800486f3f8e6fb7b1541a2246efc5a58f1477018d6",
      "en": "「Regret your own folly.」"
    },
    "95:457": {
      "repository_source_sha256": "b27b50f30d4c3b7d64325ae09470740ba0180c38c818508b1261bbdc02c3033b",
      "en": "「I won't let you stop the ideal land.」"
    },
    "95:486": {
      "repository_source_sha256": "259289aae5caa69a64c24b76cd595148777aa7264e7dfafc75699cb2a9821009",
      "en": "「I begin the holy war.」"
    },
    "95:505": {
      "repository_source_sha256": "8389336e2b50ee7fc77235fbdf1d385f95669cf3875c969563c2e06d56056e9e",
      "en": "「I'll annihilate the rebel elements.」"
    },
    "95:528": {
      "repository_source_sha256": "0887a811111c0ea9bee325c4e3d1fd1cfadcbdc1c0a7b2a91ac87618915e3390",
      "en": "「I won't let you ruin the plan.」"
    },
    "95:551": {
      "repository_source_sha256": "8424866a699e7dc70f860f20fd6ad1a31185d64508659eeee8bf21dd098d3a51",
      "en": "「Understand my words.」"
    },
    "95:574": {
      "repository_source_sha256": "1cd0cf04be96224568f7e05ea69d6ac8948418b9717bbb972d4ba806897a40b0",
      "en": "「I fulfill my duty as a god.」"
    },
    "95:601": {
      "repository_source_sha256": "c911fadd4534f5204caea0193776e331ce4e0a4629508840629129d8fdada4d9",
      "en": "「Let the weak offer up their bodies.」"
    },
    "95:630": {
      "repository_source_sha256": "03828ebfc2328c5b2dcd60a62735f2b9ba7bb38a6d58a6044eaffadcf8d971a4",
      "en": "「I grant you the peace called death.」"
    },
    "95:663": {
      "repository_source_sha256": "47c32944a0d9a45edc8323da69fede433d3ec9bae944748cbee959c430d5c496",
      "en": "「Only fear brings this planet order」"

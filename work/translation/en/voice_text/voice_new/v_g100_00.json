{
  "schema": 1,
  "rows": {
    "100:1651": {
      "repository_source_sha256": "411ef70239c0b870245de4933d85248a50e813d197c12d38f02c5d4453872be7",
      "en": "「To settle up with a past\\nof repeated folly...!」"
    },
    "100:1706": {
      "repository_source_sha256": "5c4e5d4f918e719879f728bb4e780aabdc10a4514bca6504e5f5d29a1d263686",
      "en": "「A life I once threw away.\\nI won't waste it...!」"
    },
    "100:1759": {
      "repository_source_sha256": "821b58f7a7ff186af781d31cca18e9331dd979ed566202be2189878c3e0988d6",
      "en": "「I'll show a battle worthy of\\nthe $$ソルブレイヴス$$ name...!」"
    },
    "100:1810": {
      "repository_source_sha256": "69871ff7772cee8ed7eea253eea10e0dea9cb9ef516eabf2bd15d80051de2d14",
      "en": "「I'll just live so that someday\\nI can stand tall before him...!」"
    },
    "100:1950": {
      "repository_source_sha256": "4a489eb14b5f0c1fcf54a98d9291e90e46059f0de86f0f60b71b6acdab2b93e2",
      "en": "「Is he worthy of the name\\n$$赤い彗星$$? I'll find out!」"
    },
    "100:2007": {
      "repository_source_sha256": "c096519c8ffa15036ef8481722b52684a0635e0b7bed7779a7e3c6a41647bb4b",
      "en": "「Woman or not, a warrior...!\\nHesitation would be fatal!」"
    },
    "100:2056": {
      "repository_source_sha256": "9af857b8fe8c01c660d52329150a2d893c3f975da9d5b74c882aecb967f559b9",
      "en": "「Another soldier lost their way...!」"
    },
    "100:2095": {
      "repository_source_sha256": "0c2ab14fcbabf2484b4dd6d47e9d348db0e12ff829d85e9d89980a56c6a77426",
      "en": "「Waking you up will\\ntake drastic measures...!」"
    },
    "100:2144": {
      "repository_source_sha256": "37c9e7e1a27a5708a4e5f1ece299cd6b435e569a17d8d070f6f76bb9c5302c16",
      "en": "「I'll never bow to an evil god!」"
    },
    "100:2179": {
      "repository_source_sha256": "91198caa1444866124957ef34dbc5228c443321ca7d027493fa6ceed1b79bb36",
      "en": "「Having found light in the dark,\\nI fear nothing!」"
    },
    "100:2236": {
      "repository_source_sha256": "63bb16c01dc2159ad848a19eacde7fb4f8b16ecc55c53106f938c95997663a5e",
      "en": "「No mercy for invaders...!」"
    },
    "100:2269": {
      "repository_source_sha256": "420aa4883b7ae55a3fdadfc0d984944d443ec229ac3516b0babc93e454482cf3",
      "en": "「$$サイデリアル$$...! Prepare yourself!」"
    },
    "100:2298": {
      "repository_source_sha256": "af569916062bea047d912bb4807ae714d84e654248d2aa6f3e648e2b16856fcd",
      "en": "「$$スフィア・リアクター$$...!\\nNow, a fair and square fight!」"
    },
    "100:2347": {
      "repository_source_sha256": "a6f115e6c46884b9b04ff7e1e3a867640537d7179b77c14ebfff0d124dec59ee",
      "en": "「The power of the evil $$スフィア$$,\\nI'll seal it myself!」"
    },
    "100:2396": {
      "repository_source_sha256": "85b2460a829e481c94c60c8fdd67b0f9e6408922a8dd91920dd26008297b0dd7",
      "en": "「$$皇帝アウストラリス$$,\\nI'll send you to your end!」"
    },
    "100:2445": {
      "repository_source_sha256": "bb91f1075d115e5ee9a77fff5c4e9eaa363ab0d4d40b57f0d8ae1f35167162fd",
      "en": "「We both bear the shame of living...!\\nThen let's fight fair!」"
    },
    "100:2500": {
      "repository_source_sha256": "7e5cf06979f1e7a1495df45b1d72e0494f7f8515b0244af6938c03894da4d389",
      "en": "「Even if you're emissaries of God,\\nyou're still my enemies!」"
    },
    "100:2565": {
      "repository_source_sha256": "5ccce77dc14d5ea5f4bd7ea01eda1647a9440ff64081c1fc505cee7072ec540d",
      "en": "「I won't serve an evil god! Prepare!」"
    },
    "100:2604": {
      "repository_source_sha256": "73a24a5089f7391a6ad5690fd5cb64f37d2709d0eeb83ef536123799545ae3cd",
      "en": "「You were not chosen!\\nYou are merely being used!」"
    },
    "100:2661": {
      "repository_source_sha256": "a5befadccd3e383c556fd9783bfdebda820dad51a8ff59a074f5bc8c4a97ee40",
      "en": "「Those who can't decide how to live\\nare no enemy of mine!」"
    },
    "100:2722": {
      "repository_source_sha256": "bbbf4bb22b5f8bb8a28e03ad059d6ce2d1eb666775cb72da06776319ec879937",
      "en": "「$$グラハム・エーカー$$ shall be\\nthe guide to the future!」"
    },
    "100:2789": {
      "repository_source_sha256": "4a4b25c180e76ad6bfe392dbe102deb6982f78e7c0ecb7d86efd602f5936d499",
      "en": "「Humanity carves out its future!\\nBy overcoming you, false god!」"
    },
    "100:3323": {
      "repository_source_sha256": "22398db3be130f5a4eb11130f207cd74058f9effb8e60088fcde29e8c2e500d5",
      "en": "「Contact with the target\\nmust be avoided, it seems...!」"
    },
    "100:3372": {
      "repository_source_sha256": "953e2c94a17f69c47c2a9fd87b8d1e3f3afeb1dd4b519ade854ffa92a9037ac1",
      "en": "「Overcome the $$ＥＬＳ#keyword$$, claim the future!」"
    },
    "100:3411": {
      "repository_source_sha256": "9a70815915a548ba6c0481acaa68df49cb0a8ca80b4292956bfe7c4102c2af2a",
      "en": "「No mere fight! We avenge the dead!」"
    },
    "100:3448": {
      "repository_source_sha256": "2782703a7841cfedb33c7efb0560b0f5965bf2d876c15ac256258a241867e147",
      "en": "「Even a cruiser...!」"
    },
    "100:3471": {
      "repository_source_sha256": "f4c0b28824ff970183010b1dd33d38adbeab11acc43b6cfef3380b5ffeed45ca",
      "en": "「The situation is hopeless, but\\nI'll die before I let you pass!」"
    },
    "100:7056": {
      "repository_source_sha256": "0a37e64c1aec2e12ddad62b6d40d3b132d8760d6f5b12b53918c36af25b7a67f",
      "en": "「To do right by those who fell,\\nI can't go down!」"
    },
    "100:7121": {
      "repository_source_sha256": "2db0909a4353335912835a9ea2615dbef0cb98e006f4baf41e135240ec4e953e",
      "en": "「It isn't over yet!\\nI was told to fight to live...!」"
    },
    "100:6470": {
      "repository_source_sha256": "7a3a87cd72e647a7dbce16ddc6020b3e7f6afc2de6e1047adc3ed5368e3800cd",
      "en": "「The $$ＥＬＳ#keyword$$ are this strong...!」"
    },
    "100:6499": {
      "repository_source_sha256": "d90388b25680273d262518b98173c51d884a9e7ff255cb2dc88738c0bcd29d00",
      "en": "「Defending the Earth Sphere means\\nI can't possibly back down...!」"
    },
    "100:6112": {
      "repository_source_sha256": "b14096f6bd121c79cff7d6e22cc38798d76b76c3363de4ac3e1232ca26cde976",
      "en": "「I let the $$ＥＬＳ#keyword$$ make contact...!」"
    },
    "100:6143": {
      "repository_source_sha256": "00bc30b07e7f3e3479f4bfde02283928d6c3492cf525cf19a52202cb28f66241",
      "en": "「Tch, I can't read the alien's moves!」"
    },
    "100:5693": {
      "repository_source_sha256": "bb49b8b5ecd2997d6e6ce28b12db038448a7dc4b19f42b693b40fdf8e5463870",
      "en": "「I won't allow contact!」"
    },
    "100:5718": {
      "repository_source_sha256": "6ae93f2d0db2461e9288bf1e96453bbc325261f2f174b80527b175cd5d37d379",
      "en": "「I'll not be bested by the $$ＥＬＳ#keyword$$!」"
    },
    "100:7403": {
      "repository_source_sha256": "e729eae91b9b634c81d4a731db40af9f7e927ce8e4f6b93c3ee2fd03a302edfd",
      "en": "「$$グラハム・エーカー$$ leads you to the future!」"
    },
    "100:1863": {
      "repository_source_sha256": "85101c3a296e19efcd53bcd3bbfea8f88a5cc793d7538ee40d8c1234d0c81557",
      "en": "「I know my way around a sword!」"
    },
    "100:1892": {
      "repository_source_sha256": "923379b7378df1e5f221856b5cbbab48d3df35581be272a9940364726bdf1540",
      "en": "「This range...! Got you!」"
    },
    "100:1921": {
      "repository_source_sha256": "def9dd143daba05db049443774b5945f4abdef1a18e23507639158f28ab72abb",
      "en": "「Full speed, diving into their guard!」"
    }

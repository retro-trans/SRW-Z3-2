    },
    "107:4000": {
      "repository_source_sha256": "0fd5f5ab2a9bb53b051da0ebe6f70cf69f56a574b47cdc5dccfa8154f1b49ce8",
      "en": "「For the Captain's sake too,\\nI'll fight to my last moment!」"
    },
    "107:3391": {
      "repository_source_sha256": "48968aa5ce6b33c1394107f431dfa40ceda97370a40850e1fa9acde35b7bd180",
      "en": "「Tch! A grievous blunder!」"

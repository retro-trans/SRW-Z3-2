{
  "schema": 1,
  "rows": {
    "107:3573": {
      "repository_source_sha256": "fe38d35a927e404f2add40fafdce1cfa341024e91e11d28177fc7639bf774f7a",
      "en": "「This one's no pushover...!」"
    },
    "107:3598": {
      "repository_source_sha256": "8b968cfd1690ae6853268d96248a7c517db88ca6c596c990cdae901ab24003da",
      "en": "「I won't make the same mistake twice!」"
    },
    "107:3637": {
      "repository_source_sha256": "e4ee4274974a4decd469c9d42d36dffba3f1af38966ba135e532e86f5686dcdf",
      "en": "「No one in $$クロノ$$ flinches at pain!」"
    },
    "107:3149": {
      "repository_source_sha256": "7e1e745130dbbd422b3cfbad94ad6405a452eb5f22774e915a8315af86a5d709",
      "en": "「Over a scratch or two...!」"
    },
    "107:3197": {
      "repository_source_sha256": "459089f9db5379e88eb18ac0e5ab9bea705fd82c16c89c990aabf2f688493c74",
      "en": "「That won't even slow me down!」"
    },
    "107:3222": {
      "repository_source_sha256": "a869b13652d8562a61b11358cdda7db3a084822c5012cfb473a9fce633081e16",
      "en": "「Caught off guard...!」"
    },
    "107:3245": {
      "repository_source_sha256": "f4dc31fce2cd10dfae81b6e7b0ce7968cefb62e484c4bc6734fc63fb7ecc843e",
      "en": "「I never expected a hit...!」"
    },
    "107:3276": {
      "repository_source_sha256": "4a590e16c1a1eabe63759644ca285751db2aecc05e8e419e84d12abbcfe8013e",
      "en": "「Even your attacks show weakness!」"
    },
    "107:3313": {
      "repository_source_sha256": "ec1390e25e2ae96c9ee50d27e44f565ef11109eb07125e674e1a4bbffb1be940",
      "en": "「Asclepus's armor saved me...!」"
    },
    "107:3352": {
      "repository_source_sha256": "d1fde21d909394bc40e1285f5e43b2ec35e9b76fac038e3d0472b46582e216bb",
      "en": "「This won't stop Asclepus!」"
    },
    "107:2815": {
      "repository_source_sha256": "98fcf6ec8d7c353bceb66837ac7c8962f3c055a10fd3abd23893be4148829bd8",
      "en": "「That's what we call a wasted attack.」"
    },
    "107:2848": {
      "repository_source_sha256": "4098b3e384449ef3ea23c3b585f896c467b54844530304cf74b22042c2613ec7",
      "en": "「I knew you'd come at me like that.」"
    },
    "107:2871": {
      "repository_source_sha256": "f562b66823dfb80dfa16e2cb82c24976b55afbbff15b1bfbb8fbc98a2d275c87",
      "en": "「Calm down, and it's no big attack.」"
    },
    "107:2914": {
      "repository_source_sha256": "568a560e2340936bfb58cd47b01d987b8eebfd3109ae926f3dda5ff5a867ad40",
      "en": "「With Asclepus's mobility...!」"
    },
    "107:2947": {
      "repository_source_sha256": "f8262825f0fe0b8795943663530346ed19cbe80ae3d957502a43823a4849974a",
      "en": "「I'm in $$クロノ$$'s action squad too!」"
    },
    "107:2988": {
      "repository_source_sha256": "0735a141facce8d02d105f56841d9d3b213694cddaae0e1234d149fe1161c263",
      "en": "「I've already read your pattern!」"
    },
    "107:3019": {
      "repository_source_sha256": "f6935fb60bdea6fd064fd949e3c4a23ef1448c86f32e4eb74c2d3a978bf9f4a5",
      "en": "「I saw it in your motion,\\nI knew you'd come like that!」"
    },
    "107:3074": {
      "repository_source_sha256": "295a3ddc3afd8bb06972a6f683c4444fe332e39131b3f1250795d53485cf2da8",
      "en": "「Know that it's futile...!」"
    },
    "107:3093": {
      "repository_source_sha256": "fde4cd0ab45b2c21becca6d2de6f0bf7421e8d1e8367d765735bea9abfa67ef2",
      "en": "「It doesn't faze me in the least...!」"
    },
    "107:3118": {
      "repository_source_sha256": "b680ea2994ab191a0f17bef7d04dcc3e067f8fbfc31bd8dffa67fd91a6af6aea",
      "en": "「This is Asclepus's power too!」"
    },
    "107:2671": {
      "repository_source_sha256": "d8d9fc9634cc37165564ee6281319bc8a19cf282cb45a3e9c3a8a205b51b0479",
      "en": "「Good tactics. Worth learning from.」"
    },
    "107:2702": {
      "repository_source_sha256": "ec524a425148a7b4dd883cbb1da5ff2acedcf47b5bd87021b51fab769af6f570",
      "en": "「The enemy is a cut above us...!」"
    },
    "107:2739": {
      "repository_source_sha256": "0916c08a96fce8145f1af36b2ffc683e4402b62b30336673a8d3471d3ebb38a9",
      "en": "「They've completely seen through\\nmy range...!」"
    },
    "107:2321": {
      "repository_source_sha256": "2565a139cc8adab7846eb05eb6d31b2bf1f011ad6aaaef6705247a7ce90f9364",
      "en": "「I can't abandon my comrades!」"
    },
    "107:2358": {
      "repository_source_sha256": "39cefca77fa3c89495e1b817b8ba64c9fb64d887be086350d710e2a50a4a682f",
      "en": "「I do what I can! That's all!」"
    },
    "107:2393": {
      "repository_source_sha256": "01dd9e68d0547f2076c561e97a2b8d53cc3a7ec27f9ef3c3acb049fc406e95c2",
      "en": "「My life for the Captain's...!」"
    },
    "107:2634": {
      "repository_source_sha256": "e49286c0125b6c3332de735723c763b957da3db9e6f37fd61f0de1db7ae0269d",
      "en": "「To have our attack sealed...!」"
    },
    "107:1469": {
      "repository_source_sha256": "e712d0a093b718f5bf72ad3080b4f87f6e727143f31449df537af57c6c1300bc",
      "en": "「I'll throw them off with speed...!」"
    },
    "107:1540": {
      "repository_source_sha256": "9f3b2b70bb85b166c6621ed1c6af8ae1f780d95b9fbb4f58e95ceeedaa1b3a72",
      "en": "「Closing the distance...!」"
    },
    "107:1561": {
      "repository_source_sha256": "9f41f98f672076827f3ba010b796a56aae0ff201863599e53b84486d2a6c04a1",
      "en": "「They won't dodge this one!」"
    },
    "107:1601": {
      "repository_source_sha256": "1bc0cbff59c9e38ec7f7e3b9004a5a089ee655c2a10dfd338f7c4118835de22a",
      "en": "「With Scramble Edge...!」"
    },
    "107:1636": {
      "repository_source_sha256": "975417cc810a689330c58ce04ddc1f37cf28669fdf59a17dd8992188a9fc3efd",
      "en": "「Going for a combo!」"
    },
    "107:1653": {
      "repository_source_sha256": "0f5d5a0fb8c80679f7fe1c36851145ea740a2b67b59141776998570fedf9c356",
      "en": "「This finishes it!」"
    },
    "107:1676": {
      "repository_source_sha256": "ada58730d5bd2e17016bbc42fa13318502ec68fa2e7ea9b3e4e7e23bf0383ba6",
      "en": "「Smasher, fire!」"
    },
    "107:1705": {
      "repository_source_sha256": "b42a6c6597e0c727377008363861dbc559184407f646fc4d316fbdfd44c91ddf",
      "en": "「I already have my aim!」"
    },
    "107:1732": {
      "repository_source_sha256": "8d7206f7a7aea6043d8649dd252d9e3e84ecbb694b224e389519e376aa483ed5",
      "en": "「A sure direct hit!」"
    },
    "107:1755": {
      "repository_source_sha256": "b9903c579bb82108dfcd8c218b7d0e230fce5c347d30fb965d447ec72196e9da",
      "en": "「Fall to the poisoned fangs!」"
    },
    "107:1780": {
      "repository_source_sha256": "dfbcc7d75f42c9bd59d1a9dd324e6f1746e57933108cf375e7b0a343a0da8886",
      "en": "「Come, Liberator!」"
    },
    "107:1805": {
      "repository_source_sha256": "13876a596227008e58b3bae273004fdfafc4e1b0821a57ba0d706b7297c043e8",
      "en": "「Set complete!」"
    },
    "107:1822": {
      "repository_source_sha256": "048579d6c4644f6ef4ac0c64511a1bf3c15fe8538a038b20aba340f36174a140",
      "en": "「G Dimension, fire!」"
    },
    "107:1855": {
      "repository_source_sha256": "87d17f74f446e6854617b202b85cdb827ee191eefed5ce08e9f52b2ed8f0b772",
      "en": "「Kill confirmed.」"
    },
    "107:1895": {
      "repository_source_sha256": "7acdf689b849d7ea3e00515c474de5b8c3767455be9929b3c19f47bba910563d",
      "en": "「Target locked!」"
    },
    "107:1918": {
      "repository_source_sha256": "1bb0a88448cc4225ebfc545729ff1f217ef45146544e37efe61f60cd2c1c3a59",
      "en": "「Blow awaaay!」"
    },
    "107:1939": {
      "repository_source_sha256": "e74b1ade33aad03ccf5f87893a2c4eac6513faef5f41229a53116ad1e2d3ab4d",
      "en": "「As expected, Liberator. Terrifying.」"
    }

    },
    "117:1256": {
      "repository_source_sha256": "c5c3877d8cfd7c69bfc6115ff19cd2fe478087a46dec5946f482961b53a4098a",
      "en": "「Gundam, fire civilization's child!」"
    },
    "117:1291": {
      "repository_source_sha256": "6fbcb57ee6ef4fa7928963c34718151d6c5aa173ba8dd2816e0482d35658f466",
      "en": "「When it comes to speed,\\n$$アスクレプス$$ won't lose either!」"
    },

    },
    "117:2621": {
      "repository_source_sha256": "d7ed08875302898a630d2b48cfb7d575a5a6a3c018df8931e29420ce3226cfa0",
      "en": "「Resisting is a right of the living!」"
    },
    "117:2660": {
      "repository_source_sha256": "c0e95cbbe2819a29b337f2c3d816da675d39372b2354f32795c67b62905dbe2a",
      "en": "「Cornering them with teamwork!」"
    },
    "117:2681": {
      "repository_source_sha256": "36d440aa2dafabd03f0b840ddf417b7f05b93c5a21d112541c042aaf81371221",
      "en": "「A chance our ally made for us!」"
    },
    "117:2716": {
      "repository_source_sha256": "12cea5db585a74fa285831d60efb4e6fee7758cdb2e84e9bbc348f36188e2c99",
      "en": "「Allow me to back you up, Captain!」"
    },
    "117:2751": {
      "repository_source_sha256": "6f3dd46058c011847b58061f3b515bc93e19e0294c38548fcba46e535140260d",
      "en": "「$$セツコ$$, I'll give you a hand!」"
    },
    "117:2784": {
      "repository_source_sha256": "5b93256bd76cc88a7fa2957b5e9e3dd173515acddc6f21faaed36ce3a32b3450",
      "en": "「This is the power of $$ザ・ヒート$$...!」"
    },
    "117:2815": {
      "repository_source_sha256": "0493cec736b96e69e692c3c403ea02ccb25418a22eb2a150fa07c1220765cadc",
      "en": "「No charge for this, $$クロウ$$!」"
    },
    "117:2854": {
      "repository_source_sha256": "1692ed58693295b136660b6b96b32879e2dfff666a3e7d5d5b6f2f9d4ab69db6",
      "en": "「We're comrades in the same mission!」"
    },
    "117:538": {
      "repository_source_sha256": "b764b39e6d62993b6cf390ec64317ec89d080c68b9ec8e983f36d0efccfbf8cc",
      "en": "「Launching another attack!」"
    },
    "117:565": {
      "repository_source_sha256": "a427fa3eed4b0393183fd3ab0dba16493802d3aa6400a45bffbd8113b4fde876",
      "en": "「I won't waste this chance!」"
    },
    "117:3252": {
      "repository_source_sha256": "7ae45c4c1741a0e228ded0d11cc93b26e2ccefbd9289cab4f87eeae53d265a76",
      "en": "「I'll go first!」"
    },
    "117:3325": {
      "repository_source_sha256": "7326ff663a893f982d4e805b8aed420b70fedccac44e6b1639a176b8cdc9de11",
      "en": "「I'll stop the enemy in its tracks!」"
    },
    "117:3146": {
      "repository_source_sha256": "b36679790845a5384f000655d5131f117210e6f7985cde22fe46e7503b529740",
      "en": "「Proceeding as planned!」"
    },
    "117:3167": {
      "repository_source_sha256": "19ea26b113c3c061a19a50f2ea3cbe54a9ed6b8ca78ce3a915a73eaffadcb345",
      "en": "「I'll just carry out my mission!」"
    },
    "117:3196": {
      "repository_source_sha256": "c727719c515010bd5a86a0829cd52a54395d5e0f2401a634bb2e732e8721ac77",
      "en": "「So that's my target...!」"
    },
    "117:3225": {
      "repository_source_sha256": "db43da034694b8aa03dcb45b7fc2ff2649370f13a58cef23b99ddccf5547dde0",
      "en": "「I'll turn the tide our way!」"
    },
    "117:4747": {
      "repository_source_sha256": "92bf19163f10391a76ecd33e2a49ce3f8b89a72ca43f59629c17664fea1ce6f8",
      "en": "「No...!\\nEven $$アスクレプス$$ can't last any longer!」"
    },
    "117:4798": {
      "repository_source_sha256": "036d477fa6358fbc0f81c009f6eb0869cdb6a58c966d9c8d4cca463d5ddb1ca3",
      "en": "「Captain! Please be safe...!」"
    },
    "117:4829": {
      "repository_source_sha256": "bc1b874b658f8c6b02b08602d800524914e457a7769cf37e86e76c0f15cc715b",
      "en": "「My apologies, Captain $$アドヴェント#pilot$$...!」"
    },
    "117:4211": {
      "repository_source_sha256": "88d5e9dbd4ea86ab83bbe35a57f2a4871df4b7b14156f8bd99848ae9ec04d7fa",
      "en": "「I can still do more! I won't quit!」"
    },
    "117:4252": {
      "repository_source_sha256": "1e66defdad940780f54bc393b0dfd12b84f4319eda2c312493ae63cb2aa2189a",
      "en": "「Such power... I never expected...!」"
    },
    "117:4293": {
      "repository_source_sha256": "affcda5547458661b002fa397407b48b79fa7388aa31bbcdc076a9c361893efc",
      "en": "「At least I can't lose in spirit...!」"
    },
    "117:4336": {
      "repository_source_sha256": "933897b9feb865b18c486ddd0fa4d2477dfcb913606d4e069ed76f8acfc20f3b",
      "en": "「How can I face the Captain...!」"
    },
    "117:4375": {
      "repository_source_sha256": "6069a6b84930c751396396f862dd47b8b904262728fbaa9467d2cb27efd8dda5",
      "en": "「Our defeat is Earth's defeat,\\nand yet...!」"
    },
    "117:4428": {
      "repository_source_sha256": "c8cd4c009e69cda19caf2496a573278c51257a8af6e45ea52941c097cc7aab97",
      "en": "「No dying without the Captain's OK!」"
    },
    "117:4465": {
      "repository_source_sha256": "2d5893e58864f33dd029e04cc8597fa61c2c4679c69de5ce136a21abaf6f174e",
      "en": "「My life was the Captain's long ago!」"
    },
    "117:4508": {
      "repository_source_sha256": "5ce34d2b47a9e5db884bad62bbacf9ae98568011b06fd634263c6d70757ec6bb",
      "en": "「Until this life ends,\\nI'll fight for the Captain's ideals!」"
    },
    "117:4567": {
      "repository_source_sha256": "e7f80fbb0e76caa78425fc353d020b94e14f0d3c2cd0f12a6322d2388793983a",
      "en": "「As long as the Captain lives,\\nI'm not afraid of death!」"
    },
    "117:4616": {
      "repository_source_sha256": "ff5b7d5e8bbbd589cea404763597a07767977fc69af87370d84d286c40a667e1",
      "en": "「Ngh...! As expected of you, $$セツコ$$!」"
    }

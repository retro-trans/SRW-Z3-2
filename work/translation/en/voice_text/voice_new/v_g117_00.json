    },
    "117:1576": {
      "repository_source_sha256": "e3585966512742cfcb7570b919259262261b0fbe9db8a2639dc6abaad9b16cae",
      "en": "「Superior foe or not, I won't flinch!」"
    },
    "117:1611": {
      "repository_source_sha256": "b642ab745ad008ab99468ecb37168ed7551d1ae20f9dd86c6beb7501346e7dd2",
      "en": "「Aim for the mothership! Strike fast!」"
    },
    "117:1650": {
      "repository_source_sha256": "dd798a8cd6a65a872037b7257b9f1364287495b9e191c0014ab92ef416684bef",
      "en": "「A direct hit on the bridge, and...!」"
    },
    "117:1681": {
      "repository_source_sha256": "30902da2bcb062ea76afedd43ddf48f1ff79de1162900aba7adc86fb0c81a07b",
      "en": "「I won't yield to invaders!」"
    },
    "117:1712": {
      "repository_source_sha256": "78109c80476209360e412e5f57d0db53f2f8cabf967fff6d28d94255d431abc8",
      "en": "「I won't let you do as you please!」"
    },
    "117:2430": {
      "repository_source_sha256": "81fddcfe5523d2eb98b5bae8a999e6e80d52855b0cbe7e59d562875a2dcfe7bb",
      "en": "「Our time of lying low is over!」"
    },
    "117:2455": {
      "repository_source_sha256": "ee1417a24632f14d01d8cf5e8cd6281419a470b0b6d799ee0ec7350147d494dd",
      "en": "「Time to counterattack!」"
    },
    "117:2474": {
      "repository_source_sha256": "a88f6775ed1a044c55fc6468bfa3f1d9e421ea59791fdf791e7ebcc257eccae0",
      "en": "「Now it's our turn!」"
    },
    "117:2505": {
      "repository_source_sha256": "629a71533a41f1cf29763c30508a12af6419c9205600888a768e2a98c91ee0af",
      "en": "「To keep the front from expanding...!」"
    },
    "117:2540": {
      "repository_source_sha256": "50ca4f864193d486e2fc2e1e3604e3ee406941a78d7c992da6e9060ecc8c1a50",
      "en": "「I won't just keep taking hits!」"
    },
    "117:2571": {
      "repository_source_sha256": "06650fed4a56261fe8877cbe89ff4ecfab110c792d6607b0ab2e85038bb730f6",
      "en": "「I'll repay the debt right away!」"
    },
    "117:2594": {
      "repository_source_sha256": "0dac910e73c43441977eaffdc46a2499f1ce9482cab30f31219c8b65d661f0d6",

{
  "schema": 1,
  "rows": {
    "117:4655": {
      "repository_source_sha256": "b740b2b952695bbb4132907b4f2c82de1b7df9c20fde9d8b4c178f6e0129d98a",
      "en": "「So this is $$ランド$$'s strength...!\\nTruly terrifying power!」"
    },
    "117:4710": {
      "repository_source_sha256": "0846a7ebc7b090997b9c2441c8a8c3894af577d7f160c2805386b773e1dbdcad",
      "en": "「$$クロウ$$...! As expected, strong...!」"
    },
    "117:3975": {
      "repository_source_sha256": "9224f0ffabcb6af4714f3757771028e4ebd1aee623d71b4401c5e012b84c1c71",
      "en": "「At this rate the damage\\njust keeps piling up...!」"
    },
    "117:4024": {
      "repository_source_sha256": "409932f63e2f3a24803c5e5a91d07cefd764a4a1cc2e23bbfb9791ca08556e5c",
      "en": "「Turn the tide or we're overrun...!」"
    },
    "117:4065": {
      "repository_source_sha256": "cefabf4122d2a5ed1f2d731ff95b44c2239916fedbdc710037410a0a50724370",
      "en": "「I'm not finished yet!」"
    },
    "117:4096": {
      "repository_source_sha256": "6ce7e5f0de870226317600dc7d14c53ef5388329a83fb6c6c8e6d9d3bdf7871f",
      "en": "「Is my evasion pattern read...?!」"
    },
    "117:4137": {
      "repository_source_sha256": "ffc314aa7c3d807eadba48431e08581ee1aa64347c8bbad272df3dcb06ea464e",
      "en": "「I can't worry the Captain...!」"
    },
    "117:4178": {
      "repository_source_sha256": "8484e6058079a3f1f677c78aab9b6a5ad497e3f4141e66867bcf48a368aca053",
      "en": "「This shames the name of $$クロノ$$...!」"
    },
    "117:3759": {
      "repository_source_sha256": "1f30aae4f3e75b04620d7b220e2a4d596dd76bda0aa83b80a78092a7d7d92b57",
      "en": "「The Captain must not see this.」"
    },
    "117:3790": {
      "repository_source_sha256": "6cafff1bf402cdc2a032212f3112c66f3461a85a8059a56d76cc2feca79e251c",
      "en": "「This much is no problem at all!」"
    },
    "117:3821": {
      "repository_source_sha256": "a4df039e719445581aee8de8692ebfd088d61560afad9ecb4e3354617c7ed64d",
      "en": "「To be hit by something like that...!」"
    },
    "117:3860": {
      "repository_source_sha256": "7918c5241e91f8bfca95d85f0e087a38d3d3bb9f17f15dcb4ab05b3d3ca4176d",
      "en": "「Testing us now, at this point...?」"
    },
    "117:3897": {
      "repository_source_sha256": "aba2cf208f25784f1e9cafd59faf6ece0f1bfe70e301040ec304784782123de1",
      "en": "「Fine if the operation's unaffected!」"
    },
    "117:3932": {
      "repository_source_sha256": "6d092ac9afcdfb2cc192a76bf9e2bd1757882b9afe3d8691d5b716307d9fc6f2",
      "en": "「I've scratched $$アスクレプス$$...!」"
    },
    "117:3496": {
      "repository_source_sha256": "5696493a879684e64919d849ba55b9afdf07a782aacf1e8de7f07c7ca733c6d5",
      "en": "「With such simple movements...!」"
    },
    "117:3523": {
      "repository_source_sha256": "c18b14b5703c4fbc5ce48eb0d770c13b239ec92f7717b4cf8b79fb1fc4d1f8ee",
      "en": "「I knew you'd come like that!」"
    },
    "117:3556": {
      "repository_source_sha256": "917e3d133661c9fe416199cb4c399effb1d8b25693b56bce3d32f81744be48f5",
      "en": "「Your attack rhythm is monotonous!」"
    },
    "117:3589": {
      "repository_source_sha256": "227933efefee29d7794b739753f3b589bc9e64ea5e686ddd0086f729969e01db",
      "en": "「The Captain chose me. Easy!」"
    },
    "117:3628": {
      "repository_source_sha256": "a2d9b20e954bcae10fbded75bbe4d50f24648b02792fc8415b91cdc28a9d1b3e",
      "en": "「I can see it, too!」"
    },
    "117:3651": {
      "repository_source_sha256": "bb4a3ab0560dceda258f2d8fd5920017d6ad904da8ad2772d6cca751dd201a89",
      "en": "「Mass-produced or not, no scratches!」"
    },
    "117:3711": {
      "repository_source_sha256": "957e9fb9e269839b2c2b15c6270617d8b9e7430b01599d64ef673d4a362e2fb6",
      "en": "「We're unscathed!」"
    },
    "117:3732": {
      "repository_source_sha256": "24ab3a750b6a26ab088d3f2f90b400d204a8ae8aa28932876ff77626da3dd16f",
      "en": "「We have preparations for this!」"
    },
    "117:3457": {
      "repository_source_sha256": "cd035960dbb2dfd1b7d051fb699705cc38507372bc9c502a7e5c1f6985f7e867",
      "en": "「Damn...! I lost track of the enemy!」"
    },
    "117:2887": {
      "repository_source_sha256": "640fa8d8fab2c23ac644317004f82588d1e79d5ccb2d730a8d1daf2e45765427",
      "en": "「I won't let comrades in arms fall!」"
    },
    "117:2924": {
      "repository_source_sha256": "c2ff78664c278155f491bdcbdea2dee48651e20702a1a025a1c3a65af75989af",
      "en": "「Leave this to me and fall back!」"
    },
    "117:2955": {
      "repository_source_sha256": "59041e511c4d4daeea3d7007e96267b82b27775580a1bcc39cc26f78efd434fe",
      "en": "「Please stand back, Captain!」"
    },
    "117:2984": {
      "repository_source_sha256": "b224038387cc8a287b1895ded3323c8d4e835e4325e12cf43b6155efa1ddd7bb",
      "en": "「I'll protect $$セツコ$$!」"
    },
    "117:3017": {
      "repository_source_sha256": "922bedf65afbdc7eee0922ae0bed036a6c64064a54b7bec026eea321ba81412e",
      "en": "「Tough or not, you're overdoing\\nit, $$ランド$$!」"
    },
    "117:3068": {
      "repository_source_sha256": "a75f926776af94b3d5a7678c23b7512ab6fc5bbfa07aa471ff174363fffd0803",
      "en": "「Don't die and leave debts,\\n$$クロウ$$!」"
    },
    "117:3119": {
      "repository_source_sha256": "7b3ca679731203675f779c999c7f73ee0daf0f65b1a5d572d0b41e755acd406e",
      "en": "「This is also a Vice-Captain's duty!」"
    },
    "117:3352": {
      "repository_source_sha256": "de4e05ecbb2cf23eddcb12ca38db2b3a2967db888c2c95e21102e47cba095ee7",
      "en": "「Damn...! I can't attack!」"
    },
    "117:3383": {
      "repository_source_sha256": "f84358d426fcbeac0730485db46bba98b951e96a3e721fbd71f6f4b90a9a2fcf",
      "en": "「Just watching helplessly...!」"
    },
    "117:3422": {
      "repository_source_sha256": "80407b61ce57159b43f893257d3f3de0f508bdddc1ce2c8a6416db83bee18892",
      "en": "「Did I fall for the enemy's trap...?!」"
    },
    "117:1745": {
      "repository_source_sha256": "f2bf11c0740af30a95c10005d3601124db449d6ac42e133f53af2301d2e98be7",
      "en": "「Going in with Scramble Edge!」"
    },
    "117:1778": {
      "repository_source_sha256": "772d0db5b6af2064a897df0bbf4a88772c25275349ee3cf9ad5330585506ae85",
      "en": "「With this many consecutive hits...!」"
    },
    "117:1807": {
      "repository_source_sha256": "33a8e3f6c2b925e09af15692a74a42f5ee6266ae66dc977241fd8bf1b52ba55f",
      "en": "「I'll end this!」"
    },
    "117:1824": {
      "repository_source_sha256": "1292e50b01c8a5fb34f54cce3c936fdc2c9705e7aad1e9952b8e2f76744dc4ef",
      "en": "「I'll do it like the Captain does!」"
    },
    "117:1897": {
      "repository_source_sha256": "3577ec058d3ff4f521abb84d2d5d05a0852e637124d71d997d92a3b7c12d8588",
      "en": "「I'll finish it up close!」"
    },
    "117:1918": {
      "repository_source_sha256": "6e6947abfa2417e449af192b1dc1630934d011d274b24ca7b82c9c3caf4ba9f8",
      "en": "「Take this barrage!」"
    },
    "117:1995": {
      "repository_source_sha256": "ada58730d5bd2e17016bbc42fa13318502ec68fa2e7ea9b3e4e7e23bf0383ba6",
      "en": "「Smasher, fire!」"
    },
    "117:2024": {
      "repository_source_sha256": "113ed939aad2a8817c82f31ed1b2fecb64dd20d4703c933da2dcb8a713ce66a8",
      "en": "「Serpents, finish it in one strike!」"
    },
    "117:2057": {
      "repository_source_sha256": "dec03e39ca16391252e26c7d78a1ccd0155a8fe2c961625ea6d7119419c55c1f",
      "en": "「No escaping the serpent's fangs!」"
    },
    "117:2088": {
      "repository_source_sha256": "ed2ca73c34f2c2233f48cca81bac40020287288a2f769c884ff48bfcb46d4fe7",
      "en": "「Liberator, I'm right here!」"
    },
    "117:2121": {
      "repository_source_sha256": "2c4a25e59f723aba4d2a899a3b7cc1ae210931dc5ff725877cfd83cd7ddb8b8c",
      "en": "「All parts, deploy! I can do this...!」"
    },
    "117:2148": {
      "repository_source_sha256": "048579d6c4644f6ef4ac0c64511a1bf3c15fe8538a038b20aba340f36174a140",
      "en": "「G Dimension, fire!」"
    },
    "117:2181": {
      "repository_source_sha256": "bbc9cbf92b83985a9148b46579a74292cbc1f3bf5f20169fae1267d80f24ccae",
      "en": "「As powerful as expected.」"
    },
    "117:2202": {
      "repository_source_sha256": "aa7a3c991131d983ff42bdf0ade1bc5d9a405bc3f1959c890690f79a06606b44",
      "en": "「Liberator, summon!」"
    },
    "117:2227": {
      "repository_source_sha256": "2f9efbf8bca579f16abf962d31f080ca4ea3f5d6bc5e0ad1e03ef0c1268015fd",
      "en": "「Target locked! With this...!」"
    },
    "117:2279": {
      "repository_source_sha256": "32fda2bd4e16e05fc385d555ddcf754eec57d59fb6526945bc5a241c279fb9a1",
      "en": "「This is our mission.」"
    },
    "117:2310": {
      "repository_source_sha256": "810369e7ba4e4e1c66f0eab280bd19ad6a5a2943f03fd0330d5e2901dea437b1",
      "en": "「The Dimension Corridor opens now...!」"
    },
    "117:2341": {
      "repository_source_sha256": "80161f377554a8680371125b45537e9e0d83a7e06f9da4d456838f338a79ba9c",
      "en": "「Preparations done...! Here I go!」"
    },
    "117:2399": {
      "repository_source_sha256": "f4ce66e12720d5ffd54917b74b3c06df865b1afeda9be0d938eb24e0edba1fdc",
      "en": "「This is the power of $$アスクレプス$$!」"
    }

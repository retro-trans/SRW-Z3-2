{
  "schema": 1,
  "rows": {
    "127:0": {
      "repository_source_sha256": "66cc1e3d1194f56720b7198e97616175b653221b03bbdb4dcebce5ef7a946f68",
      "en": "「Ah, so we have guests.」"
    },
    "127:37": {
      "repository_source_sha256": "19c832eaf12602bad93e698bc29bbd8db255ce781981779ab2303333d54e14a2",
      "en": "「My, my, how impatient you are!」"
    },
    "127:78": {
      "repository_source_sha256": "c6883c7ed261faca491a59cf95e11993f00b19909c91c9ffb45537fba8bedfa5",
      "en": "「Well then, would you oblige me?」"
    },
    "127:111": {
      "repository_source_sha256": "c80a25d05ab7ba1a6529ae09391adb0f2416de2b1c303cb2cd1446dc8bd3256c",
      "en": "「Looks like I have to fight.」"
    },
    "127:146": {
      "repository_source_sha256": "246b1ae3c5958dc55f322e88e0f88b76f0b69dd61e14e3afbcfc5d4d3e5cd610",
      "en": "「Well then, please bear with me.」"
    },
    "127:187": {
      "repository_source_sha256": "ce45f8ae5d01482eb37aba78f3e006dc1dc07f080e72f4a4412dd2b364469583",
      "en": "「Well, well,\\nI'll try hard enough not to die!」"
    },
    "127:236": {
      "repository_source_sha256": "00a7515c7aa0b3628da58052560068ac5fea6a2ca4940fdf5504b8b7663dc18d",
      "en": "「Shall we both take it easy?」"
    },
    "127:277": {
      "repository_source_sha256": "6d01befd7ce31064fae6d6516ed8c50177154554943313841ccd0154779dddf1",
      "en": "「Is it wise to take on\\na small fry like me?」"
    },
    "127:332": {
      "repository_source_sha256": "95983a92193780bf74f4bf281587a33c57efba7451b55bf6afb5a09bd17ed063",
      "en": "「Now then, how long can you hold on?」"
    },
    "127:369": {
      "repository_source_sha256": "97c9b7b0f457de11858bf44a85364fd705a5bec093b72e4dd1743e8f9f4467ec",
      "en": "「Do go easy on me, if you would.」"
    },
    "127:408": {
      "repository_source_sha256": "cd6c1c0c299aa777e347c8b0d282b629ad74bc6c2df6e546c515a5dea02cbbf5",
      "en": "「Allow me to be a little rough.」"
    },
    "127:447": {
      "repository_source_sha256": "5ec8d8a9ee9ad813543e9572757f48f1af608751544b3a6e4d6d206e134fd7b3",
      "en": "「Let's keep it easy. Nice and easy.」"
    },
    "127:480": {
      "repository_source_sha256": "04f62c4c19c50d4bd086ab142750c975f9024d16e9b169f5faf201572b640b4f",
      "en": "「Let me see it, then,\\nthat galactic frontier grit.」"
    },
    "127:535": {
      "repository_source_sha256": "ddec4250d658f70d7984462ba6a7343605dbcf0bbc13846aafa201c1fa2ed275",
      "en": "「Feel free to call me\\na sneaky coward.」"
    },
    "127:584": {
      "repository_source_sha256": "c5af570680560e8b8f69c372ff05130b49ef7513f112e8fc7ed6302d5969cda7",
      "en": "「Shall I unleash the hatred\\nsleeping inside you?」"
    },
    "127:637": {
      "repository_source_sha256": "cca73406658e5532fb38115ab63da129364cec21628a0d311ef264f16e1a1034",
      "en": "「It's part of the job. No offense.」"
    },
    "127:750": {
      "repository_source_sha256": "797cbcb8971092aac73cb41159a1802d206086b9d3c5e1ef4c05ca7d05005c28",
      "en": "「Won't you kindly be captured\\nwithout a fuss, $$セツコ$$?」"
    },
    "127:803": {
      "repository_source_sha256": "beb24698bf38feceb1cd0b3dd14e2ee2b51b59973112abc5af8585c196c17df1",
      "en": "「I'd rather not cause you\\nany more sorrow...」"
    },
    "127:858": {
      "repository_source_sha256": "70c2b688cab2522eb39acfcf795b83d346a5c506cc4155a74aed7b3efc010434",
      "en": "「A sweaty glutton with smelly feet?\\nSo my opponent is $$ランド$$?」"
    },
    "127:917": {
      "repository_source_sha256": "1e3ff965b2ce95f8c234bed38c425278793caabfeb46e1c274cd84a8d9abd194",
      "en": "「Let me test just how tough\\n$$ランド$$ really is.」"
    },
    "127:984": {
      "repository_source_sha256": "ec55b3420c89dfc23d605810c0b78b64201ed969f1303e15f4018f2f593e0991",
      "en": "「$$クロウ$$, you understand the debts\\nof honor in this trade, right?」"
    },
    "127:1049": {
      "repository_source_sha256": "c6ff5a1f49c17698f2e3f573c9cfd5d35cde226d5ef595d20bbe65c4b4e4e974",
      "en": "「I'd have preferred to settle things\\nwith you using money...」"
    },
    "127:1108": {
      "repository_source_sha256": "acd8c35a534ac360d7b73f1d9512669fab0112f739421bf27ba90fd3cd59e0fc",
      "en": "「Well then, I ask for a match,\\nCaptain $$アドヴェント#pilot$$.」"
    },
    "127:1157": {
      "repository_source_sha256": "b4a29e6bec98fb3c1d0c5c83b009aac7e9bae01b0d6acb1cde7ddaf052e71228",
      "en": "「Hmm... Still as hard to pin\\ndown as ever...」"
    },
    "127:1208": {
      "repository_source_sha256": "e5ec7e6ae02c6c76ff7e3013a51af142a1dcf684556599a6f7b2570a59b20691",
      "en": "「$$ブルー$$ looked after me too, but...」"
    },
    "127:1249": {
      "repository_source_sha256": "dfacc6ed5255e8b7f3306d2ae6ec3a1b1cbd3332950b27922c217f3901248dc5",
      "en": "「I'll never forget your cooking.」"
    },
    "127:1284": {
      "repository_source_sha256": "141d2b93bda79cb0f845564eff2530c79444d305d6b65c98afbaabcfc1d43eb2",
      "en": "「So you're members of $$クロノ$$?」"
    },
    "127:1315": {
      "repository_source_sha256": "6bab12bbd9b4c5af8707c337aa631de058135eb16ebd53f6576b6896678e1b13",
      "en": "「Up close, super robots\\nare really something!」"
    },
    "127:1368": {
      "repository_source_sha256": "40e12a4c4d8eb1a1e06ddf579f4e6c86a23c0d6c431eccb5551615612aeceb0c",
      "en": "「Thick armor and super power...\\nNow, how shall I fight this...」"
    },
    "127:1425": {
      "repository_source_sha256": "89ccb66119c2fa931e8329b9ea7baa3d8b444a59581f53ee9e1c885e308d3054",
      "en": "「Oh! Photon Power energy detected!」"
    },
    "127:1464": {
      "repository_source_sha256": "aecab568162b95568c4314704b202fa8726d165f9ad2707f3bb8170469f750af",
      "en": "「My, my... To think they'd actually\\nharness the $$ゲッター線$$...」"
    },
    "127:1521": {
      "repository_source_sha256": "d06cdf3775b18bfe3e5c953d57abebac3110aaf8c593ca274da2734573baede5",
      "en": "「I question whether something like\\nevolution is really necessary.」"
    },
    "127:1574": {
      "repository_source_sha256": "26b268bcdad82833bdffcc47a6c21cbe814a74c4f6400523ff74a3b0f2cda41b",
      "en": "「So I face the $$マーズ$$ of rumor?」"
    },
    "127:1607": {
      "repository_source_sha256": "8bd7b7a02f08cad670c2f708955012bbb6731e6dbea62d23fef888fa769c57d9",
      "en": "「Facing a Mechanical Angel\\nmakes me shiver.」"
    },
    "127:1656": {
      "repository_source_sha256": "642f1d200b635c4c35f82e7d053e1ccb399bf0663effdcdbe1a5a25adf9a018e",
      "en": "「Oh! A drill robot!\\nYou know what stirs a man's heart!」"
    },
    "127:1715": {
      "repository_source_sha256": "c5dc09db3fac06b54d3d145952386d0e22a98e2837955afc26b68e53efd50ec5",
      "en": "「Believe it or not, I love animals.」"
    },
    "127:1758": {
      "repository_source_sha256": "bfef7f485428e574392bd099a9333f650df08407c1841996702fc3feb269b0b6",
      "en": "「Hmm, this won't do.\\nUsing things like this...」"
    },
    "127:1815": {
      "repository_source_sha256": "2ebb3109128dc4929fb7fa5e50bde2b73576c2ad122f53486e0c3bccf965dea5",
      "en": "「I know all about you,\\nMr. Something-or-other Gundam!」"
    },
    "127:1870": {
      "repository_source_sha256": "87a488548c79ce8d678604ba12152a5951949fb3e086a916367d2c0b0ba6e9e4",
      "en": "「This won't do. Wars start\\nbecause people like this exist.」"
    },
    "127:1927": {
      "repository_source_sha256": "8c48291f1107c6f1b0dd2c2f7f537f335fdf7fb8308a22e17eea866433989a9e",
      "en": "「Oh! Does your head go zing? Zing!」"
    },
    "127:1970": {
      "repository_source_sha256": "ee63ae994f143995b94b834eb485bb27cd20fe165a87212e37b360b0b55cd1f3",
      "en": "「Oh, you're really getting into it!\\nI won't lose either!」"
    },
    "127:2019": {
      "repository_source_sha256": "dfdf9b9fb39cc7ed32ba2ea12113307d04190c5374db8516dcd83208180e224a",
      "en": "「Hmm... Even I'm lost for words...」"
    },
    "127:2060": {
      "repository_source_sha256": "768e31cef44d84c14d0cca659cff0213124253138a291ac6dfd92573ebc6211a",
      "en": "「With you darting around like this,\\nI'm getting dizzy...!」"
    },
    "127:2119": {
      "repository_source_sha256": "22720e767eeb68776a2c1dcebc847ee554dc03f06afde395da9d0230ad45429f",
      "en": "「Truth is, I was a boy good at\\ncatching cicadas and dragonflies.」"
    },
    "127:2178": {
      "repository_source_sha256": "fcb6f09a95cea1011b6330ea74893f6089a7a74a1894647c3000f962836f4386",
      "en": "「You're a fine commander. I'd even\\nlike to have you on our side.」"
    },
    "127:2237": {
      "repository_source_sha256": "72078bfdc6a039e8e075988a9f9f9b7786585f186f836014cdc146d873310b44",
      "en": "「A battle between commanders\\nought to be worth watching.」"
    },
    "127:2290": {
      "repository_source_sha256": "e38ad9928e04c2b02070f313b707f161ee6b7d4fb31d5b55e2807a2e72700cbb",
      "en": "「You look like an ace to me,\\nso please go easy on me.」"
    },
    "127:2353": {
      "repository_source_sha256": "2ed2c7ae2904a364c29fcec6e90e7217e08eec745833991945e011d1c48c84a6",
      "en": "「Dear me...\\nThat's a speeding violation.」"
    },
    "127:2402": {
      "repository_source_sha256": "45e8a5c8be423cdac6d6b881da09ff7c000e6795ab2cc0e5e8bd25c3755b22d6",
      "en": "「\"A big man's wits never reach...\"\\nSo they say, but is it true?」"
    },
    "127:2459": {
      "repository_source_sha256": "6a2137a36603440e7d7c3e2a29e1e5725f888ef4b9b924c7d7e101b1322150eb",
      "en": "「Don't relax against small foes...\\nThat's an iron rule of battle.」"
    },
    "127:2520": {
      "repository_source_sha256": "a92ab74be8817e60451205b0e63a2b32aaf876d4fa6123d5cffdecd3d008e2b0",
      "en": "「Let's go after a big fish this time!」"
    },
    "127:2559": {
      "repository_source_sha256": "628058f41d48510168fc4867b09c8f60826aeeb70cc58462a78be23a2030893b",
      "en": "「Direct hit on the bridge. The End!」"
    },
    "127:2602": {
      "repository_source_sha256": "65b8e1e9b46244dfb521cf7530efe1067c6a3d08e8f9326960663a20f67d89dd",
      "en": "「Now then!\\nLet me borrow some youthful vigor!」"
    },
    "127:2653": {
      "repository_source_sha256": "3732d28c3bf65c0f3f5b187741bc20ef58b53c99c434f0057855d15e8f3a465e",
      "en": "「I'll ask a youngster like you\\nto take me on!」"
    },
    "127:2702": {
      "repository_source_sha256": "2bc08d52e8c03b468d128280e781fde98f0b062c6478efadde07629e5f07e817",
      "en": "「That stiff side of you\\njust doesn't suit me, you know.」"
    },
    "127:2755": {
      "repository_source_sha256": "7a5e37523d752e39969f3a83ea711518fd64eb93a6d099a7a3854016f398ea38",
      "en": "「Worked ragged for peanuts, damn it!\\nThat's about the size of it.」"
    },
    "127:2806": {
      "repository_source_sha256": "0ca736a445d8d78038a4067093ba8fdf2a0fa292e1bb3dd1c89a65b94943c6d1",
      "en": "「I bear the name of traitor now,\\nand fight having thrown it all away.」"
    },
    "127:2875": {
      "repository_source_sha256": "eecf79016b3b99f06c2e4445e07d7e52511696c0eed1cbb15b238c5585e588a5",
      "en": "「You're a frightening person, yes.」"
    },
    "127:2910": {
      "repository_source_sha256": "7371b4fd0bf9eab1763a325f2584644b7fefb59bad146d5f37e6a0eba9c0db8c",
      "en": "「Ugh... Just getting close\\nseems to wear down my life.」"
    },
    "127:2965": {
      "repository_source_sha256": "c96ee350d0c01a649f222dbbe248115727a459f88755f70dc684424441de62cd",
      "en": "「$$ギルター・ベローネ$$ seems to be\\nthe same as ever...」"
    },
    "127:3022": {
      "repository_source_sha256": "dcd130e52a2146a0c7d41ed8661d6a4c588900819142f828bbc5287d2dfa005d",
      "en": "「Somehow, everything you do\\nis just so uncool...」"
    },
    "127:3905": {
      "repository_source_sha256": "4c5e64f1b4f06989988297708f0de84bdc1f4539fd895fa1cf213d426ad97950",
      "en": "「Well then, shall we strike back?」"
    },
    "127:3936": {
      "repository_source_sha256": "10e919872daf99974a5b6e2200bacaf69fdb92caa99ff20a647313401d755008",
      "en": "「Being beaten without a reply\\nis rather galling, after all.」"
    },
    "127:3985": {
      "repository_source_sha256": "1b02102f35ca9d34677ce346df8af1af5ef95b53d6376d7a43b4f1aaa419aca4",
      "en": "「Could I have a turn attacking soon?」"
    },
    "127:4026": {
      "repository_source_sha256": "9f2eafaba63257ef0b425b1708fae56c2cff54f73b252e47dad2fb1a999e90f5",
      "en": "「Too bad! Attack and defense swap!」"
    },
    "127:4065": {
      "repository_source_sha256": "d899469742ee4384dbcd854782cefaa7807a80529b6861b7492380de7d5e5cc7",
      "en": "「Believe it or not, I hold grudges.」"
    },
    "127:4104": {
      "repository_source_sha256": "0d4fbde469fc1bdb64b113ed5a51355a5b860922c8e6f34f9339bccb6cedacc7",
      "en": "「Oh my... I can catch up, then.」"
    },
    "127:4147": {
      "repository_source_sha256": "4a61b557fe5d4bbd2a12d1c0b3b1bfaaaf952da13a639db53884ab4ea8042534",
      "en": "「Your position's obvious, you know.」"
    },
    "127:4180": {
      "repository_source_sha256": "8ba16f55fd8dd5534254e9050d81a7dd3ef581ad875950ff255505b80c780eb4",
      "en": "「Sorry about this!\\nI'm alive, so I'm hitting back!」"
    },
    "127:4233": {
      "repository_source_sha256": "d4a13469acb23127eeeea44b2e30c89ee832b5d8ff13773d6dc7422666200730",
      "en": "「Leave the cleanup to me!」"
    },
    "127:4262": {
      "repository_source_sha256": "c213765f2758447a1c9ca09438642f190ed9b648b3a52a12d2ec2f9654ad9ebd",
      "en": "「Then I'll help myself to the rest!」"
    },
    "127:4303": {
      "repository_source_sha256": "587095401e9b40d3416637e20e48eee32741ad4ad01e16a8cbf6c1e8dfc0b19b",
      "en": "「Do your job properly, $$ギルター$$.」"
    },
    "127:4346": {
      "repository_source_sha256": "a2e78eb0434b9fffb65ce7075fd9ddc740263b22fb996b2aea12b5b9c07a5767",
      "en": "「Allow me to follow, Lord $$バルビエル$$.」"
    },
    "127:678": {
      "repository_source_sha256": "ecfba3349dbb5b9a644a545b54849ee8de8e7a3e04778d78a6ba0552a093b795",
      "en": "「If you'll excuse me, once more...!」"
    },
    "127:709": {
      "repository_source_sha256": "b1638bc70bc86a66bd7596517dcdbe28d68708bf0b26ed8b9da8c63e7952c598",
      "en": "「Believe it or not, I'm greedy.」"
    },
    "127:4715": {
      "repository_source_sha256": "f0b2fe255c60c658c354d49b1023123f6597df232d97f6eaf35ce5b9fbc5247f",
      "en": "「I'll run out in front~!」"
    },
    "127:4742": {
      "repository_source_sha256": "be281dcead865013843098c371e993cb4bcf92a2e767d692c53e2e65143fa2e1",
      "en": "「Back me up from behind, please!」"
    },
    "127:4781": {
      "repository_source_sha256": "3af99e997112be2afe6baea3d44ce7c9d65b31d1e767eb0b0396d7ed62c2fb42",
      "en": "「Huh? Am I... the decoy!?」"
    },
    "127:4818": {
      "repository_source_sha256": "ad0b665186e1262b757fbf478f6ddac37b51302ad123bafee9d0fb5f91e867d7",
      "en": "「The old man goes first, yes.」"
    },
    "127:4577": {
      "repository_source_sha256": "4e68bddf5a420bba7e4c8e3679ce4c17870c02d4214ab89c160175991275a10a",
      "en": "「I can't afford to fail!」"
    }
  },

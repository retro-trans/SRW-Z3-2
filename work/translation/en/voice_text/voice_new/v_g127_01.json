    "127:7174": {
      "repository_source_sha256": "5bfa0540accc3b63eac24996144074305e3fcb162978f72c2396375d362851b4",
      "en": "「Truly the number one guy\\nnobody wants for a boss...!」"
    },
    "127:7231": {
      "repository_source_sha256": "69fc200f694304e238c37084ea0543338383bd29af64eb26c9c5912a319418ed",
      "en": "「My little remaining lifespan\\nis being drained even more!」"
    },
    "127:7286": {
      "repository_source_sha256": "ff1a68e3611f3f8f22b82d4729641757ae13e91c740544d4a3a3ad669c8a912d",
      "en": "「Mmm...!\\nHard to believe a maiden's blow!」"
    },
    "127:7339": {
      "repository_source_sha256": "bfd24d5c14d71173dbc78121983f2c5fddeedbcc6edccee180cf17dc09dc21ae",
      "en": "「That nickname really isn't\\njust for show...!」"
    },
    "127:7388": {
      "repository_source_sha256": "d28d1a4ee972d8d12d573d55d906c92b2494430a4ed1cfc6ba8ba932dfa2a2ad",

    "127:6686": {
      "repository_source_sha256": "fab443908fdcc28f24fa09ce7990d0de1d84fe84d7ba47b697b6dc45da5e3cb4",
      "en": "「At least let me off...\\nYeah, you won't, will you.」"
    },
    "127:6739": {
      "repository_source_sha256": "417ce0706d96ad920529a3a59d1ceecd34aa949622e611291ccb3300190cfc63",
      "en": "「Just not my lucky day,\\nit seems, today.」"
    },
    "127:6788": {
      "repository_source_sha256": "319e39591a31a54e7bbb0c72c9b6c59b91707e07d62e166b971312566f6e9669",

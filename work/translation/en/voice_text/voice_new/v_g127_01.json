      "repository_source_sha256": "676240631a2c8e4b845a0bc59d4ab3e8b252826194ddaabffc6cc81f98724cf6",
      "en": "「Haha...\\nI was a fool to think I could win...」"
    },
    "127:6876": {
      "repository_source_sha256": "98133d4cd6aee5e4d95647102471c4c2fea7710e9f0845123b0a65056529f910",
      "en": "「Uh-oh! I see my life flashing by!」"
    },
    "127:6917": {
      "repository_source_sha256": "fe7d18abca07e6532cc20afd9dd5aa8d1d32491d10791b4fdd4c3f6e9a2aa5f5",
      "en": "「Coming back from here\\nis a bit tough...」"
    },
    "127:6968": {
      "repository_source_sha256": "40d44b0cb551043e1ed06f0ff543c5905e8417bc58a7ffcc498e47a3ba16299b",
      "en": "「Ahh...\\nI hear the family I left behind...!」"
    },
    "127:7021": {
      "repository_source_sha256": "162ef609f871ec1dc83fea411787e00e8959dc9644e77be502f41550f9f0bd82",
      "en": "「I see...! I see, I see!」"
    },
    "127:7060": {
      "repository_source_sha256": "6f16c74e3c0cac77ea02f62e2b17a881319e2109dabb76c193019ff4d3fb5b2c",

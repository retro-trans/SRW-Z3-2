    },
    "127:7437": {
      "repository_source_sha256": "da83476630d236bfc1e0803c3e4290bfb16397781ac574b1a7f95eed8a080b1a",
      "en": "「So this is youth... as they say!」"
    },
    "127:7472": {
      "repository_source_sha256": "af601fa9b90cffb191ea2fc2f561d5ae14d2fab10fd794655096eab76abcab07",
      "en": "「Mmm, so young!\\nWhat a truly youthful attack!」"

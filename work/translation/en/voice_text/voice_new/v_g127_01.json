    "127:7847": {
      "repository_source_sha256": "36f1c38f24f66b0e1b93cea4caaff6339a78b4c55579ab6f4a078de5e6d5191b",
      "en": "「Heh...\\nA short but rich life, all told...」"
    },
    "127:6621": {
      "repository_source_sha256": "fcc671470bd2e717f59f486071ce42fe9741450f54949a160876f5fd59018eeb",
      "en": "「Ouch! Isn't this what they\\ncall a major crisis?!」"

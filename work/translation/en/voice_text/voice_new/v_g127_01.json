    "127:7562": {
      "repository_source_sha256": "a0e132ee3cd453f45e3333a9df3de1a0dda191c9f1adca8f5d114fcc0f36f9df",
      "en": "「As expected of a Super Robot!\\nEvery hit is heavy!」"
    },
    "127:7611": {
      "repository_source_sha256": "0de67ba88ad082ca815bb278b15c2cc4dbe03baff320a78c47c7f92320acb593",
      "en": "「Gundams really are strong!」"
    },
    "127:7650": {
      "repository_source_sha256": "ba5743a37246e7ae3cc14f1432486fb0756a01292c47d8c8f3ff60e7d3383ebb",
      "en": "「Mmm, Gundam!」"
    },
    "127:7673": {
      "repository_source_sha256": "cd8fb8fea6f1b93467c3c2009003b8b38915392b8c98dc27a07ab0a01e3d6e32",
      "en": "「Oh dear...!\\nMy old eyes can't track that!」"
    },
    "127:6168": {
      "repository_source_sha256": "5d04ee60c70cc7ffe474e38ea7ea50d263ad07a226cd110539ea8e5278ac690b",
      "en": "「Ow ow ow... my chronic bad back...!」"
    },
    "127:6207": {
      "repository_source_sha256": "5c57af9cc34e6e50d2ff0e964d3f6063bdf9811e6f9417d1cdb01db801f136e5",
      "en": "「Ten years younger, not like this...」"
    },
    "127:6246": {
      "repository_source_sha256": "2a218476b642eee85c0ce7177df471fccaddfcd767752ba02a31508f955802f8",
      "en": "「Mmm! My head is spinning...!」"
    },
    "127:6283": {
      "repository_source_sha256": "e88c36fc7788c37341000f9fc647646acccbd79c61db9f2c9e338f1c01b96b4e",

    },
    "134:15480": {
      "repository_source_sha256": "89a73822db679707c56c3297a79275797d941df72affe3291224c752f691e87d",
      "en": "「Humanity and I aren't cheap enough\\nto be destroyed by selfish logic!」"
    },
    "134:15543": {
      "repository_source_sha256": "e96c0003666f002b39397f7a12ea918b182479976c966916b2536196bea58054",
      "en": "「It's my drill that will judge you!」"
    },
    "134:15578": {
      "repository_source_sha256": "01363ed04eb34fa49fd61dc29f0ffa53f070e928b5cc53042a1a639a3a759cd9",
      "en": "「Touch me for fun and you'll\\nget more than burned!」"
    },
    "134:15631": {
      "repository_source_sha256": "2fade7c283b18e9eedd513567fc40500f6b386328f7d188fd002c7bdf368545a",

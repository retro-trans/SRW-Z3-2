    },
    "134:11976": {
      "repository_source_sha256": "79110eabe4df4f6573a748f0c0fd53bdcf84d975b2154c02c27a98ed7927df14",
      "en": "「To hell with the fate\\nyou forced on me!」"
    },
    "134:12033": {
      "repository_source_sha256": "266a010cae045618e5cad9daba9b74636a4f201306c1619d45fa01ab1837a14e",
      "en": "「To bore through to our future,\\nI dig and dig and dig on!」"
    },
    "134:13737": {
      "repository_source_sha256": "b4a0eaaab8843f11da5e048575afb180f0ffdbcb7f28c55ba1dc6bc634cb6631",
      "en": "「My drill shows how I live...!」"
    },
    "134:13770": {
      "repository_source_sha256": "61b409f739436164b52b8a1a407171191f73ab6142aad42d7594ab2938e2372a",
      "en": "「I'm moving on! You can't stop me!」"
    },
    "134:13809": {
      "repository_source_sha256": "a99e55d7a5fda046dec490edc7a8449d4f3019bb121d6395dadd1438e5c2e312",
      "en": "「You'll regret making an enemy\\nof $$シモン$$ the Digger!」"
    },
    "134:13864": {
      "repository_source_sha256": "83f3a0ec68376709ac485c4a24306a1b5cb81421ffd5d751e7830ad2e7cd658a",

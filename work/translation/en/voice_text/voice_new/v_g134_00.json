    },
    "134:1049": {
      "repository_source_sha256": "84182cd787bc8bf23de1a7baa28983b1e72998644fa99d53c3b7b10db6ed18b1",
      "en": "「You've gotten a lot gentler, $$竜馬$$!」"
    },
    "134:1088": {
      "repository_source_sha256": "536d6bca44bcfc61105bbdd5e60b3f9171d34cd8b36ae755b8df2047f61759a9",
      "en": "「Some amazing robots showed up\\nwhile I was gone!」"
    },
    "134:16664": {
      "repository_source_sha256": "a2561b542c4cab313f322485e04af450d878c664d8c3848c9cadcbf2387f5175",
      "en": "「You showed your grit, $$ノノ$$!」"
    },
    "134:16703": {
      "repository_source_sha256": "690d3d93e687263e82ef8da56f51742e9cc40ed2f1b5841fdfab850a2ad8b68b",
      "en": "「$$ノノ$$'s effort and grit + my spirit!」"
    },
    "134:16742": {
      "repository_source_sha256": "ea602753890fb8d65c483075edfab33e9d5827dbffd8d60eb7af814357421d27",
      "en": "「Not bad, $$ラルク$$!」"
    },
    "134:16771": {
      "repository_source_sha256": "0def4ceee71d612e86af25a884f47b213f52498b062e96a220eb0b63f4036d79",
      "en": "「I saw $$チコ$$'s grit!」"
    },
    "134:16808": {
      "repository_source_sha256": "bcfe6997a51b8a0a8f16f2b2bee9e53f9c348944957d44aacc8e7df193f16047",
      "en": "「After $$ニコラ$$, it's my turn!」"
    },
    "134:17306": {
      "repository_source_sha256": "1e99ce35841b0d4f93106525991aabaab306912f717b9ac30652f8a6ba906a8c",
      "en": "「I'll make you regret failing\\nto finish me off...!」"
    },
    "134:17361": {
      "repository_source_sha256": "b5c502e0635f321d13415f90f0bc098119680cda59bc9bcf165b8cdb78e32c71",
      "en": "「In that case,\\nI'll end it with the next blow!」"
    },
    "134:17414": {
      "repository_source_sha256": "61bf1ae0d88a6f03a3b43eadbdacb37be33f962ad01184de0a9609fb148696c2",
      "en": "「Now it's an endurance contest!」"
    },
    "134:17126": {
      "repository_source_sha256": "9eb32b454786c5583866b2c701f9f8b5eb916c1f23ee812d04d89c510607c2e9",
      "en": "「Not enough! Guts, power, soul!」"
    },
    "134:17169": {
      "repository_source_sha256": "9650e4bed97db407e070bacd481c3c45d2de4597fa9d8eaccd126416453ee96e",
      "en": "「That's not enough\\nto break my drill!」"
    },
    "134:17222": {
      "repository_source_sha256": "821397020380f50c937c9dafc20de8e4136f04b7fb9264698acf032cb8e8f1ad",
      "en": "「I know! Let's shut them up!」"
    },
    "134:17257": {
      "repository_source_sha256": "1a264012ddc3d506d0f66622db68357334a0fe4ea72cefd67d8ceb1eb37045c4",

      "en": "「We have no need\\nfor your rule!」"
    },
    "134:11768": {
      "repository_source_sha256": "92886ca0fef82fcda8fb3a35055dd13cdce41ab3b7c2c50a5775ebefe2ad5dfb",
      "en": "「I'll punch a hole in your $$スフィア$$!」"
    },
    "134:11811": {
      "repository_source_sha256": "ca2cd5f38ae4456d9aa87206fc3e2fd7e2cd8f5f875cbe402ae51bf13a1ad9d8",
      "en": "「Your $$スフィア$$ versus my drill!\\nLet's see which is stronger!」"
    },
    "134:11870": {
      "repository_source_sha256": "2d80d6fd519353ec438db18f38db4fd75294cbaccfb4d7fdba0c67284a3dfe47",
      "en": "「Don't steal others' happiness\\nwith your selfish logic!」"
    },
    "134:11925": {
      "repository_source_sha256": "cba0febc069ce552daafd709a5eb398be12227c062c3b084fad1d5e534781362",

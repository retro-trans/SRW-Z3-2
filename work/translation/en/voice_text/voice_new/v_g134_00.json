    },
    "134:14314": {
      "repository_source_sha256": "02ff505eb458be6f447e53b520778e3db2abce2f431fa90b4751438d3b6af7a2",
      "en": "「Even space monsters\\ncan't stop my drill!」"
    },
    "134:14365": {
      "repository_source_sha256": "19b1b396f55efc411b1340221a595ecb9910017527c9bedacc34fa9c1189f98f",

    },
    "134:15686": {
      "repository_source_sha256": "22b84567da6815f7726eb0260e3b43725a9d884c59c39c22583a29aab580399d",
      "en": "「I'll land one on that smug face!」"
    },
    "134:15725": {
      "repository_source_sha256": "01542556f4d75cdd7b12d18b909c42e761bdc9352259992996356d1602f8ef0d",
      "en": "「Forget false gods' emissaries,\\nbelieve in yourself!」"
    },
    "134:15780": {
      "repository_source_sha256": "b7783850a0fd9f38650f4b6775f1dc68bde6389142cf1b4ec9d1ef70f7514b00",
      "en": "「Don't think you can look down\\non humanity forever!」"
    },
    "134:15833": {
      "repository_source_sha256": "2cafd893bb69bd04a2eacf2aef860acac738afa4423caf4cb83b858308abf8c1",
      "en": "「$$アサキム$$!\\nI'll end your fight!」"
    },
    "134:15880": {
      "repository_source_sha256": "a3a10e38d14d96f622ff73f358111340e7b626374be27b9e6c6e62155d3965d9",
      "en": "「Nothing in this world is immortal!\\nI'll teach you that!」"
    },
    "134:15943": {
      "repository_source_sha256": "e3516fccc411d3eb267ba2a54ba4ef77ef293f3e19fd9a3bd0a638437cf8a6e8",
      "en": "「Let's settle everything, $$アドヴェント#pilot$$!」"
    },
    "134:15984": {
      "repository_source_sha256": "3575d19365d4207425b70840a762dedd5ed97567d87ce8a93ea416a1e2708e3a",
      "en": "「It's not you who saves the world!\\nIt's everyone who lives in it!」"
    },
    "134:16051": {
      "repository_source_sha256": "a7390ab008a68a36fb24613ab25c6e6ac6e06f4eeeb8cbfe687e8fb8c0a7278e",

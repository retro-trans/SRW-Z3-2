    },
    "134:16567": {
      "repository_source_sha256": "545f359c1b0967ff39a44aa92578ba30077e4507be45854d319b882e050d5b77",
      "en": "「Don't complain about the payback!」"
    },
    "134:16598": {
      "repository_source_sha256": "db712b1fecfb74c1f5c5e6093cabb65ae825ee02479d86e83adfd9d24ccc60d5",
      "en": "「Taking a beating isn't my style!」"
    },
    "134:16633": {
      "repository_source_sha256": "6a2d4205669e163ccecf4be71fd165436feffd253797d53de5db97a48543ed34",
      "en": "「Bring it on! My turn now!」"
    },
    "134:1000": {
      "repository_source_sha256": "7de91b32ed22d4d6d64080b1e32849446c9b842b6b5ff06f312a9c2ccdc8cf53",

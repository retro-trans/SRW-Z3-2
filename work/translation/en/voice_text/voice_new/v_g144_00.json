      "en": "「I want to hear your sound」"
    },
    "144:85": {
      "repository_source_sha256": "447b738dc1da3ba87a1a48bb0cae2ca9e71f545b150b1ff050c9db23ae2f3995",
      "en": "「Shall we begin our performance?」"
    },
    "144:114": {
      "repository_source_sha256": "c69afc760c96739bfa38eb5f46dd757ff98aa8da00072b2ffd169a3ce4494dda",
      "en": "「Fighting in this world isn't so bad」"
    },
    "144:145": {
      "repository_source_sha256": "daa9fd4d51f686abcf32a78844067df6fb55713873a64848373ba9b609bb2db0",
      "en": "「With you, there's nothing to fear」"
    },
    "144:184": {
      "repository_source_sha256": "828c56edc00cb58afacb6a7f71ef66287e75f015f4263c038e77de3acb1bd40d",
      "en": "「I know. Let's match our sounds」"
    },
    "144:215": {
      "repository_source_sha256": "a90ebca3ad764d79a016d40efdf4666ba332a538e4627c93f8d94459c52fa165",
      "en": "「Together, we can do it」"
    },
    "144:236": {
      "repository_source_sha256": "638b196f468b32fc8c10bf92936615bbdedb804f255ffa5d833505847986fa89",
      "en": "「Go ahead and play freely」"
    },
    "144:263": {
      "repository_source_sha256": "ee04740ab78b29b701b29bbcfa883b75d3bb0a8f4b8514196bd109bf441d267c",
      "en": "「Are you ready, $$シンジ$$?」"
    },
    "144:294": {
      "repository_source_sha256": "a10ed5daf273ea1967330bada6977abce9ec45ac315c00f04b8e296699aa0850",
      "en": "「Let's be the Lilin's hope, together」"
    },
    "144:831": {
      "repository_source_sha256": "ab5b1d1e9439de39458aa96f686b1ed25893d0a6f587462a819e27a88ade1ade",
      "en": "「Surely this isn't the only way\\nyou know, is it?」"
    },
    "144:884": {
      "repository_source_sha256": "6162eb199eb72ec1f92c9734ba48741efd1630947a3d29211c94f9f91551e4f0",
      "en": "「Is that your will, Lilin?」"
    },
    "144:921": {
      "repository_source_sha256": "93dd7fc6cc92eeacf84c16bd70fe8bd4735b3b627d0c8ac4ec97af384cc41c44",
      "en": "「$$シンジ$$'s father...\\nOne who rivals the Lilin's king...」"
    },
    "144:972": {
      "repository_source_sha256": "d9256d7325b6275c4c24ba461ccc8ded3e318210df7ec5281f21fdf58be7f2b9",
      "en": "「You cannot become king」"
    },
    "144:997": {
      "repository_source_sha256": "6cb3a45cdfe351a0f5e62c2f9a0c55d9f9782fd66d6a17dd2cfa96edfdca1220",
      "en": "「You've been crushed by a sad past」"
    },
    "144:1040": {
      "repository_source_sha256": "ebef916a5145589eff12443d1a73d1f240a97af45328a1ee83780dcd7bcfd2ab",
      "en": "「You're just like us, aren't you」"
    },
    "144:1067": {
      "repository_source_sha256": "c265b6b7ccbc64d4e140aa602170ff56b467e0bf98864daa1e9a33fa8d498d3d",
      "en": "「I don't want to become like you」"
    },
    "144:1104": {
      "repository_source_sha256": "6fcf4eab1c42c9750b388a5033e7c96ab9a6732cfca3e94f732b6763723b81e6",
      "en": "「You'll deny the Lilin to the end」"
    },
    "144:1147": {
      "repository_source_sha256": "75fe35679cbd40bc161b692c7dee64579b472e03679bdb44309fb6473f31b81f",
      "en": "「That hostility...\\nThat's the meaning of your existence」"
    },
    "144:1198": {
      "repository_source_sha256": "487ff4e40e5151c463bbbcf8f8bc15984ce785a9ea2a0bd7ab071f3147050840",
      "en": "「Are you using that power properly?」"
    },
    "144:1239": {
      "repository_source_sha256": "3788d029b186551039f7b85614d8d17808c0d67a2dc5dcb49b286aa85e746baf",
      "en": "「Your fate has been rigged as well」"
    },
    "144:1274": {
      "repository_source_sha256": "e45f8388928d77f527c9332b05abe51fffe55ddce495e2bed9855cc91a457eba",
      "en": "「May you too find\\neternal peace someday...」"
    },
    "144:1323": {
      "repository_source_sha256": "66381ea54dfe0d1c3b70564edff74b3251082f96de2a9091d5b7590c2219b49d",
      "en": "「You have taken the wrong path」"
    },
    "144:1358": {
      "repository_source_sha256": "0fa13d0fd611124dfb692d4796cc4dc764ab4f6c978b267b41f6e9833b695047",
      "en": "「Humans can't become gods...\\nThey have no need to」"
    },
    "144:1411": {
      "repository_source_sha256": "c66039f87f07091e51269054b0855eb251642021909c3b41c25081a2cc8ce7f3",
      "en": "「Let's cap off all our playing so far」"
    },
    "144:1446": {
      "repository_source_sha256": "e3501f7ea59ac1e28dcc291af867fd8deb75d112247c63ba17dd0f8c066c8e59",
      "en": "「Now, let's fulfill our mission」"
    },
    "144:4198": {
      "repository_source_sha256": "77e913526b70b17e3edbb3bbdbec147711f5a3c9168a3c73f0f2b37fa84d520d",
      "en": "「I... I...!」"
    },
    "144:4217": {
      "repository_source_sha256": "e3e05b09cdb940309dcb0f7b949d70d15665c3aed06f99a9f8c6bdcbd3b1d199",
      "en": "「Now... I won't think of the past...!」"
    },
    "144:4252": {
      "repository_source_sha256": "422b12bfdcafe49f196adb366119fc1874360e4170f5b4bd466af75bf8bd97b1",
      "en": "「I'm scared... but... still...!」"
    },
    "144:4283": {
      "repository_source_sha256": "c5b8172163290a73b400f3492c5653716ef5a93bdbfb0fae4f323918b4cc9c06",
      "en": "「I'll change the world in an EVA...!」"
    },
    "144:4322": {
      "repository_source_sha256": "330c4c4ead3c44ae16dd73bf8df8b8692c4e43576e21166240fe062a487d8822",
      "en": "「I'm not alone...! $$カヲル$$ is with me!」"
    },
    "144:4365": {
      "repository_source_sha256": "35454d140e7a14fc86931552725370a2665499bf2c570d8ad05b0d5c57d06b75",
      "en": "「Unit-13... with this power...!」"
    },
    "144:4398": {
      "repository_source_sha256": "126881229063b835e532fb163b8df85ff5cf20f4834588f7330dfcf8128ba568",
      "en": "「I can do it with $$カヲル$$...!」"
    },
    "144:4427": {
      "repository_source_sha256": "f1f99a24e5917ec6ecff92ad693ca2d5e859cd599740dadfb87a30c3c74e0b12",
      "en": "「If I recall our piano duet...!」"
    },
    "144:4460": {
      "repository_source_sha256": "2cfa14a47cb82ba66ccfc50b97f59b328dee7ea021642dcea9dd53e47468f4de",
      "en": "「I'll do what I can for the world...!」"
    },
    "144:4491": {
      "repository_source_sha256": "9ac0db74968944a03cc27001aa21b279ceec314c3cb261e2a9df18e4368f3c7b",
      "en": "「$$カヲル$$!」"
    },
    "144:4506": {
      "repository_source_sha256": "20114c76c2efcfaed45dd018c42a8fdaa7164fdb47090dc2dbe52fea470d7d8f",
      "en": "「Yeah」"
    },
    "144:4515": {
      "repository_source_sha256": "23804aba8a3d25f3d569cbff571a00093a87c6fa87a9b7cc7b1fbd6829c52f75",
      "en": "「I'll try...!」"
    },
    "144:4534": {
      "repository_source_sha256": "5c8173a896dfdb991dda9f0d865b975191289cbc7d4dfe6897d3bf674158e400",
      "en": "「I'm ready anytime!」"
    },
    "144:4557": {
      "repository_source_sha256": "6b799822b600cc6ff77d15da956fc4a4b29672e60e098868224f2b52f7254c86",
      "en": "「I feel I can do anything with you」"
    },
    "144:5240": {
      "repository_source_sha256": "6beaad2061189a0385166240ecd5b38eef84483354eb0dd7a00dbfdf0a671d67",
      "en": "「Better than just waiting to die...!」"
    },
    "144:5277": {
      "repository_source_sha256": "1459ac2a13bfe70b3d5649ed0c21e6a7c32801e762808f8d776f85542450dcc3",
      "en": "「I'll protect humanity, the world!」"
    },
    "144:5308": {
      "repository_source_sha256": "c43133397d5e0b145769c6db7f581b2d79ec9face694ab1d7ba47e450b361793",
      "en": "「No matter how big it is...」"
    },
    "144:5333": {
      "repository_source_sha256": "8cf31465e6c015d24d7d25dcf943312d00b7b23cdf934324e1d0c7a9815e43ec",
      "en": "「Keep going even now? That's...!」"
    },
    "144:5368": {
      "repository_source_sha256": "e2c050251a3552b70f7c71ad6920ee4b6e000139bf9654a6a52829d8acf24bf5",
      "en": "「Fighting a war won't\\nchange anything...!」"
    },
    "144:5417": {
      "repository_source_sha256": "a65150b7bb4cea8b88e016a06988a6652e9f87a619a5e2a20c029a0b4b5ae865",
      "en": "「If we back down here...!」"
    },
    "144:5446": {
      "repository_source_sha256": "c1828d6f659fb5581d6d7b5b03eb5e75830a5034b208d59e93e8bf21b7530e8a",
      "en": "「If we can truly see eye to eye...!」"
    },
    "144:5487": {
      "repository_source_sha256": "92ad3d996e21a39c0b2af63717f2c0d9df2bf23f5f6cda6564243da1502bcfac",
      "en": "「Unknown or not, a foe is a foe...!」"
    },
    "144:5524": {
      "repository_source_sha256": "c9eff30bd61f84d94cb88893f74973127112f0f1e253fd911eb0e97e2d529315",
      "en": "「What is the goal of all this...?」"
    },
    "144:5555": {
      "repository_source_sha256": "2c82cf38ac2fc30afc06d863a967b48cae2bc1b044163bc55b4eeda6d1e4ed4d",
      "en": "「I'll save them for sure! This time!」"
    },
    "144:5592": {
      "repository_source_sha256": "7862712533bc20a36c100dc8d547c2536252263ddc39868647d7df4bc2217db0",
      "en": "「There must be a way...!\\nThere has to be something...!」"
    },
    "144:5641": {
      "repository_source_sha256": "e2ecf1d7eaf4a7fb6f65265c6a192803fe0ad983f3a137991005e6d00b409b32",
      "en": "「I... can't accept you...!」"
    },
    "144:5676": {
      "repository_source_sha256": "ff60c8173a6be75772be7dee3c2f0fd4a12b704d20c1692784c7d343673e60ef",
      "en": "「I understand how you feel,\\nbut you can't do this!」"
    },
    "144:5727": {
      "repository_source_sha256": "60006efb4622fe671d82bf5ac243f538ff11725e33d270f4344b3c7e97f327ae",
      "en": "「That person isn't the $$赤い彗星$$...!」"
    },
    "144:5768": {
      "repository_source_sha256": "3870539953fba80ce80767ce75a2eeebaf1684260f7eeb49608cd4a00844075a",
      "en": "「Machines trying to rule humans...!」"
    },
    "144:5809": {
      "repository_source_sha256": "b45b870e2bc28dff662da3621f6313344575c506e25bd29efe2d5224a59337b5",
      "en": "「Machines deaf to human feelings...!」"
    },
    "144:5850": {
      "repository_source_sha256": "777aa40fccba89f40785582963d64be2c276c24d6ebb9a5d620d5f4fe2623ac4",
      "en": "「I don't understand it!」"
    },
    "144:5877": {
      "repository_source_sha256": "fe74a5c9531c77eb5a5d02c1b65b20905bb329e4251a00166b8cf2e86405c58c",
      "en": "「I won't let the world break again!」"
    },
    "144:5910": {
      "repository_source_sha256": "53864960d9c6feea8097de8aca296bd6735c9d5b774a089c3ca2804085f2b44b",
      "en": "「The $$サイデリアル$$ are Earth's enemy...!」"
    },
    "144:5947": {
      "repository_source_sha256": "0b5f3fa9d1c7ef015661e8519a2226751b8f4a70b2c2ec5fcb531a7657387ecf",
      "en": "「If the $$サイデリアル$$ are after EVA...!」"
    },
    "144:5986": {
      "repository_source_sha256": "836ed30373d652ac32710b4118dd85b3a809eab86841d16ea46e5138f34ae610",
      "en": "「I'll protect it, other Earth or not!」"
    },
    "144:6025": {
      "repository_source_sha256": "337f32b776ac6c401be938ffa32a8300b748c4efa1aec8f72fc24d4fdbc6ee0c",
      "en": "「You won't use that power any more!」"
    },
    "144:6060": {
      "repository_source_sha256": "e6b8a4537857120f46e8bb2afcfb646e7edca94954562012531b4b63596def71",
      "en": "「That's... a power you must not use!」"
    },
    "144:6099": {
      "repository_source_sha256": "91c0b8fdb4456667093ab1293364da8bc1e5fdafd59f726574e6c745f4846e7c",
      "en": "「Fighting with hatred's power...!」"
    },
    "144:6130": {
      "repository_source_sha256": "494c0715ed77b5b4b78032a53e3daae048bc226bdba2128dae707be97e7c2028",
      "en": "「Before that bloodlust consumes us,\\nI have to do something...!」"
    },
    "144:6183": {
      "repository_source_sha256": "b8fb1f4976038ba0cc1477ffd691ee060332004a911efd84d609375f600f2219",
      "en": "「Beat the commander, beat the army!」"
    },
    "144:6226": {
      "repository_source_sha256": "15038fdc4ee1fcd94b02847c9c2e933e9e15e6d8dfe914ec64b2c9cedfca360f",
      "en": "「That person...!\\nPlaying around, yet so strong...!」"
    },
    "144:6279": {
      "repository_source_sha256": "e24726110d72df6eb5f755cf6659b5160d5f719b0cda237943822469c398bd33",
      "en": "「If that one leads the $$サイデリアル$$...!」"
    },
    "144:6320": {
      "repository_source_sha256": "00fec82edf2c2d30e11a9f2e7260c133a233a0bb9584d59830b912fe72904121",
      "en": "「If only you'd used that power\\nfor something else...!」"
    },
    "144:6373": {
      "repository_source_sha256": "9293bf1ac65644d37d81ebead0d36dcacb267d6248ab56a8aae01b0ba5814674",
      "en": "「I can't let that person\\nhave the $$スフィア$$...!」"
    },
    "144:6424": {
      "repository_source_sha256": "07d397e6260cf57c5ad163a3d017230e3fbea03cdffe8851170236cdaf7a676f",
      "en": "「That person is cursed too...!?」"
    },
    "144:6457": {
      "repository_source_sha256": "14ae76c913a623d143e2f450de1dc7db99cb95801eb0e4d7c6417169a1b46e0b",
      "en": "「No matter what you are, I...!」"
    },
    "144:6494": {
      "repository_source_sha256": "42b9234ad3ba49a3c35795da67fc46b2f0c27e2415088c6de89fc1eb67e43fcc",
      "en": "「Not everything will go your way...!」"
    },
    "144:6533": {
      "repository_source_sha256": "1bcadf171dbef315edf55dbc506490fb74efebe586ce0551445e0ce9756a1e3d",
      "en": "「Telling us nothing, and just\\nforcing the results on us...!」"
    },
    "144:6594": {
      "repository_source_sha256": "f39f558500c23da0f6331dff86830a4cdb846adea346df1f703a08d85913adac",
      "en": "「Is people dying that much fun!?」"
    },
    "144:6631": {
      "repository_source_sha256": "7fcf0430b0028a8a8a8282d3d6f334b68f982144e4fdb34718fcdbd74a031b8e",
      "en": "「I won't forgive you...!\\nYou were deceiving us!」"
    },
    "144:6680": {
      "repository_source_sha256": "4015387941cf90b5f3b04f122ed5a4818d3bed9d0498c24d6a341501bb0088ac",
      "en": "「Some were grateful to you...!」"
    },
    "144:6723": {
      "repository_source_sha256": "6ae13d27d5fde5aaf90a6d61c8dd3e165f243de46d9ed05435026ef8da561b29",
      "en": "「Even mere humans can do something!」"
    },
    "144:6764": {
      "repository_source_sha256": "e0bbb33d8c6db479e6e61ae8950ef81b3bfeba6e5e8d6549899afad1a01c2558",
      "en": "「You are... weak people!」"
    }

{
  "schema": 1,
  "rows": {
    "144:6791": {
      "repository_source_sha256": "73dd4410631a3691689725d0eec4c8ca6751a412f4640ef04b02f970e9302eb0",
      "en": "「In the end, I may never be able\\nto do anything... But still...!」"
    },
    "144:6854": {
      "repository_source_sha256": "232b83754c3d25fd8466cf52570d7425b785528d9122bb1d5066c67dd48714b6",
      "en": "「Protect the future...!\\nThat's what our fight is for!」"
    },
    "144:6905": {
      "repository_source_sha256": "4cb73d981d0a840cb8e94d938866bb074ea9eb620d7ae4a09a295f3e2420d193",
      "en": "「Match tempo... Here we go, $$カヲル$$!」"
    },
    "144:6946": {
      "repository_source_sha256": "f0ce653f67ec02428229e1e68e70e81ddb6a370968c7e1ac5294e770388c9214",
      "en": "「That's why we came all this way...!」"
    },
    "144:1998": {
      "repository_source_sha256": "674002cdc34e218e2e2c3a2e86c885da909984bc58d9b75326b1209e85da2ae1",
      "en": "「I can't let you get away.」"
    },
    "144:2029": {
      "repository_source_sha256": "a1d49f2d3d8cd597114813104e2104e25469e5555a14740a0714f9b56fd1b7ed",
      "en": "「It's my turn.」"
    },
    "144:2048": {
      "repository_source_sha256": "67ab6c7aaa01d043f12ff03684df05c098dade8801e37b28edf54f8533a7199c",
      "en": "「This is where the flow changes.」"
    },
    "144:2071": {
      "repository_source_sha256": "91d965e3adf963dd2bb37e4a276cadd504303712a0b728a633f4e8445c1d75ca",
      "en": "「Let's go with the flow.」"
    },
    "144:2094": {
      "repository_source_sha256": "e3cc996d8a97f15d19e2bdfd8cfbe431ddcead04a4673adad1ffbf699836c442",
      "en": "「This time I'll show you my sound.」"
    },
    "144:2123": {
      "repository_source_sha256": "30e0b20c55bc342b126b7030b7609c48095a204751f7369457f8a363c299e715",
      "en": "「You started this. Right?」"
    },
    "144:2162": {
      "repository_source_sha256": "6b6ecf3a0b2eb06cb5e848666b40163c6a9375d2f5367ba90a013ae9b6fde77f",
      "en": "「I know, a counterattack. Right?」"
    },
    "144:2191": {
      "repository_source_sha256": "b0f8a2cc4e86087c751a829278e65d3f8af0f6b078b84a7a74da6e72f119014e",
      "en": "「Now it's our turn.」"
    },
    "144:7444": {
      "repository_source_sha256": "b013827feb0653e34197d23c1c96933186b41379f34a98ff53c516b1074602d7",
      "en": "「I can counterattack now...!」"
    },
    "144:7469": {
      "repository_source_sha256": "d924b2dd49673ccdbbf84fde5f19cbdb7ae7c9f31e9501745379a13c57a2e736",
      "en": "「I should still be able to catch up!」"
    },
    "144:7496": {
      "repository_source_sha256": "7c8994eb9c0e09906da37ddb938e2de72695702f6a5ff601aa2cb4a40a86ad28",
      "en": "「I can't just keep taking a beating!」"
    },
    "144:7527": {
      "repository_source_sha256": "4e101cf6b65d218ef4f0e85626dfea24f4b9144c85408215e181978da333a79e",
      "en": "「Before I can't catch up anymore...!」"
    },
    "144:7556": {
      "repository_source_sha256": "cd87c74d110835a6610151c330833d98469817070f9dd8416578c8c633f70add",
      "en": "「I have to hold them here...!」"
    },
    "144:7585": {
      "repository_source_sha256": "63484e9f40cc1f731873dca0b690c204143adaf5c0df429a7c9dc2b675ad09b1",
      "en": "「I have to do something on my own...!」"
    },
    "144:7633": {
      "repository_source_sha256": "f7fee2ffcd2d977cecf94795c4d422a81945805df42751a5b92c694dedb4f910",
      "en": "「Let's counterattack, $$カヲル$$!」"
    },
    "144:2218": {
      "repository_source_sha256": "aafc0405f77f522536a338ac5a237c905a59d9e89fd89f7948e38c73a160e16c",
      "en": "「Leave the rest to me.」"
    },
    "144:2233": {
      "repository_source_sha256": "586e5460148b2fb16d5a4e7dc4a7fae307c861fb32f3ecf508dcf240012fe70e",
      "en": "「This way is more certain.」"
    },
    "144:7660": {
      "repository_source_sha256": "4a67e9da8fcca88edff64d94e8ceff2dff41d98b3b803b31db96a5bc22cd617e",
      "en": "「While they're distracted...!」"
    },
    "144:7691": {
      "repository_source_sha256": "5b8963cb20a6c1002f29cbf1704c5f8d38a037fdfbc44d359bb5b692bb4d9034",
      "en": "「If we attack together...!」"
    },
    "144:7716": {
      "repository_source_sha256": "3e1a2a029028d878ae23f506c3eb2d27f569141b17fae9a393a8d3892410c304",
      "en": "「$$綾波$$...! I'll take it from here!」"
    },
    "144:7741": {
      "repository_source_sha256": "61dfeda221ae9b0dc455b4f182f55e0476660f7ddd18bcbbe83c8783e96bb3da",
      "en": "「I'll work with you, $$アスカ$$!」"
    },
    "144:7766": {
      "repository_source_sha256": "56e7c35761bb8d6a266df6f654c45c86c594fde55f0d2ce23c7dc70c8ce6438b",
      "en": "「I'll back up Unit-08!」"
    },
    "144:7793": {
      "repository_source_sha256": "d8ff5307d3979627185fff69591e79e69fcc3460384cd2fbfaf2dd1aaa5884f7",
      "en": "「I'll cover Topless!」"
    },
    "144:723": {
      "repository_source_sha256": "10d17833b9425f041bd7e5e394af01e5786dedcf8521de9b75c3184929a7cf8c",
      "en": "「We can't waste much time.」"
    },
    "144:760": {
      "repository_source_sha256": "af619fcd3ba878394aef12b0791366abe04d0dbe440ae916aaba2378833b43da",
      "en": "「Let's repeat it.」"
    },
    "144:779": {
      "repository_source_sha256": "5fb7a047c322fc0cfc908785234ef80d8c62d981f5346fe3a832a498177d9444",
      "en": "「Let's follow up, $$シンジ$$.」"
    },
    "144:808": {
      "repository_source_sha256": "9115477f9059c2f1feedb6a0bd1d48b63f949576b3a55d169028229736a38edc",
      "en": "「Gladly, $$シンジ$$.」"
    },
    "144:5138": {
      "repository_source_sha256": "5e6ecad2fe42b5daeb3fcb9447e5343d8936bc55b801753874a52ee5e98d5f6e",
      "en": "「While they're off guard...!」"
    },
    "144:5163": {
      "repository_source_sha256": "de732a31858842c0a99322ba5f4e4f48cc25f2bbf640fc43c4b8891e7827984a",
      "en": "「This time... I'll do it!」"
    },
    "144:5188": {
      "repository_source_sha256": "3bb44c4c343b87a3c283d59871c07a64ede1adf58b5284d6b58dacb90a24a637",
      "en": "「Got it, $$カヲル$$!」"
    },
    "144:5213": {
      "repository_source_sha256": "938d0dfa013e418be9ee098bee9ad239ee280a2fa6d44d595e5e8c788034c599",
      "en": "「Once more, $$カヲル$$!」"
    },
    "144:2457": {
      "repository_source_sha256": "22c6b524ed504f7ceca7065eb995e96ce19a263c6e153acfe6560341ffe4415d",
      "en": "「Then let's play an ensemble.」"
    },
    "144:2480": {
      "repository_source_sha256": "0a804f8e8b8db711a3535bb2bec71098b4cd74d9b2d7bdf32cf763b18ec8f981",
      "en": "「Let's take the lead.」"
    },
    "144:2503": {
      "repository_source_sha256": "e4711fbe276f2be35598ba1ccac2ec7fe2490e0eacac993485cfea6740faa941",
      "en": "「Let's set the flow ourselves.」"
    },
    "144:8137": {
      "repository_source_sha256": "fd42b7228519d8f615a710c1fef5bfdb2fa0ec8f92d23b264da2c134de944c22",
      "en": "「I'll stick to supporting...!」"
    },
    "144:8166": {
      "repository_source_sha256": "5a6abc907aa6f63dcfd2ba957532ac3da8812cff93177d752f86a55b7dc9c62f",
      "en": "「First, stop them from moving...!」"
    },
    "144:8193": {
      "repository_source_sha256": "a77649e604d487b05c3bc70edcadf9fc47ceace71e054a8933fd214740eef25e",
      "en": "「If we foil their first move...!」"
    },
    "144:8222": {
      "repository_source_sha256": "6194822909f2f41e2f8d565a738277ceb5ba2f909368d4f04535581172851a9f",
      "en": "「If they can't move from there...!」"
    },
    "144:2372": {
      "repository_source_sha256": "6538b29883643e3145393ed2fd38448f00f82e1681ae714d21dd298fbda5745d",
      "en": "「So each of us gives it our all.」"
    },
    "144:2401": {
      "repository_source_sha256": "8a0f1b6978e619f8b52efd2c66a7256b077eda0ca06d468e87f4eaaa60b67f61",
      "en": "「That one must be my opponent.」"
    },
    "144:2426": {
      "repository_source_sha256": "ee0df220fe88025de7d6bb00028ecbc672c8f5a55ad76dccb272adbfd71f79b5",
      "en": "「A solo is nice once in a while.」"
    },
    "144:8009": {
      "repository_source_sha256": "044b25b2cef14542009deb73c77c18b619d04ef0318a4025fd7cf236de7f0a7e",
      "en": "「I'll lure the enemy over there!」"
    },
    "144:8044": {
      "repository_source_sha256": "8f813e4fe103eb716baa00e4de4c79b6b21fca270f5a30716867c4fe6745a50d",
      "en": "「They trusted me. I have to try...!」"
    },
    "144:8081": {
      "repository_source_sha256": "65733869843f07f94f7f14d7f6a67501b3d282384abd80ab4adc7766a3c7bef8",
      "en": "「We'll take the enemy over here!」"
    },
    "144:8106": {
      "repository_source_sha256": "5a159e437577a6ef2b94fe1bc3e1f7e117a428045ba705f130c29683e2d7ad7f",
      "en": "「I'll handle my own part myself...!」"
    },
    "144:627": {
      "repository_source_sha256": "0557a689ae9f706f299340ad45a20d347f9d60263b6f1ee24b654c2bac839275",
      "en": "「This looks better.」"
    },
    "144:656": {
      "repository_source_sha256": "efd1fea4eb235a4ae92426af9aef243cbde4cfcf2465a8a5b2a18aa005c24459",
      "en": "「Good distance.」"
    },
    "144:671": {
      "repository_source_sha256": "40910fb4eb89d7728f342607a5a388537a407fc8acd309bb50968c789305f45e",
      "en": "「I can't hold back.」"
    },
    "144:696": {
      "repository_source_sha256": "2e39fab50737f5ce6263f7022f3c3805e24bf9b1d80b95e3b73e2969b299dfc9",
      "en": "「How about this?」"
    },
    "144:5030": {
      "repository_source_sha256": "ebab47533bb85e7fd6456329879e5ed2f9c17ef5d139f2742e959d22bdc5e4a4",
      "en": "「Take it to close combat!」"
    },
    "144:5057": {
      "repository_source_sha256": "34ecf68a98665660a1cf1f552e42870fffafae7620a0f9ff69864ffef3561534",
      "en": "「Even if I ram it, I'll stop it!」"
    },
    "144:5086": {
      "repository_source_sha256": "9d62ffd884c4052a4f541cbede685b96f937325a570090d7747ad9e172cf20bc",
      "en": "「Head-on...!」"
    },
    "144:5111": {
      "repository_source_sha256": "d5db11d66bcf72bd98fcca64b0946bd6d92671624fd0268247f288c6ccf603b2",
      "en": "「I'll do it, even if I'm scared...!」"
    },
    "144:3670": {
      "repository_source_sha256": "cdae23ffb16c690ee252c6f313ef08e55c16c9526f887dcdbbb63cbd7bb4cd11",
      "en": "「Sorry, $$シンジ$$...」"
    },
    "144:3693": {
      "repository_source_sha256": "d9fd0057f0b797b0111989cdad7c775fd74281431d19171439085f53341a2778",
      "en": "「I'm sorry...\\nThis wasn't your idea of happiness.」"
    },
    "144:9569": {
      "repository_source_sha256": "6fc532f777bc8d7cbef5f25d092f01e5524d162a3fd5e54004b99c988956ce61",
      "en": "「No...! Is this as far as I go...?!」"
    },
    "144:9606": {
      "repository_source_sha256": "2c98ec4845e759e2b272cc370ad60bd892bde5d073129761bc4c60253055598d",
      "en": "「Waaaaah!」"
    },
    "144:3379": {
      "repository_source_sha256": "591bf2f184e71476086c5fb3dc01bf5974601670765b5a2e1cd35fa78e5a6591",
      "en": "「I see. You're terrified too.」"
    },
    "144:3422": {
      "repository_source_sha256": "35b2017997e713f7ad4236ddeeb6ffb35e74a97e407a4242b2ca8ab350294d7b",
      "en": "「I must protect $$シンジ$$ at any cost...」"
    },
    "144:3465": {
      "repository_source_sha256": "71f521a9a2efff7ab954a5e74657b3dd242d5148096d0b8fd104e20848f235de",
      "en": "「You're desperate. Painfully so...」"
    },
    "144:3494": {
      "repository_source_sha256": "04dc93a83ae6ad0c0048b6fbc4f3bcd38d39452b3fc82d8b5fd37cae77848459",
      "en": "「As long as we don't give up,\\nthere has to be a way...!」"
    },
    "144:3547": {
      "repository_source_sha256": "7f88536ae45ed27a838c43ff2d912a2239a6544a5d2126e7503a82d309dbfcbc",
      "en": "「Let's do our best to the end.\\nThat's our duty.」"
    },
    "144:3600": {
      "repository_source_sha256": "d36ea4f19a2c74ce8daeae54eeafe8e77d020f6c85c11c0f74fec25b2c376251",
      "en": "「There's still hope, no matter when.」"
    },
    "144:3639": {
      "repository_source_sha256": "256de8fab7a26f9eac9bfaa8a958600ac5e468e7e0a9cec7b0e394ead598d3fe",
      "en": "「Don't worry, our chance will come.」"
    },
    "144:9294": {
      "repository_source_sha256": "edfa835991d52ba558a175a42bcecd61314e6b48347e0cd2006039face527d27",
      "en": "「I have to protect...!\\nAt least $$カヲル$$...!」"
    },
    "144:9347": {
      "repository_source_sha256": "5b8220fc9e7d4c1fe4289232766c267647f050a3d17fcfabe43da4d3ea8fd768",
      "en": "「No, if I take another hit, then...!」"
    },
    "144:9386": {
      "repository_source_sha256": "773a44b8aedaa8b3ada81a241adc08828a0e8f31b2fb80bf874adb9713b3f568",
      "en": "「This must be... my punishment...」"
    },
    "144:9421": {
      "repository_source_sha256": "839fbad1c858f020ed14f7ae4d9742f91b0d6beaa9908e08e97446ba69889868",
      "en": "「I'll... fight to the end...!」"
    },
    "144:9452": {
      "repository_source_sha256": "93fff5d0cc7b71c440dd117c52bc748174cd63a9aa6747691718acbc96414653",
      "en": "「$$カヲル$$...! What should I do?!」"
    },
    "144:9491": {
      "repository_source_sha256": "df2a8ef00fe2b7ef728dcf7409f72ad95b584a927ab73c39330df7ccfb4a8279",
      "en": "「$$カヲル$$...! At this rate, we...!」"
    },
    "144:9532": {
      "repository_source_sha256": "7aa2cd836f200449a85b1e478db245fd4403cd7e52ac460bcfc285097e25f1ab",
      "en": "「$$カヲル$$! At least you, get out!」"
    },
    "144:3165": {
      "repository_source_sha256": "fe2d6472ef2b47e7f6a808e2be9627d8b2c808168358b158a84342488f8f0990",
      "en": "「Do you hate us that much?」"
    },
    "144:3196": {
      "repository_source_sha256": "057136377808163279ab863d5d4e6f2ca4eaed64a128d1756fea46a7051a31b5",
      "en": "「We can only reject each other...」"
    },
    "144:3231": {
      "repository_source_sha256": "98f11fc45e8bb05e64ea5fc92784dbf42ffa2c5b515e77aac2469b76a73b89b2",
      "en": "「And so hatred keeps piling up.」"
    },
    "144:3274": {
      "repository_source_sha256": "09cb459301e574f1becf033139ba00117c2bc5880b87191a4e858c8e5c3c3baf",
      "en": "「$$シンジ$$'s heart is out of tempo...」"
    },
    "144:3313": {
      "repository_source_sha256": "80bf3992d0535d9e3a4b94b8445f26b174ffd3d0e9e12b2bc45fa078aa56ac7a",
      "en": "「It's okay. Recall our piano duet.」"
    }

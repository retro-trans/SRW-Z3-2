{
  "schema": 1,
  "rows": {
    "144:3350": {
      "repository_source_sha256": "437d6801e4c686f53803948ffab3830f1ce9196d3ab8763e750a26512bfe965b",
      "en": "「Don't worry about anything.」"
    },
    "144:9023": {
      "repository_source_sha256": "37433089a577f5c140c1df4d37f0aa3a8755e81b601eae9d2ac2c86e2469bcee",
      "en": "「Wah! Aah...!」"
    },
    "144:9044": {
      "repository_source_sha256": "e564c6ed653687d1939d442f2a96312e594dca2b20cac78713fa58139d35f237",
      "en": "「What is this!?」"
    },
    "144:9065": {
      "repository_source_sha256": "43b1523e7602a762a59923f12117c7c5e686846d34115e9756d03515c56029bb",
      "en": "「Coming at me with that attack...!」"
    },
    "144:9096": {
      "repository_source_sha256": "fcaf7cbd308fdf0753183ac126f3c890589c6328a99a81411e253fae749b6f61",
      "en": "「I must turn this bad run around...!」"
    },
    "144:9137": {
      "repository_source_sha256": "7736caf402a42f8f82e40ca8b7f0ac3197190e52b869911315db6fbd06eb225d",
      "en": "「I... mustn't run away...!」"
    },
    "144:9170": {
      "repository_source_sha256": "d24702d30627172df5de49d2dff1829b8978e6fa334a703bfaa680e175617da9",
      "en": "「No matter how much it hurts...\\nI have to keep fighting...!」"
    },
    "144:9221": {
      "repository_source_sha256": "f515308d0cbcaa9ad5173f609da3c8f140d71f007c331afcb9de9439d7ef680a",
      "en": "「$$カヲル$$, at this rate...!」"
    },
    "144:9252": {
      "repository_source_sha256": "40c3101b234d95281fa133769078ca1013369c403c64ad1b3609d9ce976253fe",
      "en": "「Huh? But...」"
    },
    "144:2981": {
      "repository_source_sha256": "cdff7b2a7decd819c14e3246871adb9ee510ac216e989e87365c73921b80157b",
      "en": "「This much is no problem.」"
    },
    "144:3006": {
      "repository_source_sha256": "ded06ec0d5ed247138060ceff956270a3f7e63e61a3c2744942a8a59ab435a7a",
      "en": "「I hope $$シンジ$$ doesn't get scared.」"
    },
    "144:3041": {
      "repository_source_sha256": "d7115ae2f7817ac3b70e8738d553d3eab9540ba6c8f8a375e8a5187a8d66ecf6",
      "en": "「Did the tempo slip a little?」"
    },
    "144:3078": {
      "repository_source_sha256": "6bd11079602eebf06d07c9f5dc036fe0a3c4eeacccf77672214cb46cffa7916f",
      "en": "「Is this really all you've got?」"
    },
    "144:3115": {
      "repository_source_sha256": "14b7008e82b93f08025db1d870e5d8ff2516f0cc4010ffcb0fdd3df3ae5abdfa",
      "en": "「But that's all it amounts to.」"
    },
    "144:3144": {
      "repository_source_sha256": "0c4e13700afad089575449e1f092a810b1cfa689550a91e8bd817c2f69188454",
      "en": "「Sorry, $$シンジ$$.」"
    },
    "144:8809": {
      "repository_source_sha256": "24f69f6fddc40b2cd4f57f4e5ba08e121a2e848666152b44cc0a54300764ed02",
      "en": "「It wasn't as bad as I thought.」"
    },
    "144:8861": {
      "repository_source_sha256": "f9ed9cac73d00e2b826f8f8f7d5d30a0e2a912d008287f4dfacb46b916e79564",
      "en": "「This is nothing much.」"
    },
    "144:8888": {
      "repository_source_sha256": "90baa083a49bb1292e49f67e9c0491adac7e641b34087b8560b2ae2e68a9737f",
      "en": "「I got hit...!」"
    },
    "144:8907": {
      "repository_source_sha256": "76ee67ef363c41dffb99fd5022beef89e17ee11988b1cfe8d21be9367bf04614",
      "en": "「I couldn't react...!?」"
    },
    "144:8934": {
      "repository_source_sha256": "f7617869cb10bcd7f59ec27a46ba83110588f11c9ac858691d00cafc5b595cb2",
      "en": "「Sorry, $$カヲル$$! I couldn't dodge!」"
    },
    "144:8994": {
      "repository_source_sha256": "da3fcf3489696846954d5731220824dab5eaeae3f7a934dd4dd67f70a7837ab3",
      "en": "「No, that one was my mistake.」"
    },
    "144:2665": {
      "repository_source_sha256": "0e3f6824ef11f2f3973f1fef398cc8cdaed8ca37a17bc1aa37a071f818e0e9ce",
      "en": "「Your sound is muddied.」"
    },
    "144:2688": {
      "repository_source_sha256": "03da80c1a9a521b0f313fad01165e08f5c90db78104d3c36ba6e6386183bf298",
      "en": "「I can't let myself be taken down.」"
    },
    "144:2723": {
      "repository_source_sha256": "8efdf18fd96cd69d87dd5cea3257165617597eb0ffddf11aad1b557fd67375ee",
      "en": "「We're the hope of the Lilin, too.」"
    },
    "144:2760": {
      "repository_source_sha256": "fd307c3b16450fc525f563ca8c21ff2f83e11660dd321ec40df4ea10617ab08a",
      "en": "「Your feelings are racing ahead.」"
    },
    "144:2793": {
      "repository_source_sha256": "e78d643aaf400c23c5b7789ecaeb81ccdd960e74a6ad4c3797c8cd229cb7d29e",
      "en": "「Nice! I love the sound with you!」"
    },
    "144:2824": {
      "repository_source_sha256": "21ed64f1f4aa3b7d6fcbd49c4cbaedd6b34e9f3b0389306afcc35a10da0ce04e",
      "en": "「Fun sound. Two together is amazing.」"
    },
    "144:2857": {
      "repository_source_sha256": "adff9708aa3a7383f3dee3cf8f1eb53285ec252ef8df6b5bed3d1308bc2ebdbf",
      "en": "「It's because you're here, $$シンジ$$.」"
    },
    "144:8448": {
      "repository_source_sha256": "f9bb058bf0378c64185f44f45b707e8e7d84beca3450293b6b5d1106da22b02b",
      "en": "「It won't hit me...!」"
    },
    "144:8469": {
      "repository_source_sha256": "029c73cdbb70ea14463d2053a04a4407243e688e93270a663753c27aff822726",
      "en": "「Not with that!」"
    },
    "144:8486": {
      "repository_source_sha256": "3f1ba5182fa352e1381576b69a8346d1d2020fff7b2ff99a89cdb1423d51fb4a",
      "en": "「If I keep this up...!」"
    },
    "144:8511": {
      "repository_source_sha256": "11d1d983185a9a47d0062860fb48c3abd38004716ce68c7ace652582f6de595a",
      "en": "「Nothing seems wrong anywhere.」"
    },
    "144:8538": {
      "repository_source_sha256": "42605cadb5fe6747b0a5c381a70b1665ee0866d83be6bba16509455b89e480b1",
      "en": "「$$カヲル$$ is fighting with me too...」"
    },
    "144:8577": {
      "repository_source_sha256": "ed21d0a340ef9b08b62447c85318e57449d49fa1ccabd1ca423e669b75ee42b6",
      "en": "「I have to do it...!\\nEven without $$ミサト$$...!」"
    },
    "144:8628": {
      "repository_source_sha256": "7590c0ec51afbbbcd180afccec8b9815f87fbd3819804214b80dca0593b96609",
      "en": "「Th-thanks...」"
    },
    "144:8647": {
      "repository_source_sha256": "9915a4f831bdc2ab0451395695a7cd330e1beac9d814e3a1ab2b6c8ce1558923",
      "en": "「You're right, $$カヲル$$!」"
    },
    "144:8672": {
      "repository_source_sha256": "1f1015ec62e70e4f8aee046c1a152fb4d5ae166d0d54c9d6412b3f5f282dbc6a",
      "en": "「Amazing. You can do anything.」"
    },
    "144:2888": {
      "repository_source_sha256": "735e20bbd2683f65e33fa963758b3d63d61f5f71458641627cdbfa20bb0270a0",
      "en": "「No matter how often, it's the same.」"
    },
    "144:2913": {
      "repository_source_sha256": "d4c4e3894cbf93a447fad03ba3cd57c2adf6823aef6d1156b8347e568f58024f",
      "en": "「I'm fully prepared.」"
    },
    "144:8726": {
      "repository_source_sha256": "61f3c5da4a5e3ab60adf4dd5db40d19316a964fddf77b9b1ba3c2d414bf8d4d2",
      "en": "「I'm okay, this much...!」"
    },
    "144:2930": {
      "repository_source_sha256": "3fa7d2cda748645c591a93a3b74ae43740588552d9c75ed0f8fe69de6404f970",
      "en": "「It's a slightly unusual\\nA.T. Field, isn't it?」"
    },
    "144:8780": {
      "repository_source_sha256": "07495eb280c5a6a63f8d943fc9c2739e3f930821817e375d32593a250261f3b7",
      "en": "「Go back and protect the unit!」"
    },
    "144:3742": {
      "repository_source_sha256": "bf3f69d7922cc74444cda45564aa8056138bf9476962eefcf0c51fefd299cb38",
      "en": "「Just repeat. Same stage, again and again.」"
    },
    "144:3795": {
      "repository_source_sha256": "32222354ceeb973f9e340702832b77c5e28938e02964446f53dd3dbddc189a8e",
      "en": "「Until you reach a comfy level and funds. That's all.」"
    },
    "144:3862": {
      "repository_source_sha256": "25bcc6f110c207c27d0e76e3e19076da2dbe4d6514437e95488ae4d5e3a5211d",
      "en": "「But for now, resting comes first.」"
    },
    "144:3893": {
      "repository_source_sha256": "a06a649e07d08991a0a0adb2a765bd89af664aa48a9269e6b76f650d69437b87",
      "en": "「Don't make that face. We can resume anytime, $$シンジ$$.」"
    },
    "144:3948": {
      "repository_source_sha256": "28931d16ce813711096bdf5ae92c4f6be3798e6861806d4be6474c503483fb29",
      "en": "「If players want the world to go on. Till then, farewell.」"
    },
    "144:4033": {
      "repository_source_sha256": "6f2090e93ed32676ef178971c1f1ad0f0b557b2b94246ba58469a9f93860f382",
      "en": "「Me too, $$シンジ$$. I want to play with you again.」"
    },
    "144:4080": {
      "repository_source_sha256": "5a76186045f49408c3b95157d69a36fd3bc40eb5206c368d6e75764d792db9fb",
      "en": "「Super Robot Wars is solo. But watching is fun enough.」"
    },
    "144:4145": {
      "repository_source_sha256": "2fd7a6fa8e40bc96a956db0a75cb13ab2ffe4167c77096f5a0c77b2aea341225",
      "en": "「Because I was born to meet you.」"
    },
    "144:9627": {
      "repository_source_sha256": "9a50ce9e61d1bc0d07119bfd7c45f2d5e7f5e61eac8c573ba27fb8e73156065e",
      "en": "「Hey, how can I play better?」"
    },
    "144:9682": {
      "repository_source_sha256": "03070b7980107cbf83e9792856dc14092b3b15fec64a487369b8a8dba19d561d",
      "en": "「Huh... But I was just getting the hang of it...」"
    },
    "144:9729": {
      "repository_source_sha256": "d1d58e430891d3338c9649041b00a5b856afb6d2e01de6a119e3bd5440ca62d0",
      "en": "「Good night, $$カヲル$$. Good night, players, too.」"
    },
    "144:9794": {
      "repository_source_sha256": "041bf1b1e2b3f0f8a3c8d82ee591e13128a76a2793948c1727b0462bbf8c93a6",
      "en": "「Playing with $$カヲル$$ was fun, first time in a while.」"
    },
    "144:9879": {
      "repository_source_sha256": "8d98a0bf3f95a935656d8f115e556a4ae831360f6d5d065709bed3564c6a417a",
      "en": "「But... is it okay? You only watch me play, $$カヲル$$」"
    },
    "144:9948": {
      "repository_source_sha256": "bd777979f5ab4b78256299ce99d34b99c8399d0c40987057bca1901d49b9c7ae",
      "en": "「$$カヲル$$...」"
    },
    "144:9963": {
      "repository_source_sha256": "a28817a3c09b68ecd28c23f9122c69bc30cf25cf96a548238f55e800d75b6c25",
      "en": "「$$綾波$$, if you're free, want to play with me?」"
    },
    "144:10006": {
      "repository_source_sha256": "f46dc7eb5bde6d712179bdd5e4054b58c30196c779d6bcf4377bc88409ee4ff8",
      "en": "「No, it's not like it's an order...」"
    },
    "144:10043": {
      "repository_source_sha256": "d674bf6889a32c38d43cada22973edb506b8e071dad4f254076dff0b8155a72e",
      "en": "「What do you... want to do?」"
    },
    "144:2258": {
      "repository_source_sha256": "7ce3a22ea5e5293cd115d1f7f22b24a0af7f6b97d34424c6fc8e7bf8cb7c521e",
      "en": "「We'll take care of this one.」"
    },
    "144:2289": {
      "repository_source_sha256": "b1323d09c29ed166857138501582332587e9bcbc2062d4f96c841636e837ae1a",
      "en": "「You are the hope of the Lilin.」"
    },
    "144:2320": {
      "repository_source_sha256": "4ea11b320d49806f8df16e6b3cdc6cbe296ec9cd275155333fe56955f4bf671e",
      "en": "「You should keep singing.」"
    },
    "144:2345": {
      "repository_source_sha256": "43eef0d61f952d26bdab52d88178545170ed592ec55aa994a02c31e36bf0ff65",
      "en": "「I won't let anyone disturb the music.」"
    },
    "144:7822": {
      "repository_source_sha256": "d9fd904a934477aa18786b1331eb721827e9aee15b3cdfcc4a5809c62c156414",
      "en": "「I'll take this hit...!」"
    },
    "144:7847": {
      "repository_source_sha256": "3f24c6dd43192368f36a4117ac052415469b947724962ff0f560bb5bbbf9538d",
      "en": "「I'll protect you...! No matter what!」"
    },
    "144:7874": {
      "repository_source_sha256": "bdd871a062480aeaa2e9b99f8bc4773e0d60160505407e04ba3c8c208b054f69",
      "en": "「Get back, $$綾波$$!」"
    },
    "144:7895": {
      "repository_source_sha256": "760538be513121d121ba7008eaa52f5775eec943b196ed80a8adbd0f2a19026a",
      "en": "「That's reckless, $$アスカ$$!」"
    },
    "144:7918": {
      "repository_source_sha256": "7780dace09f38be7c3e61419e00cb4852d6786f4d3c5b83cb0ddf058a04a3c24",
      "en": "「Unit-08, fall back!」"
    },
    "144:7939": {
      "repository_source_sha256": "f9010998d09baba89b7aadf7c2acda5a9eb5456eb594dbd5812fd6b18a754f84",
      "en": "「I won't let them take out $$トップレス$$!」"
    },
    "144:7972": {
      "repository_source_sha256": "da744936d3382f371435b0ac591d137671ecb24c1ee3054c19794caf3e1e862e",
      "en": "「$$ガンバスター$$ is humanity's hope!」"
    },
    "144:2526": {
      "repository_source_sha256": "988fddbda1b547c0d6ca63148d4d2475ab45017003bb27b25b4fd08297be0866",
      "en": "「Looks like all we can do is give up.」"
    },
    "144:2553": {
      "repository_source_sha256": "8873ab078bc5a3c89d4a2bac551a39d025a5787a93e704d0536629dd1e90ae09",
      "en": "「These things happen.」"
    },
    "144:2578": {
      "repository_source_sha256": "84c8c72414484c27ac6e0b335e783c922f011a8201c46541e593216256705d4c",
      "en": "「That is certainly effective.」"
    },
    "144:2601": {
      "repository_source_sha256": "8db12f80553acfcf8c20497f6b503f577c14532734d38e97f0f18ddaad9ca44f",
      "en": "「Nothing to be done. Let's wait for a chance.」"
    },
    "144:2642": {
      "repository_source_sha256": "97a01d01786da2ed51e19a4a34bfa59ef4746d5e97367819abdefff41d6492ef",
      "en": "「Getting impatient won't help.」"
    },
    "144:8255": {
      "repository_source_sha256": "46832716d318d361ee32f734a0bfa57f91ef442d019bb535b1bed6d949eca83d",
      "en": "「Can't counterattack...!? No way...!」"
    },
    "144:8286": {
      "repository_source_sha256": "09a0700bce488172b5c08afba081b07d94cf0e792eeeb529daa5499f6428a5ef",
      "en": "「I never noticed this would\\nhappen...!」"
    },
    "144:8339": {
      "repository_source_sha256": "2410b5f076a8dc63854790914b5ca33fb34193bbacc933d4456efe66e11876cd",
      "en": "「What would $$ミサト$$ do\\nin a situation like this...」"
    },
    "144:8390": {
      "repository_source_sha256": "daffe30b5922afe719e059cc9260103691a1f3dc3cb977d0a6d625b68d87d71a",
      "en": "「What do we do, $$カヲル$$...!?」"
    },
    "144:8421": {
      "repository_source_sha256": "90ea5e26563eb309cb359a432309014c71e0ace2479620b80897312d7bc0ee91",
      "en": "「But, at this rate...!」"
    }
  },

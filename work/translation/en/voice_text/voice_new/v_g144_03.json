{
  "schema": 1,
  "rows": {
    "144:325": {
      "repository_source_sha256": "f871c507354d46c4d5e37120c28ef3d17f3eec0839b164099918e1d37438188b",
      "en": "「Maybe everything is already decided.」"
    },
    "144:364": {
      "repository_source_sha256": "50658cf07c379ac9ab2be46770d43f96390875aeb95405ea211e0c2ce5365829",
      "en": "「Be patient until the time comes.」"
    },
    "144:391": {
      "repository_source_sha256": "de07fb140f0ed31772123f2e2a52cc5bcab4169a287a3937b7acb87e8b367e89",
      "en": "「How sad, that force is the only way.」"
    },
    "144:432": {
      "repository_source_sha256": "ec0aeb30706d510f1b72d53cdbfcff1a8c245a6a3058d5cf083bf3da3d3900c0",
      "en": "「It's necessary, after all.」"
    },
    "144:455": {
      "repository_source_sha256": "dcb07e6e4d10aa28f58af8ec56610774f1f350627666c6e21108a5f1ed909aac",
      "en": "「Perhaps it's our fate to fight, too.」"
    },
    "144:490": {
      "repository_source_sha256": "1d4dc353b1848196dcf2d49226345a4216ed78298b945c5d28fd7cfff6b41da7",
      "en": "「This is $$シンジ$$'s wish as well.」"
    },
    "144:4592": {
      "repository_source_sha256": "87a9b26cbbb860fdd70402ede5feab84f93aab7b146d845cf8b2cf15654245ce",
      "en": "「I have to hit them first...!」"
    },
    "144:4671": {
      "repository_source_sha256": "4561eda2f072d0e3b025d4b44c56124f9867514dd55c552bf6a0b59eddfb4716",
      "en": "「I have to break through...!」"
    },
    "144:4696": {
      "repository_source_sha256": "6c39c16a76ddfa89b93ef8237be90dd012ebf8d872565af32ee98eb28a50549f",
      "en": "「I'll stop it by force if I must...!」"
    },
    "144:4725": {
      "repository_source_sha256": "7a4773006a06cc6b1b37a76d41a0fa7941f568c8045d7ec6c933d978c7c79545",
      "en": "「If you're coming at me...!」"
    },
    "144:4752": {
      "repository_source_sha256": "483af54dd5cbc8c106cd8047676eae67efb1ef3e9a6d3b2a64299efb3fe264d7",
      "en": "「I'll at least do what I can...!」"
    },
    "144:4785": {
      "repository_source_sha256": "5bed09950c5027437bdb51364f32bcb8cb17e0da7c2440d497d25b6895a44f98",
      "en": "「If that's how you want it!」"
    },
    "144:4806": {
      "repository_source_sha256": "802c8e22c215b18f326ecb8bd66be97398654867fb1b23f6f86c06094bf4cdeb",
      "en": "「Even without $$ミサト$$'s orders!」"
    },
    "144:4839": {
      "repository_source_sha256": "d73cc4e7ceecd31ea28e9d3e355b68c68e8a79a8254e010040e354261f49cbfc",
      "en": "「If I have the power to fight...!」"
    },
    "144:4864": {
      "repository_source_sha256": "27e9afd8b2fe4b03be3efbcdca673fb6f3048fc41772b5ddb2778ba421271dd1",
      "en": "「Because this is all I can do...!」"
    },
    "144:1477": {
      "repository_source_sha256": "5b64320c7509147b769dc38d5d99d0bf79750767e1e76ea6230ca7694b80fd40",
      "en": "「Let's sync our tempo.\\nRemember the piano duet...」"
    },
    "144:1532": {
      "repository_source_sha256": "c531e0e46a34599904bd4ddb393a5f0e291532172bb580ea1fd4e63d6ca58ad3",
      "en": "「Nice...! I love our sound together!」"
    },
    "144:1567": {
      "repository_source_sha256": "51e334be39059b9c385a453e0676412ec07bb7b093f99154c67c2ffa7037cca4",
      "en": "「Remember when we played it right?」"
    },
    "144:1610": {
      "repository_source_sha256": "58e9ca32ff7ee384456484d902df686092c20c17c34da8ee1698fdfcc6c128ba",
      "en": "「$$シンジ$$'s sound and mine overlap...!」"
    },
    "144:6987": {
      "repository_source_sha256": "d725367ea9d7dd4c0099875930df76872eeefa06d432922ec419fdc7deb8a821",
      "en": "「Let's go, $$カヲル$$.」"
    },
    "144:7008": {
      "repository_source_sha256": "49c02cfde035846cc5fea489fdd4c429799ad779db5961639c2b47a63359bc76",
      "en": "「Yaaah!」"
    },
    "144:7021": {
      "repository_source_sha256": "085d8f30e7ad03f8bf1782d31144155243cf4d0c85aacf6c68bc20c78262bf35",
      "en": "「Of course, $$カヲル$$.」"
    },
    "144:7048": {
      "repository_source_sha256": "e3f153bb34c426d7104e2ddebdc0061bcf5a45a574fe590d766ca668198e12f4",
      "en": "「Let's go!」"
    },
    "144:523": {
      "repository_source_sha256": "046e3a83afef852ed8fa65821b97f7c080e88c087e452f6ac8a2f854c40ca50e",
      "en": "「Sorry, but I won't miss.」"
    },
    "144:548": {
      "repository_source_sha256": "9cf97823e4ad9ae1b528bea8a0b5f766c485587c050db8e7b322c18961b8da11",
      "en": "「If you notice, can you even dodge?」"
    },
    "144:583": {
      "repository_source_sha256": "faa50281221a78fcf1f25ab69140ef215188db29d0f8bc2d568f4846fd495ef3",
      "en": "「I can read your movements.」"
    },
    "144:608": {
      "repository_source_sha256": "162023c389a6aefd183d566cdc180a20256260ba7645aa001070f62d0e00836b",
      "en": "「You're already locked on.」"
    },
    "144:4934": {
      "repository_source_sha256": "b5a20902a9f951a9ec8843b599dae1f901558eb890f3282ab315691889223601",
      "en": "「I won't miss...!」"
    },
    "144:4951": {
      "repository_source_sha256": "95b7497f49f6bb2e0d6eff9470dd2b68d5e5ae32acde571070f85f69307bee7c",
      "en": "「I'll hit it!」"
    },
    "144:4968": {
      "repository_source_sha256": "64e8a26882d0022912982b0d3ca18b48bced680cb532903bf1f603fffd75751c",
      "en": "「Target in the center... switch...!」"
    },
    "144:5007": {
      "repository_source_sha256": "143a72afce2077b6bfbe4238661bd6e1f8a25341fdad9cdd9616b16b5b4c7c4c",
      "en": "「My body... remembers!」"
    },
    "144:1742": {
      "repository_source_sha256": "b17c93f49878fe4d601794665f3a02c36cbf148c3686c27b4a4ce8c73e6bc140",
      "en": "「Seems no need to go out of our way.」"
    },
    "144:1777": {
      "repository_source_sha256": "9e5e5a6b02b8554d7f993c9a9ce065d9b129b0be47df1aca8b019d4761231de8",
      "en": "「At that range, this should do.」"
    },
    "144:1804": {
      "repository_source_sha256": "6d7eafe9b7156b844ff416651cd627577178e2135c1387d4550a49da575e3c1d",
      "en": "「Backing off won't help you escape.」"
    },
    "144:7140": {
      "repository_source_sha256": "2bb138bacf5bbca44594fb4c814331175681be8762ac1286269712d03565bc17",
      "en": "「If there's distance between us...!」"
    },
    "144:7163": {
      "repository_source_sha256": "92fb37491c095f1e3971bbdc7e9cdf116ac48c0ccce68ba6a64ffc9a382ace64",
      "en": "「I can use it like this, too...!」"
    },
    "144:7192": {
      "repository_source_sha256": "7dc0b1c2fa0350ae9eb21c546eb07268813bb9638cbf86a42ec461c0e2057e20",
      "en": "「There! Gooo!!」"
    },
    "144:1649": {
      "repository_source_sha256": "c989533f775c2ea649ae9c90d4618e33f452dd269b9d28b82fb9066f935b3301",
      "en": "「It's a hassle if they get too close.」"
    },
    "144:1680": {
      "repository_source_sha256": "d00adf4c11f8b627ac62605ef44303789b1479943281b37449e949284a76760a",
      "en": "「Time to push them back.」"
    },
    "144:1701": {
      "repository_source_sha256": "3f695e2cceeb2bbd53ac75580bd0fc667bf7274eff2f0950b2622d094af3c5df",
      "en": "「Touching $$シンジ$$ or me is forbidden.」"
    },
    "144:7061": {
      "repository_source_sha256": "5afa9713a38a04c49808c55ef7e65ef8e7b370eda868da1656518140292ca42b",
      "en": "「Too close...! Then this!」"
    },
    "144:7086": {
      "repository_source_sha256": "7dc453f28733d13c198cfb0727624f73a947eb9dc741531bb953b6f16d20bc8f",
      "en": "「I won't let you get any closer!」"
    },
    "144:7121": {
      "repository_source_sha256": "f4aca5a963c8f7257819901acd9878a6861bae2090fae58ff5fed83d84b0301b",
      "en": "「Goooo!」"
    },
    "144:1839": {
      "repository_source_sha256": "642857232a4e0cdf661ba36a46ac4041bb5c7df8de4ecc5b2aa9ad4adedc61a1",
      "en": "「Let's use the spear, $$シンジ$$.」"
    },
    "144:1864": {
      "repository_source_sha256": "49a21f35e934374d79a166128261077f145f08d1b293e61b17458eb6579ba9e4",
      "en": "「It really is better with both of us.」"
    },
    "144:1897": {
      "repository_source_sha256": "bfc9a50509b012a1ae6a0ae830b8b84437c412656e5278523b8ae1dad85ee003",
      "en": "「$$シンジ$$...\\nYour feelings will be heard someday.」"
    },
    "144:1946": {
      "repository_source_sha256": "fa82cfaf35125fadbec625750e6ce47aaa48e6aae9a9f771629c55baf2f82c02",
      "en": "「Let's do what we can right now.」"
    },
    "144:1973": {
      "repository_source_sha256": "3ffd4e06dddd78f48db3b13999706b2db435dfa9c674a72631fc5bf97b1db029",
      "en": "「As expected of you, $$シンジ$$.」"
    },
    "144:7221": {
      "repository_source_sha256": "ca02bd35e2b62cb9e6a729199099a74585d17314b33af4e5498003c94766719b",
      "en": "「Y-Yeah...!」"
    },
    "144:7238": {
      "repository_source_sha256": "5c07497de4e52af133deed2c3a4aba38a65ec99d0ab504975c41db09a28b12e9",
      "en": "「This power will end the fighting!」"
    },
    "144:7271": {
      "repository_source_sha256": "a7d6f3b6d5106be3a3b8c4d894b5b2ca3d0b04f7dca5a86c2c52f564756c3d47",
      "en": "「I did it...!」"
    },
    "144:7286": {
      "repository_source_sha256": "021764634f79bfd2f59dd86e3f5874bf661d674911734156245a65a46f874336",
      "en": "「This is the world-repairing power...」"
    },
    "144:7340": {
      "repository_source_sha256": "522c74fdbe2e0d5955298a8750f9569c534db224bf910126638a87cd0c0cbfc9",
      "en": "「Haah... haah... haah...」"
    },
    "144:7363": {
      "repository_source_sha256": "2e97793188feac79aba050bb61deedb689a0694ca0299790b808ac37d8bca50f",
      "en": "「With this spear...!」"
    },
    "144:7405": {
      "repository_source_sha256": "1fa06d2264eb03e627ddbec2894e74ed46b48e1521c2af0b57b996b0f0d5578c",
      "en": "「It's because $$カヲル$$ is with me.」"
    }
  },

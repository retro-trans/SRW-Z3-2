{
  "schema": 1,
  "rows": {
    "147:5557": {
      "repository_source_sha256": "23b4b3f9ef3659e500110dc73415628ef5cb908ed67a1cc1cd526793b3b58ed6",
      "en": "「We're launching a surprise attack!」"
    },
    "147:5578": {
      "repository_source_sha256": "351175e8f1cf5873d390415a08a148bcaeedcc58cee990f818b3a7b1fa11a2fa",
      "en": "「Methods don't matter.\\nThis is war!」"
    },
    "147:5627": {
      "repository_source_sha256": "5d618a09559ec901f8536d818035dc7b9f4bca9fe55454e3595de2f5a8600949",
      "en": "「I still hate the Federation, but...!」"
    },
    "147:5670": {
      "repository_source_sha256": "b618f87f2ae95838c3d8354b513c3de12af9eb706405a9efb34336c89fd40b20",
      "en": "「Then we'll use them instead...!」"
    },
    "147:5709": {
      "repository_source_sha256": "5f30767002201343a1d26ea473e3bd7b6202c97f2715b18d64a81504a1f99fcf",
      "en": "「$$マリーダ$$! Can't you tell it's me!」"
    },
    "147:5746": {
      "repository_source_sha256": "55dc29dc0e1c1a637a2817164e20acaa549687e4289d67e3b68429d203652589",
      "en": "「Get out of the black Gundam, $$マリーダ$$!」"
    },
    "147:5789": {
      "repository_source_sha256": "96229ef746286a6a9101df896857b752c4c927593662d1110601e196acfcdb89",
      "en": "「That pilot...!\\nThe machine's swallowing them whole!」"
    },
    "147:5840": {
      "repository_source_sha256": "450ed92b0c38cb04e33e62739f773724ef07fa6a961dc81cccd62c3f3159b069",
      "en": "「We'll stop the black Gundam!」"
    },
    "147:5875": {
      "repository_source_sha256": "bf054c14a5ec3c1e2cbfb5ac83f2052ef4bb3f2edc9ebc53aaecfd17311242b6",
      "en": "「Why not bet on $$バナージ$$'s\\npotential too!」"
    },
    "147:5926": {
      "repository_source_sha256": "ed980579b135463685f92842815aa18bd2a854fe06640a1df2de4738abc3f897",
      "en": "「Watch out!\\n$$フル・フロンタル$$ is coming!」"
    },
    "147:5975": {
      "repository_source_sha256": "d714140899f0376471f1b0fefc436f558a97dda4118bddee388533abe09dd14a",
      "en": "「That brat who clings to $$フロンタル$$!」"
    },
    "147:6014": {
      "repository_source_sha256": "6d771891bb5f37a574e6547844db16d8f9fdaba820ac3b20d1afe91cda29fe61",
      "en": "「$$アンジェロ$$'s coming! Intercept!」"
    },
    "147:6049": {
      "repository_source_sha256": "06d596a402df61efcd6bc78215c9c6819800116760085a14478fbfa6a829d738",
      "en": "「They were once our comrades!\\nDon't kill them!」"
    },
    "147:6100": {
      "repository_source_sha256": "42069c3cc6c7aac74b772d010d3a0fe054cb53d810b08ceaf5ac75fc7b5f9a3a",
      "en": "「Call for a ceasefire!\\nIf they won't listen, intercept!」"
    },
    "147:6153": {
      "repository_source_sha256": "9ad3ca5bae37f9a3678168f30e11a5ae5e74974723e13c5235f6a8209db63dd3",
      "en": "「Are they still being played\\nby $$フロンタル$$'s words...!」"
    },
    "147:6214": {
      "repository_source_sha256": "48141d59ca2c0229b0f5fbf50ce8321608eae9538e9429cbd128f93e1cca3a65",
      "en": "「We can't let them\\nrun wild on Earth...!」"
    },
    "147:6271": {
      "repository_source_sha256": "2a66c291c2ae226b0b7e25e8bab94d5440e62811e9b51a60ca8fb01d47310278",
      "en": "「The $$サイデリアル$$ are enemies of\\nthe Spacenoids too! Hit them here!」"
    },
    "147:6340": {
      "repository_source_sha256": "6a00e88a9e6cceead3855c6d644b4f5997c14820040fb45482f25f3a7d2650bb",
      "en": "「As if I'd trust anyone who calls\\nthemselves an emissary of God...!」"
    },
    "147:6401": {
      "repository_source_sha256": "ce8762cb999ab139004042f6fca8c281817c3324e1138826aade5e776be83da0",
      "en": "「I don't care who they really are...!\\nThey're our enemies!」"
    },
    "147:6456": {
      "repository_source_sha256": "809f9fffb90572e559ba97a7daa389dcc0f61aef02cf2e9ed72e743f72854fbd",
      "en": "「Now we've got the upper hand!」"
    },
    "147:6487": {
      "repository_source_sha256": "9aeb66706f4a5705498128506c2aff5d6d5d34ba642927511f0ba734fcb8ff1e",
      "en": "「We're not going down quietly!」"
    },
    "147:6514": {
      "repository_source_sha256": "37ceb4f0624546bf07188606719c5cd0c06c4075cf866c457cd9260a839f77d5",
      "en": "「Fire back!\\nWe can't go down here!」"
    },
    "147:6565": {
      "repository_source_sha256": "92328275f0cb519cf36365841ec38db45126312d2019d493925dc70ee4c727ca",
      "en": "「Hit 'em while allies keep them busy!」"
    },
    "147:6606": {
      "repository_source_sha256": "f897bd3214226d76ca2bc403ec520cca3cf8a04f1089bbae5382f92e90a46bf6",
      "en": "「Move to support! Hit the enemy!」"
    },
    "147:6637": {
      "repository_source_sha256": "92de32ac86251d2838f6c3983fd1728f6154c58b850b0accfc7107dfc0ebbce0",
      "en": "「Leave this to us and go, $$バナージ$$!」"
    },
    "147:6674": {
      "repository_source_sha256": "8bb07282733510ae6dab8d45e5e54d9cc7ebd94bbf82030cc6f0ed6492ec188e",
      "en": "「Support the $$ユニコーン$$!」"
    },
    "147:6701": {
      "repository_source_sha256": "ceba067222557beee16dcb4e64a10858c81bdce483c988933df11286fc1465ae",
      "en": "「Colonel! $$ガランシェール$$ will cover you!」"
    },
    "147:6742": {
      "repository_source_sha256": "63afec55a7a6cc8d8c3aa95b3612b8a421f159c9c463442955b8f41f90e35c4b",
      "en": "「Your Excellency! We'll follow too!」"
    },
    "147:7790": {
      "repository_source_sha256": "4d4f1667c7d8a2c0a6d1d0fe03986173fc69dfb6373ce792d163d629a52fe5ce",
      "en": "「This is the end...! Evacuate, hurry!」"
    },
    "147:7373": {
      "repository_source_sha256": "06f7a103fe31119ee6873a33f18a1e50db7d2cef0fc32a42f1eab98eb42ace4d",
      "en": "「$$マリーダ$$! Don't leave me alone!」"
    },
    "147:7410": {
      "repository_source_sha256": "dcd89905e7848937569e7079bed77febade51b682c62ed173b82fe5d9ad087f7",
      "en": "「Come back, $$マリーダ$$!\\nOnce you're back, all is as before!」"
    },
    "147:7473": {
      "repository_source_sha256": "2024ad259c367c1e1f4a80fe71bae7a70d14ac3b901f73b07bc20cb0cf86e5b4",
      "en": "「Damn...!\\nNo wonder, it's the Unicorn's type!」"
    },
    "147:7528": {
      "repository_source_sha256": "4353b3beed87820decd72d61a0ce1b9b7d5142d99f16842df4e70149ddc2f0e1",
      "en": "「Even if I'm shot down,\\nI won't let anyone stop them...!」"
    },
    "147:7581": {
      "repository_source_sha256": "33f2995aba058c224ad71384701571a4d3a6349aaec9c69217796530da701400",
      "en": "「Damn! That new one's off the charts!」"
    },
    "147:7620": {
      "repository_source_sha256": "9be24db8557d053d7370facf497d5fc874292346ea157758021108486aef064b",
      "en": "「Even if we have to ram it,\\nwe'll stop that behemoth!」"
    },
    "147:7675": {
      "repository_source_sha256": "5a9f83902114886f0015a42d4d947080eb79a52b0429a3d09ebf6c8834daeb2f",
      "en": "「More relentless than I expected...!」"
    },
    "147:7714": {
      "repository_source_sha256": "567843f4c00b5d7d66a08037bb55e4581c568fd7da7f56232b6363dc5f54dd21",
      "en": "「Not yet! I'll guard them to the end!」"
    },
    "147:7757": {
      "repository_source_sha256": "249ea1fd3d18da075a073370e476f4be5c8d3495f8f86aa7021fe7f36fed3bc8",
      "en": "「Hold on! We fight to the end!」"
    },
    "147:7277": {
      "repository_source_sha256": "e0fddffbf7b26f6d45c955709abc2c8fa4c21b77ce0a963b2a91e41a2508a26b",
      "en": "「Hold together!\\nWe've still got things to do too!」"
    },
    "147:7332": {
      "repository_source_sha256": "c4d624f5e261a9a85b62468988089e6ac56606163fe421ad8a96fda78de227cb",
      "en": "「Defend the place $$マリーダ$$ returns to!」"
    },
    "147:2411": {
      "repository_source_sha256": "1bc479bf9d421209c9facc7f5b79b725c7a9b125450322684048c3c9f7227995",
      "en": "「Don't underestimate $$ガランシェール$$!」"
    },
    "147:6941": {
      "repository_source_sha256": "6d65c767c08794334df670fe3ea0cdcdd2b4c4efcc6639e8c85b98d85f7de82c",
      "en": "「Foundation bastards retuned her...!」"
    },
    "147:6980": {
      "repository_source_sha256": "e551c1d7565cb73066a12c704377a88da3e3fb1f42f4b640eaa1b9c5b0d61abf",
      "en": "「Get down from that thing, $$マリーダ$$!」"
    },
    "147:7017": {
      "repository_source_sha256": "01c1bcc50551ba69ee89a2080580f6be40a099acd6018cf36540109e3404f3e2",
      "en": "「Watch out for him! Stay alert!」"
    },
    "147:7052": {
      "repository_source_sha256": "886c3665e7c186dc6c1af8b507ac65054474b33e1140a48cad0a586eb492cd5d",
      "en": "「Don't relax!\\n$$フロンタル$$ has more than this!」"
    },
    "147:7107": {
      "repository_source_sha256": "b7745e2626e75e9d8864618fcf772a258a475c1649c64610455e4e7ed7f52dde",
      "en": "「Testing us, are you, $$フル・フロンタル$$...」"
    },
    "147:7148": {
      "repository_source_sha256": "8f20dbea893f652054b17146e956530025cb02b869102395c4a8d35600fe866b",
      "en": "「He never gives up...!\\nThe next attack's coming right away!」"
    },
    "147:7248": {
      "repository_source_sha256": "72fd6ce8421ec0a29117600baa910686cfee7767fb0b8352955f23843aa6bde0",
      "en": "「The ship isn't damaged, is it!」"
    },
    "147:7197": {
      "repository_source_sha256": "7213de18ecbc71398c037baf1afcc08125c511538d085377ed1264702dfa1046",
      "en": "「Who knows how long\\nthe barrier will hold...!」"
    },
    "147:7825": {
      "repository_source_sha256": "731b3e88f4cd997fce2b369f02a5bd65a323a328707891abe733ff7e5873b64d",
      "en": "「Come with me! Don't leave me alone!!」"
    },
    "147:7864": {
      "repository_source_sha256": "80b6a60df8e70c488cbae2ae00c720886f375acc8b83399ba578794c96eeb628",
      "en": "「...I forgive you. My last order...」"
    },
    "147:7891": {
      "repository_source_sha256": "0d14c63772febda413614ca9fb3568daf636a2c87c3b435720d2f21b29d1cc0a",
      "en": "「Follow your heart.」"
    },
    "147:7904": {
      "repository_source_sha256": "2b0c345d6d5602ff0f3c7eceea59400029e71d8eb8b9e6cadcfcb804a9b7b180",
      "en": "「You came to say that at the very end...」"
    },
    "147:7963": {
      "repository_source_sha256": "8edacf06433ce05d8e8f789921f4ff9261de837f422156a5d9bbbf3419764f05",
      "en": "「Phew...」"
    },
    "147:7974": {
      "repository_source_sha256": "5ac498a169a77fea175adc91a01ed85eb06fb138f7c9a73ebbc4a9637d1f6cd5",
      "en": "「Maybe he's tired of endless fighting...」"
    },
    "147:8035": {
      "repository_source_sha256": "0f9d7d71c02696ef7bde12a4851e7a4a4976e1d5e61dd2a97a96cbb9e4e3a7df",
      "en": "「No... You're not up to it.」"
    },
    "147:8060": {
      "repository_source_sha256": "ead613df86bed8d09e9a94b9e2a07225418398d64f90ee2c966697d82714b7c0",
      "en": "「It's about Super Robot Wars. Hard work's useless if the player doesn't resume.」"
    },
    "147:8173": {
      "repository_source_sha256": "3f36dc7f815165312b2d98af1c8b77c9624f98508515056d4ace23534b380b43",
      "en": "「So, players: don't waste $$バナージ$$'s drive. Come back soon!」"
    },
    "147:6771": {
      "repository_source_sha256": "6ff2709c8d67fc3cdbe06e02879115070f77f1f23ac639329a7f611179cf2e3e",
      "en": "「Now it's our turn to protect you!」"
    },
    "147:6810": {
      "repository_source_sha256": "5e44b5ed17b7dd833109d0e0f75cc7db55cfeb3e2d498e5f8556c7948dfca534",
      "en": "「You won't get the Box's key!」"
    },
    "147:6837": {
      "repository_source_sha256": "ff7e0b3d0a8ce0a589b02d4bea3ffe4a95e6294d9b213cfc81b4230070423c91",
      "en": "「You're not at 100%! Don't push it!」"
    },
    "147:6878": {
      "repository_source_sha256": "a46dee82154f6e1db60d761c6c4afab85d7206e5a2e5c6228a079bb8887dad1c",
      "en": "「$$マリーダ$$!!」"
    },
    "147:6895": {
      "repository_source_sha256": "04508e5028d102b94a60bdb12afc7295b0d16b3815a6342aa45b7d53228cf267",
      "en": "「Don't let the Colonel get hit!」"
    },
    "147:6918": {
      "repository_source_sha256": "a31602675f9756bbb6048507a06ad26e7ba0398f0c914142367aeec70597e903",
      "en": "「We'll shield His Excellency!」"
    }
  },

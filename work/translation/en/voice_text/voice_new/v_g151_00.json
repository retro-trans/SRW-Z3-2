{
  "schema": 1,
  "rows": {
    "151:0": {
      "repository_source_sha256": "0d7ecf5c83f7d7a33e496f8aa1a2aa86c3261551bef7e42dc9e304b1dfad143a",
      "en": "「You're standing in a nice spot...」"
    },
    "151:29": {
      "repository_source_sha256": "e1cbded96e965134e24d8da5dce5662e31c128c93663eb702c58b0b0c954e71d",
      "en": "「Are you my opponent, then?」"
    },
    "151:70": {
      "repository_source_sha256": "65799604f8eb77c08d9498e322710f6ceca8c6971a669d6eea79a3b8ba181655",
      "en": "「Good kid... Don't run away.」"
    },
    "151:97": {
      "repository_source_sha256": "49c1d429b4b686a5a7058dc6b979df1ad774bb73dc24e1d338fb87b420afbbfb",
      "en": "「You're perfect as a plaything.」"
    },
    "151:126": {
      "repository_source_sha256": "64c77c03d04c921a0f4655178df912ae09ab6f9efd50267fdbc8a0f26a9dbea2",
      "en": "「Show me some backbone, would you.」"
    },
    "151:163": {
      "repository_source_sha256": "816cc61076ae3932f411b2ca69a8ffa939ad0b8cf2233d4ba0bfae79e9ab55ed",
      "en": "「If you don't resist,\\nI'll look like the villain.」"
    },
    "151:214": {
      "repository_source_sha256": "e4b180d90df53f049ca814f111becda9a6ff96f0aa5b14e93e4aaa3e80adac6c",
      "en": "「A familiar opponent is fun too.」"
    },
    "151:249": {
      "repository_source_sha256": "1189f66dbc1fe47c0b473265ea839136bda69f7343b3964fc56b183c7fea3b88",
      "en": "「Let's go all out, both of us.」"
    },
    "151:288": {
      "repository_source_sha256": "10d0b0b67b3a252207ce2f41a0bda0ed991770c0c0ef185b6bc0e849776daa2b",
      "en": "「A borrowed machine, but not bad.」"
    },
    "151:321": {
      "repository_source_sha256": "b796d16719fbdca8b799c600a7a218891510522baf0abc5e567461db832aa777",
      "en": "「Let's begin the private lesson.」"
    },
    "151:364": {
      "repository_source_sha256": "1cf041823358b15e9e23c865e42acb702e24b09735542bd0161f3f9f7e51aa9a",
      "en": "「Your beloved Miss $$スズネ$$\\nwill be taking you on.」"
    },
    "151:417": {
      "repository_source_sha256": "dea269182328485dd9b685e55e7980775d7e300491e02a2735b939291246e232",
      "en": "「Too bad. I'm not the sweet, sweet\\nMiss $$スズネ$$.」"
    },
    "151:480": {
      "repository_source_sha256": "544c797f4b63b54ad3ae08bb83015a416cc4987b39f16aa28ff1a23b673adc8e",
      "en": "「As I thought, it feels better\\nwithout the glasses.」"
    },
    "151:529": {
      "repository_source_sha256": "38b72c4ad3a4a7e4bf8b2ace487045d3b64e9a0b59cc2f9b0e063ad01a4f1047",
      "en": "「I'll do as I please.」"
    },
    "151:556": {
      "repository_source_sha256": "5e45311b44ca918b6ab31bbfe12b346713a1d4e3b2f50709548442b7a886bb27",
      "en": "「It feels good, moving my body\\nby my own will.」"
    },
    "151:607": {
      "repository_source_sha256": "23478731e67d5205a5b3935352bed0a9268852763bdcf96fc300359650a227bd",
      "en": "「I know how you fight inside out.」"
    },
    "151:726": {
      "repository_source_sha256": "15d51df7ea5e3c75a646d496cb1f43f6b878d71731bd4002f718f623b789b91e",
      "en": "「I'll crush this brat's cockiness.」"
    },
    "151:769": {
      "repository_source_sha256": "cbe4fa80a2e63679fd2398548cde24b4cf47012f498a59a6582aa60247ea496a",
      "en": "「I can't stand them. The ones who\\nclearly live out in the sun.」"
    },
    "151:826": {
      "repository_source_sha256": "8e23c8d2d33a90eb635dc0a76a2f99833496676ebbe57c4fa82e216682732388",
      "en": "「Wreck your prized $$トライダー$$ and\\nthe company goes under, $$ワッ太$$.」"
    },
    "151:891": {
      "repository_source_sha256": "c2c5fcc17adff34536f420d04f58e3ee4b973f86272ca695b407daef211a3b97",
      "en": "「Justice doesn't always win,\\n$$正太郎$$.」"
    },
    "151:940": {
      "repository_source_sha256": "ec7db715f67c159502575e9b5b5d1bcde1e7cde4af8da27c700e712272338425",
      "en": "「Off to join your beloved brother.」"
    },
    "151:981": {
      "repository_source_sha256": "ddff4dcece05c26cf5a7230cc5dd93289032897841baa434663543288473f7aa",
      "en": "「Aren't you getting cocky,\\nthinking you can't die?」"
    },
    "151:1038": {
      "repository_source_sha256": "35770f99c362ac3692cce878b964bb24463d7211d4d06b3d667ae56162c48a92",
      "en": "「My opponent's a Gundam... Fun.」"
    },
    "151:1075": {
      "repository_source_sha256": "c14aaeb8be7c4d60479832c1dd00131f76822072115dac07050c711a5b51b46b",
      "en": "「Downing a Gundam adds some prestige.」"
    },
    "151:1118": {
      "repository_source_sha256": "3fe4227b8441b9db306cee445b94038e2824f8f3d2e7bf6818925e486b27b291",
      "en": "「I'll call myself a Gundam Killer.」"
    },
    "151:1159": {
      "repository_source_sha256": "a8933ca3fbe14419b1a34be139522ee3f24742091d16cf596a62342af4d86e53",
      "en": "「Rough life, being a $$ニュータイプ$$.」"
    },
    "151:1200": {
      "repository_source_sha256": "3613c5a478eecda8ffb028bd953348d5dce2b26782c953ae03fe92ead9e37638",
      "en": "「Don't you get lonely, $$イノベイター$$?」"
    },
    "151:1235": {
      "repository_source_sha256": "10048481e5c1d409ef7dc4da80983766e04a38e8a0a74920c85c74560511ece0",
      "en": "「$$コーディネイター$$...\\nSo you're a born soldier.」"
    },
    "151:1292": {
      "repository_source_sha256": "c9b63e123cbf7976c1c266c4fee0ec1f4465267f0aceac35a845dbcf502d0ee2",
      "en": "「Go see a future of despair with\\nyour proud $$ゼロシステム$$.」"
    },
    "151:1343": {
      "repository_source_sha256": "e1a64f8c449ce55991107afcae35544aab99fcf3ff73402b57a8d5b7e1d9b0ac",
      "en": "「Coming at a maiden,\\n$$ユニコーン$$?」"
    },
    "151:1394": {
      "repository_source_sha256": "0bafc04befe9b4e9ba1f8025c2f52285bd446863beb555d767b0835630e66af0",
      "en": "「I'll shave off that scruffy beard.」"
    },
    "151:1427": {
      "repository_source_sha256": "f663edfca7b0dd2fc215d6074ad57f93fa7cc46d557cfd876afff777131a0b3c",
      "en": "「Let's see what you've got, $$チームＤ$$.」"
    },
    "151:1470": {
      "repository_source_sha256": "ae613720b5fbccc1c4e82fec02352a0c6e1d628bda0fabbae077b548b85648d7",
      "en": "「Let's see what the ladies' man from\\nacross space-time can do.」"
    },
    "151:1519": {
      "repository_source_sha256": "2efe17d5183f14eb2379882080927e0d7508ceee8f6815b324630fff215a2b3d",
      "en": "「Heh... I don't dislike your song...」"
    },
    "151:1562": {
      "repository_source_sha256": "af0b72fb37622e4eba51645443185eea11aaa5dfa9518f5ecc2bdf457d08d65d",
      "en": "「Pluck the wings, the Valkyrie falls.」"
    },
    "151:1599": {
      "repository_source_sha256": "a59127805f8eeb34da6c1f499b536932c53e0037b09d93ef370a8d04650ac19a",
      "en": "「I doubt you can handle women,\\n$$アルト$$.」"
    },
    "151:1652": {
      "repository_source_sha256": "397766450466f4477ad0683bf28fb4d56408d0891f86f7a0590ba367d197564a",
      "en": "「Atami's shadow boss is a hero?\\nYou crack me up, $$甲児$$.」"
    },
    "151:1713": {
      "repository_source_sha256": "8d9a830beef3bf5c99e58c08091f089eece1b12f2b333683f3ecdb07db098b31",
      "en": "「You're better suited to wiping\\nschool windows.」"
    },
    "151:1764": {
      "repository_source_sha256": "7d11cf77d071a63f03a5833d85913ca40d0e4f446cd4a345f1a48ca20836ff8c",
      "en": "「You're all fired up,\\nJapanese salaryman.」"
    },
    "151:1817": {
      "repository_source_sha256": "029514cba7256d4d02f034de8fe04ed5b65ac14447068d78ec67323326a5a933",
      "en": "「Smooth-talking men can't be trusted.」"
    },
    "151:1860": {
      "repository_source_sha256": "ee66d045c263601661462740526246d74f09bdfc226de04425049a5b148dd7ba",
      "en": "「With the tactics you hate so much,\\nI'll flip your strategy over.」"
    },
    "151:1923": {
      "repository_source_sha256": "1e237f6d6b720d22d16d194a9cbeddbb7a5bc9cff2b14805534a762ca7793ab1",
      "en": "「Your moves are crude, $$カレン$$.」"
    },
    "151:1956": {
      "repository_source_sha256": "175da276a4247f55d4f1460448510c21a79c53fa1b68876e3aba37d14f2ed39d",
      "en": "「A warmonger on justice's side, huh.」"
    },
    "151:1985": {
      "repository_source_sha256": "093c159699940043703bb287a1d65bb4186720955ce47db4acec984d678a273f",
      "en": "「Study war, sense and women, $$宗介$$.」"
    },
    "151:2026": {
      "repository_source_sha256": "b81fdb737bbc0040bd176c8423f55e8acc0928d34215ea597753aa2781d735c0",
      "en": "「...No. My heart can't resist him...」"
    },
    "151:2069": {
      "repository_source_sha256": "34d5d2db72cb653cec9a33d314af8efd95ae6e8ef109ac24933dd3eb861d92fc",
      "en": "「You're 12,000 years too early to\\ndate, the lot of you.」"
    },
    "151:2126": {
      "repository_source_sha256": "82e5cdd6d1fed2f78412375828c975ca1b78aee0453825ab966a378535c563dc",
      "en": "「The legendary Mechanical Angel, hm?」"
    },
    "151:2159": {
      "repository_source_sha256": "85877eba626e3cfba4c14e62f24cd6139f93c7468e5f13374b45a3e89d346c19",
      "en": "「That fire of yours is stifling.」"
    },
    "151:2192": {
      "repository_source_sha256": "cf6bcdcd416d3946f68b30d83cd675008e414bff299f2c66cd0a5112d4ec58b9",
      "en": "「Understand that you can't stay\\na child forever.」"
    },
    "151:2241": {
      "repository_source_sha256": "09a16c569fce21e75d7c558ead039491da6decb0fba78fefbd5288b0f2c3de55",
      "en": "「A clumsy android girl\\nisn't wanted here.」"
    },
    "151:2290": {
      "repository_source_sha256": "c1dbf21e272c89aa4beca51c499575d5633b1b5222036e1969e5b5a8460cdab0",
      "en": "「Even your drill can't pierce\\nmy freedom.」"
    },
    "151:2349": {
      "repository_source_sha256": "c98522680cbb195284ab13926d40303068834d13aed497800843c688e0325163",
      "en": "「Rest easy now, $$シンジ$$.」"
    },
    "151:2378": {
      "repository_source_sha256": "a6a4a4f948444fc2913e7507dd378e732ee25c09307b8189aa0c77c0c335a928",
      "en": "「You're not $$レイ#pt394$$.」"
    },
    "151:2403": {
      "repository_source_sha256": "ca1caa756f324cc383bb3db43722d90f423baec5809a7007b5e772cfc737a9db",
      "en": "「You've been through a lot, $$アスカ$$.」"
    },
    "151:2440": {
      "repository_source_sha256": "754002c8dd97bd18aa8c4bad2e1055a1d593f09ed610012a6cf68c8005302480",
      "en": "「You belong back with the fleet,\\ncatching fish.」"
    },
    "151:2499": {
      "repository_source_sha256": "06e8e31496c25b43aa7e0b64c93569008c2c782ae21a32d52bd35a7e80462d8e",
      "en": "「If the real Reactor loses to a\\nnovice, that's a laughingstock.」"
    },
    "151:2554": {
      "repository_source_sha256": "7b48aeee1fca1d4c7a5e9417d1f47d175c6c640d2a58e99a558441ebef85889f",
      "en": "「Let's see how it's done,\\nusing a $$スフィア$$.」"
    },
    "151:2613": {
      "repository_source_sha256": "27c932ae0e428b39e58181eabed07ad633f9a43018e8e14e2785078530ffeb39",
      "en": "「When I take you down,\\n$$バルビエル$$'s face will be a sight.」"
    },
    "151:2664": {
      "repository_source_sha256": "28b5da0e54fa16c38979c6d7128212ddbbd7fa9451a2aad60a655540b4658600",
      "en": "「Sorry, $$エルーナルーナ$$.\\nI'm taking this one.」"
    },
    "151:2715": {
      "repository_source_sha256": "710f3feee2b051dc4c2629932092f827bdecf7b80cdf0d5bf65f7a7c486130a9",
      "en": "「Being liked by $$尸空#pilot$$,\\nyou're out of luck.」"
    },
    "151:2768": {
      "repository_source_sha256": "a837390aea8fe745a8e163dde779f1c8bd861f8d013b6e26adf9211ebd544cb3",
      "en": "「Hand over $$ジェニオン$$\\nand the $$スフィア$$.」"
    },
    "151:2817": {
      "repository_source_sha256": "a4ec9498e7b7a0eddf385fcb5dcc42b67ea1b6f8d79a1e541a6ec8638431037c",
      "en": "「That seat is rightfully mine.」"
    },
    "151:2860": {
      "repository_source_sha256": "3f218a1ff9d205edb1f8b6436ec7feab2c5314f9bb1f4a9c74556af2900d8d49",
      "en": "「Too bad. I'm not your beloved\\nMiss $$スズネ$$.」"
    },
    "151:2917": {
      "repository_source_sha256": "a060872fabebd0e691631c8edc7181f468fbea70558f5c8049bf9fe07e162580",
      "en": "「I'll send you after your family.\\nThat's my parting offering.」"
    },
    "151:2972": {
      "repository_source_sha256": "63eb95bdee064533e77d259b07fcd68cff0bd05929d95626e300784f88130cc2",
      "en": "「Sorry, $$スズネ$$.\\nI'll crush your precious student.」"
    },
    "151:3027": {
      "repository_source_sha256": "db45baa0bcdb53d7459dfc2a73c9da1e1a3bc321b05c32e75150b1cf70c2658f",
      "en": "「$$ジェミニオン・レイ$$...\\nI'll make it mine.」"
    },
    "151:3078": {
      "repository_source_sha256": "ab59836cf1234faab432ffeecc8669fd3ac23eba84f6ec2a105b77261b1cb45c",
      "en": "「Let's end the Volunteer Club today.」"
    },
    "151:3121": {
      "repository_source_sha256": "a9f374885e1a48a14ef2f6b5de7257dfb65ff813f54722139c3201116e8c7424",
      "en": "「Put school ahead of playing hero.」"
    },
    "151:3164": {
      "repository_source_sha256": "c239f11dcfacb5fb76317094be0f02fba8fb4c03c9842d30b95fb737dc7dc501",
      "en": "「Battle isn't like picking up trash.」"
    },
    "151:3203": {
      "repository_source_sha256": "afbf70d7fd452f21540345b4ae804af6ad0819b9b160e939c6d543c4b8753351",
      "en": "「Too bad I'm no longer the woman\\nyou lot like.」"
    },
    "151:3254": {
      "repository_source_sha256": "425d069561bc77f9d0c344bc35ef6c61435f7a90ece3a1a6f318cd152f97133f",
      "en": "「Sorry to shatter you boys' dreams.」"
    },
    "151:4188": {
      "repository_source_sha256": "21f2243b5d94390c9a65ab1a1dce96c7c316cf82cead7cd14d3a479afde65976",
      "en": "「Did you think you could escape?」"
    },
    "151:4217": {
      "repository_source_sha256": "4770e6893d833a7c5e8eb8ea85eaa06f5bbff0256aa212bb39fb6cd84876305d",
      "en": "「Heh... you're slow to disengage.」"
    },
    "151:4244": {
      "repository_source_sha256": "b10dfbc02e046dce329b1b7a4e4704e081198fed0ac89f917e0472229058cf35",
      "en": "「Looks like you want some punishment.」"
    },
    "151:4285": {
      "repository_source_sha256": "5ff1a487af64af58eaaa2954b8a56fb57d5ce9be8484a9b1cdb1fa493d25963d",
      "en": "「Stand still and get countered.」"
    },
    "151:4326": {
      "repository_source_sha256": "07d80aa54097399ee7046b749cbc15ebe9e161e8df731bd431eee396c2ebb22f",
      "en": "「$$スズネ$$ and I are polite women.」"
    },
    "151:4363": {
      "repository_source_sha256": "15a8b8882ec520f6c70546d9a3bd3ef6cb50fd98d4384162720cb5b612a08c4d",
      "en": "「Time for some payback.」"
    },
    "151:4394": {
      "repository_source_sha256": "5f6ba4d9a9c994e5854193038ffc2cb476fc5e19651bb6707dc4cf855722108c",
      "en": "「Double or triple payback. Choose.」"
    },
    "151:4437": {
      "repository_source_sha256": "5cd6291d286864f5c03efe528cb5e8604010c5749537f80c3797c8a34313d263",
      "en": "「You're as reckless as ever.」"
    },
    "151:4468": {
      "repository_source_sha256": "aacdd0dc61ba65db443262d69997fed22c75f013f8a0ded1cb0fccd36ab99582",
      "en": "「Did you think you'd be forgiven?」"
    }
  },

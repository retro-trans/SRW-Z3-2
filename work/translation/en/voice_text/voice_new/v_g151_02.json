      "en": "「My head's... pounding...」"
    },
    "151:6153": {
      "repository_source_sha256": "eaff4f7e3fe7b8c1cd3e0e2223ea547e57029f81fc41b7f2bce0c7974fd5ca21",
      "en": "「Damn... I can't think straight...」"
    },
    "151:5287": {
      "repository_source_sha256": "0ff9bf9afecb9bce7a16158b1524e3e92e11c6ccf2cf645ef00ec9b97bf19c1a",
      "en": "「Oh? That one hit...」"
    },
    "151:5310": {
      "repository_source_sha256": "949ff1c8ae7fd833d210f0e30b91e3d917b3f8fedbc524310e4f6c36d553f091",
      "en": "「Well, these things happen.」"
    },
    "151:5339": {
      "repository_source_sha256": "d7c511e35fda9a0da04141e9462dd83869561adfd1e14879c4c411d36f4be181",
      "en": "「All you did was land a hit.」"
    },
    "151:5364": {
      "repository_source_sha256": "27bff079b0243b377266a339e925ec2d4a21d67c0162bd638d499cad7a312025",
      "en": "「Don't hold back. Really come at me.」"
    },
    "151:5399": {
      "repository_source_sha256": "569f2d09883fa18efe8ba819dde8b36314e0806e49d76a453cff12bebede62a6",
      "en": "「You're totally gun-shy, huh.」"
    },
    "151:5432": {
      "repository_source_sha256": "903643172d5845f6cb38ffcf0c11f8f71fc4d07e69de5efa6dcf2d11c2303058",
      "en": "「Geminia's armor is decent too.」"
    },
    "151:5471": {
      "repository_source_sha256": "3f806d4157371c6ac20111f70cdebed31b91e8691a4531d57f8c189e8ab2bdd7",
      "en": "「Having taken one, it's nothing much.」"
    },
    "151:5512": {
      "repository_source_sha256": "9ac60878c0d5ac1cfb6274c0d9d48e1070b314b0b5c9e964e4b9716f9de0abe1",
      "en": "「I knew you'd avoid the vitals.」"
    },
    "151:5555": {
      "repository_source_sha256": "6bfd7b2abcb249325b2e7b3929b1821636e04c4132bc0d23038b860cc66610ef",
      "en": "「You thought that would stop me?」"
    },
    "151:5596": {
      "repository_source_sha256": "a81a478e28d914a201a22b5b4542d7400652295db36d3a5db70429caaa5fe070",
      "en": "「Yeah, yeah, nice job.\\n...Satisfied now?」"
    },
    "151:5649": {
      "repository_source_sha256": "59a17104a6e1e0cd245127b778bf55b8711fa9c8449c1ae000666a5b4fcbbe95",
      "en": "「You're soft, $$ヒビキ$$.」"
    },
    "151:5674": {
      "repository_source_sha256": "64ac8510fa8996cfdb8d7e414ad803b184e31f38ff9507279cd2e2406b1ed99d",
      "en": "「Hate the thought of hurting\\nyour dear $$スズネ$$ that much?」"
    },
    "151:5723": {
      "repository_source_sha256": "a396259c240452566add2affa6e288083ddfaa60ec8ed64ef083d3c84323f13f",
      "en": "「How kind they are, the members\\nof the Volunteer Club.」"
    },
    "151:5009": {
      "repository_source_sha256": "856adfe753aee0ad0644eb3a7c66315f0d0b56629aa9f305ba34fc2ec447094c",
      "en": "「I know your habits.」"
    },
    "151:5040": {
      "repository_source_sha256": "852ec6496dbfadcdde7b36a25fee6c198ed388c4efdc8cdd98c5e05c0b8a9cd5",
      "en": "「You really are kind, aren't you.」"
    },
    "151:5067": {
      "repository_source_sha256": "74975ae78c16b9a8c9048be1ca0a2b753b23b7d2fb3a3bbb1287bcaa14ffe749",
      "en": "「Are you making light of me?」"
    },
    "151:5094": {
      "repository_source_sha256": "316cb44d0bdcb339788dfba120a715bcf6f8697ef8d69bad0236a09772e2a1c6",
      "en": "「Heh...\\n$$スズネ$$ was well loved, it seems.」"
    },
    "151:5143": {
      "repository_source_sha256": "c23b7afa26154adce33155d8a15e37ae9ea89d11f5098ca517f832c03f83bf96",
      "en": "「Too slow. Your moves and your mind.」"
    },
    "151:5172": {
      "repository_source_sha256": "f0f28d7627aa6a47b80b0809d49e2b2407e522c950b1fe2c3c45926fe9e2850e",
      "en": "「Easy, even without psychic control.」"
    },
    "151:5211": {
      "repository_source_sha256": "04ccf43c4bc0baeb896e5e342e09e905f44c77ee5a8650b5eb3536a6858c37f9",
      "en": "「That kind of thing won't work.」"
    },
    "151:5244": {
      "repository_source_sha256": "093ce2a646e510b4a1b2a208b1a27800bff6a824ce0678135cd06d8b062eb56f",
      "en": "「Knowing it's futile, you still try?」"
    },
    "151:8987": {
      "repository_source_sha256": "15a85781b81cc496aeb07113e03591b7c437a32e7b4245e7355429b2e134d3d8",
      "en": "「What... done already? How pathetic.」"
    },
    "151:9026": {
      "repository_source_sha256": "d38323d438f59d723d51f26036cfbb0698de7e39a1149047836f523830db9233",
      "en": "「Show drive enough for a no-reset, non-stop clear.」"
    },
    "151:9131": {
      "repository_source_sha256": "dfbc2f167da46d0a6dfbc6a424fbb5f43f2187312b110961af99d9d37a1352c6",
      "en": "「Heh... I expect a lot. Hurry back.」"
    },
    "151:9188": {
      "repository_source_sha256": "1020351d3c0f2c4f180a7e08660acb9e83973602737ec2a684e982529a887070",
      "en": "「Then I'll gladly play with y-o-u.」"
    },
    "151:9223": {
      "repository_source_sha256": "852127d4520ee503994b78730d07f8e4b7dff34acd362c6d8e0a22bebfa3448a",
      "en": "「Good work, Player.」"
    },
    "151:9256": {
      "repository_source_sha256": "73eb6fe8ba5198f9bacf1caa02d920fff507ccc32ea717a02324284f36264553",
      "en": "「Pausing? Perfect. Let the player pick, me or you.」"
    },
    "151:9339": {
      "repository_source_sha256": "6e0870770e765931a8720a25510388c5611917047a2e5bcc06c652d101ab73bf",
      "en": "「Pick me for service no stiff teacher offers.」"
    },
    "151:9414": {
      "repository_source_sha256": "4ef1319d4a7cf4efb02da0fc3599183ad6a5c07a7a55e317d533c902c5e0cb40",
      "en": "「Hey, no fair!」"
    },
    "151:9431": {
      "repository_source_sha256": "6a752639d5d46c067b086995e096561f795129db510eaf3f5d43ba4750fc21b4",
      "en": "「Then think up your own service.」"
    },
    "151:9486": {
      "repository_source_sha256": "d02c97b26b5885b02fd65640310b256fe66bed15e9098b8887936be7fe3a98ff",
      "en": "「U-uuh...」"
    },
    "151:9501": {
      "repository_source_sha256": "8d713c0c731ed1d4a0a6cce92fa73a1c0eb8c922361869e0ebf2ebff7405047a",
      "en": "「Decide who you pick before resuming.」"
    },
    "151:9576": {
      "repository_source_sha256": "841ba5c7ed7a327a4b99018766bf10cdcb21f45b34606f70980144d21e747280",
      "en": "「I believe in you, Player!」"
    },
    "151:4641": {
      "repository_source_sha256": "b24ee2ee10c8138afb6362dae2934f1c5b842e9d3115beba9ab96165a1a713f6",
      "en": "「You owe me one.」"
    },
    "151:4666": {
      "repository_source_sha256": "4e78a3d980ddf65d5dcbc2fc2465edc0b9c7d5d1c8bb8986ccc79e8347a3ce28",
      "en": "「It's so-called volunteer spirit.」"
    },
    "151:4823": {
      "repository_source_sha256": "e4888807f0dbb13d38239a3449f0d61e64eb943612cc265e0631a8b0245faae6",
      "en": "「Well, well...\\nThat's an interesting trick.」"
    },
    "151:4872": {
      "repository_source_sha256": "b7338867e03cff99b8693c87ef60235dcd129a7c5d1a5492014c1a411478fa0b",
      "en": "「Not bad.\\nYou saw through my range.」"
    },
    "151:4923": {
      "repository_source_sha256": "330aa2cd27e4c8de93e3a8ce4f9c073766014a1611f04906c381db98ea6674d8",
      "en": "「I knew.\\nThis kind of trick is your forte.」"
    },
    "151:4974": {
      "repository_source_sha256": "578d62260ab664f6eb80128e57204747423a3b31cda3b2a4ce477bbd7afef670",
      "en": "「Can't counter, so I'll let it go.」"
    },
    "151:3285": {
      "repository_source_sha256": "8ab602a750ce73b19283499b429b947afe85ca2e456d616cb43c338ed7a21a6f",
      "en": "「Light particles... converging.」"
    },
    "151:3304": {
      "repository_source_sha256": "93166cd5249bde4ba30c65b5a46a785539df49c3f6fa17fbf7a653e1eb0e19dc",
      "en": "「Come on! Running's pointless!」"
    },
    "151:3337": {
      "repository_source_sha256": "357609597d7ced095e77fab35155e8dfc08710374f03cb9283ad96fac73d31ef",
      "en": "「I'll take you on with this.」"
    },
    "151:3366": {
      "repository_source_sha256": "529ce02c0be21f5259ba8f4adbec51cccd173af3bc5091e1fe535ee42a17b184",
      "en": "「Go, Light Particle Blast!」"
    },
    "151:3395": {
      "repository_source_sha256": "532e60ef522bec9d101a817120a449f6d8844fac5ed64dfa77a6a7f67a6d48c6",
      "en": "「Its power lives up to the flash.」"
    },
    "151:3422": {
      "repository_source_sha256": "2fc8c34f2dda4f72e67f2b390de1c90525a09109c17fb3229c1b73d3f9e9c779",
      "en": "「This is Light Particle Blast!」"
    },
    "151:3451": {
      "repository_source_sha256": "c8f94232273779568c211803420a7c2a8bb5e42fcc6f4de4158fe6a3313fef66",
      "en": "「Artificial $$スフィア$$, yet ample output.」"
    },
    "151:3484": {
      "repository_source_sha256": "d021eeaf9aad6e2b3e213d78d0dbe3f41cf49d2ac4d1487ce3697bb9d2dbcf5f",
      "en": "「Vanish into the light!」"
    },
    "151:3505": {
      "repository_source_sha256": "3a4449994d45ad117830a5e6cd961d18afa9710d6e788308b1fa126a9af7a538",
      "en": "「Light Breaker Sword, huh... Not bad.」"
    },
    "151:3538": {
      "repository_source_sha256": "6f040c0da5af17db2013634b36e76cd5794e80d2a275a4e2c75539462d60a3b3",
      "en": "「Let's make it one clean cut!」"
    },
    "151:3563": {
      "repository_source_sha256": "630084292aa7d1f0ca873122f6c784e0866d33a9052cedbcf11195463f9c6b6b",
      "en": "「This blade cuts even dimensions.」"
    },
    "151:3598": {
      "repository_source_sha256": "9ec530eb807941b05387c85e1b2fce02ac5f54ac1a437e6a7b7596f592a23b70",
      "en": "「Let's do this, Formenia!」"
    },
    "151:3625": {
      "repository_source_sha256": "18136de72166a548fd1ad0f44b7930f804b6f7226b277594933dc925faf33690",
      "en": "「Let's cut even the ties between us!」"
    },
    "151:3664": {
      "repository_source_sha256": "2e6eace19293bfd9ffd1a37079a5b2e74850b8a5e321e598150b805df7f92145",
      "en": "「Causality and bonds, cut in two!」"
    },
    "151:3693": {
      "repository_source_sha256": "3db7645da5dae1f7ad5dbadf0d0b44218e68d343320b9f8be38c4206f66c675d",
      "en": "「Light Breaker Sword Formenia...」"
    },
    "151:3718": {
      "repository_source_sha256": "29ff6da47208bbb88d78f5ee0f5dc3be503aba2bb9f6680e2389ae3a24f419e6",
      "en": "「Causality, severed! Vanish!」"
    },
    "151:3743": {
      "repository_source_sha256": "7f9a2434a608532ac0006ec82b3067d4d0676ba980f696d85449d21c88273d35",
      "en": "「With the artificial $$スフィア$$,\\nhow far can I go...」"
    },
    "151:3792": {
      "repository_source_sha256": "c6137d1b9c3a0c36ac816e957daf761e627bbda4a8fcbebe128c67aa67231aa8",
      "en": "「Let's do this, Geminia!」"
    },
    "151:3819": {
      "repository_source_sha256": "16d250af8fac4d9ea6cb34ae18aa6d66ae0b9a77eea822cf46267bf1071fde0e",
      "en": "「Hahahaha! Hahahahahaha!」"
    },
    "151:3854": {
      "repository_source_sha256": "f823ee65d9ce26a8df901d77865dea1b27d3d6857ed038674ae705df5bee0787",
      "en": "「This is the end!」"
    },
    "151:3877": {
      "repository_source_sha256": "c8b5258cf9d9d135cad8344965dcdd8d8718962331c43c5daaba649dcb10656c",
      "en": "「I live as I please.」"
    },
    "151:3910": {
      "repository_source_sha256": "b81d0716334dd5bcfa03548b444582f7008fd33504a593f4d6d942564ca8e15c",
      "en": "「I'll have everything I want!」"
    },
    "151:3945": {
      "repository_source_sha256": "48f3e8e15dc8a265d3ffedd48c720725a453a0cf3013ff36ea783408df57d145",
      "en": "「I won't let anyone get in the way!」"
    },
    "151:3972": {
      "repository_source_sha256": "c6269aa83a521bf0e41080db8c3ea329b52b52b8d57f1426bf011cfde022d406",
      "en": "「No matter who it is!」"
    },
    "151:3997": {
      "repository_source_sha256": "1e5ffca5e725d922297d722e9959831a4afd5e9575f2ff2e5ca9f540cbd0cd0e",
      "en": "「Light Particle Full Burst」"
    },
    "151:4022": {
      "repository_source_sha256": "8bc0b5aaeb1a49b83c0a737480bdb5e3f3081238643b99e74fab74721c6d511e",
      "en": "「I'll show you this thing's power!」"
    },
    "151:4055": {
      "repository_source_sha256": "508d72b6765b1562c17ee96a4c5232a2fe2aa781e0bab3c15b3f7132bf1e72e6",
      "en": "「Trying to run is pointless!」"
    },
    "151:4084": {
      "repository_source_sha256": "0d4cecbb8ebd13e45560364457857dc80ea92e55369610c542c68405f9d63b78",
      "en": "「I don't stop!」"
    },
    "151:4109": {
      "repository_source_sha256": "9a17086e00750f24367a7e54402f61a6d74af6422c7ab64580c35c104dcd7525",
      "en": "「It's over, $$ヒビキ$$!」"
    },
    "151:4134": {
      "repository_source_sha256": "63aa2d42f5fcf1d0b063bcfe928e5ff4c4eb7317d4a859ebd3f7d972c4b455ab",
      "en": "「This is tough love!」"
    },
    "151:4159": {
      "repository_source_sha256": "8188feb748a3c1852106f7a042246f0d4cffc89efe5ef20983d306f1bd327331",
      "en": "「Vanish, Volunteer Club!」"
    }
  },

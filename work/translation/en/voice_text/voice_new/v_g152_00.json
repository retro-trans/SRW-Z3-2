    },
    "152:4422": {
      "repository_source_sha256": "0ae8acda020638fea235b600fa5f7102654c379eb02945e603c522d1cd82bc96",
      "en": "「Incomprehensible. K6821 shows\\nability beyond this unit's data.」"
    },

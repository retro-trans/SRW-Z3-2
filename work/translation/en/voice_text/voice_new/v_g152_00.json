      "repository_source_sha256": "2635b72c8323c45fe7f6ac3eecebb8d42997dab25ca6898afd133c7556a0c34d",
      "en": "「Enemy output exceeds expectations.\\nDanger level reassessed: high.」"
    },
    "152:4662": {
      "repository_source_sha256": "22d458aef2fe82c267dc84ea3cb44757a92988cefc05537faf3ae019d9a17f58",
      "en": "「Enemy capability exceeds weapon\\nsystems. Unmeasurable. Danger: max.」"
    },
    "152:4725": {
      "repository_source_sha256": "acac6601629a432f3dc99bde55a6757b2cd99067aeaa3e7c966b831cbc066bc2",
      "en": "「Incomprehensible.\\nThe enemy exceeds its specs.」"
    },
    "152:4778": {
      "repository_source_sha256": "f3915b78c6437e5a23a47dfc6f825924e5a6eb99597962711a9ebcd8c1c61888",
      "en": "「Combat strength is even.\\nCause inferred to be the pilot.」"
    },
    "152:4837": {
      "repository_source_sha256": "c67e5ea1aaf2d8dae7334dff8448c4f96e0c8141a1bba26a02b8591a316f48eb",
      "en": "「Incomprehensible. Enemy movement\\nexceeds the pilot's bodily limits.」"
    },
    "152:4892": {
      "repository_source_sha256": "a168391cdbbd9b4eb53181172fb683863061ac591ea8f9d81d08b88175c5fe25",

    },
    "152:5279": {
      "repository_source_sha256": "55cd3dad2e6dd4f8b83b420eab2694656d23eba27350351cd187abfb0444b9b4",
      "en": "「You deny the realization of order.\\nIncomprehensible.」"
    },
    "152:5328": {
      "repository_source_sha256": "be1985461b0bbc66b3aa3d21c97bf9d17070083df960bf1877e295f22cc3c368",
      "en": "「I am the being called god.\\nI will win as the ruler.」"
    },
    "152:5385": {
      "repository_source_sha256": "6328f682b803f07dc35d89f7e06338df9c364f27378ebadbc23b548b7e10ae30",
      "en": "「To ensure humanity peace and order,\\nI cannot be allowed to lose.」"
    },
    "152:3901": {
      "repository_source_sha256": "5af051719b0a5f7441fd89488a382802e2d25a9a03905ba40bdbbcc6ad9d23b6",

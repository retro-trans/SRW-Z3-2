      "repository_source_sha256": "e6124b5d327c0cbb381b652bc18d4f61b9883b6a31febe06f74f13f58ec93f67",
      "en": "「Your actions are meaningless.\\nCease combat at once.」"
    },
    "152:5051": {
      "repository_source_sha256": "cfac3d1652450127c67c24b2cf648ce8c8835a164f91b0fd17cdf5efffd69dcf",
      "en": "「Your existence is incomprehensible.\\nNot of the humanity I govern.」"
    },
    "152:5114": {
      "repository_source_sha256": "39380e4c59bdb0f5e93c26d8fd808bf87364daadaa622ec3223609b20a108b18",
      "en": "「Judged you the plan's top threat.\\nTop-priority elimination target.」"
    },
    "152:5171": {
      "repository_source_sha256": "092050e2487c10eecfa4e96664dce092d37d4851685266863b9d20a96c1042c8",
      "en": "「Unit damage rate rising.\\nConsidering retreat mode.」"
    },
    "152:5220": {
      "repository_source_sha256": "47051377be070a5c7dc7e5c136251ea82e4d10fd1f3e521b6a18a966d88fb0cd",

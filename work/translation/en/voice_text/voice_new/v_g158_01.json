    },
    "158:1626": {
      "repository_source_sha256": "bdd1a478e43ee9d2654234580b23858a96690363f4d8cc8c1634d75eed5e5885",
      "en": "「Whoever they are, one-on-one...!」"
    },
    "158:7517": {
      "repository_source_sha256": "26522d792df96f4ef3acb8869a233a7ec467b3c3a792ae9f2cc46fe793bd5305",

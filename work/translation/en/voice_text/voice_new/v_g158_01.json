    },
    "158:3017": {
      "repository_source_sha256": "0548da566304237b2b6f7bc3c34d527706e3968576f3ae2569f67765a7d97a5c",
      "en": "「I won't let the battle of $$グローリー・スター$$\\nend in a place like this!」"
    },
    "158:3078": {
      "repository_source_sha256": "edc8de269d285f7d036c894e451bff458c62da74db67a21fce614d08c1996073",
      "en": "「I won't allow it...!\\nOn my pride, I'll protect $$バルゴラ$$!」"
    },
    "158:8676": {
      "repository_source_sha256": "9f94e5550c0b2087c0a2db760d260d34e0a3bd6cbbabf1449643b0b9f8525f9d",
      "en": "「Now my true mettle is tested...!」"
    },
    "158:8715": {
      "repository_source_sha256": "ce3e398e3a6458ef888f21fcb86775e0dbeaf0a82117384f710c7e3730e00633",
      "en": "「While I have pride, I fight on...!」"
    },
    "158:8756": {
      "repository_source_sha256": "1348dbc18ba327b535726ca2180a8a3ce415ddea2267dfad9c874e30edf64a7c",
      "en": "「I won't lose to sorrow or foes...!\\nI can't lose!」"
    },
    "158:8807": {
      "repository_source_sha256": "96903027dde4ed5f2106e6552bb5e87ff00c8673d6d3068c8fe8c4efd24ba257",
      "en": "「What saves me when I'm cornered\\nis what I gained in past battles...!」"
    },
    "158:8874": {
      "repository_source_sha256": "43f53e78bdb764adb7e347009adb8d1ebbfec04a087249c79dc6d59897bcee09",
      "en": "「Hold on a little longer, $$エイクロス$$!」"
    },
    "158:8911": {
      "repository_source_sha256": "d1069b5c651ec71833f9927c019d097ab383349e2ae09d7ddd2bcaf549d35efd",
      "en": "「Even $$バルゴラ$$ can't outrun them...!」"
    },
    "158:8954": {
      "repository_source_sha256": "87820af985c3a4110d8904379bb180a4451e1b0cbc0a60413ddf5e372e294a95",
      "en": "「$$バルビエル$$'s hatred swallows me...!」"
    },
    "158:8993": {
      "repository_source_sha256": "4438264c81184c38c09dfe6a7ab011126fc97aaab8b4cd8e93aa505d6f066b1d",
      "en": "「This is $$サイデリアル$$ reactor power...!」"
    },
    "158:9036": {
      "repository_source_sha256": "9ee927dbe4807fcadfc49230f7610437273c9b076103f49ad457b27fbd78406a",
      "en": "「$$アサキム$$!\\nI can't lose to you of all people!」"
    },
    "158:9093": {
      "repository_source_sha256": "278776d0375031a53b3279131076b4a95d32d6ac4ec7e0550d630d2d557ccff7",
      "en": "「Humanity and I won't lose to you...!」"
    },
    "158:9132": {
      "repository_source_sha256": "43a22629c43787215d28661bbd309a13a5a86caad8ff0f9df6590739c85c2d64",
      "en": "「I won't let it go your way...!\\nNot me, not this universe!」"
    },
    "158:2542": {
      "repository_source_sha256": "430f756945edd867ddd2caea606dedd64dcaa6a82443b09f6848e080470f2051",
      "en": "「$$バルゴラ$$ is our pride...!\\nI won't allow any more!」"
    },
    "158:2599": {
      "repository_source_sha256": "12ecdd3194d706e89ff84c3f342180c34224b91cf150a4ac91348111d5712be2",
      "en": "「I can't shake them off...?!」"
    },
    "158:2632": {
      "repository_source_sha256": "666f7c0d27a70b3663e9e0a522d857cbf8b4893f9e950daec912cbeb1ead72c4",
      "en": "「If they read my trajectory,\\nI'll change my motion pattern...!」"
    },
    "158:2699": {
      "repository_source_sha256": "1962b7484e2557ef2f37ce6e0015bd8fcdf32d24901f5cc02da78c06fefb5d91",
      "en": "「...I won't scream...!\\nI'm a warrior too!」"
    },
    "158:2750": {
      "repository_source_sha256": "632b81b539432b2400b90e5ff4c5f9045c6033b5d25b36fd7ad1195741d0561e",
      "en": "「In a pinch, I recall\\neverything I've done so far...!」"
    },
    "158:2805": {
      "repository_source_sha256": "644060218cfe27887688a4ed2cf21fe6efb369e0321a4fde7be251edc5647cbb",
      "en": "「$$グローリー・スター$$ is a star of glory...!\\nIt won't fall!」"
    },
    "158:8480": {
      "repository_source_sha256": "746da73ab77cdf3b1c7ce8a82ded50e22a8ae030359bad3b17fb305699690fd8",
      "en": "「If my focus breaks, I'm done...!」"
    },
    "158:8515": {
      "repository_source_sha256": "5c52119124fa1a091cfb9fb85eefe03a7958b2bca7dbdf3bc1d1a16277070708",
      "en": "「I won't call this much\\na pinch...!」"
    },
    "158:8564": {
      "repository_source_sha256": "c38f36d13b8c90d63ec5a9e3984392ecef930bee77b5509cee559ac83773124b",
      "en": "「If they're reading my trajectory,\\nI'll just move faster...!」"
    },
    "158:8621": {
      "repository_source_sha256": "9458781df267675b2964c91e6d9a15856b429eb44d6e4efcba4c32f714dc2be9",
      "en": "「I can't keep slowly\\nfalling back like this...!」"
    },
    "158:2307": {
      "repository_source_sha256": "d5f9ae4358e63940aed06be00cb902a63581df4b7ec14232e5fb558a74ee2d9d",
      "en": "「Ngh...! I scratched $$バルゴラ$$...」"
    },
    "158:2350": {
      "repository_source_sha256": "69e33b68f7e16ceea76483520232e5fc8419d1699212cfe9f433f61c9fca329d",
      "en": "「If I flinch at damage,\\nI can't fight!」"
    },
    "158:2403": {
      "repository_source_sha256": "3aad6f693013cccf52fc1780020b99d5c350eae2a176f36279ab3c53e4eaa456",
      "en": "「$$バルゴラ$$ can take\\nthis much...!」"
    },
    "158:2452": {
      "repository_source_sha256": "cfdabbe03812f3fc20b9aee968c2fc1947a99e6d66c2a06916af4d11955210de",
      "en": "「Dodge timing, earlier...!\\nAnd tighter!」"
    },
    "158:2511": {
      "repository_source_sha256": "4716b0d1290b82a45d4b420ab87c577bb04dc4034528eef6b776a487cea89f30",
      "en": "「Did I misjudge their movement...?!」"
    }

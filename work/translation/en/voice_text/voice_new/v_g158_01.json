    },
    "158:10905": {
      "repository_source_sha256": "4f74d3969aa0ed31405ecb7a203f024fab436bdc8a370a307f3424638890c608",
      "en": "「Kyaaaaah!!」"
    },
    "158:2862": {
      "repository_source_sha256": "0bb22467475f7d05b8909ec21c5a555f59eba5dedf9babbac6d2d8824301dbb6",
      "en": "「I won't be killed for nothing...!」"
    },
    "158:2899": {
      "repository_source_sha256": "94d37003a3f9a91544a48733c0ceda91f2ca3aa10a9590bcb7d95137c209d49e",
      "en": "「My mission is to come back alive...!\\nI refuse to die!」"
    },
    "158:2954": {
      "repository_source_sha256": "7dececdd80c7c18a808ece6eccf971a0922d9a6976d7b8ee1f0a8204786d3007",

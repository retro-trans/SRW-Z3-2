{
  "schema": 1,
  "rows": {
    "159:9169": {
      "repository_source_sha256": "1a79f183b10405f220c3ecc13eca1e3949064eb56e9354038a86fac7b3be3ba4",
      "en": "「You walked right into my trap...!」"
    },
    "159:10467": {
      "repository_source_sha256": "35b851dfc96f32283ca4a5e76d0c5788e1cf73b9a83b424e9dbbb284f15c3493",
      "en": "「Damn it!! I didn't expect this much!」"
    },
    "159:10504": {
      "repository_source_sha256": "975aa2dc578d435b2f73339ca6417592c7f1411e49ede0f92fab6b9529cf4f5a",
      "en": "「No excuses...! Retreating!」"
    },
    "159:10147": {
      "repository_source_sha256": "e262608a24e7b46268938e7d6fe13ac4a0cad9019301712fc623f3fe6b930e2d",
      "en": "「Very well...!\\nI'll show you a comeback from here!」"
    },
    "159:10204": {
      "repository_source_sha256": "0d1dd8d0dfc710e2518aa789b9cf37fbee00e5e36ef5b470da210b97299437d3",
      "en": "「You're ahead of my read...?!」"
    },
    "159:10241": {
      "repository_source_sha256": "dca8d06a5451a603ae0494cc5aa36d6eef6646de4fed2d404da09204c92113db",
      "en": "「A brush with death like this...!\\nI've crossed far worse many times!」"
    },
    "159:10292": {
      "repository_source_sha256": "7991a1432ba95b18894a5693b883922840bf83ee7f76a9bbc41e9c3c7edcda7d",
      "en": "「I still have a move...!\\nAll that's left is the timing...!」"
    },
    "159:10347": {
      "repository_source_sha256": "3b143d0d77d08a12e41f2b92279730fab6266a55a7602301befd53390935c79c",
      "en": "「$$ロロ$$, $$シャーリー$$, $$ユフィ$$...!\\nLend me your strength!」"
    },
    "159:10406": {
      "repository_source_sha256": "7c1c7faf7cf2bb57cc2b86630e50c19af44c17d55375f9a9b460ba314328740c",
      "en": "「For the future $$ナナリー$$ wants...!\\nI will win without fail!」"
    },
    "159:9897": {
      "repository_source_sha256": "3c96b28565ca7afdd3510d4d2da1b56824d3fc0236d3b434eb0b67fb18b81794",
      "en": "「So you're no easy opponent...!」"
    },
    "159:9940": {
      "repository_source_sha256": "29a5efb90723ef0c9d2f7b5f39c3ab53f8b283f9d341db7802e6bdd67d9c7b10",
      "en": "「You've focused your aim on me...!」"
    },
    "159:9979": {
      "repository_source_sha256": "3749a22d52a33df7f570ab7975d26f91d98d3247d7c5f7af7e090232583f2043",
      "en": "「Little by little, my calculations\\nare going off...?!」"
    },
    "159:10065": {
      "repository_source_sha256": "cda04ac42958d8de972c2134ced280334e200dcaef430243c7108ca045df1022",
      "en": "「Tch! Falling for a simple feint...!」"
    },
    "159:10108": {
      "repository_source_sha256": "df2f5a8dc06d4fd72061aab97f0b92e646e0dba8a801788d247770b4da4da3ce",
      "en": "「You won't let me win that easily...!」"
    },
    "159:9751": {
      "repository_source_sha256": "8c593ff3f70654806e8e5a507c866474441b6b0df1550cd0a718eee85ec149eb",
      "en": "「As projected. No problems at all.」"
    },
    "159:9778": {
      "repository_source_sha256": "cb82bc9b2a997c08a290fdca33f78d0370ad9b461c805ec0ed54aecaa99a060a",
      "en": "「A petty mistake. I must be careful.」"
    },
    "159:9811": {
      "repository_source_sha256": "c017415abcb9a962c8fdc15800411894ea1f6d61d91f98561b7e864f5b29fb3b",
      "en": "「Not bad, but it lacks boldness.」"
    },
    "159:9854": {
      "repository_source_sha256": "4dde125982bb9d2d086c6f4c565237ff742c0de59baefaea3ef67be8efe48e17",
      "en": "「Evasion patterns may need review.」"
    },
    "159:9365": {
      "repository_source_sha256": "a027f3c25d09383b13855c274ebf9d68c480e383284cfaa298be4e3015fc93d1",
      "en": "「An unsurprising result.」"
    },
    "159:9392": {
      "repository_source_sha256": "932963bcdf91d393fb2b1d97de7799de1d775d942965dad4d0c2c95b670b075a",
      "en": "「At this rate, I win in two moves.」"
    },
    "159:9435": {
      "repository_source_sha256": "e0c29f72db57fd926b8137e802e7a9c00e7957c2e55cff8053ee0b5043aa8db9",
      "en": "「Nothing but hot blood, I see.」"
    },
    "159:9466": {
      "repository_source_sha256": "9a6b3fae77fedddf7b0ff347ac4e057a68c87da22ac7138e4779f490edfb1c72",
      "en": "「If it doesn't hit, it means nothing.」"
    },
    "159:9499": {
      "repository_source_sha256": "4824b4f07bda0f2379649290ddc25db9a82e38e3611e87d512062ea88e1b3c40",
      "en": "「Surely you won't blame your machine?」"
    },
    "159:9542": {
      "repository_source_sha256": "63eb3ae92d1460d3b46a94a529c8ed83b49d3aa9f777d548be03dcf38d55e7bd",
      "en": "「Use your head more when attacking.」"
    },
    "159:9581": {
      "repository_source_sha256": "d9ce0d46aa798e54111fde37bc845f25b8a3f44071d6abbc6eda9b5988a1ec51",
      "en": "「I'd already seen this result.」"
    },
    "159:9610": {
      "repository_source_sha256": "d8a71135b36cc4d48e8e53165a49aa7e9cf9c24bd39743ccc043bb3744e12344",
      "en": "「I read three moves ahead\\nbefore I act.」"
    },
    "159:9659": {
      "repository_source_sha256": "58061cbc42455b1e4d14948ebc7e24078131e9ce88f2f7b7e5a79c9d37e04f41",
      "en": "「Systems should be used effectively.」"
    },
    "159:9692": {
      "repository_source_sha256": "1f809d88070906f5077ca6303ddb91cd0f3589b2ebab8dca9374c513d35d2d05",
      "en": "「This is the Absolute Guard Zone,\\nand my power to wield it...!」"
    },
    "159:4675": {
      "repository_source_sha256": "1311b8f20b36e0e564204748c8be056d493410f9987fb0deeee0e7d6f228f4f1",
      "en": "「Yes... I... will destroy... the world... and create... the world.........」"
    },
    "159:10539": {
      "repository_source_sha256": "f52939322b84fdea8c9fd581e2d98e489761bc06cfea6609c4ffa4cf992f4d68",
      "en": "「The game is born... from the player's actions」"
    },
    "159:10598": {
      "repository_source_sha256": "067d14598d0b7e230eb04a7b1f8e1abad54b6d6a8fe1bdbd05627358067a9faa",
      "en": "「The game moves on... by the player's choices」"
    },
    "159:10653": {
      "repository_source_sha256": "15e0d93a37fab560f5e5fe4df182c9120a90afa8c73bcb008089a03757763286",
      "en": "「Yes, this game is about to enter its next form」"
    },
    "159:10704": {
      "repository_source_sha256": "6ac112f2069897b5621cc9aa1d6b2c74252ebf456748cfbfcf32769851dbb258",
      "en": "「Be sure to come back. So the hands that mark time never stop...」"
    },
    "159:10755": {
      "repository_source_sha256": "be0bcd9a24bc0cd12a8a7cc8556e2d307ffadd77e86e4ef0f7d5f22a502416e4",
      "en": "「This is my own way of drawing the line. I've decided to live as $$ゼロ$$」"
    },
    "159:10812": {
      "repository_source_sha256": "b49ea35f53069314354c05dba278c2a8dd7a021516d645b2d83edf78e56b46a5",
      "en": "「Hmm...」"
    },
    "159:10823": {
      "repository_source_sha256": "b3d1890abb6441bd4f4d536204a09f9fce87250dd028b6fb30dd79b6dd9e17bc",
      "en": "「This is fine, right?」"
    },
    "159:10846": {
      "repository_source_sha256": "dc262d3b2b88dcf80059efc6ed4ab745e77dcc4cdcb54a757a784ebb209be7c2",
      "en": "「Even unsaid, the player surely knows what they must achieve...」"
    },
    "159:10919": {
      "repository_source_sha256": "7c7e69c7b352160216e6116406c44af7750b0cb8bf28e2e5678f5c7315075ce9",
      "en": "「I, $$ルルーシュ・ヴィ・ブリタニア$$, order you!」"
    },
    "159:10962": {
      "repository_source_sha256": "99ba76fc690f6547e5025d27ea313ff0645ec5e74d8a39fb9cee0146878c6f55",
      "en": "「Player, return to the game at once and clear SRW as fast as you can!」"
    },
    "159:11037": {
      "repository_source_sha256": "1dc877a2aeb50c183e89774e2ade5d583241d8fd2d2291da47c13d1797e3b4b1",
      "en": "「...Is what I'd like to say, but this isn't a Geass order. It's my wish.」"
    },
    "159:11112": {
      "repository_source_sha256": "5afeb7bd9a4bc2ef2ff2e977599b2836fa08e51a5d2e0ff25e3dc4a08d29a050",
      "en": "「I look forward to meeting you all again. Show me that miracle of yours: victory.」"
    },
    "159:8798": {
      "repository_source_sha256": "f4cb158a42df4c6c81bc13a6c47d513eba1e43d336d7aae59e18296b4aeac451",
      "en": "「I won't let you...!」"
    },
    "159:8821": {
      "repository_source_sha256": "81a56d5bbc36790a4676c9168eade2085a0a64d58f0edf5dad01ff706bc3a7c0",
      "en": "「I won't let a single unit fall...!」"
    },
    "159:8854": {
      "repository_source_sha256": "cf7cc78414a7039e8b5d296c64ec16b5b62ffc7727acb6c67d17d49d353c6fe2",
      "en": "「I told you, $$スザク$$! Live!」"
    },
    "159:8895": {
      "repository_source_sha256": "ae4189b0c5ee7c7ae4eed2d12960b9bc5ba8d1893c556b726e4d29c3e530c546",
      "en": "「$$カレン$$! You still can't die!」"
    },
    "159:8934": {
      "repository_source_sha256": "e35467800262090e5e62235792061cfaa2b11ac9f4a504e83c567f7203ba3b0a",
      "en": "「Hey, stop being such a handful.」"
    },
    "159:8965": {
      "repository_source_sha256": "e1868e71b237dae5d869e6d2189320666268d05e5e42e00170429ec599809dc6",
      "en": "「Don't be reckless, $$キリコ$$!」"
    },
    "159:8992": {
      "repository_source_sha256": "285af7a0a7ecbde3e4ba721b059f2a2349a5c455953e16474b302586a9e6b1b1",
      "en": "「Fall back, $$ヒイロ$$!」"
    },
    "159:9019": {
      "repository_source_sha256": "888cf2389d00adfa8499652d44258bb8d479f8a779ecd7d37cb515c082734506",
      "en": "「If a Gundam goes down,\\nunit morale is at stake!」"
    },
    "159:9068": {
      "repository_source_sha256": "bc9c44e50cefd00a7dbbdf059a2f51c03c5521f9a49fb8694aeb867a779854f2",
      "en": "「I can't lose the unit's linchpin...!」"
    },
    "159:9295": {
      "repository_source_sha256": "4ce9c992f2909911dcaf0331423ccaa3a5eaf28be8398738f1385e52a055102d",
      "en": "「Can't retaliate?! Impossible...!」"
    },
    "159:9328": {
      "repository_source_sha256": "091f883f633f32622bddbf0005b44a38f616fee8ad09115c45f4296cdef85370",
      "en": "「So even I misread it...!」"
    },
    "159:4923": {
      "repository_source_sha256": "f8a1a5b9063283014db342981e7e58b06fa4c8c4131339ba5f62dbbbc067ef23",
      "en": "「Just as I read!」"
    },
    "159:4940": {
      "repository_source_sha256": "7978d918d85090ecc292f3d81620ab874004af17f9397415c76d77558aef10c7",
      "en": "「Is this the sure way?!」"
    },
    "159:4959": {
      "repository_source_sha256": "1b4a3919bbd1e0df0a82ec081d0512c2b1a50e15b1ff15bc4ae3c027f19727d1",
      "en": "「This is how you use power!」"
    },
    "159:4992": {
      "repository_source_sha256": "ceafb166944b33036b8995870168ab3325a7f8f5608cbe2428f39ea6af2ce3db",
      "en": "「This is how $$ゼロ$$ fights!」"
    },
    "159:5019": {
      "repository_source_sha256": "307e8cb006bcf96fccc06e326057200502b44bb795902eef4ddaeedca27877ba",
      "en": "「Let me gauge your performance!」"
    },
    "159:5048": {
      "repository_source_sha256": "ad3670739ed573e0d348eb0fc59296062a7e0dd1dcfd05935f24e6d257b3967f",
      "en": "「I'll simply eliminate any obstacle!」"
    },
    "159:5083": {
      "repository_source_sha256": "988163a5a26c0125c9fffc30342cbe2bd00ede5c29371da6d827c721c991fe11",
      "en": "「Kindly leave this place!」"
    },
    "159:5116": {
      "repository_source_sha256": "1a14f088568a3497d48122f3e685ff23cb22a9a31394376dff819ff5aeb6b224",
      "en": "「Your defeat is sealed this instant!」"
    },
    "159:5153": {
      "repository_source_sha256": "1fc5ac35c758b23c53d97a874ac2656f9834596a22fb9d31929276ba6f7a6dbb",
      "en": "「You can't dodge this move!」"
    },
    "159:5182": {
      "repository_source_sha256": "599fafa0c975183a9abd63531a761384f596c9f37cc446c09c96769d2293b123",
      "en": "「I'll knock that pride down a peg!」"
    },
    "159:5219": {
      "repository_source_sha256": "fcb1a9dfe4546cab5708af8fb0f81d476ceb3115069a2b8cae1318922fcbfe33",
      "en": "「Show me how you deal with\\nthis move!」"
    },
    "159:226": {
      "repository_source_sha256": "ef3336d07d435b9953ff2a7a7c410b36b61d9cf47503db7d4e1cf85d723a7a85",
      "en": "「If I can just stop its movement!」"
    },
    "159:249": {
      "repository_source_sha256": "368796b33ffc1784ec69f4c4c901047e006216c8957e71463516fd2e1c1594f7",
      "en": "「Damn it, quit darting around!」"
    },
    "159:5369": {
      "repository_source_sha256": "8f16953ada72674b9c2409814583a81d746cc77441418f7d22bd8819df2eb459",
      "en": "「I can't keep saying I'm bad at it!」"
    },
    "159:5398": {
      "repository_source_sha256": "e89f49455defb2cf86069d057e80d73f886041f7577d78c4e0203261739ec8ad",
      "en": "「I should be able to pull this off!」"
    },
    "159:5268": {
      "repository_source_sha256": "12e7d86ddd8a42390b6857c1d622f52163eb454514a74cf0588772f460f50849",
      "en": "「I can read your every move!」"
    },
    "159:5307": {
      "repository_source_sha256": "6df2900d610ee7e420ed6850a664ebd548ac8b2fd0f7a164d21e8f0d0251a31b",
      "en": "「Never knowing you were being led...!」"
    },
    "159:5338": {
      "repository_source_sha256": "4f532b3900843dd034b93fc3ea96c2c518b6fafe0ad15440f42b491b6b9a9827",
      "en": "「You came there, as expected...!」"
    },
    "159:8111": {
      "repository_source_sha256": "bd59dee350d376984bf86b3f2cee932ce3f6b08d580cf8c0bfda68d41f764dfc",
      "en": "「No escape. Nowhere at all...!」"
    },
    "159:8148": {
      "repository_source_sha256": "db97b9a27399858637183af97841f1e6f8ce0d37d572cd196e637600bd12d611",
      "en": "「Diffusion Phase Cannon, fire!」"
    },
    "159:8177": {
      "repository_source_sha256": "548bed079569e6cc98c025ff3f9a611455079582a8714dbd04d047f0836aaaa9",
      "en": "「If resisting is humanity's history,\\nI'll see it through too!」"
    },
    "159:8232": {
      "repository_source_sha256": "5a377f53d2c5b853ccc6f5e9533a534a010baf10c37a6bd0e49e7b55a2d86053",
      "en": "「Good, from this position...!」"
    },
    "159:8265": {
      "repository_source_sha256": "49745931983c1680cd93d5a91ea65beda028995d58b30157ad96bbf652df853c",
      "en": "「Now! Phase Transition Cannon, fire!」"
    },
    "159:8294": {
      "repository_source_sha256": "104436d5a082d184015a68f3e5227473c726fb2ba6693ef1c84cff6c9b418387",
      "en": "「Not for nothing the miracle worker!」"
    },
    "159:5458": {
      "repository_source_sha256": "f7d18c4c8e879cea267d02a7b7952a8e1a904ce5d653230a0dfe571f7fb19b6b",
      "en": "「This move decides it!」"
    },
    "159:5481": {
      "repository_source_sha256": "3ea1ab821f82bc4f8b3d50ae2374eb56f949931a69d867ff85f46d3ad665fbec",
      "en": "「And that's checkmate...!」"
    },
    "159:5512": {
      "repository_source_sha256": "6fa60a8c89e8233e106555d5c29752089cfef63e44e0462dbf7c8d5e0bdd0970",
      "en": "「Be gone!!」"
    },
    "159:5535": {
      "repository_source_sha256": "9803b51176b87061da35c6ac3e0339cf1f6f93c8f81db29243666d7153026909",
      "en": "「Is that the end? How anticlimactic.」"
    }
  },

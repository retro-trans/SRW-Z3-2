{
  "schema": 1,
  "rows": {
    "164:0": {
      "repository_source_sha256": "b8f438e31dc548dc790d7dfa3a419ebc504719e0985a88b8a006d2af8b1b93e1",
      "en": "「My name is $$ダバラーン・タウ$$...!\\nThey call me a fierce general!」"
    },
    "164:59": {
      "repository_source_sha256": "6c34da759870fb2959c2ec86fd2a837b3a45f59411d9c692e528e7663e3e69dd",
      "en": "「I'll bury all who stand in my way!」"
    },
    "164:100": {
      "repository_source_sha256": "5bf32b0ee7f057422869b787f279be00c8b0e0e1732fe20abda371cf751951f6",
      "en": "「Your life is mine!」"
    },
    "164:129": {
      "repository_source_sha256": "eee293d6582d48e6c5b1aff44e3c182a059e1bbcc228a1442b11cb9d02b6eea9",
      "en": "「I'll teach you\\nyour place...!」"
    },
    "164:178": {
      "repository_source_sha256": "7b344ed80512c8b94c4b415bc538854ebc21e8909a7439ae61fc16e112b60da2",
      "en": "「Come at me with all you've got!」"
    },
    "164:217": {
      "repository_source_sha256": "d7356632c3dd0212bb7fc97e5e59b66db419b7e887ee8748262db95c5dcd28b6",
      "en": "「A battle on the line...!\\nThat is what I desire!」"
    },
    "164:270": {
      "repository_source_sha256": "06b92d70d222cdf4d481ee238768c345700d5a65ff6d73060dc15149c6855994",
      "en": "「Battle sets my blood boiling...!」"
    },
    "164:303": {
      "repository_source_sha256": "7aa653f7181347218a6204b6e60b31c4ce517096e251caf621d8bb2e01cc947e",
      "en": "「Satisfy my fighting instinct...!」"
    },
    "164:346": {
      "repository_source_sha256": "c5dc123cc9f7ef004acdca045bbbc07de61e3961390aa75de8271b05fab4f624",
      "en": "「Battle is my very life!」"
    },
    "164:381": {
      "repository_source_sha256": "b9fa73a998323e32d0ce09e80a418f702534831719674ef153095b06b33b0579",
      "en": "「Fight me with all you've got!\\nThat is your role!」"
    },
    "164:432": {
      "repository_source_sha256": "bf832f87ce594a797e122784bee5bf8f2f18a52430af775181bf466f485450da",
      "en": "「I'll savor this supreme game!」"
    },
    "164:475": {
      "repository_source_sha256": "2fb507e29d7b6bab25f33c5f0c2d3e39f74a6f95fc69d6c124f2a70a5732aeb2",
      "en": "「Burn the battle of $$ハイアデス$$\\ninto your eyes!」"
    },
    "164:528": {
      "repository_source_sha256": "49573e228eda12d7b2b52520705725f1ccd6c9ca8d81d1f4657002e9a290ee66",
      "en": "「I hope you'll amuse her\\nat least a little!」"
    },
    "164:581": {
      "repository_source_sha256": "0766dc758628898923662e53dcaf42727ad9b685b950459f89b049281ba34aa8",
      "en": "「Your head will be my gift for\\nSupreme Commander $$ストラウス$$...!」"
    },
    "164:634": {
      "repository_source_sha256": "b67d3db8070bee54fdfd42de66914c15980ac67528aadcf22397a8ce02168cfc",
      "en": "「This fight is for $$ストラウス$$!」"
    },
    "164:675": {
      "repository_source_sha256": "94266683858129201c236df715f1a7247b30aa1d6ab15e66ae27534283add7ea",
      "en": "「Victory to our leader, Lady $$エルーナ$$!」"
    },
    "164:714": {
      "repository_source_sha256": "3553595fc0cddea8dbc5ca17c75c5c86482b8c43fbc4b4197a36eeed2f79ab5c",
      "en": "「Lady $$エルーナ$$!\\nWatch your servant $$ダバラーン$$ fight!」"
    },
    "164:771": {
      "repository_source_sha256": "55deb79d3138967f6633958f6af155461691f3157f5319a6ecb41365ebe7fd8c",
      "en": "「This burning passion...!\\nAll of it for Lady $$エルーナ$$!」"
    },
    "164:826": {
      "repository_source_sha256": "47f64de409708e6e25ea0829783fc675bf2601bf5ff9ac04f4ef613427f631f4",
      "en": "「I can't use my power on this ship,\\nbut it can't be helped」"
    },
    "164:877": {
      "repository_source_sha256": "e72e858c4d1f9a1f28e8b6752b60741864d4151366c78bd764c61e2640995bca",
      "en": "「For the likes of you,\\nthis $$アドラティオ$$ is enough!」"
    },
    "164:934": {
      "repository_source_sha256": "388bd52ff193b1a4a3fab25606f9a6b48a4a5f5328f38be07ade2c499e0bb3e2",
      "en": "「This ship is no $$アドラティオ$$, mind you!」"
    },
    "164:977": {
      "repository_source_sha256": "4e146502b50db8f6be7a9b6756c74632476eb6f69fbfbd2d550d353130cbfd05",
      "en": "「This ship is the limbs of $$ハイアデス$$,\\nracing across the galaxy!」"
    },
    "164:1026": {
      "repository_source_sha256": "7889cde52fd114916d54e8d054f6353b8f9f34bd91adc128a826d64dc6537140",
      "en": "「Ship and man as one: the ultimate!」"
    },
    "164:1135": {
      "repository_source_sha256": "f254f91c4d4002efbe2e80247ef9c911dbe92b707dae9ca84dee1c48089eefeb",
      "en": "「A child, yet a full-fledged warrior!」"
    },
    "164:1176": {
      "repository_source_sha256": "aa5c891e237b050838e77ca29fea17bc3dffe708ee1194043c6e26b9243c6b9f",
      "en": "「Show me the power that once\\ndrove back Emperor $$ズール$$!」"
    },
    "164:1229": {
      "repository_source_sha256": "cad1b71c919d97b69a88dbb7317b7563e4dfa14fca357da4422120d700ee03c3",
      "en": "「I'll end the $$異能生存体$$ myth!」"
    },
    "164:1272": {
      "repository_source_sha256": "8b0d76c2c7b9792e20372c0c60ccfea559c8ab2bb72f1c61d3db393a60ca8514",
      "en": "「Effort and guts, eh? Fine spirit!」"
    },
    "164:1313": {
      "repository_source_sha256": "daa34aff9a0169b65a5f81de6ac4f25da65d15ba2c71fc5e7025a916c81643a9",
      "en": "「Let the supreme game begin, Gundam!」"
    },
    "164:1350": {
      "repository_source_sha256": "af23f6355ab07f04c2d50ae01bbe21c72b945a5b7f9dd537a5d305279b2ad2e0",
      "en": "「Gundams! Amuse me!」"
    },
    "164:1391": {
      "repository_source_sha256": "eda67db678b05a41051e2e66bef58c5a4c2ede28d2bf96243030cb2cab8c7635",
      "en": "「Use your power in battle!\\nOtherwise it's no fun!」"
    },
    "164:1450": {
      "repository_source_sha256": "6999156b05f397a388bd2e02606fa4b06ab070bb550669152101df17d747e2b9",
      "en": "「An enhanced soldier! Interesting!」"
    },
    "164:1483": {
      "repository_source_sha256": "ecdd3baf0b54122d61935b9698a69ab88f3205bcb67f2c0ced94dde688377387",
      "en": "「This song... my blood boils...!」"
    },
    "164:1510": {
      "repository_source_sha256": "a74685b781874059fd2fb44d4030cc4379d6dff6483db01ecac6a60b157dbbe7",
      "en": "「You're no ordinary gnat, I see!」"
    },
    "164:1547": {
      "repository_source_sha256": "d603f410057e392f729c11eaab408a7fcdb0992a645c8c277cf6c12700b2b116",
      "en": "「Here I come,\\nwarriors enthralled by $$ゲッター線$$!」"
    },
    "164:1598": {
      "repository_source_sha256": "c7e0e69b3f649d8d03edd26b423f777464ce4f74efa828f12e74691b766bd03e",
      "en": "「Heir to the soul of $$ゼウス神#pilot$$!\\nLet's settle this fair and square!」"
    },
    "164:1649": {
      "repository_source_sha256": "de2c3fef3e9dcccca9e62cfdf208432ade50a3a7d24fe0064f64511a397e0e08",
      "en": "「Show me a corporate warrior's power!」"
    },
    "164:1692": {
      "repository_source_sha256": "b0693fd6843aa835a1e286190e606520a7f9713b74d36df48793feca12538783",
      "en": "「Don't think smooth talk will work!」"
    },
    "164:1733": {
      "repository_source_sha256": "c3fdbd1a6b364cedf2b4fda9b8c8e8bacac00c3d099b8ca8e48cbce8fc7a13c1",
      "en": "「Forbidden power, is it? Interesting!」"
    },
    "164:1764": {
      "repository_source_sha256": "1bc7cfd14e583a25cd78fb8df0ce762e0383a7c4e83ac153595ff0e05fdb12da",
      "en": "「Beasts are beaten down by force!\\nThat is the way of the galaxy!」"
    },
    "164:1815": {
      "repository_source_sha256": "0e6f3ceff06c726affcb5dfb8c16563548fd598d3af52befeddf349144892672",
      "en": "「So you're the Spiral Man!\\nYou'll do nicely as an opponent!」"
    },
    "164:1868": {
      "repository_source_sha256": "93f135bed3dafa755b414b06945b5f26ac3064028d84617c9799d669b0195f6a",
      "en": "「I'll destroy the android!」"
    },
    "164:1893": {
      "repository_source_sha256": "1d77d078b50c41e85df882b85a7c8f63254e4211b24d837d0ab5ab90f9361392",
      "en": "「Claim the name 'Invincible'\\nafter you defeat me!」"
    },
    "164:1946": {
      "repository_source_sha256": "06af8b493a100daffb2551bac84c22df2aea60d7d594e0862ba3bf1c5579e2cc",
      "en": "「Come, Mechanical Angel! Face me!」"
    },
    "164:1985": {
      "repository_source_sha256": "84408c182095219324e7032f35fa6091f74999ddfa3b75b6c6c4907ca201b451",
      "en": "「Come, $$スフィア・リアクター$$!」"
    },
    "164:2024": {
      "repository_source_sha256": "634de30b61e1f263b3dc92e4adea716228858167e04f48cafdd9367dec175640",
      "en": "「$$ランド・トラビス$$,\\nYou alone I'll bury by my own hand!」"
    },
    "164:2075": {
      "repository_source_sha256": "e81aeaf382eb9938e8152a04abdd0d5e02a9829412f86378d32e6c4b7640082c",
      "en": "「Damn it!\\nWhy does Lady $$エルーナ$$ favor him!?」"
    },
    "164:2130": {
      "repository_source_sha256": "8e42329396745b48e33972aa9c0e4ae4f5ed9d660da3a5ef761fcd0aadd401a2",
      "en": "「Maiden!\\nSink into even deeper sorrow!」"
    },
    "164:2179": {
      "repository_source_sha256": "d3da843b0cc2429913441ad88304fccb9de55ea501de3afbfb9bfd38cc5d2150",
      "en": "「Money-grubber...!\\nYou don't deserve to be a warrior!」"
    },
    "164:2234": {
      "repository_source_sha256": "b63f3e6b8ec29456325a54d0ff952cff34109c9845fd80b7c64a2b2cc9477a16",
      "en": "「Show me the $$いがみ合う双子$$' power!」"
    },
    "164:2271": {
      "repository_source_sha256": "530be80c347803dde512e0d3f56f970e2e37364cae49930b31a91a6ea3b15d92",
      "en": "「I can tell!\\nYou're a warrior worthy of me!」"
    },
    "164:2320": {
      "repository_source_sha256": "ff820853a5d474547e8f9fb7c2b699a3eddecece4f9ba85ffa8089f59115ccab",
      "en": "「A one-man army, they call you? Then!」"
    },
    "164:2359": {
      "repository_source_sha256": "0553549921432427068188545b6cfe1a5a60e2d029d03838bcc856ada757e881",
      "en": "「That power...! My blood boils!」"
    },
    "164:2402": {
      "repository_source_sha256": "19fea82e7e99e9a459280c34cccc5e4f9c156020cde51515544d8cae62294797",
      "en": "「Woman or not, I won't hold back!」"
    },
    "164:2437": {
      "repository_source_sha256": "71aa5f8f0cf50ccff0cb21192223a55de5232dc331f7c70839a3f9b20c2eb610",
      "en": "「Ladies normally get my courtesy...\\nBut this is a battlefield!」"
    },
    "164:2500": {
      "repository_source_sha256": "dec5a7b5a4105f9cd7e793e707cbdc516a8650a6987587e8e508974e9877ff50",
      "en": "「Ship combat is a thrilling setup!」"
    },
    "164:2541": {
      "repository_source_sha256": "386f334de359cba95ccaf4953387da2ea55ae0c2b1129d85da8c5738aa69d89e",
      "en": "「Ship battles do stir the blood!」"
    },
    "164:2582": {
      "repository_source_sha256": "bc2d9af0be7c596c7588020009215863a8658fb3d50343f7a750c7031b27863c",
      "en": "「Show me your skill as a commander!」"
    },
    "164:3280": {
      "repository_source_sha256": "d5bf82bf4caec8e8e8922130462f8bb72f155827d76937afb2fbc153ce8ae41d",
      "en": "「Hitting back when hit is textbook!」"
    },
    "164:3315": {
      "repository_source_sha256": "42262e4075ecc125e3038ec125b2c9d40338f91845ad3b28da3e9f3800cb8202",
      "en": "「I've seen your power.\\nNow it's my turn!」"
    },
    "164:3364": {
      "repository_source_sha256": "4ee1f6ba563eeb440b228be218def3dfcd4c5779b252a33a1c1013ade065572a",
      "en": "「I must thank you for the fun!」"
    },
    "164:3405": {
      "repository_source_sha256": "cec824b7928f484528bd31bbf2f0c257e037a79021621a8e42715bccac1954e8",
      "en": "「Not repaying would shame $$ハイアデス$$!」"
    },
    "164:3446": {
      "repository_source_sha256": "1594dd734772c44cfd8f66e5d5ce8be756ed12c432c37dd31e9335e43000e214",
      "en": "「Take what I give back!」"
    },
    "164:3473": {
      "repository_source_sha256": "8cc0069b962fb601ecc73aeb5529756c22d2f182734af66fbc1c1f76ec620834",
      "en": "「You didn't run? Admirable guts!」"
    },
    "164:3508": {
      "repository_source_sha256": "90a028c7d70c6a20740d0f2ab2019ebeceeb7ee68ab5b206fe951325ed7bb59b",
      "en": "「Don't think you can retreat!」"
    },
    "164:3541": {
      "repository_source_sha256": "9f00d15e08e1076dff2d86111d343886a8b5e1466157bb4e704477dfd65d9377",
      "en": "「Don't be shy! Take this as thanks!」"
    },
    "164:3580": {
      "repository_source_sha256": "7f4bd4146a40b56b27ebba82b68c883eff382f347d9681bb52091d83ed900ad5",
      "en": "「I'll make victory certain!」"
    },
    "164:3609": {
      "repository_source_sha256": "fa79ff2fcdcaba12af84645196c031e9a130da1ec58f6dabc8a37e163590a071",
      "en": "「Let me in on that fun, too!」"
    },
    "164:3650": {
      "repository_source_sha256": "d4345925c5f629299753a0cb56976a663e815e30f4ca01617cc7a2a1477bd268",
      "en": "「It is an honor beyond words\\nto stand on the same battlefield!」"
    },
    "164:3699": {
      "repository_source_sha256": "a2609fdd8f2208a8467561bd6b4e2d656787c676255b243a8fb7d92367a4bca1",
      "en": "「I'm with you, Lady $$エルーナ$$!」"
    },
    "164:3728": {
      "repository_source_sha256": "8f7c1a50ef9ab37ca20b75126669a71c15d6463cea231c7666918176cf7e2277",
      "en": "「We fight for the Supreme Commander!」"
    },
    "164:1061": {
      "repository_source_sha256": "cbc2e47ddf5f781e89fde8f0d29754cbc42c408939178d4f6e96e3b4e9901a8e",
      "en": "「Oh, you can still entertain me!」"
    },
    "164:1096": {
      "repository_source_sha256": "0984c98aad2f0e6566e3403aac9c90d8685f475b04c355c79251504c65f9336b",
      "en": "「Well endured! Here's your reward!」"
    },
    "164:6523": {
      "repository_source_sha256": "9057e1ca3b0a021b38c20f4307378d24354da1b0077149b34b83785b90b5a692",
      "en": "「U-Uoooooh!!」"
    },
    "164:6554": {
      "repository_source_sha256": "995094ae4e5b3c88d6e683c57d22a534c4bfbedb45d04ed27706855929672945",
      "en": "「A fine battle!\\nLet us honor each other's valor!」"
    },
    "164:6605": {
      "repository_source_sha256": "fb9579efd4b2b8bdb92b14a82393845d321c8c64f4d41a31cbd50e2f97db5caa",
      "en": "「I look forward to the day we meet\\non the battlefield again!」"
    },
    "164:6654": {
      "repository_source_sha256": "f863bcf6993b7df0fb3bb80ac18fbfe954424870af028dcb4fdda42a20c00c23",
      "en": "「To show such a blunder\\nbefore Lady $$エルーナ$$!」"
    },
    "164:6705": {
      "repository_source_sha256": "d2ad365a09d7cc78710aa4adc177d0f8fbd1dfbaa61b964a8a949245ac469a46",
      "en": "「This ship goes no further...!」"
    },
    "164:6734": {
      "repository_source_sha256": "e2c512d4a0310419944b692d4fd8b385c270eb4b0ab85afedd24d0ac4f9698e9",
      "en": "「No regrets!\\nI gave it everything I had!」"
    },
    "164:6783": {
      "repository_source_sha256": "46a4b806abcae1cee4a7e0b52214f1306f6665d3548963ef3bee9cc292e1a3e8",
      "en": "「So my days of battle end here too...」"
    },
    "164:5568": {
      "repository_source_sha256": "7bc69a657e4b4462670c039bc0c85bf8a4c4360f417482db7d633e696197a328",
      "en": "「Ho!\\nThis is quite an exciting turn!」"
    }
  },

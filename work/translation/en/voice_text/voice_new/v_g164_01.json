{
  "schema": 1,
  "rows": {
    "164:5621": {
      "repository_source_sha256": "f3853e76856d2a080655d2561deddbaeb2c4274daa79fc63f9ddec678de0dda4",
      "en": "「Every muscle in my body\\nacclaims you a mighty warrior!」"
    },
    "164:5676": {
      "repository_source_sha256": "b3a0f7bbbf9597320deca5043edc5bf89c0e7ff8760e577985d45db167a53b19",
      "en": "「A fine attack! I like you!」"
    },
    "164:5715": {
      "repository_source_sha256": "c5ad95d41906f5b8cf7d0dbed3c3645c1931b0dbf02da00ad9c478138b28d15b",
      "en": "「I, who raced across the galaxy,\\nmeet a foe like you on the frontier!」"
    },
    "164:5784": {
      "repository_source_sha256": "9c252a24ddf6258765828b8f178a821222a3b7e8a800fd39a04d542ec4a9e484",
      "en": "「I admit it!\\nEarth has blood-boiling battles!」"
    },
    "164:5843": {
      "repository_source_sha256": "708b0c20589128dc79d7ac0ed0c7dd19ec7c6ae118688a99a4635e41b718c85f",
      "en": "「I love you, Earth!\\nYou gave me the ultimate battle!」"
    },
    "164:5904": {
      "repository_source_sha256": "16124d7714afee562eba9fd0c259c5ca4d4e706007ee0d7fb13545a3bcab635d",
      "en": "「Turning it around from here is\\nwhat $$ハイアデス$$ does! I'm on fire!」"
    },
    "164:5961": {
      "repository_source_sha256": "f0b6f612449ad973e83788defeb39b1f3035a4d6b9b381e000f3d0abc3287901",
      "en": "「Damn! Fires are starting everywhere!」"
    },
    "164:6004": {
      "repository_source_sha256": "39dc9b725aa47163dd7de2b090757823575c2cdc3377f7d54364f6cf54282f44",
      "en": "「I can't lose, not while I'm the\\nSupreme Commander's right hand...!」"
    },
    "164:6055": {
      "repository_source_sha256": "c50ffa7dca33034c3ea0dde41957434d732ca1e860b8be57179733132a7f3fbc",
      "en": "「I can't lose, not while I'm\\nLady $$エルーナ$$'s right hand...!」"
    },
    "164:6110": {
      "repository_source_sha256": "b9a8703cd495337424fcbd21faf616f4b4410185b6506279029e739d9af4697d",
      "en": "「To think you'd corner this $$アルデバル$$\\nthis badly...!」"
    },
    "164:6161": {
      "repository_source_sha256": "044bebf58868aa61dfab051b067d4c45cd369f8ca83aebf217463118b34f2987",
      "en": "「From here begins the ultimate moment\\nfor me and $$バン・アルデバル$$!」"
    },
    "164:6214": {
      "repository_source_sha256": "11dde29a32a8514e11c789e77488d4a5495404a7be4f4b3ece600cb1d09a0527",
      "en": "「I'll give credit where it's due,\\n$$スフィア・リアクター$$.」"
    },
    "164:6265": {
      "repository_source_sha256": "1eb766da5a567dc6244f965990e26a20b88de2edbc85ddc58cab1eed2546c7f8",
      "en": "「You got me good, $$ランド・トラビス$$!」"
    },
    "164:6304": {
      "repository_source_sha256": "591fd7f84c6d8f2f1ada285ce103aee957307f0ca4246d679998ade542881349",
      "en": "「I can't lose!\\nI can't lose to you, of all people!」"
    },
    "164:6355": {
      "repository_source_sha256": "bc1a9359f28aba028bf28ded1afdc721eeb303312e8b646ab5606ee5145aca05",
      "en": "「What a blow!\\nTruly worthy of the name Super!」"
    },
    "164:6408": {
      "repository_source_sha256": "29b44c02c2208cec4b75b202ebe199d82c1eb43ddfc9df4b071635418aae7eaa",
      "en": "「Gundam! A name fit for the strong!」"
    },
    "164:6449": {
      "repository_source_sha256": "fabc85f84aa76fce2eed5aac2307aecb9a113dacd68a7820478f939dabeaf303",
      "en": "「Nngh! You overwhelm me with speed?!」"
    },
    "164:6490": {
      "repository_source_sha256": "ecd75c4dae3a42bb04283cb15308afd95c63868e441ac762bcf29c6375c84463",
      "en": "「Small, yet I can't take you lightly!」"
    },
    "164:5148": {
      "repository_source_sha256": "9ccb762e7951914f6e9b0771cf052c0294975ed83364709adfaa39ce7d88e563",
      "en": "「That's it! Burn your blood hotter!」"
    },
    "164:5187": {
      "repository_source_sha256": "317f0ab18979b6f0f20d23875cb852ea054f81812863f351ade81814ca6ed1a0",
      "en": "「Give it all! Put your soul into it!」"
    },
    "164:5218": {
      "repository_source_sha256": "b8d56b1fe2f3f39ba983939afc35125d9a161fdcc9f2b24022860489ac24d9f9",
      "en": "「Not enough to boil my blood yet!」"
    },
    "164:5261": {
      "repository_source_sha256": "367e5aeab1392848f7b155d8f3cfe8fda0dda03e93d17f85cdfacd6803b35181",
      "en": "「Good, you! Want to join $$ハイアデス$$?!」"
    },
    "164:5304": {
      "repository_source_sha256": "95e504a05dc2cd2e9481338924b9d06ede17ed28130b7f293f427be643e60dd2",
      "en": "「Very well! I name you my enemy!」"
    },
    "164:5345": {
      "repository_source_sha256": "d8ef0602fdebef672cf4eda4132dd25c2d0430b2aefec7fdf9b7e53da57f5286",
      "en": "「Not yet! Even this is not enough!」"
    },
    "164:5382": {
      "repository_source_sha256": "0252f2a930f397f0b641ce93becf8fcbee2d284ae9086cc1072994fb17763a1f",
      "en": "「Bit by bit,\\nmy gut is heating up...!」"
    },
    "164:5433": {
      "repository_source_sha256": "6e84fceea5c4d5d8625a95ecee5c49b732c7710cd8f03b47da9a4af4091101e9",
      "en": "「This pain raises me to my peak!」"
    },
    "164:5476": {
      "repository_source_sha256": "248d0bf87781dd579d6106cc30e912dfdbb9cc93a691e80c2e2585eb57a13769",
      "en": "「Our souls tremble, $$バン・アルデバル$$!」"
    },
    "164:5515": {
      "repository_source_sha256": "0f1ec09d78e1e8e2e72a032cec2466d04821f4568c21f821397f095615248256",
      "en": "「I see, $$バン・アルデバル$$!\\nYou're enjoying this too!」"
    },
    "164:4492": {
      "repository_source_sha256": "c698a182392dff3ebefac483fa697ded3fadd5c1fc49c55378ee9ce9267f21f5",
      "en": "「$$ランド・トラビス$$!\\nIs this as serious as you get?!」"
    },
    "164:4547": {
      "repository_source_sha256": "79e0e2f04345ece6759732a626552998231fe526f001d27067c44ccb25b7387e",
      "en": "「Don't make me laugh, $$スフィア・リアクター$$!」"
    },
    "164:4588": {
      "repository_source_sha256": "88d7b24efa0a8f60e9de30f841d6fce21dc503dcc00f74af7e05a2e8f9fd4b36",
      "en": "「The power of the $$スフィア$$ seems\\nto be tossing you around!」"
    },
    "164:4750": {
      "repository_source_sha256": "9ac4e9028b3fd6e0fdefe4ed762a6520f65b0ace93911b5a238c36a130dddb4c",
      "en": "「That tickles!」"
    },
    "164:4769": {
      "repository_source_sha256": "4ade03ac33758d02dac01f88f30c198ede29f61feacd3d704982f0714dddfe4a",
      "en": "「Far from enough to entertain me!」"
    },
    "164:4802": {
      "repository_source_sha256": "1e24fe27f6fd27f2a909ead5a5ca0c2ef1637064e46c5a5a4456d8fc2f4bc98c",
      "en": "「Is that all?! Laughable, small fry!」"
    },
    "164:4843": {
      "repository_source_sha256": "4c9102e69b9369c2006ddaed9bd60c98996436b6589efefdd1bd45cb10eb3d63",
      "en": "「You don't understand\\nthe essence of battle at all!」"
    },
    "164:4892": {
      "repository_source_sha256": "4a765da8de6b118155746adb448211f09fab20db3fb7202bdef3e9281822223c",
      "en": "「No need to test me! Give it all!」"
    },
    "164:4927": {
      "repository_source_sha256": "e66349e560922ca3b24a91f7c82d4884a094342c26b8f3b2834fa2470e1fd3c6",
      "en": "「Do you mean to insult\\nthis $$ダバラーン・タウ$$?!」"
    },
    "164:4976": {
      "repository_source_sha256": "34686aaea0c1d2b42bcd3976c6fb70a1c984ca24fe47423cba415ae087600dcf",
      "en": "「Like a feather brushing my cheek.」"
    },
    "164:5015": {
      "repository_source_sha256": "148e1a2efb68764b2394939e501c0db0d35448d755a3e61d5f640f1b08b3b73a",
      "en": "「I thought I'd enjoy this with you,\\nbut my eye has lost its edge.」"
    },
    "164:5078": {
      "repository_source_sha256": "f450edc76659d8ef39583340c3d35d6e2c4b388c7011408fc8d7842e80130043",
      "en": "「Don't underestimate $$アルデバル$$'s armor!」"
    },
    "164:5113": {
      "repository_source_sha256": "111cbaddb5d573a2a60e6c05d6c644e4e527309b0f2f34ffbc289740e14d5afa",
      "en": "「Oh! You managed to damage my ship!」"
    },
    "164:4140": {
      "repository_source_sha256": "3ea29c6a2b5557b8863b2a9df415587279c0721245aebc785a015efd33e734b8",
      "en": "「After all, resistance is futile.」"
    },
    "164:4163": {
      "repository_source_sha256": "be95127acf604e1a8b47e5edc5da386889f3037b13c4757007aea48c8659af70",
      "en": "「You're no match for $$ハイアデス$$.」"
    },
    "164:4204": {
      "repository_source_sha256": "5dcfec2d54b5157ed5b51ef6e506fe2cd6589c312bbcddba58660e1804c03210",
      "en": "「With that little power,\\nyou can't survive the fights ahead.」"
    },
    "164:4257": {
      "repository_source_sha256": "823061f6226a84933a284cd4bb4415a602c40a6988d3042345d379b1fcd54087",
      "en": "「Don't think ordinary tactics\\ncan hold their own against me!」"
    },
    "164:4312": {
      "repository_source_sha256": "2556a308f9d3bb19c08334fba06f4c785ab8c7517d353f42f036a18c9fb3f056",
      "en": "「Think cheap tricks will work on me?!」"
    },
    "164:4351": {
      "repository_source_sha256": "563ced46ec4386f59756791eeedf93663838de9761586b54bb5cc361c76ed91a",
      "en": "「Coming at me with just that\\nis utterly laughable!」"
    },
    "164:4400": {
      "repository_source_sha256": "e7f95a4d9328d199c55bed5c660ebf39f34205684a30fcb559a25f7b4999f22a",
      "en": "「The legend of the invincible\\n$$ハイアデス$$ lives on with this ship!」"
    },
    "164:4453": {
      "repository_source_sha256": "5d97489ae7456dbf4208c92640bb1c64a037dcee46f882fae6db95c18cd6f61e",
      "en": "「Man and ship as one, no blind spots!」"
    },
    "164:4637": {
      "repository_source_sha256": "b89acba37b0063fdb99b282c5b02c0787f3a9a945654258a61faaf441672621f",
      "en": "「What's wrong?! Is that your best?!」"
    },
    "164:4670": {
      "repository_source_sha256": "aadaa49755ae47f3dff676eae38dc7365c8bfd4dea7ea7fb39233161a292c777",
      "en": "「How feeble!」"
    },
    "164:4691": {
      "repository_source_sha256": "9985415fb1011e61d69ef9efd9797ff4120964f73f39a2588aa655dbec77e582",
      "en": "「Put your back into it!\\nOr you'll never break the field!」"
    },
    "164:3763": {
      "repository_source_sha256": "4b1223372db2cac62fc8148de06cab7b0d4b21e35d42e5a660214124abafacdb",
      "en": "「Not while I stand here and watch!」"
    },
    "164:3800": {
      "repository_source_sha256": "759c6607b3054bac1c2098cb8d444ff63ee92602db6a7d1d07f7a547b04b9292",
      "en": "「$$ダバラーン・タウ$$ will take it!」"
    },
    "164:3837": {
      "repository_source_sha256": "c1d8a364236a0ad2f93b4898319619d7393dde5fcc2ef8afb5730dfc3a4437f2",
      "en": "「No one touches the Commander!」"
    },
    "164:3874": {
      "repository_source_sha256": "d14dec5a489a2df5fdebf01d9ed2791816dfd34324199afd3ccf80615ad1efd8",
      "en": "「I'll protect Lady $$エルーナ$$!」"
    },
    "164:3907": {
      "repository_source_sha256": "4e07c12fff8b8246ba5716e79a884dcd8932c5d30f05a3702faf7546b460cbfc",
      "en": "「Bearing the name $$ハイアデス$$, no defeat!」"
    },
    "164:3950": {
      "repository_source_sha256": "148fe0cc32af54b78cc5f6c482ac7d8d5586d855c6a0c603686c8f4adb0cc5e8",
      "en": "「A blunder! I couldn't counter...!」"
    },
    "164:3985": {
      "repository_source_sha256": "19af6fe50230bbfb749faaf062cfc755174ac7f10f86169525b0d33a216081a3",
      "en": "「Nngh,\\nleft watching the foe walk away...!」"
    },
    "164:4038": {
      "repository_source_sha256": "d7f2f284f83f213ed1f39a1a15e78aa62383a7ba13151cdb5e97205d7b3ffcba",
      "en": "「To seal my attack,\\nyou must be a renowned tactician!」"
    },
    "164:4089": {
      "repository_source_sha256": "f3bceb8c465ba38a8d1dd4149cd24b2811b5653b099636ea1c8bd098341c38b6",
      "en": "「A disgrace! I've dragged the\\n$$ハイアデス$$ name through the mud!」"
    },
    "164:2648": {
      "repository_source_sha256": "0beac5a624e4c46ac3fb5168f316225164e8374e32d702219b7fc591e58f5d8f",
      "en": "「Land a direct hit!」"
    },
    "164:2665": {
      "repository_source_sha256": "f4da1c83889f6718b615dfcf7f8458c9db5f633f870b1d5982b6b2d59f820827",
      "en": "「I can read your moves...!」"
    },
    "164:2694": {
      "repository_source_sha256": "3513e57f4bcdb93b4adae9fb09983caf3139e3e67a0ba07388648f9e0318510c",
      "en": "「Main guns, fire!」"
    },
    "164:2715": {
      "repository_source_sha256": "681a5a4db85b8946f467ba0b16744f7699fd4e654b7bde7508f19c63f5ac78a0",
      "en": "「All guns, aim at the enemy!」"
    },
    "164:2736": {
      "repository_source_sha256": "48a83c96db682fcfce44d7078ba415ed5d0f83a8d7fa2cad195a1877f9e98068",
      "en": "「Concentrate fire on the front!」"
    },
    "164:2765": {
      "repository_source_sha256": "bbe2f81e03e1cfe6496b5529ff6e26b6630de792d8bb3c1a9250fdce7d781f7c",
      "en": "「Fire! Pour it on!」"
    },
    "164:2790": {
      "repository_source_sha256": "bd4f7bed528e3cfb455cecd6a014e28156021db6ce72c932ff02bada5fe4e4b0",
      "en": "「Photon Torpedoes, fire!」"
    },
    "164:2823": {
      "repository_source_sha256": "314e2e9b6d81c0170dc3876d9bf8f9c1582269df3062149a6c691dd80f955615",
      "en": "「Take these Photon Torpedoes!」"
    },
    "164:2846": {
      "repository_source_sha256": "89b657364793f8eba37b86c56e799e6350b22bf25d54ff26901c1a0614a8f828",
      "en": "「Torpedo warfare is my specialty!」"
    },
    "164:2873": {
      "repository_source_sha256": "5d8d470cc91ce8b7a56d8849bac0142f54840bcb9a80e3f0db5364b998904bdd",
      "en": "「Vanish into the light!」"
    },
    "164:2900": {
      "repository_source_sha256": "36342dd82d0c8e1bf6b20d3d1825451abf09f7e25194a33fe3145efec741abaa",
      "en": "「I'll slam in every torpedo I've got!」"
    },
    "164:2933": {
      "repository_source_sha256": "ba83d3e9be67d407221102c92174a8dcb515403ee46a2665152e8690e4fda010",
      "en": "「This is naval combat, galaxy style!」"
    },
    "164:2964": {
      "repository_source_sha256": "a0998976afd6da302e7b2c9b62d4c2c9dd05e0fe8a3470be9aff8c425ada5da2",
      "en": "「$$バン・アルデバル$$, commence bombardment!」"
    },
    "164:2997": {
      "repository_source_sha256": "0dd9261d3a3ff541e0d0d594b00527c7b83df239e6de74da958b912cd564a4b5",
      "en": "「Fire away, $$バン・アルデバル$$!」"
    },
    "164:3034": {
      "repository_source_sha256": "d9f7bdd1d0c0512ca0f63a17f4a0ffba3cd6bd4b1b53253f42c9c159d0b7bca2",
      "en": "「Charge! And all guns, volley fire!」"
    },
    "164:3071": {
      "repository_source_sha256": "0a2f8f6e29ee2deeee89cbd282fc7821ca11b5fad5bc71c57a6c78a0a992324f",
      "en": "「Charge up! All guns, roar your fill!」"
    },
    "164:3114": {
      "repository_source_sha256": "95df80d8fb3e60c2b1521254b4cafbfa706d4e1b7a3b154d222f5e155fa610a5",
      "en": "「Firepower contest? I won't lose!」"
    },
    "164:3147": {
      "repository_source_sha256": "2d1d9e9c68433ceb25f645b6fce599762a6784f23d0e682fb96132da3a2cb16e",
      "en": "「Each cannon shot is my very soul!」"
    },
    "164:3186": {
      "repository_source_sha256": "eec84ee3787a08624b6453652be3b1d4cabf6c40f4a78ad5a491c856eea22cae",
      "en": "「Crush them head-on with firepower!\\nThis is how a man fights!」"
    }
  },

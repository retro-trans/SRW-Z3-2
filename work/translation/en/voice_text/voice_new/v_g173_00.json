{
  "schema": 1,
  "rows": {
    "173:2809": {
      "repository_source_sha256": "d4ad429b6fda2b0136dc1e00445125453c1464890c2b0e6d2524dedb9fe102cf",
      "en": "「How arrogant, toying with\\nso many people's fates...!」"
    },
    "173:2858": {
      "repository_source_sha256": "646c0e5f736d8d0ec7c56217231edcbebb3106df19c2f765cb479413192eec44",
      "en": "「I absolutely loathe smug, prim\\nbastards.」"
    },
    "173:2911": {
      "repository_source_sha256": "670a551128906d169956da16ffd15597bccbd4118e6be1834325c81cc99614c2",
      "en": "「Shame on you,\\n$$レナード・テスタロッサ$$!」"
    },
    "173:2960": {
      "repository_source_sha256": "ad6774598d4f90914febd2b07bea2ddfc54eac8952777b9492ea68bf557c7b06",
      "en": "「You're not right in the head.」"
    },
    "173:2989": {
      "repository_source_sha256": "62c7006f4145d492d5a97c1c9fe59a1e1dff6d5e5811b3d65be220121724edc5",
      "en": "「I'm taking $$カナメ$$ back...!」"
    },
    "173:3370": {
      "repository_source_sha256": "8aeb6df476ea146f9284ed69cf3d4e70d702008760eaec88bf2f1213c6cd863b",
      "en": "「You're just $$シャア・アズナブル$$'s remnant.」"
    },
    "173:3411": {
      "repository_source_sha256": "e4a4ff9dcf6af95cb1fbcee55ef2fd5c4debcee652cb7327f8cf4caf5c41aefb",
      "en": "「Don't think about anything else.\\nFocus on intercepting...!」"
    },
    "173:3464": {
      "repository_source_sha256": "b46fea3992625a7ad40c1cbff396ba00e8b4f8f4f7744048391ecc1e778ec866",
      "en": "「What are they even fighting for...?」"
    },
    "173:3603": {
      "repository_source_sha256": "cfab413950baf23bf62761f2d8531228ab9b4a2551231bf099fda4861d59e359",
      "en": "「We resist their rule to the end...!」"
    },
    "173:3642": {
      "repository_source_sha256": "a5370a5c007590a2be76272c6b93fac586df155ed34f89e6e4b4bc676d83a71c",
      "en": "「Our fight is to give people back\\ntheir freedom and peace!」"
    },
    "173:3705": {
      "repository_source_sha256": "297c3046cbd5e8a0efe6ee62280964744c42560c68587545a9e9aed079d28ee4",
      "en": "「Know that what you're doing is\\nnothing but arrogance!」"
    },
    "173:3760": {
      "repository_source_sha256": "b54a4ed45ce9a3f49b72182fcbaac8627d5c8e5081068fd8fbbcadd09dc81edc",
      "en": "「I'll drag down that vile bastard\\nwho plays god!」"
    },
    "173:8996": {
      "repository_source_sha256": "9f1ab243ff5ecbac869f81035add680528126a48ae227191d5f6c07f337f3076",
      "en": "「They'll pay for their recklessness.」"
    },
    "173:9037": {
      "repository_source_sha256": "b78feacda209b4a5c14a78775ec23366ca7154203b46f4258989aac706dd843c",
      "en": "「We'll face them with all we have.」"
    },
    "173:9070": {
      "repository_source_sha256": "ae93149e6a2b5de98aeb6cf68298b06a83b113a88cc6b2b19933b3563fb36e34",
      "en": "「We'll clear enemy units ASAP.」"
    },
    "173:9109": {
      "repository_source_sha256": "760d0bc1048dfab8f1daa45d9d6df62d75552d81c28b4eff7219774ebde85d61",
      "en": "「I'm counting on every one of you.」"
    },
    "173:9136": {
      "repository_source_sha256": "04f4914466112a19bac325d44985a2a2696fcc6ab45b4da31b15c9a633a7ff3b",
      "en": "「We'll have to teach them\\nwho we are.」"
    },
    "173:9191": {
      "repository_source_sha256": "c52edd18e089b9549ef0c88d0cdc87f7c1ea8b57a67615faecc7233a4473455d",
      "en": "「Let them learn her power.」"
    },
    "173:9226": {
      "repository_source_sha256": "4cd381a46d80a25b147aca64f6a4032ad96348f6cccfab09ea3d0ef2b5caacd9",
      "en": "「We'll show them our will to fight\\nis still alive.」"
    },
    "173:9281": {
      "repository_source_sha256": "a2dcc19ac5776af57243a68f236b46a36f6c8431fd1a2ff5be8bb75190b40bfd",
      "en": "「Let's make them realize\\nour spirit isn't broken.」"
    },
    "173:9342": {
      "repository_source_sha256": "875eb5c7896ac48881ef44f3b56adb9bcc0d94c5ff03c4d232b1d990c9f2a592",
      "en": "「We can still fight, and so can she.」"
    },
    "173:9379": {
      "repository_source_sha256": "ba1c3a95a8749c43e912159e46fe4cfef6a04468e49af2fe803202a0c089df67",
      "en": "「I'll stop this no matter what...!」"
    },
    "173:9412": {
      "repository_source_sha256": "aa97b96d829137d854eaba95193c340907c9bc004af155425e416bd732a6d575",
      "en": "「We'll end it before transformation!」"
    },
    "173:9449": {
      "repository_source_sha256": "27485d62393b247fb837c16fd5d6b043b47ff427575fb8c2e0b5880c44db64cf",
      "en": "「We can't let $$ＴＡＲＴＡＲＯＳ$$\\nbe activated!」"
    },
    "173:9506": {
      "repository_source_sha256": "a2ec7394672c286d0b47fc7df7cacbcb134ba5a4b2fdc2fd4cb18d4d6cb66542",
      "en": "「Defeating $$アマルガム$$ is our mission...!」"
    },
    "173:9545": {
      "repository_source_sha256": "04fe114f96fc137f82112d2aa21d865438ca0f0253531761d863adbd6fe38569",
      "en": "「We'll crush his arrogant plan!」"
    },
    "173:9582": {
      "repository_source_sha256": "a8c59e51a0df5ef3b0b800d6c13d11eb4800cee071c4b2eec09f06f85de477ca",
      "en": "「For those who fell... we will win!」"
    },
    "173:9681": {
      "repository_source_sha256": "76ec41b402cb79380ed3e01cb9cbdbe27e57b0319f3f10f909f9687294df7493",
      "en": "「By any means necessary,\\nwe stop them here!」"
    },
    "173:9734": {
      "repository_source_sha256": "ea10522063781709e675e7e231d8b8bae019a4029b478db153f4e362d28c7fbd",
      "en": "「$$宇宙怪獣$$... nemesis of intelligent life...!」"
    },
    "173:9769": {
      "repository_source_sha256": "ec72cb88561217b54bc78425be5c9f984c3aade8cb57bafa94a2b854def2bb4a",
      "en": "「We'll hold the line till talks end!」"
    },
    "173:9808": {
      "repository_source_sha256": "e85ee509614721218d7f46acde84150b54050eafc46280638d8b41f6ef0a0809",
      "en": "「We just brush off falling sparks...!」"
    },
    "173:9847": {
      "repository_source_sha256": "34d1713347093fee08a6436b50c6f1157c782e8003528a6da7a1a70b4f9c2936",
      "en": "「We'll gather all the intel we can!」"
    },
    "173:9886": {
      "repository_source_sha256": "c085db4a07ea03ae65170f76129b29465341f430621ee2d4815e584dbe536d9d",
      "en": "「Disable their unit!」"
    },
    "173:9913": {
      "repository_source_sha256": "abd1735cb429987017319f52d6682e166dc4ad47d525a7dc0b3491f34cdfd6a2",
      "en": "「Attack, avoiding the cockpit...!」"
    },
    "173:9948": {
      "repository_source_sha256": "084be04bb655d06d9ebca7ef332b54cc9f6a8695d9be46c221e9d46805badf2f",
      "en": "「If you think a fight like this can\\nsave the world...!」"
    },
    "173:10003": {
      "repository_source_sha256": "b0aa883312ee6ec30adfc3bf38faa6762d4cfff697ba9bf5a515dfba87a44294",
      "en": "「You chose war as your means,\\nso they are our enemy!」"
    },
    "173:10060": {
      "repository_source_sha256": "da59d6591ac2809fa4eca861185b69f0d69f5b2b1765ed7fd56e862e34d7672f",
      "en": "「The infinite potential of AI,\\nshown in a form like this...」"
    },
    "173:10119": {
      "repository_source_sha256": "7b769f67f1134050a94718a5963731ff79e43e2998e4075d67d0ce21a307954e",
      "en": "「We'll swiftly eliminate an AI that\\nlost sight of its purpose...!」"
    },
    "173:10176": {
      "repository_source_sha256": "3e6f372e7c48d44baa65f90eb2830f7c69bed800c6d7056952c475cbe6dc77bf",
      "en": "「Set the enemy ship as the target!」"
    },
    "173:10203": {
      "repository_source_sha256": "d4a74c0bb68ee7693f7c0da1173efdf4f26fbfe2cc554530d5f900ad17bc9d3b",
      "en": "「Hit the ship, break their command!」"
    },
    "173:10240": {
      "repository_source_sha256": "0d0dfc5473e996e52df386c547c3ddeb9bc954776be6926d68ad156e9da71139",
      "en": "「Teach them who rules\\nthe seas!」"
    },
    "173:10291": {
      "repository_source_sha256": "c814f6d9c22eeb4c3c6419882f97ce06cc75c1396ad4c61e32be15b2bfa36f74",
      "en": "「A gang of thugs is no match\\nfor us, who are trained!」"
    },
    "173:10348": {
      "repository_source_sha256": "a4b7e6991171df54ee29ef0d0e1a0c14bee6ee9f775b44d78d366392ca84dee9",
      "en": "「We'll take down the pirate chief!」"
    },
    "173:10387": {
      "repository_source_sha256": "efdfb4b717d834a007f4c45d213a9f8a5400fbe97ebaf93fb9c83da160541d99",
      "en": "「Let's show them which of us is\\nthe Empress of this sea!」"
    },
    "173:10448": {
      "repository_source_sha256": "d27843867275dfc05f29b57c97cbebe6c1a982f7f2e4091fffaca316876be4a9",
      "en": "「Our role is to make him\\na naked king...!」"
    },
    "173:10503": {
      "repository_source_sha256": "f8fccedbe79e738da50fc53a4562702caae1d847724d3412a258e0463155ffb4",
      "en": "「We'll fight him his way and\\nhand him defeat...!」"
    },
    "173:10558": {
      "repository_source_sha256": "c26b1edc75f66ba84e77cda9bf25d1c2c2c6637beae8423b06992283954a127b",
      "en": "「W-we must not let those people\\nget near us!」"
    },
    "173:10613": {
      "repository_source_sha256": "ce3ad90a5227a83b51b48fc9265e8d8539b191e080caf89d6bebcbe70bc2de32",
      "en": "「We can never allow them to\\ncall us by that name!」"
    },
    "173:10672": {
      "repository_source_sha256": "49318b6dcd5e36a787609ea1949181836252720a06b81589d9773939b109c4d0",
      "en": "「Target: $$サイデリアル$$...!」"
    },
    "173:10703": {
      "repository_source_sha256": "1bfa307b116d112c1250fb64fd1190c4727ff024b8674991fd2cedcf0b0a75a5",
      "en": "「We'll show $$サイデリアル$$ our\\nwill to resist!」"
    },
    "173:10754": {
      "repository_source_sha256": "6e43c9955ef5264cd5cee56be0b00180b6a80a898b2495f05f4ccb60ef77c315",
      "en": "「If you want to play ruler,\\nbreak us first.」"
    },
    "173:10809": {
      "repository_source_sha256": "318ba6a15137ad2b0442258b7ef118ec43d0cd27ca3d9f005044e6da1e0484b6",
      "en": "「Our opponent is a Reactor...!\\nStay very alert!」"
    },
    "173:10858": {
      "repository_source_sha256": "7a07742d118c7ace67a10295b67844c4ceef9e95beb09c394d9b659f2825e6eb",
      "en": "「If an Empire executive has come to\\nthe field, that suits us!」"
    },
    "173:10923": {
      "repository_source_sha256": "dcfdc2afab0f70b6b8dd22d733d73d315c2c29f07b4a31dcbbfb01abf41aaeea",
      "en": "「That's the Empire's flagship...!\\nA worthy opponent!」"
    },
    "173:10986": {
      "repository_source_sha256": "0955f3bd3956ebd50875855e51f6a29c8925880885962202767ea634f66d5c2f",
      "en": "「This is a battle between warships!\\nWe must not retreat!」"
    },
    "173:11037": {
      "repository_source_sha256": "801c1c4c8c5e53cde60fd14c52dae49cce2a6817886f15e55fdd353e5ccb61da",
      "en": "「They are the ultimate enemy\\nof our humanity...!」"
    },
    "173:11090": {
      "repository_source_sha256": "d8947679f54a0b9521dbc8558d3d4a6397227fcb9787e8a1a3904b07450d1517",
      "en": "「We'll show them the power\\nhumans possess...!」"
    },
    "173:11141": {
      "repository_source_sha256": "5245b8eaadcd31139e0c001d6f02f386969edeb6ea1623840bd3387de0fee31f",
      "en": "「We'll make him pay for lying to us!」"
    },
    "173:11180": {
      "repository_source_sha256": "73aee90d88eee5ec27ba590ab87c793adce002cd0ffd3534a5d214413e57e5d2",
      "en": "「We'll make them realize just how\\ndespicable they are...!」"
    },
    "173:11255": {
      "repository_source_sha256": "c881ce9df63bb0ad91ae7f196d5d674c67151cfa38502a3fb33ab845e09a3f4a",
      "en": "「My subordinates can't possibly lose\\nto those insufferable people...!」"
    },
    "173:11326": {
      "repository_source_sha256": "bcd8222c94ae9bfef721ff36ae92942ec51b557493660a6551a7bf7e1ed032b4",
      "en": "「Even if they're immortal, we can at\\nleast stop them in their tracks!」"
    },
    "173:11393": {
      "repository_source_sha256": "e84808675e512355160d26a133e4a2794d21f0087858386d576b1330be9e954b",
      "en": "「There's no need at all to consider\\nhis circumstances!」"
    },
    "173:11442": {
      "repository_source_sha256": "d2142913b71295353ad0ac7962355a400dbed4f9a1c63265beab4e6e324ccf0c",
      "en": "「$$アドヴェント#pilot$$!\\nWe'll stop your ambition!」"
    },
    "173:11497": {
      "repository_source_sha256": "3ed3d6f691efe9c404e1694f6cab2bd5545bd3536b18777bf2550cc20a1cc9d1",
      "en": "「Nothing can stand against us, who\\nhave overcome so many hardships!」"
    },
    "173:11554": {
      "repository_source_sha256": "dd25c40a5d0e72ace00868470fd577d47b6f98a02bea88c47c6f37c2121d26ee",
      "en": "「Everyone, let's win and go home!\\nBack to our Earth!」"
    },
    "173:11607": {
      "repository_source_sha256": "b0da063eb81a7173a924d41219253cbbe9d0947abfd6edfe148ee8aec45d1a67",
      "en": "「Do you think you can escape?」"
    },
    "173:11638": {
      "repository_source_sha256": "b0c11c76ee03ff0432bf8aa6128ab11e6f2350fb7fc3968f8a67ed41990f40e1",
      "en": "「We'll pin them down there!」"
    },
    "173:11667": {
      "repository_source_sha256": "e9307211bbbfa81a1e64fddd34daef93a138dccd4bc9fefc42ad490ce1d122bc",
      "en": "「Never knowing you were lured out...!」"
    },
    "173:11700": {
      "repository_source_sha256": "6a4567ff5c2451f2a33b01a6d2a4b04582b83ffb3715e0474463b38e91bc339e",
      "en": "「I'll make you regret laying\\na hand on us!」"
    },
    "173:11753": {
      "repository_source_sha256": "40560db22d0d49e8dd31713e43cc62bfa7c74758ff86179ad780619a7ffd2e43",
      "en": "「We'll follow our ally!」"
    },
    "173:11776": {
      "repository_source_sha256": "25faa9f2b45271f74aea8da94df6c419100d094aa579d2c472a8cb98c5c72e8c",
      "en": "「The enemy's off balance! Our chance!」"
    },
    "173:11813": {
      "repository_source_sha256": "e10d1ad566a60e03bc10522e0eed6ceeaaa3de2c5bc6903f7b4c2292c23aa3c1",
      "en": "「Follow the allied ship and attack!」"
    },
    "173:9625": {
      "repository_source_sha256": "7e49b85dec35538685859b30ff34428da4f2cc629cff1cc815a5b142434020b6",
      "en": "「Hurry with the next round!」"
    },
    "173:9650": {
      "repository_source_sha256": "1d2d3a495117cfffcee6b4ae2f4cdf975f00ec723eed5e9d64494f610840d576",
      "en": "「Attack again before they get away!」"
    },
    "173:12514": {
      "repository_source_sha256": "e28316057c429b12d8742f3b9967b34ca132896b772593cd69f748acd70a6889",
      "en": "「Respond as quickly as possible!」"
    },
    "173:12541": {
      "repository_source_sha256": "25b50bbb82373289c7a98719f0df1bf9c41b11c4f83efdeeb1ab18b64a940436",
      "en": "「Hold out no matter what\\nuntil we strike back!」"
    },
    "173:12596": {
      "repository_source_sha256": "aaa97ed6e99478f7f9665057409645a6327e9e0acae17e65be94eb53cbde0337",
      "en": "「The real fight starts when cornered!\\nAll hands, steel yourselves!」"
    },
    "173:12405": {
      "repository_source_sha256": "41f1d6357754a7bb10f3a70ff3bec8c80c1f7a6956356b806ba64fde7c5ab2b4",
      "en": "「This is... humiliating...!」"
    },
    "173:12430": {
      "repository_source_sha256": "54e5ab1a667a5ff2727bf7ed5404290b7017454bb68fb454d05902dbe0b4c626",
      "en": "「Hurt my daughter? I won't allow it!」"
    },
    "173:12473": {
      "repository_source_sha256": "cd3dec01868d67684bfe10ca8460b77432d344b827d7dbe8bb25f6c351fbde83",
      "en": "「Send the repair crew to the damage!」"
    }

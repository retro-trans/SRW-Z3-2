      "en": "「Maintaining current speed.」"
    },
    "173:12112": {
      "repository_source_sha256": "62277e6d8b422e89644963626297ac01ab1291581fb1d2b376b2dc95af82140d",
      "en": "「Preconceptions won't work on her.」"
    },
    "173:12147": {
      "repository_source_sha256": "a7a3cd9753fb9c46f51133b04019a12c3c2fcbeed7a761503bbf6198529b2e80",
      "en": "「So they underestimated her and me...\\nThat's what it comes down to.」"
    },
    "173:12208": {
      "repository_source_sha256": "1d7fa671b41ab8cf1b794ffd9c247d24d1e30e746167d22e418e2dc02d00db31",
      "en": "「You seem to enjoy pointless efforts.」"
    },
    "173:12239": {
      "repository_source_sha256": "79b17299246c0a49168049044b546cb133200cfac0672bf035d0ef098cc0e214",
      "en": "「This is the result of underestimating our gear.」"
    },
    "173:2244": {
      "repository_source_sha256": "245210451a0e32299b2a49c5de6b7ac4c86f6dbfd53cd2f19ea30dfc2af809c5",
      "en": "「Human nature can't be changed...! He's strong and kind!」"
    },
    "173:8466": {
      "repository_source_sha256": "37dec22d250dc8baac92a7e6bc5ff47c1a97191857a345985302ef19c17a9901",
      "en": "「You've grown strong...」"
    },
    "173:12653": {
      "repository_source_sha256": "89934f73a172ef1719302afa1c97f8229666a997c6fdb3f5a3f70c2c482a0663",
      "en": "「Mmm... where are we~? Oh, $$相良$$!」"
    },
    "173:12708": {
      "repository_source_sha256": "86672a42c98f657ae11fee2dab28cf49a18d155929cf5b691b52849504d0e9c7",
      "en": "「Forget the game~. Call me $$テッサ$$ like last time~!」"
    },
    "173:12799": {
      "repository_source_sha256": "91c9a4e063374c79089ea6b72aee0a507962b54ae2f7ed8fe3e046c691223917",
      "en": "「I'll do anything for you...」"
    },
    "173:12832": {
      "repository_source_sha256": "770ac22eea7cdceaa5b7d96d37252ba535dde4f5326abc2438d9dd49980b5aba",
      "en": "「The doctor~?」"
    },
    "173:12845": {
      "repository_source_sha256": "6b272eea529501834f90a41f47cbd8f05b45d5d74c0876e9d75980f80af6142b",
      "en": "「Ah! N-no, I didn't mean it that way! I was just half asleep...!」"
    },
    "173:12926": {
      "repository_source_sha256": "aae142c979e6256f814fe80baad441faf9edd903f4f094b0ba1dcf6610e13e12",
      "en": "「Don't tell the others! Please! I'm sorry! I'm sorry! So sorry~!」"
    },
    "173:4265": {
      "repository_source_sha256": "8d04f9825d95f07059ab290836829f4b739c9e930c389c2a428572d447e7712a",
      "en": "「I told you to 'survive'.」"
    },
    "173:11842": {
      "repository_source_sha256": "dc0511a094274695be68ce687e527b158e895dc87e06638ad1ae459e172dc26b",
      "en": "「Pull our allies back!」"
    },
    "173:11869": {
      "repository_source_sha256": "8d51c034a6709ba105925093ce94cd0545fb164ac4e5728dd56bd4262ba2a5b7",
      "en": "「Don't let our allies be taken out!」"
    },
    "173:11902": {
      "repository_source_sha256": "6cfae3e058235331963da6fdca719209219417540ebfa62bc90239eb2dcc266a",
      "en": "「That's an order. You must survive!」"
    },
    "173:11937": {
      "repository_source_sha256": "70d205902e527565c4dc2562b63fec2426bac96045ee746ae708b3d674e26433",
      "en": "「I won't let an allied ship fall!」"
    },
    "173:11980": {
      "repository_source_sha256": "f1899a48af4d62d9afe94d5cedf3f86710752532d6efba69ea84f237bafd1761",
      "en": "「Unable to attack... humiliating...!」"
    },
    "173:12019": {
      "repository_source_sha256": "af5f4baee7cc57bdca29d83ddb761eb205b68a572b0a0ac4ce5b39a3fe22d057",
      "en": "「All I can do is watch them leave...!」"
    },
    "173:12056": {
      "repository_source_sha256": "2cda096de0db5cd0b48a1539fb5510700319b2640b87034cbe5c6f4541ff5234",
      "en": "「To think I was outsmarted...」"
    },
    "173:789": {
      "repository_source_sha256": "cf43465ba1f6ee0549bccd720eb8a9bc8a37c3698f41cdf221c6d0dd9eaf1e50",
      "en": "「Open the torpedo tube doors.\\nDisengage all safeties.」"
    },

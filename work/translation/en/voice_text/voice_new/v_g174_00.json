{
  "schema": 1,
  "rows": {
    "174:2941": {
      "repository_source_sha256": "668f2d26af36779b1a99a8491c4df4143e1a73c0b2a4c9e2c5e58e54847244d9",
      "en": "「Well then...!\\nTime to make my move...!」"
    },
    "174:2990": {
      "repository_source_sha256": "310fbd300017f9bec7c06ded5512a56b16600075b5d81ea328126050da5cb6a8",
      "en": "「Good timing...! Here I go!」"
    },
    "174:3025": {
      "repository_source_sha256": "cedd0d2bf3415e01bd875ca53ef4f3f7df193ef0035b0223a771bb38a26c1929",
      "en": "「Whoa! Can't pass up that opening!」"
    },
    "174:3060": {
      "repository_source_sha256": "3dc8df12305268515fbfc4bb168e675f1466a965498f08e7ff6bec9fd70415f3",
      "en": "「All set...! Okay, here I go!」"
    },
    "174:3097": {
      "repository_source_sha256": "07eb2e77d9ddda8fae9600712973aad894740a5bc6e6c7f91a41e2a05897bb19",
      "en": "「Time for Death to get serious...!」"
    },
    "174:3998": {
      "repository_source_sha256": "120a2c65d9aaef58e2595a4a38054a2191b6d1ed73aa0ff8dd7a4969b9af5b12",
      "en": "「In a situation like this,\\nyou're clearly the bad guy, right?」"
    },
    "174:4049": {
      "repository_source_sha256": "5651b3d3029c4be70a9770150eb2e47e02a3f9aaf4debb7da07564a543cadffb",
      "en": "「Who the hell is this thing?!」"
    },
    "174:4080": {
      "repository_source_sha256": "2645a10c20187a8236621c2a994e78288f33593f060922285a4f7167d58527ea",
      "en": "「Damn! More and more keep coming...!」"
    },
    "174:4121": {
      "repository_source_sha256": "7179652d20468a5b94987daf477913dacd9b0abf0fa1f91935b7197151c2de61",
      "en": "「I can't lose to some calamity!」"
    },
    "174:4160": {
      "repository_source_sha256": "eb6ad40b17c578b5f1150cc635f6ea3fdd8821d3850a57953f90b0980261693d",
      "en": "「For the colonies' sake,\\nI can't let you through!」"
    },
    "174:4211": {
      "repository_source_sha256": "4492c1f4e3e8e6f709bfd57f66740dcc6fcab5382a5c45689e7ef3327a57b119",
      "en": "「No way $$宇宙怪獣$$ get their way!」"
    },
    "174:4250": {
      "repository_source_sha256": "06bfe68a59bc37c3792ea795b9cf21fad79a664fcfad843e8cecf46ee3bed684",
      "en": "「Sorry, but I can't go easy either!」"
    },
    "174:4291": {
      "repository_source_sha256": "58b4e5898b2fe5da436e1b903799fa92706c45846a67827e25ea94c19bf19b59",
      "en": "「Looks like I'll have to aim\\naround the cockpit!」"
    },
    "174:4340": {
      "repository_source_sha256": "714560a2a9c73b22464f91cd7796a0e34346f9a016837ed80fd945faa24b97ad",
      "en": "「It's always the quiet ones\\nwho do the flashy stuff...!」"
    },
    "174:4395": {
      "repository_source_sha256": "da4095c23e41247c19d6ad1768b905ee4874d489a3107ae5fdb4f317ca12ad0a",
      "en": "「Tch! Unbelievably single-minded!」"
    },
    "174:4428": {
      "repository_source_sha256": "c8074b8192eb6f56f7390f1b3a01e87d9b7f14ce4ddf5ab29ff19afc58d95924",
      "en": "「A new model? Now I'm excited!」"
    },
    "174:4467": {
      "repository_source_sha256": "45ccf2fc060147fc5c235beb1707bb983ee71d86107435085408346b67b2a59c",
      "en": "「Show me what that new model can do!」"
    },
    "174:4502": {
      "repository_source_sha256": "c6e052174ca9a6d4d3572e5a906ef9e319a5264cf7f6dc69b5f687b5b9d42aa4",
      "en": "「You guys! You still want war?!」"
    },
    "174:4543": {
      "repository_source_sha256": "3d86fe7fae5935d7aba2714b42e8ad17870a010598d690ce6674c87a824b4de3",
      "en": "「Is this the time to argue\\ncolony this, Earth that?!」"
    },
    "174:4592": {
      "repository_source_sha256": "62e8a3a0ad41ce6c85b1b7cd40b5681dfc1ab785785025022086fca8ad47e214",
      "en": "「Let's see what the ace can do!」"
    },
    "174:4629": {
      "repository_source_sha256": "2013c9f184226da362325dfde917ea21312a7f57dbf65e18f2ea94bc2452e6e4",
      "en": "「Gotta take out the commander first!」"
    },
    "174:4668": {
      "repository_source_sha256": "992f481763b99009f29cd1cc3743120fb5990877518bb33e8e27fd59f508f198",
      "en": "「Quick way: target the battleship!」"
    },
    "174:4705": {
      "repository_source_sha256": "08caf962d7080ed691481a490786aa6bec04b88bce11a765f3cedbe5bf9596f4",
      "en": "「Gotta drop 'em before they go ping!」"
    },
    "174:4742": {
      "repository_source_sha256": "39cc518d7cf0b56758c98353366bb4b531a4d089c03ad0b352ef3a134797c377",
      "en": "「No time to pity their situation...!」"
    },
    "174:4781": {
      "repository_source_sha256": "a82d7b9d1ed4e6c06cf439e95c87a9487e887371a59ed60ede860f60b5f52b82",
      "en": "「Let's have a Gundam showdown!」"
    },
    "174:4810": {
      "repository_source_sha256": "5d79ce7a565953ef6ec10df6b0d7ac6df4f7f40bc84f1e98abc4298db7be0db2",
      "en": "「My opponent's a Gundam too!\\nI can't lose!」"
    },
    "174:4859": {
      "repository_source_sha256": "fa18bd6ddd9d16e7129c1a3182ce894e7517a879819708db92f3aed824ae405e",
      "en": "「I'll hold out till dialogue's done!」"
    },
    "174:4898": {
      "repository_source_sha256": "e964acce7a7ed2bf70aac4b5e2d99291dc56fa1d889ba27a4d50ceb3c874e238",
      "en": "「Hurry up and wrap it up, $$刹那$$!」"
    },
    "174:4935": {
      "repository_source_sha256": "c19b35754d3e6b723679f5d082162acb78afdabe5872c74286ad1a451d88b294",
      "en": "「I'm gonna stop you,\\n$$フル・フロンタル$$!」"
    },
    "174:4988": {
      "repository_source_sha256": "e63a2c35d5e945eff3b0e70d158d1b12999f86606859961adb768d9bd501d762",
      "en": "「Death'll take on the $$赤い彗星$$!」"
    },
    "174:5025": {
      "repository_source_sha256": "717b1ff96ad4c3c080a15042dd412f7f2a4f07a823211f95d66ff87271139f8f",
      "en": "「Hysterics are unsightly,\\n$$ハマーン・カーン$$!」"
    },
    "174:5080": {
      "repository_source_sha256": "9cc2f0b72befdb593e5fbd07c9a12e7bc25b60aede7567da619bf50b1ec37c18",
      "en": "「I'm not losing\\nto some machine!」"
    },
    "174:5131": {
      "repository_source_sha256": "cb5e18a8efc91f0acf0a8f017e86816783ed2ae57d3076777f631739148b448b",
      "en": "「Broken machine can't control humans!」"
    },
    "174:5172": {
      "repository_source_sha256": "698a3c8fe81bd63ca32d41559249e0cc4f18c3fc1a5c2ee9cdcc19b3adf609c5",
      "en": "「Guess I have to settle things\\nwith you after all...!」"
    },
    "174:5233": {
      "repository_source_sha256": "948b29e262760152d9a80df1a7bedc24ce423f73128cb9b87466a04b6665376f",
      "en": "「The hero of mass murder, huh...!」"
    },
    "174:5276": {
      "repository_source_sha256": "ef4a53507c903768d1e0bcec8c3336b642f9bfcf5f81afe83ce88504c60bc6fe",
      "en": "「Invaders get pounded, period!」"
    },
    "174:5309": {
      "repository_source_sha256": "438829347f09f7f56f8a4c7cf954de5dab0e832b62d1f998423d798234abb30f",
      "en": "「I'll take you on, $$サイデリアル$$!」"
    },
    "174:5346": {
      "repository_source_sha256": "b988cac9fe416021cd66785ef771f87a8933b848d9abc27aa3d37bde4e1f17a3",
      "en": "「Get back to your own star, now!」"
    },
    "174:5379": {
      "repository_source_sha256": "ec9884909fa35b05b1a425bde2a170a99e8b3ba6c0eda45dd79077cc383011b0",
      "en": "「I know how to handle\\nReactors well enough!」"
    },
    "174:5434": {
      "repository_source_sha256": "6bc9c6a5f6d19d5bb0d96bda784c4adedabcf1c35477873ff2e23a9165a028bc",
      "en": "「End it before that nasty power hits!」"
    },
    "174:5473": {
      "repository_source_sha256": "b06b16d3870898112135d0eff5c89bbbc6e7bbfa4d8241cd6987fb551b3ac6d8",
      "en": "「It's all in how you use a $$スフィア$$...!」"
    },
    "174:5512": {
      "repository_source_sha256": "4cd23ff2d7f6a8b3fd7911e6042e255afe70965c6a825f963e3db7960d60360a",
      "en": "「If you're God's emissaries,\\nI'm Death, here to hunt them!」"
    },
    "174:5569": {
      "repository_source_sha256": "b0f664f0f072ad40d8468e115c393a978a80e994da4815c21125d66816c06f97",
      "en": "「You people are nothing like\\nthe god I know...!」"
    },
    "174:5622": {
      "repository_source_sha256": "99b974dae1d884bf3da1d14ee303b9300d52dd6251489c5d0fd4b6d7a8459fda",
      "en": "「If you play God's emissaries,\\ntry to be a bit more likable!」"
    },
    "174:5691": {
      "repository_source_sha256": "ca0ead5200a04680a1a6023d65770ca07fe79a04279de9453a79ad7257541b31",
      "en": "「That refreshing smirk\\nfooled me completely!」"
    },
    "174:5746": {
      "repository_source_sha256": "185687bee96187405421d654eee3ce5a392a55ca228896272dec11c430ba8274",
      "en": "「I'll trust the silent type\\nover a weirdly squeaky-clean guy!」"
    },
    "174:5803": {
      "repository_source_sha256": "c0cd9702a4f1bb704226419020f5181e0ae68cb3f556f9ac9fb35e1790c2094f",
      "en": "「Don't think you can look down\\non humanity from up there forever!」"
    },
    "174:5858": {
      "repository_source_sha256": "f40eea977149d717bb31b49abe6a8a9e5fe3c7ac573f194edd6bb6c49ff0f6f0",
      "en": "「I'll rip the mask off the god\\nyou all believe in!」"
    },
    "174:5911": {
      "repository_source_sha256": "4100a92071ee3f6e07f5527d355fec7a4f46635dcfeb27cccd8174e2a3f28efc",
      "en": "「I'll have to ask you to stop\\nmessing with us!」"
    },
    "174:5960": {
      "repository_source_sha256": "ebefba2066526fdf3e90612d6fb7a67f4b4baf17607dc80c2f9a44e06366d85e",
      "en": "「Time we settled this, $$アサキム$$!」"
    },
    "174:5999": {
      "repository_source_sha256": "a879bba6268d8b4b8f4fae02c28bf4f827c221b04d631e7b6a48d7709af2b851",
      "en": "「$$アドヴェント#pilot$$!\\nI won't let you have your way!」"
    },
    "174:6052": {
      "repository_source_sha256": "beda829abad1eb854aba087150aae002d6e4aebb74a0a2ae3d4c0a706fe88b7f",
      "en": "「We'll take you down and\\nreturn to where we belong!」"
    },
    "174:6109": {
      "repository_source_sha256": "0b35302b6237356b1e3d8d485207e84e7bd399eb3f90fd354d3d7f50eac993bf",
      "en": "「Last one...! Let's do it, partner!」"
    },
    "174:6395": {
      "repository_source_sha256": "cdcf791311e57b55b86680400c1348b5d786f2c42107a0f72c2483ecfc29347c",
      "en": "「Hey, hold on a second!」"
    },
    "174:6422": {
      "repository_source_sha256": "f420cb6053046c34c91f390ec427211b3d48105e864d84b453ed7162b7200993",
      "en": "「We've got a present for you too!」"
    },
    "174:6463": {
      "repository_source_sha256": "be16d324dbb174c9a1c1490e828451d09d10c934245e06c7a3a654f60939d8ac",
      "en": "「Thanks for earlier! My turn now!」"
    },
    "174:6506": {
      "repository_source_sha256": "0f9f58ca3bca56f1561f629e42259e9f65f4ec0fc72c13b768ce56ba7bd7964b",
      "en": "「Time to return the favor!」"
    },
    "174:6539": {
      "repository_source_sha256": "b9cca52003aee516f01c948392d60fe90c45a052e0e2d491c7e5de0dc3350792",
      "en": "「This one-sided deal doesn't pay!」"
    },
    "174:6580": {
      "repository_source_sha256": "6779bb17a18b271cac49605b58b22664f699ab4484fe782277387cb26fe7fdbd",
      "en": "「Hold it!\\nI've still got business with you!」"
    },
    "174:6633": {
      "repository_source_sha256": "fbc431a2bc2f789b263337f30e0e381ca4b2d5c2f6dff17f9d2b5f623bd3b9ae",
      "en": "「OK! I'll handle the rest!」"
    },
    "174:6666": {
      "repository_source_sha256": "aa39d2dc6448b8e42037b42644799fc9078a050b52c91c74581c90802fc750b5",
      "en": "「Time for some teamwork!」"
    },
    "174:6695": {
      "repository_source_sha256": "d871489e0f0a937b6dfa3c61e424aba06135e12e3301ceefbff18b997e2bd1c0",
      "en": "「Nice one, $$ヒイロ$$!」"
    },
    "174:6718": {
      "repository_source_sha256": "1235123793e146c55a688ed252b8760801ffdc0df888acd0f29327ab61d16091",
      "en": "「$$トロワ$$, leave the rest to me!」"
    },
    "174:6747": {
      "repository_source_sha256": "c04841657a65a4ca0424a0fde28f877e8aeb88c87ade954c2eb4c2989a2acf4c",
      "en": "「Well done, $$カトル$$!」"
    },
    "174:6772": {
      "repository_source_sha256": "702b2053a65fb602333424057144008dbdb4a19f260e5c4632f97053f559826c",
      "en": "「I've got your back, $$五飛$$!」"
    },
    "174:6799": {
      "repository_source_sha256": "ab5112dc4d967c632eef858956d475789dcc2cc5a7633b2f0455437ea41cb127",
      "en": "「You're fired up, $$ヒルデ$$!」"
    },
    "174:6828": {
      "repository_source_sha256": "70b5ab7c7f79347ae78ad8638256c6d74c3cab296427193fb4ccf60f72fb26c3",
      "en": "「Not bad there, $$ゼクス$$!」"
    },
    "174:6863": {
      "repository_source_sha256": "27c35296314fb68498b7c3ae0e5e6f635003370c0a15d8705a5d4e6d161ccc73",
      "en": "「I'll lend a hand, $$ノイン$$!」"
    },
    "174:6886": {
      "repository_source_sha256": "fdea30854205d7468cdc4d6bce504640aa84d537e32feb458d051a5c0727913f",
      "en": "「Let's follow after the $$ガンダム$$!」"
    },
    "174:6917": {
      "repository_source_sha256": "d93bffeeb14efefca734d48660693b92c633f95340f101647a77b776a9222e7f",
      "en": "「I'll help, $$ロックオン$$!」"
    },
    "174:6944": {
      "repository_source_sha256": "0f3ba71b8877c4b70e68f82b235e3c2ea185628b8a00c0eb39c904c163903b5b",
      "en": "「You owe me for this one, $$クロウ$$!」"
    },
    "174:3924": {
      "repository_source_sha256": "501028b5ae590c3260637f736344850ebb4af2f9a74cdcd461c168e7f41f6144",
      "en": "「Gotta make the most of a chance!」"
    },
    "174:3963": {
      "repository_source_sha256": "5631e7b25c7dd654bbe1e4d43f6885829550a9b712744ccddb841d6fb558f140",
      "en": "「Leave an opening, get hit again!」"
    },
    "174:7499": {
      "repository_source_sha256": "8ef733374a4525616481b028ff935a16fc0b644cab4e06c866224f9663aca01c",
      "en": "「No hard feelings if it is all gone!」"
    },
    "174:7538": {
      "repository_source_sha256": "b3bf843ca63efe592cb9c5f8778f7614b16ac27ded9ef6fa30cc92b323189aa2",
      "en": "「How about first come, first served?」"
    },
    "174:7569": {
      "repository_source_sha256": "356d261e5e8028b2bc589b24393ceb3a028eec2cf11faba07b6b47fa7b99de43",
      "en": "「Sneak attacks are my specialty!」"
    },
    "174:7596": {
      "repository_source_sha256": "d1f2946f893f76343c30bef33a20a0ad648bba21a64b7395e08bdbcd913d52f9",
      "en": "「You're a real slave driver...!」"
    },
    "174:7373": {
      "repository_source_sha256": "390ec7864e5546decd1e78a59c069f408b2728370187b14e265db2eb94092d2d",
      "en": "「Yeah, yeah, divide and conquer!」"
    },
    "174:7400": {
      "repository_source_sha256": "0192c7e585b56955012b76c0a106f76e017255f52be244fc4b18dd4a326a5eaa",
      "en": "「Then that side's all yours!」"
    },
    "174:7431": {
      "repository_source_sha256": "354282912b11f9009ac6bdb4af438c577105eadd348161a8a3e7dc9271fb3a0b",
      "en": "「Guess I'll do as I like!」"
    }
  },

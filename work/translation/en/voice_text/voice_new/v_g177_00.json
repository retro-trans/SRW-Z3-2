{
  "schema": 1,
  "rows": {
    "177:0": {
      "repository_source_sha256": "830c6a8c35c22b1e0a16262d552ddb4b9b8d6fc6e3aa9e275e1ac6c3ce42a916",
      "en": "「I deliver judgment...!」"
    },
    "177:21": {
      "repository_source_sha256": "a9f75216ee86a6b8928dcc9367c70230b6c17b44b7c14e1fddb0ea66c4b15411",
      "en": "「Listen well to my words...!」"
    },
    "177:58": {
      "repository_source_sha256": "8cbdf9d969cabc00bfa9b9e875bc0d81f052701d8e34749e7ab1b57f490420fb",
      "en": "「Insolent Earthlings, repent...!」"
    },
    "177:95": {
      "repository_source_sha256": "873bc2c1be20a02adaf129037f014b0af23ccaeb41c55c1f0806f4a3a825c44b",
      "en": "「I am $$ドクトリン$$.\\nI declare your fate...!」"
    },
    "177:146": {
      "repository_source_sha256": "e2722ddb52ebde3d4a102aedd81687b2cf0dceb4b39805786c10ad579f308837",
      "en": "「You sinners entered the sanctum...!」"
    },
    "177:187": {
      "repository_source_sha256": "7e83062039572c78f224d65b3ec8c59bd84a03bc1d81d8031a7dc15e64459e78",
      "en": "「Know your sin, Earthlings...!」"
    },
    "177:218": {
      "repository_source_sha256": "0808a4d6ac70f39ea0c31a774d2342fd06315e4255a636de314962aed7fe9287",
      "en": "「Immature younger brothers, you have no future...!」"
    },
    "177:257": {
      "repository_source_sha256": "438ca2b3a96ef0465f040c26ee9d63ab43735db79444492176bbc4265635fd80",
      "en": "「I acknowledge your strength.\\nBut you lack the qualification...!」"
    },
    "177:306": {
      "repository_source_sha256": "4d99079082be68f9c881b36d7f240361589dd19751b7846d25cfb8f8ab0dc1c9",
      "en": "「Foreign body marring this universe's order...!」"
    },
    "177:341": {
      "repository_source_sha256": "21cbac8210816ba8e6ce975bf252acfc74a40fe8c9d97c841975eece51ef7365",
      "en": "「Your lives have no worth...!」"
    },
    "177:372": {
      "repository_source_sha256": "925a305971f832e1f12c4d28ec02dd4869281249b304c49fdc9abbbb9325f842",
      "en": "「Monsters born of the flow of\\n120 million years...!」"
    },
    "177:427": {
      "repository_source_sha256": "24b9c39b10e9c0d432c86e51b5a58d81bed01cd29220ce89ce9dd0944056597e",
      "en": "「In the name of duty and obligation,\\nI declare your destruction...!」"
    },
    "177:478": {
      "repository_source_sha256": "3811487fc4120477a7fa5abfa10c7e1ac5cd2dec8ca197c55256a4632f11a35f",
      "en": "「Sinful ones... Your name is Earthling...!」"
    },
    "177:513": {
      "repository_source_sha256": "e283af5cca6a7502ca330879cda7f81579aa5f3b3c033f502175f0d372209044",
      "en": "「Before you lament, repent your sin!」"
    },
    "177:550": {
      "repository_source_sha256": "41332fa0c5cc59f3a3d0aa212a5ec84425f01751a29d18db04cc4c1dd61b7d3e",
      "en": "「I won't let you disrupt the Supreme God's rebirth ritual...!」"
    },
    "177:587": {
      "repository_source_sha256": "e7ac417f8e3093e2544176d1791d2b568048548eca28b0345635b21964a6bbef",
      "en": "「You are not permitted to receive\\nthe light of the $$黒い太陽#sol$$...!」"
    },
    "177:642": {
      "repository_source_sha256": "183cdbe8af31afb8fb56c936d313b9bd9b3e6df1d43bb3f245d1922c667dee15",
      "en": "「They must be made\\nto taste suffering」"
    },
    "177:691": {
      "repository_source_sha256": "26dd94275c83853413bf9460e6f4fe4637981b69bf8745bf588a95625a3479e7",
      "en": "「Now I shall deal you punishment...!」"
    },
    "177:724": {
      "repository_source_sha256": "ea1210c226ee1691be55322189b9a5eea22511a6c2b766aaae36743ab85c9d7c",
      "en": "「Precisely because you deny it,\\nyou must be punished」"
    },
    "177:779": {
      "repository_source_sha256": "319cf740fd8d408ca572f31d89dba8625cf5e22bed7050e09ed872f1a38f8434",
      "en": "「My heart is filled with anger...!」"
    },
    "177:812": {
      "repository_source_sha256": "c417de90b501dc14d7f903f001d02fa000f1dfefd493070b03f2f898d27f00a6",
      "en": "「We are the $$御使い$$s...」"
    },
    "177:831": {
      "repository_source_sha256": "ea94cb1bc88997cdcdbf31e0eec83bdba5cb105e25a0c00490fff7f1051ff743",
      "en": "「Guiding immature younger brothers is our mission too...!」"
    },
    "177:870": {
      "repository_source_sha256": "8054fff96f3cf5c7c7d1c63c16673dd3cb1bd10563e34f5dc0f4f60a784cbc7c",
      "en": "「The one and only being\\nwho mastered this universe's truth...!」"
    },
    "177:1042": {
      "repository_source_sha256": "c22b987e5fd34e82904a0b245121516a116a7d8f6c33cb85e6d08e9c629770ac",
      "en": "「I cannot grant you\\neven the light of the Moon...!」"
    },
    "177:1091": {
      "repository_source_sha256": "be7163f8f1239280099bff64dc85a557e8a26b9b437696c8d65913eec602becc",
      "en": "「Insolent man! The sun is with us!」"
    },
    "177:1132": {
      "repository_source_sha256": "3ee16d878c9480f4c5ddc9bea2aa2ed7df9915480a428ec94f5e771d76a5f759",
      "en": "「Is it futile to reason with a child...!」"
    },
    "177:1171": {
      "repository_source_sha256": "84c92cd992bbba5d6f760696aa24e3de8e1e6de8848d2719bafb467e95c992d2",
      "en": "「Machine doll bearing a sun within!\\nYour existence is not permitted!」"
    },
    "177:1234": {
      "repository_source_sha256": "9739f625b6b8c10f6361ad7f4cd7c2988e7994d99b1ea26cef34774741f9e9f9",
      "en": "「Even if you unite light and darkness,\\nyou cannot win...!」"
    },
    "177:1285": {
      "repository_source_sha256": "610aa7242b390da2c5f704036f689a8cfe4be7a2e463bd705b187cfa8deb2325",
      "en": "「$$異能生存体$$...!\\nI'll clear that karma myself!」"
    },
    "177:1344": {
      "repository_source_sha256": "b95c05e552cbd7e2ef67dc25013aecf5dfcf65b991324be63a46214b2f255429",
      "en": "「Gundam...! I'll erase your existence!」"
    },
    "177:1383": {
      "repository_source_sha256": "663c42f175dc3de5f876f323895cd11b7600aafa6260ea64f800134499521fda",
      "en": "「I'll destroy all products of the civilization of fire...!」"
    },
    "177:1422": {
      "repository_source_sha256": "5fa4e84aa0b3b6c18e8ec47ea420d1d56de79a6fec4a54c4e7b1bc76ccd83225",
      "en": "「Sinful tool...! Its name is Gundam!」"
    },
    "177:1461": {
      "repository_source_sha256": "105a0b3d2843e4c7dfc73b8dd4a5ab54aca96148cff58d8e02b196677216988e",
      "en": "「Fire taken up to face the future...!\\nBut that cannot be permitted!」"
    },
    "177:1526": {
      "repository_source_sha256": "a8f221c216d5416f1c0366a954b6915e19699ccbdfc148d95dfd200e404c482f",
      "en": "「One who goes from evolution to $$シンカ$$!\\nI pass judgment on you!」"
    },
    "177:1577": {
      "repository_source_sha256": "a78e86ea182f3b9d6abf01ba96bb99eab8df6be50da8756d88745e38f43d57e4",
      "en": "「You who reach $$シンカ$$ led by Gundam!\\nYou must die!」"
    },
    "177:1632": {
      "repository_source_sha256": "982dff41022cf6f0e7e1e3ffb567a856587a9141eb041142c51ddbd2f3ae65d1",
      "en": "「Know that the bud of $$シンカ$$ in you\\nis the cause of all calamity!」"
    },
    "177:1687": {
      "repository_source_sha256": "80433d0a024b04d4012aaa5744af3267f3b799338a656bb4eba76f0947c66c37",
      "en": "「Destroying civilization with your hands\\nis the atonement you can make!」"
    },
    "177:1746": {
      "repository_source_sha256": "39db656f67539cbb36d98b086c5a1128987c0d9f8eb68e93f085273703afdf7c",
      "en": "「Gaining the means to turn feelings\\ninto power is forbidden!」"
    },
    "177:1797": {
      "repository_source_sha256": "81592686ccbac99cd1992c61a858d54d713c7505a4581386906997ae351a4398",
      "en": "「Sinful one, heir to the beast's blood!」"
    },
    "177:1830": {
      "repository_source_sha256": "183a655957b7871b3ad82063368c6b3e23ae3f583652b48d6a5c4da476ace375",
      "en": "「Sink back into beasts once more!\\nThat is your fate!」"
    },
    "177:1889": {
      "repository_source_sha256": "4b9f887f730c41b9cfcd6e7a38d14aea14fee298470f791f8e105d3b1ed74b91",
      "en": "「Most sinful one, $$始原の特異点$$!」"
    },
    "177:1924": {
      "repository_source_sha256": "b2b73ff43dbb952a0e002f336b6962ecd41b348e3e8080b1f0ee9a002068ef24",
      "en": "「The salvation of the whole universe\\nwill be accomplished by our hands!」"
    },
    "177:1979": {
      "repository_source_sha256": "62b67939432154f658c1ddfa43d3d997d28a849323ae861bc2893d68837f9a22",
      "en": "「You who bring forth life's power!\\nStop that song!」"
    },
    "177:2030": {
      "repository_source_sha256": "fa8de46ab9db5d5ba1c07088a3f1b9c4380d0f765dbb2dc34c6c8f3762c1f566",
      "en": "「Your feelings are just the reflex\\nactions of lowly life forms...!」"
    },
    "177:2087": {
      "repository_source_sha256": "aa593dc6735260bfd45c454ddcb53b9249c850ce7b32e37845c788dbb0fcaf7d",
      "en": "「Do those wings give you power...!」"
    },
    "177:2126": {
      "repository_source_sha256": "6732cd84e835d002d4d4a506ea56dff9faf41ee69991b3868f0b2217fb6853be",
      "en": "「Demon God of Light! Fall to despair!」"
    },
    "177:2165": {
      "repository_source_sha256": "65abc8b238df11720efffacea3a1fe907ec0e4870633d19967ae1b07e64e1274",
      "en": "「Sinful one, warrior of $$ゲッター線$$!」"
    },
    "177:2200": {
      "repository_source_sha256": "a76422829e3ac2225bc2308af0431435ab50397c08e71d30b15bf9b7b775142d",
      "en": "「Receive the retribution\\nfor dabbling in $$ゲッター線$$!」"
    },
    "177:2251": {
      "repository_source_sha256": "6e9e18a3e3c414ea819c30d4276b7663d9442fd6f77ba63772764f95361d5161",
      "en": "「What could beings who just earn\\ntheir daily bread know of cosmic truth...!」"
    },
    "177:2316": {
      "repository_source_sha256": "f64eedd45d3a33e2181e0b05de9b16d667d4a9f0c392adee3613ff4c99737852",
      "en": "「Defier of God's will...! You are guilty!」"
    },
    "177:2355": {
      "repository_source_sha256": "ed70d7bf3f318881680ea71794d1076e7913fa09f125107e5f6240383c8c7f0c",
      "en": "「To you who deny that king's power,\\nthe path to $$シンカ$$ is closed!」"
    },
    "177:2412": {
      "repository_source_sha256": "a361646f8d51a266b72faee6e63d28157c6df3a28de2a9acfbc2615eed45f5fd",
      "en": "「You who kill your own kind\\nare the farthest from $$シンカ$$!」"
    },
    "177:2469": {
      "repository_source_sha256": "6276c44551b05def2ef1b0e40102bc8d5c9b5d90cbb646b90a9256a5d143a931",
      "en": "「You may not wield the power of feelings!」"
    },
    "177:2510": {
      "repository_source_sha256": "813153703afae1517d56887578cb3a193f290cf82af76af40f8b7485b7ea8ac0",
      "en": "「You are without sin! But you're mine!」"
    },
    "177:2549": {
      "repository_source_sha256": "759b2e32396cced58b7a880a87507f5f86aa20e3d8f3046ce3116c5e1b4b7d47",
      "en": "「The $$天翅$$s have already perished!\\nPerish too, Mechanical Angel!」"
    },
    "177:2600": {
      "repository_source_sha256": "5cff97047912bcade4d8f6e4226518d6bec8130e66ff0ad19e3773a2c819885f",
      "en": "「We'll manage the mingling of waters!」"
    },
    "177:2637": {
      "repository_source_sha256": "00b229a69f53373fd0ce96b19bad392cc33b8fde1e961b3f3b2414f8703ddf3e",
      "en": "「There is no future beyond the flames that felled $$バアル$$...!」"
    },
    "177:2678": {
      "repository_source_sha256": "369a551810210f28ded636ed6444cc7a2331ae71b814333737b4ddda1b963171",
      "en": "「You dare challenge us with such power...!」"
    },
    "177:2719": {
      "repository_source_sha256": "bb82ae26e0d991a3ee7c83fec4ce454e4403725b2c88f1f900dc3b89bdf291eb",
      "en": "「Power born of the civilization of fire...!\\nI reduce your existence to nothing!」"
    },
    "177:2774": {
      "repository_source_sha256": "97f954e17c3dc8f1443c8b67f7527b7cb19a7ec37ece68ccd49bbffc9ef81b4e",
      "en": "「You who challenge Tengen!\\nKnow your insolence!」"
    },
    "177:2825": {
      "repository_source_sha256": "bd0dca952ae80eb9027a7ec9b1aaa79392d98cae37127acb8d335f1635a34939",
      "en": "「Even the destination of the wind is in my grasp...!」"
    },
    "177:2868": {
      "repository_source_sha256": "e1583f281d90a751a3046d2c435745355dc98a007add1e88109325baaaa427fe",
      "en": "「That vessel will never hold a soul...!」"
    },
    "177:2907": {
      "repository_source_sha256": "bf4c02ce40ff9c77f3879adb0d5b5e8c1adadd89b39faba8425c4d0774bde156",
      "en": "「Beast strayed from the herd...!\\nI shall guide you!」"
    },
    "177:2958": {
      "repository_source_sha256": "9f291074c6bb8f3e7f5e06dca1b315bf66bbc18722c9b2ab19b6dc0ff6e087e1",
      "en": "「Is that ship refusing\\nthe fate we have decreed?!」"
    },
    "177:3011": {
      "repository_source_sha256": "03e657060205ab6e0e6b346382af19120d115933f331dc2614a65e402827a756",
      "en": "「Bearer of the twelve keys!\\nOffer that power to the $$黒い太陽#sol$$!」"
    },
    "177:3070": {
      "repository_source_sha256": "f189284368e9946336ef0fee6d8925987db9eb7f57a36cc836f12f708e95dc94",
      "en": "「You did well to nurture the keys...!\\nThat alone deserves praise!」"
    },
    "177:3135": {
      "repository_source_sha256": "61f92637e04bc6aa509f1e922b4936aea3eaaa16442f83fb49e60e14af664230",
      "en": "「The twelve keys gather at the $$黒い太陽#sol$$...!\\nYes, now is the time of rebirth!」"
    },
    "177:3200": {
      "repository_source_sha256": "909110e3c02e97aa2ac3b3f2831c281a20a09fac17d7b3e751b7944a967cead9",
      "en": "「$$悲しみの乙女$$!\\nI shall wipe away those tears!」"
    },
    "177:3251": {
      "repository_source_sha256": "ad796dafe186ba7e4d5cf8768d58432d5e5ae326aa3c21276897e3d6535d749e",
      "en": "「$$傷だらけの獅子$$! Sleep now!」"
    },
    "177:3292": {
      "repository_source_sha256": "df08e5a394365c605418cd0f6ac5d9fae261e721cdfc9276b765d5746ed22c79",
      "en": "「$$揺れる天秤$$! I'll shatter your will!」"
    },
    "177:3329": {
      "repository_source_sha256": "5240afb7782f950abe86aeefdda0f5a9f9ffef1c69eea6196742d6d3bea824f3",
      "en": "「$$いがみ合う双子$$! Come to me!」"
    },
    "177:8387": {
      "repository_source_sha256": "da757c6bcc8c50c0ca4307e35b1612de8fa2ab6f5715ba8b698673250952e605",
      "en": "「Let's just wrap this up quick」"
    },
    "177:8416": {
      "repository_source_sha256": "e145c530ededeef9ff601df3622682a99e36b2dc64212c8bd86b410278448b3a",
      "en": "「Hee hee... That kind of thing is thrilling!」"
    },
    "177:8457": {
      "repository_source_sha256": "089d3114e2308adea48ee42ccb586342bc9e663992290e7701e0520d2f2361df",
      "en": "「How foolish they are...\\nThey could just be judged quietly」"
    },
    "177:8506": {
      "repository_source_sha256": "2d36ceaa6fae83108572be1e4d42ed05297d84d6f8b353bed7c04ded08a8c9cd",
      "en": "「$$テンプティ$$ is having a blast, though!」"
    },
    "177:8549": {
      "repository_source_sha256": "187c39cef93c7a04a6ffaca517f6eefa724f5e94302fdf446aa9dfb67da78a1c",
      "en": "「Supreme humans serving the Supreme God...!」"
    },
    "177:8582": {
      "repository_source_sha256": "222bb96f971a9dd092d3e8b06a1bdbd874ae25a21da4260544274e86362f04b8",
      "en": "「The oldest humans to attain $$シンカ$$...!」"
    },
    "177:3372": {
      "repository_source_sha256": "b9bff9f76d6039b7165a4983d6dd72dacefc6121f0a8213fbcc85af399eb0e21",
      "en": "「You must receive retribution...!」"
    },
    "177:3405": {
      "repository_source_sha256": "078cad7f734fec362fd0e75e9684a94721db86ad94055819c2e6880c0f7d2d75",
      "en": "「Atone for your sins with your body!」"
    },
    "177:3440": {
      "repository_source_sha256": "5d4483ea8c80b9b0b46304f1d95668ad8515858fc6c3c30c5ac373191916b97b",
      "en": "「That's in the palm of my hand too!」"
    }
  },

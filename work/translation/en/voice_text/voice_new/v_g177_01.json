{
  "schema": 1,
  "rows": {
    "177:3469": {
      "repository_source_sha256": "3f0e537daf314846921e17cdae38cebf8aec528e3315a78808bf5b9ba6fc09d6",
      "en": "「You must know your own sin...!」"
    },
    "177:3508": {
      "repository_source_sha256": "aa10a79a347c3b5112589daef1cccffd8500f9fc505fd65ef7588cea3a864bb2",
      "en": "「Insolent one...! Face retribution!」"
    },
    "177:3545": {
      "repository_source_sha256": "8bff248fd01228a780348c43ac4cfe51b8d2a3bc64e12f17c63c1fd64d3e525d",
      "en": "「Learn what comes of\\nraising a hand against us!」"
    },
    "177:3604": {
      "repository_source_sha256": "d53b96176c6ef98e0304746e2c12672f24111af7b616150fe3a348fbf329e3e5",
      "en": "「All is fate, already decided!」"
    },
    "177:3637": {
      "repository_source_sha256": "ea75ff1e308ea0b404bb482833a0f51713c063011d144627fcc0ca86f241192f",
      "en": "「You who defy fate, be swallowed\\nby the fate we decree!」"
    },
    "177:3694": {
      "repository_source_sha256": "91c84109d91861a18075de41b6a6a5e4212a1167d50bbd92af7b656a09db5e66",
      "en": "「Together, we proclaim God's will.」"
    },
    "177:3727": {
      "repository_source_sha256": "d1c43126dbbfcd8242178c68f920fe5e9a181be4b2749d451cd7c56b55d71010",
      "en": "「Comrade, leave this to me.」"
    },
    "177:3756": {
      "repository_source_sha256": "c9478aacaa8c2e881abfc67165967f4ccfa7e2ac770a7a318484a35f2dec7a9d",
      "en": "「I lend you my strength.」"
    },
    "177:919": {
      "repository_source_sha256": "b131bf6b93fc3909c64b149a431216118176d0ce1819adf2c505aa08a2e7b85b",
      "en": "「I sentence you once more...!」"
    },
    "177:954": {
      "repository_source_sha256": "8a4a810486a50794c6f14aa65d63cc62a0c8a4fee403a884be813f654f8eea77",
      "en": "「Still deny your sin? Once more...!」"
    },
    "177:991": {
      "repository_source_sha256": "7521a49cb89c1ab0172126858c7c21820143463ac9c7dea4c2161d3cfa85b0ee",
      "en": "「Your clinging to life...!\\n$$ドクトリン$$ will sever it!」"
    },
    "177:3825": {
      "repository_source_sha256": "85aa2604f208f8cb0fd785b219b8110d9fda7b623b2fdbbbf3b8047c31af5603",
      "en": "「Follow after me!」"
    },
    "177:3850": {
      "repository_source_sha256": "6f9614459978c3f682dcd3cebdc330532bd848843e97937e01343b9b19f50892",
      "en": "「You may not move from that spot!」"
    },
    "177:3779": {
      "repository_source_sha256": "8eddfd1d0741048910376143ebba5b92de82eaeb742a2e8aa972e13e9730d950",
      "en": "「I will be your opponent!」"
    },
    "177:3804": {
      "repository_source_sha256": "c16855aef005b8dbc124af73b54cd9613b3d71503282a319283a8565ffbdab67",
      "en": "「Repent!」"
    },
    "177:8109": {
      "repository_source_sha256": "4d13b3cb633095de08a2c5718fbeed4f833ae2669bfcf82bf3aed1f26769596e",
      "en": "「Impossible...! No choice left...!」"
    },
    "177:8146": {
      "repository_source_sha256": "25f50672c5542f0afd65031bf65ed8ce645981b4bac31d1748e59880c7eef61a",
      "en": "「This must be some mistake...!\\nThen I have no choice...!」"
    },
    "177:5754": {
      "repository_source_sha256": "ea6fc146624ba0f782f3dd1deea047aff06eda7350fc3d2d1bb7b3d366fdfde7",
      "en": "「Is this a nightmare...!」"
    },
    "177:5775": {
      "repository_source_sha256": "3e10016f00dc3ea4c5d62b2b0e656305eb8fd1851a1acf4b45eb48a36f8b7520",
      "en": "「The impossible is happening...!」"
    },
    "177:5810": {
      "repository_source_sha256": "a49a1e8a8a5ce1291e81832815ad4b2d929811e2520366b9e767b61cc278cc0a",
      "en": "「The fate we ordained\\nis being overturned...!」"
    },
    "177:5863": {
      "repository_source_sha256": "1b71f2ede797bb301600736f1eeb7e051f5566273432401c9fda085e6fa431b8",
      "en": "「Foreign matter! Do you mean to warp\\nthe order of the $$カオス・コスモス$$!?」"
    },
    "177:5926": {
      "repository_source_sha256": "632369ad0996db3cd5d0d51255f45b4e6cb2389177003d846a0b847aa29c6ed7",
      "en": "「It seems some mercy\\nstill remained within me!」"
    },
    "177:5985": {
      "repository_source_sha256": "d751a20096a33757fac8274c72ef06be2253089c6eba452eb5418b2755024cf4",
      "en": "「I now cast off all softness...!\\nAll that awaits you is annihilation!」"
    },
    "177:6052": {
      "repository_source_sha256": "555393bf3ccffe25a965afde1b585b10eeeae7b8696da4702a311eaca33cd90f",
      "en": "「We are the $$御使い$$s...!\\nNo defeat for God's will incarnate!」"
    },
    "177:6109": {
      "repository_source_sha256": "2960a2ee5acd244d50eca458d0396b678ac2bfc06b6e80acdec490099b204c38",
      "en": "「I admit it!\\nIn power alone, you rival $$バアル$$!」"
    },
    "177:6164": {
      "repository_source_sha256": "3537c910723bde5bad96a1c3ea2c582a5eab74be60e6152eecefe0576edcb2c7",
      "en": "「They're monsters beyond causality!」"
    },
    "177:6207": {
      "repository_source_sha256": "b43761a0f0ce4a786f76fe7b8587a5f5e8ab41ac2eed4ea87f496b0d3261296e",
      "en": "「Quiet...!\\nThose people cannot overturn fate!」"
    },
    "177:6262": {
      "repository_source_sha256": "12fd4154cd5321aa51a5b85c611dc64ffb06770b0ca7de4fcc1d2a8a6e0afc62",
      "en": "「Anger unseen in 100 million years\\nis filling me!」"
    },
    "177:6325": {
      "repository_source_sha256": "625ffd8bd1a3849fe35c98548dbb3299de9efed181639b0308a18a6c01e9fb7d",
      "en": "「I'll return that anger to them!」"
    },
    "177:6362": {
      "repository_source_sha256": "e3e47fdecb4db5e64d994124312e35b53db612186fc862a3c28f93648ab53771",
      "en": "「That moonlight...!\\nIt can stand against the $$黒い太陽#sol$$!?」"
    },
    "177:6413": {
      "repository_source_sha256": "e5ba09dc4b92c9184f7878606fdf2334583c1fd32ec8b210eb92f5137e09b2de",
      "en": "「That man...!\\nHe holds the sun's radiance inside!?」"
    },
    "177:6464": {
      "repository_source_sha256": "3089f534a267bcd47198c915096a3b843457a72d1f6df6f3d5d0b92b76ca75e1",
      "en": "「Child or not,\\nyou must know your own sin!」"
    },
    "177:6519": {
      "repository_source_sha256": "7e2745e8ab2cba8443c3b463bced7c88f9ed18f7319ed29e9fe01c7016744586",
      "en": "「Never! That doll must not exist!」"
    },
    "177:6560": {
      "repository_source_sha256": "938c0e0afb83c5fac4950dbc90cb6bc7f3bd0673e422f09f66899889f91186d0",
      "en": "「So this... is the power of love!?」"
    },
    "177:6593": {
      "repository_source_sha256": "33da8db5cee6aa1bcd039b90cd23cdf5b5f85a85450872d9bfcbbe08c60db6d3",
      "en": "「$$異能生存体$$...!\\nCarry the god-killer stain again!?」"
    },
    "177:6658": {
      "repository_source_sha256": "0e0c2bdc7525fae961bd7dbfaf4916002bd642690a04eda9c9d5b0a4c05b11ea",
      "en": "「$$始原の特異点$$!\\nYou still defy fate!?」"
    },
    "177:6707": {
      "repository_source_sha256": "5375a7957e9667ac9e9b7ba4dc3f6a9f54440adc82528a25db65da76f53db7bc",
      "en": "「This power...! Gundam guided you!?」"
    },
    "177:6746": {
      "repository_source_sha256": "f08462007152d2cf4c363ca2a5b86e021831f03260344aae282f398984d1d976",
      "en": "「$$ガンダム$$!\\nLead Earthlings to the next stage!?」"
    },
    "177:6799": {
      "repository_source_sha256": "bdcb16d6720d3b320ee2920866af85107142379c70a9021551709d8e8d005ae2",
      "en": "「This one...!\\nAlready walking the path of $$シンカ$$!?」"
    },
    "177:6848": {
      "repository_source_sha256": "49c462f61263cddf74df8ac3e621fe8cb7ff2dc54201e9050201474529e5a810",
      "en": "「Beast-blood heir! Turn back!」"
    },
    "177:6887": {
      "repository_source_sha256": "72b4be89be0676a37bfe220b6fdb9b3547d0bf5531c6d108830b5354b1861eb5",
      "en": "「Unbelievable...! The life force\\nthis one wields is truly infinite!」"
    },
    "177:6948": {
      "repository_source_sha256": "ee53868723f95a88df000e3d8797099e98af2af1e7b38a3cbf5058c739cacc76",
      "en": "「Accursed wings...!\\nDo they carry feelings to me!?」"
    },
    "177:7005": {
      "repository_source_sha256": "56822d1b2f069f88bda5c5b94ae16b3c9c468c6abde8e96ef98c22882683f64a",
      "en": "「A light that kills even gods...!\\nTruly a Demon God, as they say!」"
    },
    "177:7056": {
      "repository_source_sha256": "f4a43cc537a1e0bc299d2fdfd6959e68abcd04c12390ef4b1e65f02a62ec76e0",
      "en": "「Warrior of the $$ゲッター線$$!\\nYou are already beyond saving!」"
    },
    "177:7117": {
      "repository_source_sha256": "8daeaef42dc7ece3f251e07fb29fed831f134ca20160b794cf83f924b252ed6d",
      "en": "「So this... is the power of what\\nEarth calls a salaryman!?」"
    },
    "177:7172": {
      "repository_source_sha256": "e77612114454d7c6dac39f5e690b79451b43ed00bfd7259c2cbe27f5681ba729",
      "en": "「This one...! Ignores God's will\\nand fights me by their own will!?」"
    },
    "177:7231": {
      "repository_source_sha256": "e7fb3addbd9137edaede6af3a2088f5eae2888301f9105953b89621b4270660c",
      "en": "「You who reject the power of kings!\\nWhat do you aim for!?」"
    },
    "177:7282": {
      "repository_source_sha256": "70662d1e0377a283bae0534dc38d9dc8b7ba96350bd7f66b5c665dcbd5e981e4",
      "en": "「How many feelings is this one\\ncarrying into battle!?」"
    },
    "177:7337": {
      "repository_source_sha256": "dcb8ba2ecead312d0518205c7c9f55a1cf295fef1ad8e85ce21009e5a1b6a9c7",
      "en": "「Unfathomable! This one's existence\\nexceeds my understanding!」"
    },
    "177:7400": {
      "repository_source_sha256": "85ae560fb9c31feaab474d50c24448aae8ac2ed3aecc785562c2b5a291ff5ea1",
      "en": "「Mechanical Angel, mingling\\nof waters...! That is forbidden!」"
    },
    "177:7451": {
      "repository_source_sha256": "4ccc3df3b1f590a4fd7d5220ee3b461d8b7199f32af7ff7635154be5b545c600",
      "en": "「This one's soul is truly flame!」"
    },
    "177:7478": {
      "repository_source_sha256": "11646ace39cd27991bf1911e43a871f282de7a56ea4fbaccc08106b1570fb6d7",
      "en": "「Futureless power dares face me!?」"
    },
    "177:7515": {
      "repository_source_sha256": "0195c140382ab534980cbfe2e54d4a0d9623737a8ac74beb3279164dbc0b8f08",
      "en": "「Wisdom of fire! Why not give up!?」"
    },
    "177:7556": {
      "repository_source_sha256": "be7ce786dd5cbfcad3bbf790297770e01785c1ef60268beb3d6b345907de3861",
      "en": "「Spiral Man! Did you set\\nthe wind's destination for us!?」"
    },
    "177:7607": {
      "repository_source_sha256": "83ffb6383f8998ab0fd16d1f66f1c5eb9859451787e5ab8340336773c2594a2c",
      "en": "「Mankind, you tread forbidden ground!\\nRepent!」"
    },
    "177:7658": {
      "repository_source_sha256": "1797d30b1d9baa6a4123095bbf17de7d6c3d30a2790291354d746572378a2f85",
      "en": "「This one too is swayed by Earth!?」"
    },
    "177:7699": {
      "repository_source_sha256": "b624485578539d2cfe68594b8bb7f512b19f12ed9213b5d949083b3f305395d1",
      "en": "「The power of gathered feelings...!\\nIt rejects fate!?」"
    },
    "177:7760": {
      "repository_source_sha256": "346071ed69987f4f416491d2eddf89ab3b4ce6e8d03736e794db61b216aa1da8",
      "en": "「Why!? Do the Spheres hold more power\\nthan we anticipated!?」"
    },
    "177:7825": {
      "repository_source_sha256": "5f2a54590d90d08224901aa10e5b9f97fb9a170d014c967c15ecb541ad1657dd",
      "en": "「This is the power...!\\nIf all twelve are gathered...!」"
    },
    "177:7876": {
      "repository_source_sha256": "665ac96421c94380b27277bf89ff9b84d199d3dc361a0711075309c63dc96017",
      "en": "「That power...! Offer the Spheres'\\npower to the $$黒い太陽#sol$$!」"
    },
    "177:7931": {
      "repository_source_sha256": "af72c34dcdb09d9b708291a8dfc42a9a92af8e775e459d88a2eb035c61d405c3",
      "en": "「Why seek tragedy, $$悲しみの乙女$$!?」"
    },
    "177:7972": {
      "repository_source_sha256": "5f677104898e54e31cf1d4cf2d062d017752ecbedfcb7f5f4f1ea0a688764dee",
      "en": "「Do you feel no pain,\\n$$傷だらけの獅子$$!?」"
    },
    "177:8025": {
      "repository_source_sha256": "ccdad2ef7795e889f1bc5def0cab9065c427416974534a92fbc9b9873be834d7",
      "en": "「$$揺れる天秤$$! Why not give up!?」"
    },
    "177:8066": {
      "repository_source_sha256": "2f734e615e7d8901ee53bd3b16f537cbf34c7bef3cae692f3212f0df1a32e701",
      "en": "「$$いがみ合う双子$$! I seek that power!」"
    },
    "177:9250": {
      "repository_source_sha256": "2b4856b7c97fea0303647bf33fe47db47af024f31187c926adbf31bb19cec519",
      "en": "「Even so, you're hit too much!」"
    },
    "177:9283": {
      "repository_source_sha256": "9213a5fb9f9edbc936637d750b886a12c3d3de5a2a57b806e7369c23b3109231",
      "en": "「What's going on, $$ドクトリン$$!?」"
    },
    "177:9320": {
      "repository_source_sha256": "108c8da6b7b1935ecdce98ad91f22939940cea4b258ef4de9008ddf9086ebe70",
      "en": "「Don't say I didn't warn you...!\\n$$ドクトリン$$'s really angry now!」"
    },
    "177:9385": {
      "repository_source_sha256": "ce1861cc1a617c834e41c68359b0734a736ba463060d5593d9a104404e176381",
      "en": "「Those guys, how dare they...!」"
    },
    "177:5210": {
      "repository_source_sha256": "f530e3accdb8fd536f6dd696ba7b5178994e5d5e4eb76299d6e7086352b176d0",
      "en": "「As expected,\\nyou deserve to be called monsters!」"
    },
    "177:5259": {
      "repository_source_sha256": "ba210f38cb5cb0fec69024497bd944b8ddbacdfe6d41209ffe2a44f1597f6855",
      "en": "「Know that your power is your sin!」"
    },
    "177:5294": {
      "repository_source_sha256": "33ae8261b9d4a98999df07c5036c272f18b221dca3ecd30d1dc8fbb875893f06",
      "en": "「You wield power without grasping\\nwhat truth is...!」"
    },
    "177:5349": {
      "repository_source_sha256": "f103e2ad14c966941ef951ddfe502ce72d7949d14c480e7f68ff42cbeb9b587c",
      "en": "「No wonder you made it\\nall the way into $$エス・テラン$$!」"
    },
    "177:5404": {
      "repository_source_sha256": "4304eb4694af624775922a9cc48a22e28e04799bc5306eb0bbb86a9ee7e35c0a",
      "en": "「Your violence...!\\nDo you mean to awaken my anger!」"
    },
    "177:5457": {
      "repository_source_sha256": "4c0284b54aa46eb22e962576099d9160d2ae6267064497085311c50fa5509f9a",
      "en": "「Indeed, you need purging by force!」"
    },
    "177:5500": {
      "repository_source_sha256": "6ab5a7f6afbce04ca68b8ece099b9a673e729e598d893b112aef80f80622db75",
      "en": "「$$シンカ$$ is not for the power-only!」"
    },
    "177:5543": {
      "repository_source_sha256": "3f99ac8793b4c490b6ffe7e5e3e98f1d655988001142fda85880a6eb01978995",
      "en": "「A power that fears not even gods...!\\nYou are no different from beasts!」"
    },
    "177:5596": {
      "repository_source_sha256": "d78ce6113ecbe4ae87c17b8e813dbf99fd8a60178dbe1e5423089dbc84180e78",
      "en": "「$$テンプティ$$, mind your place.」"
    },
    "177:5629": {
      "repository_source_sha256": "510826d3a567b786c782ad2d18d4155b5f0b8d7ecd38325ab21a1dce992a2ee7",
      "en": "「Such is Earthlings' potential...!」"
    },
    "177:5664": {
      "repository_source_sha256": "13ff58a7cba5caa2a00897afc58101f942d31e453a333bd57a53bcd57287881b",
      "en": "「Your sin: aiming that power at us!」"
    },
    "177:5705": {
      "repository_source_sha256": "36627ec501d31b30d9242417984ab99e5b4c4c5487a9665c8a5dd2edfec1161f",
      "en": "「$$テンプティ$$,\\nleave the anger to me...!」"
    }
  },

{
  "schema": 1,
  "rows": {
    "177:9115": {
      "repository_source_sha256": "4230be49609b0d2f87d13ed578d7389bcd8bc3417462a77e9e5fb50394600347",
      "en": "「Aha! Not bad at all, huh!」"
    },
    "177:9154": {
      "repository_source_sha256": "57d28b7d78e05d4aaf08c722bcab9e1d93c319f4e5cc48903df18e8fa50f2f82",
      "en": "「I don't like that sort of thing...!」"
    },
    "177:9195": {
      "repository_source_sha256": "393a95309bc5221ebf3408e012b70a3a7e3af4bfeedfce725433887801f66167",
      "en": "「That's enough, $$ドクトリン$$!\\nLet's crush these guys!」"
    },
    "177:4438": {
      "repository_source_sha256": "71bb5c6e3fe6c857ee74823e74247e4cfe93706858bad25a832bdcfc4ab4204f",
      "en": "「It is futile.」"
    },
    "177:4453": {
      "repository_source_sha256": "f6498d282720173f724c5a919c9154c3ed49030a3c26daf1139a38cd76d55340",
      "en": "「That is hardly a scratch.」"
    },
    "177:4472": {
      "repository_source_sha256": "2a1c2456ef3e977a5c65a6fe27e3d6b3d5c6026cfb5e9b8d379f8ec453828638",
      "en": "「This is your limit.」"
    },
    "177:4493": {
      "repository_source_sha256": "b9da660a3185f0a5a9eb07af75ecdb57a0c2201e20db458ce95f81d26c228907",
      "en": "「This $$プロディキウム$$\\nis the will of God itself.」"
    },
    "177:4542": {
      "repository_source_sha256": "81681b55913708df5097f0c20380cb3e8631b84157c0f63787f78a4292b8f536",
      "en": "「'Feeble' is the word that suits you.」"
    },
    "177:4581": {
      "repository_source_sha256": "e930584b1e00b3bd6fa70d38a459e32baa8204c8c93a7da55a87299fcafbe881",
      "en": "「Touching me is all you can manage.」"
    },
    "177:4614": {
      "repository_source_sha256": "227e11cc0b6399cb9a3c938d347042487cd0e42aa8ad752cd6b7fb2b286cd199",
      "en": "「Is that the attack that felled countless foes?」"
    },
    "177:4655": {
      "repository_source_sha256": "516045e355c137d48ed9095489092dbfd7fdbb20bd97fcb5159ee945b6e88ef1",
      "en": "「You do not understand what power is.」"
    },
    "177:4692": {
      "repository_source_sha256": "5ccdb31117c155dd9646c8e7386a16a34580aeed21f49b8140677c18cb892e48",
      "en": "「Learn the meaning of powerlessness.」"
    },
    "177:4729": {
      "repository_source_sha256": "c2a96783c00d42328d48443ad1f4b59fdcaa3685ffc589e53c42c0379d51ec2e",
      "en": "「It was that one's will that shook.」"
    },
    "177:4764": {
      "repository_source_sha256": "e4f14b5edad7dbf669feb51758ddce5a7b13c081281fd5dcb4fe34e22fe198de",
      "en": "「So you touched this $$プロディキウム$$.」"
    },
    "177:4797": {
      "repository_source_sha256": "272bd62cf35f0bb2ef81ba70902dc24614a6e74a89eeacf2fda378c9fcec0c27",
      "en": "「Do not scorn them. They're monsters.」"
    },
    "177:4830": {
      "repository_source_sha256": "45abee95c8b52fd7147d2efefb082768a464b733209277841195ddf5fbfdd1cb",
      "en": "「You do not know what a $$スフィア$$ is.」"
    },
    "177:4873": {
      "repository_source_sha256": "a59fbf50fa219541bd713a79ac19fcc329430fffd8d844f330acf3429311d3d9",
      "en": "「You have mastered nothing\\nof $$オリジン・ロー$$.」"
    },
    "177:4926": {
      "repository_source_sha256": "9152f17a6adb0d4311aadc3b61e2be997d20d89d366359f8de662b4e3f007468",
      "en": "「Spheres are too much for humanity.」"
    },
    "177:8997": {
      "repository_source_sha256": "7ee4579abc33e048b510adeb9597e400f9c88be2037edc752a4e4f7729dc6bd3",
      "en": "「And throw in the word 'futile' too!」"
    },
    "177:9028": {
      "repository_source_sha256": "5a4cf23b5b26e28e74b8a3a8b919e70a238c1c86a093af815af585ff12223cc6",
      "en": "「Hm? Did it shake a little?」"
    },
    "177:9051": {
      "repository_source_sha256": "30573e2b663cb93323eb16b5b41da3740354f20adcd8edcaf11c8e98dd517c18",
      "en": "「Aha! Touching it brings good luck!」"
    },
    "177:9084": {
      "repository_source_sha256": "ecd5471b766dd5c499982500074e79352172a6facce48979e178d06b89a66dcf",
      "en": "「Nice! You actually landed a hit!」"
    },
    "177:4087": {
      "repository_source_sha256": "14d2fdfe02a9b995c6cf219cc8b2ef9dc921862d650e2c53d24bcb42bfc9a5b9",
      "en": "「As expected.」"
    },
    "177:4104": {
      "repository_source_sha256": "6324ad97eb0ce0d95a101bb5749201cd0536e072029d1c356f73cc1bfe700d4b",
      "en": "「This is your power.」"
    },
    "177:4123": {
      "repository_source_sha256": "bb329076c55624411399610e537f9e13c3a7fc771f542da81c48c385f60e6985",
      "en": "「Powerless...! Utterly powerless!」"
    },
    "177:4154": {
      "repository_source_sha256": "ffad2c25e8e20924e7e2504ee521027187ef00084e92d89ccb2ba1b151f5cc30",
      "en": "「Awe makes you cower.」"
    },
    "177:4181": {
      "repository_source_sha256": "28b974bf96f4e1289517fa96d09b77a9cd5074dfa523da4c47f07c65ccdb16ef",
      "en": "「Fear makes you tremble.」"
    },
    "177:4206": {
      "repository_source_sha256": "a84cd90ac9b4f74106de6c5e2e52a443bef0430441afc38fe67a619bb8ff0ae8",
      "en": "「Even this result is all your fate.」"
    },
    "177:4239": {
      "repository_source_sha256": "8bfc818e7a375f7222203cef1056506cb9ca796deb300f65f2d91d2a1479a76c",
      "en": "「Do not ask the impossible, $$テンプティ$$.」"
    },
    "177:4270": {
      "repository_source_sha256": "a6e021764e7a1063b96aefcf86ee168c6edb63d0ace31687eae9f36739f99699",
      "en": "「I merely showed the natural result.」"
    },
    "177:4299": {
      "repository_source_sha256": "c53d180714e5fab639fb826eaf52a4214894cf83ac603b1ae29ceebe923ce82d",
      "en": "「That should teach you a lesson.」"
    },
    "177:4328": {
      "repository_source_sha256": "c9d28f92d52e6826e68e653c57e556f3a4311d0457920e2c85c547d5438ed264",
      "en": "「This is the will of God.」"
    },
    "177:8853": {
      "repository_source_sha256": "a3c84cbb26c22623661f73a472281ea989599d44eb265d34e22a33e9d98eb6a8",
      "en": "「Huh? You can't even hit us!?」"
    },
    "177:8882": {
      "repository_source_sha256": "b18108a057ab5600fcc2773f70c01e4a0540e2604464267cb16913c809846b56",
      "en": "「Ahaha, missed!」"
    },
    "177:8905": {
      "repository_source_sha256": "80699a1cc3f9db343eac31167634f645bbf24a03e05218c376aad0d9a07b2e20",
      "en": "「Dunno. That one won't quit easily.」"
    },
    "177:8946": {
      "repository_source_sha256": "b6bdf3596101a4fbe5e924b55a7e8f9187b74633ea8c7776d09197c0b2bbc553",
      "en": "「Or rather,\\nthey just suck at aiming, right?」"
    },
    "177:4349": {
      "repository_source_sha256": "ac221cacdd10a76a7aa4a2b466f9c9a3468a41e925de046fbfed19d309885dd8",
      "en": "「What a futile struggle you put up.」"
    },
    "177:4378": {
      "repository_source_sha256": "c0edbb12710495682f2c159e9698e392245c67442412572f7e8b4ea8474da693",
      "en": "「Fools cannot break the will of God.」"
    },
    "177:4409": {
      "repository_source_sha256": "6910d2a058e5fe8fe36fc06f05c3c1e9bfbf6da658b14e77208b2f1083c573f0",
      "en": "「You may not even touch it.」"
    },
    "177:8195": {
      "repository_source_sha256": "4d324be1747169d245a6c00db302756993fad60d3cbe051ad7450d0bc97a3455",
      "en": "「Be in awe... I am $$怒りのドクトリン$$.」"
    },
    "177:8236": {
      "repository_source_sha256": "9f57322f32f7d1de91b1bb691c76ec2301d3242bbb9709bbcd3ca89b0a2782cf",
      "en": "「We serve the Supreme God, father and elder brother of all parallel worlds...」"
    },
    "177:8301": {
      "repository_source_sha256": "6f118ed3439e13fbcb442c4ee4734157c8c5e04522dd4622d69f8c9bed3b6a11",
      "en": "「$$楽しみのテンプティ$$.」"
    },
    "177:8324": {
      "repository_source_sha256": "1d46d0dc98e17a5047b25d36d9426c0696f5e942c84db18415fdc87dde25457b",
      "en": "「In short, the pinnacle of all living things... no, of all existence.」"
    },
    "177:3881": {
      "repository_source_sha256": "a93ac2c6f6197bfd6f09cdb85f38e8d7a73c5e09e785d2ef4893473ddc880181",
      "en": "「What is this...? What's going on...?」"
    },
    "177:3912": {
      "repository_source_sha256": "47a61a5e8a8e3b5c97a01c02a1065a7abf0369cafef13f2d5d6527a1aa9614fb",
      "en": "「You resort to petty tricks...\\nTypical of Earthlings.」"
    },
    "177:3963": {
      "repository_source_sha256": "0feb06c46121e8646a92b834bb52852200625dea51cdd0ba9fb7b8cf489a4cf2",
      "en": "「So desperate to survive...?\\nKnow that very thing is your sin!」"
    },
    "177:4016": {
      "repository_source_sha256": "8dfb529839b61dfad9ed6824a44801e02bc5ddc775b3b871b654118cea10f505",
      "en": "「You have spat at heaven itself.\\nIn time, you will learn it.」"
    },
    "177:4969": {
      "repository_source_sha256": "d006c22d34d68a65353f2af0eb31910a110b4be3ca76f032c15be4c993e54cc7",
      "en": "「The time has come to pass judgment!」"
    },
    "177:4996": {
      "repository_source_sha256": "7196abf7ad34132d3e923ff816fae1bd6372f2731b25d575b0143c5cf7a4c3af",
      "en": "「Accept your own sin!」"
    },
    "177:5023": {
      "repository_source_sha256": "b0121e3353f4dc4e79594d80a6d457204f7b3911941aa046ea6f528d67b19af8",
      "en": "「You are guilty! Name: Earthling!」"
    },
    "177:5060": {
      "repository_source_sha256": "1d05e2e80c2a522aee185201390c2a6573c47d111205fc4639c64b76baa628aa",
      "en": "「You... now, at last, know your sin!」"
    },
    "177:5097": {
      "repository_source_sha256": "e8407f8a1541eed5638c77badc82904243a151953b107cbf7abf2de104f18954",
      "en": "「Defier of natural order! Vanish!!」"
    },
    "177:5136": {
      "repository_source_sha256": "60115415d14c0f192af4e7ed30fde92b3da2947787f4351d044156a5d728ca01",
      "en": "「That is where we are!」"
    },
    "177:5159": {
      "repository_source_sha256": "dd58c9a0af0b2b35cbcbbbba23eac944b6d238a79fd06f960877e706d0b154e9",
      "en": "「The one who judges you...!\\nIs the one sent from heaven!」"
    },
    "177:8632": {
      "repository_source_sha256": "9a03a6a1697e9d01756e7f2b3c488088101ac7b78f4768c4c19a8262fbe494e0",
      "en": "「Trying to run is useless! Here!」"
    },
    "177:8673": {
      "repository_source_sha256": "2ea8e7c9dea7eaf262a234a7cd94085ded369e3b6970ae69250e90dcda81dbe7",
      "en": "「Let me hear your dying scream!」"
    },
    "177:8712": {
      "repository_source_sha256": "3f75244371d2ea481007802a80989adbb7b9b1ccd735b7875296f086f4f1d92b",
      "en": "「Ha ha ha ha ha! Ahahahahaha!」"
    },
    "177:8747": {
      "repository_source_sha256": "27d4b2248738246417f981e60588e2974e00308e67dfaa002f8552e3cc9af4e2",
      "en": "「Hee hee...\\nStill unaware resisting is futile?」"
    },
    "177:8802": {
      "repository_source_sha256": "7bff9ed02b38d5d20a8251bb5e17d751c51d8e83c54852162da1d8b4438112e4",
      "en": "「A place humans can never reach,\\nno matter what...」"
    }
  },
  "speakers": {
    "g177": {
      "token": "$$ドクトリン$$",
      "basis": "Voice set is shared by the two Prodikium pilots: Doctrine (formal, calls enemy 汝, God's will, addresses Tempty) and Tempty (casual, calls Doctrine by name); intro lines are Doctrine/Tempty's 怒りのドクトリン/楽しみのテンプティ"
    }
  },

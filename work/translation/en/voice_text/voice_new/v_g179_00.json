{
  "schema": 1,
  "rows": {
    "179:640": {
      "repository_source_sha256": "8741627869a7049bb875337fde694d2cedc3f958b8b1aeb2081118d49dcb9128",
      "en": "「All right, let's go.」"
    },
    "179:661": {
      "repository_source_sha256": "20781b025a4028e9ca47f0206b7309e529fc815f81777a30cef137d39f7d25d5",
      "en": "「Engage...! Not my style, though.」"
    },
    "179:702": {
      "repository_source_sha256": "9c4ce0a7dabad199f8e6f25d593d7072f84e5ae4932d2a02da586e3909a2d51d",
      "en": "「Once I'm on the battlefield,\\nI'm as ready as anyone.」"
    },
    "179:751": {
      "repository_source_sha256": "46818c7e0ea4d19fff193c530e4c7a4f3a419179155185516d7e207c6f5806b6",
      "en": "「No $$Ｚクリスタル$$ unless we go up front.\\nWe've got to do it.」"
    },
    "179:812": {
      "repository_source_sha256": "a01b132f9c92a273ec9392379309cb1879e975f3923ae9b39d3fbb53ee4afdbd",
      "en": "「I'm counting on you, escorts...!」"
    },
    "179:843": {
      "repository_source_sha256": "f1ec09a5e9a3ec0fff16c66bd1245b51682e517c9036657e9987cd8aa82abe0f",
      "en": "「This $$ソーラリアン$$ is carrying\\nhumanity's hope.」"
    },
    "179:896": {
      "repository_source_sha256": "d079edc1ef5377b4fadfe00847255582e0089a57cdc4e9e38a7b17eccfa8e08c",
      "en": "「Behold the pinnacle of human wisdom.」"
    },
    "179:931": {
      "repository_source_sha256": "ce9644bc8f2b2f0f3b64512c2d9736f8d96821f223b894c5805bdd3d34a01a10",
      "en": "「$$ソーラリアン$$, top speed! Moving up!」"
    },
    "179:974": {
      "repository_source_sha256": "d6536d448b3dc751be6c86233a9e656905d1baf2807ebdf82df40b31c042d6de",
      "en": "「Let's do this, AG.」"
    },
    "179:991": {
      "repository_source_sha256": "0fc0b5aabb84d8a50dd0bd7f492709ea0f546b2bf8879027ebe51cdcca80ecd9",
      "en": "「You never miss a trick. Impressive.」"
    },
    "179:1020": {
      "repository_source_sha256": "edefcd07f45f2287976459d9a8d88eb634c89fadcb17ae17be0620d011993cac",
      "en": "「What's the $$Ｚクリスタル$$'s status?」"
    },
    "179:1047": {
      "repository_source_sha256": "eb5370947e81c0c0243c83fc047c26d816967d7258f354ce2935cd71f53b56fc",
      "en": "「I'm not the type to be called\\nthat, you know...」"
    },
    "179:1098": {
      "repository_source_sha256": "eadab216866bc4b9703b2ff9940cee6fed73bd5eecb28e56fb6ada2442adbffa",
      "en": "「Main, sub, MGs, missiles: all ready!」"
    },
    "179:1141": {
      "repository_source_sha256": "43a4a1988eb8b4b84ece13915c9a935781e6ee135c47be658bbb24b473ae1b5a",
      "en": "「Good eye, customer...\\nNot the time to be saying that.」"
    },
    "179:1288": {
      "repository_source_sha256": "56aab97020fb20ea72f3164deae98b09f7219fbbbcccf5ac8b40b4e8c9a43c5d",
      "en": "「Have to, if only to protect Earth!」"
    },
    "179:1331": {
      "repository_source_sha256": "99a27de3baaad45cbcd4945a00252ebcfdac65175413d9eb73df1c2cd2d91623",
      "en": "「We focus on holding the line here!」"
    },
    "179:1372": {
      "repository_source_sha256": "258e697fcab362be6d739e5b62dcfeb37a7c464169d1db879ba7985f3289031d",
      "en": "「Our opponent is $$バアル$$ of $$バアル$$!\\nNo need to hold back!」"
    },
    "179:1429": {
      "repository_source_sha256": "7df14f5efbbbe077134752f26a75e120cbb2b27fe7c5d63685fcd358c1a80540",
      "en": "「We're a mass of life's power!\\nWe won't lose!」"
    },
    "179:1484": {
      "repository_source_sha256": "e892b55af09517d9ffc809d0a046cd8bd3dae09d291e916cb18785f98c83b2aa",
      "en": "「I'm not naive enough to sit and wait\\nfor $$バアル$$ to destroy us.」"
    },
    "179:1545": {
      "repository_source_sha256": "bcd91937682abe2ecedbae168b9792b63eb731f1d42ecb7a063a02951da4fdba",
      "en": "「Monster hunting's my trade too.」"
    },
    "179:1580": {
      "repository_source_sha256": "cb884680ba38f045d53e8a3b81cd4834a28bd3eaae96fc2f19a0cb4e84fc10f0",
      "en": "「That face looks wicked for a god.」"
    },
    "179:1619": {
      "repository_source_sha256": "6c6a7101f95b6b61e462b8624d6562b6c2d0de0e4c86fa1f49133de70d3775b5",
      "en": "「Gods come in all kinds,\\neven poverty gods.」"
    },
    "179:1670": {
      "repository_source_sha256": "0d5beba959005cc783ca8ee3b0b7e28defbaa1d41a1045de70a4ce9d4fd25177",
      "en": "「Your sophistry doesn't move me.」"
    },
    "179:1707": {
      "repository_source_sha256": "a089edb03ee1a67b99e9924496b7caa65099bcc25082d56a2cc149b5d59512c3",
      "en": "「I have zero interest in revering\\nbrute force.」"
    },
    "179:1764": {
      "repository_source_sha256": "07de3808aad84fb47bd52fcd5f218577b8b32b6c80142bc427a8fda07c7e88f6",
      "en": "「I'll finish you off quickly\\nand get back to my lab.」"
    },
    "179:1819": {
      "repository_source_sha256": "3f862e9d2e59f30bbb08e73b882812ebca9502c5726c03f6a41720309e9ce7e2",
      "en": "「I'll put your data to use\\nfor humanity's advancement.」"
    },
    "179:1872": {
      "repository_source_sha256": "e538e1cb950f167686952cba372f0239ecdd0c8bde36ad1109aa3b1c844bb0e8",
      "en": "「The fight's nearing its climax.\\nTime to take Earth back.」"
    },
    "179:1933": {
      "repository_source_sha256": "a7a63ada626bdb2de20f7ae634eeef198fce93fce6db853d0ce96b96cb907fa2",
      "en": "「We can't let you do as you please\\nwith Earth's $$次元力$$.」"
    },
    "179:1998": {
      "repository_source_sha256": "6bc8f222da5215c2e3b206b6475ce566132baafb8783fb0a344ba6747ee0c03e",
      "en": "「Attack target, $$サイデリアル$$!」"
    },
    "179:2027": {
      "repository_source_sha256": "833607d4150752a474447d63f502842e30175dad3ed39b136672ed5a7832853b",
      "en": "「When it comes to selfishness,\\nyou and I are quite the pair...」"
    },
    "179:2082": {
      "repository_source_sha256": "7b609a8fadf1bd283c6f8e0e03172769c685a4debaa722bd55f138e75f08d73d",
      "en": "「I know the $$スフィア$$'s traits\\nwell enough, I think.」"
    },
    "179:2137": {
      "repository_source_sha256": "db495ff2b2d8fc0492aa938adfaa401c501237e6e17a5d9b04bdd8f307a66a5a",
      "en": "「$$Ｚクリスタル$$ versus $$スフィア$$...!\\nA clash of $$次元力$$.」"
    },
    "179:2194": {
      "repository_source_sha256": "ae66d1b6492d1c0c9feff4b70e78110300ea6abcb9c299f10ca80c91ad369561",
      "en": "「Make me believe that confidence.」"
    },
    "179:2229": {
      "repository_source_sha256": "431e15f3d2408a647256d7979db8c9e2e2df52728760c000896f32a35f41e658",
      "en": "「That machine of his...\\nSeems to use Earth-based tech...」"
    },
    "179:2286": {
      "repository_source_sha256": "274e53bd5cc0c3ad88ff2e57603c76ed027ae61b8c6428ef791f7f8191314df9",
      "en": "「I see... I kind of get why that one\\nhates $$クロウ$$.」"
    },
    "179:2353": {
      "repository_source_sha256": "532f8cd38269df1623d662bfed908d05b1fe9483824c23796ffec34ab1b13029",
      "en": "「Fighting a bull head-on's a bad bet,\\nbut we've got no choice.」"
    },
    "179:2410": {
      "repository_source_sha256": "4c1b410193f0df7b2dad068dbaf0aece27c1dc69a17266573524b9a25a5322c8",
      "en": "「A $$次元将$$ and a $$スフィア$$\\nteam-up... This one's tough.」"
    },
    "179:2465": {
      "repository_source_sha256": "d20422f0276abda05afa20450a4328240926318f5a0d0eb8cecb0af062c68dd7",
      "en": "「Your existence stirs\\nthe researcher in me.」"
    },
    "179:2516": {
      "repository_source_sha256": "f1e1e6995e28e20bf9e0c606922791280911459c98a478ecb5ed497a328b1a3f",
      "en": "「Not sure how, but I'm starting\\nto grasp what you really are.」"
    },
    "179:2575": {
      "repository_source_sha256": "6ebf68eb094e32cf9d0ed1579f7ebfa4ffe31b8ee10d5b91e2b2ffa83873194b",
      "en": "「Love is blind, flaws look cute...\\nNo point talking to these guys.」"
    },
    "179:2640": {
      "repository_source_sha256": "74163baae37f918e3f5b631e07abe65cbab4bd390034540f13c5bd33e45afbe2",
      "en": "「If we can't beat these guys,\\nthe $$御使い$$s are a pipe dream.」"
    },
    "179:2703": {
      "repository_source_sha256": "95558f5128ca893822d004075a44533e96d356879a6392d505fa817aa040dc14",
      "en": "「Call them watchdogs, I suppose.」"
    },
    "179:2736": {
      "repository_source_sha256": "2067f20773956c49f542e59c347a6670cde6e1960c6172d519f649e990d6469f",
      "en": "「Time to finally fight these guys...!」"
    },
    "179:2775": {
      "repository_source_sha256": "40094eb517cd1a151c73875a2e4a24b036ac668ecc42fd4045fba6524f62a8a9",
      "en": "「I'm going to study what you are\\nin depth!」"
    },
    "179:2828": {
      "repository_source_sha256": "28c0db0c7da17a8a1a29c345293fa19a56ec64b73dfc5f8ee12bd1031fc59ca1",
      "en": "「I'll teach you humanity\\nisn't some pushover!」"
    },
    "179:2883": {
      "repository_source_sha256": "7ee0816f039a60f5b9c628a6a301ccb5eaf9d0c3f2338f97f9fa38ab2d227b6d",
      "en": "「Ready, AG?\\nOur opponent is an $$御使い$$!」"
    },
    "179:2932": {
      "repository_source_sha256": "54835b51c50c05edd73659026e5a416d9ccd39e2da6c7e07ecdb9e8df3e7bc42",
      "en": "「I'd like to hear your logical basis\\nfor condemning humanity.」"
    },
    "179:2997": {
      "repository_source_sha256": "81e057d6bfb6bc911d27589497097ca3d710e1497c1ee2ff80fddf74c74c04d0",
      "en": "「So their concept is the same as\\nthis $$ソーラリアン$$'s!」"
    },
    "179:3064": {
      "repository_source_sha256": "a55213b591e130f24092db63769fb6ef2590b2f96d9d4e850cb928ded83834c7",
      "en": "「Some things in this world you\\ndon't do just for fun!」"
    },
    "179:3127": {
      "repository_source_sha256": "0d49ce14ea95497af765dac82907a9087129cdfef09ab76c1dc52df134bab596",
      "en": "「You've sure looked after\\nour $$クロウ$$.」"
    },
    "179:3176": {
      "repository_source_sha256": "2c84c34d2a58e9e28e7fe50567f2049c5ea32c5cdfd3b67f52d35ecddf563227",
      "en": "「This man... still hiding something?」"
    },
    "179:3213": {
      "repository_source_sha256": "fd559d2e7b6b165f628d4ff5b6ffd1febe00556698de9180b312514e3c6b0b27",
      "en": "「As for shadiness, we can match you.」"
    },
    "179:3256": {
      "repository_source_sha256": "97c57efdb7a75d6742cb968f8ad9faf445e4bb71386ecf215000e26ff6857d21",
      "en": "「We've got plenty left to do\\nin this universe yet!」"
    },
    "179:3325": {
      "repository_source_sha256": "1a31268d98ccd632043ce0dae32357463f5fc39979c60a6e2c3754cb4c4cdf25",
      "en": "「Sorry, but your joy is nothing\\nbut our trouble!」"
    },
    "179:3386": {
      "repository_source_sha256": "a442b998379abdb0c82f00c4235ce8a50f67756c8292b38877e4b562ed4750f7",
      "en": "「Full of spirit! Let's go, AG!」"
    },
    "179:3419": {
      "repository_source_sha256": "6fb689cfbf475205c33f9d13fce1c419fb2cb84ed7ffc7663aae044f9838c8a4",
      "en": "「AG! We're going all out!」"
    },
    "179:8179": {
      "repository_source_sha256": "02776df9a835f56fbb3aa30d3d22a2ccec4e0dfab31cb2291c305f90b3a4d9bd",
      "en": "「Well then, time to open shop!」"
    },
    "179:8206": {
      "repository_source_sha256": "b4758a3ad4202e7d32414cbd2700315ee87e440f757322de77432ea8702cdc0d",
      "en": "「Big sale, losses be damned!」"
    },
    "179:8247": {
      "repository_source_sha256": "f7f384abd3d6e41170498cf5b394c985073a98d611a6416704c3818497c3d84e",
      "en": "「Sola-sola-sola, $$ソーラリアン$$!」"
    },
    "179:8282": {
      "repository_source_sha256": "4e71d5ca202ffcffc964ee998b26900a63164fdb082fcad48e25b5308793411b",
      "en": "「I'll give it my all as well!」"
    },
    "179:8317": {
      "repository_source_sha256": "50f9b71e05fa08d7f9d2fb1eedb0312650a30c1a3900cee9f42472f509f804b1",
      "en": "「$$Ｚクリスタル$$ and I are both shining!」"
    },
    "179:8356": {
      "repository_source_sha256": "3d6b28a9ce42bf6c9c09b482da737b7316238458e17ff415342f84e814df1c19",
      "en": "「I'll deliver the $$Ｚクリスタル$$'s glow\\nto everyone!」"
    },
    "179:8407": {
      "repository_source_sha256": "646a35baa5efbada5b570ab60d33528a70db96545f3b4a23498660fa2c620835",
      "en": "「I love you~! Here I go!」"
    },
    "179:8440": {
      "repository_source_sha256": "40b64393b7961f8e0a9ab3bfee919542b5b9dd2bb9ddd042914dfc7f0de72938",
      "en": "「We're not in a position to pose as\\ndimensional bystanders!」"
    },
    "179:8499": {
      "repository_source_sha256": "b923b3513839080b538279f627c1abc8df52d43a1eaa49ed925c79881ef237c2",
      "en": "「Hello, me!\\nGoodbye, you!」"
    },
    "179:8548": {
      "repository_source_sha256": "9275eca6b05522ad8c1a7c5b21776fb31b23c5cfec3ba87d7a9be2603badc5a2",
      "en": "「Weeelcome to my...\\nBeauuutiful wooorld!!」"
    },
    "179:8615": {
      "repository_source_sha256": "d5ae1fee58b75902feabb6ef65476ba44b49e8bb999ed39a61338d0aba134013",
      "en": "「Another energetic day... Attack!」"
    },
    "179:8658": {
      "repository_source_sha256": "b4fa5e621582c00c4eda52ccc6227f1702be0e4b2ee4278cd2a0fc155ffab2af",
      "en": "「Enemy search complete!」"
    },
    "179:8683": {
      "repository_source_sha256": "096135bdadf669f8772682d4787bac47ec482f2371c95ddc93928728cc3a53e1",
      "en": "「Perfect! Shining bright again today!」"
    },
    "179:8722": {
      "repository_source_sha256": "4edd62b79f12f0b54a72491f0a32726d6df216050f49c8082fff0c8a0db68547",
      "en": "「Captain, your orders!」"
    },
    "179:8743": {
      "repository_source_sha256": "a9589c1928133d22ff02036e73980c609c6836b893e65f641639ffdb6956c703",
      "en": "「I'm supposed to do all of that!?」"
    },
    "179:8782": {
      "repository_source_sha256": "d291ef0a868cf5ec0f4ebb16114110e777559391794b0da994b6972f7b4d0fcc",
      "en": "「The enemy's closing in on our ship!」"
    },
    "179:8874": {
      "repository_source_sha256": "a0e593b19f5bd82c97ad04c53273ff9ce11146f7f9888d18f3a5a86b06e30cae",
      "en": "「Let's make it flashy, with all our\\ngrudges so far!」"
    },
    "179:8929": {
      "repository_source_sha256": "928063582d742c51ea89df2ad8e6ab92ec77594ba91e5e93f4bdf61eb86f0ca8",
      "en": "「No mercy for brazen invaders\\nwho trample everything!」"
    },
    "179:8980": {
      "repository_source_sha256": "dc8f16e1f0ec6bed38ea4ef2cbcfd6fd57ec03eb325eb8bd823d2fc1f3bd8cd4",
      "en": "「It's $$スフィア$$ versus $$Ｚクリスタル$$!」"
    },
    "179:9019": {
      "repository_source_sha256": "4a88d1054d01cdd10543cd8b717fc461c091afbdfea56fff5286a9ee6d57f1e2",
      "en": "「Captivated by $$次元力$$,\\nI came all this way!」"
    },
    "179:9076": {
      "repository_source_sha256": "7983746ed42bbd18197edb1e71e6bb1cff4ed9fede7afa423dcc0725ce3a41db",
      "en": "「The $$Ｚクリスタル$$ I refined won't\\nlose even to a $$スフィア$$!」"
    },
    "179:9139": {
      "repository_source_sha256": "693ad3ea54a8665618c40327e46d918a28ce51b9666df70c4b5d8892b343cc65",
      "en": "「Our endless, wretched ties are\\nabout to be settled!」"
    },
    "179:9192": {
      "repository_source_sha256": "1154772673ddf2b6a2364980365fc9352bfc0771dae6a008522eeee05645ffa0",
      "en": "「Let's do this so neither of us\\nhas regrets, $$アサキム$$!」"
    },
    "179:9255": {
      "repository_source_sha256": "1957e2b00af341655afd646ff2ee7df9194ac65df74fcc52c156fa0305da30f9",
      "en": "「Wagging your tail at the strong...\\nThat attitude is disgraceful!」"
    }
  },

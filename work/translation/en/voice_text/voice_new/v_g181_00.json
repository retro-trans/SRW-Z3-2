{
  "schema": 1,
  "rows": {
    "181:2234": {
      "repository_source_sha256": "59454c080881aeed5376a4bd4c249e51ff5e35d3c2c63e86405428824fd43510",
      "en": "「About time.」"
    },
    "181:2262": {
      "repository_source_sha256": "ffde10dbc6be3c4802115c27cedff264eb23cd2b9411a459939d626d21ba589f",
      "en": "「An opening?」"
    },
    "181:2277": {
      "repository_source_sha256": "7faa81d7cde4d1dab972891b0cb7a40c4376634fcce1251276b15b5cf2c6c80d",
      "en": "「Almost time...」"
    },
    "181:2769": {
      "repository_source_sha256": "0b9fcaeef7ea807591165882b204a5340a1b320a28b6e4c4ab1d8e98e4d120a8",
      "en": "「Questions can wait.」"
    },
    "181:2788": {
      "repository_source_sha256": "81aa628b6afb8c94516bb1e3be192575434d2a12a4f7ac67838e752079d2b151",
      "en": "「You're an enemy. I won't hold back.」"
    },
    "181:2819": {
      "repository_source_sha256": "36263fb0100a9283f2d848ebdffaad2328c6a70fa6a44ef78fbb9b1bb6f1a6c0",
      "en": "「I'll thin them out, even a little.」"
    },
    "181:2842": {
      "repository_source_sha256": "69b689bb95e8b9cb05795aef89d0426d6fb1283f596976230e9810660b454314",
      "en": "「So this is humanity's natural enemy.」"
    },
    "181:2869": {
      "repository_source_sha256": "1aed034d21f4978144e352616056dfcb887a889992c7fde3e9ca91f1e20aa0fc",
      "en": "「True, they differ from past foes...」"
    },
    "181:2904": {
      "repository_source_sha256": "943cee138e8c516b0626818897067121848d3eb626ea75b077cb2f92495a74d4",
      "en": "「Target: $$宇宙怪獣$$. Destroy it.」"
    },
    "181:2933": {
      "repository_source_sha256": "73d8b81a8c78424b4c2aaa5aab32d61bc20af7a6cc8e2f5a44dc8fba9a95f179",
      "en": "「If you mean it, I won't stop you, but...」"
    },
    "181:2976": {
      "repository_source_sha256": "4666592f1d11e16de7973435df0bd7d843906a60e092f44102f166f082590b34",
      "en": "「I'll hold the damage to a minimum.」"
    },
    "181:3005": {
      "repository_source_sha256": "c1c139228e197af52074b3a230468fabbd4f67f4b720f212e0186d4295b18d7d",
      "en": "「Stop the unit and they can be saved.」"
    },
    "181:3042": {
      "repository_source_sha256": "bd76b2cabb70f274a4388f30c190f66998d0c99ae6e3c51f5462532a96cba4f6",
      "en": "「A unit is only as good as its pilot.」"
    },
    "181:3081": {
      "repository_source_sha256": "0979e53d76787397b98a98d0ba1dfe71607ca555c096a18189c582fc89586341",
      "en": "「Let me see the new Gundam's power.」"
    },
    "181:3122": {
      "repository_source_sha256": "a6a630699ba2b03d11c4ffab6ba7073feee2385fb610927880bc88eedad2a09b",
      "en": "「A Gundam. Don't get careless.」"
    },
    "181:3159": {
      "repository_source_sha256": "a9400c2fd9d1c09bda5d819eeb1abec5365ded2298e46bf378f04dec826f1452",
      "en": "「Keep waging war, and I'll face you.」"
    },
    "181:3200": {
      "repository_source_sha256": "56b3879a571a89a33c826ad42d862777695a8c344903134d04b55200c8452bdf",
      "en": "「What you're doing is a repeat\\nof a sad history.」"
    },
    "181:3253": {
      "repository_source_sha256": "07ca9f299a2777b5758219077c5d90f74eb673dacd98f42b384cf88a3f47499b",
      "en": "「Your heart seems to be empty.」"
    },
    "181:3284": {
      "repository_source_sha256": "144969cd6876d9025053638cfcb885fc61ac1bf76353e978f6a08a71763e7324",
      "en": "「I'll take down the $$赤い彗星$$.」"
    },
    "181:3307": {
      "repository_source_sha256": "65106494d5576a46825fae1bdd3d760ef65af4e93545ef16cd81a3c38e73319a",
      "en": "「How sad, a woman who can't cry.」"
    },
    "181:3344": {
      "repository_source_sha256": "54751b0f48ee70ec91ec803ff63ab016f8efc40f933811eb75042086493f4157",
      "en": "「I won't hand the world to someone trapped in the past.」"
    },
    "181:3383": {
      "repository_source_sha256": "4cdd9f1301efd119a794bec0b9c49dcfb5885cfa4cc1d42c8c9a3fd0ef68478e",
      "en": "「Looks like I can't lower my guard.」"
    },
    "181:3416": {
      "repository_source_sha256": "6f6bc8add91d415ea0547f74dad56dfb96f441dda306983f8790c340a87c5460",
      "en": "「We should drop the commander first.」"
    },
    "181:3455": {
      "repository_source_sha256": "b84a4f61e64dfaf965f5c838a2afb822ed66ab77ea34186524c7dec2ea30d58a",
      "en": "「Target: battleship. Destroy it.」"
    },
    "181:3488": {
      "repository_source_sha256": "7e110cb9f1dc262643a56f9d514fb92a39071aa45716d6ac1b5e2919c4c6370b",
      "en": "「Just hold out until dialogue's done?」"
    },
    "181:3529": {
      "repository_source_sha256": "5a42bea4cc4a2f0e2e384a18fa80ba79808325d826dd7afbbb5b6ae032b71a8e",
      "en": "「If we hold the line,\\n$$刹那$$ will do the rest.」"
    },
    "181:3578": {
      "repository_source_sha256": "58bd75daa1a36d3bc2f04e0156f7982bc54f052a06d5c7bdbccabe67e9ae9511",
      "en": "「How pitiful, a life lived\\nonly for fighting...」"
    },
    "181:3629": {
      "repository_source_sha256": "788db61cb227330a50fad05dcfa52f0f2f93242d8f6dcc62e12fcc1d6047e98c",
      "en": "「Autonomy resembles emotion, yet differs.」"
    },
    "181:3672": {
      "repository_source_sha256": "825c8dea65f1b4f860774e707d43dba12223b6330084dd95bcc513f1b6412195",
      "en": "「I've seen enough of people's tears.」"
    },
    "181:3711": {
      "repository_source_sha256": "be6779f88d79c5f6624f418a51b3270b102ec5edbec3b0b245b55a71cc289b20",
      "en": "「Selfish people can't lead the world.」"
    },
    "181:3750": {
      "repository_source_sha256": "bd0d4ff097a503e2a83d50f0526013acf39d0ab05ec7aab6901c14ff00cffaa4",
      "en": "「I'll annihilate the invaders.」"
    },
    "181:3771": {
      "repository_source_sha256": "21cce1eee29b94c81993e296b822beb316f01459bd63f157c698b8375c480168",
      "en": "「I'm taking Earth back.」"
    },
    "181:3798": {
      "repository_source_sha256": "08859e04b26289cfed09a9488bf94a3d1ad4054b874a2be6d3d3ce61ac9da9e4",
      "en": "「Attack target: $$サイデリアル$$.」"
    },
    "181:3825": {
      "repository_source_sha256": "0b048dfd2ec0a126e0d6416ec16c196847ebd45977811d368e95993a015acc34",
      "en": "「Mastered it? That's trouble.」"
    },
    "181:3862": {
      "repository_source_sha256": "6a6bd8cd7a9176e4d9d368fedca99be005d890116abd6e963395e731992eb3ff",
      "en": "「Even a Reactor can't be absolute.」"
    },
    "181:3905": {
      "repository_source_sha256": "59fa28313014162f65876e7a19a60bf659b8a6ecaf6410102faf04619a0c10c4",
      "en": "「Not like any Reactor I know.」"
    },
    "181:3938": {
      "repository_source_sha256": "229fb4905ea8879163340b149fe444c33c9db49f783cde97459257e4933aa4a1",
      "en": "「So it's unlike any opponent so far.」"
    },
    "181:3977": {
      "repository_source_sha256": "cc8942bb1205f356f1dba0e2084aae443b0e426ea6ce9932c4377886fd35f40c",
      "en": "「Emissary of God? Laughable.」"
    },
    "181:4006": {
      "repository_source_sha256": "90fd0ce87bdbdfc3269aa58d3951226e4891e93b6b281a4e047c584738e055db",
      "en": "「True, it's beyond human knowledge.\\nBut...」"
    },
    "181:4055": {
      "repository_source_sha256": "b8fe02634bf12d38813b9e1814873ae769368181ec984543fa67e4cb0732043d",
      "en": "「You turned enemy. I show no mercy.」"
    },
    "181:4088": {
      "repository_source_sha256": "a2cc2957e1c4fd5a768d3db50646811833985b7890b108cf8039df43fd9b0c18",
      "en": "「Shame. Some people believed in you.」"
    },
    "181:4131": {
      "repository_source_sha256": "57162c17b66749beddcf73f84a8ceca608056e5594d25c67cbd7ffb32d908020",
      "en": "「Do you have the power\\nto look down on humanity?」"
    },
    "181:4180": {
      "repository_source_sha256": "1c0417554cad0b3ed1f46dcaa668d3ec094db74da62f8c1bf8d105a9d4580a50",
      "en": "「The name of God's apostle ill suits\\nsomeone steeped in greed.」"
    },
    "181:4229": {
      "repository_source_sha256": "bdfe91427a00175440bc889a0bf3f87d725ce2bec2e8a6990d48baeb4ffd825f",
      "en": "「Sorry, I won't play along.」"
    },
    "181:4268": {
      "repository_source_sha256": "75aae948358fd2f2608fbd2923996f72f0d7501d3a0e061f1d93922e9f69a181",
      "en": "「$$アサキム・ドーウィン$$... I'll end this.」"
    },
    "181:4305": {
      "repository_source_sha256": "faedf527f2600f37faaa47d53133badd49ea23c384895d66926276af14a70fbb",
      "en": "「My final... performance.」"
    },
    "181:4330": {
      "repository_source_sha256": "354712c35bf59de4bbffbf9faaf386c386689fec40e9e505536846aa3629e9a0",
      "en": "「$$アドヴェント#pilot$$. You're a pitiful clown.」"
    },
    "181:4367": {
      "repository_source_sha256": "7acfdd1c77dd8e230bc30ad4bf27083cc092534c122bfcf4f252bc717554a5f0",
      "en": "「The world and I will\\ndefy our fate of death.」"
    },
    "181:4544": {
      "repository_source_sha256": "896e387a6002b2830fb3e80c0770704fd76d41338db657b60d1ff98ee007b99d",
      "en": "「Commencing counterattack.」"
    },
    "181:4563": {
      "repository_source_sha256": "6c75c18185e47c39b21d3ed936f291261118c2668815e5a0717504aa4ebeaead",
      "en": "「You hit me, so I hit back.」"
    },
    "181:4590": {
      "repository_source_sha256": "7258041404ec5947f4918091144e79c1bfd71e8ed9ffb0baca40c7e679bdbacd",
      "en": "「I'll return the favor.」"
    },
    "181:4634": {
      "repository_source_sha256": "29bc4ec87dcd7f60578637db297ed925aca1ff6f7697351be98d82f15447251a",
      "en": "「So it's my turn.」"
    },
    "181:4663": {
      "repository_source_sha256": "f937c028e0c592367edfee6bb2b6e31add15a06df8c24af1466f6fa1003dea22",
      "en": "「I can catch up easily.」"
    },
    "181:4684": {
      "repository_source_sha256": "f7c468c49c9b6f2c72e5364b313c12069875bc2939399976634f0843f54821b4",
      "en": "「This is more certain.」"
    },
    "181:4703": {
      "repository_source_sha256": "55e178c0760310c52e09efadad05cf0721d203bffedf18e20a8cd47a849aaee5",
      "en": "「Leave the rest to me.」"
    },
    "181:4730": {
      "repository_source_sha256": "b898cf4dc2b3dd61610cedf26c357fcb0326920a60be87de07f60e7222cf90a6",
      "en": "「Impressive, $$ヒイロ$$. You're thorough.」"
    },
    "181:4773": {
      "repository_source_sha256": "2d4b5fbac648507647ebfe29b49b6fa4d59353763695df1dfbcb7614ebaca9cb",
      "en": "「A shrewd attack, $$デュオ$$.」"
    },
    "181:4804": {
      "repository_source_sha256": "80543fefad55f4404c591b9c23256deab3667f789c7db13c6dc51cc72b2d9fe6",
      "en": "「$$カトル$$, you go on ahead.」"
    },
    "181:4831": {
      "repository_source_sha256": "e9fbed51eeab698b47a38bed9302f67b91610520824d19499e934add023cf9cd",
      "en": "「Leave the rest to me, $$五飛$$.」"
    },
    "181:4852": {
      "repository_source_sha256": "04a41858dfb1d584701d800854372ee8133768ff05de649c5eba121d6a00a76b",
      "en": "「That's plenty, $$ヒルデ$$.」"
    },
    "181:4871": {
      "repository_source_sha256": "eb0f93535aa7856c711e7aff6047dede347a45081be85ae06e7d3794b6cb8440",
      "en": "「Impressive, $$ゼクス$$.」"
    },
    "181:4894": {
      "repository_source_sha256": "652ee2f269f1170f5f8932ea558ce9c9391c52de274ba06e62e0b2e55454883f",
      "en": "「$$ノイン$$, I'll cover you.」"
    },
    "181:2725": {
      "repository_source_sha256": "dccb7daa543a5deeed947966c65827a5d1e79b1af3023e18e1e89c8879fd7d4b",
      "en": "「Strike all at once.」"
    },
    "181:2740": {
      "repository_source_sha256": "91d52d334c590207b802e4a4b3e86cbe7dcf389842056351b1c3f8a3d2c3d3d1",
      "en": "「An opening to exploit, it seems.」"
    },
    "181:5288": {
      "repository_source_sha256": "c4b44eb7162039f67a44810800dd10d48ae4d412646b6875d372960dfad545ff",
      "en": "「I'll pin that one down.」"
    },
    "181:5311": {
      "repository_source_sha256": "34df155d3943b802dd4e573bc6d28ce2e73f6909737feadd92677575bb245c30",
      "en": "「I'll draw the enemy's attention.」"
    },
    "181:5338": {
      "repository_source_sha256": "a10a25cfe3ea1e48cd3f53fd5ea1222aefca9334f4bf299abab5b0bd43d43ae5",
      "en": "「I'll take the lead.」"
    },
    "181:5353": {
      "repository_source_sha256": "0e91dcb23cb0ae83fa7e9d5a34a3b1e2caa52bf437d2d90eb82ea4597484adee",
      "en": "「I'll open a breakthrough.」"
    },
    "181:5182": {
      "repository_source_sha256": "b82201b642f8095c4b0da16c57c0c0684c24645cf70dbc10a4698998254674ee",
      "en": "「Then I'll leave the front to you.」"
    },
    "181:5205": {
      "repository_source_sha256": "907666fecb827d2abec99ac965017c0cbcf0b14ec4213acac0746267a7648b2c",
      "en": "「Pick them off one by one, then.」"
    },
    "181:5230": {
      "repository_source_sha256": "3a55f284d08e1502cd3fee2a84fcdf8542cdd9ba9a36fc42b866f1b03fe3ff1d",
      "en": "「So that one is my enemy.」"
    },
    "181:5249": {
      "repository_source_sha256": "232a32bc8a13bff7eee77198f7c519470210273e6a553c77b2d6bcc2a6f55e01",
      "en": "「So each of us plays our own part.」"
    },
    "181:6266": {
      "repository_source_sha256": "1ffe27ecb79dc0259a3219573bba64f433679afa90987a0daa2855ba1639607e",
      "en": "「Damage rate... past the limit...」"
    },
    "181:6297": {
      "repository_source_sha256": "d112538c7d31697bcb7abc893ddd857529c9188b53eed07af56cde9f6230511c",
      "en": "「Sorry. This is as far as I go.」"
    },
    "181:6058": {
      "repository_source_sha256": "3b43dfa1bbe49a498eefddf1c82434160d4d70c893227af04e5918cb35ee5ed7",
      "en": "「You're strong...」"
    },
    "181:6079": {
      "repository_source_sha256": "689598136835ee2d0712146ac2a33cd7c05a6719444a9e9b18b28f8204eff220",
      "en": "「Situation's bad... as usual...」"
    },
    "181:6114": {
      "repository_source_sha256": "f1ac0239bfaf9e3682ab991edbd39fef1df5ba674438a266177ad5846f740d63",
      "en": "「Beat the enemy before my unit blows.」"
    },
    "181:6151": {
      "repository_source_sha256": "14b0a6ba7b924edd2249966acc8c49757512fa57fd8387e2eeb972923ee5b875",
      "en": "「Never losing hope until the end...!」"
    },
    "181:6209": {
      "repository_source_sha256": "1c67977d5e98ae5d389008936b410d2bf3394eda23d9b28174fa7f49de6069cb",
      "en": "「If I die, $$キャスリン$$ will cry.\\nThat's not what I want.」"
    },
    "181:5894": {
      "repository_source_sha256": "6c619a21b659e9d99e0e3728c61e44292c6c0f9b6002594c3720d8ab6d61c70f",
      "en": "「Not time to panic yet.」"
    }
  },

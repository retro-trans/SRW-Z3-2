{
  "schema": 1,
  "rows": {
    "181:5921": {
      "repository_source_sha256": "fd91116b8d13a04c0e902c048c8249f6c22d1d043c948197e53068f74cc60cbb",
      "en": "「I expected this much.」"
    },
    "181:5948": {
      "repository_source_sha256": "ac5a695fc8dffc7f9088b2dfca112a7ac38fe1eebb1f58080abf43df3d440e95",
      "en": "「I've sized up your strength.」"
    },
    "181:5975": {
      "repository_source_sha256": "a88c9b0433d960de100cb87cfd044682be039757bcd6d1110f14271a55db4a23",
      "en": "「This is unexpected.」"
    },
    "181:5994": {
      "repository_source_sha256": "fcac33e4b24e9a56af29e2f98e850aa4c72e290c754d8fabb88afca19ce97ab7",
      "en": "「Have I fallen into their trap?」"
    },
    "181:6021": {
      "repository_source_sha256": "c07902d357c734b3efec2c948b253e3fb2c47852637b2be190820609c15828a6",
      "en": "「Better to finish this quickly.」"
    },
    "181:5732": {
      "repository_source_sha256": "5ef30eae6137381ea12886b37fc6aa3f08322759fa2ab98d7ed1b45e7ab05bcb",
      "en": "「Is this all?」"
    },
    "181:5749": {
      "repository_source_sha256": "19103666ab648626f66aa49fb0f04f539408b56a4c895b5b25fd2182ccde1c60",
      "en": "「Looks like I got hit.」"
    },
    "181:5770": {
      "repository_source_sha256": "0d0f015ddcdef2d83feb669ec7d14e97d031a6f93c3b322ae70083068f9959ef",
      "en": "「It doesn't hinder me at all.」"
    },
    "181:5795": {
      "repository_source_sha256": "240fca516bd739ae7c290e76824b75b113b2e28e15178d0e66cde6ad59bf3fd5",
      "en": "「That damage isn't worth minding.」"
    },
    "181:5830": {
      "repository_source_sha256": "a5f35b3ab7cfadb72b1adf54a9e681a4fb5754ec4bca596e20bb2312ad0a6136",
      "en": "「Your emotions are getting ahead of you.」"
    },
    "181:5865": {
      "repository_source_sha256": "ff0f272714cd8521138002b639220cfc669ff290dd56d4dce08cb3e77c494f6f",
      "en": "「I can't let my guard down...」"
    },
    "181:5506": {
      "repository_source_sha256": "1176ba053c9e364296cc29d8528675381c95c4da7108659c44973bed70a2d290",
      "en": "「I have no intention of stopping.」"
    },
    "181:5535": {
      "repository_source_sha256": "9859a0d92876e40cbc2b2a4b4c1425a684e07cc86e338e91b2964ed715baf268",
      "en": "「I see. So that's all you've got.」"
    },
    "181:5560": {
      "repository_source_sha256": "df1020ea6f5bd736e7e9b07c977d6712b5902c28a8eed837457f508ffc148c5e",
      "en": "「I can dodge that easily.」"
    },
    "181:5581": {
      "repository_source_sha256": "b4eb4916789390c33a288e0a74fb1c6c25f6112d82f72a3285698651ae44cd34",
      "en": "「That attack was pointless.」"
    },
    "181:5606": {
      "repository_source_sha256": "b851deb2c8e0399ff56f1dc22b3552ad408b60c951ea60919d25eba56dfdbb8f",
      "en": "「You should've sized up our strength.」"
    },
    "181:5641": {
      "repository_source_sha256": "5a491b382b7d7e8bd3820eacf176f0994ada24d091e6bc13f2192d8f725c7deb",
      "en": "「Your read and aim are both sloppy.」"
    },
    "181:5666": {
      "repository_source_sha256": "3c1012f98ca799729ccb82b7c1d0746845d282310126c1b61af0e180997df381",
      "en": "「No damage on my side.」"
    },
    "181:5695": {
      "repository_source_sha256": "92612a5dd62501515e95bb9ab1034e4cc686cff1df82a1ce70909fb25d47f472",
      "en": "「The equipment kicked in just right.」"
    },
    "181:1733": {
      "repository_source_sha256": "989c578ef09bffa5a79e81dd017f2417cd97825f9b7d80ed1489b0ed5d855812",
      "en": "「They're just like we were. $$デキム$$'s smooth talk has them dancing over why they exist.」"
    },
    "181:1822": {
      "repository_source_sha256": "12e0e2b54862a53a872508884f03ea4754cf6246b12b77366c7a29fcfb43aee4",
      "en": "「Now I'm back\\nto being nameless...」"
    },
    "181:6326": {
      "repository_source_sha256": "9b7e7e4794dd5edacd30257814299e69b15b13756c0dcd449b3273e050a1e19d",
      "en": "「Moderation, or you'll end up like these two.」"
    },
    "181:6385": {
      "repository_source_sha256": "3e6edc7fa1609f9b12508dab0c1f90354826272515fbe22558ae53ebc43698c1",
      "en": "「Until we meet again.」"
    },
    "181:5475": {
      "repository_source_sha256": "84524cd11ac87e0ebb22025ff46058bfbed4e53898ca516f27ea0d53ac96466a",
      "en": "「You're keeping a good distance.」"
    },
    "181:4915": {
      "repository_source_sha256": "23ae6eb77985f310e4db6d067bf48a9079ceb6a4e05ab00942f6ae2a572b4324",
      "en": "「Don't push yourself.」"
    },
    "181:4932": {
      "repository_source_sha256": "1220598672160831e78d3bc30b64e6e4853b8d747848d4a53551549c62c88192",
      "en": "「Dying for nothing changes nothing.」"
    },
    "181:4971": {
      "repository_source_sha256": "825ef241b687853947058d3ed4ff89dd223f1ffa7e05affc31d4395134e4b0b9",
      "en": "「$$ヒイロ$$, take care of your body.」"
    },
    "181:5006": {
      "repository_source_sha256": "baf8c5d3865bd0e536af1f7fa0c620f703a110142d104b9485049b21725cbe2e",
      "en": "「Don't let your guard down, $$デュオ$$.」"
    },
    "181:5029": {
      "repository_source_sha256": "306b117a53561eeb9a2c3f444194f493e1cec38999254b6e2f43ef2f817df6c4",
      "en": "「That's not like you, $$カトル$$.」"
    },
    "181:5066": {
      "repository_source_sha256": "9e54ef3a7b09a1669807a9f595c393eaef03cfafc6e754f6cfce846734e4330b",
      "en": "「Don't throw your life away, $$五飛$$.」"
    },
    "181:5095": {
      "repository_source_sha256": "db99efbad8f789579d995457b1a09293a2e6fb6430b270549034f6410bc71357",
      "en": "「Don't do anything reckless, $$ヒルデ$$.」"
    },
    "181:5120": {
      "repository_source_sha256": "81fe39da018bc93db95493df13c89a6b6f1fbd32de5feb0a11e63fcaa1ec821c",
      "en": "「You owe me one, $$ゼクス$$.」"
    },
    "181:5149": {
      "repository_source_sha256": "72da7220e5b2b6f02a4b3f6c4f06030e48a86f99580e96e70cd8654dd5c406b7",
      "en": "「A mistake like this is rare, $$ノイン$$.」"
    },
    "181:5374": {
      "repository_source_sha256": "3d46c0465146ed023450d220b01cce2d106c4ab7179ee0d7f2f10bd219a8cf0a",
      "en": "「Can't counter. Must act fast.」"
    },
    "181:5409": {
      "repository_source_sha256": "ee0d6b35ad98466bb30c168bc0642e37447dbcba82710861eb7be65b5a211857",
      "en": "「Certainly an effective tactic.」"
    },
    "181:5434": {
      "repository_source_sha256": "3307b9d11a12c3c50f48b24d861e927fc0a42f41fbab7202080d3d589e71228a",
      "en": "「They've fully read our strength.」"
    },
    "181:2296": {
      "repository_source_sha256": "ff2af24dc6685fe3ba69d2db9944414806371b67c4e84d6499530fb087277ab6",
      "en": "「I've been seen. I can't let you go.」"
    },
    "181:2327": {
      "repository_source_sha256": "f5e0fd5c13854f7c589afe784227f2dd9db75a2b93e3ce7e01a46ee65cf67c87",
      "en": "「Sorry, destroying is my mission. I'm going.」"
    },
    "181:2366": {
      "repository_source_sha256": "47cb45dd8dbdfd23f06b55bdc296069dcf44f27e8aeab532d411f2e0a2987740",
      "en": "「As long as there's resolve, I fight.」"
    },
    "181:2397": {
      "repository_source_sha256": "eb1b1d36a7ae0436b1e2673bc1e04864ddb1786b2d76bb77a7b978285fbc14e0",
      "en": "「I'm going to act on my emotions.」"
    },
    "181:2430": {
      "repository_source_sha256": "2d3edecbdf20869f45d752bd338d407fb09f17e204ae763d0df26a222017618a",
      "en": "「How about this?」"
    },
    "181:2447": {
      "repository_source_sha256": "fae165baf43d775d14937a7b64195b869218e62e5b06560d048b5586b4d2da0c",
      "en": "「I'll finish it for sure.」"
    },
    "181:2466": {
      "repository_source_sha256": "20c48c719bf2e06c4e5af7c9b3a11629b355df4126117cae672a4405cd1e837a",
      "en": "「Looks like I'd better hurry.」"
    },
    "181:2493": {
      "repository_source_sha256": "84df0be79871287a2674699bbf6725bdc8d6bc2de5b3048f291301e9aa5ceed0",
      "en": "「You should've known this would happen.」"
    },
    "181:2530": {
      "repository_source_sha256": "39b47bd70b71d7a9f530cbcdd04e3ac4f4ef463bfbef61a9281983e6ce425cc1",
      "en": "「I strike when necessary. That's all.」"
    },
    "181:2645": {
      "repository_source_sha256": "647716f2370ab966379dab241c7827e0a721aa1821a41789432a697c2d828736",
      "en": "「My body remembers this range.」"
    },
    "181:2670": {
      "repository_source_sha256": "ceeb5f50fcbf5137040bfebac11cc27d1949961092b9583c9e7bfceed90af658",
      "en": "「A good range.」"
    },
    "181:2687": {
      "repository_source_sha256": "315770ee1a03428871f7bae3c42ee05c2f2465c468a0d340251ca626804cc578",
      "en": "「At this range, this is the one.」"
    },
    "181:2712": {
      "repository_source_sha256": "48bdc94b8db8475318f47bbcbd1fe4662dd6d6e17b46c1af3ec59dc5e787a6b3",
      "en": "「Close combat.」"
    },
    "181:2584": {
      "repository_source_sha256": "23c0ddb315942dc659b98ca051d71fdc397fe874b10b3ac9b3d2e6f63edb3b6f",
      "en": "「Locked on.」"
    },
    "181:2597": {
      "repository_source_sha256": "1466d71c426ab0cc8354b510d3842390778bdbcf768e3b1126a55e8a67bc7b25",
      "en": "「Your movements are easy to read.」"
    },
    "181:2624": {
      "repository_source_sha256": "d65203fbfbeb53c9546b7f4474321efd4d7896153a0e3a759697b1658cddbf2a",
      "en": "「I won't miss.」"
    },
    "181:4418": {
      "repository_source_sha256": "1c897eedd820454f9f7f1287c69e02282832cd5533d49e11a459f087484c7939",
      "en": "「Target acquired. Preparing attack.」"
    },
    "181:4460": {
      "repository_source_sha256": "fc51b73302e90441f2f65b23a620974948cbf8aa20f7e06a642596feea8fda94",
      "en": "「Better results than expected.」"
    },
    "181:4510": {
      "repository_source_sha256": "df1e5bdd1d4f0eafead27d46ab6f12bf1e632e2c8ddb4a85d213c7aedeae8417",
      "en": "「Firing...!」"
    },
    "181:4527": {
      "repository_source_sha256": "df5f84527cbc6a9df1f76dcb35d2b1c73f81b084153a8bcee794ade2233cc8a3",
      "en": "「A fine weapon.」"
    }
  },

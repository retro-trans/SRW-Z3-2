    "182:6267": {
      "repository_source_sha256": "fd43b06418e310c2e092b4f5762998783e580adc9cfdd34e110cf202f0349ee8",
      "en": "「Wake up, $$リディ$$!\\nDon't be taken by the black $$ユニコーン$$!」"
    },
    "182:6324": {
      "repository_source_sha256": "76cc106187841289cc854fd727b102472e916a35a3e09d4f99e24bc4cd20f6ea",
      "en": "「Damn!\\nZeon's obsession is drowning me...!」"
    },
    "182:6375": {

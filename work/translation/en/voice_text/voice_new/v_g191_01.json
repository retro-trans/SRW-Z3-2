    },
    "191:1339": {
      "repository_source_sha256": "f04d2cca0ad2b9288c99b33b8e07e65cd4b3fa037dec6495bfed0ec755e2b92b",
      "en": "「Cannot counter from this position.」"
    },
    "191:1314": {
      "repository_source_sha256": "61e4c842155408c47880153ac9ff5bdfad8a1fec1d2be66d3cc15f3d0b3b35ac",

      "repository_source_sha256": "af2be48f78c43f66e5272f11b0d3987ddfeec213409050f03f45ebe12185ddc0",
      "en": "「Be reborn.」"
    },
    "191:910": {
      "repository_source_sha256": "1e38057143d764ab07ccac1e8bfeb7c14478699a2a428bb3d3731bb191ea5d04",
      "en": "「Vanish from this world.」"
    },

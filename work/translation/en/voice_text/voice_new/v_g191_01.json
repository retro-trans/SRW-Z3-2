      "repository_source_sha256": "eae3c8740bdb9e7bd8accfa0a3e3b546656a1a9cba74cf68ce678530125b375e",
      "en": "「Return to the void.」"
    },
    "191:946": {
      "repository_source_sha256": "52d432c3d48a67754104e88400689cd1cf652e6da363546e230a2cab2c29a18a",
      "en": "「Return to the cycle of rebirth.」"
    },
    "191:963": {
      "repository_source_sha256": "acce4baf40d702a83ca83d8e43bf5fdff52c59dddb991f816e4a935049a04b42",
      "en": "「One who has received God's grace...」"
    },
    "191:988": {
      "repository_source_sha256": "02a1484f16bc03d8d714832b13e568a2654909e7c069d039c69f26aaf5940197",

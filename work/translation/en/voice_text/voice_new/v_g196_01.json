{
  "schema": 1,
  "rows": {
    "196:14474": {
      "repository_source_sha256": "978e238c1e1cb3fac747e6965d9a2b8a5f77aa7976eb260e563d95f5cc9b2d12",
      "en": "「$$ノリコ$$! Add circular moves to dodge!」"
    },
    "196:4335": {
      "repository_source_sha256": "1963af6782dfeba31b0bc77001c951fa40326e1b9f7c164252e2c287cf19a144",
      "en": "「We're invincible!」"
    },
    "196:4356": {
      "repository_source_sha256": "039d5855b7034f916325da5370e87aae9ed974071c2f18eb4342388cc708751a",
      "en": "「With damage this light,\\nit shouldn't be a problem!」"
    },
    "196:4407": {
      "repository_source_sha256": "85a30ad260a717eedca010394ade6dacda60b29d1415314bf066808b24e7e53e",
      "en": "「I can't shake the enemy off...!」"
    },
    "196:4432": {
      "repository_source_sha256": "48749ec8b66ef7edfb65623fa67bdacd2a3a4985cfd1da8776a0ad94c771c95d",
      "en": "「Yes!\\nThat doesn't even count as damage!」"
    },
    "196:4481": {
      "repository_source_sha256": "3e2463a7a6fd343d76fb30ef76f8997b7fda1c3d40b4c4a017e0469ab9748b62",
      "en": "「As expected of $$ガンバスター$$!\\nBut I'll dodge the next one!」"
    },
    "196:4540": {
      "repository_source_sha256": "31f52ed676326d8faeb0c197bc458ef7b2c9fa0f0a45ff0c080ae7c1be14f2c8",
      "en": "「In that case,\\nI'll lure the enemy with $$ガンバスター$$!」"
    },
    "196:14052": {
      "repository_source_sha256": "6c172a98c930ef4fac2414627ce60b23a0a09d3543156d070cbc27af83009a0d",
      "en": "「Futile! A flaming $$ガンバスター$$ is...!」"
    },
    "196:14095": {
      "repository_source_sha256": "73dfdd2408658f3d662384d928a15e21db890895e06d2481837f90eca1c24740",
      "en": "「Don't let your guard down, $$ノリコ$$.」"
    },
    "196:14120": {
      "repository_source_sha256": "63a28930e17c10c854809a15b843c652ef0a1ec7e1176133d5daed083b65de16",
      "en": "「Wait, $$ノリコ$$!\\nI'll build a new evasion pattern!」"
    },
    "196:14179": {
      "repository_source_sha256": "eaa45555db71344eb7ce03a5590a351c4f846dc278c8f5c664eb9e8e82d85173",
      "en": "「Are you ready, $$ノリコ$$?」"
    },
    "196:14204": {
      "repository_source_sha256": "e2ea81aa63fd6c6857ea9490585dd8be09bbbe7f80bb6b12ab1c258c45513cd3",
      "en": "「All normal. Just hull scratches.」"
    },
    "196:14245": {
      "repository_source_sha256": "7c6aa104512684fe1c8ea1218c60b7fae4c8862f8d51f86c93f06cf31f284a63",
      "en": "「$$宇宙怪獣$$ seem to target us...!」"
    },
    "196:4037": {
      "repository_source_sha256": "fd19e02359d1fe4bd01a22b50aa0e5fa29c63b29f2357c86bb20ab0004161fd6",
      "en": "「No, not yet!\\nI should be able to go way faster!」"
    },
    "196:4096": {
      "repository_source_sha256": "b99332d4e46d7676ea2f3caf302d23ccae9e47204efb69c2a6d8a1032ce4fa40",
      "en": "「$$ガンバスター$$ is\\nno ordinary machine!」"
    },
    "196:4145": {
      "repository_source_sha256": "cb1185b53162f23f81afca9b3458d2e198540933b42660f4fa499ffdc465e290",
      "en": "「I won't waste $$コーチ$$'s training!」"
    },
    "196:4188": {
      "repository_source_sha256": "c152c4656dcaada9e04cb14e6865225338a1ecb0638ea9f5a1a1f7bbc2a003c2",
      "en": "「$$コーチ$$'s teachings\\nstill live on inside me!」"
    },
    "196:4241": {
      "repository_source_sha256": "adaa8656ea89e32105056125dd2ec0879c4011a906da5e6e4bde7de0a5a5d131",
      "en": "「I did it...! Faster than before!」"
    },
    "196:4280": {
      "repository_source_sha256": "94094a1cf4bbdf0a85ea8aba5c80f4cee536bd92234277f726a43dd9ad26e5c2",
      "en": "「I absolutely can't\\nlose to the $$宇宙怪獣$$!」"
    },
    "196:13836": {
      "repository_source_sha256": "1666beef18e3961c81f00cd9d647a9de940f8bc2a8f1fc27ab51be2e719735ca",
      "en": "「$$ノリコ$$, an ideal evasion pattern.」"
    },
    "196:13877": {
      "repository_source_sha256": "0362bf820c49ae15b6c56cca061cfdddd754cf8b3940494f30dfe09b17850460",
      "en": "「Too easy!」"
    },
    "196:13892": {
      "repository_source_sha256": "d568e2220db8e727400e9d3a1323a212ed8fceb12a307db3385b384222fed7d4",
      "en": "「You've grown, $$ノリコ$$.」"
    },
    "196:13917": {
      "repository_source_sha256": "ace4d990a341906cd13e03a3018a3d011f52a55da5d9033c1f2001bd3be92e20",
      "en": "「And so have your feelings.」"
    },
    "196:13940": {
      "repository_source_sha256": "1c720ba6729bad8db250d6e9fe2c5fc09d8ad0662cb46e1bf11d39d1dab9a28a",
      "en": "「$$ノリコ$$, the effort you've built up\\nwill make you even stronger.」"
    },
    "196:13997": {
      "repository_source_sha256": "27b3863a30e86e8dad4a11d1dc9b434f39cf60a4d728b0191c68552666943315",
      "en": "「$$ノリコ$$, you've got a good grasp\\nof the enemy's movement patterns!」"
    },
    "196:27": {
      "repository_source_sha256": "d364814a4441ac0555520432eaa5dd7d0d5b66767d389a79f06161f89ab74786",
      "en": "「Okay... $$ノリコ$$... let's combine!!」"
    },
    "196:1224": {
      "repository_source_sha256": "7e2c111556387221e4516d5de6787652890b1cc7378b132fd3cab40df83a04f2",
      "en": "「Guuuun! Buuus! Teeeer!!」"
    },
    "196:12084": {
      "repository_source_sha256": "b2b05a97e95fc6b5e6c83b3ee56b811cb530d4255623b13b56e4ecf9e2880134",
      "en": "「Hiya, it's $$タカヤ$$! Guess what...! This time I'm running the show all by myself! $$コーチ$$, Big Sis! $$ノリコ$$ is growing up a little more!」"
    },
    "196:1322": {
      "repository_source_sha256": "9219a52baf28c61532358abb0a908274d08f38017d7669063ecf470d4b25eb6a",
      "en": "「Of course! All together now!」"
    },
    "196:1353": {
      "repository_source_sha256": "0f462ed57ebfd48547921b3723cb3ccf8b3a02bdf417cc7cb355d79ddbf55a6d",
      "en": "「Of course!」"
    },
    "196:1374": {
      "repository_source_sha256": "629fa5bcfcca4747206f8d9c567760dc14d855c7e2f4e6a33f24ded49aceb4ed",
      "en": "「Wait, that's not it... Everyone, thank you for your hard work. Please rest up!」"
    },
    "196:1441": {
      "repository_source_sha256": "9058966d33153ce54f62cfddb6576de3d8ca890c1ffe803a5e59ebccce147b0d",
      "en": "「Huh!?」"
    },
    "196:5208": {
      "repository_source_sha256": "85278bdf58b8cbf3f88bfd3abd4db6f604e37e3343cb2e02d43dc255c873e9ce",
      "en": "「Hiya! $$タカヤ$$ here!」"
    },
    "196:5237": {
      "repository_source_sha256": "f07d5029f1085825fa16fb67d7c86fea014fa16baa3f14324c1c2423c672e81e",
      "en": "「They're points you earn by defeating enemies or taking certain actions in a scenario, and you can buy all kinds of things with them at the intermission $$Ｄトレーダー$$!」"
    },
    "196:5368": {
      "repository_source_sha256": "f36af82155d4934ac988104cea7ff09ee39d88495429d6d5569092d161d92ac1",
      "en": "「Wh-what, ehh?! Aw, no way...!」"
    },
    "196:5401": {
      "repository_source_sha256": "4fc95669cdc545ee724a5882d32cac787b3487663f1d76bb09c655f63bea5d9b",
      "en": "「Bye-bye!」"
    },
    "196:5418": {
      "repository_source_sha256": "9cd11a5ec8b9054fab8c957a967f043f6e737fc6a07a2ab85444380688664c36",
      "en": "「Oh! It's a postcard! More people send email entries these days, so that makes me happy!」"
    },
    "196:5495": {
      "repository_source_sha256": "f1b52c7082511b179eb959141a5420c50591edb48c22a17c0d65a30b0517e647",
      "en": "「I send my entries on postcards whenever I can, too! I think your own handwriting really shows the effort and guts you put into a letter!」"
    },
    "196:5624": {
      "repository_source_sha256": "a8f36afcfb73541df673780702bcc60f59b2e56491ba93fd015f6229cfbfa134",
      "en": "「And you can draw illustrations, too!」"
    },
    "196:5661": {
      "repository_source_sha256": "b854c1f3c966a8e591d295e54f5e329433cbd8e7076edd01de80ad2e65e6d2af",
      "en": "「Awww! But I still have so much I want to talk about!」"
    },
    "196:5708": {
      "repository_source_sha256": "0da6e53d11cd745102e64997ec4f4b0803a04a695436fc991fb5e78de97a1dec",
      "en": "「It's the $$次元力$$ activation system that affects the whole unit. And you can power it up in all sorts of ways with $$Ｚチップ$$s!」"
    },
    "196:14830": {
      "repository_source_sha256": "5a407e34bf8228e1cb44f75a2b4a3a721a9acc0d73b7bb252122a7926388adc0",
      "en": "「This is $$アマノ$$.」"
    },
    "196:14845": {
      "repository_source_sha256": "031e5a46aa1769641fb0c6d999fb95a1b09666aafef0d09c68b387396afbffcb",
      "en": "「Now then, a message from one of the good kids playing Super Robot Wars, a superfan from Aichi Prefecture...」"
    },
    "196:14934": {
      "repository_source_sha256": "caea8bd853789f3d4c17b6f8b9df3e6f19dde74f1276ccf65397af021be0c877",
      "en": "「A postcard has come in asking, 'What are the $$Ｚチップ$$s that debuted this time?'」"
    },
    "196:15007": {
      "repository_source_sha256": "2d3bf5cae7703b17af4f36a14bc89f703da6a9b662c115bc3e1a8431405191ec",
      "en": "「$$タカヤ$$, what do you know of $$Ｚチップ$$s?」"
    },
    "196:15058": {
      "repository_source_sha256": "e204534e2fc5621f0c7dfa0dfc782cce639fbd8acaccdf7af8c2f30706266194",
      "en": "「Close, but no. You also get $$Ｚチップ$$s when you earn SR Points. So you won't forget, you'll learn it by writing it out 100 times!」"
    },
    "196:15183": {
      "repository_source_sha256": "d707f0d1f671a5ccd8f46cb25cd32e4bd56a761d5b211c67156c0dd2192460e8",
      "en": "「Well then, until next time...」"
    },
    "196:15329": {
      "repository_source_sha256": "205261405751f09d928d417ab58e6a445193f4f8ad56fa839d6ee3714cef611c",
      "en": "「Yes. It's been a while, so I was surprised too.」"
    },
    "196:15370": {
      "repository_source_sha256": "a0c02954587eae32828fc3521f073b2e46c260935139fdda7be5e3fc71ce85a8",
      "en": "「Y-yes... that's right.」"
    },
    "196:15393": {
      "repository_source_sha256": "f4799cc03cfa99644a901bb25e9849250ee0b90fd1133b4e75965ada955a4bb3",
      "en": "「$$ノリコ$$... it's almost time...」"
    },
    "196:15422": {
      "repository_source_sha256": "d90d071701e5b099cb6d28f180654c689f05dc5c7b8e56138c9bc2f8778eca84",
      "en": "「I'll answer the Super Robot Wars superfan's question another time.」"
    },
    "196:15481": {
      "repository_source_sha256": "981a530c3aedf05493f5352df1f002bf12d61bee87c1ace2ed59a85b63267bc0",
      "en": "「A postcard has come in asking, 'What is the $$Ｚクリスタル$$ that debuted this time?'」"
    },
    "196:15560": {
      "repository_source_sha256": "31588f992ee64304de2ecb7d51db932c2ed70ce246c5f21dd51a6797cbd02653",
      "en": "「$$タカヤ$$, what do you know about the $$Ｚクリスタル$$?」"
    },
    "196:15615": {
      "repository_source_sha256": "c9fe51626e609f143dbbf1280af642b10093a3c55e9fdd29c012aee543900317",
      "en": "「Close, but no. The $$Ｚクリスタル$$ does more than that. Its power will be revealed as you progress through the game.」"
    },
    "196:4014": {
      "repository_source_sha256": "3d2c4b8479d4d11473f1ef4de5c5bda6a5a58133867fc39f49ef3daac1d329c7",
      "en": "「Lost the target!?」"
    },
    "196:13807": {
      "repository_source_sha256": "ad4ab96995933499cbac93d05dc476ef0c8f4235060c7c8c108f24f3d7fa7680",
      "en": "「Yes, the enemy is no pushover...!」"
    },
    "196:3995": {
      "repository_source_sha256": "eaf052f2c2eab5cdc35fe52572b5ed8d6fc5d313686ff16c8a6423e57a27cf1b",
      "en": "「Busteeer...!」"
    },
    "196:13754": {
      "repository_source_sha256": "86afdeb79a30013401d525cb7316e0ff812965472587b9c4b27fefeb985b83ac",
      "en": "「Hold it!\\n$$ガンバスター$$ is badly worn down!」"
    },
    "196:3944": {
      "repository_source_sha256": "8e93527daacedc04df1eafea5d807c60cf9dd236e8730276fdb58271f90a2f09",
      "en": "「Yes!\\nI'll overcome any adversity!」"
    },
    "196:13725": {
      "repository_source_sha256": "7923b5a738fb7bc67e889c165dae223e599bac4b6ddff4dd45e47211a65cd2f3",
      "en": "「Endure it for now, $$ノリコ$$!」"
    },
    "196:1040": {
      "repository_source_sha256": "55804b428df0ee0bb185d78bdb54091cebbf465aa56f6b4cf7aac4e94a996e23",
      "en": "「Buster Hooome Run!!」"
    },
    "196:1895": {
      "repository_source_sha256": "86846b8d1696f255734ff5c9c0cfcb0373ab055fcea816103e3ca0398eac9c10",
      "en": "「To the galaxy's backscreen...\\nFly awaaay!!」"
    },
    "196:3762": {
      "repository_source_sha256": "e7b6fbd1fe86ab50f369c4ad9d01729fc24c25fcf826bf2d6a48008f594c3791",
      "en": "「Buster! Home Run!」"
    },
    "196:8456": {
      "repository_source_sha256": "f34c52600b3bff5796189b151da071f5cfe9863293a90049a05d9d6a6d2077a3",
      "en": "「This one shot sends you to hell!」"
    },
    "196:8483": {
      "repository_source_sha256": "8ead02ec9731409128661fa719420c5b5e5f224beebe635b5fbbeff7ee52c794",
      "en": "「Finisher! Buster Home Run!」"
    },
    "196:13545": {
      "repository_source_sha256": "8c8b838d12e7ab809a68cafbe6ba1d41386217221c3848cacf4a56d5924ec2d8",
      "en": "「Send it flying to the galaxy's end!」"
    },
    "196:954": {
      "repository_source_sha256": "04bfe36a9e98408bd83c7ef58b7a5d83da81058d28134ab908afeef415b80630",
      "en": "「Double Buster\\nCollider!!」"
    },
    "196:0": {
      "repository_source_sha256": "b0405c000e679e26d2da5870838123a7878a935c49770e45e468e91ea8e513ad",
      "en": "「Aaaaaagh!!」"
    },
    "196:1119": {
      "repository_source_sha256": "70d8d86851338a79ab29030b83070c54b13ffac584bbed49760069c75d75a4b9",
      "en": "「Big Sis, I'm going to use that.」"
    },
    "196:1146": {
      "repository_source_sha256": "1cbdae95361b77ac20cd3acce36e01618e2bdf056153b22076d011d8437702ff",
      "en": "「Yes, go right ahead.」"
    },
    "196:1167": {
      "repository_source_sha256": "0d5f07b9094a71104d3b6de61254aafc7863fc6c638b32cb3b849cd3c13d3062",
      "en": "「Super!」"
    },
    "196:1182": {
      "repository_source_sha256": "be7f82bae5f6690c6a9880833b3e512dee00786f1e0d53b12b05dbc3b46eac2d",
      "en": "「Lightning!」"
    },
    "196:1197": {
      "repository_source_sha256": "4c6989e2c1ccfc813b4dbf7f7818af6d73db96ae26fa7de1851f946ec7fac091",
      "en": "「Kiiiiiick!!!」"
    }
  },

{
  "schema": 1,
  "rows": {
    "206:2580": {
      "repository_source_sha256": "9188229055fec99addea4bd8ee913637c0971f34eb5c66ffba9dab47c600f764",
      "en": "「Just because you have a $$スフィア$$...!」"
    },
    "206:8392": {
      "repository_source_sha256": "f25b1fbe8cd4cc45909b3e3c1658d902c067b0949e9d121ababe89db2a52d77f",
      "en": "「For what I feel I must do...!」"
    },
    "206:8629": {
      "repository_source_sha256": "47f63aa20f94396317e6f0127d99a674613ee95ca032e3999f1b48fb3f1d3165",
      "en": "「With this machine that carries\\n$$タクヤ$$ and the others' feelings!」"
    },
    "206:8678": {
      "repository_source_sha256": "e822f2db67a348c3a64212b7315475212e0ee34f23aff496d518e0c550f09f7d",
      "en": "「I've got plenty of weapons!」"
    },
    "206:9125": {
      "repository_source_sha256": "3d31652fa03ee97c287d096f90c4e92a8a5d06aba5e6448c144c51fb6cc2c10e",
      "en": "「Won't back off? Then I'll fight...!」"
    },
    "206:9164": {
      "repository_source_sha256": "613b194d9a5f4c9bc99d0ee74588c274df6a2a50488b56fb69033746a7cea35b",
      "en": "「Fighting like this?\\nYou've got to be kidding!」"
    },
    "206:9215": {
      "repository_source_sha256": "7ff14735668396371b1d7c43be31dea54125334b095edae694fedaa15efd8d6a",
      "en": "「What good will it do\\nfor us to fight here?!」"
    },
    "206:9268": {
      "repository_source_sha256": "88e4471df2f997b23df831fe062d9f327165d5ab5987630efc2eb0b32eb7d630",
      "en": "「Wake up, $$マリーダ$$!」"
    },
    "206:9305": {
      "repository_source_sha256": "d854f21abefa535b4af0464d426ddce084403c220b03d9c965e186fff3315afc",
      "en": "「I can't let the Captain and\\n$$マリーダ$$ fight each other...!」"
    },
    "206:9360": {
      "repository_source_sha256": "9c52f7b0e449d3b470a0e482cbfd6b18ec343b4d7af9dbd55cffb1a7d2e38be9",
      "en": "「To reach $$マリーダ$$ with my voice,\\nI have to act now!」"
    },
    "206:9413": {
      "repository_source_sha256": "160c1079b765c93ccc9dbe0eaf1c0a7d1f41a2eb621cab47665c523769502954",
      "en": "「Look at the situation, $$リディ$$!\\nWe have no reason to fight here!」"
    },
    "206:9478": {
      "repository_source_sha256": "45c35b5b42eb9159fe6230c7438f43914672c8cb0f437d20a4a80f255c5d114d",
      "en": "「Get out of the $$バンシィ$$!\\nThat's a dangerous machine!」"
    },
    "206:9541": {
      "repository_source_sha256": "a7bc82e0eed31308a12e21844370f018a2f1b152791895bdad64e52950b1e683",
      "en": "「Foundation lackeys like you...!」"
    },
    "206:9582": {
      "repository_source_sha256": "5fd54639695e0493ad7f0df7f82f5fe999e03ea0ae610ac4c4b2fe6023ffcd54",
      "en": "「Federation forces interfering...!」"
    },
    "206:9619": {
      "repository_source_sha256": "987c80db35817e87f64bc50b14c31de8a51db3fbc5a5ba696d92cbb51372644c",
      "en": "「$$ハマーン・カーン$$!\\nWill you go on like that forever...!」"
    },
    "206:9678": {
      "repository_source_sha256": "6aec656d5bc7cfecbe880db2b073d9709d47350ab61f983787915735cb878eac",
      "en": "「$$ハマーン$$!\\nWill you shut out possibility?!」"
    },
    "206:9737": {
      "repository_source_sha256": "e5e35cf5c94c181606ef355f6ac0316168b1811054394f317492990b2c43451d",
      "en": "「Without even understanding $$オードリー$$'s\\nfeelings, you people...!」"
    },
    "206:9792": {
      "repository_source_sha256": "727390c4f857ac1ad10b282c100dfd66c4eaa84ad98d8c15720399367fcc04be",
      "en": "「This is no time for a war!」"
    },
    "206:9833": {
      "repository_source_sha256": "a7cea71e7ec2a25e8202b2e8e57f113da1ec25f564346492a932c43bbe5ee076",
      "en": "「I must act before being absorbed...!」"
    },
    "206:9872": {
      "repository_source_sha256": "b96864b3ad264cd195989e6bf0eb5901fcc467956c04022ca59343f1dd02898f",
      "en": "「If dialogue can end the fighting,\\nthen I'll bet on that too!」"
    },
    "206:9931": {
      "repository_source_sha256": "b14016269d43ff8aa2dfc4a19757d172d26cc9f8d2905afefd73ad43c5fe5e31",
      "en": "「We won't be wiped out...!\\nHumanity is only just beginning!」"
    },
    "206:9988": {
      "repository_source_sha256": "b70e5aa4bc7a3bad25e7c375b17b77fa08fd5877e31e5512668e12f51adcbe9f",
      "en": "「I'll resist with all I've got...!\\nThat's human possibility too!」"
    },
    "206:10035": {
      "repository_source_sha256": "dcc169fc2a072076795e6162469a7bb569dcdcab5fe8233e3161f9453e40caa9",
      "en": "「We'll seize it...!\\nOur way to live, with our own hands!」"
    },
    "206:10086": {
      "repository_source_sha256": "f483fe16cdd28f2fa9c36f61f8d136f44c95af59b9f9b3ab1a0836d8e89bc5f6",
      "en": "「Machines that try to rule people...!」"
    },
    "206:10125": {
      "repository_source_sha256": "21fbd5c759b92c48abf6498e0ae9b053aa6fed5c7d853704d6702a5ab09e5b57",
      "en": "「What the world needs is\\nneither a system nor domination...!」"
    },
    "206:10184": {
      "repository_source_sha256": "026945df1e598bc95a15fbac98ec44d4821c5a8921f916f7fd74889f22478a15",
      "en": "「I'll stop the $$新地球皇国$$ here!」"
    },
    "206:10225": {
      "repository_source_sha256": "02e6f6e071850b47e07b28095090f6902a8e12b1834f09ed214aa317900efe27",
      "en": "「I'm taking back what you stole,\\n$$サイデリアル$$!」"
    },
    "206:10274": {
      "repository_source_sha256": "41d8eb581ea943842c08d07e082bded77dda928d0fe6adcb2eaf089a5913a604",
      "en": "「I can't let your power spread...!」"
    },
    "206:10317": {
      "repository_source_sha256": "3edbad3281991fa5cbb8b1ff0ff5f78e1d9d2be4aa1cc128594152b98a3b2760",
      "en": "「Using that power just to\\nrule over people...!」"
    },
    "206:10366": {
      "repository_source_sha256": "74709ef1dfedbd3a5e350865cb39933cef9fa0d5de16b6d0ecc7854781ca27f2",
      "en": "「I think I know how frightening\\nthe power of the $$スフィア$$ is...!」"
    },
    "206:10419": {
      "repository_source_sha256": "ac29e3cc198a238a60411468e515d29a127656221217bd1bc4eeeda6143aee56",
      "en": "「Before you spew your hatred,\\nthere's more you could be doing...!」"
    },
    "206:10482": {
      "repository_source_sha256": "9e8c9abdfb0a69cd3dc032334f8752ed3db42a6d217b6919d0ec9ee8a8d23040",
      "en": "「Don't you feel anything\\nabout a life of killing, you...?!」"
    },
    "206:10549": {
      "repository_source_sha256": "922a467c64c9e4600d985610504229ee6110bbf3dd9078b3ca63eab9c0b4163a",
      "en": "「I'll break the enemy CO's tactics!」"
    },
    "206:10588": {
      "repository_source_sha256": "de00aad17e43f9875cf8d0f9966e41265970c3a32e86b894dd7b6136f2b9c426",
      "en": "「Spreading war just for fun?\\nYou've got to be kidding...!」"
    },
    "206:10645": {
      "repository_source_sha256": "82c5694f4bbfbffeb03ab5acaea6c0e2653432f039f19bc771aee65b0f7508fd",
      "en": "「With this, I'll end the war\\nwith the Empire!」"
    },
    "206:10694": {
      "repository_source_sha256": "e97b95b072510f7f33b2fda124b675e5ed291503639ae2e785229a208a3c8940",
      "en": "「Someone who strayed seeking power...\\nI can't sympathize with that!」"
    },
    "206:10753": {
      "repository_source_sha256": "130d7cbb8947418aa32168146d8b447923fbfe435d7d77d8d4b7236bd5a66dbc",
      "en": "「Anyone who, for their own desires,\\ntakes the lives of others...!」"
    },
    "206:10804": {
      "repository_source_sha256": "a019a1c66a0a873ff532e43e52100c69662e8da984d894b394121024de795621",
      "en": "「I can't leave you unchecked\\nany longer!」"
    },
    "206:10865": {
      "repository_source_sha256": "f835beed09d47f3970e4e4d113cee18965e6532c4c3844742a7c5cd10ceae79e",
      "en": "「Nothing but a coward, afraid of\\nhuman possibility...!」"
    },
    "206:10918": {
      "repository_source_sha256": "3a016146aace89bf935a7b1e4bba419cd6bfd7a400f15e94fd2dc827048def82",
      "en": "「Our god lies within us...!\\nSo we fear nothing!」"
    },
    "206:10977": {
      "repository_source_sha256": "55de23ce21070163a6d79f9616246a35e492b78278b818cd9a947af53cde5e4e",
      "en": "「Only humans kill gods...!\\nI have no reason to obey you!」"
    },
    "206:11038": {
      "repository_source_sha256": "70f1778afdd53960dd61dc325e0ed693c6dfc6a96aec4e8638b74757bea2127f",
      "en": "「I won't listen to your\\nselfish judgment...!」"
    },
    "206:11087": {
      "repository_source_sha256": "23d9ec4bc9680545803e27d1013005bbcd0d37fce2e35886493e9e718058df30",
      "en": "「What's so fun about the sight of\\npeople dying?!」"
    },
    "206:11138": {
      "repository_source_sha256": "16d0bd57bf84dbebce26c5d3145d6f7558e0f87fc0d8e7ca77cf4f6edcbe3f7f",
      "en": "「$$アドヴェント#pilot$$!\\nI won't listen to you anymore!」"
    },
    "206:11199": {
      "repository_source_sha256": "e56303d922844430ef5f31055eecf87441fa7878b7a7677096632f09b3775f3d",
      "en": "「You may mean no harm!\\nBut you're our enemy!」"
    },
    "206:11258": {
      "repository_source_sha256": "a68f3877df11545225ad2b7055455cd289eb01db2af5ec25ec60559a0152ac8c",
      "en": "「We don't need anyone's salvation!\\nPeople save the future on their own!」"
    },
    "206:11319": {
      "repository_source_sha256": "07c954a22b3bafaafdb4e79e9b96d63544ebe81922b44707a0f096318890bb2e",
      "en": "「$$アドヴェント#pilot$$! Overcoming you,\\nhumanity will grasp possibility!」"
    },
    "206:11392": {
      "repository_source_sha256": "1f2084b666851d57cbc0f0b81b5d43655efb4fc389591c0b68be5aef6eb2e553",
      "en": "「Giving up your own possibility and\\nliving by clinging to someone...!」"
    },
    "206:11453": {
      "repository_source_sha256": "b99dade603b3c06924a234b52610244cae014744cb4a84280421943b230acc42",
      "en": "「You threw away your own future!\\nPeople like that...!」"
    },
    "207:7102": {
      "repository_source_sha256": "a855386860f29ca012eefb2da44b79707e2c38d8b41b12f4fb5e93998ac931b9",
      "en": "「I fight, trusting my possibility...!」"
    },
    "207:7180": {
      "repository_source_sha256": "b49ed0ba2b62a07cd5e415c2117df3e85c420a2294b029f82349f83d81f2d48f",
      "en": "「No matter how hard this path gets,\\nI'll keep walking it...!」"
    },
    "207:7237": {
      "repository_source_sha256": "99ab4f7cacb2f3089db4331ec2305b18b06d70e893bb2a29cbc330708bbfbf65",
      "en": "「To protect everyone, now I must...!」"
    },
    "207:7272": {
      "repository_source_sha256": "a102f0c5db2faa4e122cd9f41432ebc95f417ae354a61adf04733c6ae969500a",
      "en": "「I'll let no one take our future...!」"
    },
    "207:8154": {
      "repository_source_sha256": "fc7e45dd371dc5893e4df84a12889057ebe6680b467b2ee6dea4e807ffb72f0c",
      "en": "「You who can't believe in human\\npossibility, what could you know?!」"
    },
    "207:8207": {
      "repository_source_sha256": "6d30160ab2c27e70055a56a349faaaa8ae73f7482e1a6db4556c9941ef9ce124",
      "en": "「Your words feel so cold!\\nWords from someone like that...!」"
    },
    "207:8276": {
      "repository_source_sha256": "ded6c4ae17f57704e52da5c8897b660124271f60cd555603676a49675ff7c20e",
      "en": "「I can't let you use\\nthe Box!」"
    },
    "207:8327": {
      "repository_source_sha256": "cdd1e37cafab892ba8d7794e50ec2b050ccd5218bc702a232718c1a4cef10f54",
      "en": "「$$フル・フロンタル$$...!\\nI won't give the Box or possibility!」"
    },
    "207:8380": {
      "repository_source_sha256": "8f0ff2ed1ad53ca4396072cf6381b0c211a0f181947fa35f89567c819ade4f1a",
      "en": "「Captain $$アンジェロ$$, I'll end this here!」"
    },
    "207:8419": {
      "repository_source_sha256": "bfa0bda88a8522521c00f6acdc5476316ab515beeb9836206cccce29bc44a177",
      "en": "「Captain $$アンジェロ$$, if you want power\\nbeyond human, trust yourself more!」"
    },
    "207:8494": {
      "repository_source_sha256": "4f46289e0c30ebba64490045046cffd677fc7d18f47b061f94a9056a52a9afd7",
      "en": "「Humans create humanity's future!\\nPlease understand that!」"
    },
    "206:11512": {
      "repository_source_sha256": "7862de56a60e6a2c34e9d8ec6e8a20f2c147008846cf779a0d0d6ade64175600",
      "en": "「Don't get in my way! Let me through!」"
    },
    "206:11545": {
      "repository_source_sha256": "8278d40c0189d8703d61282278c45369a4a9770355b21509c810d4f51c586928",
      "en": "「I have to hit them while I can!」"
    },
    "206:11578": {
      "repository_source_sha256": "436da81c1f287c3346df4316a32ec9620db8e0be9d01a2efac159d2b94072b39",
      "en": "「You shouldn't have come at me...!」"
    },
    "206:11619": {
      "repository_source_sha256": "b25f2cb989b5c564cbda034c28c96b8fea5f90f87a563b1581902e6fe343e949",
      "en": "「I won't just take it lying down!」"
    },
    "206:11660": {
      "repository_source_sha256": "fa14d2dbe32338b7a6665e88b1f79b816f942c98ceb80c435952b83c76770b7e",
      "en": "「If I don't do it here,\\nsomeone else will be in danger...!」"
    },
    "206:11711": {
      "repository_source_sha256": "a3a7917295e3ea1e41944ff4f122ecb1bf7c97a5666ab0b1c9e061b53e091699",
      "en": "「If you're still within my range...!」"
    },
    "206:11750": {
      "repository_source_sha256": "13fe8f1695bcf5c36196207e5f4c6e3c0ce616484acdaf491fe8da74fe213625",
      "en": "「I'll handle the rest!」"
    },
    "206:11777": {
      "repository_source_sha256": "4690a2c173d2f6367c1a7784ed27ff34ba0acd0e6c32e1160ca661313df457ab",
      "en": "「Even I can\\nhelp somebody...!」"
    },
    "206:11826": {
      "repository_source_sha256": "8ef870d1c3cefa26d29aec991099776984648a4a8a3315a0627b2246fde9e09b",
      "en": "「$$マリーダ$$'s and my consciousness\\nhave become one...!」"
    },
    "206:11875": {
      "repository_source_sha256": "de3eda90e3af9e3779702385f35a487390cb91447a14d1229420156f95d11db2",
      "en": "「$$コンロイ$$! I'll take it from here!」"
    },
    "206:11906": {
      "repository_source_sha256": "a68e0201ae16844b7125a8749ba3ced012d7644c293d5606fbc2b1883cf9a599",
      "en": "「I'm following $$刹那$$!」"
    },
    "206:11931": {
      "repository_source_sha256": "090c355dae6e859c09636adbca67e95f005b496545667dbc54cea021205ef538",
      "en": "「$$ガロード$$ made an opening for me!」"
    },
    "206:11964": {
      "repository_source_sha256": "1c31e47d1b7f7ccd7001c797da8be557f7da3c30b6a2b8e7ce9b3bd672f8031e",
      "en": "「It doesn't end with $$ロラン$$ alone!」"
    },
    "207:11107": {
      "repository_source_sha256": "8f3689a71275195e691bd2d5674ab0fea4e53f5802c3a191aada83724feb490f",
      "en": "「I'm following you, $$リディ$$!」"
    },
    "206:9053": {
      "repository_source_sha256": "020a50371c3a801aa0092dc83089b45ba765b1d37d3599b93cad967bf39d5df8",
      "en": "「Didn't drop them? Once more...!」"
    },
    "206:9092": {
      "repository_source_sha256": "c80ad4a8eb1044d352aa36ebc6bb8843f87fc10a671ca83356f210c27b86bee9",
      "en": "「I'll keep doing it...! Right now!」"
    },
    "206:14195": {
      "repository_source_sha256": "80ce19679f2fb0f3c125c6dde31d6e894db5ed24072fc46b537963bb5eb3aa18",
      "en": "「No...! Coming this far, and I...!」"
    },
    "206:14234": {
      "repository_source_sha256": "122675db8a7061ac0ddc56094f955684ffafac3a9f72b6f0fbfc649527ec3f65",
      "en": "「I'm sorry, $$オードリー$$...!」"
    },
    "206:13519": {
      "repository_source_sha256": "793546bc7217836435ad91f6a45772efa004b4aedfb1542adcf2da78e0c2ab18",
      "en": "「Guh...!\\nI can't shake $$フル・フロンタル$$ off!」"
    },
    "206:13570": {
      "repository_source_sha256": "1f3a061b5412c7e0309af1dfff92e3fa46cff76be5639e18b7d6d416bdda5377",
      "en": "「So I can't beat that person...?!」"
    }
  },

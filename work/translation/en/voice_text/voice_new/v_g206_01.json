{
  "schema": 1,
  "rows": {
    "206:13609": {
      "repository_source_sha256": "ba5c29e31af1f646dce62f62be3bbbd1b588cd63f3c85281e0cc156cfcff0ff5",
      "en": "「I promised...!\\nI'd return to $$オードリー$$! That's why!」"
    },
    "206:13670": {
      "repository_source_sha256": "59cbd30dca5662c757f385c6d1d369a9d135eaf80d0700d03b8f6784de596bd5",
      "en": "「Is Captain $$アンジェロ$$'s obsession\\ncornering me...!」"
    },
    "206:13727": {
      "repository_source_sha256": "a43aa4d9bd3a66d6cb78ab2e81193cb8df8ec9b9b46c2dfa000f88385d49fbe5",
      "en": "「That unit is amplifying Captain\\n$$アンジェロ$$'s obsession...!」"
    },
    "206:13786": {
      "repository_source_sha256": "f5d2e63b9565910b22a80fecfd443046a06bcd092d1d896423e42ec08520dfc7",
      "en": "「No, $$マリーダ$$!\\nIf you keep doing this, you'll...!」"
    },
    "206:13849": {
      "repository_source_sha256": "c2dc7c402a5442e1328b246f64deca9f0aacee5bf7f5323cf285d58eeec0c0ef",
      "en": "「$$マリーダ$$ is completely\\nswallowed by the black $$ユニコーン$$...!」"
    },
    "206:13914": {
      "repository_source_sha256": "04839cecf98ac485ebdd6495f5ce2d7bdccbe9a580c3d344db16224149326664",
      "en": "「$$ハマーン・カーン$$!\\nWhat kind of person are you...!」"
    },
    "206:13961": {
      "repository_source_sha256": "f4792a7a660887747ae3b96d7c4a348176376bd57946f92bdb976b1f0c9e4d03",
      "en": "「$$リディ$$,\\nI believe in human possibility! So!」"
    },
    "206:14018": {
      "repository_source_sha256": "c3c4945da61a871e691a421bc318a13e43c53912165263dc742261176a157166",
      "en": "「Are you serious, $$リディ$$?!\\nAnswer me!」"
    },
    "206:14071": {
      "repository_source_sha256": "2fc9929e04eaeb573c87a5314870913c14b2e5bea3003b0736b3b1671f1fcb08",
      "en": "「Why won't you understand what\\n$$オードリー$$ is saying?!」"
    },
    "206:14132": {
      "repository_source_sha256": "8e01613429774c276614981465c6b4f18cbe003687f0eb521207e51934302def",
      "en": "「If the war continues,\\nit'll be too late to turn back...!」"
    },
    "207:13528": {
      "repository_source_sha256": "18bdb0e3ce6f65f06ef0d9b3eb1b6f666f6933a826a4a9b419d00e96999d4b33",
      "en": "「Don't give up...!\\nA chance will come if you don't...!」"
    },
    "207:13587": {
      "repository_source_sha256": "b61114eb4cf24ee02c9b2fa578802a8de755d78be35f7cbd6ecc9499d19f5080",
      "en": "「If there's even a slight chance\\nI can do it, then I...!」"
    },
    "207:13636": {
      "repository_source_sha256": "f171645faa323776ff9c851a04d6b8124df75215ea11668342f76c815f24c762",
      "en": "「Have the courage to beat despair...!\\nIf I'm a Newtype...!」"
    },
    "207:13699": {
      "repository_source_sha256": "f1ff05c9d992ee3b77ac4465aa8ea0210c591846ccc0cd177a26a27413766af7",
      "en": "「I'll fight on to the very end!\\nTrusting the inner god: possibility!」"
    },
    "206:13373": {
      "repository_source_sha256": "d4471a321c8364f3373889d88d06978ae2e13dc3a465ba99b18476707c0cb1e3",
      "en": "「I can't absorb all the impact...!」"
    },
    "206:13402": {
      "repository_source_sha256": "9ab76b72fecbd1446b4a3ce157448fe26c44744b5f44dc72790de7449ad8b104",
      "en": "「I have to move faster...!」"
    },
    "206:13431": {
      "repository_source_sha256": "b455828cb160e2615c5c01b093a9357ce6e027e651a0f93f37ced6933c89e83f",
      "en": "「The situation won't crush me...!」"
    },
    "206:13468": {
      "repository_source_sha256": "5aaa46b57c3d358771372329d4dc874c9454edb32fa8708c64bf00c3e2664ebc",
      "en": "「Sharpen my senses even more...!\\nOr else...!」"
    },
    "206:12490": {
      "repository_source_sha256": "c754e4f739ea86766e4174b9e4959008fb8cb0bed0ce900b298e4448c304bcd2",
      "en": "「I won't let you have your way\\nany longer!」"
    },
    "206:12543": {
      "repository_source_sha256": "92ec2162823357b12ab79f48a20e86fe03f160ba55f340bd6e3503022997aa29",
      "en": "「$$フル・フロンタル$$...!\\nWhat are you up to...?!」"
    },
    "206:12594": {
      "repository_source_sha256": "70c11675c6a15d1a4d712bce8903d95165750b40c769cb2f94b3f229f58b13f9",
      "en": "「Giant mobile armor or not,\\nthis will...!」"
    },
    "206:12645": {
      "repository_source_sha256": "341777660f22a4f8ea413659756c2165664c1b2cfda0bedf6653f2f8e79f5e79",
      "en": "「You, who wrote off human possibility\\nand threw away the future...!」"
    },
    "206:12704": {
      "repository_source_sha256": "2afd646fc175fcef155f0a73bce04af6368cc57a9634293468e6a1bbfabb8704",
      "en": "「You're still going to fight,\\nCaptain $$アンジェロ$$?!」"
    },
    "206:12755": {
      "repository_source_sha256": "f371224ae72e4ddbfb25b3031dd4f4532a5a65493ef13076e6ff2bc97737b8eb",
      "en": "「In a unit full of bloodlust...!」"
    },
    "206:12794": {
      "repository_source_sha256": "805132610ad987b406a344932dafb2a7a3a6c5f7f051b3f9b291b9e5d17f9cdf",
      "en": "「$$マリーダ$$! Stop it!」"
    },
    "206:12827": {
      "repository_source_sha256": "fce965cd1ebecbf97fe902090c76cd65a7dd01fbdb4569006fe0b406d82a9265",
      "en": "「That you can't use your power is\\nproof the real you is resisting!」"
    },
    "206:12890": {
      "repository_source_sha256": "4a70bbdd5dee4295cd0fe6f72dd903cdde50199e6374504eca12e9a1fb481923",
      "en": "「$$ハマーン・カーン$$!\\nYou should be much wiser than this!」"
    },
    "206:12947": {
      "repository_source_sha256": "b4b823f5343624ab42870abff98560e3c70ad0dcc4af52199d6dc396a1089a7f",
      "en": "「Calm down, $$リディ$$!\\nThe machine's swallowing you!」"
    },
    "206:13010": {
      "repository_source_sha256": "ea222f3e0b800bc6682f78f47df6d2dfe95ee79a6c872a6b2f26c5cf540c0077",
      "en": "「Stop it already, $$リディ$$!\\nThis fight is meaningless!」"
    },
    "206:13069": {
      "repository_source_sha256": "7312c9688ba41a4e239acf5a94cad0496edd6464cb5f95a33e65b4b4ff76a734",
      "en": "「If you don't want to die, fall back!」"
    },
    "206:13112": {
      "repository_source_sha256": "eda1dd0fe5981ba90af097adff770c8efdf5b612986598c2010058a3c551dc2f",
      "en": "「You've lost sight of why you fight!」"
    },
    "206:13219": {
      "repository_source_sha256": "7b53992d858e49f73b7d3782a3d1cbf73402b4eef28335077e66b20be3f82d80",
      "en": "「Guh...! Outside my awareness...!」"
    },
    "206:13250": {
      "repository_source_sha256": "0fe2dd2910c95da55b2d2b8bb16fa3b4e076b0f1dbe4e4d8d8d4986489d6b06e",
      "en": "「I got distracted elsewhere...!」"
    },
    "206:13277": {
      "repository_source_sha256": "ee04e063bd85525c60098beae0611fc470c9c6f3356f25a8ba0c94244643224c",
      "en": "「I'm hit...! But even so...!」"
    },
    "206:13316": {
      "repository_source_sha256": "1307f949ff9598ff0c64de74b076be36d4db0f2d09a21ee42d40c89965542172",
      "en": "「Even if you come at me,\\nthis little power won't do!」"
    },
    "206:12262": {
      "repository_source_sha256": "9c77f8ed6a4620aaca8a17ae2b9ea21d16f12671720f3825d55bb477c022d176",
      "en": "「I can read the enemy's moves...!」"
    },
    "206:12287": {
      "repository_source_sha256": "4eaefae15e6b1753e82d7fe3a28677ddf4fd6ad59c505e8d82f1f3bb62c7f54d",
      "en": "「It's not just about attacking...!」"
    },
    "206:12326": {
      "repository_source_sha256": "4ce6c6361ddcb0684bd601ae79c7e1d71b1b965938e8cb4b1886cb7ceb3118c2",
      "en": "「You may think you nailed it, but!」"
    },
    "206:12361": {
      "repository_source_sha256": "f2af2a64f3d02eebfd932f23452767524344dc44699552a27fbc15d9fd7309c6",
      "en": "「If I focus on dodging, I can...!」"
    },
    "206:12398": {
      "repository_source_sha256": "3d1a1014d164af6591f6dff4681672b7390e329aef842cbe8ba78887c5fdf5c7",
      "en": "「If I know I'm being targeted,\\nthere's a way...!」"
    },
    "206:12455": {
      "repository_source_sha256": "5358014490644dfd772914123117906aeefd16c3382b3f93c1f6ef801f25baab",
      "en": "「If I can let out what I feel...!」"
    },
    "206:13178": {
      "repository_source_sha256": "f3950bc7372ae6471d5e2b87df91dea91e4df9cef2208d52cc758904447efc28",
      "en": "「If the $$サイコ・フィールド$$ catches it...!」"
    },
    "206:14261": {
      "repository_source_sha256": "fe3688c156540ca91fc7bf192d41d61f426efbd76073eefda452648f667ff036",
      "en": "「$$バナージ・リンクス$$! $$ユニコーンガンダム$$, go!」"
    },
    "206:15883": {
      "repository_source_sha256": "7b464902aa7f96fcb07297fb8c7d26363d4ef5def359307d9403f34cdb6d5632",
      "en": "「$$リディ$$!」"
    },
    "207:13826": {
      "repository_source_sha256": "26932c9c4ea9bdfeaab046879cbc28799fe85ac9eec3988ced0d85802dbc65b8",
      "en": "「...! $$オードリー$$!」"
    },
    "207:13849": {
      "repository_source_sha256": "d0b34e57ad59eb687a8bc7a18d98773e8f22f069c226f812ea02c3f009df31c3",
      "en": "「You can do it, $$ユニコーン$$...!」"
    },
    "207:13895": {
      "repository_source_sha256": "cf0da7bbd841493e7a917d49d85215966e4711036e10f8bfcfe464cf48be00e6",
      "en": "「I know. Everyone's inside this...!」"
    },
    "207:13934": {
      "repository_source_sha256": "8a735d1b14730d72c2f75f2f8b0515ac16ba87542eec6ee313e5bf0950f875ea",
      "en": "「$$オードリー$$...」"
    },
    "207:15957": {
      "repository_source_sha256": "cc3cb836279948e2c666ec83544d957f6ec3dbd5244f667e24bd9a3ec01cfa0b",
      "en": "「...! Nooo!」"
    },
    "206:7624": {
      "repository_source_sha256": "e367a5a5269816769df93980120136f796afd35ce42886aa7238546ef2d9d7db",
      "en": "「Still, it has taken quite a while, hasn't it.」"
    },
    "206:7671": {
      "repository_source_sha256": "89f0aa0aa7935e76d4a9155116c287acfe0c85a6c5e63998cdc1f7f4f4cb77c6",
      "en": "「Dear players, so that $$フル・フロンタル$$ doesn't get there first, I hope you'll resume as soon as you can.」"
    },
    "206:7776": {
      "repository_source_sha256": "4e4f28f33408c6a2dddf492b983038aa25f53582a77beadcdbc79bcf06d7df92",
      "en": "「Ensign $$リディ$$, I hear you learned what the Box really is. Tell me what it is.」"
    },
    "206:7869": {
      "repository_source_sha256": "7efe83f55d3ebd269bd0fa7623a456221fe30178e166fe3e6458db75af723680",
      "en": "「Why not? I should have the right to know too.」"
    },
    "206:7929": {
      "repository_source_sha256": "1957f2a8c9524e4b5c195cd7688215ca91d37103191069127550d24ba6bfffdb",
      "en": "「Then I'll have to see for myself what the Box really is. Together with all you players.」"
    },
    "206:8012": {
      "repository_source_sha256": "c644e258ed1330c7a009e3b0f343ee068d3c5411a636a5cd7a3e4c982d7d49af",
      "en": "「Everyone... To learn the truth, please lend me your strength. I'll be waiting for the game to resume.」"
    },
    "206:14318": {
      "repository_source_sha256": "cf5f9cdbc7eae1097ad798a3b4b533607a7a920995e9cfa764661b2f0b28d4b9",
      "en": "「Somehow I cleared this map too...」"
    },
    "206:14357": {
      "repository_source_sha256": "e19349e72fb466614ef5b2dcc24be61a9df5bd6b12c2e23aa29f59168ff1b8ce",
      "en": "「I'm getting used to SRW little by little too! I won't let you pull that!」"
    },
    "206:14434": {
      "repository_source_sha256": "456bec8cc13275a41d61db19b86dd61fbd2e6b28e15b3a5de7293564236dce4d",
      "en": "「I'm asking you too! The outcome of this battle rests on you!」"
    },
    "206:14507": {
      "repository_source_sha256": "b599b212d7354a55386d486804bdba4947b26f7644f6a77fbefee7d66ab61bf0",
      "en": "「I think so too, but... It's always like this...」"
    },
    "206:14554": {
      "repository_source_sha256": "3c058fa23f967cca84de2cb1b740a6fce8d6bfcc0bd9a42f28f949641428cfb3",
      "en": "「'But,' 'Even so,' everything I do thinking that just backfires. At this rate, someday there'll be a map I can't clear...」"
    },
    "206:14665": {
      "repository_source_sha256": "bf546305679ce12d5c1ae1b5d250405475c0f7f0da9fa646a3e79ac97126aadd",
      "en": "「I never knew there was such a way...」"
    },
    "206:14694": {
      "repository_source_sha256": "7034b54761704d2d7d6b70912709140a024947e4dd30fb1da5ee88aae7d5674c",
      "en": "「...If I use the Spirit Commands 'Strike' or 'Intuition', I could even hit $$フロンタル$$, but...」"
    },
    "206:14781": {
      "repository_source_sha256": "0f50e8339d843cb2270809387b884334178e92d50b5ef27400131c885e71d721",
      "en": "「What's wrong, Captain?」"
    },
    "206:14814": {
      "repository_source_sha256": "e03abbe9f551a005ee39ba107078f10766ce610964b5a2bbeddd21c11e20c0bd",
      "en": "「...I'll... I'll end this war!」"
    },
    "206:14857": {
      "repository_source_sha256": "634a8ed6263bc44c5e94f628a720d188d5601e2eea6c089f9e826e205e4cebfb",
      "en": "「With the power of $$ユニコーン$$, the beast of possibility...! That's why...!」"
    },
    "206:14906": {
      "repository_source_sha256": "ddc66ee5accdceebd7364e003eaabfe566497a28f37451fef0b92e59f2de31de",
      "en": "「Even so...!」"
    },
    "206:12001": {
      "repository_source_sha256": "3b46136886529e7ff2d19774f7f86babb0f6eb51b2628a29ca7f6f850b2907cf",
      "en": "「No! Fall back!」"
    },
    "206:12026": {
      "repository_source_sha256": "96337683f027906b51f02889c56ad21f71bbedd0de04689cbe44838329c8a278",
      "en": "「I'll find a way...!」"
    },
    "206:12057": {
      "repository_source_sha256": "6ed1865910c8467a7732e0e2c99461e25ad4d0e3bc5299b6fc03ffaf59b8d62b",
      "en": "「Don't push yourself, $$マリーダ$$!」"
    },
    "206:12098": {
      "repository_source_sha256": "8258ee3c6c8f6e253acca88b1a0d590e31ed99a2e69a040f63412ff86fc96a8e",
      "en": "「Please fall back, $$コンロイ$$!」"
    },
    "206:12135": {
      "repository_source_sha256": "8a17c8ac34011c22efb6b0ef35a7e824b2d66161a3fa804f99ea955f1fabf6b0",
      "en": "「You meant to target $$刹那$$, but...!」"
    },
    "206:12174": {
      "repository_source_sha256": "d1ac93df2d77eb40431bf1f25ec400875a567d37e5c316c495099a379f4a0261",
      "en": "「You're too distracted, $$ガロード$$!」"
    },
    "206:12211": {
      "repository_source_sha256": "9f003bbb5da380750ccda660e212e4d04d61ee634aff00df524a85491b73aada",
      "en": "「Please get behind me,\\n$$ロラン$$!」"
    },
    "207:11365": {
      "repository_source_sha256": "5650e90e9dae97cd780fced635e12fe30d40e3bc7dfa74b6d348b46d085dd01e",
      "en": "「No, $$リディ$$!」"
    },
    "206:8427": {
      "repository_source_sha256": "c2a4958dda693aaeebeaf94497e9487d2035aec89710f93cb4dcf974978ce114",
      "en": "「I'm getting through!」"
    },
    "206:8448": {
      "repository_source_sha256": "47e77b8e574916a12803a6266e7b50853d7dc92ed6cf388259d371b72260e82f",
      "en": "「Move to the front!」"
    },
    "206:8467": {
      "repository_source_sha256": "47615b3ed9a6be5ad73e05cc13f47a500f74e3d859ce364980a7b0ae2a5e8ed7",
      "en": "「I have to do this!」"
    },
    "206:8496": {
      "repository_source_sha256": "78450b654932ac8a58ed3533f30835b9fcbfd43dc94532d922821572e39e2c9c",
      "en": "「You had the option to run!」"
    },
    "206:8531": {
      "repository_source_sha256": "eb5ccc8f116d3370f90b373332c89942731c33dffa01819928c03a4fe7ba96de",
      "en": "「Before it comes to the worst!」"
    },
    "206:8558": {
      "repository_source_sha256": "b0652555affc86fc305d93f4057805edd79f589e8b20fa36bd2f8a428f058e67",
      "en": "「All I can do is move forward!」"
    }
  },

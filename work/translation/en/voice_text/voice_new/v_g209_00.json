{
  "schema": 1,
  "rows": {
    "209:0": {
      "repository_source_sha256": "6e62ea5e0ab41512e62486ad68cb41a5cbf0bfb57464ce76d5014e81a3d217d7",
      "en": "「Heh... Help me kill some time.」"
    },
    "209:41": {
      "repository_source_sha256": "dc9985b6dc30c99e2afde3dc626d52bbcd3e4da00b6905004cc2dd20d722a813",
      "en": "「How long will you hold out?」"
    },
    "209:76": {
      "repository_source_sha256": "6c734c0ee12f79dc19b3f50df5f102df063428c75f292c2c326c5ab87e882d9c",
      "en": "「I hope you'll cry out nicely.」"
    },
    "209:115": {
      "repository_source_sha256": "806bf111b1228147b325fc2a8b3ef5f6a82efa4faac920316abf1832a91c8e47",
      "en": "「There's no meaning in anything I do.」"
    },
    "209:146": {
      "repository_source_sha256": "b981a5b4339ecf94559b30951a02a96b76400f7e8a0f76425ca8b74aab390420",
      "en": "「I'll never run short of playmates.」"
    },
    "209:177": {
      "repository_source_sha256": "6b8865ef1b0f9f39c5b334eaa9c9cec366a53b82a9bc67e60be1daff847780a9",
      "en": "「I want to know your blood's color.」"
    },
    "209:214": {
      "repository_source_sha256": "f4de15264a7ddcc906bb8d4f3230171cd7648cb7d3c4d4cd6e2ab86113dd8025",
      "en": "「Feel free to run, if you want.」"
    },
    "209:251": {
      "repository_source_sha256": "03efd19b85543fc5870080a6ee48d82daaa5d15e25aaf255512ca306125d3e82",
      "en": "「I'm $$バルビエル$$... An Apostle of Hatred.」"
    },
    "209:290": {
      "repository_source_sha256": "a8a1ca9d6cb5bd5560bde38515ac497abec2a0c02f3846837a4177506744fc74",
      "en": "「Scorpion venom... Have a taste.」"
    },
    "209:319": {
      "repository_source_sha256": "0f21c71e3bf2c53ee55e5cdb53815b4d9df35a52f005c7f8de4b52b0fbd3c1f2",
      "en": "「I'm not called 'Needle'\\nfor nothing.」"
    },
    "209:368": {
      "repository_source_sha256": "4e77fcf81d8f571a019b6ea4352d518ceb23e031890440d6ca88f8ae58e93b88",
      "en": "「I want to sting you in the heart.」"
    },
    "209:403": {
      "repository_source_sha256": "22cbf1b0428251215f4b6a77952f9bc8ce3bcf3340452d839823f8fa47aa0f1e",
      "en": "「Heh... Does hatred need a reason?」"
    },
    "209:442": {
      "repository_source_sha256": "6af02271ebc733f82bc8096b569dca224e45119fc62078bdd991940b4e0cf99c",
      "en": "「I trust that you'll be the one to\\nquiet my blood.」"
    },
    "209:491": {
      "repository_source_sha256": "9f7b49c4cc1236ed17c80efb030fa84c7e6bb52a934177f0080e538622e893fc",
      "en": "「Hate me.\\nThat way we'll both have more fun.」"
    },
    "209:546": {
      "repository_source_sha256": "72848401d4de041699037d9f6aecebe531621d45ba9553c0991e102d345fc146",
      "en": "「Do you get it? The image of maggots\\ncrawling inside my head's veins...」"
    },
    "209:613": {
      "repository_source_sha256": "c50fbb2f6a5864abb6cf30ba31f8fcdc26dc7169f84643818acc46579057214d",
      "en": "「Poison and hatred are alike.\\nBoth eat away at a person...」"
    },
    "209:668": {
      "repository_source_sha256": "7b5177b27505afd7048f1385bcf810af19322aa0f7de03399507b231f0c8fe22",
      "en": "「Begin the Sabbath of hatred...!」"
    },
    "209:705": {
      "repository_source_sha256": "810f69c4435ee3b8cbcc571974b5fe70fe449147e716589e28ee756e6024943f",
      "en": "「I want to see you break...!」"
    },
    "209:740": {
      "repository_source_sha256": "24b5d45771f9d916a1592e0ab5c31924ce5c8e6b4073b0c3140c37b489f1c44b",
      "en": "「Hatred's flames scorch us both...!」"
    },
    "209:783": {
      "repository_source_sha256": "6bba9307057c1b944f020605527ff070173f35875643bb9001b31e98a339d7b7",
      "en": "「To decadent, bloody beauty,\\na wine of poison and hatred...!」"
    },
    "209:832": {
      "repository_source_sha256": "df2c1e9c750e7df212e73166c1b2a19c310f0eb15adde19086b2b080d73b102c",
      "en": "「No reason. I just hate you...!」"
    },
    "209:871": {
      "repository_source_sha256": "0a0f2d61d4f7ffa5532fc130998fa3578719921551b8eb7eb167bb4e58fae091",
      "en": "「Hatred is what makes my blood\\nrun hot...!」"
    },
    "209:920": {
      "repository_source_sha256": "614ca9f3f73f67f640fa933f066788897836fa7edf1808e8f334bdb75b157c6f",
      "en": "「Right now, the blood in my brain\\nis about to boil...!」"
    },
    "209:975": {
      "repository_source_sha256": "0cad821376cdbbe1ab138c5f2b235f3f9866198995a2cd1048d0c6b0d4037105",
      "en": "「I lost all patience with you\\nlong ago...!」"
    },
    "209:1161": {
      "repository_source_sha256": "2955a59a1a3d3ad8ecd80767e383634038540a7a96ab4e663e6c7455a6e68bec",
      "en": "「I can tell, $$ビアル星人$$.\\nYou carry hatred for the masses.」"
    },
    "209:1224": {
      "repository_source_sha256": "d8e414aa06d5e299dcb89393229e71d63c97f2ce5d5b09cce0e91321332ae400",
      "en": "「Peel back a dashing fellow's heart\\nand it's full of hatred for his kin.」"
    },
    "209:1287": {
      "repository_source_sha256": "d75b65f56fc28ef52f428a25546cafb42ec7be1fe4e39c67d8a9b6186311c538",
      "en": "「You hate them, Young President?\\nBig business, recession, red ink.」"
    },
    "209:1342": {
      "repository_source_sha256": "91f593a8477fd46406b397d3c104040e92bdd54d5d43a8978600e06c75dc4fb3",
      "en": "「A heart that hates evil...\\nHeh... Let it swallow you whole.」"
    },
    "209:1401": {
      "repository_source_sha256": "e9bc27fc831c47ec77e9b4fbfca3055fa5f8df3fcbd8316ed71c0abdeebe6660",
      "en": "「Your power of love can't\\nerase my hatred.」"
    },
    "209:1456": {
      "repository_source_sha256": "72cee8ce0b9396590486d717a0afd4015355aa85b8991123d97fe2900ee3a1d1",
      "en": "「Go on, hate them, $$異能生存体$$.\\nWhatever tries to twist your fate.」"
    },
    "209:1521": {
      "repository_source_sha256": "a2ffd59a88dc75235f9ee6e227fdc9852dbc1de7b09f6c5bc78542d2e400a235",
      "en": "「A guidepost born of the civilization\\nof fire... I can't leave it be.」"
    },
    "209:1570": {
      "repository_source_sha256": "27dc49bcff98bfe7ed09ce5991c10b0306be9be7bc638e5e178ce43a74a0c10f",
      "en": "「Proof of the civilization of fire\\nis gathering in this world...!」"
    },
    "209:1625": {
      "repository_source_sha256": "a0436c2d9632edc1d640b2c4b0e97ce69591df464f2a7509da5e5e0a59ed2a9f",
      "en": "「Gundam...!\\nJust looking at you irritates me!」"
    },
    "209:1680": {
      "repository_source_sha256": "2513a5ced61d75e3d728afcda64ad21cd89315567be6790658e59bf7e0ba93fd",
      "en": "「Think hatred vanishes if you just\\nunderstand each other, $$ニュータイプ$$?」"
    },
    "209:1737": {
      "repository_source_sha256": "e5ab8978122f659a15e08eadef583ba7efe873599c5bfafaeda444002a3c556f",
      "en": "「You believe talking erases hatred,\\n$$イノベイター$$?」"
    },
    "209:1798": {
      "repository_source_sha256": "6c2dc14e68d4f233d4ca4160714d0f8a87b3c6d8bf2bab84681e7fa429430bd1",
      "en": "「People are born with seeds of hate,\\nand they sprout.」"
    },
    "209:1863": {
      "repository_source_sha256": "64eafa853f7ba79d25067e8c3001ec493951ac74a6dbc2e790952b008df37c1e",
      "en": "「You hate $$アムロ・レイ$$ deep down, right?」"
    },
    "209:1904": {
      "repository_source_sha256": "ac8b1edd6ef3256179ae58ad07e34c1f03071c3746af2a58351a464c5bf17aa4",
      "en": "「The Heart of Space must surely be\\nfull of hatred too.」"
    },
    "209:1955": {
      "repository_source_sha256": "b610eb2cae20488e43549fae78396e330b7c52f4ab6616a7393d0dc43edc6b3d",
      "en": "「I'll seal the beast of possibility's\\nfuture with scorpion venom.」"
    },
    "209:2006": {
      "repository_source_sha256": "8277fbbe618f702212d16fee8c7bd49aca23ed7f03a859bd8cb2d079aa1ea061",
      "en": "「Butterfly vs. scorpion venom?」"
    },
    "209:2041": {
      "repository_source_sha256": "4e578a54c851f62dfd1d772eef30befb62cf2519f722b742b770de9b625620d7",
      "en": "「The $$サテライトキャノン$$ is haunted\\nby the hatred of countless people.」"
    },
    "209:2110": {
      "repository_source_sha256": "54547194dfd5994979cd72e657672ffe527f76bbef6f0ba1bdca63ecf1395fa8",
      "en": "「Does a beast even have the\\nemotion called hatred?」"
    },
    "209:2159": {
      "repository_source_sha256": "4401402d3291430ab3e5606b0bb8d804fa243b93f02f6127a942b532a643c592",
      "en": "「Won't leave the beast-blood heir...!」"
    },
    "209:2198": {
      "repository_source_sha256": "8eaa03e9ae1b595abcb429b4edee6c96738fbc5e4aec2919c3239571074ccb67",
      "en": "「$$始原の特異点$$...\\nHow many people hate you, I wonder.」"
    },
    "209:2263": {
      "repository_source_sha256": "948e490c10626815e59cb400b3aaae5073539b112f5f1d5712c2e9bb2d77afb5",
      "en": "「$$始原の特異点$$...!\\nThere's a kill order on you...!」"
    },
    "209:2322": {
      "repository_source_sha256": "8dc741c86afc0f2d9d58e8addb4c43466abba2ab2327332d17567ce855df3817",
      "en": "「Stop that song...! It's grating!」"
    },
    "209:2363": {
      "repository_source_sha256": "6b6eff4f7f0d6e728afc345a59fd4458cbf654931f287a9b6b72098be570e24f",
      "en": "「Gnat...! That buzzing is annoying!」"
    },
    "209:2404": {
      "repository_source_sha256": "08d0a704df47db2230c89cd547d6e7eff760e73c08af83c9e759b0094f119804",
      "en": "「You'll surely end up hated by\\none of the two children.」"
    },
    "209:2461": {
      "repository_source_sha256": "7f33004e850f697f5222b21d130ceb2cfc81ab06af6796590e916c3e6656bcbb",
      "en": "「Light is born where there's hope,\\nslaughter where there's hatred.」"
    },
    "209:2522": {
      "repository_source_sha256": "4df110f1a999c7312618501349b2a659531fcfcaa3ea39c581b2b48d34542d70",
      "en": "「Using $$ゲッター線$$ without knowing\\nwhat awaits beyond evolution. Bold.」"
    },
    "209:2585": {
      "repository_source_sha256": "6a04ee8268f07853fc0dc659ec1befb478cf559d0208e33c31834f9ac3002558",
      "en": "「Anyone who uses $$ゲッター線$$\\nought to be erased...!」"
    },
    "209:2636": {
      "repository_source_sha256": "1210d6f078e8db6d437aff91a69623a3fd24b2045344f557e012c4bf5c0d6289",
      "en": "「Ever heard the words 'out of place',\\nsalaryman?」"
    },
    "209:2691": {
      "repository_source_sha256": "5fb3e2b2568591e633ede688094d19e5f7900328161a58c83f6878de9e28e9bd",
      "en": "「Posing as the agent of God's will,\\nNegotiator?」"
    },
    "209:2752": {
      "repository_source_sha256": "a7525c2306b2b382b2b8582cf5a70f73d1c5d9317cb761dfd5f5e44a96313ddc",
      "en": "「If I were you, I'd have denied\\nthe world itself.」"
    },
    "209:2811": {
      "repository_source_sha256": "af883ab25c89fb5bcdea03fd10d97ebd87151fe93488908896a6ffd51dcc4fd0",
      "en": "「You gathered the world's hatred...\\nI'll throw mine at you too.」"
    },
    "209:2876": {
      "repository_source_sha256": "6847516b574e92e3eba6b5b602593088f5a240982e2f9d2857ee90ec7e65a1a4",
      "en": "「Your Geass was quite the spectacle.」"
    },
    "209:2909": {
      "repository_source_sha256": "b923fa7992f8060b8e2165ce33133ad32d18bc48ee7b06a9863f1f19c4cff9c6",
      "en": "「Don't you think war is\\na product of hatred?」"
    },
    "209:2964": {
      "repository_source_sha256": "02c1d521759649ba3e05bfd70180093ab93b6cf60c8260ab2ab9b16064a86e36",
      "en": "「The people you shot probably\\nhate you.」"
    },
    "209:3013": {
      "repository_source_sha256": "cd61d1018a05840626542745b008173d323f25fb94f953071083757f450b244c",
      "en": "「Mere Earthlings have no right\\nto use that power...!」"
    },
    "209:3076": {
      "repository_source_sha256": "f03c47cd4bedb939cd4055c9669103ff4c21b0cadb840ac288c9e19b84c7d84c",
      "en": "「What the hell are you?!」"
    },
    "209:3101": {
      "repository_source_sha256": "bfff8c3e176712012dc18d386c8d3027cbadbbfe96464b35be1cad1de51d1b6f",
      "en": "「So you'll avenge the $$天翅$$s' hatred?」"
    },
    "209:3144": {
      "repository_source_sha256": "a8295592928e75038d6e367855e24869b24df3bad9a1aef51f21bb6ac92f5d86",
      "en": "「What the mingling of waters creates\\nis meaningless...!」"
    },
    "209:3203": {
      "repository_source_sha256": "3beec07649f88cf279e397af89433bb7a9da3bec6b3d06d20017719761931219",
      "en": "「You should've only fought $$バアル$$,\\nthat's all.」"
    },
    "209:3258": {
      "repository_source_sha256": "97b891020a190f45d00220d64324211d442676550548456b419552718c6c4784",
      "en": "「Since you bear the name Gun,\\nI'll erase your existence...!」"
    },
    "209:3309": {
      "repository_source_sha256": "4652659b83bfbcb1ab1ba4edc6aa9325d21bacd30d494b44e0eee8fd0eeea5e9",
      "en": "「I sense your haste and irritation.」"
    },
    "209:3352": {
      "repository_source_sha256": "1a8daadfc1ebf6cd6cb451a71a0a3a43fa817c8f94b174d3e33f4f6535d472d2",
      "en": "「Beings created to fight $$バアル$$...\\nPathetic.」"
    },
    "209:3407": {
      "repository_source_sha256": "209205cacb7d2721d2a94c9ff57650ddcf2956599811585a8d5d801bbbe0f911",
      "en": "「Even your drill can't pierce\\nmy hatred.」"
    },
    "209:3456": {
      "repository_source_sha256": "30de272ad6de583e91ecfb7a0be5b30b6b4b5ed0b1d39070d935ad24b5581e0a",
      "en": "「Still unaware the destination of the\\nwind is despair, I see...!」"
    },
    "209:3515": {
      "repository_source_sha256": "2fbdefd50aeb85652219d170a686b2028594c35807e117c415454ac7fdbcea67",
      "en": "「A man-made god's vessel. Arrogant.」"
    },
    "209:3552": {
      "repository_source_sha256": "0bea4619f9d35412d2acade10bd001fac9f499c515cf7d35d344e738f3f91d8f",
      "en": "「A punk who forgot Alliance rules.」"
    },
    "209:3593": {
      "repository_source_sha256": "5a3fe4e57bec5f2854d19f26a86a140905271e305462ddc49093f967112c37d2",
      "en": "「This $$マシンキャリバー$$...!\\nSomething's off about it...!」"
    },
    "209:3646": {
      "repository_source_sha256": "b8d4b706aee55437883add42aec292a67daffa563824a34691e7cdb28703a681",
      "en": "「It's your fault for not obeying us.」"
    },
    "209:3685": {
      "repository_source_sha256": "46b6674be780b85e62d89275d0319719695c75c62449d4d99b8949ed62844ecf",
      "en": "「Do you think a second-rate Reactor\\ncan beat me?」"
    },
    "209:3742": {
      "repository_source_sha256": "a032df46e336243ab53c4b566c779c6312e90280cc8efd9f65fb5d5cdd0ffb7a",
      "en": "「$$セツコ$$... I'll kill you myself.」"
    },
    "209:3783": {
      "repository_source_sha256": "e5d2a6838501fe1872a607c6c39427307b021ccbbcf4b3b9a162937a987c8ff2",
      "en": "「$$セツコ$$... Ah, $$セツコ$$, $$セツコ$$!」"
    },
    "209:3822": {
      "repository_source_sha256": "f05a631db8869b9e225cbbfe3e57002f07a6c4b7e0a1b3fa503e07d6480b8a48",
      "en": "「I don't hate stifling men so much\\nas I just can't stand them...!」"
    },
    "209:3873": {
      "repository_source_sha256": "36d211cd2e46eb1f1884b187cc7638e1dead5245fdfe048e815bbc2dd02b3a89",
      "en": "「Heh...\\nCravia must hate you, surely.」"
    },
    "209:3922": {
      "repository_source_sha256": "9546bfca9bfdff884c3c68a025de94eac98f3e2779319ff47c47bf6dae3e26fe",
      "en": "「Don't get cocky just for beating\\n$$ガドライト#pilot$$.」"
    },
    "209:3979": {
      "repository_source_sha256": "a2fb5cf007e2e4c7ef8077b65beb9078eea0022abbe4d954fe3d0178eaa87ad1",
      "en": "「Admit the hatred for your mother\\nthat lives in your heart.」"
    },
    "209:4030": {
      "repository_source_sha256": "6c5e0c1de489ae32f107f0f33b36a6fbfa08fb0b324d04f91c752359bd27fc54",
      "en": "「If you shoot that ship down,\\nhow many people will die, I wonder.」"
    }
  },

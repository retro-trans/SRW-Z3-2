{
  "schema": 1,
  "rows": {
    "209:4089": {
      "repository_source_sha256": "3c18076b10652dcf6a1fac840b7feeb23af65945b4bc759d2166ed83c38b251b",
      "en": "「Sink the mothership, end this fast.」"
    },
    "209:4128": {
      "repository_source_sha256": "08914c2f39b219edc597d45b7ad37fe8c0a49dcf2efcdde1cada06b568872ecb",
      "en": "「Hatred for the one who took\\nyour loved one... I understand it.」"
    },
    "209:4187": {
      "repository_source_sha256": "dbb01ca86d8d290efa15c3013139259c8514bcc986b9892ed3325a1519d8dc19",
      "en": "「Go ahead and hate your love rival.」"
    },
    "209:4222": {
      "repository_source_sha256": "e9ca1d88158497791557c2804029e28589164461bb51fd76d55fa68850417a24",
      "en": "「No escaping the scorpion's sting.」"
    },
    "209:4253": {
      "repository_source_sha256": "5288c926c25193df205dcf7fc6c75f306e81ba2df8a910a2625f9cecc0ae1ee1",
      "en": "「You're not planning to hit and run?」"
    },
    "209:4290": {
      "repository_source_sha256": "edb6cf2d30a47eb343c9dfdfc490c5aae2dd07d43ce3059cfa1c70e9a75ac082",
      "en": "「Do you think I'd let you get away?」"
    },
    "209:4323": {
      "repository_source_sha256": "935a241d2c98a862c27f8fd93ad0362476c7dd1a73780319a186705063b0da90",
      "en": "「I'll repay you with my hatred.」"
    },
    "209:4360": {
      "repository_source_sha256": "31bd9e6f67ea4406ac6beba28c7a53d7a9d5cadac38abdbb995adeb3e7cabfd6",
      "en": "「Running away looks pathetic on you.」"
    },
    "209:4387": {
      "repository_source_sha256": "8441bb646b6e93c9fc80f76083c547b0eb66be9ca6047b301d2d48514b3dc23b",
      "en": "「You must want to die, attacking me.」"
    },
    "209:4428": {
      "repository_source_sha256": "8f9e4054d5c205944da96b4ceedc71c5f68dc566904e194e602369cf77e4a5c7",
      "en": "「Hit my right cheek, and I'll just\\nstab you in the left chest.」"
    },
    "209:4477": {
      "repository_source_sha256": "5d722d1d02f7acfbcf8701a3440147c24d3cc4ff4c8ff7a19ad92ec625f89eac",
      "en": "「Know how vindictive scorpions are?」"
    },
    "209:4512": {
      "repository_source_sha256": "fc23c2283e27243791e79ab9b234f452de3f6b57b9d8c2e1ab0375b147a610ae",
      "en": "「Hatred drives me.」"
    },
    "209:4539": {
      "repository_source_sha256": "7d803a784510f7b210005a7583e6f096703b5af91b469d17f4e950a0c4ce35fc",
      "en": "「Will you leave my hatred no outlet?」"
    },
    "209:4578": {
      "repository_source_sha256": "38a56367480c4df80038c2154bbad0ce7f8f7faa9f4624f95fb7451cb2c5a55a",
      "en": "「Underestimating hatred and grudges?」"
    },
    "209:4617": {
      "repository_source_sha256": "58d9aa23dfae71a30199a6d381a73490a52cfabb0fb232648d8c5a9e03f17b80",
      "en": "「Anger me and expect to get off free?」"
    },
    "209:4648": {
      "repository_source_sha256": "dc857e880baf226ca97f85c25a1fd20454e3b7b22858df068660e4294c2e74f0",
      "en": "「Move aside. I'll finish it.」"
    },
    "209:4683": {
      "repository_source_sha256": "ae01a6501d5cd0da03c2d6f974108f519d7ddee87c588dd1b2d44cebda80fcf7",
      "en": "「Hearing death cries is my privilege.」"
    },
    "209:4724": {
      "repository_source_sha256": "753d97449331aad1175d3a5b12064d9f4fc9ee7f825931a8328a25baef340906",
      "en": "「You're in the way, $$尸空#pilot$$.」"
    },
    "209:4743": {
      "repository_source_sha256": "f800dc1d6bcf7a766460c401b47a9ab1e82598eae1165833f183cccc9c935c1e",
      "en": "「Stay out of it, $$ストラウス$$.」"
    },
    "209:4774": {
      "repository_source_sha256": "4d2ad16fbad96f6fb4091202b50e31bc829aba9fa1af4d496b92a2c563e1173c",
      "en": "「You're annoying, $$エルーナルーナ$$.」"
    },
    "209:4809": {
      "repository_source_sha256": "505672811315a639727743bed82214e67fa0f0d87168a2dfeb9db174dd4ba6e1",
      "en": "「That's rare,\\n$$アウストラリス$$ failing to finish the job.」"
    },
    "209:1024": {
      "repository_source_sha256": "d46d5d3575e92fa5d375ca1ddbb3463376eecafb0a55497fe67f11dfe000fdbc",
      "en": "「I never give up prey I've targeted.」"
    },
    "209:1065": {
      "repository_source_sha256": "eb5cc837d451a38b571052b2c2b109dd29658a07f30b9d5c5654c8d7568e7846",
      "en": "「Never, under any circumstances,\\nare you allowed to refuse me.」"
    },
    "209:1122": {
      "repository_source_sha256": "ee26a7aef573abc46f4a60587e1e04bd777c287456e3580de38229e751d0aa4f",
      "en": "「Heh... some poisons work slowly.」"
    },
    "209:5025": {
      "repository_source_sha256": "95591327ae4f2a600f917726fec031a39e1b0a5d826427f59f04c6fd2f0f24d4",
      "en": "「Making me your errand boy, huh...」"
    },
    "209:5056": {
      "repository_source_sha256": "e6c145df30cdef7c539e77f3260671b79b4183408c2a3e82e7a4110d21dbba69",
      "en": "「I'll kill the target first.」"
    },
    "209:4959": {
      "repository_source_sha256": "07d24fff749df0acd1fcbcc7ce963e9337090a248104ac4425b74f8f1a888005",
      "en": "「I'll take you on. To kill you.」"
    },
    "209:4996": {
      "repository_source_sha256": "919008cc4e8e28d6dd3d7f57c8375ec3663e3d12124c788b733890109a687c40",
      "en": "「Be honored. I'm your opponent.」"
    },
    "209:10549": {
      "repository_source_sha256": "254c225edbe51bfd926edcaa1e506dfe43c16d1ecf170799febe318fd66dc298",
      "en": "「Good grief... that's all you've got?」"
    },
    "209:10588": {
      "repository_source_sha256": "647be27c401bc677dc78e565960a05e8689cc485d92fde13cc420eab8442bb84",
      "en": "「Heh heh... my hatred just\\ngrows stronger because of this.」"
    },
    "209:10639": {
      "repository_source_sha256": "7d685f52f1b0d5899b9c832444cb3da231daa4a33a9dbd89e0c31b0201d63500",
      "en": "「Not bad. I'll remember your face.」"
    },
    "209:10678": {
      "repository_source_sha256": "5934f7580bcdacd0114f716e4ad5957df544c54f213fbde7cbcff998f36816ce",
      "en": "「Impossible! Impossiiiible!!」"
    },
    "209:10717": {
      "repository_source_sha256": "1b50a46632214beeb59d9dc08b7505514f5dc8c88d4edeeea13bbb1d4c4e9ddb",
      "en": "「U-uwaaaaaaah!!」"
    },
    "209:6897": {
      "repository_source_sha256": "ac31f16ef6d8f08dfecfcdbafc09c8cde673f7a32d86b69d6c200eca60c60975",
      "en": "「Ha ha ha!\\nMy blood and yours are mixing!」"
    },
    "209:6946": {
      "repository_source_sha256": "4373de42b5f085bcb8bc5d5ad115c4ba74b7823a3a6c14095df44ea10f723e77",
      "en": "「Yes!\\nHatred rules your brain and mine!」"
    },
    "209:6995": {
      "repository_source_sha256": "21d67bb3a9cfbdcd07b0076f6b66c8d297639ccb1f22a3cd6106870b41b08725",
      "en": "「That's right!\\nFight with hatred like that, too!」"
    },
    "209:7048": {
      "repository_source_sha256": "f33099013e1bd2850edcc700993091b2c718e0a7a32f0b8165929757b31232cc",
      "en": "「Blood in my eyes! World's dyed red!」"
    },
    "209:7087": {
      "repository_source_sha256": "ca174179018873e5b15b946241e31c1d0e210f671612dc22b5a65da348a02d09",
      "en": "「I get it...!\\nYou want me angry that badly!」"
    },
    "209:7146": {
      "repository_source_sha256": "757e63eb0f988836b4e0ede10520a9516f869e7b21767ea82a87971e96d89740",
      "en": "「I admit it! You're the best prey!」"
    },
    "209:7185": {
      "repository_source_sha256": "199d9b8da49ab953e5057ad99c0fa2b481428340bcb4f40ba6fbe94d4c36d3a7",
      "en": "「The pain only doubles my hatred!」"
    },
    "209:7222": {
      "repository_source_sha256": "6fbf05cd5a675f00d94e3fe6bc1e869df72b9c97895d61a38a23bbb4bb174688",
      "en": "「$$アン・アーレス$$!\\nTurn my hatred into power!」"
    },
    "209:7271": {
      "repository_source_sha256": "467f79730547e704a2f7e061d7c7cb85894455da188c15c6f5cebff87c8a1cd9",
      "en": "「What the hell is this!\\nWhat's going on!?」"
    },
    "209:7322": {
      "repository_source_sha256": "8b0a93d765a3e6b0a4a211b7453a509e7e29c3e93e0612355ae2a4bb97cbb3f3",
      "en": "「Damn it! Don't screw with me!」"
    },
    "209:7355": {
      "repository_source_sha256": "00c89c9d4e5f7baecb91ad9a26cb3dfd400631da6009d3e40a3a2453ff05ad97",
      "en": "「I'm $$バルビエル$$...!\\nI'm a $$スフィア・リアクター$$, damn it!」"
    },
    "209:7412": {
      "repository_source_sha256": "028ffae89002c6fe6f975271751df089fd178833065b48ecac0de7cfd9301b1e",
      "en": "「A power beyond my hatred exists!?」"
    },
    "209:7455": {
      "repository_source_sha256": "16f83cc081495643482a964c4cc4449f083fc45ef2c92927599f24026df59a6f",
      "en": "「$$怨嗟の魔蠍$$! Drain my life!」"
    },
    "209:7490": {
      "repository_source_sha256": "6d506cded6608cd68c68b9f1532a6a8832fa9cdf16246938dea304f7e03aa986",
      "en": "「N-no! If I die,\\nhow will I ever vent my hatred!」"
    },
    "209:7551": {
      "repository_source_sha256": "40792b9dd0319ecebf906081627857c3852cbf327c0b63076a3c42ed6b42c6f0",
      "en": "「I won't die!\\nI'm sure I was promised eternity!」"
    },
    "209:7604": {
      "repository_source_sha256": "ebb678ac31505539671ddd9d1d6b20ae9eee897e6ba25484b74a1b68d21c8c5f",
      "en": "「No way...! Is my hatred lacking!?」"
    },
    "209:7647": {
      "repository_source_sha256": "2b4a4519163fbaabeb3a5ac461cc48e8ca193e65f51174bf1e74beb4a8b7f1c9",
      "en": "「Uwaaah, $$セツコ$$ooo!!」"
    },
    "209:8796": {
      "repository_source_sha256": "66188dd498025ee1bde3ef2638ac02759b973284eed06d1c0e1b6a2e052018df",
      "en": "「Damn $$ビアル星人$$...!\\nYou should've let hatred take you!」"
    },
    "209:8851": {
      "repository_source_sha256": "d1409559d4273e4fd089e3dec39d4b2eb228658b854a7dc6354caf6f8526ed07",
      "en": "「This radiance of the sun...!\\nAnd it stands beyond hatred!?」"
    },
    "209:8906": {
      "repository_source_sha256": "ea583c48d4b6312a38831814eb86dc585570ab74811795446f34b91d43d3709c",
      "en": "「You brat...!\\nYour cockiness ends here!」"
    },
    "209:8953": {
      "repository_source_sha256": "f7a6d0b99e94f0895f56d7ae3e6da0ecbcdf930cb7b61382d5a395b9a08b1f11",
      "en": "「Being beaten this badly\\nby a mere remote-control doll!」"
    },
    "209:9008": {
      "repository_source_sha256": "1c9e5c7744b6c057384f88379087d456f48329db03017c5dc048a3ca35f00905",
      "en": "「This is that guy's love monument!?」"
    },
    "209:9047": {
      "repository_source_sha256": "fea4e70b7e2957c468ea8a90831e2dd2e23a02f04846f19b9535212af888475a",
      "en": "「$$異能生存体$$...!\\nAre you out to warp even causality!?」"
    },
    "209:9098": {
      "repository_source_sha256": "f84207629c2d587f35252b6104883dc43b6dee052a6d9f7f2211f0ab768bd157",
      "en": "「$$始原の特異点$$...!\\nYour existence can't be allowed!」"
    },
    "209:9147": {
      "repository_source_sha256": "bddf2311b4fbea91f2b611fd80087b6dd513990b180acc4720e30b78de495e3b",
      "en": "「Damn $$ガンダム$$! As I thought,\\nyou're more than just a machine!」"
    },
    "209:9210": {
      "repository_source_sha256": "15fecea943a3cf0f0d289c6cf0917ceb5d0b4cd600d2037119df30f538b100b4",
      "en": "「Fire civilization's proof! Smash it!」"
    },
    "209:9249": {
      "repository_source_sha256": "4e7bd1aca00d6b07eedd9cca80a594a8db0e6e14e759f0a8a788ae54baa8f309",
      "en": "「Damn Earthlings!\\nYou won't walk the $$シンカ$$ path!」"
    },
    "209:9296": {
      "repository_source_sha256": "c45d1f5bcb7e6c6c73da1faed41fafed44b4f213aeffd77b6e20d00eaee16a96",
      "en": "「Butterfly poison corners scorpion!?」"
    },
    "209:9335": {
      "repository_source_sha256": "2ff4d789799f24968f785b8ffc00b70f5732920b4997df38b2cdef68c498b7b3",
      "en": "「Hot...! The beast blood's power!?」"
    },
    "209:9370": {
      "repository_source_sha256": "16b100c1d503aa412a9e878b6508730cca14bf8d534ca9b1e29c7c29f11d7c03",
      "en": "「Stop! That song shakes my brain!」"
    },
    "209:9411": {
      "repository_source_sha256": "3dd7c82be33a95a635bdebcf2620c7dd0f43af79ad05fe0620865c8f9df9a7dd",
      "en": "「Do the feelings riding those wings\\nexceed my hatred!?」"
    },
    "209:9470": {
      "repository_source_sha256": "a886a02f5be8166476c1ca84eeb2007b1570aa8f08c08c0e7b690f296ca93137",
      "en": "「Demon God of Light! Enough of this!」"
    },
    "209:9511": {
      "repository_source_sha256": "8540e673667dcf71f2fcb989f9c3981d6e508661775b12c691d9d235bf6d0998",
      "en": "「This man...!\\nIs he in sync with the $$ゲッター線$$!?」"
    },
    "209:9562": {
      "repository_source_sha256": "8808c743c7724a6a83cc66fb97e6596c5157ac295bf7b965c2ad78f8cee02e23",
      "en": "「How can a mere salaryman\\nfight this well!?」"
    },
    "209:9615": {
      "repository_source_sha256": "8d6553e49f69d2156f843ba9a54bc4e9084a7b8e965618fe440e453886fcd7fe",
      "en": "「What!?\\nThat guy's own words raise morale!?」"
    },
    "209:9670": {
      "repository_source_sha256": "15e9d1584a12f7348601b82f0f0e58d6b5e2c12ace9643680e960039936638f1",
      "en": "「Damn you, $$ゼロ$$!\\nWorking a miracle against me!?」"
    },
    "209:9719": {
      "repository_source_sha256": "7cc41804c05ccdd50b2976ec3e8db2b89350c20893d94a2314dda14ce33a021a",
      "en": "「Turning feelings into power...!\\nThat's supposed to be God's miracle!」"
    },
    "209:9770": {
      "repository_source_sha256": "46af0ed70fbf0755d9d8bb1d2b0ec8488b8eda457dc44cade17ec85238979f5d",
      "en": "「My hatred is... wavering...!?」"
    },
    "209:9807": {
      "repository_source_sha256": "45271bb1cff7516610af6809ad0db03f5509b85bd4390e406dbbf0d7271e6332",
      "en": "「Mechanical Angel!\\nPower from the mingling of waters!?」"
    },
    "209:9856": {
      "repository_source_sha256": "ac2c61d6daf48a6d6b67eb7cc26f288848bdae36acbf1a1dfd7b1b024a886f10",
      "en": "「This power...! It's pure flame!」"
    },
    "209:9885": {
      "repository_source_sha256": "14d9d89d610bf75bb386f8d8738b6e402ce9601d0c446a0bf3714574bfbc9f33",
      "en": "「You...!\\nYou've overcome the fear of loss!?」"
    },
    "209:9936": {
      "repository_source_sha256": "a214451cecffadf757e0698fa95d43587091957525cd7932d76cfcbb31707a2e",
      "en": "「What's this \"because\"...!\\nShut up, you mechanical doll!」"
    },
    "209:9983": {
      "repository_source_sha256": "94f2555c1ce9cc05fa9370aa2f9e5701fdf99881b14e7fb1a1717fa158c608d5",
      "en": "「Drill coils the wind's destination!」"
    },
    "209:10026": {
      "repository_source_sha256": "159c1ab6bcad83b6ddcfa763a240cae3ff6c648650ec17344557264344eccaab",
      "en": "「I won't accept it...!\\nTheir existence warps the world!」"
    },
    "209:10079": {
      "repository_source_sha256": "3e003a8b5ac86a93671b581d47b84487d5a2c339ba58422c31c1dad04f8ed8c8",
      "en": "「No! This guy fights nothing like\\nthe $$人類銀河同盟$$!」"
    },
    "209:10142": {
      "repository_source_sha256": "2d912fbcdacfe6065a24e2384e5110bfcdc650a4644a607dd4a672a6605585dd",
      "en": "「Nothing but a second-rate Reactor!」"
    },
    "209:10171": {
      "repository_source_sha256": "65726d9e2a5d02d9d799fd0ef8ff678fe0e0d1d92d10cfb7033d8438f6a0d651",
      "en": "「You won't be chosen!\\nI, with a baptismal name, am chosen!」"
    }
  },

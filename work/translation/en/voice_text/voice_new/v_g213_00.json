      "en": "「Hold still.」"
    },
    "213:6029": {
      "repository_source_sha256": "a6031f430d888c12d7a5e81ae5d9dc45027bdaa502f01b3e75eb8d1c7534f09b",
      "en": "「I've no use for broken machines.」"
    },
    "213:6054": {
      "repository_source_sha256": "1260046293e606a6679072cabab58a041f1be19ae8bb11e974ed2f30c3461f69",
      "en": "「I destroy machines that rule people.」"
    },
    "213:6093": {
      "repository_source_sha256": "50e90112a51dad4e6603fe75701a5be14a35e5a5d4380d1ebe7a6e8780ba64d7",
      "en": "「It's just like a $$モビルドール$$.」"
    },
    "213:6128": {
      "repository_source_sha256": "1147b6e823682c767e5afd1dc063cdd888b3bf5a29be3b718bcb4888e7be6e45",
      "en": "「$$フル・フロンタル$$, I'll stop you.」"
    },
    "213:6163": {
      "repository_source_sha256": "f8b76b520efa93519fdd1bbc6b14e795951e266cb698c14a7bfa6a10edfe2ef2",
      "en": "「That's enough, $$レナード・テスタロッサ$$.」"
    },
    "213:6202": {
      "repository_source_sha256": "0c59f88f7a9c77eacdf3346d42b861b8c4a1db0c65b66198f192ce091ac55729",
      "en": "「Stop involving others and the world.」"
    },
    "213:6239": {
      "repository_source_sha256": "f6f300cfe22557f82e256733ff4db3f403e988ab2d46092392b80a1fcdc3c4b7",
      "en": "「This age has no need\\nfor a ruler like you.」"
    },
    "213:6290": {
      "repository_source_sha256": "c23e843653ae96a39ac02cd5a54bb309150c7853c6799915cbb2fd10d41360da",
      "en": "「Removing the greatest obstacle, now.」"
    },
    "213:6323": {
      "repository_source_sha256": "c588737ea788d223200aea7928abe5c22d0874888827c60d22e3f3e56391b488",
      "en": "「I know, ZERO.\\nThat one is the final enemy...!」"
    },
    "213:6374": {
      "repository_source_sha256": "2f745ba737f67281908a79d17c7159d6347a7550f595621f0267f9723750d255",
      "en": "「$$サイデリアル$$ obstructing peace must go.」"
    },
    "213:6417": {
      "repository_source_sha256": "00211e36fa76b9589329136a930aeaf23eeb854fa88fff7434bfb075b9adbd8e",
      "en": "「Your greatest mistake was\\nlaying hands on Earth.」"
    },
    "213:6468": {
      "repository_source_sha256": "15425ff2c7d610be32502a19ab6cb39574c792485011b382a7cce31c8b2fbce8",
      "en": "「We're taking Earth back.」"
    },
    "213:6491": {
      "repository_source_sha256": "bd4a47d3d9e9aa6a61a329e157709ae8d50e45206f8b4205d2b99e7edc7fd32a",
      "en": "「I won't let you use $$スフィア$$ power.」"
    },
    "213:6520": {
      "repository_source_sha256": "f3d2f55d38d68c396ee38e8400a17d50de23f92cb157771bcd4964d3c3059372",
      "en": "「Destroying you before you use that odd power.」"
    },
    "213:6553": {
      "repository_source_sha256": "d52a69f5a3e50dabf6dc3737b8d2e3b50e62d59dd5d7652c527f20f8bd22d01c",
      "en": "「I won't let your hatred\\nspread any further.」"
    },
    "213:6602": {
      "repository_source_sha256": "8e554f733f6ef25c6317f354f89dd5a18bc99347b720f2794b2eed79b9e936d1",
      "en": "「I'll stop your killing intent.」"
    },
    "213:6625": {
      "repository_source_sha256": "7cb37c8a4abc80edca92dc594755285d8c0ff9571579a94bae03367068cad90a",
      "en": "「Hit the commander, the Empire halts.」"
    },
    "213:6658": {
      "repository_source_sha256": "40183fcfc1242f4c33a7315cf885778d2f09f343762cc241737e3914298ed2c2",
      "en": "「Final target, $$皇帝アウストラリス$$...!」"
    },
    "213:6701": {
      "repository_source_sha256": "47263c353c9dfe17c184d3784ed2f6b09014903aad8cd8b5b78e50589290a5ce",
      "en": "「Emperor or general, you're unfit...!」"
    },
    "213:6744": {
      "repository_source_sha256": "3a43e05b84d1cd85d75ba7ebd7faa468f1385134d3040accad80f21d0c25270b",
      "en": "「You are no emissaries of God.」"
    },
    "213:6777": {
      "repository_source_sha256": "0397207dd4431646fdf71c13082d997b5aaf3c2d0d0adc1fa4261a75cb992b87",
      "en": "「Whoever you are, you're my enemy...!」"
    },
    "213:6816": {
      "repository_source_sha256": "3a8cf38a6c02347999eef7babf77bff11a8349862e501191ce60f3849278fa5b",
      "en": "「If you would judge humanity,\\nI will judge you...!」"
    },
    "213:6865": {
      "repository_source_sha256": "0bee5297f32c5623ec54ca422186d8caf7ef13139ef37ea51af3a9e559b05d2e",
      "en": "「Battle is not a game.」"
    },
    "213:6888": {
      "repository_source_sha256": "551f9b2dd78e04e136dc4a23dffe1401e4b24ce53f995b189e8248c2ea51a0b3",
      "en": "「$$アドヴェント#pilot$$... I'll end you.」"
    },
    "213:6925": {
      "repository_source_sha256": "ea3383d1103138b789b8edab939b6a867f86a7ed9a04b68c9e69ff3607252028",
      "en": "「You have no right to savor joy...!」"
    },
    "213:6962": {
      "repository_source_sha256": "30fa77700fcd62fc00fb763aee3505bafb8fb97cdec2a51271b60add64a5394d",
      "en": "「I've no use for a cowardly servant.」"
    },
    "213:6991": {
      "repository_source_sha256": "f91d419cd283edc261e749c62b4c044e6df5340c3c0221bbd0e54cde7528fbf6",
      "en": "「You people misjudge your own power.」"
    },
    "213:7028": {
      "repository_source_sha256": "4650547741db1322d1746470d00f751bd232593695ecd658ede4c01cba38b6ac",
      "en": "「$$アサキム・ドーウィン$$... I'll kill you.」"
    },
    "213:7067": {
      "repository_source_sha256": "2d0c781fc9595392ac39f31097d8b4d8491632bc8d687b3d543a776d93afc522",
      "en": "「Immortal or not, I will fight...!」"
    },
    "213:7108": {
      "repository_source_sha256": "9459104c56756da492a7ff815a95aebad45ebb68598b1572c943c3eafcda1d46",
      "en": "「$$リリーナ$$...! I'll protect the world... the future!」"
    },
    "213:7151": {
      "repository_source_sha256": "e9a38066683e9a3ba9f88f7f176b20dbead183698ef010622ebe8146a17866e5",
      "en": "「I reject the future you speak of...!」"
    },
    "213:7188": {
      "repository_source_sha256": "aaa0a8bf8998428e3a6a77114c83bc0056a090f006fb2a720378f790a78b5bce",
      "en": "「$$アドヴェント#pilot$$...\\nNo one wants your salvation...!」"
    },
    "213:7245": {
      "repository_source_sha256": "44bdd1f89c553bf08caf4fc942106894811dcb4aa73c540e7100e9d76907d437",
      "en": "「I'll lend a hand.」"
    },
    "213:7258": {
      "repository_source_sha256": "2014c5fc27cbb944406e358a1a461baec6412e67acd772e37f54a254c1253106",
      "en": "「This is quicker.」"
    },
    "213:7283": {
      "repository_source_sha256": "b1169997b27e4042c6cfef46bc73c00feb4af1b8ca9cddf95da787d15c09b6b9",
      "en": "「I'll strike after $$ロラン$$.」"
    },
    "213:7310": {
      "repository_source_sha256": "367dd508a4805af67d6d0bc804f56e2912611d3d271ba101fa60c965242d2085",
      "en": "「I'll cover you, $$ガロード$$.」"
    },
    "213:7335": {
      "repository_source_sha256": "04f426c57628e1d94433c0b80dff435df7293d1311c96692d4aa6858c04e9dd1",
      "en": "「Supporting the $$ユニコーン$$.」"
    },
    "213:7360": {
      "repository_source_sha256": "aa163df27510e430e344c7f6eacb782f2e5c85ffe1197aa3994dacb8e09e4e1f",
      "en": "「Leave the rest to me, $$刹那$$.」"
    },
    "213:7631": {
      "repository_source_sha256": "bd65acee4b9d12bed23d022aeabd08fa6ad22a15b5b2b5bec71471400fac289f",
      "en": "「I'll go first.」"
    },
    "213:7644": {
      "repository_source_sha256": "3a0b87bf22c946340a46ddee2afa34ea039da0be35bc8bf3d5db332dad312af0",
      "en": "「I'll hold them in place.」"
    },
    "213:7669": {
      "repository_source_sha256": "b83e7a5dd41ccba7ebb1dd9c409b0313c7fd9d540f511e633fc35d31982c4c92",
      "en": "「I'll draw their attention.」"
    },
    "213:7694": {
      "repository_source_sha256": "5817ce4eca2b1aa2e8f98402e565c9a13c27dfb292baec93c9472b89c5d4cc41",
      "en": "「Follow my lead and strike.」"
    },
    "213:7529": {
      "repository_source_sha256": "f07a0ee44098e11f30a3630bb70f29da1e6041132a3a23166df78e1e88865f3f",
      "en": "「I've confirmed the target.」"
    },
    "213:7554": {
      "repository_source_sha256": "433a08ba1c713ea3517bdcbbbc8f0ff185df9f37f0f113791f607147c2c47ee1",
      "en": "「We each take on an enemy.」"
    },
    "213:7575": {
      "repository_source_sha256": "3a1dc6bdff2ca984a17c311314d49729ae25626b187e03648e22fc90e3daadeb",
      "en": "「Don't let your guard down either.」"
    },
    "213:7598": {
      "repository_source_sha256": "0278f60c4cbe00f17868001958a775c32679f832015b50a14bbc3f0bb7000560",
      "en": "「I'll do as I please on this end.」"
    },
    "213:681": {
      "repository_source_sha256": "048e8da89bc61d6aabe8fef2288ffc412d89451b0cc72cf32abcd7eaddb58054",
      "en": "「The more you fight,\\nthe more peace's sacrifice is wasted!!」"
    },
    "213:742": {
      "repository_source_sha256": "04516a11a3750518b1974dc2a647d1776c05989197d5de0db2e822bba3e5f2b4",
      "en": "「...I won't kill anyone anymore. I... don't have to kill...」"
    },
    "213:1893": {
      "repository_source_sha256": "f538ecdefa23777aae7c61888f71e5246f8a83d9eee6b5c0ae548dd7e4b67c3b",
      "en": "「Confirming... The Shelter Shield\\nis up, correct?」"
    },
    "213:7717": {
      "repository_source_sha256": "4fd2facef48f45044b65545e97618a78d5ffa6a5a183824e493bf07561b7708a",
      "en": "「Why abort? Return now or I'll kil...」"
    },
    "213:7774": {
      "repository_source_sha256": "ca2f70d88fc3cadc191b30f3627e305902e56dd5e871254d3d271fbdb8f63e9e",
      "en": "「Suspending here? Not a bad call.」"
    },
    "213:7381": {
      "repository_source_sha256": "483d5e93cbbac66172744ce533e43ebf231b29f8512b64be503c063d490358d4",
      "en": "「Don't worry about it.」"
    },
    "213:7396": {
      "repository_source_sha256": "d1198e0ba8da39ea0b71c0153cb65947e8a0cfaa8eb0413d84a4db0977442a58",
      "en": "「I do what I want to do. That's all.」"
    },
    "213:7429": {
      "repository_source_sha256": "afab64831ed7079d0c84e3c39be851f0ff71eeef302c8e2a1ed1a6f6d482c919",
      "en": "「Pull your unit back, $$ロラン$$.」"
    }

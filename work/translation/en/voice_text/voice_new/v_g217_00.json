    },
    "217:9764": {
      "repository_source_sha256": "8f5ad295091df2f5f015894c265eefa5d28e3f6d97f465601391b603b35b9d74",
      "en": "「We should get even stronger...!」"
    },
    "217:9803": {
      "repository_source_sha256": "3848a7c5cb92882ef42d24baac457291555e2748d2d326923bee35d1a245caa0",
      "en": "「Now, $$ヒビキ$$!」"
    },
    "217:9824": {
      "repository_source_sha256": "f5a61777965ef9e9049979d2670d924337856132e54b0fb0487a9163e3a462a2",
      "en": "「Now, $$ナイト$$!」"
    },
    "217:12538": {
      "repository_source_sha256": "6c94e879125e5376ded1a5271e38034e7d63367d785ac9b35b5aa7cd3b3bfe13",
      "en": "「Making my move...!」"
    },
    "217:12555": {
      "repository_source_sha256": "12d356c420ca23c9677075e0657297e34096892c827118f0494932e99592f366",
      "en": "「Got it...!」"
    },
    "217:12570": {
      "repository_source_sha256": "bc356ff92ee4dee581052bd720f6d9a4a3a0762fc5c6484e7fa0fb8be4fb0c60",
      "en": "「I've read your moves...!」"
    },
    "217:12589": {
      "repository_source_sha256": "67008e1a7aa0cf69ce1f81825775f8c7b85dd9b9cb48bc43c88f6c233a1c7ed1",
      "en": "「I see it...!」"
    },
    "217:12604": {
      "repository_source_sha256": "ef5ce22db304d12b16842a67da8697b700ce0d327f47216d013befb65929e0e9",
      "en": "「Everything follows the flow...!」"
    },
    "217:12631": {
      "repository_source_sha256": "2bafc4000463995054f6793f3261753e33013ce121f874b69bbb58654bd0b48c",
      "en": "「What I must overcome is...!」"
    },
    "217:12662": {
      "repository_source_sha256": "13409c52b2b0997c1aeec0583cb27fc876d3ca86560dd82b2a3b2d45519f41c3",
      "en": "「Unleash what's deep in my heart...!」"
    },
    "217:12699": {
      "repository_source_sha256": "54676dcb095f956feca61ef166155ae06802278c8b23b7c837e0eeddef916904",
      "en": "「Man and machine as one...! I can!」"
    },
    "217:12726": {
      "repository_source_sha256": "6ee5fa4dc53ff622c32f386d0bf23713bd7004133e28cc4ce8b46444df2e64f5",
      "en": "「I've steeled myself as well...!」"
    },
    "217:12759": {
      "repository_source_sha256": "589be6e5c0cd47c5f12a7428a7eda645d3742f9b4948ef73be0c38472104382c",
      "en": "「I was ready long ago...!」"
    },
    "217:12792": {
      "repository_source_sha256": "01216a95c61ab5b74780ea4ee5d451e1bf0b23007fd9b5f5e3b41963c118613f",
      "en": "「Sharpen my mind...!」"
    },
    "217:12817": {
      "repository_source_sha256": "a568ffc86e194f0d3ce4dbddd1e4ad79528ad0d837b0eb2a8e8d538ddd1f7b39",
      "en": "「My mind is clear...!」"
    },
    "217:12850": {
      "repository_source_sha256": "63e518192e4e0c0de0af9afcbf2f6b4e3f4736ec56b91ef6e5731ca2092906ac",
      "en": "「I will... surpass my old self...!」"
    },
    "217:12883": {
      "repository_source_sha256": "66d07d4b4121cf05889376ae3a8d6fb3557b28c6b75a39d3159d4c5f5bbbdb7b",
      "en": "「Even alone, I have to do this...!」"
    },
    "217:12922": {
      "repository_source_sha256": "b80d2c6644ec3dc6ece16dae54bd6a8ffd6829e03389284945dd131644d97912",
      "en": "「Let me look at myself again...!」"
    },
    "217:12957": {
      "repository_source_sha256": "7ef7951491f42d3c159be9d4fb7452f84453f318e873e01d44b55624c5907052",
      "en": "「To get Miss $$スズネ$$ back, too...!」"
    },
    "217:12994": {
      "repository_source_sha256": "de5c3b225094ec56c262e8fb435771582386c2d06e71ea3eb35a79a4a135c2f0",
      "en": "「Let's do this, $$ジェミニオン・レイ$$...!」"
    },
    "217:13029": {
      "repository_source_sha256": "304322e1365164cfc5721529ad506044f0f795a7c642719fbce7decad41b01b6",
      "en": "「Overcoming hope and despair...!」"
    },
    "217:13056": {
      "repository_source_sha256": "eedb9bfe2c4959a713f889333751d0585d801ffa6e8e693c30f7905bba012033",
      "en": "「My consciousness spreads\\nthrough all of $$ジェミニオン$$...!」"
    },
    "217:13105": {
      "repository_source_sha256": "5ebb67338ea574e6ad18c9c22722ef03048cc9b2d7c95a85119313488e7eccfd",
      "en": "「Making lawlessness the law,\\nmaking the infinite finite...!」"
    },
    "217:13164": {
      "repository_source_sha256": "b71dc512e8034784113274d09c1c1d85154fe3ac110a502932d5c4431f46da96",
      "en": "「Please handle scouting, Miss $$スズネ$$!」"
    },
    "217:13201": {
      "repository_source_sha256": "360dde5fc38029a04409654d4a00fedb5d9a247c35cb4e26786c20ba1e4b1f7f",
      "en": "「This is my range!」"
    },
    "217:13241": {
      "repository_source_sha256": "0502e95ce9c6b14a858b72ffbeaec7ed08647c88b5a6b24183a7d9d367d66a11",
      "en": "「I'm making my move, Miss $$スズネ$$!」"
    },
    "217:13270": {
      "repository_source_sha256": "ac8268ccb0e27bf6c10004c9ab636726e4cc62eada94cb23c6fd82bbc4f1656c",
      "en": "「I feel Miss $$スズネ$$'s awareness...」"
    },
    "217:13301": {
      "repository_source_sha256": "fb932995ef766319b50529d3c95106406f529c4a41a976c471c18fc8eab1d2d3",
      "en": "「Yes! Going all out!」"
    },
    "217:13388": {
      "repository_source_sha256": "a9a911f2d575f8aae48cf59627bca43b4a2c295765d7276cf69c462887ed2391",
      "en": "「See humanity's all-out resistance!」"
    },
    "217:13423": {
      "repository_source_sha256": "0c4a6b0c136f12fa4fc3a8cf0d36e17371ef1a958915f477b7d935c2004c2e5c",
      "en": "「$$バアル$$! I'll be your natural enemy!」"
    },
    "217:13462": {
      "repository_source_sha256": "318213f0311cc90f29547fae5d61219f08dbfbf386fd73a3897fa71f33c43342",
      "en": "「I'll do anything to survive!」"
    },
    "217:13505": {
      "repository_source_sha256": "4b9ffeb26163e285cd7871d5dec8b008dbe1117f3e84933801e2f20cffc35aac",
      "en": "「Being played by $$フロンタル$$...!」"
    },
    "217:13536": {
      "repository_source_sha256": "30a5495625b8b886f143feace94b0cd59ff087280de486cba4301b82440c794c",
      "en": "「This fight won't do Earth any good!」"
    },
    "217:13575": {
      "repository_source_sha256": "5b8500dfa24efa10ff43ab8b30fee13d9541e10086a9e94bc3757e6b3b51337a",
      "en": "「This is the human power you scorn!」"
    },
    "217:13614": {
      "repository_source_sha256": "ac53da7d54542d831ce2e21b46433576aa1245ed6d9c042d14ae5f3cb2ae3b5e",
      "en": "「Past the despair you speak of,\\nI'm still alive!」"
    },
    "217:13665": {
      "repository_source_sha256": "184483cc6e7f30b888b56a0106cecff39dc0add31e3235c84489162e7270e257",
      "en": "「Broken machines get smashed flat!」"
    },
    "217:13708": {
      "repository_source_sha256": "1ffb065a2162c2c548c54664cb6544868e61d02ef660ffbe6e6d82323da7b753",
      "en": "「A man who denies the future\\ndoesn't suit the name $$赤い彗星$$!」"
    },
    "217:13761": {
      "repository_source_sha256": "af94abf30ec7801c0b334f3927b6cd961aa09031607b51ecc20a068377ea32c4",
      "en": "「Him...! Way too much hostility!」"
    },
    "217:13802": {
      "repository_source_sha256": "141690210e891f34ee5c2df36a1ad117bcc34f446152fad424b07946f60b30a6",
      "en": "「You'll answer for making\\n$$千鳥$$ and $$宗介$$ suffer!」"
    },
    "217:13855": {
      "repository_source_sha256": "74e374d9de7b5a31101c5d75301545e78420294776d6242949f56474bec2f7b9",
      "en": "「Ensign $$リディ$$!\\nIs this the only way?!」"
    },
    "217:13904": {
      "repository_source_sha256": "91a267434f664123d2a7892f675919b91c9957a82ce579b1456ec203fc4397cc",
      "en": "「Vanish, $$アムブリエル$$!」"
    },
    "217:13937": {
      "repository_source_sha256": "9202ee05e3da35403b76a14c0ea63f45bc1a6865eba5e8d9e080755efd559511",
      "en": "「I'm taking Miss $$スズネ$$ back,\\n$$アムブリエル$$!」"
    },
    "217:13988": {
      "repository_source_sha256": "bfcbe028b28b92de5b80664565ad3167846ca9f51755c478a728a8b0b2f959c7",
      "en": "「I'll accept you and Miss $$スズネ$$!」"
    },
    "217:14027": {
      "repository_source_sha256": "e96af6e0df92dfc0bed034f8e78d1d2b7a18897571e26579d7f0e482988eab32",
      "en": "「You and Miss $$スズネ$$ are one!\\nFeel it, $$アムブリエル$$!」"
    },
    "217:14092": {
      "repository_source_sha256": "dde5882f72c05ba2c2e3214783d23c096f073fd2fc4dd6718130837b3b3a1ce2",
      "en": "「You're leaving Earth,\\n$$サイデリアル$$!」"
    },
    "217:14143": {
      "repository_source_sha256": "9c07ae79a3f1ab71800e27932ea36244ea0bd9273f51474134e394c8da1f4839",
      "en": "「There are plenty of humans\\nwho reject your rule!」"
    },
    "217:14200": {
      "repository_source_sha256": "6521e86e2b67e428eb12eae06b55c198eb159dcf15cfa943be1bab50430f8167",
      "en": "「I will take Earth back from you!」"
    },
    "217:14235": {
      "repository_source_sha256": "c073808deb068e66e721a0be75dfef0a08b44c9e8d42f9e1e8888f67aa36f3c6",
      "en": "「Your rule... I'll break it!」"
    },
    "217:14272": {
      "repository_source_sha256": "e9279721ad5241fe10a3943f72b95f7bd86345c698d6052c51f5b7220665ac70",
      "en": "「That smirk ends here,\\n$$サルディアス$$!」"
    },
    "217:14321": {
      "repository_source_sha256": "aad0a2e26234022287f7b043c47f28a90ce301294d3312dafbb08df4ac0d4f58",
      "en": "「Let's fight head-on, $$ダバラーン$$!」"
    },
    "217:14352": {
      "repository_source_sha256": "badcbc21c8b40cceff0531c63d5639cd20016ec462cfecd4a65e4e1737ff7e77",
      "en": "「You'll atone for your\\ndirty tricks, $$ギルター$$!」"
    },
    "217:14401": {
      "repository_source_sha256": "c4c09ad734d58f988efa9737017f89d74fc4af9f1d685c82c7864885ad64575d",
      "en": "「$$尸刻$$!\\nI won't be swallowed by your aura!」"
    },
    "217:14450": {
      "repository_source_sha256": "cc3fe4ae266d973abd6cf6ff44b57fc17b455c0e72228f3c1d181adfe9ba829c",
      "en": "「$$マキ#pilot$$! You are...!」"
    },
    "217:14479": {
      "repository_source_sha256": "52dbad46d3805738524826097c5195f5852a56b534f7d098cb57a39d97d1be45",
      "en": "「If nothing can be done,\\nI'll do it with my own hands...!」"
    },
    "217:14534": {
      "repository_source_sha256": "db809da377dfce40c479754606d2c8867a7c4bcee4095acf2d395c1951d1212a",
      "en": "「My $$スフィア$$ is mine!」"
    },
    "217:14567": {
      "repository_source_sha256": "69139705b079f0102e735e6116358c38dd4f3b74616fc6eac4be461059972cd2",
      "en": "「Even if I'm an inferior Reactor,\\nthere's a way to fight!」"
    },
    "217:14622": {
      "repository_source_sha256": "1c1cc8bf7abaf70bb24e7d7257de930e182b61076301f38fea6acabc8d47f829",
      "en": "「A good chance!\\nI'll learn how to use the $$スフィア$$!」"
    },
    "217:14679": {
      "repository_source_sha256": "017cd9d3ace1ef225816ca07af8e0fe6173af2faeec9d86a67361d00f80bd8bf",
      "en": "「I won't lose to a being that only\\nspreads hatred!」"
    },
    "217:14728": {
      "repository_source_sha256": "76bd0be1e25c832a1f040448becea54d05684a842b5f27a6427376679c3da198",
      "en": "「$$バルビエル$$!\\nYour poison won't work on me!」"
    },
    "217:14781": {
      "repository_source_sha256": "6e3fa20c3a2e94d3469dcd23a79d61b9bb9d076b4215588eae190e6cb881e2be",
      "en": "「Swallowed by his bloodlust, I lose!」"
    },
    "217:14816": {
      "repository_source_sha256": "61bc3bbefa47977b42f59dac1e830b23b6d139d9980341c400d766f3391f3fd3",
      "en": "「$$尸空#pilot$$!\\nI'll break your shroud of death!」"
    },
    "217:14871": {
      "repository_source_sha256": "22c7151485ff12385ecc59952df8b98f4d31e4ce2623b3e30828968bec7115fe",
      "en": "「If I take him down,\\nthe Empire's army will collapse!」"
    },
    "217:14924": {
      "repository_source_sha256": "370a6f047ef2704fce4d1259d9b0aac10e9aedaf88f34e31a8342de0bcea2a78",
      "en": "「The Empire's flagship! A worthy foe!」"
    },
    "217:14967": {
      "repository_source_sha256": "00785851adbfc073633eb90769dcdfcd36adaaaba7f542d47f69f1fe914e79d7",
      "en": "「I'll take you on,\\n$$エルーナルーナ$$!」"
    },
    "217:15016": {
      "repository_source_sha256": "52e3a4e1a3dd3438a7949a2eaf1906ee59f11a2b6535426e8d6375f055000297",
      "en": "「Earth is not your playground!\\nI'll teach you that!」"
    },
    "217:15073": {
      "repository_source_sha256": "69779ff7ff646bd9818624a807318f5b00698c1517f35c72fa9311cf7a60ca7f",
      "en": "「$$次元将$$, 4 $$スフィア$$s...!\\nI'll defeat them!」"
    },
    "217:15128": {
      "repository_source_sha256": "a9745146953af233dbe6c04b3e31cce7bbed78859b5356ebb2113f3fb67af7d4",
      "en": "「$$ヴィルダーク$$!\\nPower without justice is violence!」"
    },
    "217:15179": {
      "repository_source_sha256": "ecd4d565591e1ec3350ee59fd2a08b54b6f304f9abb332f95bbf1d37eb59d0e8",
      "en": "「I won't give you my life\\nor this $$スフィア$$!」"
    },
    "217:15232": {
      "repository_source_sha256": "4ce173287902e7ac87d38127a7a1c7ced44595b258a451e5ae7ad2b5723c7f39",
      "en": "「I can't forgive what you did\\nto $$セツコ$$ and the others!」"
    },
    "217:15295": {
      "repository_source_sha256": "585d40297a577d3ebb7f3de022bd05afdd1fa2425058235a12735022c6665c7c",
      "en": "「You mistake the $$御使い$$ power\\nfor your own, it seems!」"
    },
    "217:15354": {
      "repository_source_sha256": "54da0809ff2b3beb3fea03f45e21092054c8e0d2a523e06bdd45188a9e7a3256",
      "en": "「If the chosen ones lose to us,\\nyou'll lose face, won't you!」"
    },
    "217:15409": {
      "repository_source_sha256": "86a6fbd00cdf56c799484cefb61b0e0d32469f4142a5e25788ee683005d82886",
      "en": "「We... aren't your possessions!」"
    },
    "217:15446": {
      "repository_source_sha256": "fbefc93e9753753b5f249035559069cc302ecd646bdb79f4e2a595d2e93a4cc6",
      "en": "「I decide my own fate!\\nI'll never hand it to you!」"
    },
    "217:15507": {
      "repository_source_sha256": "8cbd654591434d80d03a2242b0ceb2b96a7ffcef96fdd162bfccae8c0582fcec",
      "en": "「My anger or yours...\\nwhich is greater?」"
    },
    "217:15558": {
      "repository_source_sha256": "47d0caf6d6cedc974317b7b062193f3357ce0e960a34b3ddcdaba873e0ca5097",
      "en": "「A hard-head like you has no right\\nto decide humanity's future!」"
    },
    "217:15615": {
      "repository_source_sha256": "02885c35cb2f7a1d44c33e8d1df8e9a3d801d07e2d9dcdd96d6914160edb2eac",
      "en": "「$$ティティ$$ is gone!\\nAll I see is humanity's enemy!」"
    },
    "217:15676": {
      "repository_source_sha256": "5bc02b327b07d7b8a79b2548a00b997c25cad45857f410592a1e8a218ec424b5",
      "en": "「I'll avenge the anguish of lives\\nyou took for your pleasure!」"
    }
  },

      "repository_source_sha256": "d922273c7c236a06d119217100a68f86a08b70aa8c734ebf947e67411d4f5e6a",
      "en": "「D-Energy convergence is complete.」"
    },
    "219:1258": {
      "repository_source_sha256": "b17490d3277276da1fd98d3c2596ae8c5eeb3cbb3c67aaacab1b99193b2c989f",

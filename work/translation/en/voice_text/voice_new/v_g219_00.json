      "repository_source_sha256": "b7e0dcc3a999eb75ef265911c29493efd228d8b390f0818be9334cfe42cee3b6",
      "en": "「Miss $$スズネ$$, Midgardsormr, please!」"
    },
    "219:3632": {
      "repository_source_sha256": "0468bf7a39c27914a59275283893618e5233232d1a9eb44675896eeae202d52d",

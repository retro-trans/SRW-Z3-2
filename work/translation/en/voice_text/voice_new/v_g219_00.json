    "219:1047": {
      "repository_source_sha256": "f014454bf70a020517cf8bf8103a2afe3aaf264f30a44656060be39387853344",
      "en": "「Quit playing. They're still alive.」"
    },
    "219:2366": {
      "repository_source_sha256": "ad7200bd9c1c88c91af81f6069a93f14316585a39255f6676b4b4f3063bb02a1",

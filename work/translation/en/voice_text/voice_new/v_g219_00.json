    },
    "219:3277": {
      "repository_source_sha256": "67aa9d572a3dc06f6df6641a5c0cd2f7261219250cf545be98781e3369549418",
      "en": "「Blast through, Nitro Pike!」"
    },
    "219:3306": {
      "repository_source_sha256": "1ea43dd3df1146ee475dacd01e11f6d4b36a8bd577e42a9bda4a9210eebdf9e9",

      "repository_source_sha256": "e96178d9ba7c67d46f0567b1c808f9a329ed3f8cba644224a6fbbc18149deb9e",
      "en": "「Cut it to shreds.」"
    },
    "219:1163": {
      "repository_source_sha256": "ff9513b9c2405ef47b28d75edf05084ae6ad42342a4854257792400d26130f35",
      "en": "「Nice. Melee gets my heart racing.」"
    },

    },
    "219:2636": {
      "repository_source_sha256": "f014950821e969281a602a7cbf03f891cc2bfebc60ee5f568ace1eb5d07d4023",
      "en": "「I-I'll be careful next time!」"
    },
    "219:2663": {
      "repository_source_sha256": "cff2a9c3ef7546e3cf07937207074fefec29fdadd2aad6e6dd30d058c76ed26d",
      "en": "「I'll definitely dodge next time!」"
    },
    "219:2694": {
      "repository_source_sha256": "c2776cccf7d8609b4242ec432a35b75e974be963d7bab7a5104a8928f35bb4aa",
      "en": "「No need to dodge a hit like this!」"
    },
    "219:1530": {
      "repository_source_sha256": "254a032a98ca39c394cfc84bca9dac9c88917332266fa2da26f1c9251eb814d8",
      "en": "「Heh... you've learned to talk big.」"
    },
    "219:1563": {
      "repository_source_sha256": "a32e136dd7d65e0f0297f103e8109c7a0a338bbeb645782bfe643b352811259b",
      "en": "「No idiot gets hit by something\\nthat slow, right?」"

    },
    "219:1785": {
      "repository_source_sha256": "bf7157f75227079ffc5422be29c3ce48df008f88f9ef1c865d2ed43ea9b9f57f",
      "en": "「What's this supposed to mean, huh?」"
    },
    "219:1820": {
      "repository_source_sha256": "2d45ab3b21c52b789209149e86e636237fbd1516629ee744bba0d42e9390e360",
      "en": "「You... are you playing games?」"
    },
    "219:1847": {
      "repository_source_sha256": "902060e945ae3730e23ad4bf59ed0758c4c8969b2a57865c6d1c13ca0a946717",

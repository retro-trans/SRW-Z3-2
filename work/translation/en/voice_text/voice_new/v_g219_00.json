    "219:1939": {
      "repository_source_sha256": "ea459cf56507dd2ec965943b6ef6860d6d7e1ed0f92506ab543c9629809b70d0",
      "en": "「Let me pilot! I can't trust you!」"
    },
    "219:1982": {
      "repository_source_sha256": "13c9238698d3875291eee24c52d5e0d82d7de483d6f5af7d4c046f54fd97b9ea",
      "en": "「Damn amateur! Trying to kill me?!」"
    },
    "219:2854": {
      "repository_source_sha256": "ee410c92a1ed00b4edd11b270d3fe43c0bc15c7d671a805bf6952d9d67a8d97d",
      "en": "「I'll pass on both!」"
    },
    "219:2877": {
      "repository_source_sha256": "7b447731faa33c759996d4586a6a17945c15b5c85be580e199f2ce3e2f6f4f0f",
      "en": "「Wait! No way, Miss $$スズネ$$!」"
    },
    "219:2916": {
      "repository_source_sha256": "495c35b38ccaf24452fd5d6379c2510dcedd8707e51ac81e5911e48d9c53991c",

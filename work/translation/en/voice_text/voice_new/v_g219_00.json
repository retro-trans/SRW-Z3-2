      "repository_source_sha256": "89c4423b9a6e0aba0218337115b2b18c4aa823d7a9fe748f0345cc182da42f83",
      "en": "「Very well. Be thorough.」"
    },
    "219:3184": {
      "repository_source_sha256": "ab43fca81ed1df64818e1c1943c1bbb952ae9e71655cf815664f8a288b4eeb61",

    },
    "219:2768": {
      "repository_source_sha256": "8ec2518b95ee87f3770d9b151200ab3251541807c86c65e887358474e3372320",
      "en": "「N-No!\\nI'm serious, completely serious!」"
    },
    "219:2819": {
      "repository_source_sha256": "5d93abab4fda4a5ec7ffc74b8dc764ebbeca1413e70d548ca4acd17c97d3e6d1",
      "en": "「Are you okay, Miss $$スズネ$$...?!」"
    },
    "219:1710": {
      "repository_source_sha256": "c7b24b3ee2c57358b8d42da072cc6122e5eca7ee97a516920b2a29a4e7f2a159",

{
  "schema": 1,
  "rows": {
    "231:6119": {
      "repository_source_sha256": "2f462dfac72eac342b052957b0b80ecad6da4e58181d7857593cf09ba360c314",
      "en": "「To keep the status quo, people\\nbury possibility. Such is man.」"
    },
    "231:6186": {
      "repository_source_sha256": "f972d95bf63494c5b66122b8135dcb8d1e4eb7fca33790f87faaa95196577d67",
      "en": "「Only we can fulfill the Spacenoids'\\ncherished wish.」"
    },
    "231:6239": {
      "repository_source_sha256": "d5ff1531d411424106ff241b48717ba8db0074ebe28de4959808d2d0826862fe",
      "en": "「Fear not. It's over in a moment.」"
    },
    "231:6740": {
      "repository_source_sha256": "6497dec29d328e5602578c9ae7e07fda2e4ccbcdc6a1bb40a6e413bc92a2a45a",
      "en": "「You seem a gifted pilot,\\nbut that ends here!」"
    },
    "231:6803": {
      "repository_source_sha256": "5dfeeeaf3fa160fa5f5901528c330b3ec2b3ccd43a5729b32c1b81f31992e265",
      "en": "「Let me free you from days\\nof anguish under the Box's curse!」"
    },
    "231:6856": {
      "repository_source_sha256": "14c9e8d62c0994e0d84c0af8555fe53d1006fd8214278465cc5d786518409ed1",
      "en": "「I cannot allow the beast of\\npossibility to exist!」"
    },
    "231:6911": {
      "repository_source_sha256": "dc1b53a7080a926cc77611aa29848a46730f6e8a0eb0b74f7e7d2dfdf32cb901",
      "en": "「Let's see the Black Lion's strength!」"
    },
    "231:6950": {
      "repository_source_sha256": "455bbea969618373e59b7fd2d97770e6d87d81efd3a479cd018e6a92c022c50c",
      "en": "「I'll end this now,\\n$$マリーダ・クルス$$!」"
    },
    "231:7001": {
      "repository_source_sha256": "57bb9423542cd577435eb62cef1f61c3d175a4fa303f9c2466c7df9afd9887ea",
      "en": "「$$マリーダ・クルス$$... You, of all people,\\nknow my power well!」"
    },
    "231:7058": {
      "repository_source_sha256": "ad6c133c04747f0af1c572e335bde052ed63fdc9c03708b46753a89d3e4828fe",
      "en": "「$$ジンネマン$$, regret dreaming\\nof another possibility!」"
    },
    "231:7117": {
      "repository_source_sha256": "3fd61b2c7405e5af1d730415041d8c5a0dd16c1d68ecae6724733c1253bb8ba5",
      "en": "「Casting off your grudge won't erase\\nthe past, $$ジンネマン$$!」"
    },
    "231:7174": {
      "repository_source_sha256": "6ac94e7f0665f54d709e4ea83c87ef1d569449346a0b6a3df17105f2f3f127c2",
      "en": "「This strange bond with you\\nends here!」"
    },
    "231:7225": {
      "repository_source_sha256": "5b3f284aaffbe3f6cd44717f3a0371e1ea5e9735a28a4473f27a369a868c50d2",
      "en": "「The $$ロンド・ベル$$ flagship sinks here!」"
    },
    "231:7266": {
      "repository_source_sha256": "3bd6b565c634862e801580f5ef189d3f8b5016e15f354cec080ec0fa7a36cfa2",
      "en": "「$$ロンド・ベル$$, don't think you can\\nact freely before me!」"
    },
    "231:7329": {
      "repository_source_sha256": "1228f68dfe59501ff522a1743bbb30e29972c67ec9311d6125b93e1f0e32b374",
      "en": "「Even pooling humanity's unconscious,\\npeople won't change, $$アムロ$$!」"
    },
    "231:7388": {
      "repository_source_sha256": "a444d4fbb53b8860b992138f2999e2828a7f7fe6a29946a573c8d29a315de0f5",
      "en": "「I'll take over the $$赤い彗星$$ name,\\n$$シャア・アズナブル$$...!」"
    },
    "231:7455": {
      "repository_source_sha256": "803c85f9a397d35c34b10810cbaaa995d8493189fc93163c4da30681fc6b2b05",
      "en": "「An individual and their circle alone\\ncan't defeat me, $$カミーユ$$!」"
    },
    "231:7516": {
      "repository_source_sha256": "b62dc6f7cbf749200cb1465a6bbab62a8dbeb74654f81e70a46e90ef395c58bf",
      "en": "「It's a shame, $$ハマーン$$.\\nTo think even you would leave me...!」"
    },
    "231:7573": {
      "repository_source_sha256": "e5f64ae33aaf0b5bba3cd4b4cdb8329a90f69d96b3b6c7793243263a54fe9157",
      "en": "「$$ヒイロ・ユイ#pilot$$, I'll crush your future!」"
    },
    "231:7616": {
      "repository_source_sha256": "9bc55e1dc93f313b2186185ab8e973df46240197d61b88b3bad94b737a24a5b9",
      "en": "「The future of Coordinators\\nis up to me as well!」"
    },
    "231:7665": {
      "repository_source_sha256": "d8fbcaec23c41155753edce7935fa1cafddfdb9eba7947d2527dd20eaf895463",
      "en": "「To avoid repeating mistakes,\\nmen like me are necessary!」"
    },
    "231:7730": {
      "repository_source_sha256": "1f4c0523ff73fdac3b9f0f806bacd55403c8ef23e1c6a71d932295a912266c4e",
      "en": "「So keen to relive the $$黒歴史$$,\\n$$ロラン・セアック$$?」"
    },
    "231:7791": {
      "repository_source_sha256": "9265f3be0a459831418ab4a7240e2442c09310e3dd0224aac3c59d40effe83ea",
      "en": "「To think all humanity can become\\nInnovators is a fantasy!」"
    },
    "231:7856": {
      "repository_source_sha256": "ff817cbb7bb65931eed81831141ce3dd3db0266a241639e6f2ced6f5964c9296",
      "en": "「Linking people's wills through song\\nis nothing but a sham!」"
    },
    "231:7950": {
      "repository_source_sha256": "24b08edeb885a34003bbd92d857521e6bbe835490b02498b26012bf7f72fa10e",
      "en": "「Since you deal in war,\\nyou're no different from us!」"
    },
    "231:8005": {
      "repository_source_sha256": "bb962c68696d8b443c6db300a60cad3ad2f2ba76a29d0d8af210e5dc8acd8b73",
      "en": "「There will be no miracle...!\\nThat is reality!」"
    },
    "231:8062": {
      "repository_source_sha256": "ee7e671d9fef6561ebb22177089618d4639bd3edd1105c6497f0368dcb638b97",
      "en": "「I'll eliminate those who use\\nthe power of the Spheres!」"
    },
    "231:7911": {
      "repository_source_sha256": "b3cee84e96e64f12cccbee17373dcdd88836773aaa44b70cd503ade0653eae13",
      "en": "「Not even you can sway my heart!」"
    },
    "231:8297": {
      "repository_source_sha256": "e19964f8dbc6b1e6f991472639f43c48f08c2e0e42ed88dffaf318b24b5fa7f0",
      "en": "「Your moves after attacking lag...!」"
    },
    "231:8332": {
      "repository_source_sha256": "4491910087ae3f73f90af1235221c1b1432016526bbdd62dfcafd20b231c8e94",
      "en": "「Futile resistance invites death...!」"
    },
    "231:8373": {
      "repository_source_sha256": "440616621fe8646789cb5e131da419538ea87ded2b54551e95e94505024db613",
      "en": "「To come all this way to die...!」"
    },
    "231:8412": {
      "repository_source_sha256": "ff008dc39d95b9c59de0703d42be1a2ee88585fe0d1b98c5c6fd5d41189636a2",
      "en": "「I'll repay your recklessness...!」"
    },
    "231:8455": {
      "repository_source_sha256": "ab58dc1aa673cef66e455d040abde694c5cabbba50695315b32699e17a85c1a4",
      "en": "「The moment you let me counter,\\nthe outcome was clear...!」"
    },
    "231:8508": {
      "repository_source_sha256": "a3ed06a19471b6bcc1cc8687200fc5e5972b7c3510ae4b055c30b4b3ec426051",
      "en": "「Indulge me a little longer...!」"
    },
    "231:6662": {
      "repository_source_sha256": "7897d1092a58793328c8ce777b7d1115e8216412cd04220c3f371b87fc6a602d",
      "en": "「My attack isn't over...!」"
    },
    "231:6697": {
      "repository_source_sha256": "9cbb5ec10b5974cfe1e0d0de292aa08c2826e58591d271d2061487cddc582566",
      "en": "「You survived... This finishes you!」"
    },
    "231:9241": {
      "repository_source_sha256": "1480189d8ae627bc77bf462b80b286c7d907c6a6e9761335474ccbaad30b178d",
      "en": "「I somehow held my ground...!」"
    },
    "231:9272": {
      "repository_source_sha256": "4019d85033e45e43d3fb151b2090fb787ed21df8773d9cab28611a0d5d3d8d4b",
      "en": "「I can't die without doing what\\nI must do!」"
    },
    "231:9323": {
      "repository_source_sha256": "24e406ffdf8b80075594e1e128c3e60441c57f944a8890d0b3fdcdf38fe39421",
      "en": "「To think I'd be driven into\\nsuch a corner...!」"
    },
    "231:9374": {
      "repository_source_sha256": "268efab00ca75c69067b1b1d64decf2e835b4242dcb4ed94465382bcdba59333",
      "en": "「Ngh! Am I to lose again...?!」"
    },
    "231:9021": {
      "repository_source_sha256": "2dba8f686280f73b8981a71ce9343802212b69a4fe909c126857bd1acf76b3ef",
      "en": "「I advise you stop here,\\nfor your own good.」"
    },
    "231:9076": {
      "repository_source_sha256": "b0591cc8537512624c58ec4e8f2105f5cfd953e72b1c13905a304df1f63a288e",
      "en": "「Do you want this twisted world\\nto continue as it has?」"
    },
    "231:9137": {
      "repository_source_sha256": "0a508d57976c604d902773f48b9a8bf27cb86932e8469a1ea8c896bbc79e2a9d",
      "en": "「No matter how you struggle,\\nmy victory won't waver...!」"
    },
    "231:9186": {
      "repository_source_sha256": "aa3c1466ed4c5982573e27192ab6c22e6c67584f9f730ea861e4c545d70b78dc",
      "en": "「You're skilled...!\\nBut don't get carried away!」"
    },
    "231:8863": {
      "repository_source_sha256": "415a7e8f62a8a73fd698791bb475e3372a7af44d23b3bac2161b8e88dfe4a4d9",
      "en": "「You don't seem to realize you're\\npicking a reckless fight.」"
    },
    "231:8918": {
      "repository_source_sha256": "055ee3f3a71b6e8670a3a33d900c34b8f31b63cd46b9d133577de4410e92c4ef",
      "en": "「Know how powerless you are.」"
    },
    "231:8949": {
      "repository_source_sha256": "620aa3c4dfc2363caa19c5a64264eb7f0005e55ca16e1b78ef47168e28133e34",
      "en": "「This is reality. Accept it.」"
    },
    "231:8984": {
      "repository_source_sha256": "afae5fd925bd243ed15e2b418d6e355daf9a69f25af6f1af50c8369d98854fc0",
      "en": "「Did I raise your hopes a little?」"
    },
    "231:8551": {
      "repository_source_sha256": "f3d213bfc6d3c72f6990134a3a5749e1d14d03f9e95433896d20131efde8358f",
      "en": "「If I fell, morale would suffer.」"
    },
    "231:8590": {
      "repository_source_sha256": "f18e62d3b50e5f68f63e034d45a317044a2f6013b1e4f01aab33cc037f5c8e71",
      "en": "「I knew this would be the result.」"
    },
    "231:8623": {
      "repository_source_sha256": "e12821ac9298ee25ce743736f8839f55ad7127ed9f644589c698091a38ffade5",
      "en": "「No attack matters if it doesn't hit.」"
    },
    "231:8664": {
      "repository_source_sha256": "28f08da74a10f461644ef3f27bbd610875078fe883f6b91c14b329da24d8e085",
      "en": "「Can't you keep up with my reactions?」"
    },
    "231:8701": {
      "repository_source_sha256": "d00acfc21c667acee54925939ce843f44fd66e6784d7e83a26500f54e747add0",
      "en": "「It was not for nothing that I\\nreceived the $$赤い彗星$$ name.」"
    },
    "231:8756": {
      "repository_source_sha256": "dcca307e0f285c74add753e4714ab4e35d0bff2a8d6990f1ec3fd5d2fa1160c5",
      "en": "「Did you think I hadn't accounted\\nfor the unexpected?」"
    },
    "231:8807": {
      "repository_source_sha256": "d820b06f3b038841c86f52f5b7b81db033e8c2b6c046e8f516c11166c0b01c66",
      "en": "「I prepared for this much, at least.」"
    },
    "231:8838": {
      "repository_source_sha256": "1176624a3f75e01064c8b4fe1476c251ea7e12599560c3e45f2a0209dba9af73",
      "en": "「Beams won't get through!」"
    },
    "231:6278": {
      "repository_source_sha256": "6c078359711955547c517003711479ad4a98cbdebea545ea049f0f900eb95ace",
      "en": "「Get out of my way!」"
    },
    "231:6303": {
      "repository_source_sha256": "c1b34ddbc53d7fccfcda302aa2cf67f961fb4708e6446175758b413c619f32b7",
      "en": "「You have no way to survive...!」"
    },
    "231:6332": {
      "repository_source_sha256": "5df166c4bdce666026bf7578d65641bae28000084e3f8538d0d18442267a0761",
      "en": "「What a petty trick you play...!」"
    },
    "231:6367": {
      "repository_source_sha256": "a32f8601a07e0584a212c13cdf1a7f7cbc42722d1f484d02a293f4cd3975cd25",
      "en": "「I'll set this warped world right...!」"
    },
    "231:6400": {
      "repository_source_sha256": "bf2c06a23b21a272b310405263696c4a58ef874b4ee1da79995a3c581a3b6b13",
      "en": "「I'll take your life here!」"
    },
    "231:6435": {
      "repository_source_sha256": "5877a6f504537a1aaf2f43bda1263d50d07a1c2649ef3f2e15705519bc26a7b9",
      "en": "「It was careless to stand before me!」"
    },
    "231:6474": {
      "repository_source_sha256": "769adc0dafb3ae6b67d1d3919d0c677ed8ce5622c51b57187e588a1d22d34620",
      "en": "「The outcome is already decided!」"
    },
    "231:6503": {
      "repository_source_sha256": "585350b9aa4e910d239ca5c46b60df93a9d7de3e08c3d32708c218dfc2ff118a",
      "en": "「I won't let you dodge!」"
    },
    "231:6596": {
      "repository_source_sha256": "59d454351c0dfb06fc09400c97ecf3a4bb9f3e3421b71b14c785885e618895b3",
      "en": "「From that position, I can catch up!」"
    },
    "231:6629": {
      "repository_source_sha256": "6e2652e9445e8237304dcd2002b90caf4b84285f497c24b6ee6520c87b22f0d2",
      "en": "「Your sense of spacing is sloppy!」"
    },
    "231:6526": {
      "repository_source_sha256": "ffcd9a3cac4529fdb9ebc5fdef315fe6f82dd4d411770f2de74eb02dd52239e4",
      "en": "「Thought distance would save you?」"
    },
    "231:6565": {
      "repository_source_sha256": "6c6e05a39659d366722ede964c61db8d82e3c9ce1796b4de8046ac9141869306",
      "en": "「Unfortunately, that's within range.」"
    },
    "231:8113": {
      "repository_source_sha256": "5ba64879124ceb5966a5ecefd53e9becf2fd257a357e6d4705c8f6670143e0b2",
      "en": "「First, I'll pin you down!」"
    },
    "231:8136": {
      "repository_source_sha256": "6a2a68943afc28a00c31cab1727a56d79b47d5e406d31ec3f0880f9c085b43fd",
      "en": "「Vanish with this!」"
    },
    "231:8161": {
      "repository_source_sha256": "e4415fc077f30a2242463ae016827ab3c39c5dd35505f9b623f524b7df40dbbc",
      "en": "「Can you follow the $$シナンジュ$$'s moves?」"
    },
    "231:8200": {
      "repository_source_sha256": "2aa1e40245adcc4cfd51d86183edda8098b2091bad44d02ccfec49cf5436900c",
      "en": "「That was too much to ask...!」"
    },
    "231:8233": {
      "repository_source_sha256": "c00464ca9af58e2cfb13b46a7a9cb999360ae6c885e97909999bc2138b966c23",
      "en": "「Struggling won't change a thing!」"
    },
    "231:8272": {
      "repository_source_sha256": "3a4e43d444c5d637d34e3b5a6bcade317dd902771fb7fdc2c7749ea4aed1c8bb",
      "en": "「This is the end...!」"
    }
  },

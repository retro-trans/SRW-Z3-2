{
  "schema": 1,
  "rows": {
    "232:7316": {
      "repository_source_sha256": "e93e008903a3ecd2f866e5ce6cf6418d9c37c19b71ae4c16737aebe352601cc2",
      "en": "「For the heir to the Box's curse,\\nyou lack stature.」"
    },
    "232:7367": {
      "repository_source_sha256": "43eb63eb072b1edbaf48b2be5ee4f5efb9d8fd76cbe2674c42d90fd0fe7da940",
      "en": "「You can't protect the Box or Princess like this.」"
    },
    "232:7410": {
      "repository_source_sha256": "24f95b05189495fc3b507af4f26d296821648cb7cbb3d8bbd78a5a918a90ff0b",
      "en": "「The Black Lion's power\\nis not yours to master.」"
    },
    "232:7461": {
      "repository_source_sha256": "62817260dbc9fffa0fd7894c733dd18b91ae5353c39a64429b27f05be1d578c1",
      "en": "「That's enough, $$マリーダ・クルス$$.\\nYou've fought well enough.」"
    },
    "232:7516": {
      "repository_source_sha256": "7abaa9f83e96fc8333d1ecfb0217d88b4642181adad873fd2fa2647a284ba73b",
      "en": "「$$マリーダ・クルス$$,\\nthis is your limit.」"
    },
    "232:7565": {
      "repository_source_sha256": "3e312e6793ef7ec69e9da3770ab8bf608030dcee53e838758b7efd8d7ba73e54",
      "en": "「No need to hold back now, $$ジンネマン$$.」"
    },
    "232:7608": {
      "repository_source_sha256": "e13cfed56ae5c1919cd58fb87cf9d334ca05f6c7d811acdf81fc93e5de84a627",
      "en": "「That captain's command yields this.」"
    },
    "232:7649": {
      "repository_source_sha256": "3148ec533800950f8fe345a98f3505143067f934652292b1e26463a49f5ab18d",
      "en": "「Even $$ロンド・ベル$$ are but\\nbabes before me.」"
    },
    "232:7706": {
      "repository_source_sha256": "77013d42cc6c35da369d072d9011d6651d74bd388cab6e775fcdf923b684d95b",
      "en": "「Very well.\\nI accept your challenge, Gundam...!」"
    },
    "232:7763": {
      "repository_source_sha256": "5e6aa95c4cba5a656dd038a4110d7394d39251e1b8dee62e4cbde8c9e30cd54f",
      "en": "「You cannot bring out\\nthe Gundam's true worth.」"
    },
    "232:7814": {
      "repository_source_sha256": "d4b364b4a5ba7f058b94e68aa574f77fcf37be141ed86431fdac135677f8ffc8",
      "en": "「Do you think this little pressure\\ncan do anything to me?」"
    },
    "232:7875": {
      "repository_source_sha256": "2ccfaf40779e93e1c0fcb898f3df973165a860b2fa7c0fe17d553743eb234bd0",
      "en": "「$$アムロ$$,\\ndon't think me $$シャア$$'s equal...!」"
    },
    "232:7926": {
      "repository_source_sha256": "7da1c3df006f2714a176dc9ad35bd6890476fed56498c46c773628a9e486ba27",
      "en": "「$$シャア・アズナブル$$,\\nyou are already a finished man...!」"
    },
    "232:7991": {
      "repository_source_sha256": "84949d69fb6d6d853e24517d2f6294f32481c4ec9ee7134e83226d85582d7514",
      "en": "「You disappoint me too, $$カミーユ$$...!」"
    },
    "232:8032": {
      "repository_source_sha256": "c6be1422b651982ab8274f5d1135e726891334709b3ad846f8f9cacb5c0ffa9f",
      "en": "「Just a woman swept away by emotion,\\n$$ハマーン$$...!」"
    },
    "232:8188": {
      "repository_source_sha256": "415a7e8f62a8a73fd698791bb475e3372a7af44d23b3bac2161b8e88dfe4a4d9",
      "en": "「You don't seem to realize\\nyou've picked a reckless fight.」"
    },
    "232:8243": {
      "repository_source_sha256": "055ee3f3a71b6e8670a3a33d900c34b8f31b63cd46b9d133577de4410e92c4ef",
      "en": "「You should know your powerlessness.」"
    },
    "232:8274": {
      "repository_source_sha256": "620aa3c4dfc2363caa19c5a64264eb7f0005e55ca16e1b78ef47168e28133e34",
      "en": "「This is reality. Accept it.」"
    },
    "232:8309": {
      "repository_source_sha256": "afae5fd925bd243ed15e2b418d6e355daf9a69f25af6f1af50c8369d98854fc0",
      "en": "「Did I get your hopes up a little?」"
    },
    "232:8346": {
      "repository_source_sha256": "4e4bcb24cb00aa43a155afa6fd12f4da641d99cd349e3ca5421912fa268e3685",
      "en": "「Such an attack can't stop this unit.」"
    },
    "232:8389": {
      "repository_source_sha256": "e1a391133d3546e2e37e591e6eea01ca51427bc540a9852ead8c86e6fce165d7",
      "en": "「As you see, the armor is off scale.」"
    },
    "232:6885": {
      "repository_source_sha256": "f3d213bfc6d3c72f6990134a3a5749e1d14d03f9e95433896d20131efde8358f",
      "en": "「Morale suffers if I'm shot down.」"
    },
    "232:6924": {
      "repository_source_sha256": "f18e62d3b50e5f68f63e034d45a317044a2f6013b1e4f01aab33cc037f5c8e71",
      "en": "「This result was a given.」"
    },
    "232:6957": {
      "repository_source_sha256": "e12821ac9298ee25ce743736f8839f55ad7127ed9f644589c698091a38ffade5",
      "en": "「Attacks mean nothing if they miss.」"
    },
    "232:6998": {
      "repository_source_sha256": "28f08da74a10f461644ef3f27bbd610875078fe883f6b91c14b329da24d8e085",
      "en": "「Can't keep up with my reactions?」"
    },
    "232:7035": {
      "repository_source_sha256": "d00acfc21c667acee54925939ce843f44fd66e6784d7e83a26500f54e747add0",
      "en": "「I wasn't given the name $$赤い彗星$$\\nfor nothing.」"
    },
    "232:7090": {
      "repository_source_sha256": "482d3ef40c14d2b3d8fb4572559963b06119de1279160cc440990b5332b1747d",
      "en": "「You thought a frame this huge\\nwould be easy to hit, I see.」"
    },
    "232:8081": {
      "repository_source_sha256": "dcca307e0f285c74add753e4714ab4e35d0bff2a8d6990f1ec3fd5d2fa1160c5",
      "en": "「Did you think I hadn't\\nconsidered the unexpected?」"
    },
    "232:8132": {
      "repository_source_sha256": "d820b06f3b038841c86f52f5b7b81db033e8c2b6c046e8f516c11166c0b01c66",
      "en": "「I'm prepared for this much.」"
    },
    "232:8163": {
      "repository_source_sha256": "1176624a3f75e01064c8b4fe1476c251ea7e12599560c3e45f2a0209dba9af73",
      "en": "「Beams won't get through!」"
    },
    "232:10060": {
      "repository_source_sha256": "4272eefad8d9432fe4650195e87198bdbc6887827dcf480cfd5b74c742fb07d1",
      "en": "「Light born of people... Something this warm...! How futile...」"
    },
    "232:10127": {
      "repository_source_sha256": "6553b95d3d5242af3e44b77a6a29ae3ca08274a18d40c346ddd299a05c2df0eb",
      "en": "「I leave to you... what you think must be done...」"
    },
    "232:10170": {
      "repository_source_sha256": "3383b4160f3349b43856ef3d6e88d5604602ee3b880f2dfdaf609f1a13798138",
      "en": "「Too slow, $$バナージ$$. At that speed, I'll see this story's end first.」"
    },
    "232:10259": {
      "repository_source_sha256": "0f2e80c8270a7cda81ce77e83247f2359f12dcd73f66465bd44554907191162a",
      "en": "「Very well. From here it's a race. I'll take my leave for now.」"
    },
    "232:10338": {
      "repository_source_sha256": "9365f58e4301053fa5cb10a9cca6cd379de1ec963e33c988a709e7296ea7e99c",
      "en": "「Then let's stop here for today.」"
    },
    "232:10373": {
      "repository_source_sha256": "0c348949da65bc191e1a76b1ddcfd447bddb252cf692d05bc0bcd85d7ec96328",
      "en": "「It's fine, Captain $$アンジェロ$$. $$バナージ$$ speaks of his stance on the game.」"
    },
    "232:10444": {
      "repository_source_sha256": "2a6af5409a0cf34fd90b0c0de0f8041e2e88e8ad0bed61aca511b38588f67303",
      "en": "「True, it feels half-finished... Surely you yourself want to know what comes next?」"
    },
    "232:10535": {
      "repository_source_sha256": "17a3b9d30a95739ab8ca50deb56a5fc4c201ca7f7fce86410511ec78169a5eec",
      "en": "「Oh dear... We do need some rest.」"
    },
    "232:10588": {
      "repository_source_sha256": "16261269c0dab59dab3624723647c438de1c61d15654c8ef9a99f93bad17294e",
      "en": "「Games are meant to be fun to play.」"
    },
    "232:4067": {
      "repository_source_sha256": "6c078359711955547c517003711479ad4a98cbdebea545ea049f0f900eb95ace",
      "en": "「Get out of my way!」"
    },
    "232:4092": {
      "repository_source_sha256": "c1b34ddbc53d7fccfcda302aa2cf67f961fb4708e6446175758b413c619f32b7",
      "en": "「You have no way to survive...!」"
    },
    "232:4121": {
      "repository_source_sha256": "5df166c4bdce666026bf7578d65641bae28000084e3f8538d0d18442267a0761",
      "en": "「What a petty trick you pull...!」"
    },
    "232:4156": {
      "repository_source_sha256": "a32f8601a07e0584a212c13cdf1a7f7cbc42722d1f484d02a293f4cd3975cd25",
      "en": "「I'll set this warped world right...!」"
    },
    "232:4189": {
      "repository_source_sha256": "bf2c06a23b21a272b310405263696c4a58ef874b4ee1da79995a3c581a3b6b13",
      "en": "「I'll take your life right here!」"
    },
    "232:4224": {
      "repository_source_sha256": "5877a6f504537a1aaf2f43bda1263d50d07a1c2649ef3f2e15705519bc26a7b9",
      "en": "「It was careless to stand before me!」"
    },
    "232:4263": {
      "repository_source_sha256": "769adc0dafb3ae6b67d1d3919d0c677ed8ce5622c51b57187e588a1d22d34620",
      "en": "「The outcome is already decided!」"
    },
    "232:4292": {
      "repository_source_sha256": "585350b9aa4e910d239ca5c46b60df93a9d7de3e08c3d32708c218dfc2ff118a",
      "en": "「I won't let you dodge!」"
    },
    "232:4315": {
      "repository_source_sha256": "ffcd9a3cac4529fdb9ebc5fdef315fe6f82dd4d411770f2de74eb02dd52239e4",
      "en": "「Think distance would keep you safe?」"
    },
    "232:4354": {
      "repository_source_sha256": "6c6e05a39659d366722ede964c61db8d82e3c9ce1796b4de8046ac9141869306",
      "en": "「Sadly, that's within my range.」"
    },
    "232:6202": {
      "repository_source_sha256": "92e7267e8ce45900490de13ac3f8fcf62793f97edcc0fa12a0a19763cfc6855f",
      "en": "「Turn to dust and vanish!」"
    },
    "232:6231": {
      "repository_source_sha256": "918acc866786fda4c6c98cc80e21cd06602bb637e3346100058a75667def885b",
      "en": "「All guns, fire in unison...!」"
    },
    "232:6254": {
      "repository_source_sha256": "46473fb39fa37799c7982024c6eb3c840d22e1c4ffa8a6bdde243fbd3b6f6ae9",
      "en": "「Can't dodge this many Mega Particle Cannons...!」"
    },
    "232:6295": {
      "repository_source_sha256": "db9b48d3d801e4ccc47ccb6da02970d64ddade41553250681c89a25ab4bb0c73",
      "en": "「Don't underrate my firepower...!」"
    },
    "232:6334": {
      "repository_source_sha256": "80822afafddd003ff94ebb031ebd3d20ad0860c817ad72f6ceb75e65fd23fc90",
      "en": "「Concentrating all guns' firepower!」"
    },
    "232:6363": {
      "repository_source_sha256": "1aec71fd0b45a6262a918c444c33385773b25b44563f93314f43bf7379547178",
      "en": "「Let this end everything!」"
    },
    "232:6394": {
      "repository_source_sha256": "53a7d5d07b3fad7ff301a129173f268f2aac9d689b565a887e3a2391adc82942",
      "en": "「$$サイコシャード$$, activate...!」"
    },
    "232:6423": {
      "repository_source_sha256": "8a96bf32ef87b2762d20d93e24f99118d8ccde60bf5bba573af5eab26a2a3d7d",
      "en": "「$$サイコシャード$$ generators, deploy...!」"
    },
    "232:6458": {
      "repository_source_sha256": "59b0e4a6c480c0780a18c7f039795352af9e70a433ddf7bfcf69e4c48a8eb436",
      "en": "「This is the light of ruin...!」"
    },
    "232:6485": {
      "repository_source_sha256": "5905c667dd2ddacc281569bcd02308cbac60e953c4fcf9d8dfad8f110ff0a16a",
      "en": "「I'll annihilate the light\\ncalled possibility here!」"
    },
    "232:6534": {
      "repository_source_sha256": "1e3182562b0984c349fce32d09a0f1908b755b9bb213b779db99376f1b53db3d",
      "en": "「Fall into the void!」"
    },
    "232:6559": {
      "repository_source_sha256": "102ec43d50df3b11595f8912b488df063e0476104e75641d98f9a26e6df1228c",
      "en": "「If you believe in the light ahead...」"
    },
    "232:6598": {
      "repository_source_sha256": "67aa6d78db79798a71bc586b901e9c03b88bfe4eaa59c291eff4d6e33b2ec277",
      "en": "「Then I will simply wipe it out!」"
    }
  },

{
  "schema": 1,
  "rows": {
    "248:4594": {
      "repository_source_sha256": "69bf1999fbd7f546e1085f9756c579b34ae016a932e42072d305c55f99eaa335",
      "en": "「A Federation machine is no issue...!」"
    },
    "248:4631": {
      "repository_source_sha256": "0766ec9ea477205609cc44407b87f8754efc794eb11a786d718b606296f2ecd0",
      "en": "「Gundam's power...! It'll be mine!」"
    },
    "248:4670": {
      "repository_source_sha256": "35ae0a374f941940d17bce43c10e2e4b959a06f84d91a0a2359d94cdf8456a9b",
      "en": "「If I use its transforming traits...!」"
    },
    "248:4701": {
      "repository_source_sha256": "c40ca0e3582fc86f29b3bbf19830c5c6860d9fab33ab8db2433e37970e98cd52",
      "en": "「I'll control the $$バンシィ$$'s power...!」"
    },
    "248:4738": {
      "repository_source_sha256": "e69ddd93f798756e5f87f02ecb566f326aca3ca92788b7a2271614368f53acd6",
      "en": "「I will never lose myself again!」"
    },
    "248:4775": {
      "repository_source_sha256": "dc8074678178a7b4a2c94cf3bea1a09d63a78d3b1a032d00da2a3307c8b6f9bd",
      "en": "「I'll draw out $$ゼータ$$'s performance...!」"
    },
    "248:4814": {
      "repository_source_sha256": "d6becbad4e51b51a9df7ab18cabaac795c9d3b2a89dfa2c34e8e9cafefd9c9f7",
      "en": "「The $$νガンダム$$ can surely do it...!」"
    },
    "248:4851": {
      "repository_source_sha256": "58fb44dc5401d3710a85ebba84e6988424d4726a38cc898ca506b9771c3d9673",
      "en": "「$$ターンエー$$'s power, to carry history on!」"
    },
    "248:5084": {
      "repository_source_sha256": "8436a066ee9b15a53375a240bf661ae1ebeb1143cf06ba2e02601cced7e91051",
      "en": "「The Princess said it...!\\nShe won't walk the same path as you!」"
    },
    "248:5137": {
      "repository_source_sha256": "65c3d207146d29116046efb17de3a108bb23aa8ac6dd40eaac0e2e3307d33e0a",
      "en": "「I can't let you run free, you who\\nthreaten the world and the Princess!」"
    },
    "248:5190": {
      "repository_source_sha256": "04dc11ad735548d72aacc3479767c733739c3d53b3433169ce928967ebbe717a",
      "en": "「I'll end this, $$フル・フロンタル$$!」"
    },
    "248:5227": {
      "repository_source_sha256": "36fb21ff990a075f883ded94bc328e1c078594a51cc5351fc1788a58933afb90",
      "en": "「I won't lose to you, who hides your\\nexistence behind the word 'vessel'!」"
    },
    "248:5286": {
      "repository_source_sha256": "d818d894cdb28121fac8ec44a9a1eedc6468bc16831cc8a9c8a8c22ed7d361c4",
      "en": "「I'll repay you for running amok,\\n$$アンジェロ$$!」"
    },
    "248:5345": {
      "repository_source_sha256": "c9f1c71dd82c94c92db456e0bcbaec2b775bc72b9ddeefb0e517ff7c4e333cc6",
      "en": "「Don't mistake your refuge, $$アンジェロ$$!」"
    },
    "248:5386": {
      "repository_source_sha256": "050b2333399aa0222e544b9c797a30521405c18b8c164b477370e28658b1b992",
      "en": "「I'll make you let me through,\\n$$アンジェロ・ザウパー$$!」"
    },
    "248:5439": {
      "repository_source_sha256": "0a149442c132dd151dd893ae6028f5a673df706de910d6d0b160f1c0d8d701e7",
      "en": "「Calm down and look around you,\\n$$バンシィ$$ pilot!」"
    },
    "248:5494": {
      "repository_source_sha256": "a11cacc601da462872c9975f1de9933567f83bb4f64967951825d15fe4541895",
      "en": "「Don't fight misled by the $$バンシィ$$!\\nAt this rate, you'll...!」"
    },
    "248:5555": {
      "repository_source_sha256": "9eb379e15ad2b1ca4e9bb9342ecc0da82165e24063fda4043c147281307bb9e5",
      "en": "「I have to make you see that\\nlight is dangerous...!」"
    },
    "248:5604": {
      "repository_source_sha256": "c56629c9d7ae2afa6c7411d7aad5dbbf0d681e85e6e20cb1297fdc11d7c20e47",
      "en": "「I won't let you bar us from the Box!」"
    },
    "248:5639": {
      "repository_source_sha256": "624525ec89c1a47afc824cb3bd688b7304864d7e216d81c62ec7cda830925726",
      "en": "「Weapons down! Hear the Princess out!」"
    },
    "248:5680": {
      "repository_source_sha256": "d863f7457aa5a0224f2fb9cf86b30f251aa7b28f0f061850f03225220ea8b247",
      "en": "「Why can't you see you're dancing\\nto the Foundation's tune?!」"
    },
    "248:5731": {
      "repository_source_sha256": "90c7e65b6fca9f123b5505a5e780afad355a2a812ef164f346d0d75c8e8d92bc",
      "en": "「Lady $$ハマーン$$...!\\nIf you'd obstruct the Princess...!」"
    },
    "248:5782": {
      "repository_source_sha256": "61a327c267594526e2274773f2934615803f6fc5b08086ea352ee790b6fd7444",
      "en": "「If they fuse with us, we're done!」"
    },
    "248:5819": {
      "repository_source_sha256": "8512661fed14c231d8931d99e910e0e2579753355eec83e9b9c7f7a7a1a25c47",
      "en": "「For now, we just have to stop them!」"
    },
    "248:5862": {
      "repository_source_sha256": "57c07cecb74a742d1322113b3de71de82e0b682ab1cea8d166fdc5658e97ebf3",
      "en": "「I can't let the invaders get away!」"
    },
    "248:5899": {
      "repository_source_sha256": "0499013ee7f1855bfabc7869aea6091194d1dbc928252a5028e80dc29ff7a1e2",
      "en": "「We'll defend Earth and the colonies!」"
    },
    "248:5942": {
      "repository_source_sha256": "2d2a6d0421349d8c24514d39d8e1335ed9e09badf97b0ef764fcd95b9ddcebb6",
      "en": "「What are these things, anyway?!」"
    },
    "248:5979": {
      "repository_source_sha256": "94be7054079232b1184f361bfa66b84a3d4eabe1357c4e2b0f4f56414beb9a78",
      "en": "「Humanity has a future!\\nI'll protect it!」"
    },
    "248:6028": {
      "repository_source_sha256": "c9230b68a0c72853c0ef990b7937e4ea7fdb8820cda8083a741218230d15a30f",
      "en": "「I won't retreat, however many come!」"
    },
    "248:6067": {
      "repository_source_sha256": "9358497bdd7a76df78eabfafc47537d8b5e90bcad3d5f841463ae73e0dac3c9e",
      "en": "「Something that tries to rule people\\ncan never be a god!」"
    },
    "248:6122": {
      "repository_source_sha256": "d47dd0f66b8ee91e8123fd74a0ae3be59b20462c75324efe7d46f98bad51ab7b",
      "en": "「I'll smash machines binding pilots!」"
    },
    "248:6163": {
      "repository_source_sha256": "27889bb4d10cb4bc7642d1393b412f0dd79c477b19273cf41877fc7a374a32b2",
      "en": "「Hold on...! I'll save you now!」"
    },
    "248:6200": {
      "repository_source_sha256": "edaaeccb4c48f23c7585fe67b663bb4c3293249a386d0f124e634f1d1d6f4a2b",
      "en": "「$$サイデリアル$$ confirmed! Intercepting!」"
    },
    "248:6237": {
      "repository_source_sha256": "2a335424d8ca7192f38dec77da2fa539f84377efbb66d0164d8d396d7c2a1129",
      "en": "「I'll cut $$サイデリアル$$ strength a bit...!」"
    },
    "248:6278": {
      "repository_source_sha256": "051739fcf6087a1d1238c33ffb0a45c8329fc12420984f787c92b70591dcf205",
      "en": "「If I leave you alone, the colonies\\nwill be dragged in sooner or later!」"
    },
    "248:6341": {
      "repository_source_sha256": "ab3d9187aba7aebe683b85c36adb7b06d00dc9068ac9f185ec120ba67a26754d",
      "en": "「Against a Reactor, I don't know\\nhow far I can go, but...!」"
    },
    "248:6400": {
      "repository_source_sha256": "f7abce6f5a90630da6c6fddd33e6c72d34125fa7bec9cb51242f5f69b5f38cff",
      "en": "「The glow of your $$スフィア$$...!\\nIt's a light of ruin!」"
    },
    "248:6451": {
      "repository_source_sha256": "6374f6a29cdf5add03964d80e1ed8786a2cb87504023e1f5be2fc452dfa45f71",
      "en": "「Know the Empire's sun is setting,\\n$$アウストラリス$$!」"
    },
    "248:6500": {
      "repository_source_sha256": "71832a73430c69f028686ba1639d743af0b6a1e3ab8c647c5a9c5f661bc9c2cb",
      "en": "「You'll answer for all the fighting\\nuntil now!」"
    },
    "248:6555": {
      "repository_source_sha256": "367a83cf091a55b55dbce2c3665eb4922e7bc97461e2f8bd280ded566a16fc5e",
      "en": "「I'll credit your stance against\\na cursed fate, at least! But!」"
    },
    "248:6614": {
      "repository_source_sha256": "21e29acb4550c961566e7134aa3be9a047f081ab0bad915ec47173c213b0a5dc",
      "en": "「Whatever your reasons, you are\\nour enemy!」"
    },
    "248:6663": {
      "repository_source_sha256": "8d1675cb58971ef6debb58b08065a1efaa92cc7bf099813f6356c9fe2cfd01e6",
      "en": "「You who ignore people's prayers\\ncan't be emissaries of God!」"
    },
    "248:6732": {
      "repository_source_sha256": "87768f67cf45b88e520c4e714b166a055f5f7ff2ce4bf664abac81eecee2b414",
      "en": "「The light we should cling to is\\nnever the likes of you!」"
    },
    "248:6797": {
      "repository_source_sha256": "6d3ea84a971446b47b56c2447fa4ac03b319c1c672550073e1b6dc5c83f3d586",
      "en": "「This man...!\\nWhat's he thinking behind a smile?!」"
    },
    "248:6844": {
      "repository_source_sha256": "0da8a1a5a66f86991ae495a923196b193d7ea965578be189a87f85ecdd4bb538",
      "en": "「$$アドヴェント#pilot$$!\\nYou're no savior!」"
    },
    "248:6893": {
      "repository_source_sha256": "d8f926ff1347479ee9046e3da3ae43b7f1afa389ee2de59df7dfb906644a5fb7",
      "en": "「$$アドヴェント#pilot$$! I'll defeat you\\nand return to my Master!」"
    },
    "248:6954": {
      "repository_source_sha256": "198db849e95877924ff5fef54ef0fb79e8eee5a8a08413d363b4630cd1a52c1e",
      "en": "「Cowards who cling to the $$御使い$$s!」"
    },
    "248:6985": {
      "repository_source_sha256": "692a50d2710a12e157d91017c2bd2d0e05551a1c0b90896f0038f1c89cb14dc7",
      "en": "「I'll teach you that the light you\\ncling to is a sham!」"
    },
    "248:7658": {
      "repository_source_sha256": "654d1e10d2bf2a982aff66c2f3776e724b073fa2aa56da8f57bb0102a8a22549",
      "en": "「Intercepting at once!」"
    },
    "248:7679": {
      "repository_source_sha256": "877b66f0a6616b2c858d98e806934f7f1f9c6e5d1459e7aa6046ca7c03a94fdb",
      "en": "「You think you've escaped with that?!」"
    },
    "248:7708": {
      "repository_source_sha256": "dfc5e86b4a49160ec1baae1c973318267f9786e0fbb16b77a516e4c7321ea55d",
      "en": "「You open up after you attack...!」"
    },
    "248:7739": {
      "repository_source_sha256": "87fb364685dae0ec4918e7cadedd5690f3c01e7fc704a9e1223c3c70cf950cfb",
      "en": "「I can't let you go like this!」"
    },
    "248:7776": {
      "repository_source_sha256": "059032beae9ceeb26c766225ea93c9490ddb4a0f8c660745caf8b04a1f4a9f30",
      "en": "「Let me lend a hand!」"
    },
    "248:7801": {
      "repository_source_sha256": "155e8ea7e599195f3d6ca95df9a8580787912079f0ec025ab0e70dceceb79693",
      "en": "「The battle isn't over yet!」"
    },
    "248:7832": {
      "repository_source_sha256": "9eeb655ef29d1358a8f47a63d58e512027cbc244402c58fe2ec402050563b5d9",
      "en": "「$$バナージ$$, leave the rest to me!」"
    },
    "248:7867": {
      "repository_source_sha256": "6e3a8e4f1cf307d6d1e0b58a7c2ee02e4f15cd1d25f2be833178e0705f3233b7",
      "en": "「Ensign $$リディ$$, covering you!」"
    },
    "248:7894": {
      "repository_source_sha256": "3f4ced42560fa034123096ffe45cbe639217a48d3a9b201791ee7399cceec552",
      "en": "「I'll follow the Master!」"
    },
    "248:7915": {
      "repository_source_sha256": "63340289d8650b03fe13924339bc09d23774356e9581d896f0a175bae5ba2589",
      "en": "「Moving in to support Colonel $$シャア$$!」"
    },
    "248:7952": {
      "repository_source_sha256": "1a60f467f531c6e452343a1971120f4fc3788ee92007b0d50163b6ca29a9f167",
      "en": "「Covering you, Lady $$ハマーン$$!」"
    },
    "248:7983": {
      "repository_source_sha256": "9910fa6dc5833566843b329067ab2493ff575992a2e5fa764fba013ffa3d063a",
      "en": "「Being near the $$ネェル・アーガマ$$\\nturned out lucky...!」"
    },
    "248:8038": {
      "repository_source_sha256": "3aaa231e55de7925d574c30a716eaff23343c1f41c3a3132dd548a56f32fc7d7",
      "en": "「$$ロンド・ベル$$ isn't your only enemy!」"
    },
    "248:5014": {
      "repository_source_sha256": "0c2dfa007c703d94617850dd50c619faef04841d617105f181c35efc32958232",
      "en": "「If I fail, I'll just keep trying...!」"
    },
    "248:5053": {
      "repository_source_sha256": "05f084cb68972833bec01eb96f4d9f1d9562c0154240c15d0873b6871b251746",
      "en": "「This time I'll bring you down...!」"
    },
    "248:8420": {
      "repository_source_sha256": "28ca97cccb2388a29847950d195fe6cf74d60c451a2bc1afb3ddf63a9f14eee6",
      "en": "「I'll secure the way forward!」"
    },
    "248:8445": {
      "repository_source_sha256": "df6708e59dc7b69a5fda2b42caa9b0aa8250984f9ffd635a1bfdc77880cdaa4c",
      "en": "「I'll at least break their stance!」"
    },
    "248:8368": {
      "repository_source_sha256": "476de72c3bdeb9c32b9e62f07e6a7be1e85a5071167998479c94527cf72e4e70",
      "en": "「I'll take this one on!」"
    },
    "248:8397": {
      "repository_source_sha256": "f1a81ede21077983d3a40aa128d9fd6289f0d97cb545596af18257fc42f3d610",
      "en": "「Good luck to both of us!」"
    },
    "248:10216": {
      "repository_source_sha256": "ba0490d5cf650029becd4f2fbdb3b0652008416d3affb848a029cee35c100966",
      "en": "「Sorry...! This is as far as I go...!」"
    },
    "248:10251": {
      "repository_source_sha256": "db8ee2f3010257795303d02c040b858d72c72383a87fd1c53c96f9ef8fffe6c0",
      "en": "「I'm sorry, Master...」"
    },
    "248:9429": {
      "repository_source_sha256": "035f08cd7af6f4fcec4e45d2bd4f8586b739bde617a8f0acda82aa1eebf4faf5",
      "en": "「I won't lose to one who gave up...!」"
    },
    "248:9472": {
      "repository_source_sha256": "dd09e463182ed8d6a8951c97b257f610dbfcc724f002beb6aa47593ec38cb713",
      "en": "「You're not called the Red Comet's\\nreturn for nothing...!」"
    },
    "248:9525": {
      "repository_source_sha256": "1f5e1cd5eb090dc126f9b7a43fa3d0400c0bce8df416a5a8e54a4540e4551356",
      "en": "「The Box will go to $$フル・フロンタル$$...!」"
    },
    "248:9568": {
      "repository_source_sha256": "eb360384a7efdb607ae913d1dfdd7056ed2fa4c00df16606dbe2fae2a4cd5c2d",
      "en": "「Ngh!\\n$$アンジェロ$$'s tenacity corners me...!」"
    },
    "248:9617": {
      "repository_source_sha256": "23f0a3cbf542e5edcfaaa5b2ddb0e0d314cab693c734825ca9363242b9a69a1e",
      "en": "「Stop it, $$アンジェロ$$!\\nHatred will swallow you!」"
    },
    "248:9670": {
      "repository_source_sha256": "7f9a6893e6fe5859a0663893f6f7991b1d2e6f005f9e4030e6f8d271c1937c59",
      "en": "「$$ハマーン・カーン$$!\\nIs this what you truly intend?!」"
    },
    "248:9729": {
      "repository_source_sha256": "00b5f0ac3cfbe937cf6f8c45a98cfca14fc72592c443ce488a3065ebb6403262",
      "en": "「Is it fully under control...?!\\nThat black Gundam!」"
    },
    "248:9790": {
      "repository_source_sha256": "d8329947529730ea130f1415704d4c9716d4978b6a86b650b32b7fc725b44e1b",
      "en": "「Stop fighting! At this rate, there's\\nno taking it back!」"
    },
    "248:9857": {
      "repository_source_sha256": "9b4f5f23450fdb3f5a563bf7ca8022e0054f5e2220c6b647568695ff6d5d45ec",
      "en": "「If you wish for $$ジオン$$'s future,\\nstop fighting right now!」"
    },
    "248:9912": {
      "repository_source_sha256": "a1a3f0b737c834ea68f85b4a54911793b8d2bcb5d5ac15024c8f2bb85a948ca1",
      "en": "「Will this hatred cover space...?!」"
    },
    "248:9953": {
      "repository_source_sha256": "2ef9a5057fd5cbcfc18a2db52331e93cb9a48c16f2cb549bcb6eabaaf9dda3f0",
      "en": "「Damn the Foundation, they'll seize\\nthe Box at any cost...!」"
    }
  },

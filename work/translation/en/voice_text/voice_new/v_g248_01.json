    "248:10610": {
      "repository_source_sha256": "80bd97374876ead93a1e44c85736ea16ad25a0184aa0fe41b4afafa297f90957",
      "en": "「Keep a firm hold on $$バナージ$$, Princess. Or else he...」"
    },
    "248:10677": {
      "repository_source_sha256": "87f4f9cd782a4c51e79b9117780c5e4f1dcffb7a15ba92a383b3f04be169cf30",
      "en": "「Another game over, $$バナージ$$? Not enough practice?」"
    },
    "248:10758": {
      "repository_source_sha256": "a00afe8e5ab987149ef0f391eee0a65170b17c645417738833b0136a09574f7d",
      "en": "「Then retry after a game over. You keep your funds and levels.」"
    },
    "248:10841": {
      "repository_source_sha256": "98aea6e42282fe1fc5b15fd052b5428a88a8b3c805bf78e44129c6442d0eb225",
      "en": "「You can always start over. People... and games...」"
    },
    "248:10898": {
      "repository_source_sha256": "10c879d892dc544c5e11d50479af1d81880c1c839d38d14db2495b5504a995ff",
      "en": "「But a retry after game over forfeits SR Points. Do mind that.」"
    },
    "248:10991": {
      "repository_source_sha256": "1f27c3cd33840d43108ea5ec9920efa92df021b884bf0cdeb82ee4b00512c413",
      "en": "「Good luck, $$バナージ$$... and to you players, too.」"
    },
    "248:8075": {
      "repository_source_sha256": "bcf6dbce64ea261f211fa7b38970bd691ff94f34adcb402b86f369af16875a9c",
      "en": "「I won't watch my allies get hurt...!」"
    },
    "248:8112": {
      "repository_source_sha256": "46942be0fdb5af0e0406805ef5f9a67f02bb4c02e35a079fbb15f846c89e8ed9",
      "en": "「I'll stop them here!」"
    },
    "248:8135": {
      "repository_source_sha256": "74757acc4f3474d636721b245e93492881ee64a1a6e2c742e868bf292e9d013a",
      "en": "「I won't let anyone touch $$バナージ$$!」"
    },
    "248:8168": {
      "repository_source_sha256": "369ecd42c1a3dd23042a2745344102e12797e978316975cd0ba16a34b29c0826",
      "en": "「Stay alert, Ensign $$リディ$$!」"
    },
    "248:8197": {
      "repository_source_sha256": "f5140ab9439f3fbe89b15da8f43abf453a51bad3084e716b9c763483c6e4985d",
      "en": "「I'll protect Master!」"
    },
    "248:8222": {
      "repository_source_sha256": "928804f11b7ad13b2b32a12af28e828ffaaec71fb9f2c598bd071b8e6b5d0c40",

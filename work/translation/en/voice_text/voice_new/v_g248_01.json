    },
    "248:8257": {
      "repository_source_sha256": "6f472e630f54003e7d824681660a935756658c859d63b3658838e01c1b00347b",
      "en": "「This time I'll protect Lady $$ハマーン$$!」"
    },
    "248:8290": {
      "repository_source_sha256": "13195d8062ecf294d2c096cf7a8069a083ccc92d64c92e7ca9f8c5af13b79223",
      "en": "「Captain $$オットー$$, I'll shield you here!」"
    },
    "248:8329": {
      "repository_source_sha256": "46f3ee4041b0f41ec57922342d2f865b848576dbb9aa8aa5290d39e4ae6923dd",
      "en": "「That'd disgrace the $$ロンド・ベル$$ name!」"
    },
    "248:4403": {
      "repository_source_sha256": "8fc34428968dc6bee8ed2552a78b460334d282f6941e6fad224fc9aa46da1624",
      "en": "「If I strike at this timing...!」"
    },
    "248:4438": {
      "repository_source_sha256": "5a808a7025742f07b0f83f938e0000f15089a53338f0e0fc1dbb3e4d6a8d46ff",
      "en": "「I'll break through here!」"
    },
    "248:4459": {
      "repository_source_sha256": "b7b3a5d27bc41927cb5a9d773aab9350068ac5ba893f8b2af03eed315098d7d9",
      "en": "「I'll stop you here!」"
    },
    "248:4480": {
      "repository_source_sha256": "780248ae6bb7253ee2da1c999c1f7a1468897c578b104cf86ebff8ee95b69b6c",
      "en": "「I've taken the advantage!」"
    },
    "248:4519": {
      "repository_source_sha256": "1d24caadd75154c973f5723335ecfb1cb5898aa40a4b944cfa946203160ccf07",
      "en": "「I'll drop them one by one, surely!」"
    },
    "248:4546": {
      "repository_source_sha256": "2a26d87a163d60465fafe663329aa23651f1d74143aedc21b876caf9f5ba0368",
      "en": "「I'll fulfill my role!」"
    },
    "248:4571": {
      "repository_source_sha256": "775f8c6d0605961c5b98b862ff21b04e01e29e5328c719a7fac302561acf05f5",
      "en": "「This is my fight!」"
    },
    "248:4951": {
      "repository_source_sha256": "8de30ebd9cc60d5a1fd02d61341864b774acba75789b1e81ccb3ad4b623fa6a1",
      "en": "「I'll use a sure method!」"
    },
    "248:4886": {
      "repository_source_sha256": "a73cdc2a384d5adf172c1de6b267b08a42def3b4568c8167a484c10b42ce2ab8",
      "en": "「My aim is set...!」"
    },
    "248:4911": {
      "repository_source_sha256": "49ba839ba5b3a221e5f7f01856832faac3a3a9536dd6882b367ac7392c7de9b7",
      "en": "「From this position...!」"
    },
    "248:4997": {
      "repository_source_sha256": "2fd15e14e67c98a75022358e49659efb86226d51991cc462043c43e7edb00946",
      "en": "「With the saber!」"
    },
    "248:7404": {
      "repository_source_sha256": "8649278097937fa772f3afadd82fd455ac0712bd222bdf49d705403523f4d22f",
      "en": "「My consciousness is expanding...!」"
    },
    "248:7435": {
      "repository_source_sha256": "63380c340bace9c4b09442efb46abe8f15ab7109db85191c1f1be078c6cb830d",
      "en": "「Human will... $$ゼータ$$'s power...!」"
    },
    "248:7489": {
      "repository_source_sha256": "e70d1bd9a78c2e99f0e6de5a6757aa6129d2063101cc39b9ea40fc70ba033318",
      "en": "「Show me that power, $$ゼータ$$!」"
    },
    "248:7520": {
      "repository_source_sha256": "437c9331f32dbc1c0058bfd5b958cdad09fd2664e1206104d20969e450d391f3",
      "en": "「For the lives lost until now...!」"
    },
    "248:7582": {
      "repository_source_sha256": "105472620c5207247b8657761b2048242e8ab9ff52a0c0a79ab9898b0d6bb7b3",
      "en": "「I must use the $$月光蝶$$!」"
    },
    "248:7609": {
      "repository_source_sha256": "4773a314a4ae9370ff73038db94f97686a3b29752c4ef0dbd0d47ef95da3aca8",
      "en": "「This power...!\\nUsing it to link time to the future!」"
    },
    "248:7042": {
      "repository_source_sha256": "fb8f4aa89c51701fca8c1a4ab1de5e938dff3099c3ff0953491032dd721effa7",
      "en": "「With this Armed Armor...!」"
    },
    "248:7109": {
      "repository_source_sha256": "e357cda0603c2f22742405e7da01b340d691994eb78429b0c463ea3320f9ff6d",
      "en": "「First, secure the best position...!」"
    },
    "248:7146": {
      "repository_source_sha256": "dec25f9b70f1a204f1920296d9afdf626df6aa8cc60c1ae66ca141b672dc23b1",
      "en": "「Good! From here, I can!」"
    },
    "248:7171": {
      "repository_source_sha256": "944b57de83d518aa25cf413e2485a92d887a00334737c121cd23376205896b1d",
      "en": "「I know its power firsthand...!」"
    },
    "248:7206": {
      "repository_source_sha256": "859a33de95ccb44eaed48eef9d1f4ecc6f749ca8e0b5f94916632ed2dc097964",
      "en": "「If even one shot lands, I win!」"
    },
    "248:7250": {
      "repository_source_sha256": "331645456ebe055136b773288dce783d3922933c846af302bf85a80181551d47",
      "en": "「If it's the Beam Magnum...!」"
    },
    "248:7281": {
      "repository_source_sha256": "27b376ee7aa1a8a4b3b8564c441690b0484702e166cb49b969b99507e486ebf8",
      "en": "「I'll fire every last round!」"
    },
    "248:7323": {
      "repository_source_sha256": "83afbf4dbbddbfdf30adc99a4476a454c42230f4f52bfb18e6e61e7dfc2081db",
      "en": "「Prepare yourself!」"
    },
    "248:7346": {
      "repository_source_sha256": "aec164c1d849c59b4ebcd0c3814da8b446e92f599d7f22c4a57a759aa9481662",
      "en": "「I'll fire while the barrel holds!」"
    },
    "248:7379": {
      "repository_source_sha256": "6f759a1a9f1ea09d2e5cbbe436f825d8dd92f66e7db00466be66ed8090b59f36",
      "en": "「This is the last! Hit!」"
    }

    },
    "249:2643": {
      "repository_source_sha256": "7a50ddfc0a29fbef730a8061d35541b31c25b2189ecf0863e18b08a77a29b5e3",
      "en": "「An attack like this won't stop me!」"
    },
    "249:2674": {
      "repository_source_sha256": "2560e351e12ce856302ff01fd151eb03067a4550b7f8e2e2b0a14202b7fdfaa8",
      "en": "「Don't touch me!」"
    },
    "249:2693": {
      "repository_source_sha256": "67e7ffc0a2a5965b68dea1a5ac5ad65a734e103f0c0e2b533608a46baa4e70af",
      "en": "「You'd get in Master's way?!」"
    },
    "249:2438": {
      "repository_source_sha256": "3f41d7f61a0e2b9b5818f36782e6998e0b997edcde4b3c823b28e1504670e192",
      "en": "「Hitting my shield means nothing!」"
    },
    "249:2469": {
      "repository_source_sha256": "675330f8756672b3aeed6972a45288599477903fa0268b85a9e78ce97c7e96e8",
      "en": "「I'll stop it with the shield...!」"
    },
    "249:1805": {
      "repository_source_sha256": "2dcb97913b8d89a0e73a81098dbd140c679787422535be8e1fceea2ca54674d2",
      "en": "「Looks like the pilot is the problem.」"
    },
    "249:1840": {
      "repository_source_sha256": "821b32e70df3a1c1121a86640d71171922935c6c226b667e009ec4a5f8f0e046",
      "en": "「A monotonous attack, just as I read.」"
    },
    "249:1867": {
      "repository_source_sha256": "f8867ed3fd4764d48053c0a11069a3ec993eb1ec6f3bf537ef97c0177d4d94d5",
      "en": "「That was plenty of time to dodge.」"
    },
    "249:1902": {
      "repository_source_sha256": "46cb497202d3ab26d55b359157ec79a4639fbe9d28e41ee635c3da3a67d70285",
      "en": "「You thought that could catch me?」"
    },
    "249:1939": {
      "repository_source_sha256": "9ec98f8655e477e2c6550ca816e13b249176b479bb7379bf90b132b5f5aafba6",
      "en": "「You launch a pointless attack, huh.」"
    },
    "249:1970": {
      "repository_source_sha256": "4929236f56953661d6c2ae81132479cb5f0cdac0432699526844d73ac4f9312d",
      "en": "「You lack everything.」"
    },
    "249:2347": {
      "repository_source_sha256": "e69f2ba9f9a94027585123a376925dcc5358f41ddbc3f741920609c9d5a4f058",
      "en": "「Spare me the pointless resistance.」"
    }

      "repository_source_sha256": "0a70e9f122b0d2f82deaae8c2db11fc9c67262aef789288d56611509f7ef3325",
      "en": "「However much I take, I'll fight!\\nFor Master!」"
    },
    "249:3689": {
      "repository_source_sha256": "228a6c19b94a134785ac8f22c9e315bbfeafa85ace3b35c41d36f75099ff1b2d",
      "en": "「Master... Master...! I...!」"
    },
    "249:2724": {
      "repository_source_sha256": "1d70be15665be929e4f6bd4e5eace433a344c84060ffe65e75470e237782f53f",

      "repository_source_sha256": "e0063a8b33f110d744728c99ea57e3adcdae3f5702d6b5b5b83a2f75bcdfa972",
      "en": "「I heard you were all elites,\\nbut is this it...!」"
    },
    "249:2178": {
      "repository_source_sha256": "3f95b37cfbaf1e7e0967e439b9780e70030bdcbad968ad8fe172bc20dcc4575c",
      "en": "「Even $$ロンド・ベル$$ is no match for me!」"
    },
    "249:2246": {
      "repository_source_sha256": "a73a960137fc8b3e282a77ca8bd714dd57f42893aa40bb919f9acdd683c5afe8",
      "en": "「Not as good as the rumors, Gundam!」"
    },

      "repository_source_sha256": "3d2d16061ed2017b9da1a342c918518032b6fdcb5ab4e948af5d83403b339011",
      "en": "「Strong...! Beyond what we expected!」"
    },
    "249:2871": {
      "repository_source_sha256": "1450e16561f724fdf1bb29a1db0c75be22d8f0a99440d520f273cc62a327c5d3",

      "en": "「Not damage worth worrying about.」"
    },
    "249:2531": {
      "repository_source_sha256": "89acbd979d5484ac926b994341231d8cffdddd2bd296926628734de63780a04f",
      "en": "「Minor damage. Mission unaffected.」"
    },
    "249:2562": {
      "repository_source_sha256": "064521aa1b2cf7897cdb47ce5b08118e4c87f48bf1a5fbc2f9c5993bb4a5a4cf",

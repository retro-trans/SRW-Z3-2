{
  "schema": 1,
  "rows": {
    "272:0": {
      "repository_source_sha256": "b50478befabc7d643e44e3f4dea608048cc4b80146df48401f0c770689dcb862",
      "en": "「I, $$ラケージ$$, shall be your opponent.\\nConsider it an honor.」"
    },
    "272:67": {
      "repository_source_sha256": "002a5c6b8e5f4f3ce073e540314c2dddd4b4a57c58613f8d349013b5cd5a3d29",
      "en": "「I never let marked prey get away.」"
    },
    "272:100": {
      "repository_source_sha256": "5f1fbc416ad2c50dc6750b77f8269956f6dd20e6dd6773930939900c855317b0",
      "en": "「That's the price of underrating me.」"
    },
    "272:135": {
      "repository_source_sha256": "9870701342629ef433570fdecda5cc9efea51700e6466350c66bcfb2a30462bd",
      "en": "「Hehehehe... This is getting fun.」"
    },
    "272:176": {
      "repository_source_sha256": "34aad5e4f916f9dcbe0822730aecc860621fb40a606090def93c9d87a3e9f1e2",
      "en": "「Being my target was your bad luck.」"
    },
    "272:211": {
      "repository_source_sha256": "a8f8860c3d78962da57caae798bd03d418800a81a7f7ba88058ab4bd70ffe696",
      "en": "「Run if you don't want to die.」"
    },
    "272:254": {
      "repository_source_sha256": "5dd029196bbd0abadcbdbe37347ffd1e21613c8c77c4b92d6122897a84d98c83",
      "en": "「Are you prepared to go down?」"
    },
    "272:289": {
      "repository_source_sha256": "092ca5379b161fac92c585c5533a31aef84fec2f6724603fb437f2754aec3cfa",
      "en": "「Think you can beat great pirate $$ラケージ$$?」"
    },
    "272:1053": {
      "repository_source_sha256": "06864137b140aa1b648e6532840850de6cf9550d28d346ee6eb00f0f39b4e266",
      "en": "「You're not the only one\\nwith a special $$ユンボロ$$!」"
    },
    "272:1112": {
      "repository_source_sha256": "edc63654a4267d30753afe6350a193c09bd56a2dfca45931d8b8e8758719c01c",
      "en": "「With my skill,\\na $$ユンボロ$$ like that is nothing!」"
    },
    "272:1163": {
      "repository_source_sha256": "5c3b217635db463b6ee92f28a3f088aff784410dc3dc69c387170f7342e8ec75",
      "en": "「A pirate doesn't fear a $$クジライカ$$!」"
    },
    "272:1202": {
      "repository_source_sha256": "3568e126d409e977cf88a9ae036f3ad3ed19c2f94904c3752d05d80f42eac04e",
      "en": "「Honestly! What a creepy opponent!」"
    },
    "272:1243": {
      "repository_source_sha256": "21ab4c45d9f3c13524fcc9963ad8b6e78fae936a951de590d1e81b581fb3a697",
      "en": "「Shall we go hunt space $$クジライカ$$?」"
    },
    "272:1282": {
      "repository_source_sha256": "d5a59ccd8ec0bc46097024da9cd873b74bc36095746e8e3906118804894d1749",
      "en": "「I'll sink you, fleet and all!」"
    },
    "272:1317": {
      "repository_source_sha256": "22d025e59bf5d91d91de8ce435af5669455dadf6b4e272f1b5a4b473e6e27524",
      "en": "「Let's finish this fast and get back\\nto the pirate trade!」"
    },
    "272:1368": {
      "repository_source_sha256": "4f0a79cee8220c067ae8a3e8c02b95b351a9fda02d8585003f0704afff1aa5b2",
      "en": "「I'll break your broken machine\\neven further!」"
    },
    "272:1421": {
      "repository_source_sha256": "b2e34eeb97d061fb0be2ca6936f002389015f176c33bb600fac31652507c100d",
      "en": "「Prosperity and peace are things\\nyou seize with your own hands!」"
    },
    "272:1472": {
      "repository_source_sha256": "c4f8945c1f8d7f0613544b35afe7f4bda88c96675a89d85e795784b0da9dd697",
      "en": "「How about a contest of power?」"
    },
    "272:1507": {
      "repository_source_sha256": "96b4e6678908575b9e8f231e952c081e2769a5dd70deec96f894472bf8cb3c1f",
      "en": "「What a pesky $$ユンボロ$$, darting about!」"
    },
    "272:1550": {
      "repository_source_sha256": "b841c1537353192e2fe19f6265c02ec0367ce7f9c29d01aa4e16d3e27b3e2105",
      "en": "「Can you match my $$ユンボロ$$'s power?」"
    },
    "272:1591": {
      "repository_source_sha256": "fe01f88d50d03118ca8dfc7e9cba14d13b62581d7eaff66f382c92bac0ee5833",
      "en": "「You're big, so you're easy to hit.」"
    },
    "272:1630": {
      "repository_source_sha256": "56dd88c4a158ba96eab09ef150760520325f11a1bf9ef0e92fb9c63b4b53a90b",
      "en": "「Hehe, that color...\\nI don't mind your taste.」"
    },
    "272:1681": {
      "repository_source_sha256": "29d062b46477cd00c2a094ef7f277d3156ea9eced6208bdfddd22825a6928000",
      "en": "「I'm called an Empress too...\\nI won't fall behind.」"
    },
    "272:1740": {
      "repository_source_sha256": "d0314d06f2e5f8f6c1449eabe0d89f652a77daccff44b07e948ba8fd30876f9a",
      "en": "「A $$ガンダム$$ Yunboro, is it...\\nWorth the trouble of taking down!」"
    },
    "272:1799": {
      "repository_source_sha256": "ecf0507b94c889d6c737d7914f27870656656eeaedd2fac751e8dcc9370212d8",
      "en": "「Unlike the space boy's $$ユンボロ$$,\\ndon't you talk?」"
    },
    "272:1852": {
      "repository_source_sha256": "8a6606ead13a385cda67c773b027f0c65e2b87034832f0b141f58c6ee7c3a316",
      "en": "「I'll scrap you as a souvenir\\nfor $$ピニオン$$.」"
    },
    "272:1909": {
      "repository_source_sha256": "8bd97035362d5a4eeb997f4b17b56d7cac2e29134d8e127649592b6d51858e1e",
      "en": "「Kindly go back beyond the stars!」"
    },
    "272:1942": {
      "repository_source_sha256": "cb08f6446274e0415d6b0906235cca3c3fd20ed638d68a1b08b9eef14da79e2c",
      "en": "「Since you came all this way,\\nI must show you hospitality...!」"
    },
    "272:2003": {
      "repository_source_sha256": "08a38a6c95ef49df4097e86ec7b65ab3476fb3ff3365cf966941a4cc0102fa83",
      "en": "「I don't like creatures like this.」"
    },
    "272:2046": {
      "repository_source_sha256": "d95e7edcfa5e66f51c4c66facd87b7fe758396837705200db17c1c89e7a35305",
      "en": "「No need to hold back on a monster!」"
    },
    "272:2083": {
      "repository_source_sha256": "739d945f063866866bcd894ba782fd1a79a9815aac951c12d5ce76c0f97656b7",
      "en": "「Attacking you doesn't much\\nappeal to me...!」"
    },
    "272:2140": {
      "repository_source_sha256": "dcc12ec3c6aac603fea61d0c749245cd639274360732413787272c41cd9423a5",
      "en": "「If you surrender,\\nI might let you go!」"
    },
    "272:2191": {
      "repository_source_sha256": "d991c5811ac49180c7aa2598d2a9b97ffc85be6fb75ad01505ec17cf38ffecf7",
      "en": "「What treasures are loaded\\non that ship, I wonder?」"
    },
    "272:2244": {
      "repository_source_sha256": "dfe38ff1abef100aab1f91dc85220ab5e4e46b887b46feca9c3cf5885e260fbe",
      "en": "「Crush their head, and\\nthe victory is ours.」"
    },
    "272:2303": {
      "repository_source_sha256": "c0b42a8be54371936ee9af752defa84ca4e7a04a934d60ef4291ec7e8422556e",
      "en": "「Quite a tough-looking opponent!」"
    },
    "272:2344": {
      "repository_source_sha256": "c76a8c3bc82c955f8ba142f43189ae5fcabe7826c7f0c671a5cca3cda5d0510a",
      "en": "「Your days of throwing your weight\\naround end here!」"
    },
    "272:2393": {
      "repository_source_sha256": "ad20f13804d7309a9bb67470d73fe48968557221ae28a93d5a62f8b9c6e964a0",
      "en": "「$$サイデリアル$$!\\nGet off Earth this instant!」"
    },
    "272:2448": {
      "repository_source_sha256": "f855fafd13636b73d3d0391ce59238c3c103560409f19330d20fc8e75d2ea59c",
      "en": "「That arrogance... I dislike it...!」"
    },
    "272:2491": {
      "repository_source_sha256": "38728be1384aee770248f9c9ff879d2f0c71ac8493f5ae654db239230aa1b41f",
      "en": "「Now then, let's take back\\nwhat was taken from us!」"
    },
    "272:2540": {
      "repository_source_sha256": "37d704e553ff12cee4db56475cd2d8583c48b5b6c304219818ba7087e3193ec1",
      "en": "「Your treasure...\\nI shall take it from you!」"
    },
    "272:2589": {
      "repository_source_sha256": "9c849f5e3e0889516a5a83b8f2176794dbdaa5af28b2578007be7371461b60ea",
      "en": "「The power of this Sphere...!\\nI won't let you use it!」"
    },
    "272:2638": {
      "repository_source_sha256": "aa9f11c294f4e4febe70203aa819d55d515a1ffff6b8c4ad87b1f2f08cbebe92",
      "en": "「Think you can have your way with\\nhumanity? You're sorely mistaken!」"
    },
    "272:2695": {
      "repository_source_sha256": "5a54f92f8307d85071c35e3a4e31a42abf9255c4b931ab3ff5bd23075772bec2",
      "en": "「Playing at being a god...!\\nI loathe it to my core!」"
    },
    "272:2754": {
      "repository_source_sha256": "ede19aeec0705da2b47725d1bafe1d6bc6c61d51ca8a92a94c2c1d3e2dd6e712",
      "en": "「Behave like the servant you are\\nand stay quiet!」"
    },
    "272:2805": {
      "repository_source_sha256": "a85e24c9e632c4e034161975216d38e3b0dd8cf576b1af439cc3dfb7027b5518",
      "en": "「Small fry who can do nothing\\nwithout an $$御使い$$ backing them...!」"
    },
    "272:2860": {
      "repository_source_sha256": "fe63ef7fb30b83eeb32738f531a9dc3b81a8013808b5058b41018ef9fdef3429",
      "en": "「Regrets come too late!」"
    },
    "272:2885": {
      "repository_source_sha256": "fa8197a8ddfb07f5312dd956f87584eccf789338b6e5099f96836df846422fbb",
      "en": "「As you wish, I'll be your opponent!」"
    },
    "272:2926": {
      "repository_source_sha256": "2a414269da2d275a3669413c57572c6faca3b17f008fc1e612fe108894a4ffe0",
      "en": "「Time for your punishment!」"
    },
    "272:2953": {
      "repository_source_sha256": "0a525eaac618c2349e0e8af2da593bd58a355a6951c1b8d7e190458ca433d059",
      "en": "「Hehe, the prey is caught in my net.」"
    },
    "272:2990": {
      "repository_source_sha256": "8415570442dcd6472de57495c7cc771eea8a2dc098405eaa3c847bf89c8c3092",
      "en": "「Come now! I'll strike back too!」"
    },
    "272:3027": {
      "repository_source_sha256": "ad511b2224cc72c612bfb71c89e9d54dd3903b6f655ed614e6a0514bd18a2b93",
      "en": "「What a reckless fool we have here!」"
    },
    "272:3066": {
      "repository_source_sha256": "cae93ac381a6b89648e2623dad124aeeed32e8bf4ca446f04a03dcd1b48ed0b5",
      "en": "「I'll repay every hit you landed!」"
    },
    "272:3109": {
      "repository_source_sha256": "b3f3376f837b606b90be44c992b4f7bffcdf416511d720c0833f55ed5810f8fa",
      "en": "「Now it's my turn to come at you!」"
    },
    "272:3144": {
      "repository_source_sha256": "d148cd049b9a9a442794d4895d7bcf9cddc6a987166e36305cb6557c2069e6b1",
      "en": "「I won't take a beating quietly!」"
    },
    "272:3187": {
      "repository_source_sha256": "db46c989ca0db9cce8be0d6baea4bcd770850dd5b2a8427463232b595b1d8ffc",
      "en": "「I, $$ラケージ$$, will handle the rest.」"
    },
    "272:3222": {
      "repository_source_sha256": "2e6c5c11f833de11ca8e8c015e27e87633cacb19f59a09864255bbf480537550",
      "en": "「Pardon me for coming from behind.」"
    },
    "272:3247": {
      "repository_source_sha256": "20bef4380ce44904a5467fd6bc1a184220f1f1fd1d49b47058986e867ed72b03",
      "en": "「I might lend you a hand.」"
    },
    "272:3280": {
      "repository_source_sha256": "c785ebcd4360a80431bbfd6c5634116ab06a23bfd17736ada095f8edc1c1dd0a",
      "en": "「Troubling great pirate $$ラケージ$$, hm?」"
    },
    "272:3323": {
      "repository_source_sha256": "02d854afcc1e209c605e53d597caae33292f7a32717a762eff0178bceba35968",
      "en": "「My subordinate's mess...\\nI'll settle it myself.」"
    },
    "272:3370": {
      "repository_source_sha256": "e10da71865495b3a30ffd760fc2ab230aedc0529f9cb51656343bf53d6afeca5",
      "en": "「$$レド$$, do bring them down properly!」"
    },
    "272:3409": {
      "repository_source_sha256": "51a67149c0aa58d29ffd85f45ae882baac776f7f1d426dd7a9fa8a5e6790b1b5",
      "en": "「Your finish is sloppy, space boy!」"
    },
    "272:975": {
      "repository_source_sha256": "be19f66a39a25a66afbea6534546b982e4717cfb03fe74ec71bc9fca777a83c0",
      "en": "「Too bad,\\nit isn't over yet!」"
    },
    "272:1026": {
      "repository_source_sha256": "e14dc2ff15af009da6aa74a25cb8f2f2eaef0598cc5ab878def5bb33032afe21",
      "en": "「It's too soon to feel safe!」"
    },
    "272:3777": {
      "repository_source_sha256": "1bb33f4533904a9c13c02580a3fc7d61d4a0ccb6b831d9a83a36fbccbfab3df7",
      "en": "「Then, I'll go first!」"
    },
    "272:3796": {
      "repository_source_sha256": "825cb60ca0290d4cdac8a174d35c4520582e6805e9abfda8b4db85baad494b09",
      "en": "「Allow me to strike first!」"
    },
    "272:3835": {
      "repository_source_sha256": "0b1bae7d15ae9213ca10e62f5916019462fc0bb239302079343ee664e98cc360",
      "en": "「Forget harassing, I'll finish them!」"
    },
    "272:3876": {
      "repository_source_sha256": "88216c966618cfaa6938d248c23343aeedc98ade31cdae820e88d5fdd676dc0b",
      "en": "「Wouldn't I be enough by myself?」"
    },
    "272:3623": {
      "repository_source_sha256": "4866bfedb1aab532bd860edd7271f14294c42a00a5981fdd3755bc5f3706abf5",
      "en": "「Leave the enemies in front\\nto me!」"
    },
    "272:3674": {
      "repository_source_sha256": "c80f14e660609574423251fa8b5d350763769bb1a7972d87d4fbdbc2e94fcfbf",
      "en": "「I'd do that without being told!」"
    },
    "272:3707": {
      "repository_source_sha256": "5eed085ecc60bbea38eef527639467b8829e2b2dc2afe76292f17acb1281b9ea",
      "en": "「Unlucky for you to face me...」"
    },
    "272:3736": {
      "repository_source_sha256": "e6732d4088a631dd7874492c7a072c1d67777c9a14827ccf3b548efb9ce0bffb",
      "en": "「I shall be your opponent.」"
    },
    "272:6605": {
      "repository_source_sha256": "4fa19c5e4d45743a5aa7ae7d84a461cdbb558a63dcb6137d809b51420a0fca93",
      "en": "「I was beaten!? I, $$ラケージ$$!?」"
    },
    "272:6642": {
      "repository_source_sha256": "5344ad508d9245d14338a425572dcdf832a4bc0068c54e8eea63a3cbbfaba8bb",
      "en": "「How infuriating...!\\nTo think I'd come to this...!」"
    },
    "272:6691": {
      "repository_source_sha256": "52dce47218477a4876464e0c6620d995cabae84567462b559024bc3c54bc4957",
      "en": "「I've lost all face over this...!」"
    },
    "272:5652": {
      "repository_source_sha256": "f9ed765223b8e463b46c9ed08651d8f0e841c90042048a9985f6fa9ab2280a87",
      "en": "「Gah! What is that $$ユンボロ$$!?」"
    },
    "272:5687": {
      "repository_source_sha256": "44aab29ffa27398aa94075e0cf975e05cc62bfa1dbd03b7ac47a9109b003b746",
      "en": "「That $$ユンボロ$$...!\\nIt's no ordinary one!」"
    },
    "272:5738": {
      "repository_source_sha256": "ed6ca1c5b11dcbf6a6c7550b8a33cff5db06c9f1dea7777a9c8d6720618f110b",
      "en": "「These guys...!\\nThey don't fear $$ラケージ$$ one bit!」"
    },
    "272:5795": {
      "repository_source_sha256": "770ef744e6d3b3c97ddeab94ade30e2a637bcd9548f80e33d6dfc3cf3b648f65",
      "en": "「To think the outside world has\\nsuch a powerful $$ユンボロ$$...!」"
    },
    "272:5854": {
      "repository_source_sha256": "0e4988773a5ffed87ed4a754e7f4296c7d41b4f038c406c90de569739c24b0dc",
      "en": "「To think such a monster exists\\nin this world...!」"
    },
    "272:5905": {
      "repository_source_sha256": "dd6992aef19fb5c41ec8d84fc4ab25e1bf6c8d91ba6f82c15080a8536f5a5783",
      "en": "「I refuse to be destroyed\\nby the likes of you...!」"
    }
  },

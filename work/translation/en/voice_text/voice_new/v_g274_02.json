    },
    "274:11872": {
      "repository_source_sha256": "39e13a51ff2dce96d30e0ac9ea29b7e536005b570a701f69fc4b0ef0cbac7e23",
      "en": "「This thing...!\\nWay beyond any space monster before!」"
    },
    "274:11923": {
      "repository_source_sha256": "029415832e7e7df2c67f6449fe53cc92110defc9d72299670108a04ed620a0e2",
      "en": "「It's the $$変動重力源$$...\\nReal space monster power...!」"
    },
    "274:11972": {
      "repository_source_sha256": "5620d91b8829fd9aab15c7a169da0f4f309e76788977bbe55cc2addd3c906500",
      "en": "「I won't lose...!\\nFail to beat it and humanity's done!」"
    },
    "274:12031": {
      "repository_source_sha256": "ab06edc9fcd9693be1438fdbd65309a0a7c812efd89f8b830f4b48133e2cc814",
      "en": "「Uwaaaagh!」"
    },
    "274:12052": {
      "repository_source_sha256": "bfcecee2cd48f6eca8be6f17800c36a94f71ab531b5ab2ebaa210a2aa9698796",
      "en": "「Taking hits like this gets rough...!」"
    },
    "274:12091": {
      "repository_source_sha256": "e876dd7856ad8543b26c67652a09091426e4568578bfc949e590e458d4430f18",
      "en": "「I can take a few more hits, tops...!」"
    },
    "274:12128": {
      "repository_source_sha256": "b38bdb60e195e1dee4e2cde66ceec554faa31d3896a3448934052b6542bcc38b",
      "en": "「Bad situation or not,\\nI won't whine about it...!」"
    },
    "274:12183": {
      "repository_source_sha256": "541f5e37ad7fc40b06240f794f061bfe90e8dda283a95b50ca72e3e4142b4466",
      "en": "「I can't win unless I give it all...!」"
    },
    "274:12226": {
      "repository_source_sha256": "440418b6d872141f2a27be3598d3c4d754e3dd80f5d2e8cffe80034eb12fa3c4",
      "en": "「However tough $$ディスヌフ$$ is,\\nit can't take the next hit...!」"
    },
    "274:12283": {
      "repository_source_sha256": "708d25ff0a68cc9bb00bfb829ed20bf59db7708fccf2fde598049c0b342c6746",
      "en": "「I'm not going to lose like this!」"
    },
    "274:12316": {
      "repository_source_sha256": "4fce3e9e03d53443aeb2633529199bd80b72d1e1d7d53ba50f32efe61bba299d",
      "en": "「Damn...! It hit a bad spot!」"
    },
    "274:12355": {
      "repository_source_sha256": "f4f1de1acd3f8beb2e91d80a698072ed21199a4351176b0be4578065e1eba308",
      "en": "「I can't get overpowered here!」"
    },
    "274:12398": {
      "repository_source_sha256": "bdabaa4944b8eeebc75666246749064e5acc3914e9765ed04229beeec6643251",
      "en": "「What are you doing, $$ディスヌフ$$!\\nYou're getting sluggish!」"
    },
    "274:12449": {
      "repository_source_sha256": "9f211dbcae284ab9711af03832cf919bd4aa87ebe78ca6a6fc01aa0db3a3f08d",
      "en": "「$$トップレス$$ is power to save humanity!\\nNot in a place like this!」"
    },
    "274:12506": {
      "repository_source_sha256": "dda4472dee8cd75ff49746f6afa9e7faf5e4b7ab3ba81f40fc3c22796a1a50b2",
      "en": "「Sorry, $$ディスヌフ$$!\\nHold out just a little longer!」"
    },
    "274:12563": {
      "repository_source_sha256": "c8158189086854fd58eebf37e6786d5ed8726dbde51af83440a21468bd46d28a",
      "en": "「$$ディスヌフ$$...!\\nI'm entrusting my life to you!」"
    },
    "274:12614": {
      "repository_source_sha256": "d73906ae2374d5680ee99507bd5431b6e26075673ffa4f22b7a039e15c1e1976",
      "en": "「Never mind me, worry about yourself!」"
    },
    "274:12657": {
      "repository_source_sha256": "edaa91a9a0a9cf65a2686d5ce768c0bfc51c25a565e3298b28aa4991a90ebdab",
      "en": "「Watch me, $$ノノ$$...!\\nI will never go down!」"
    },
    "274:425": {
      "repository_source_sha256": "afbc825dfcc622ae54266b9b8defbc4e700750701549d323030b5a3e30560dd9",
      "en": "「It's okay!\\nBig Sis has $$ノノ$$ with her!」"
    },
    "274:478": {
      "repository_source_sha256": "92d2f608753b815b0f199973207ef29b8a87b821abc3b20281956cb8202315fe",
      "en": "「Big Siiis~!」"
    },
    "274:11247": {
      "repository_source_sha256": "0a1896aea248bef7956547da9e530a6155030b4370ebaf4e497f1a9da7cf1161",
      "en": "「Heh, looks like you can fight a bit.」"
    },
    "274:11278": {
      "repository_source_sha256": "90b07176e02e0b6ea76fd2bb3078e49907e305c5d99df4b6ce7da3f3e6b5a3a2",
      "en": "「This doesn't even count as a pinch.」"
    },
    "274:11315": {
      "repository_source_sha256": "f83c6dde2b062d653183e97f1a46a6af8d618ca82c28ff2e5a8587c87be0d58c",
      "en": "「No problem if I can keep fighting.」"
    },
    "274:11352": {
      "repository_source_sha256": "a2a6a50063930b15d02f933d01d3460b06a7918cdaa76bbb542d44418cab8d99",
      "en": "「I don't like fighting by\\nrelying on armor, though.」"
    },
    "274:11401": {
      "repository_source_sha256": "eea0c76c787091b30774118e5faf6064278210377c95c32e11aaf638d94db4ce",
      "en": "「Can't dodge? I'll take it head-on!」"
    },
    "274:11444": {
      "repository_source_sha256": "79f67a8132e2fc9a53b72db0712aeb97b4ca5d9b81b316d1e0904104896fdcaa",
      "en": "「Damn! I can't dodge it all!」"
    },
    "274:11477": {
      "repository_source_sha256": "b5958513967511efde4d87e8248a8a8425a83a92418309f4825164e45a2ffcce",
      "en": "「What's one more scar now?\\nIt's nothing!」"
    },
    "274:11532": {
      "repository_source_sha256": "3a4cb1ae046bb5dabc134dd9d113524a9bcf5b93df43982051114b9b694aae16",
      "en": "「I won't fight at your pace...!」"
    },
    "274:11573": {
      "repository_source_sha256": "ee9d9b0f44a12af8c8cb80e617d8a78f11804a278bc6fb0623eae3617bcc8505",
      "en": "「$$ディスヌフ$$! What are you doing!」"
    },
    "274:11606": {
      "repository_source_sha256": "7f657d190fc69ba2e77982998343f123de0b39a385bccbd602e7ea4dbadb5d75",
      "en": "「$$ディスヌフ$$...!\\nI need your power for a comeback!」"
    },
    "274:11665": {
      "repository_source_sha256": "5def220b3637dc4e0ca13695e2ac357c51e41ecb2a1785776755920a9c065411",
      "en": "「Not yet!\\nMy hard work and guts aren't gone!」"
    },
    "274:11716": {
      "repository_source_sha256": "ba72b3e791e9365bd3fec2254af8e468b95acad196e9d8315410cdaa519e0d3f",
      "en": "「Hey! Stop clinging to me, seriously!」"
    },
    "274:11751": {
      "repository_source_sha256": "c53685475a91b708c59360e28c6fda0a4f7ac880b54580d104bfb6b43dafe1e8",
      "en": "「I'm fine! Quit looking so worried!」"
    },
    "274:305": {
      "repository_source_sha256": "d65d5bead6db24aeb845384c804e0f17467796ab04c0b837af1934d1118039f2",
      "en": "「Gnngngh...!\\nI-I can't take any more!」"
    },
    "274:354": {
      "repository_source_sha256": "f758c791fe64f44f1596ea785633dba37d927079a888ade9d529f2d684e75929",
      "en": "「$$ディスヌフ$$ won't lose, because...!\\nIt's a battle-tested veteran!」"
    },
    "274:10383": {
      "repository_source_sha256": "1157fd595479df5ce6131678488648db239417f6be7ca7938f2e17eac071e57a",
      "en": "「Space monster attacks are like this.」"
    },
    "274:10424": {
      "repository_source_sha256": "1d43d82dcfa9fadf5403da52265b3877c522e14d9f4394ee2c0318328358aaa3",
      "en": "「After all, a $$バスターマシン$$ is\\nbuilt to defeat you...!」"
    },
    "274:10477": {
      "repository_source_sha256": "ed0a01819cadd91c966bd4879c734d0ccc5c02652b82883232f9f36bbbd778fe",
      "en": "「If it hasn't fully awakened yet...!」"
    },
    "274:10516": {
      "repository_source_sha256": "dc0ca21dbd59fbe70b8aa53722c85889a704c998d264706f72b4cbcd045c6958",
      "en": "「With $$ノノ$$ along, I can take on\\neven a $$変動重力源$$!」"
    },
    "274:10567": {
      "repository_source_sha256": "d85196d5301e3e7951f9d8ff816fd2c7d652487bd448779bc2b4de671e46b727",
      "en": "「Suicide run or not,\\n$$変動重力源$$ ends here!」"
    },
    "274:10802": {
      "repository_source_sha256": "d967d6854fe18387fdd0b87a62cbd78f7f7305a55735bc17c0c6d419733b4ad9",
      "en": "「Hmph, is that all?」"
    },
    "274:10825": {
      "repository_source_sha256": "de7c6e2ebd9aac3421bc22905e93df21178cff23b7cb421b764a0837d888856b",
      "en": "「You aren't playing games, are you?」"
    },
    "274:10862": {
      "repository_source_sha256": "c0af41cd0ec19c98bdab366187849bd93391e5ba9a5358ac631b190ac5a78b1a",
      "en": "「Can't you tell it's pointless?」"
    },
    "274:10899": {
      "repository_source_sha256": "034461d90c25c1ded31a2b363ea628666c2b8812eeb124248a1fab925812fb08",
      "en": "「What, I don't even need to dodge.」"
    },
    "274:10934": {
      "repository_source_sha256": "c2bd767a35555e61cae65bba97ed6702963c7c10ef43209a00df8cfa8cd80c14",
      "en": "「Don't worry about it,\\nI'm just stronger.」"
    },
    "274:10985": {
      "repository_source_sha256": "e792193a07868755251432c38068c4847f4ecc0446f579b51001904c59d67f5e",
      "en": "「Enemy must see the power gap by now.」"
    },
    "274:11024": {
      "repository_source_sha256": "fc0dd96c40c4a6e771bbcd72b88e29f611730a77d1118dfaaed07d7103c1826f",
      "en": "「You've got decent sense,\\nbut you can't fight like that.」"
    },
    "274:11073": {
      "repository_source_sha256": "3eb438c05d1621cbc08b0ebef4d2733bf3e9a6750f7f194fb6fe51b2d2392f10",
      "en": "「Why not quit wasting your time?」"
    },
    "274:11110": {
      "repository_source_sha256": "985b27cf5bbeea7672df7d9779fa6b7fad837a70ab16cdc78e4b4fa42018882d",
      "en": "「This body's scars aren't for show!」"
    },
    "274:11149": {
      "repository_source_sha256": "89923767791806e862475f137026d4944e2bf0b4938560d0285657ea76e04160",
      "en": "「You're in the way of my piloting!\\nGet that big butt and chest away!」"
    },
    "274:11206": {
      "repository_source_sha256": "41f791c33145805af96296004d42d7eba47adde2a55c564c159bcb9e4fe8acf0",
      "en": "「Wrong. It's because I'm piloting.」"
    },
    "274:10750": {
      "repository_source_sha256": "34507758db1d813cd791b2b835af1d2812f8c09e67b9b5694e684d31560203c5",
      "en": "「Buster Shield!」"
    },
    "274:10773": {
      "repository_source_sha256": "6fc32d56f22d09207217478fdea6d3f7033587202479b88313a4dd390768c1d1",
      "en": "「Guard up, $$ディスヌフ$$!」"
    },
    "274:183": {
      "repository_source_sha256": "c25ee126d7f7cbf61f34ef1ab8060bf5ef2f233f96f2483eb5057505295ecd44",
      "en": "「Big Sis, you're so cool!\\nI'm all fired up~!」"
    },
    "274:236": {
      "repository_source_sha256": "729589afdc97f37840b617547d622ff0c3693db8188820ab2783cc69b95a6419",
      "en": "「Wonderful! Just as expected!\\nBig Sis is $$ノノ$$'s #1 inspiration!」"
    },
    "274:9896": {
      "repository_source_sha256": "45c7122dff4433da350dfd6833a582b438d6c2cb14ac24ba8a30123a8168f3b3",
      "en": "「Monotonous moves are easy to read.」"
    },
    "274:9931": {
      "repository_source_sha256": "bfe725a87552bf48928ad5f1bec3bc9c2fe61a29b2fc83c95903b378e6da339e",
      "en": "「Seriously, I can't be bothered.」"
    },
    "274:9966": {
      "repository_source_sha256": "2f4f8c5996283328a5414a1a299aa58ee3a92c2b1f6c946e79eeee07501490b9",
      "en": "「Slowpoke's attacks won't hit me.」"
    },
    "274:10001": {
      "repository_source_sha256": "f4deb55dcec49016a6e868d7ea4b88ac4bcb3855f5d678016184430c7b9fd6be",
      "en": "「I see right through\\nwhat you're trying to do.」"
    },
    "274:10054": {
      "repository_source_sha256": "d088a6a77c8cd801455390588ba8a3197870bdd4ac99e1a9c7b59f24d2ad1ce8",
      "en": "「I'm not going to get hit by that.」"
    },
    "274:10093": {
      "repository_source_sha256": "f6cd2cb6d176712bc52286d6582122c49c1af2d2b7a4ab25ed3ea06ad2a07b05",
      "en": "「With that, you couldn't even\\nhit a Dumbatross.」"
    },
    "274:10144": {
      "repository_source_sha256": "4818309a554bfa582dd8a87e85848ac2c9ab360733114299740a23cdf5a20fb2",
      "en": "「This much is a given.」"
    },
    "274:10173": {
      "repository_source_sha256": "93c2968687eb77002b2d0961921363013e9c481e0fcdcb0d71cc4502bf4c85ed",
      "en": "「Looks like you're no match for me.」"
    },
    "274:10210": {
      "repository_source_sha256": "d9469ec04b19cbda7946c41ebab07ac4e798f992f055c28909b8d114e43dc193",
      "en": "「Give up. The skill gap's too big.」"
    },
    "274:10247": {
      "repository_source_sha256": "c2aafd903abe39f29dc855e7501fe3e5568dce174346895a2f75871bba51c5be",
      "en": "「This is hard work and guts!」"
    },
    "274:10272": {
      "repository_source_sha256": "13b53365f4fb861652fe9d759528977e72d27c43522319a6a8c6c6cfb96d280f",
      "en": "「Wow...! Degeneracy reactor power!」"
    },
    "274:10311": {
      "repository_source_sha256": "533b75565b22ced133ae56408b115bf7686f5b1d8a929af529f4abed27504833",
      "en": "「I get it, so just calm down a bit!」"
    },
    "274:10348": {
      "repository_source_sha256": "60b4c1fa0463249d38e90b569cc25f00b72ebbc51a306e9454fa4cd1ed832415",
      "en": "「S-stop it, it's embarrassing...!」"
    },
    "274:10618": {
      "repository_source_sha256": "d55a628525d7b3f78ae8d1be1fd47a6df73376ea0b4f68afb3125c15dc4571fc",
      "en": "「Pointless! That did nothing!」"
    },
    "274:10643": {
      "repository_source_sha256": "cea6125ce1151ea5deb0170c472e9036d25030326fb9b4a5cc211b8904690c3e",
      "en": "「It's pointless to even attack!」"
    },
    "274:10672": {
      "repository_source_sha256": "36b62f4d9b93477091d34f4bbb2f3ebea729c8388b17b50f7ae6a1deaf9590c6",
      "en": "「This is the Inertial Canceller!」"
    },
    "274:10711": {
      "repository_source_sha256": "ada261ed4973bc517360004a0b95288b021c0d6b448214c3a2938c9f1887871a",
      "en": "「This is $$バスターマシン１９号$$ power!」"
    },
    "274:12927": {
      "repository_source_sha256": "d0c5dd969eebb5999d5bfec7c9202239e2cbadd50569be067afa91e51b8e057c",
      "en": "「Strength isn't about body size! It's the power of the heart! Right, $$ノノ$$! That's! Hard work and guts!」"
    },
    "274:13031": {
      "repository_source_sha256": "31af61ce0e0fdde185720392f27335ff70b8f4d5f1cadc64f179ae4f21f5640a",
      "en": "「You use $$Ｚチップ$$ to grow the $$Ｚクリスタル$$. Depending on its stage, the whole team receives various effects.」"
    },
    "274:13130": {
      "repository_source_sha256": "70beb1374990330a824255c1f09a487c81859cc1d1ab6129390a0509d500cac9",
      "en": "「...Well, leaving the Dumbatross and her ambitions aside, it seems the growth of the $$Ｚクリスタル$$ has other important meanings too.」"
    },
    "274:13233": {
      "repository_source_sha256": "4f9da67d3a04cac0bd5e1ce97858b8af2a8f5ab512b9c47689082d23976d0ded",
      "en": "「So that's how it is, so you'd do well to grow it as soon as you can. Well then, see you again...」"
    },
    "274:13310": {
      "repository_source_sha256": "fc6827743b6f8be95ae8cf1755c5b8c3657ba8970ded437f1d42c14c0781a75e",
      "en": "「W-what?」"
    },
    "274:13325": {
      "repository_source_sha256": "85dda87ef3f7d2df1bd67af87a49c43519038025027a1974a979d293ef73dc15",
      "en": "「Only me...? In that case...」"
    },
    "274:13352": {
      "repository_source_sha256": "ac350565361171ed33248819ddd9d5a3f9ecc9ad691518c9042cb0ae5a2ec2ec",
      "en": "「W-why do you pick SRW over me!? Idiot! $$ニコラ$$, you stupid jeeeerk!」"
    }
  },

{
  "schema": 1,
  "rows": {
    "275:12024": {
      "repository_source_sha256": "8816322b05f213b17fc6c08622888e0af28a451a697ff16e17c554931f030bb5",
      "en": "「Since you turned on us,\\nI'll just punch you for real!」"
    },
    "275:12075": {
      "repository_source_sha256": "6a3e565a2ef88b9239f3c6357a653cda8f28f30c14c9d88141cbd0195c726736",
      "en": "「As you well know,\\nI'm a man who shows no mercy!」"
    },
    "275:12126": {
      "repository_source_sha256": "d213bf9f8dcb7bcc801abb0502defa14f5ec47196337cc3d2174335b0585669b",
      "en": "「Every big hulk has a weak spot!」"
    },
    "275:12169": {
      "repository_source_sha256": "91518d430f713913263cbadbe401eba9d28291c92c088bb7e15c63600c040124",
      "en": "「If I got scared of a big opponent,\\n$$ザ・ヒート$$ would be a name in tears!」"
    },
    "275:12238": {
      "repository_source_sha256": "c97592be83dd8eb82614f02662afcd3832195be58ed6deb1774b84b2be6a158c",
      "en": "「Battleship or not, I'll punch it!」"
    },
    "275:12267": {
      "repository_source_sha256": "eb71f2786bbff654e4e62fafd18c9bd30a3062e88ff284c7f8ccac93c57974eb",
      "en": "「Scrapping a battleship is a cinch!」"
    },
    "275:12304": {
      "repository_source_sha256": "f70116ba088e0592b13f2d69d82000adfaebd83f82aa5ecf90c82084298e59a3",
      "en": "「Can I trust someone\\nwho splits hairs like that?!」"
    },
    "275:12355": {
      "repository_source_sha256": "3c20485be6fcd05369fb9077d58acf960f7e4b7d321df28518d1d390482c2531",
      "en": "「My gut is telling me so!\\nYou're a bad guy!」"
    },
    "275:12404": {
      "repository_source_sha256": "78c05a1a47c59c9baedf299ff0889b36ce13aa0ff726e033a53ffdaa8a66e6d4",
      "en": "「It's a contest of strength!\\nIf you lose, give up clean!」"
    },
    "275:12459": {
      "repository_source_sha256": "e7dcefa6ca776c6afbe7f7daffde46678132ab49963d2e5c548ef4a02e0dd239",
      "en": "「Anyone who forces others to obey\\nis a bad guy, period!」"
    },
    "275:12520": {
      "repository_source_sha256": "7c2a64af85b62cd15a0f8984ebcf08e5df6692c205725bd1bbe11e399ff9fe0e",
      "en": "「Barging into somebody else's\\nplanet with your boots on...!」"
    },
    "275:12573": {
      "repository_source_sha256": "923a5e7ca4187ad5e522d3e3bd3e492097d685586ca895842bd603f22538999e",
      "en": "「Get ready for it, $$サイデリアル$$!」"
    },
    "275:12608": {
      "repository_source_sha256": "3725469c701dc93a89d502242bd03b0ff3c901f0f560b839644ce34131deecf7",
      "en": "「Time to turn tail and run,\\n$$サイデリアル$$!」"
    },
    "275:12669": {
      "repository_source_sha256": "23700aa582b07fe10635c00260c5e67ed7d330fea01160973efefa4570feff6b",
      "en": "「I show invaders no mercy!」"
    },
    "275:12706": {
      "repository_source_sha256": "c6b96c8b7854beb945e61921eb2f7fbd342dc34933e76b01e7bbc31e5f9ea61d",
      "en": "「Ready for this, old man?!」"
    },
    "275:12745": {
      "repository_source_sha256": "eac04dceb2fbdf47c72a041730560365346c46a79dc4314a2256b8ec30325eb7",
      "en": "「You'll pay for tricking us,\\nold man!」"
    },
    "275:12798": {
      "repository_source_sha256": "c687d6ba5fd4379609d3081cf52743adb3d427a584337e9946c456d57ea293ad",
      "en": "「$$クラヴィア$$!\\nIf you won't stop...!」"
    },
    "275:12847": {
      "repository_source_sha256": "46f6665ac70b95376ad4c7c0548c8d7aea60b7c99523ea2531f178af3264f9a6",
      "en": "「Spit out all that hatred,\\n$$クラヴィア$$!」"
    },
    "275:12896": {
      "repository_source_sha256": "47ee0c7116b1e50654e67106dd21cd00c536313ce64e27e1e6f4f257c9129f91",
      "en": "「Sick and tired of your dirty hands,\\n$$ギルター$$!」"
    },
    "275:12949": {
      "repository_source_sha256": "471bb284ea5725089cad90df2b54c142d0b8c6b35a97c98d13e90ae0df462e67",
      "en": "「I won't forgive you, $$ギルター$$,\\neven if you apologize!」"
    },
    "275:13002": {
      "repository_source_sha256": "5cc41d53582257aded4f741437d46a25dceab6ac124091e4f8e4ed248161a2b1",
      "en": "「Hey, you!\\nPlease, stop taking it out on me!」"
    },
    "275:13061": {
      "repository_source_sha256": "83b0c7ef1eb2a340987d94d5306bc2bdbf3d0c807a4e8636a654b90692700993",
      "en": "「Why, you...\\nare you this whiny only with me?!」"
    },
    "275:13124": {
      "repository_source_sha256": "ae097811ddffffbebe351c5af63c320c80ccc650ec59f8c89005e15baf1cbd26",
      "en": "「Like I'd give you my $$ガンレオン$$!」"
    },
    "275:13163": {
      "repository_source_sha256": "d6d73caeb704717cdcac47ce0c92e301e7f69213615b7a16cc7146c9f57f15aa",
      "en": "「Drawn by the $$スフィア$$,\\nsome real pains showed up!」"
    },
    "275:13214": {
      "repository_source_sha256": "9ebc02fddffc2dd1ca0290c0630f2bbaf9f8a392c3745049409aa1ad3986f853",
      "en": "「If you want a fight over the $$スフィア$$,\\nI'll take you on!」"
    },
    "275:13273": {
      "repository_source_sha256": "f688f655a4260da858ad20c5335440f3ae731868d420ebd45eae3c2bcf94c17a",
      "en": "「Enough with the hate, hate, hate,\\n$$バルビエル$$!」"
    },
    "275:13320": {
      "repository_source_sha256": "14c5128d40d2d22a1cb7fafe6feb926989a9f97e69d5cfc1f95dc20314f7f5f6",
      "en": "「$$バルビエル$$!\\nI'll give that gloomy face a punch!」"
    },
    "275:13381": {
      "repository_source_sha256": "c956228135c2c301157e251a60e96020247abe8cb763506ee44cb61d4679c7a8",
      "en": "「No way, no way!\\nPeople ought to live with a smile!」"
    },
    "275:13432": {
      "repository_source_sha256": "b203470d706a110bed450b8f62aaddc8caf45871cf81e23aa265c48b1cab2567",
      "en": "「$$尸空#pilot$$! My Heat Smile will\\nburn away your darkness!」"
    },
    "275:13493": {
      "repository_source_sha256": "6e77e4010c97f1fd3d428134a4b19672a95edc3d56c2943f860c1959261a6957",
      "en": "「It's a head-on power fight with you!」"
    },
    "275:13532": {
      "repository_source_sha256": "63cac8cf0c4b66b1bf8b54ef06d432f8fcc62168e279c3cda460125402affef2",
      "en": "「If we weren't enemies,\\nwe could've had fun together!」"
    },
    "275:13595": {
      "repository_source_sha256": "e42ea58c520bba054bddec126a7ce2202a41e4a1d4ca67657f27c8bd7683ac4c",
      "en": "「Let's go head-on, $$エルーナルーナ$$!」"
    },
    "275:13630": {
      "repository_source_sha256": "ad2b4161b5edec4f6c929d77bc323c4b1c11137f4d743f35f44b352f808466d1",
      "en": "「If it's a power contest you want,\\nI'll give you more than enough!」"
    },
    "275:13695": {
      "repository_source_sha256": "c586c56c0ee3add83903e497359940f91a24f1a50545a9b4bdd448e55467dce1",
      "en": "「Duel me, Your Majesty the Emperor!」"
    },
    "275:13726": {
      "repository_source_sha256": "2f7266a308b0d878e750fcc92525595743a33e06ce39c49bcc6361f942eda080",
      "en": "「I'll crush you and end the Empire!」"
    },
    "275:13769": {
      "repository_source_sha256": "1d376fc89446f66d381d6b32fcc560b6cb8c0fd404afc89a0934029b36d09be9",
      "en": "「Four $$スフィア$$ or $$次元将$$,\\nI can't afford to lose!」"
    },
    "275:13838": {
      "repository_source_sha256": "16ba50b0b5d5bbf852e06d2d08e53bea83447d3c8cc8dc728bb156fbaee4f6a8",
      "en": "「You're persistent, $$アサキム$$!」"
    },
    "275:13869": {
      "repository_source_sha256": "f9768d9e416090102c08e9fb1214635de3d7d3eef5e9a4b781d2982a04852e30",
      "en": "「$$アサキム$$! If you're set on fighting,\\nI'll take you on!」"
    },
    "275:13930": {
      "repository_source_sha256": "dbc1f8a1d2e22ed812b116d865578ff562f65c198410d32b405c8c702ee53b98",
      "en": "「Let's end this, $$アサキム$$!\\nIf that's what you want!」"
    },
    "275:13991": {
      "repository_source_sha256": "d15e71aadc47b965e12553cc8a308b4bb25f77e377c82102d875f66cee3cb3bf",
      "en": "「Just how different are you and I\\nfrom you lot?!」"
    },
    "275:14044": {
      "repository_source_sha256": "43c98396778d8986a40cbef132bb54c1dc40784db7f570e7d1bca91c569d9a97",
      "en": "「So the $$御使い$$'s lackeys showed up!」"
    },
    "275:14077": {
      "repository_source_sha256": "6f976f0fbaf40a3081ebb1edb6e8c609ce919144617f0a057ac4f6eccda1d23d",
      "en": "「Don't think the big shots\\nget everything their way!」"
    },
    "275:14140": {
      "repository_source_sha256": "80aa26bb3f80fc3e122cc0b25998e4b12fef37aab051f204009bfd5727c47f01",
      "en": "「Like I care about your convenience!\\nWe're alive!」"
    },
    "275:14201": {
      "repository_source_sha256": "e82fd5b5c2341b00a0ed2b22bd2647d87211783ea5d9d251d71e1500dbad53a5",
      "en": "「You hardhead!\\nEnough is enough!」"
    },
    "275:14252": {
      "repository_source_sha256": "97ea6c4ac6309e174646c3918a908a8a4165b21640ec210c85998d6d6d6b1b51",
      "en": "「I'm warning you!\\nI'm pretty damn furious myself!」"
    },
    "275:14307": {
      "repository_source_sha256": "cc9bd58017ee2e8d4c804953d9f726a77a6981d7ddc198489367f32077495b55",
      "en": "「Little girl who's playing games,\\nget out of the way!」"
    },
    "275:14364": {
      "repository_source_sha256": "4e5273e155f2ddd890eb4f1f5e85bb73e6702cda3d108f2cd8d3efc45195761f",
      "en": "「Taking lives just for fun?\\nYou're one outrageous piece of work!」"
    },
    "275:14421": {
      "repository_source_sha256": "146d77c7466fde48d0cb606be48e2c2e0d2e0d9fa6e9b98ac2d9936e3d7a7e3a",
      "en": "「I never thought you'd be someone\\nwho takes people's lives with joy!」"
    },
    "275:14486": {
      "repository_source_sha256": "6221aead59b7f21892eca66601460f6ee366bdfd951cd686785b642357baace9",
      "en": "「$$アドヴェント#pilot$$! With a refreshing smile,\\nyou do some outrageous things!」"
    },
    "275:14557": {
      "repository_source_sha256": "3eae976573d86ac4c702314510866de8660133119d0d1be4787bd0f5699d477d",
      "en": "「$$アドヴェント#pilot$$!\\nI'll straighten out your attitude!」"
    },
    "275:14614": {
      "repository_source_sha256": "ed367927c61d04be2e4a0f0924630826bd30b9eb708afe7ce808dd9f0263d16d",
      "en": "「Sorry, $$アドヴェント#pilot$$! Neither we nor\\nthe universe plan to end here!」"
    },
    "275:17189": {
      "repository_source_sha256": "348907a761763e8abd2a7d03671fb0da599239487b915792409987bb4b1177e0",
      "en": "「Let's do it, Gun-Gun Mode!」"
    },
    "275:17220": {
      "repository_source_sha256": "4687de186e5b45ed593581bafbdc20b6389092a86de93287e65891ed534b9a02",
      "en": "「Get fired up, $$メール$$! Full power!」"
    },
    "275:17263": {
      "repository_source_sha256": "2013239d4d3d2ef7e1446c1c6383e569db6a8692484b75dfbf25fc2fd1f65d4b",
      "en": "「If you come at us, I show no mercy!」"
    },
    "275:17298": {
      "repository_source_sha256": "172e0600a99985823b15d25672b1c3b35f2729ea56504676682460325926c70e",
      "en": "「You got it! Look forward to it!」"
    },
    "275:17325": {
      "repository_source_sha256": "e296301ae77b883e522f10705926b35f776ad113dcf00f2cd783da5d069f8b19",
      "en": "「Makes it sound like we're broke!」"
    },
    "275:17368": {
      "repository_source_sha256": "7ddebc98146b5dc37cdd64e9e2f6c4e53e6b455fe8f9b0cd5deabd02a1115c74",
      "en": "「Work hard and the food\\nand beer taste great!」"
    },
    "275:17421": {
      "repository_source_sha256": "2b93e1084159b074c1db908c23b134c8a7e1014b49b25fea91ec5db7d4d5dbe1",
      "en": "「Here they come, $$メール$$! It's $$サイデリアル$$!」"
    },
    "275:17460": {
      "repository_source_sha256": "98ad2826a498ee0d2567fbad9c41c3e37910ac3d0d8edab51f07e7d6c44f8bfa",
      "en": "「Don't expect forgiveness, old man!」"
    },
    "275:17501": {
      "repository_source_sha256": "e1ec74537f4c63e9b9d00044d644c3c4e638493d01944276ad0d282ba062b857",
      "en": "「No good, $$メール$$!\\nWe have to stop him by force!」"
    },
    "275:17552": {
      "repository_source_sha256": "dd6b02e8d132bb1382e2371b655779247357d50a8bb375da5fbdef6c19815122",
      "en": "「You...\\nyou clash with guys like that...」"
    },
    "275:17601": {
      "repository_source_sha256": "d5a53255b83c010b6aee57c253ccdbcfd25492b3b187f898bcb97a13cb17ad86",
      "en": "「$$メール$$!\\nShake off every regret and memory!」"
    },
    "275:18204": {
      "repository_source_sha256": "55a1c9cdd472f0c4a4ae7f2d5b100913ad8a0548867f0b4d20a8b5d62d996c10",
      "en": "「With all of $$ビーター・サービス$$'s might,\\nI'll get past you!」"
    },
    "275:19945": {
      "repository_source_sha256": "df15d513c50a052a354d83316086c2a0ac137320723e659b245ccd9ece276727",
      "en": "「I told you it's Magna Mode,\\nDarling!」"
    },
    "275:19998": {
      "repository_source_sha256": "aca77bcec202e2a9ef7cd3b91ed23c15650664faff8527efa043fecff6eed1cb",
      "en": "「OK! Same as always, Darling!」"
    },
    "275:20037": {
      "repository_source_sha256": "2481c0b2ee0a8980a65b30b6c0e06711e80c884542d176d009dda792b0edc45c",
      "en": "「Careful not to overdo it, Darling!」"
    },
    "275:20070": {
      "repository_source_sha256": "a96a767193e783b933d33064a480b410ec1f8c9c7c9dadd5543312408b7e3d83",
      "en": "「Darling! Show me something cool!」"
    },
    "275:20109": {
      "repository_source_sha256": "cf30e8e71d09452ea764ccf7ef517db0d7a562356aea8a5bf4802d9b5a75c9e4",
      "en": "「Ram them as a fireball, $$ガンレオン$$!」"
    },
    "275:20150": {
      "repository_source_sha256": "775eccb0cd1baef33f7b61dfcfb818c72b837b555d63dc46ca9be5eb1ef0b09b",
      "en": "「Full of energy again today, $$ガンレオン$$!」"
    },
    "275:20181": {
      "repository_source_sha256": "10feac9a8dfda79bf621dcc939b34644f86e03c34ffc3afacd510625e724d0d7",
      "en": "「We're seriously angry, you know!」"
    },
    "275:20222": {
      "repository_source_sha256": "23c776210a2fe814efa7730bcffd4592d3b32d64c2af85ace5de46661dbd5de5",
      "en": "「Please stop, $$クラヴィア$$!」"
    },
    "275:20257": {
      "repository_source_sha256": "412acfd00a45b8b344157f99c4e03a7b92e285aff352c755159eab79aaeabf27",
      "en": "「Stay away from Darling, Holstein!」"
    },
    "275:20296": {
      "repository_source_sha256": "62952476382981307ee2bbf37072004ca3e1e9d0626da4a3c5a0d253f26d8c33",
      "en": "「$$アサキム$$!」"
    },
    "275:20779": {
      "repository_source_sha256": "58b842bff23285c2d8e8f69747caf515cdb6eef22a5c6ec027bca6d9a6f6ff44",
      "en": "「Let's fight, $$アドヴェント#pilot$$!」"
    },
    "275:14689": {
      "repository_source_sha256": "6ef28e92f070ddb976a1d03b5ab0a779446d0a16db2f3c7954992a4c73230221",
      "en": "「I'll chase you to the ends of hell!」"
    },
    "275:14726": {
      "repository_source_sha256": "bbdf6b6f9bcd720594c9ecddd4f10011852e0b6c4df438488c0f54f64a337d01",
      "en": "「I'll hammer it into your bones\\nthat running is pointless!」"
    },
    "275:14777": {
      "repository_source_sha256": "5083d0ff0f578f2016c413d2e159b5609623bd3a24237541365d9be4793dbab7",
      "en": "「Hold it right there, damn it!」"
    },
    "275:17650": {
      "repository_source_sha256": "78fc539c221cb8130d9321a2d3d27cf691c48201ac811818e8680489642a3edd",
      "en": "「Wrong way, wrong way!」"
    },
    "275:17665": {
      "repository_source_sha256": "9edf28bc185844f420e1bd6d26c839cd5bd1f8ac92c4ef5bf9b3a7103c9dc608",
      "en": "「Let's chase them, $$メール$$!」"
    },
    "275:20311": {
      "repository_source_sha256": "d210060433fb2bb800bd5bf3322e807f3d50c06f3c81219f8716046649a627e2",
      "en": "「After a chance comes a pinch,\\nDarling!」"
    }

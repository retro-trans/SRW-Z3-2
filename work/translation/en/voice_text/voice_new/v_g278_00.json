{
  "schema": 1,
  "rows": {
    "278:345": {
      "repository_source_sha256": "5e51c45b3eaa8d60de5531dc0dbb368ce98d91d3582b7428de4bf03a9cc5815f",
      "en": "「$$リディ・マーセナス$$,\\ncommencing combat!」"
    },
    "278:398": {
      "repository_source_sha256": "ad8dcdc120fa1b31bbc5f8143ff33a24adea4d2386d0e13a9f25f573b2aade56",
      "en": "「I bet on human possibility too...!」"
    },
    "278:429": {
      "repository_source_sha256": "aa378101fd5b9460e7702f8fa822c8a0f89e9f57b182f10a87782f5567ddde71",
      "en": "「I won't lose! Not to the word\\n$$ニュータイプ$$, and not to myself...!」"
    },
    "278:496": {
      "repository_source_sha256": "a212168861ff41ec387cf7ab428c99857f107c2970132076b0419b584dcc03fb",
      "en": "「I'll find how to change now, too...!」"
    },
    "278:539": {
      "repository_source_sha256": "ebd1c4deee54e2cd00e1c4962cf31eccea5b326ec21eb432d7b42f1ae985d251",
      "en": "「I'm done running from my fate...!」"
    },
    "278:582": {
      "repository_source_sha256": "101e69f01396849e267e894dc53a0048f40982d15424c7b7ac2dcdc07271fc54",
      "en": "「The light she showed me...\\nI won't waste it...!」"
    },
    "278:631": {
      "repository_source_sha256": "684e322039aee47eea9a7244a0e5038241676718d39e8ca59df9033581dd9985",
      "en": "「To never repeat the same mistake,\\nI...!」"
    },
    "278:1418": {
      "repository_source_sha256": "ecb5c7e51ea634fb2e993a80c63b71284c7cc73845e51c13b26629e4c61ec1b5",
      "en": "「You doubt human possibility, yet\\nyou're the vessel of its consensus!?」"
    },
    "278:1475": {
      "repository_source_sha256": "b2af5044d10b9dab9bfdcc3fe586ba79fd52cfaf5cfe738b6b3858aa39e9352e",
      "en": "「$$フル・フロンタル$$,\\nI'll pay for your karma!」"
    },
    "278:1530": {
      "repository_source_sha256": "48644b6a924a8485a939f7ce5480d3eebd74927e09437952b5e73a2451a2bc7d",
      "en": "「You'd snuff out the light in hearts?\\nWe'll stop you!」"
    },
    "278:1587": {
      "repository_source_sha256": "bda3372b6a5500002d9ebd434ed114b6a880923838d3104234d31334e9b20e9c",
      "en": "「Spit out what's under that mask,\\n$$フル・フロンタル$$!」"
    },
    "278:1650": {
      "repository_source_sha256": "a339280fc185ceaab894d967ef4cef25346ff98c82181049ce0879aa5779a692",
      "en": "「$$袖付き$$' guard captain never learns!」"
    },
    "278:1687": {
      "repository_source_sha256": "7048f98a4c1e537dcbdc70e9339b88f64c136f437b49f92ca718b1a0fa8ed5bd",
      "en": "「That blind faith is dangerous!\\nThat's why I have to stop you!」"
    },
    "278:1748": {
      "repository_source_sha256": "3cf0b24c61522fb65810bc6fca0eeb25a432af658307e29d0bcd95f3c4f4fe45",
      "en": "「Even if $$フロンタル$$'s aide shows up!」"
    },
    "278:1789": {
      "repository_source_sha256": "043c7b03a2f57744730b588a4cddc55f77c8136d3f6f7b88fee00826d4de0e22",
      "en": "「I won't hand the Box to $$ネオ・ジオン$$!」"
    },
    "278:1826": {
      "repository_source_sha256": "2d2429b9e1cd0a309306f7002765505d7e6447c588061c6f0ad5372f3ff359c6",
      "en": "「$$ハマーン・カーン$$, this can't be what\\nyou're supposed to be doing!」"
    },
    "278:1895": {
      "repository_source_sha256": "57a6422e3246e10e493b9b94b6110b317cd44bef44a0c25aaf7572c28c102f75",
      "en": "「I can't let you\\nhead for Earth!」"
    },
    "278:1946": {
      "repository_source_sha256": "d9a860740e28228633184da9b017ad947aa62659c7940df079822f2da7b59b7a",
      "en": "「We'll buy the time until the talks!」"
    },
    "278:1979": {
      "repository_source_sha256": "691ef82bdec7d452cfa7f3d565d2b2b43d15ec85eb76a0debc4bd689b380b8af",
      "en": "「Hate me if you want. But for now...!」"
    },
    "278:2014": {
      "repository_source_sha256": "c4cfd82e77402d8d32a0a9cb7325f116714f5647ff126d2ac4c92f2a7247ca63",
      "en": "「I won't let $$サイデリアル$$ throw\\ntheir weight around forever!」"
    },
    "278:2069": {
      "repository_source_sha256": "fed31e62aa3a15d7bf907157939cda1c8af0a20923aad340a58b2c259c02a85f",
      "en": "「If you took it by force,\\nwe'll take it back by force!」"
    },
    "278:2132": {
      "repository_source_sha256": "a3a463638a537d1390c3168ae097759f9a1617b8ccee294328e0d2b45f993d78",
      "en": "「Reactor or not, I'm not afraid...!」"
    },
    "278:2171": {
      "repository_source_sha256": "24ce380068f38c0fe67668fc6115db31ca8cf7193bf530cbf7a8f1ab883ff115",
      "en": "「$$スフィア$$ power over events...!\\nCan't drop my guard for a second!」"
    },
    "278:2230": {
      "repository_source_sha256": "bc405f63d58f695cdfb8e2ba1a346654a850314a56160b6b9645d3b4f88a2b73",
      "en": "「$$皇帝アウストラリス$$!\\nA defeated general suits you!」"
    },
    "278:2289": {
      "repository_source_sha256": "20370aa8b5bbf4ce53c16dba804a3d5dee21ba2ea667d6123e2616b55a931d60",
      "en": "「Even if the key to lifting the curse\\nis with us, we won't hand it over!」"
    },
    "278:2356": {
      "repository_source_sha256": "57adae464bb141a3fb7d91bc31dbb665ae592a572b2d4d5f4e4ac913f38f916d",
      "en": "「I won't lose to a man who does\\nnothing but curse his fate!」"
    },
    "278:2405": {
      "repository_source_sha256": "d64c6fc99622027197b3c333a5fcba90752a29e086cb34bc91f73a7cf8008669",
      "en": "「You warped the fate of Earthlings\\nand my family... You, above all...!」"
    },
    "278:2468": {
      "repository_source_sha256": "b9e20b09413c3b53655f2682c565f2ca577e70ca862cc990f747d5f9a6ecde88",
      "en": "「Today's humanity has no need for\\nintervention by emissaries of God!」"
    },
    "278:2523": {
      "repository_source_sha256": "707e089e6ecd7e15aaf8609d04fb06a5046c029969d1709af4608dac9e85a737",
      "en": "「I have no right to blame you...!\\nBut I can't let you go, either!」"
    },
    "278:2596": {
      "repository_source_sha256": "232ad805e3767a2060517b345b36f7f9075fa9b0ba5b93c7f99e7e8641e7aa7c",
      "en": "「$$アドヴェント#pilot$$!\\nYou'll tell us all your schemes!」"
    },
    "278:2649": {
      "repository_source_sha256": "61ba731607656a5dfb8588daf2e6e21210eae831111a2e874bccd51289b760f8",
      "en": "「You won't take the path we trust...\\nOr a future full of possibility!」"
    },
    "278:2720": {
      "repository_source_sha256": "538d38dab0c66b13632e8780a0bfb3dbdf87b0984c3dfb9f88f05ddf496cb51f",
      "en": "「$$アドヴェント#pilot$$!\\nBehold our light of possibility!」"
    },
    "278:2775": {
      "repository_source_sha256": "61adc7aea42a1bbefcff7aff39d4a4a7d5797f56cedbdc2ffe7f7817de0e5a7c",
      "en": "「No one else gives you a future.\\nYou carve it out yourself!」"
    },
    "278:2842": {
      "repository_source_sha256": "d28db5cb743a33d109e967745af2b4d51e65c7eb4ee0fbbe5b3b23e40bf1e0f2",
      "en": "「I won't lose to a pet\\ntamed by the $$御使い$$...!」"
    },
    "278:3982": {
      "repository_source_sha256": "dcb8a04542093e680173d2dc8105f7a7107f83653b265a2197377256b3f7cc12",
      "en": "「Now it's your turn to play along!」"
    },
    "278:4017": {
      "repository_source_sha256": "b52bab7aed1f807746bda636a8109c0d5ea66a8e17681e5445ad09b2a6a8019e",
      "en": "「Showing where you are was a mistake!」"
    },
    "278:4054": {
      "repository_source_sha256": "756fd051c6509c648c2ace2216470bfc030b7d5632205ba6d1805387137698e7",
      "en": "「Like I'll let you just get away!」"
    },
    "278:4079": {
      "repository_source_sha256": "6cd83eb97048954f8521bf7b8f0720752d659c747e2e8e3f7b1a437a5d63e2af",
      "en": "「I can't let it end with me beaten!」"
    },
    "278:4116": {
      "repository_source_sha256": "be413b2d7311f696231efbcbb79cbe7ca1bec6d6382782b6dbacdf312cf1820b",
      "en": "「If I can strike back...!」"
    },
    "278:4141": {
      "repository_source_sha256": "d50b5a30752a5cdc034e18e25e94e8434e30c142b4ae3c7ecdb72bec77ae356b",
      "en": "「I'll catch up to you...!」"
    },
    "278:4168": {
      "repository_source_sha256": "e70a41cf58fae687d61f1603c6489ca137f7b40f5f661beea036c5521ad0c975",
      "en": "「This is $$リディ$$! Supporting you!」"
    },
    "278:4203": {
      "repository_source_sha256": "46ef89ab7acf86e60608d11780a8cc35cf56f88d42825104c3533701018fb0a3",
      "en": "「The attack isn't over yet!」"
    },
    "278:4236": {
      "repository_source_sha256": "7c157ab1bfb2ddfd53033c54ad68e6e0e30ef9be83a866093fc6f1f61f2048fd",
      "en": "「I'll fight too, $$バナージ$$!」"
    },
    "278:4263": {
      "repository_source_sha256": "1d7ed5d197b707f29610e7de5bf7799681a4c41ef46e20f3a3d629521927d3ec",
      "en": "「Let me follow you, $$マリーダ・クルス$$!」"
    },
    "278:4304": {
      "repository_source_sha256": "867e2f8bbf92c1b41de6dbef08958eca88504f4f7200cd3c0c6613ffe7d70bcc",
      "en": "「Coordinating with the $$トライスター$$...!」"
    },
    "278:4335": {
      "repository_source_sha256": "d8b7f125f0f32f90285a7312cd1ca958b8208151c15c57a38dfa589bdb24e3bf",
      "en": "「Distracted by the $$ガランシェール$$ squad!」"
    },
    "278:4374": {
      "repository_source_sha256": "2e665449c9d8bf2eca2dfac07d1932d441f037f5be63b11783a040e1331bd09b",
      "en": "「Now I understand...!\\nWhat it means to sync up!」"
    },
    "278:1356": {
      "repository_source_sha256": "ecab18cfdf7666dac00364dd25662b3b786ba3bb10a9eb3bfc221fcd65ebe63b",
      "en": "「Think I'd miss that opening!?」"
    },
    "278:1387": {
      "repository_source_sha256": "9801cc52be231b17dae879b2014940b44217932236fff0d0ec272c6af311b947",
      "en": "「Here's another strike for you!」"
    },
    "278:4786": {
      "repository_source_sha256": "66b4760834290f68f496db6c3036495c2eb9d99524b252dc3a727403d76e2df5",
      "en": "「I'll lead! The rest is up to you!」"
    },
    "278:4817": {
      "repository_source_sha256": "49b6bcf30c46f695ab41a93768ee5c39eb062a92594b053f8c496ea5d4e9fcd0",
      "en": "「I'll open a breakthrough!」"
    },
    "278:4848": {
      "repository_source_sha256": "8d19f2d26631ee8ded0c877f071d1b3a6b1177a0ffb26f202d052b79e59b2be3",
      "en": "「I don't intend to be just a decoy!」"
    },
    "278:4701": {
      "repository_source_sha256": "3127c7d4682d2b8709e076fe84c52295ab1cf5ee8ab732575421368616029485",
      "en": "「So that one's my opponent...!」"
    },
    "278:4728": {
      "repository_source_sha256": "9739ef7dbcf771ce08e85581f8822e018c08ed2c66bf8add53456d4ba5f0aa6d",
      "en": "「One at a time, I'll finish them!」"
    },
    "278:4757": {
      "repository_source_sha256": "18a064c7dea93c349e4d6f3435aea1b0fc699c3414dbda2dfbba545524c61b49",
      "en": "「I'll split you from your wingmates!」"
    },
    "278:6592": {
      "repository_source_sha256": "6f1214d9a66a3b5935aae09d9b0ef80dda9cf4829198a0e279d4338748ac9934",
      "en": "「Sorry...! This is as far as I go...!」"
    },
    "278:6664": {
      "repository_source_sha256": "83ba628ce92cf4081f0101703daca739e7ed25d7084a7fcd857d55bab8f3fa34",
      "en": "「$$バンシィ$$ is... going down...!」"
    },
    "278:6035": {
      "repository_source_sha256": "7c3ea36bbf9eadf6f7df5c4fdc086367d06ae7fd0b7d8fc7fcf11f0481a31b43",
      "en": "「$$フロンタル$$! You bastard!」"
    },
    "278:6062": {
      "repository_source_sha256": "83aaa049a880a203c2b61136ca1f10d4d6aad251fcdf511f62f242bb4189a8dc",
      "en": "「You call this humanity's consensus!?」"
    },
    "278:6103": {
      "repository_source_sha256": "66075b15ac902008dd15e935a2da4d3a024204cd26bd76f9ba1804da25fb80d7",
      "en": "「I won't let your darkness snuff out\\n$$バンシィ$$'s light!」"
    },
    "278:6170": {
      "repository_source_sha256": "fa877048b17c62a17a4bff37566ad4f9a772e53f68657cf8c88c2438ccadaa1c",
      "en": "「Damn! I took a direct hit!」"
    },
    "278:6205": {
      "repository_source_sha256": "9d9fb427ea43e08fca0095df3c77cc99fb9a5a3e3faff49dc72fe2539cc7f52d",
      "en": "「Damn! It's breaking down all over!」"
    },
    "278:6248": {
      "repository_source_sha256": "feb0bdbf92f5e82e2a3cf2032520dfd1a1c2a68987875576d5efd8c23264da02",
      "en": "「No matter how hopeless it gets,\\nI've decided never to give up!」"
    },
    "278:6307": {
      "repository_source_sha256": "a9828fdb63d15e59a3a7fc2bea19a249888d003e3cf2850a4286b2f06c5e1048",
      "en": "「This life everyone held onto for me,\\nI can't throw it away here...!」"
    },
    "278:6370": {
      "repository_source_sha256": "7f11361d229d7be9f91c3a0641c083f962115aa191f4c55c06e289b9c8c57649",
      "en": "「I can't end like this...!\\nI haven't atoned for anything yet!」"
    },
    "278:6439": {
      "repository_source_sha256": "e630405e5de7f4e5fdddc65a00a5010684553076f6287f524f1f753e7a413573",
      "en": "「I don't mind losing my life...!\\nBut I can't end here yet!」"
    },
    "278:6504": {
      "repository_source_sha256": "37d24e8bc4b434a7cf13c19fdcbbdda6c7a6e022ad2d9a383300a1503612b22a",
      "en": "「Not yet, $$バンシィ$$! Hold together!」"
    },
    "278:6541": {
      "repository_source_sha256": "78557e6465dbe8a58ca7b3194fd880054a014872673d0860f50a9c0a6f05316c",
      "en": "「$$バンシィ$$!\\nNeither of us can be done yet!」"
    },
    "278:5823": {
      "repository_source_sha256": "f86444c35b539aad1a83ae72c7bd9e971b52baa83173ff1f8c3931a023b63536",
      "en": "「Ngh, this one's tough...!」"
    },
    "278:5844": {
      "repository_source_sha256": "f2479d9964a064241029cbbc310527227f086680e21b9b5cc01e1dd76bcb55b8",
      "en": "「I let them set the pace too much...!」"
    },
    "278:5883": {
      "repository_source_sha256": "07076b734f48fbdb191ca8ab42835750071a53e6fd86ef5bbf95c652fa04b969",
      "en": "「Too much reliance on my gut...!」"
    },
    "278:5912": {
      "repository_source_sha256": "d02510ed68d01d353ac1d8f750d1ccf3281c9fc561cc369d28b48283cdb6be74",
      "en": "「I'm fine...! I can still go on!」"
    },
    "278:5943": {
      "repository_source_sha256": "c8e84e6c4430de2a17af6d932d821a93634a05177c95a1f52e4f64727a1367e5",
      "en": "「Pain is proof I'm alive...!\\nI can still do this!」"
    },
    "278:5992": {
      "repository_source_sha256": "2b54228bd29bfc569efa3312ee2b52f96fedd960940ea8f8ffddb47d81135e0a",
      "en": "「This pain... maybe I deserve it...」"
    },
    "278:5255": {
      "repository_source_sha256": "2ec2994369d6bf4f04d144ee6242200e9d79b664304360f9c822cc41ce220a7a",
      "en": "「$$フル・フロンタル$$!\\nYour vessel can't amount to much!」"
    },
    "278:5316": {
      "repository_source_sha256": "a38cdfdff4cff0983a948075a5efbd94ac7bf7213dfd16b3bc641be11fbc9af2",
      "en": "「Your ideal will end as a pipe dream,\\n$$フル・フロンタル$$!」"
    },
    "278:5381": {
      "repository_source_sha256": "b9ad06f13cd05275acde023aee120d5b72d5731fd73a97b1133140b04d2f1602",
      "en": "「Is that it, $$フロンタル$$'s guard captain?」"
    },
    "278:5615": {
      "repository_source_sha256": "ef16757bcde8377684f264a047e5cfb93aeba355c6f9b6210087a1ab468e3cfb",
      "en": "「If there's no major damage...!」"
    },
    "278:5650": {
      "repository_source_sha256": "accc4a3f385367e0f3b772d5d6071dc9297427a31d622b3f33f195ed21ff9a27",
      "en": "「No direct hits and I can do this...!」"
    },
    "278:5689": {
      "repository_source_sha256": "d47aeda1082b829b3a6f6a0e0addc214d8b062de139092b9dd3d8a57b9785038",
      "en": "「My read was a little off...!」"
    }
  },

{
  "schema": 1,
  "rows": {
    "278:5716": {
      "repository_source_sha256": "38faf9654bbf25df4cda83797a7884159863abd0bcdc31fb3fcc074aca864aba",
      "en": "「I can't flinch from this attack...!」"
    },
    "278:5757": {
      "repository_source_sha256": "132ec587927b8546fa18275090551f00e5a0f7b96a4e0f54e21a4daee4f46c9b",
      "en": "「I was prepared to get hurt long ago」"
    },
    "278:5790": {
      "repository_source_sha256": "be15d27047e03d477b975b18b394caa56353772bafc91d9747348de4ea4387bd",
      "en": "「Now I advance instead of dodging!」"
    },
    "278:5549": {
      "repository_source_sha256": "92fa9a05744f21e64e32f5a6c3fe60800a8a2e204e28908ec371bd66d3fe2f76",
      "en": "「Not taking that head-on!」"
    },
    "278:5576": {
      "repository_source_sha256": "4ce53a8ff5a623815283201a04c9dc80fef10d1ab46900490c374b27eec56c68",
      "en": "「With the shield, this is nothing!」"
    },
    "278:5074": {
      "repository_source_sha256": "c3056ed292d4e63364ccf6388f01f43aed625e1b8d749de215e8801dcdef6165",
      "en": "「I'm not about to take\\nneedless damage...!」"
    },
    "278:5125": {
      "repository_source_sha256": "a6dacd1da1568de30101f86ccd6be1e93822d00a1b7f48e1213948e45658badc",
      "en": "「Not to such a sloppy attack...!」"
    },
    "278:5156": {
      "repository_source_sha256": "356caa6f6d5f941a5d2ebf86c018863156d4c578650ca87c0311cdbe248b6214",
      "en": "「Stay calm, and I can handle this...!」"
    },
    "278:5195": {
      "repository_source_sha256": "cc952294c39d7b97846df9ea93a707b6bced47f97a62cc5ef1a61585184e56a1",
      "en": "「Looks like my read was right!」"
    },
    "278:5224": {
      "repository_source_sha256": "9e7590417e8178e0ce58d84834835235b6bbaff077ac8582bb5555c7b6ca4d3e",
      "en": "「I could see the enemy's attack too!」"
    },
    "278:5420": {
      "repository_source_sha256": "75f53c48bd7f42911f8efe0ac0f67eba014a8548f0d9ae6e9a2e97503df2cdfa",
      "en": "「Hitting me won't do a thing here!」"
    },
    "278:5457": {
      "repository_source_sha256": "843bacef53ad1bb33b239211cc63cade7d66f77111e4106426b578e37022d5c5",
      "en": "「I don't intend to rely on the\\nfield any more than this, but...!」"
    },
    "278:5510": {
      "repository_source_sha256": "190a77bbb773ebc7b163dc5dbba9d5548260e73e264450b7197d9c06d4068d49",
      "en": "「Good thing the I-Field activated...!」"
    },
    "278:83": {
      "repository_source_sha256": "4e3505ce1c9783cc17e00e849ab83632fa0f56046b908f6ec87802849128355a",
      "en": "「Goodbye. I will not forget you」"
    },
    "278:122": {
      "repository_source_sha256": "2d233593a71a7de20b86e5499942675e9d0112221ac68d6d4fbc3c6cf2030dc8",
      "en": "「Accept it, $$バナージ$$」"
    },
    "278:151": {
      "repository_source_sha256": "73d882e4effd338a1f4b0b9e8ebd6cf5516cd530ec6ad78e49b4c1b5b31b8cff",
      "en": "「$$リディ$$!」"
    },
    "278:164": {
      "repository_source_sha256": "d4106ae9474745ee55e74773e4c376a307503a2ee9d5e1f731526b1f4b285ac6",
      "en": "「$$マリーダ$$... I'm sorry...! I did nothing at all for you...!」"
    },
    "278:219": {
      "repository_source_sha256": "f012150066150243d255f6a38cec9b98bf184b3709815ddfd6d37c9c806daccd",
      "en": "「Whatever it is, whatever happens... promise me you'll come back to me, no matter what...」"
    },
    "278:316": {
      "repository_source_sha256": "2988d05eb91f1ee60e7e7d01083be9d73722dd7e976d43abed764b2a7e1df4a7",
      "en": "「My one and only wish...」"
    },
    "278:6691": {
      "repository_source_sha256": "69c0d52c92e5377ec4475c25749b7d1bd69bf9b04d9e6a824d677bae0fa1ea34",
      "en": "「...! $$ミネバ$$, stop!」"
    },
    "278:6718": {
      "repository_source_sha256": "a24ed2a15679f7b7bb3b6f5ef10e0a127dfed9bd16fda62ee4fb3cbe190ac2df",
      "en": "「$$ミネバ$$aaaaa!!」"
    },
    "278:6743": {
      "repository_source_sha256": "9f16f199ebb8dafca6b49d0caa9e6eb9c15b1927af4c01515ac31949166e151f",
      "en": "「Everyone...! You're all denying me!?」"
    },
    "278:6794": {
      "repository_source_sha256": "07b5489c7bd556589b1f4f99649781be3e8a9801bc8b69b965b8ae74036313ff",
      "en": "「$$ミネバ$$... You... me...! I told you not to leave me alone...!」"
    },
    "278:6857": {
      "repository_source_sha256": "2ee304d2f60463d20ede0c73ecb53dd7c319aa7e9ab6b65697d8d64d4b134e1e",
      "en": "「W-wait...!! I... What did I do...!?」"
    },
    "278:6920": {
      "repository_source_sha256": "b6e2e6c2dbdb61212552c9380d2152981a71dd700700b4fc59f0f41dc5f61ec4",
      "en": "「Let's do this, $$バナージ$$...! This light isn't something only we are producing!」"
    },
    "278:6993": {
      "repository_source_sha256": "285333eff40ce7e0713e0ee616f205d836f176634a150d8781a7f110a53724bc",
      "en": "「Is this the perfected $$ニュータイプ$$...!?」"
    },
    "278:7034": {
      "repository_source_sha256": "f63ec2505fbfe753b123c7271523f07faca5c0c9a1d1b0298c0391e280587c4b",
      "en": "「You're so reckless...! Nobody wanted that kind of result! As long as there's a possibility, that's enough!」"
    },
    "278:7137": {
      "repository_source_sha256": "55e0021470b21b94099215d92d40045641079ce0cf0d805ea8ee61b5c95659e3",
      "en": "「Both you and me! There must still be plenty we have to do in this world, right!? I'll bring you back, no matter what!」"
    },
    "278:7228": {
      "repository_source_sha256": "e388c59258951642066ab67ce4122767d2161d97cd14acb79659630f124cf203",
      "en": "「$$バンシィ$$!」"
    },
    "278:7243": {
      "repository_source_sha256": "d4465744006f911b24806feada864c610c1e2a811ffe4ca89e58f80981556447",
      "en": "「Think you can hold $$ミネバ$$ like that!? I'll steal $$オードリー$$ away! $$バナージ$$!」"
    },
    "278:7322": {
      "repository_source_sha256": "42966e246ed761c3607f4a579c32dead88ff6e2fc1cdd2e46a794be88b61f445",
      "en": "「I can't possibly tell you that...!」"
    },
    "278:7367": {
      "repository_source_sha256": "987667dfc2dbc61d9b0c810f7aa9d5b40a8d1d0d33a0e75ff9539c8d62398be3",
      "en": "「Take a good look in front of the screen, $$ミネバ$$! The players are watching this exchange!」"
    },
    "278:7448": {
      "repository_source_sha256": "7aa34ebb3d64ef154551b8a5fcb04fe953c59b7af140e7589bc0aabb56ef34d2",
      "en": "「There must still be players who don't know what the Box really is... And yet I can't just go and spoil it for them!」"
    },
    "278:7557": {
      "repository_source_sha256": "73111387c5eed9ff67c8893d43078687f98de135bba888cd9441e255ddeeb6c5",
      "en": "「Damn! Why do they keep hitting me!?」"
    },
    "278:7608": {
      "repository_source_sha256": "360b5e442a74f70bdaf115dbbfa7977d3321210db7fa8a3f8466b7a09eb9f644",
      "en": "「...Both of them took off the moment they heard what you just said, Captain」"
    },
    "278:7663": {
      "repository_source_sha256": "ae2d0a8c7e7c6ef0b3c2b723725233061eeb4ac5d595ea56787460795dfafba8",
      "en": "「Heh heh... Looks like the $$トライスター$$ aren't prepared enough either」"
    },
    "278:5022": {
      "repository_source_sha256": "1a40d5f5784b3449bbd1ac1d7e7559c6676bd1b8328e9f8bd3933cc9a62a65d2",
      "en": "「Damn! Smart way to keep distance!」"
    },
    "278:4987": {
      "repository_source_sha256": "6f308c9429201723e459eda16ae6f4a244961fce6449d75c7a830b1d164f6ef8",
      "en": "「Ugh! My output won't fully rise!」"
    },
    "278:4425": {
      "repository_source_sha256": "0881a3fb41deea23b25ce994bb568a311b5ee56c209643f60352f11097315469",
      "en": "「Hang in there! I'm on my way!」"
    },
    "278:4450": {
      "repository_source_sha256": "be95f1c48e72d7e41884c1ea7e8dbc65a890a5d0f292e851631db4164974c28e",
      "en": "「I'll be the shield! Fall back now!」"
    },
    "278:4487": {
      "repository_source_sha256": "5fbb16bf551ef90157de1f9904547b01510090cd86a370a97ebfc9a22df72ddc",
      "en": "「Let me do at least this much!」"
    },
    "278:4518": {
      "repository_source_sha256": "07611f65da7d9f47554957024ec9fc0daaaacca5dd2085899b7e126b79d8b9b5",
      "en": "「Fall back, $$バナージ$$!」"
    },
    "278:4545": {
      "repository_source_sha256": "ac250f3d4f3c82468a155418c3bd83d008b49387674de785a6ad8b83fc9fe775",
      "en": "「I'll repay my debt, $$マリーダ・クルス$$!」"
    },
    "278:4582": {
      "repository_source_sha256": "04fdfd6110e58b41c7d20780eefdcca51bee3227eed991213dc199be6b16d5b1",
      "en": "「Precious comrades are on that ship!」"
    },
    "278:4621": {
      "repository_source_sha256": "9bb0dae977abf9b41b16d52c14e7f434b68039d891877df2fc1d5d07b97e9900",
      "en": "「I won't let $$ラー・カイラム$$ go down!」"
    },
    "278:4658": {
      "repository_source_sha256": "81139b96847030a59a95bced7b7a34946c1b417bcdeaff9822542182f98b7529",
      "en": "「That disgraces the $$トライスター$$ name!」"
    },
    "278:4887": {
      "repository_source_sha256": "e31928ea4eb8508e8521da95942d37363ff2b262976b45ae57a20129c63d8fe6",
      "en": "「Can't counter!? What a blunder...!」"
    },
    "278:4930": {
      "repository_source_sha256": "c1f1aa2e5ef3d8eb7438e4ee0a3323814fa932362bd13c5fa14d8723ffd7cba7",
      "en": "「I'm not going to keep getting\\nbeaten one-sidedly forever...!」"
    },
    "278:703": {
      "repository_source_sha256": "05441be0c44b667a3ac136feb86cc20db8c31ba688ac773e36ac0ed5a1ae1fff",
      "en": "「I won't let you go any further!」"
    },
    "278:736": {
      "repository_source_sha256": "65853c927c2de82b44fc3d107e0e204c39efa5dadc7d595a04f458da08ce4c03",
      "en": "「I'll walk the path I believe in!」"
    },
    "278:765": {
      "repository_source_sha256": "913c8711c936051b6db034345863667018d6e5fd0c647e7d128e52c780f02e0c",
      "en": "「I'm going through here!」"
    },
    "278:792": {
      "repository_source_sha256": "a87c8e4e3d2e4b43aadccd863fe5a4ea2075f47c8d4fc6ffc832dc5776866b76",
      "en": "「Reckless or not, right now...!」"
    },
    "278:819": {
      "repository_source_sha256": "dabdf0712f0d01e75e8561bff82cdf8ae6a376b767cc820a3ad6289c15d48aee",
      "en": "「For everyone's sake, I'll do it...!」"
    },
    "278:848": {
      "repository_source_sha256": "69ad2d888f8d568c44f14cc725452e1bd6cd38728c4fd8b97b2bdb2b5c415c1c",
      "en": "「If you're in a spot like that, then!」"
    },
    "278:875": {
      "repository_source_sha256": "2a10d8bc4e1c6f8988bf5422574a217105fb2d2edf50c4d07b964ed0ada15105",
      "en": "「We're moving forward!」"
    },
    "278:898": {
      "repository_source_sha256": "4ee7c139a4261a95d41236345abc0ffaca3369b13aec8e87b5d798a06702fa4a",
      "en": "「I'll show my resolve with action!」"
    },
    "278:921": {
      "repository_source_sha256": "768a2787d317389590c5bf52f2ec47062fa091c5eb2eab4c3d15a36ecf425be0",
      "en": "「I'll atone by fighting!」"
    },
    "278:946": {
      "repository_source_sha256": "f91229d9c7a02aa561a00a97925849e03568664ae32b01d557b4132a62e647e4",
      "en": "「Let's go, $$バンシィ$$!」"
    },
    "278:969": {
      "repository_source_sha256": "138fd115331aa6b7f9165e291a880a08a1ed4ca26acd147afc30f60313f0e645",
      "en": "「Show your power, $$バンシィ$$!」"
    },
    "278:1000": {
      "repository_source_sha256": "66be4532556727b2de1b5c3934a73a3de6dac73cd262a1cd8ab51a144d0e64e2",
      "en": "「Lend me strength again, $$デルタプラス$$!」"
    },
    "278:1043": {
      "repository_source_sha256": "c86433658780d2a7fd20ca319f21ba0f4963f40531aac34394b73754d79edfd8",
      "en": "「$$クシャトリヤ$$...!\\nI'll master it, just watch!」"
    },
    "278:1173": {
      "repository_source_sha256": "f3b748d6f9adac24f541a916eec767585fcfe2302b2d08a4221e55324dfad145",
      "en": "「I'm charging in, feelings and all!」"
    },
    "278:1221": {
      "repository_source_sha256": "762a3ed6329f0942a4a0d13b99bc38fd16f95f75ddb545da2944f02f369e4444",
      "en": "「If I can just close the distance...!」"
    },
    "278:1092": {
      "repository_source_sha256": "b6c7a8dd6d7b4b4b924b15677025e1fa49e859bb8d7931221ad621b9d87df1ec",
      "en": "「That's within my range!」"
    },
    "278:1123": {
      "repository_source_sha256": "e33e76cca6fa4355217401318faf004db4940b7f4a15414c0bcc8004e7374be8",
      "en": "「From there, this will work...!」"
    },
    "278:1154": {
      "repository_source_sha256": "8f782ceaaffa213a5de6d486fec44b11aebfd0f8b73fd59d35166b2c63df0974",
      "en": "「I won't miss!」"
    },
    "278:1250": {
      "repository_source_sha256": "453b8de4307c88ff79b3bdb4239578e985b5aef51e09ef05d24114f9db55d0ce",
      "en": "「Go down!」"
    },
    "278:3575": {
      "repository_source_sha256": "b1bc6a8156d12ed80bce41c676b5f90faa456feaa4a385eac89eeda66ed28b63",
      "en": "「I should be able to use it now...!」"
    },
    "278:3606": {
      "repository_source_sha256": "4c68beb13fa7565f7c3dac61cd1eb1b1490830eb3439c9759afa50f261b8bde3",
      "en": "「With the funnels...!」"
    },
    "278:3627": {
      "repository_source_sha256": "7e43b684c614ce6ddc663387bde7dad5fd686db82fbe3f909eab79e7c9c87d56",
      "en": "「Go! Funnel!」"
    },
    "278:1331": {
      "repository_source_sha256": "871fc13af2c7766582b8536ee1ab83dc31c8fb42b89fbde2768e9e9ff7092966",
      "en": "「I'm ending this!!」"
    },
    "278:3743": {
      "repository_source_sha256": "8ceee4db5de2541befec960aca2e8642504f828929bb1b4134ddcafc3f9b6cc3",
      "en": "「This power flows through my body...!」"
    },
    "278:3836": {
      "repository_source_sha256": "c35fad2ae8c59f67cef100cfd8d16048e4010ec485f75bb2f6d100efc7fd6ce8",
      "en": "「I feel it...! My awareness widens!」"
    },
    "278:3111": {
      "repository_source_sha256": "97ee2be5345c8e63bc616c4f09d286063167d5b50ea80ea9e52223e8f4a27735",
      "en": "「With this... the finishing blow!」"
    },
    "278:3194": {
      "repository_source_sha256": "3ad17fb2e7b87ae55cac60ef34014811da643cf9a337e99287dcacc752cdde31",
      "en": "「With this... go down!」"
    },
    "278:3710": {
      "repository_source_sha256": "76ec14b27f84faa5591bb70074f7388bf9835ae5effdb18cd3d64c5b7e0c9084",
      "en": "「$$ゼータ$$ is teaching me...!」"
    },
    "278:3803": {
      "repository_source_sha256": "af4a3526a40d9ea2adde116e2f42da9bfb414907aa6d00fcab2333af59e12485",
      "en": "「I'm betting everything on $$ゼータ$$...!」"
    },
    "278:3873": {
      "repository_source_sha256": "7299ec0d19e328ede58c71ef5254e8a21c1b9ccbc2809af81d13565e21028dff",
      "en": "「With this power... I'll do it!」"
    },
    "278:3900": {
      "repository_source_sha256": "93d273982535c93ac81028c422fd04302801376d4b1e5263c7343a1e30fcb92c",
      "en": "「Allies, back! $$月光蝶$$!」"
    },
    "278:3943": {
      "repository_source_sha256": "420b40fe93328591814ce35204e8a3c67f58963bfccd1c42cb1bde93d3a6e87f",
      "en": "「Risky or not: $$月光蝶$$!」"
    }

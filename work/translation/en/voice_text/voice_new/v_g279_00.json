{
  "schema": 1,
  "rows": {
    "279:0": {
      "repository_source_sha256": "fd31637ada742ce47e85a95ca7944c43c5dc65e4e58bbffae9fb404fcacbbe64",
      "en": "「If $$バナージ$$ can master it,\\nI'll show I can too...!」"
    },
    "279:61": {
      "repository_source_sha256": "da0b672bb06e970f99b8093cdedba2fbd062d54f99e5b5d7c4ae14fdcfd9f0fb",
      "en": "「With this $$バンシィ$$,\\nno matter who I'm up against...!」"
    },
    "279:114": {
      "repository_source_sha256": "fc225b5a75b3c1d354e15459a6ebdd0fd93e9bc450b21094275b7509717d6b51",
      "en": "「Even an imperfect order...\\nCan't change it? I'll protect it...!」"
    },
    "279:185": {
      "repository_source_sha256": "bfdbd783bf54bc3f7e84ed674201af4688016043f9ffe478e802153b67ace7e3",
      "en": "「I must stop the Box being revealed!」"
    },
    "279:226": {
      "repository_source_sha256": "dfdbc347c1a640c81eb710fd9720d47d7b3a87560c883978ed777f601df14d5e",
      "en": "「The secret of $$ラプラスの箱$$\\nmust be protected!」"
    },
    "279:283": {
      "repository_source_sha256": "07b19f12ac5a3327c820b22f8d369bd5e430e6cfbc98316b0e39c33d9b487f42",
      "en": "「We're already a bloodstained family!\\nI can bear being called traitor...!」"
    },
    "279:834": {
      "repository_source_sha256": "5a825c8ddea74f204c5ab947c79497f4d2a143dd99f77ca3e72e96a6f9993cde",
      "en": "「$$バナージ$$eeeer!!」"
    },
    "279:869": {
      "repository_source_sha256": "f449e905c3ecf0f724ed257dc26c544012f3caac1929fd98518f92203413f120",
      "en": "「$$バナージ$$... Without you...!」"
    },
    "279:906": {
      "repository_source_sha256": "76edc85d778fd5b2527dc320ac752714c4fea92d080e57c38292fadd357ed70b",
      "en": "「If you and I vanish,\\nthe century-old ties vanish too!」"
    },
    "279:961": {
      "repository_source_sha256": "5ade3365d1ae9a2ac80c663e839757faeb1f19f2c4815457d84e8b99c06ae12f",
      "en": "「Sleeves people,\\nrunning with the $$ネェル・アーガマ$$!」"
    },
    "279:1020": {
      "repository_source_sha256": "3de852e989e8671162ab80ddde8529b9383f384418446f8d51092ebbdcaaa96d",
      "en": "「Time to repay my debt from then!」"
    },
    "279:1055": {
      "repository_source_sha256": "956b631ddaeff76ce3a0539a4fdf70324c5783777421df5f8ed64b1c56a6c085",
      "en": "「The $$バンシィ$$ is my arms and legs now!」"
    },
    "279:1086": {
      "repository_source_sha256": "3105ff26340cf9dce1de3e9eb1733adb21eb038fc6b4f6c9943509288dd3dff5",
      "en": "「Captain $$ブライト$$,\\nthis is the answer I came up with!」"
    },
    "279:1135": {
      "repository_source_sha256": "e554286165305f96aed0d273c22b38c7fd93cf79a5bd3f32b4486e14ccb0f606",
      "en": "「$$ネェル・アーガマ$$...!\\nYou're all rejecting me...!」"
    },
    "279:1192": {
      "repository_source_sha256": "71644bb004170ab9ead31b5306893f7739069a1c33f8a002bb12c06eee97f428",
      "en": "「Even against the $$トライスター$$,\\nwith the $$バンシィ$$...!」"
    },
    "279:1243": {
      "repository_source_sha256": "687977aec99b2771b5bec83d8bd40247f8d4c046b0e181ac7c59971b6cd258cc",
      "en": "「$$ガランシェール$$!\\nIf you're taking $$バナージ$$'s side!」"
    },
    "279:1302": {
      "repository_source_sha256": "299167dd817a32e4ca5fa4bac8371706253d789b7e6c0eb23eb9ea3df20e08f3",
      "en": "「You keep wavering around!\\nWhat the hell are you people?!」"
    },
    "279:1355": {
      "repository_source_sha256": "b71d46cfaede57dbd3bc491457395974eb10b1cef5dd8648a876dd673b3eb09b",
      "en": "「Out of my way, $$カミーユ$$!」"
    },
    "279:1382": {
      "repository_source_sha256": "02cd95a214581b1302abe12d75a9455d3624f245c25a59762b33822ab0c5d10e",
      "en": "「I can take Captain $$アムロ$$ now...!」"
    },
    "279:1425": {
      "repository_source_sha256": "11b206cc9b7960f1f6a804b42f488982522537a54f7edb484d5741afc92c69d7",
      "en": "「$$赤い彗星$$? A relic of the past!」"
    },
    "279:1468": {
      "repository_source_sha256": "96d135b4822bd78fda885e5a79685248768638a72e48bae4e051584ca0b36be0",
      "en": "「Fall back, Lieutenant $$エマ$$!」"
    },
    "279:1493": {
      "repository_source_sha256": "a2ddbdb16e20931bdd4e5eeb884e35c99c42261be8618fc491e5f2939fa301b8",
      "en": "「Stay out of it, $$カツ$$!」"
    },
    "279:1520": {
      "repository_source_sha256": "007f90b22b5ec4ef1f5baadbc201efce153bfee520d675ecdddda99abec0f22f",
      "en": "「Do you want to die, $$ハサウェイ$$?!」"
    },
    "279:1553": {
      "repository_source_sha256": "b6dd8bbd46e21202cc348d24228df47a5ec2792c6d74aef56cea55cc045f2ab7",
      "en": "「$$ファ$$! Even you're against me...!」"
    },
    "279:1582": {
      "repository_source_sha256": "150c60391499f867484b9ca8abcfc02e0b4f3b4c8a82288e3094b1eba0755577",
      "en": "「Don't get in my way, $$シン$$!」"
    },
    "279:1607": {
      "repository_source_sha256": "b0b3283b419aedf7479774a32915ec3c897eb4c5b7490703ad70e480f641d8a4",
      "en": "「Kids have no business here!」"
    },
    "279:1630": {
      "repository_source_sha256": "0dc9525de5dea8295739600ac63ea98cac561ae6bd94bd8b96babc00fda64a8c",
      "en": "「So the $$Ｓ．Ｍ．Ｓ$$ is coming!」"
    },
    "279:1655": {
      "repository_source_sha256": "1eb4169001a9d23a0d2d07bef2b41d106542d091b61b592c06ce88b447d19384",
      "en": "「I won't let you play the hero!」"
    },
    "279:1686": {
      "repository_source_sha256": "797e1f6285de79a1539f46a9a68ca46fa2889a7be6e5ab7106bfbb8b4dd20138",
      "en": "「You're just terrorists, after all!」"
    },
    "279:1725": {
      "repository_source_sha256": "b51de3374ca2428da48e1833e84d905296f3d1e1db317e129bc063800a960ff2",
      "en": "「$$フル・フロンタル$$!\\nI won't hand the Box to your kind!」"
    },
    "279:1788": {
      "repository_source_sha256": "601de1beaf53505f3121f27e46c2d69434990a1c8f802605d3c778d3e51203b2",
      "en": "「Pathetic hanger-on of $$フル・フロンタル$$!\\nYou're in my way!」"
    },
    "279:1847": {
      "repository_source_sha256": "d4513cd706616646ec1ebce93f0a30b71a37a23a30f4909650b3f29c0218c043",
      "en": "「A mere $$ジオン$$ rabble\\ncan't beat the $$バンシィ$$!」"
    },
    "279:1908": {
      "repository_source_sha256": "3f6b308c3f2cd4624405cf48feac926cf914b450a0e377c77dfac927d543e907",
      "en": "「$$ニュータイプ$$s! A human variant embodying\\nthe curse of $$ラプラスの箱$$!」"
    },
    "279:1973": {
      "repository_source_sha256": "9c2cda77f64ca6678ede7ea82781bb247a590b4b039b4447610bbeba84fca9cd",
      "en": "「If only $$ニュータイプ$$s\\nhad never been born...」"
    },
    "279:2026": {
      "repository_source_sha256": "7e497e7477dfb9c909a7b531ceed5b80c67f7aaa41fab5376951e2e072829198",
      "en": "「I can't accept a new humanity\\nadapted to space!」"
    },
    "279:2087": {
      "repository_source_sha256": "3718a4a41980102d7164926302547542ab9e8fd6d119113fa58aab40b88e3a84",
      "en": "「Damned $$ガンダム$$s!」"
    },
    "279:2118": {
      "repository_source_sha256": "f7fa9c52f43bb962fa7556cfc014fc150c9220ab7059e067ae6436e0bda57d93",
      "en": "「I'll cut off the curse\\nthe $$ガンダム$$s have spread!」"
    },
    "279:6478": {
      "repository_source_sha256": "a431313da06a4dc6fc7e084caacce51a316c1782cd4a812c0fffa0f914927348",
      "en": "「$$ミネバ$$! I... I...!!」"
    },
    "279:2459": {
      "repository_source_sha256": "50afeae0142667f9eee6dad75c51383106230d587a4a003ee8379ce3709675af",
      "en": "「Don't get in my way! Move!」"
    },
    "279:2486": {
      "repository_source_sha256": "b7886187fe122560b6aefbac7c091b39476f7409dd7722071fc1e66942bc70f3",
      "en": "「I pay back what I owe!」"
    },
    "279:2503": {
      "repository_source_sha256": "41c52117abe3f0499ba02b9efe701006a285725998391093ef6cb57c18708ee4",
      "en": "「There's no softness left in me now!」"
    },
    "279:2528": {
      "repository_source_sha256": "bac9ecf6532bd6cbc0cc5a7e6653a5ae65482634f9d481c1bcad2244c90043a3",
      "en": "「I... decided to go all the way.」"
    },
    "279:2563": {
      "repository_source_sha256": "58af223d65a9b8db176a9ce9c892e89287da88415b34659678dac1853744ac2b",
      "en": "「I can't just let you go!」"
    },
    "279:2598": {
      "repository_source_sha256": "5f331869f61770f43e6a2bde4abd2a898692920ce217bda1a9b69b4d265ea537",
      "en": "「The old me would have shown mercy,\\nbut now...!」"
    },
    "279:2649": {
      "repository_source_sha256": "cd18832bd521d17efc95f6e7413326b878b1145fa4a0af7159112b24fb999ecf",
      "en": "「Move! I'll take it from here!」"
    },
    "279:752": {
      "repository_source_sha256": "488e7d93e0626cde55901131ef54ecf95719037d722de3f13f6f942150dfbee5",
      "en": "「Even if I can't finish it off,\\nI can strike again...!」"
    },
    "279:803": {
      "repository_source_sha256": "74d1c439183b4e955e083826504516bdae83125d3e9bd364e3b332bdbaec889c",
      "en": "「Wasting time with a futile struggle!」"
    },
    "279:2859": {
      "repository_source_sha256": "7f0899d1319132df3245327b46f878022f59dd0defc122604f67f21bc40fd370",
      "en": "「That guy? I can handle him alone!」"
    },
    "279:2890": {
      "repository_source_sha256": "db9de74bd7bc5566e5ae75bb6f9c5f0a2e3d95274d98075b5e26d85fa76a74ee",
      "en": "「No need to say it! I'm on it!」"
    },
    "279:2785": {
      "repository_source_sha256": "5cb1d28a0224138d17a08aebd6a1842a59e4b0156010bc7e1728ab24427351bd",
      "en": "「I'll do things my way!」"
    },
    "279:2820": {
      "repository_source_sha256": "f3e250c4fcc101759767e8c45b2e23f702aef123dd673de13cab80c14f498f5d",
      "en": "「Got it! I'll take care of that one!」"
    },
    "279:6369": {
      "repository_source_sha256": "77d2983992e39c793fb89491697652c58d72a614fab2084f6413249a8356b5ec",
      "en": "「Am I... unable to stop them...!?」"
    },
    "279:6410": {
      "repository_source_sha256": "6a94ed7bd313cdec0005d18bc5325bc3d5bd1d44919a81e577e1842ff0c2ff90",
      "en": "「Damn! This wasn't the plan...!」"
    },
    "279:6443": {
      "repository_source_sha256": "d82a5cc0151f8398c639a2d1af07c79698918e7db1681bd2dd22eb844aa899d5",
      "en": "「$$バナージ$$eeeeer!!」"
    },
    "279:4845": {
      "repository_source_sha256": "1a8edf43e109856cb700082b053fd33f9f2ce68ddff2b451af331d2f43c5c7a9",
      "en": "「Not yet! Not until I wipe out\\n$$バナージ$$... the $$ユニコーン$$...!」"
    },
    "279:4908": {
      "repository_source_sha256": "bc91794c4f4f8ab90fc026598fabc94eb84564730c9e80a5a5fa3aca207caa84",
      "en": "「$$バナージ$$! I can't die\\nwith a loss to you hanging over me!」"
    },
    "279:4973": {
      "repository_source_sha256": "31c6c6d93662e8b4f33a0a0163abede5f9ac67870f9b09fe591b3512d6aebbf5",
      "en": "「Ngh! You really do know\\nthe $$バンシィ$$'s quirks!」"
    },
    "279:5034": {
      "repository_source_sha256": "ebebcd2176bf9abb2998020d770b11b6b3e670e1e57d5c466be5b70ec10d1b14",
      "en": "「Damn! If I can't even beat\\nan enhanced human, $$バナージ$$...!」"
    },
    "279:5101": {
      "repository_source_sha256": "04412dbffa984fbe9a3b6f278eb95793233a1ad74525b198aac6574503752a83",
      "en": "「No mercy...!\\nSo that's it, Captain $$ブライト$$!」"
    },
    "279:5158": {
      "repository_source_sha256": "6178347cac3fabac6489880c7a49f0678e5276cb96f8a77b17f7d9de1d9d9499",
      "en": "「Only as his enemy do I see how great\\nCaptain $$オットー$$ is...!」"
    },
    "279:5219": {
      "repository_source_sha256": "fc3f59324cdb8acf6b5b05c0d8e5d026f7dac93ac3219312182c45b5b6fef7df",
      "en": "「No wonder\\nthey call you an ace!」"
    },
    "279:5268": {
      "repository_source_sha256": "450425d7935bdcf9fd61084238830314c694b1321a3afdb52352146f670b4b11",
      "en": "「Damn! Pushed this hard by a ship\\nwith barely any weapons...!」"
    },
    "279:5333": {
      "repository_source_sha256": "ae0d1c1df629e60de217d93e5b7d2c0f95ad5df07d325bbd74d32e137e17e928",
      "en": "「Will I never beat $$カミーユ$$, ever...!」"
    },
    "279:5374": {
      "repository_source_sha256": "a1fcd70a534c0e8fa8b0d66399906d7bf3d245bdc262f71f3251b5573ceaa289",
      "en": "「This is Captain $$アムロ$$'s pressure...!」"
    },
    "279:5413": {
      "repository_source_sha256": "0b815531f2c8657ec1d425d9a0f33bc20afcdb934a3e72e27982b821dabc5b2e",
      "en": "「$$赤い彗星$$'s aura is cornering me...!」"
    },
    "279:5454": {
      "repository_source_sha256": "37045cac848b9e6881ac2598e47189d098121b0c11c731c00e99a4ed0b6cfb20",
      "en": "「Impressive, Lieutenant $$エマ$$! But...!」"
    },
    "279:5493": {
      "repository_source_sha256": "ca047dffc70771d669711cba3a5310a49ec472b0c8f11d6fb5f09cbfa0ea2765",
      "en": "「$$カツ$$ is cornering me!?」"
    },
    "279:5528": {
      "repository_source_sha256": "0c044d89ad790517a8ab89918f8417c3dc477fb30b97cfe3e90ff585be48797b",
      "en": "「$$ハサウェイ$$ is pushing me back...!?」"
    },
    "279:5567": {
      "repository_source_sha256": "8e02ae896d9c75614114ffc15280cde04b112c87797771d387611495114a63d8",
      "en": "「$$ファ$$...!\\nIf you mean it, then so do I...!」"
    },
    "279:5614": {
      "repository_source_sha256": "76d66a577419774ea9fcf04e00fb19cca4580c039ad2881b78212b8fee787d58",
      "en": "「So you're finally serious, $$シン$$!」"
    },
    "279:5649": {
      "repository_source_sha256": "ecdcc4db2806bf7ebd402152fd82adfb8611502bd9a65f2a3d1df6d83aefca6c",
      "en": "「I'm at a disadvantage in power...!」"
    },
    "279:5682": {
      "repository_source_sha256": "464884cb765d58b1fc15066c114f2da0ced817dfa83213843872085e6d93b387",
      "en": "「Damn! The power's on another level!」"
    },
    "279:5723": {
      "repository_source_sha256": "039e1399705aec1e6af897aa96e99240d0700b21f6da21c8348242a4bafc904a",
      "en": "「Beaten up by a mere mercenary...!」"
    },
    "279:5764": {
      "repository_source_sha256": "fa2bec12aa73b7f19bf72f3aa18babaa9053c3d65dfa3100b9b758fb39bc5bfc",
      "en": "「So this is $$Ｓ．Ｍ．Ｓ$$ combat skill...!」"
    },
    "279:5797": {
      "repository_source_sha256": "abc8c196f50543c88d96d3fa9e5f325fe9092d70a646eddb4287fc3a5968759e",
      "en": "「At this rate the Box falls into\\n$$フル・フロンタル$$'s hands...!」"
    },
    "279:5848": {
      "repository_source_sha256": "58ff8937aefef686f0155f5fdf5bbb03dc7fa86d68722479fa23c21bc7366c00",
      "en": "「Struggling against a mere Guard...!」"
    },
    "279:5883": {
      "repository_source_sha256": "b786c2e82d61ae79f509813a1e6587a8c4c18db9e7a65447bc21e289b7b1661b",
      "en": "「Monsters!\\nI can't leave that power alone!」"
    },
    "279:5930": {
      "repository_source_sha256": "843f821ad06629eedea3603a05c7878dd50f81ca1d40e0d4db821d6bd9b00322",
      "en": "「Move more, $$バンシィ$$!\\nYour opponent is a $$ニュータイプ$$!」"
    },
    "279:5989": {
      "repository_source_sha256": "a8e30e1d0479ad11d8d6a9d93a48e8be845eb62963c5bda54e2e8f7c418ca6ab",
      "en": "「It's a $$ガンダム$$ I'm up against!\\nI was ready for this much!」"
    },
    "279:6044": {
      "repository_source_sha256": "92e9e21071da2f38a9b01cfda844857442f27aeb784c46b8ebd445c513fedd20",
      "en": "「Ngh!\\nSame Gundam type, so why...!?」"
    }

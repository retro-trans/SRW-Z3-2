      "en": "「An AI will be slow on snap calls!」"
    },
    "295:10347": {
      "repository_source_sha256": "5231bd398d1764b868baa78e8ba2e286634e8efe8ab82755682b15102fb8594c",
      "en": "「I can't lose to a machine...!」"
    },
    "295:10384": {
      "repository_source_sha256": "fea4deb79d2079f01b8eb67b0f330e9e1628e013f4a45745a213b70c091d5438",
      "en": "「Lock down its movement!\\nDon't aim for the cockpit!」"
    },
    "295:10437": {
      "repository_source_sha256": "d5218f57ee00915f7d7056de78309876b3660f5f9f6ce129eb2205eaa196431c",
      "en": "「We fight without human casualties!」"
    },
    "295:10474": {
      "repository_source_sha256": "e98b671a25cba8dcf87eb9efd84993e89e083d00e4d83f57f26995110162e2d4",
      "en": "「Enemy commander found! Attacking!」"
    },
    "295:10509": {
      "repository_source_sha256": "3438052876e3b19d483882ddd3759d2eaea8a581aed9441253e56b000a7a9bdf",
      "en": "「That's the heart of their command!」"
    },
    "295:10542": {
      "repository_source_sha256": "07d22c06cf9a47682673a9b48d19d3f31833e03d6f610d790c5c667dbd24e9aa",
      "en": "「Sink the mothership, turn the tide!」"
    },
    "295:10583": {
      "repository_source_sha256": "681f84e26e1d74ccd9db24f731ca83312b110201655c41b1f6ff9fcf75782b64",
      "en": "「I'll drive you off Earth!」"
    },
    "295:10614": {
      "repository_source_sha256": "c2a5dc7c24f8cee45f56f185f822ed5365a577d1989f5af007c188284f192bbd",
      "en": "「Invaders get what they deserve...!」"
    },
    "295:10649": {
      "repository_source_sha256": "f95fc4527808f6ed5061c999d4ad9dd589df5522810fd26c128188622de6d3f2",
      "en": "「$$サイデリアル$$...! What's your goal?!」"
    },
    "295:10684": {
      "repository_source_sha256": "ddb02345afd22c6920e362055110ff297a6be9130f1f6996dc3947a77fee57a6",
      "en": "「A $$スフィア・リアクター$$ has shown up...!」"
    },
    "295:10721": {
      "repository_source_sha256": "cc03f3a283521e66fb13123f744af99eb7f6db745a30989e81e8be2d88be2671",
      "en": "「Even if the enemy has a $$スフィア$$...!」"
    },
    "295:10760": {
      "repository_source_sha256": "89af99d2dc0362444a4df50355005e09b751ab2edd5137edb36ab0d560aec65b",
      "en": "「A being that spews hatred around...!」"
    },
    "295:10799": {
      "repository_source_sha256": "6216d970fe7af0a8ccdb9313058a559853203c9582b2e9f36005df2cbea2b8a5",
      "en": "「Its bloodlust... slip and I'm lost!」"
    },
    "295:10834": {
      "repository_source_sha256": "140044fa5951be07bc4d628124fed600caf8a4dfdee0af463ca441f53b5b5f1b",
      "en": "「Take down the enemy's leader,\\nand the battle is decided!」"
    },
    "295:10883": {
      "repository_source_sha256": "5b9607a01cf3469cfd3450c6f3aa51c9c7ba51b00e43e9d7fdab943488769ee3",
      "en": "「Their Emperor is up front...!」"
    },
    "295:10926": {
      "repository_source_sha256": "e1cc7d617f317b2bd157b7c35cd64a06b9e155e7f6c6c3796f5609561ee5765a",
      "en": "「I won't let you cut down my comrades\\nfor your selfish aims...!」"
    },
    "295:14278": {
      "repository_source_sha256": "ae5481fe121876657778281b8c08840509ed5ef3e4df46b666df7b67c1a11f50",
      "en": "「Target: enemy unit ahead, $$チェインバー#pilot$$!」"
    },
    "295:14321": {
      "repository_source_sha256": "890b93153eeadad6af01eb55ae015a896d8c8b80c6127b933abf724edc993ec2",
      "en": "「$$チェインバー#pilot$$, how far is the enemy unit?」"
    },
    "295:14354": {
      "repository_source_sha256": "a9b0b5e0abf05d3322f0c466250b599f58481c201c5012f5bad3086763edcdeb",
      "en": "「That was my intent from the start!」"
    },
    "295:14381": {
      "repository_source_sha256": "497eba0c7b1e51ee26df58fa5932d6bd5754899d44d81c8b9b66494d0a58e167",
      "en": "「Good. Commencing combat!」"
    },
    "295:14412": {
      "repository_source_sha256": "6d3ad9eed923cf06132590784d0e0e75804a91db808d53ae9b468299f139a2e6",
      "en": "「$$チェインバー#pilot$$, going to combat readiness!」"
    },
    "295:14453": {
      "repository_source_sha256": "3d6849c676740514adb6da0c3dc08c39216eb4261d7b1e88be24efec5ca932da",
      "en": "「This opponent doesn't look easy.」"
    },
    "295:14482": {
      "repository_source_sha256": "c64c65cacca71de7b8184d8d114424bc04895488cc51334707c2a803f83374fe",
      "en": "「We'll fulfill our duty!」"
    },
    "295:14507": {
      "repository_source_sha256": "c93645a5aee444be0b4540b8b41c43d2490ac1f34763355b8c49200f9fb21c15",
      "en": "「Looks tough, but\\n$$チェインバー#pilot$$ and I can do it!」"
    },
    "295:14824": {
      "repository_source_sha256": "c83e5a587e59ac6f6b4ea4eb207c5c7eb4613144f2a21aa6071279266fce7c33",
      "en": "「Don't let them near the fleet!」"
    },
    "295:14853": {
      "repository_source_sha256": "c856e33d1f288064396fa27ab514506b904fc4bcaf692f4b6625d188b5f7625b",
      "en": "「Humanity's enemy? I annihilate it.」"
    },
    "295:14886": {
      "repository_source_sha256": "f0fd62f71c2aa5d4eb54c10969e58848fadd444d8126881042d2c08f6bddc152",
      "en": "「A space monster. Annihilating it!」"
    },
    "295:14919": {
      "repository_source_sha256": "3a6a4afaad06bceb66998fae03b2644a122c8914bee6e053bfe77e1e3e78f6b1",
      "en": "「The Alliance doesn't matter.\\nThey're enemies. Annihilating them!」"
    },
    "295:14968": {
      "repository_source_sha256": "5744cc909e4fb766baff1e750c320910fd1f7949034cabc0f722628903be13c7",
      "en": "「The enemy unit seems AI-controlled.」"
    },
    "295:14995": {
      "repository_source_sha256": "dd348b5c3848a094f2bfd29f4654a227c9de0d47b07ab2e3f1eb7f1c4fbdd0ee",
      "en": "「Now I'm fighting for this planet...!」"
    },
    "295:15038": {
      "repository_source_sha256": "1a53c1795eaa84429e32b511ab5eac1aa3cb0512a0ac131e541011290c77f44f",
      "en": "「I'll crush every last invader...!」"
    },
    "295:15069": {
      "repository_source_sha256": "a3e581a2720ea971749b3e5512df1739b64abac2499cad34cd0ef17f716d85c9",
      "en": "「A top Empire officer! Going in!」"
    },
    "295:15106": {
      "repository_source_sha256": "8c1ab4b1c689fd85fc469a6b1773b233369829c589e590036bc7a2b1102fba87",
      "en": "「But not doing it isn't an option!」"
    },
    "295:15143": {
      "repository_source_sha256": "83ec65ab99210b2db70a43f9f1fccb4dc4c6749e2f92c036eb886f9082c90caa",
      "en": "「Top priority: eliminate that one!」"
    },
    "295:15170": {
      "repository_source_sha256": "6f1ee34c041b39b61f618c2f4774c288290830ca872cb6d4d9493738572d25db",
      "en": "「What an eerie machine...!」"
    },
    "295:15197": {
      "repository_source_sha256": "f2b0499b2b98d8ea1a9cd72b2d81fbc8df73be63fe6dcfc07a251b3b24234aef",
      "en": "「They're brute-forcing straight in!」"
    },
    "295:15226": {
      "repository_source_sha256": "b763ee1d2c6d3dcb01bba2c13d1a4b6ac6cca37a32a360c8806bf76fe32357a4",
      "en": "「In a way, that's the most human...!」"
    },
    "295:15261": {
      "repository_source_sha256": "8381942d4af82d2c17526cdb639e7b885c2a31c001c007e7bb2478216febb60f",
      "en": "「This one...! Somehow different\\nfrom other $$スフィア・リアクター$$s!」"
    },
    "295:15320": {
      "repository_source_sha256": "4253a72b02fe3679af033ad0991f263ec492d63cca8ef072c26723544d9ca9f7",
      "en": "「Beat that one and the Empire's done!」"
    },
    "295:15353": {
      "repository_source_sha256": "15687526fdec3588a51e79580331a94bdb6b1892181dec364734ac6f32bb1941",
      "en": "「Is that one really controlling\\nthat much power...?!」"
    },
    "295:15410": {
      "repository_source_sha256": "41cbe72713e26b5e78d47fa8fbe4c2164f0f14bdc159df22351ecedc76d046b3",
      "en": "「Is death the peace they seek...?!」"
    },
    "295:16883": {
      "repository_source_sha256": "7d9532ae68d012e48495daa56f29a92305d72b06545ac5c6e130a4918e3d35b5",
      "en": "「I fight for the victory I'll win!」"
    },
    "295:16922": {
      "repository_source_sha256": "8b49e16f6aa11a2681e39ec850205edef359930db38ba0a77dc1d6a9972ad3f2",
      "en": "「I fight as a human, not a soldier!」"
    },
    "295:16961": {
      "repository_source_sha256": "5b197754de7b860430d99ce23aabc9ec008646d1b25298964aa7fca91d7d0c52",
      "en": "「I'll fight to protect someone, too!」"
    },
    "295:16992": {
      "repository_source_sha256": "ff2428a84de1833ad8d3da680920d121f5df0176cdb6db43d7df6d0674efc56f",
      "en": "「I fight of my own will, too!」"
    },
    "295:17131": {
      "repository_source_sha256": "0fd484d8d0c66366565fe3591859167770aa2e246c9be3a131ce430ff5fd4832",
      "en": "「No hesitating...! I have to do this!」"
    },
    "295:17201": {
      "repository_source_sha256": "c0150cdf78cbed66892428aaa62f9bacb7365c93ccda1ea8935b5022918967e6",
      "en": "「Lieutenant Colonel $$クーゲル$$!\\nThis is the answer I came up with!」"
    },
    "295:17252": {
      "repository_source_sha256": "8a68ca7a9f4a4a47d705e409e2a571b6c5b64950ec1717e497141fc27f1f69ab",
      "en": "「Lt. Colonel $$クーゲル$$! Won't back down?!」"
    },
    "295:17295": {
      "repository_source_sha256": "ddd63de864492ae6653a681cbfca3f45ee27c5ba868f59ef90acd2b840fe5aa2",
      "en": "「Even if it's you,\\nif you lay a hand on the fleet...!」"
    },
    "295:17348": {
      "repository_source_sha256": "87b5b12ae52e4f43ad3bc543b4653eb62448c6c7198de3086cf482530313998a",
      "en": "「Prosperity and peace\\naren't yours to give!」"
    },
    "295:17401": {
      "repository_source_sha256": "c7e0247cb4ba6736201ba412cf0bc988115744b8d33d70b38865c580867e698a",
      "en": "「We'll stop you...!\\n$$チェインバー#pilot$$ and I will!」"
    },
    "295:17454": {
      "repository_source_sha256": "100f4b8e8bb2c7a31b3c4f5b92e6fbbb908c816bb48281d1798730c7f3cb9c90",
      "en": "「This planet has no need\\nfor a being like you!」"
    },
    "295:17503": {
      "repository_source_sha256": "c5090be4bb75b74be3932a803f5f4732583fdeee180c5348ba64183bc85057c6",
      "en": "「Neither I nor humanity will perish!」"
    },
    "295:17536": {
      "repository_source_sha256": "1d7be2a1432628b78724fe37a96ee15b9a4380e3c6b113fb0782209f82f12190",
      "en": "「I'll protect them...!\\nHumanity, the people dear to me!」"
    },
    "295:17585": {
      "repository_source_sha256": "6256c214db144e1cf80024de846c2b821afb7926fb55b007581ed4f5eed4cba8",
      "en": "「I'm not fighting for a mission...!\\nI fight for our future!」"
    },
    "295:17652": {
      "repository_source_sha256": "c2a2e446a129d2b06e89577de8ca28176ea2cf8c238dd6fb45caed32def7ee0b",
      "en": "「Here, I cut the threat at its root!」"
    },
    "295:17681": {
      "repository_source_sha256": "f29321f75f3543b63c836a1b3d1dc85a0cb6ef01f3e38376c2e1799510d6fdd0",
      "en": "「You make humans fight each other?!」"
    },
    "295:17718": {
      "repository_source_sha256": "1a3632bbef4071b674a4e510e2f03e0fa84b4d06807b59f5f1ac1cdf294e08bc",
      "en": "「I can't accept someone who\\ndecides things by force like you!」"
    },
    "295:17779": {
      "repository_source_sha256": "107aa850d0d66c6094481a2e5ebd05c33318e1c0669e3e1bf77457baa39fe72e",
      "en": "「Beat you masterminds,\\nand every battle ends!」"
    },
    "295:17834": {
      "repository_source_sha256": "3d122c995378effc0134b05aa59eff917a85bbfbb726ad65adc300c9af57f204",
      "en": "「How can one who takes lives\\nbe an emissary of God!」"
    },
    "295:17889": {
      "repository_source_sha256": "f8d72d337e4a5a688f3d5ea6c9bbe2e592df50de63c386700d46a54c6aad4f32",
      "en": "「You're the same as $$ストライカー#pilot$$!\\nYou're not gods!」"
    },
    "295:17948": {
      "repository_source_sha256": "a407a5b19268b62eaaeeceba8838d4d957336c405404f0ba0c2f062406631e4f",
      "en": "「It's not us who should be condemned!\\nIt's you!」"
    },
    "295:17997": {
      "repository_source_sha256": "e8e6fa7b212cda72691afbafdaf6e672c223b2b98d209bee4e9b8d6342fb19fc",
      "en": "「We're not fighting\\nto amuse you!」"
    },
    "295:18056": {
      "repository_source_sha256": "2398da609079cec6ad8f53b6f839dbe60c43fbcaf8ed8cad87724dc2c09c464e",
      "en": "「You're a traitor!\\nThat alone is reason to defeat you!」"
    },
    "295:18109": {
      "repository_source_sha256": "3cfeb1da0eaf381e5384510a18539be5fb004fd86b8deb3395dc86d885c1a1ee",
      "en": "「$$アドヴェント#pilot$$!\\nYour joy brings someone else sorrow!」"
    },
    "295:18170": {
      "repository_source_sha256": "07148363eb0c6d17e8e6b23a447150dc5f2c7d85711d4f3d3015c22d081e6d13",
      "en": "「God never chose you!\\nYou're just being used!」"
    },
    "295:18239": {
      "repository_source_sha256": "454253307595cb87ba75da39cfa393b658c105673af973009ffd17a1107d5e34",
      "en": "「Those borrowing $$御使い$$s' might...!」"
    },
    "295:19091": {
      "repository_source_sha256": "b012fc08836bf8a5871723f448a284e81fba340be25143d38d8e02aefe7d619a",
      "en": "「Then I need you to do your best too!」"
    },
    "295:19134": {
      "repository_source_sha256": "aaaf51c9a5a8eee2640dc9e3076b2f316c1121f0d1714aee692e965e233c27fe",
      "en": "「This is our fight!」"
    },
    "295:19159": {
      "repository_source_sha256": "013c7c7d56ebf334d43686ab61303fcbca19ae9edd306b84e56a8c6ee932d1d2",
      "en": "「No retreat? Then I have to fight...!」"
    },
    "295:19192": {
      "repository_source_sha256": "17797b5b101b1151d037cee685f626e75381e1371c570fdfc513f6cec5e4998d",
      "en": "「Is this all I can do for now...!」"
    },
    "295:19225": {
      "repository_source_sha256": "d0a11c638ae062500dfc0f03402c3dd4da8318da54bb5ff6723f63966f00270b",
      "en": "「Humans playing God and judging...!」"
    },
    "295:19266": {
      "repository_source_sha256": "f6e2a4568f7eaabe8b400cec9eaa89687a7e5b4fc8776c74e203179865e86f7f",
      "en": "「So, Lieutenant Colonel $$クーゲル$$!\\nWe're going to stop you!」"
    },
    "295:19323": {
      "repository_source_sha256": "6a6af3449cc178e885889b485ad05d4f40a44bcace1aac8f5a000e408760f2b6",
      "en": "「Take that one down, $$チェインバー#pilot$$!\\nThat's our duty!」"
    },
    "295:19384": {
      "repository_source_sha256": "a7c239b54d63dfcd03900f3337d8697bc0a14eb737971876854c55e6c436d7b5",
      "en": "「Exactly! Let's do it, $$チェインバー#pilot$$!」"
    },
    "295:19425": {
      "repository_source_sha256": "21f03afb536c314295753492cb5251abc6f62d78f9bf6128a9bb4289900d5c9f",
      "en": "「$$サイデリアル$$...! We'll stop you!」"
    }
  },

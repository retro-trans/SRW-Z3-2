      "en": "「Our common sense won't work on them!」"
    },
    "295:10253": {
      "repository_source_sha256": "64516c269a8597ce847d87c560d7b83df4d9fa867078bb76da81685c07e174ca",
      "en": "「No signs of life...!\\nThen I won't hold back!」"
    },
    "295:10304": {

    },
    "295:14074": {
      "repository_source_sha256": "23bda8816c3d93540cde4a42ed13a957c04c42bffab8a0a80682898a116c6878",
      "en": "「$$エイミー$$... everyone...! I...!」"
    },
    "295:14109": {
      "repository_source_sha256": "c5f6ef0d4704d9c0b8718d2fceaf03c1fbf315a9575a3aec79a5815c4a878cdd",
      "en": "「I'll fight...! To the last instant!」"
    },
    "295:14144": {
      "repository_source_sha256": "b644c389235779af1d5c45124a0aa114b6676cd19c192ec3e0a05a0d0d4d1395",
      "en": "「I can't die yet...!\\nI can't afford to die!」"
    },
    "295:16514": {
      "repository_source_sha256": "e4468a5a8d14fbc276fc9e073fb1031e4c5137a813f60c4884b06a74ecb9b7dd",
      "en": "「As I thought,\\nthis is no easy enemy to beat...!」"
    },
    "295:16565": {
      "repository_source_sha256": "80bb05e40ccfc0b5ced2c99619af3a1a57a43da953ca43993d9271f70bfaea0a",
      "en": "「I won't let that thing run wild!」"
    },
    "295:16606": {
      "repository_source_sha256": "3bc985254141b1b57986fa7d5330b7cb911e6df4612346c548663edaafbd21d7",
      "en": "「Not good...! Should I retreat...?!」"
    },
    "295:16649": {
      "repository_source_sha256": "f2ed8909aaa35586d22f6ec138efb5565b4df539f9169bc0ca48e40a2754c6a0",
      "en": "「We'll turn that around!」"
    },
    "295:16676": {
      "repository_source_sha256": "719287ecc358e35c8e706daa462c129578663b8aa0c726e0a501a0cdcf01672d",
      "en": "「I'll break the deadlock before then.」"
    },
    "295:16707": {
      "repository_source_sha256": "f3ed5c1697533b8f386e347dcb246376e10555e650d803c4584df8b6b8b7d5a1",
      "en": "「I'll figure something out...!\\nWe can do it too!」"
    },
    "295:16760": {
      "repository_source_sha256": "c09d4f1907b11b19b38466e40549c211a17755f1d1126f5b555bd2d1da276b9c",
      "en": "「Hold on, $$チェインバー#pilot$$! We're not done!」"
    },
    "295:18589": {
      "repository_source_sha256": "4347542540c543be386b171fbb18d4232e5149dea17a3e29ee93d916ac647b95",
      "en": "「Ignoring how I feel,\\ndoing whatever you like...!」"
    },
    "295:18640": {
      "repository_source_sha256": "a09d49e1b090214ef0ff3a5d7bd18a314fbf93e6dae3a915c488b30cd9f2cd20",
      "en": "「Is this enlightenment too,\\nLieutenant Colonel $$クーゲル$$?!」"
    },
    "295:18693": {
      "repository_source_sha256": "d07d3d23b2c672a78cd1507e9d3909b530d6ed027bf1d7b3534d2942a034905d",
      "en": "「I can't back down...!\\nEven if it's the Lieutenant Colonel!」"
    },
    "295:18748": {
      "repository_source_sha256": "6f380a475664ed5c201fa76137a493110688f766683dec2dd00a0e8e645a64bd",
      "en": "「How's it this strong with no pilot?!」"
    },
    "295:18789": {
      "repository_source_sha256": "0515e7967036bca47b9029f59b2c5124d45a500e9f5f0de32c7eddc195de9cc0",
      "en": "「I can't lose...!\\nEven if we both fall, that one...!」"
    },
    "295:18844": {
      "repository_source_sha256": "f1bff6aa1181cf7d4f29dc45e3f774dfc7dddea43502e2524ca4f79ddb557c4b",
      "en": "「I won't let you destroy me\\nor humanity...!」"
    },
    "295:18899": {
      "repository_source_sha256": "6f2be785ad64495bf52749361f3ddb8c572641aad58e2de4e44a565414da6a9d",
      "en": "「Must we fight them until\\none side is destroyed...?!」"
    },
    "295:18958": {
      "repository_source_sha256": "f62048d4cc1f5a8dbc1ab663d96f692656a5d691204a4baf2d86e348a1196ae2",
      "en": "「I won't let my way to live be shut!」"
    },
    "295:19001": {
      "repository_source_sha256": "c6efec295bb72bca59b1dc5cd4c6d665aa82e54cbd9da015e7d9bffb03e0e4c2",
      "en": "「Not yet...! I have a home to go to!」"
    },
    "295:19042": {
      "repository_source_sha256": "5c91149993228cd228a3409abbdea874f12f2268f3bbd423feadf8e8ea8da69f",
      "en": "「$$エイミー$$... everyone...!\\nI can still fight!」"
    },
    "295:21229": {
      "repository_source_sha256": "58385c5662877e481e82b70a8cb7fca1effb03ceb67eb19d1f68764e0c8a2010",
      "en": "「What is this power?!」"
    },
    "295:21256": {
      "repository_source_sha256": "3de68386c674b6fef86c712787d45b1d6901f4d3f7e2f783cf4b4f0d6647097f",
      "en": "「I can't be taken down!\\nNot with $$エイミー$$ and the others waiting!」"
    },
    "295:21315": {
      "repository_source_sha256": "c53f0e4adf1e14dfc067c2509915e7c6b1ed7cb980fa30f1cc3da031ced1a989",
      "en": "「No matter how much I take,\\nI'll never submit to you!」"
    },
    "295:21372": {
      "repository_source_sha256": "ced0900aea021c1d3be3e6b16a5b7e3887d2a7633ece659d2564534dbca54430",
      "en": "「Specs alone don't decide a fight!\\nLet's go!」"
    },
    "295:1442": {
      "repository_source_sha256": "90955947fb0103a0fb24646e01f0354c69deef3d24b65fcec95bc7c1d600b1e5",
      "en": "「Hit. Optimizing auto-maneuvers.」"
    },
    "295:1483": {
      "repository_source_sha256": "b1e6ff55199a66a38d520418b83ef3ea29c7e5f4fd178ee5f7082fc7d21babc7",
      "en": "「Damage past safe range. Alert up.」"
    },
    "295:1526": {
      "repository_source_sha256": "48af056992604a7a06ff61171debecfe71afaf11eb8690fb00ff3d2f7a4ee79e",
      "en": "「Damage exceeds expectations.\\nTactical review required.」"
    },
    "295:1581": {
      "repository_source_sha256": "993a77242476350954ea9a239845ba71bb556a388dc47f794dfaa6985e52795d",
      "en": "「Situation danger level increasing.」"
    },
    "295:4666": {
      "repository_source_sha256": "86bb155350d35688db176b20fac9f7fa84eedb4ab970403e802cc844678fa17c",
      "en": "「Enemy threat updated. Be on guard.」"
    },
    "295:4709": {
      "repository_source_sha256": "abdc1822b0b3f67509493cd1ea462fa46454adeed4649f8236470745e2926d0b",
      "en": "「Advisory.\\nFurther damage poses a serious risk.」"
    },
    "295:4760": {
      "repository_source_sha256": "11c6ddf6814bb7344ef303a02a4464a723a759b053405ac719739a7799ec55a6",
      "en": "「Warning.\\nMore hits will hinder the mission.」"
    },
    "295:13290": {
      "repository_source_sha256": "9bc5704cd76e78359903578986b09e01f75d251487cb7b1e1765b7c757d95ab3",
      "en": "「Ngh! Not yet!」"
    },
    "295:13311": {
      "repository_source_sha256": "175c5804729fb270e7346e96e308e259cb8c76da7e7a84f8d5f9f22e8f549a22",
      "en": "「That unit... it's strong!」"
    },
    "295:13334": {
      "repository_source_sha256": "a152011a5ee49eaa00392c94ab5039c4341a8cad20bb5d298e199535fca9fe94",
      "en": "「Accurate attack...! But!」"
    },
    "295:13363": {
      "repository_source_sha256": "646fd6c4c414e0399dbd022741441450031b65600957ae42c47928ae841066e4",
      "en": "「To think it can attack like this...!」"
    },
    "295:13396": {
      "repository_source_sha256": "dfb5fa960c331b50a942fa3449b93d1efb0956a2edeec0b2190ae4198d15b982",
      "en": "「I need to regroup somewhere...!」"
    },
    "295:13437": {
      "repository_source_sha256": "5d347280e011308ff508f21a6e07ceceb46124c36a7c5fe5efaf6b4e57bdb559",
      "en": "「I can't be cornered like this!」"
    },
    "295:13480": {
      "repository_source_sha256": "14929189b078cae2aa6dc031b4f3574c8ea3d387ccbe6848756802048cff6e5a",
      "en": "「$$チェインバー#pilot$$! Give me more speed!」"
    },
    "295:13521": {
      "repository_source_sha256": "dfe0e5e0a40b25cf6808821802488af113f2a7c8b895298d06132c2ba3921950",
      "en": "「We're avoiding further hits,\\n$$チェインバー#pilot$$!」"
    },
    "295:13570": {
      "repository_source_sha256": "3e7dd370f2dbff51776d78c2b051022d74a3b58f00cece2bb8bb33bd8a50b0bc",
      "en": "「So annihilation's the only way...!」"
    },
    "295:16382": {
      "repository_source_sha256": "c4458b6c61c163f35a8e8be4db66f5f6ab1348d591c492759df5516c1da4d38d",
      "en": "「An enemy to watch out for...!」"
    },
    "295:16407": {
      "repository_source_sha256": "475de7937722382868798ab9ba0995c20e1f4863a9152e2f39ce168fc7a79254",
      "en": "「But I can't fall back!」"
    },
    "295:16434": {
      "repository_source_sha256": "16453c2af2f65dfebdc630bca4a2ce1583ca3fe259067f55cf4111d480b747cc",
      "en": "「I'll end it before it turns fatal!」"
    },
    "295:16477": {
      "repository_source_sha256": "a46ab91dbb6d887ebf1b97506a5d172b76c9331b1446f2155fb6907ab047c794",
      "en": "「If you know that, then evade!」"
    },
    "295:1312": {
      "repository_source_sha256": "fd36c3f929781a2fda32ebf0a3f9bb347b9b1fa9e250d571f5344eda62e5fe96",
      "en": "「Enemy attack threat is low.」"
    },
    "295:1337": {
      "repository_source_sha256": "f63d8290f9981a78ec755471fa55694a8033dcdd4df6add4630253d514ff0aba",
      "en": "「Minor damage. Continuing combat.」"
    },
    "295:1366": {
      "repository_source_sha256": "e5017c2a9ded32267f3bdd37180d84d8dc9a002742edc6dd26e4046a20d9834e",
      "en": "「Your combat skills cannot\\ndestroy this unit.」"
    },
    "295:1415": {
      "repository_source_sha256": "4890d819310eaa76155d0fe0064d7ccd202e1be0abf0c8832ee9e2beb6dd1e81",
      "en": "「Threat rated low. Minor attack.」"
    },
    "295:4565": {
      "repository_source_sha256": "10c817e98275cf67971b275d9fb388258cb990cce0706ba9d0b7fd83a7b5f640",
      "en": "「Extremely minor. Combat unaffected.」"
    },
    "295:4600": {
      "repository_source_sha256": "a4a230022d996da9d7b28ef82399e1a0db8f0e633f15b9f593785ed78b7ce6ad",
      "en": "「Hit. Only grazed this unit's armor.」"
    },
    "295:4643": {
      "repository_source_sha256": "5beb2c50859f2626e272917e0f32b1b82a7016fcdfa70609e40715459f3358cf",
      "en": "「Hit. Output down 5%.」"
    },
    "295:5944": {
      "repository_source_sha256": "c380e4f17dcf355c48da5e443ff9d9fdd7e5429dc7846de94d2b33f81bf2cd4e",
      "en": "「No significant gap in combat power\\nbetween enemy and this unit.」"
    },
    "295:5995": {
      "repository_source_sha256": "b4f1a5efb9338dc15af67333b419e522d8ae52838e2e00a4a7626753f172b438",
      "en": "「That attack can't destroy this unit.」"
    },
    "295:6038": {
      "repository_source_sha256": "8df2c7fd07ebbf86fdda04ad43bddf4a6c40236f367bf942ac66f5d63d16e1fe",
      "en": "「You exposed a flaw in your program.」"
    },
    "295:12655": {
      "repository_source_sha256": "a0b57703712df34b406f6c3604bb325d2ff1a71a72664d49029643f8e685f2bf",
      "en": "「One of the less dangerous\\n$$ヒディアーズ#keyword$$, then...!」"
    },
    "295:12706": {
      "repository_source_sha256": "9fc240499b64df2d507edaea3574a1a32abc3668ea9f566e98b7a14706d6f518",
      "en": "「No brute-force $$ユンボロ$$ beats me...!」"
    },
    "295:12749": {
      "repository_source_sha256": "8283412c4131138bafba023cd31560b60e50bd4076ce2e3181faba02b2bbf007",
      "en": "「A direct hit would finish me,\\nbut...!」"
    },
    "295:12798": {
      "repository_source_sha256": "87c61b12139d3d13f849368e3ef4e18294df9cdb52338a1710bdb5aa492f01b8",
      "en": "「With our mobility,\\nI won't take a direct hit!」"
    },
    "295:12974": {
      "repository_source_sha256": "c0c05c6817e371600ffcbb8f2d181a02c7250494b4a538fdf35a5f43a0b72985",
      "en": "「It's not enough to threaten me...!」"
    },
    "295:13005": {
      "repository_source_sha256": "7b858177ea004219435c58e6298991e41a8f391582f98d6f618dff25cd39c290",
      "en": "「I feel no real impact...!」"
    },
    "295:13040": {
      "repository_source_sha256": "f6d8422dbf9ff21856c62f4c04ee705e1dc986ae47e5ba8656947e17abffc0c5",
      "en": "「If it doesn't hinder combat...!」"
    },
    "295:13073": {
      "repository_source_sha256": "974011bda847a015149d23d8bf937f157b4a21dee91b0d373dad36a73d489d19",
      "en": "「Ignore minor hits!\\nJust avoid direct hits!」"
    },
    "295:13132": {
      "repository_source_sha256": "508ed36b825e4908eca0a76ff8279deba002bc6404590f0d70a164f4396a896d",
      "en": "「Was I too caught up in attacking...?」"
    },
    "295:13165": {
      "repository_source_sha256": "a900ca0b6caf4a6ef5a7652c7a73a68700e47d11b2c72185dd5cfebbd9f44ec8",
      "en": "「Ngh...! My judgment was late!」"
    },
    "295:13196": {
      "repository_source_sha256": "8c99a8251a121c82166c3a0faaa054d90e995c00c9b9654d6007a049e30aa173",
      "en": "「They read our evasion pattern...!」"
    },
    "295:13237": {
      "repository_source_sha256": "9da65b2b706c13f69921e90f4b5d3322deae045a5969d11a28d4a2ffb6df86d7",
      "en": "「$$チェインバー#pilot$$!\\nRework the evasion patterns!」"
    },
    "295:16226": {
      "repository_source_sha256": "d5cfd38f2ee6402bfd46e5c239dd31b9176070fa4dd49a1068d3e14e64c9771e",
      "en": "「$$チェインバー#pilot$$, report the damage status!」"
    },
    "295:16265": {
      "repository_source_sha256": "af1a861c9698040f89533bcd6f54e38cd4ab58d131b250f98a6855793dc598e4",
      "en": "「But I can't keep taking hits...!」"
    },
    "295:16308": {
      "repository_source_sha256": "3ce1fced90acd45bdbb455c39898a54db7d11829a23b49038a26a6534fbee6f0",
      "en": "「If it won't hinder combat, fine...!」"
    },
    "295:16341": {
      "repository_source_sha256": "31e6c98a7e8e70d23047d222bcd48c2cb98c19228ccfb8c9d4f75df119395fbc",
      "en": "「Ignore it! Report once over 10%!」"
    },
    "295:18270": {
      "repository_source_sha256": "8e7c3085e13a394c7adcf2dafcf05537b571324b19705a0d3b2bbf7c0482779f",
      "en": "「Stop it...! At this rate...!」"
    },
    "295:18307": {
      "repository_source_sha256": "4efb45d8e42003d184df486c5118b887065bc00a203ce1abdac41eb7ab17f57d",
      "en": "「Lieutenant Colonel $$クーゲル$$...!\\nPlease stop fighting!」"
    },
    "295:18356": {
      "repository_source_sha256": "ead37064afb92cab9afeea5ae93f45e94aefd2c7dcfba3eb520de784a2da54ec",
      "en": "「Lieutenant Colonel!\\nThis fight has no meaning!」"
    },
    "295:18407": {
      "repository_source_sha256": "8ea0a53535eb6e962432bc9be265ed30fdad048c039205623beacb5fe6da0264",
      "en": "「Without Lieutenant Colonel $$クーゲル$$,\\nthis is all you are!」"
    },
    "295:18460": {
      "repository_source_sha256": "bfba38d89299b7b39719f89b847f5f5a7a5b5546c346202fe20807ec04878953",
      "en": "「Still going to call yourself a god?!」"
    },
    "295:18499": {
      "repository_source_sha256": "6845b8de4af3515d4b3f4305f33968a646754b85f24ac7a3b3ef97eb795ca965",
      "en": "「Don't mock humanity, space monster!」"
    },
    "295:18532": {
      "repository_source_sha256": "e6865f23ad5386558dcc271ba4159c9472c204ded702058739c4bf3581cd4060",
      "en": "「We fight carrying the futures\\nof so many people...!」"
    },
    "295:21102": {
      "repository_source_sha256": "d662a46d6409e607a7b050495133affbdce2f4d89282fc6220e02db789fd4b25",
      "en": "「Even a superior model, with this...!」"
    }

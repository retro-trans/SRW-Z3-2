      "en": "「Possible. Request swift destruction.」"
    },
    "295:4496": {
      "repository_source_sha256": "8983f957701353a6c6c9f064539006a3d27ea1e52ed3bf46e0f305b7e9213bfb",
      "en": "「Understood. Collecting data first.」"
    },
    "295:12366": {
      "repository_source_sha256": "0481c6b969c77e0b1ba0bf40038d10d58798a7032310e79b203bbf65639ba7a9",
      "en": "「That attack is way off target!」"
    },
    "295:12389": {
      "repository_source_sha256": "d494163f38b2cd08de0ddacfb568d9e2212f887c05198b41d8b38a49432c37f2",
      "en": "「I knew that was coming...!」"
    },
    "295:12416": {
      "repository_source_sha256": "68d69236eb61efda42d249e8d0b1281e601fc789652644e30e9140906e593fd0",
      "en": "「That was close...!」"
    },
    "295:12433": {
      "repository_source_sha256": "ad39ca9eaf8ff2aa89c64c488d6a4220a66de02d2e10e3f348de8cd424305d99",
      "en": "「A late call would've been bad...!」"
    },
    "295:12472": {
      "repository_source_sha256": "3e5eadd29116c1ebcf78ef2883af35c568d53769d5394bc47164c4aaa570e944",
      "en": "「I won't fall for a dull pattern...!」"
    },
    "295:12507": {
      "repository_source_sha256": "2eb8233f7e82ae411a121b6abee137fef9a2c6a1f10206454d2e19642c524224",
      "en": "「The danger isn't that high...!」"
    },
    "295:12540": {
      "repository_source_sha256": "ebfaa6defbe6261232f0bf20fa84ae5c60e4e71ce59f7d12db4efefc7e1d42c0",

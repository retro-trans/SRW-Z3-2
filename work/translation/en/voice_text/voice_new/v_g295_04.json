    },
    "295:2862": {
      "repository_source_sha256": "45a00f551d57cad99ac45f3383345a328dd37bc1e50c2166af741b94127e23fc",
      "en": "「Enemy data updated.\\nOptimizing evasion program as well.」"
    },
    "295:4336": {
      "repository_source_sha256": "a9d5ebcd43184b258556575aaededb401019da7b2cec5b109311344ac042648d",
      "en": "「No problem.\\nEnemy attacks are fully predicted.」"
    },
    "295:4385": {
      "repository_source_sha256": "1feca903c945458015c56374a4e80ec436059998089b30ca0153d95d0e873c2d",
      "en": "「No logic found in enemy attacks.」"
    },
    "295:4422": {
      "repository_source_sha256": "64d8e55f5e9221e26a8d18b7473d751f9f69008549be708abe0af3f06c0b2f10",
      "en": "「No damage. Evasion continuing.」"
    },
    "295:4453": {

    },
    "295:12575": {
      "repository_source_sha256": "2b099aed391d40eb2a59cbf7ea5b69ed0478f8f399a957477f8e961e18ddcb7d",
      "en": "「Well done, $$チェインバー#pilot$$!」"
    },
    "295:12606": {
      "repository_source_sha256": "f3bdadc0233b8451dcf3428c1253bb89677e9511f797fb300faf94f23a3999b6",
      "en": "「Hold this speed,\\n$$チェインバー#pilot$$!」"
    },
    "295:12847": {
      "repository_source_sha256": "77e35850251c1e44729a81553125e6228094ae2cc5be6a404146680e23dadaaa",
      "en": "「Even if it's a space monster...!」"
    },
    "295:15970": {
      "repository_source_sha256": "db7ec5bdc8e5e19b92ed268f3875589ac39b71961472eb2666afdfebdd7395d9",
      "en": "「Good dodge, $$チェインバー#pilot$$.」"
    },
    "295:16001": {
      "repository_source_sha256": "a11a7a04fcb416308d33205e2cc27857ba65c9c358e52e5252eb3e46f9a18a35",
      "en": "「Stay alert. The next one's coming.」"
    },
    "295:16030": {
      "repository_source_sha256": "345872dfd38b26e13fc0b6db5408aa90aee07c5e2d9b85c1e22a26bc86c8ed69",
      "en": "「So in short, it missed the mark.」"
    },
    "295:16061": {
      "repository_source_sha256": "1d87db84cdd8584057c7b81263e753e0878e912e4824a678b95558ea52a84548",
      "en": "「Watch for their attacks and counter!」"
    },
    "295:16100": {
      "repository_source_sha256": "2cd314b668cb0c8e852458214a5ceada1833697e46873a6ebc972399b2b3127b",
      "en": "「Space monster, was that a feint?」"
    },
    "295:16135": {
      "repository_source_sha256": "a9eac82e9a682dddc7a86367feda7b778ae5528299427f0deccf7b18a9c5e82e",
      "en": "「Collect enemy data while you can.」"
    },
    "295:1260": {
      "repository_source_sha256": "ebe894a6ecebd7e6e39722214ce3d6c81a5f2c50a8d896300819e63245727a57",
      "en": "「Anti-shock defense.」"
    },
    "295:4546": {
      "repository_source_sha256": "c04cd02bd1e4b90a4f988895176f2e2764330e27824f47add4454d6a0f336d24",
      "en": "「No damage to this unit.」"
    },
    "295:16178": {
      "repository_source_sha256": "1e824b18850d17873dee00cf5a39d131a94855eaa954253dd6be82323dc082e9",
      "en": "「A pointless move...!」"
    },
    "295:16199": {
      "repository_source_sha256": "8ce151f4739be43fc18ced116895270093f0d2a606129625ff6fc8a3ffc259d6",
      "en": "「I'm moving to counterattack!」"
    },
    "295:1279": {
      "repository_source_sha256": "f32b7430b4b8f16df74b0b050d5a668b98eb3bf1b8fa79970961d8f73d16f6a7",
      "en": "「Gravity Weiver, deploying.」"
    },
    "295:12878": {
      "repository_source_sha256": "dbfdeadb02bb37745d3227031404de74b0f5e6a578ff5d5e74eb78fbb8c57c34",
      "en": "「Gravity Weiver, deploy!」"
    },
    "295:12913": {
      "repository_source_sha256": "4ed1351a044ae155141f050f7ac90a8cea7c71a51c3ffe9d73195a40b4689491",
      "en": "「The Gravity Weiver can be used\\nlike this, too...!」"
    },
    "295:6194": {
      "repository_source_sha256": "db9846068fdc4538dee5b4f5fd2a2d74a029dce7f595af0a043aa8d562177f6a",
      "en": "「All this sky and sea will bring you possibilities.」"
    },
    "295:1910": {
      "repository_source_sha256": "2e21a65c169026c6d102ebe67a54e1acda581f34d025cb62ea67f4ec8be7735b",
      "en": "「Save data storage confirmed.」"
    },
    "295:1939": {
      "repository_source_sha256": "2d9c7f3d52472c7748fb61efab81c2af8fcf903f5a2c9ac80f9ed7962301b5e5",
      "en": "「After the game, players have the right to free sleep, food and drink.」"
    },
    "295:2002": {
      "repository_source_sha256": "af25b52a161934f724d9f44518e5634b56c60e379b2e2467a332b6eea175e04e",
      "en": "「However, your mission is not over. A swift return to the front is expected.」"
    },
    "295:2067": {
      "repository_source_sha256": "eb03c2ec769af0d947f43cd34852622724f910333c9a2053471846cbfd92218c",
      "en": "「Given this unit's energy system, there is no impediment to activity.」"
    },
    "295:2116": {
      "repository_source_sha256": "5127d7fa31bf4eda5110d7c6a3b536eedb5a346c8a7c96e120a5fb25261dcbbd",
      "en": "「Understood as praise, or goodwill, toward this unit.」"
    },
    "295:2157": {
      "repository_source_sha256": "5ce0122861844ef0fedb5d219884b6586737cc173991f3bc79281c991070abb9",
      "en": "「It is a function for supporting Ensign $$レド$$. I make constant suggestions so the Ensign can coordinate better with those around him.」"
    },
    "295:2254": {
      "repository_source_sha256": "cde7a3a0b31569b9eb263880174180a2aa5755401035e8aaef3497252db05343",
      "en": "「Yesterday I suggested a manner of speaking that pleases young women, but the Ensign strongly rejected it.」"
    },
    "295:2329": {
      "repository_source_sha256": "46bc14a73ca6da037eb7af793f843b880222072689bcd7796725eb0819647c19",
      "en": "「Ensign $$レド$$: super mad, MG5. Chamber: yucky, mega-ultra-dire.」"
    },
    "295:6249": {
      "repository_source_sha256": "88f38b62e5f58699cab4272d87ba1ae5e812fb457078ba2a8bbf833400698d6e",
      "en": "「Affirmative. Furthermore, combining it with a support attack at that point allows more efficient damage.」"
    },
    "295:6342": {
      "repository_source_sha256": "8486b48d6af5d5a9f56bcea65aba41e3db0a9df418fe8a17f7cdf8c0d87ca6f5",
      "en": "「Ensign $$レド$$ is inferred to have an insufficient grasp of the battle system. This unit recommends attending its SRW course.」"
    },
    "295:6431": {
      "repository_source_sha256": "7411c7c68f179f613ba5f6f011615338a03068c30dc47de51c58ae18c0c06560",
      "en": "「Get set. To that end, this unit has cleared every SRW game.」"
    },
    "295:6494": {
      "repository_source_sha256": "b3d4238f3a4c332d35bda00ffe3627354c886b1eeea0a444bf3e584edad8a2b3",
      "en": "「Get set. To that end, this unit has cleared every SRW game and listens to Umasugi WAVE every week without fail.」"
    },
    "295:6597": {
      "repository_source_sha256": "b27ffd1961acdb109f44dfafc3e623b88d1d05294dcbaa89be29dca4874d9330",
      "en": "「Get set. To that end, this unit has cleared every SRW game. Ensign $$レド$$'s current level of understanding is below mori soba. Super, awful.」"
    },
    "295:6708": {
      "repository_source_sha256": "f23d974334a07df35fcf5a17b08000c2223ee027c17a571bccbd74d6fc964bf2",
      "en": "「Inferred from the number of remaining enemy units. Annihilation is possible at this rate.」"
    },
    "295:6753": {
      "repository_source_sha256": "30c7d95ead3a0fb3941a7766c508e3c9fb7827bb16c802b4198f3420eb362a2b",
      "en": "「Skeptical suggestion. You are not registered as a pilot in this Super Robot Wars.」"
    },
    "295:6836": {
      "repository_source_sha256": "631c869734b1c42d956d41aa10cc4755189c5c1642742652cd5a32e61a827285",
      "en": "「...I can find no logic in their behavior. Therefore, in accordance with my program, I will end the game.」"
    },
    "295:6919": {
      "repository_source_sha256": "d6208c4a1a26fa0fd2472360f87ab9ec26c01116ec1bd424226579d95d2f1989",
      "en": "「I expect to meet you players again.」"
    },
    "295:6958": {
      "repository_source_sha256": "cc65dfa3404756971e50a0f7122448528bf5c979f1b36072370e85bb4b19ac82",
      "en": "「$$レド$$, you're still playing SRW...!」"
    },
    "295:7003": {
      "repository_source_sha256": "886b309a2d6495179fc19e31ebffba809df0d9c77466b384cbc1f356b004ddae",
      "en": "「No good, $$レド$$. Take proper breaks!」"
    },
    "295:7052": {
      "repository_source_sha256": "eb6bbc157736e9b62d579bbd6299c35466bcd59840816a51acdd1ccdd8f7811f",
      "en": "「Players, working hard is important, but please take breaks in moderation, too.」"
    },
    "295:7129": {
      "repository_source_sha256": "36231497d65bf5424ed96073abc67290b45380c630f70bedfab27873cb834eeb",
      "en": "「All right then! Good work, everyone!」"
    },
    "295:7162": {
      "repository_source_sha256": "80958bac631eaf195e4113d25cf700dad41f99772bb598be187d150819acbd48",
      "en": "「But $$ピニオン$$, you're always wiped out.」"
    },
    "295:7217": {
      "repository_source_sha256": "c05bff1f1a5b0be4cdfd2eabaffaa26560c19b3be8abb9dab839c44e53fdb704",
      "en": "「Players can mod and train however they like, but try not to end up like $$ピニオン$$.」"
    },
    "295:7320": {
      "repository_source_sha256": "6c76808826f6450d5d5a43fbbba10648606b8869adb17339fc77481fad3af449",
      "en": "「Good work, players.」"
    },
    "295:7359": {
      "repository_source_sha256": "288c53651491160587f4331d389d536a060e6281418f4318ec6806d469704931",
      "en": "「I'm greeting the players who enjoyed Super Robot Wars.」"
    },
    "295:7440": {
      "repository_source_sha256": "2a596d487394dde51f8d6bf2c7d36a3e50e9225ec03024cbc25be88cae860b9a",
      "en": "「That's it! You try it too, $$レド$$?」"
    },
    "295:7473": {
      "repository_source_sha256": "f174f2977ec2692caac74ce2478f3ea4e91efae6ccdf2846a17e6ddc1f5e5a18",
      "en": "「It's okay. I'll teach you.」"
    },
    "295:7514": {
      "repository_source_sha256": "613a55b1a0b947f8da1746622b2723d4488ccdf9304cb306ff9fba52a09cbda9",
      "en": "「Well, players! Rest, then come back!」"
    },
    "295:7589": {
      "repository_source_sha256": "389d0ab806cb5ea56440bb0cd3124b39d0f2c0fd300c928d3d5ce03ba4afde02",
      "en": "「Good work, $$レド$$, too!」"
    },
    "295:7610": {
      "repository_source_sha256": "3c58faea3d201d30feb5f62d56824a5dcece91bc14a768d42f6c379580cd0b43",
      "en": "「Good work, $$ピニオン$$. I've got a game software delivery for you.」"
    },
    "295:7659": {
      "repository_source_sha256": "ec40578297b12bf452d42130c26be22634d1f60cfe7d2505b2ab7cfa9cfa11ae",
      "en": "「If you wanted it that badly on release day, you should have bought the download version.」"
    },
    "295:7734": {
      "repository_source_sha256": "ebbdf9289a01b52f948cdba755b75bc21fa9d2469796dcd480f1e35b26daf3aa",
      "en": "「Players who don't want to end up like $$ピニオン$$, check the official Super Robot Wars site!」"
    },
    "295:7837": {
      "repository_source_sha256": "904952dd072690d289628d1fe2977e9a3731861b04723937217bc4ae82aefc09",
      "en": "「Good work, $$チェインバー#pilot$$.」"
    },
    "295:7864": {
      "repository_source_sha256": "a3510ed90259678b01d99638f279ef68bc23a7396ca45900bb14cc183b8373ed",
      "en": "「'Good work' is words of appreciation for effort, you know.」"
    },
    "295:7911": {
      "repository_source_sha256": "cec984b9b34509f1e559830d5247b701230b2201481d2bcd122408850f619e7a",
      "en": "「You're learning words fast, $$チェインバー#pilot$$.」"
    },
    "295:7958": {
      "repository_source_sha256": "231cc338d27028dae7f043f4815b5c345c75c86b011433d84b2407f9ff63fbe2",
      "en": "「For example?」"
    },
    "295:7971": {
      "repository_source_sha256": "81ec7420d504e2c3bdbc7eea4fb5ec17008b991feaef2d536edeac564d2f566a",
      "en": "「...It seems it's not just $$レド$$, $$チェインバー#pilot$$ still has lots to learn, too...」  (Exasperated)"
    },
    "295:19963": {
      "repository_source_sha256": "d5df20d3f59d29e29742f4b2ae76a43501aca0cbd8d9ca52d48cdd56b5ab9f5f",
      "en": "「If I use 'Valor' here, I can deal massive damage to the enemy, right, $$チェインバー#pilot$$?」"
    },
    "295:20040": {
      "repository_source_sha256": "94834c512422688d27dab62b7de7d4c383972f9e3800efc14328ea04c7863814",
      "en": "「Phew... SRW's battles run deep.」"
    },
    "295:20079": {
      "repository_source_sha256": "5b3e93b3d12c9d4bf796bc696fa44146567050da8f6d818247c9ea988d9ca923",
      "en": "「An SRW course? You...」"
    },
    "295:20108": {
      "repository_source_sha256": "ba0802aa377da5896097baa4cfaf6c4b183989c0d096f745006b3c482bb3e601",
      "en": "「You... change your name to the SRW Player Support and Enlightenment Interface System...」"
    },
    "295:20187": {
      "repository_source_sha256": "ed94bbafc0a0a526ad485bea425b079365ab98341deba08c9b7b29ef89f999f4",
      "en": "「Right, I'll settle it this turn.」"
    },
    "295:20226": {
      "repository_source_sha256": "ef76c66b5aa2ed1acb77f265a1c53df5b7b46bd8a52542472cc8e5620953bc94",
      "en": "「No... I've been playing nonstop.」"
    },
    "295:20263": {
      "repository_source_sha256": "a72985bc392e3b61e9218b7802021504c2b3940b64322268b88d11309fd3ccb0",
      "en": "「It's hard... Game over right away.」"
    }
  },

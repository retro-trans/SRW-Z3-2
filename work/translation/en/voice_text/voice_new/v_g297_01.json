{
  "schema": 1,
  "rows": {
    "297:2077": {
      "repository_source_sha256": "de5a20ef275379acd027fdffb62d1728f23148c0da6fa14234b67febbc31e9a4",
      "en": "「I'll take this on.」"
    },
    "297:2098": {
      "repository_source_sha256": "762552f436bd1f9e27c09ca90ee560a544fa1a39de76605f389f82c9e9ec6fbd",
      "en": "「I can't let you do that.」"
    },
    "297:2255": {
      "repository_source_sha256": "51426684cdb59a28a50eccaa3b033d7804d57d03cb578acae7a9f664bd3d6466",
      "en": "「Seems you fear $$ベリアル$$ that much.」"
    },
    "297:2294": {
      "repository_source_sha256": "f4f9bb855249dafd99bb6064147d213bc719d3586dcec5f378155f6f37f54cf3",
      "en": "「A wise call, for you.」"
    },
    "297:2323": {
      "repository_source_sha256": "7456bb18aa7ce0d6726c9c172bb76c1214e55b963865dbeb6471946dd4540666",
      "en": "「So I'm the one who made the mistake.」"
    },
    "297:124": {
      "repository_source_sha256": "28f245a4a594dbc09a084c299b580f41bc9ebd83e7556b9975b7d272868e8d0d",
      "en": "「You're slow.」"
    },
    "297:139": {
      "repository_source_sha256": "9807581b5cd3dca56b82fe4710564e537b4501d1901eabaffbeba454858241e3",
      "en": "「That won't do.」"
    },
    "297:160": {
      "repository_source_sha256": "a05d4c6994ba8b39594aba5115357dcddd62cce7f4bd864e356aef1d33f4c6ee",
      "en": "「It's a simple game.」"
    },
    "297:179": {
      "repository_source_sha256": "787d84c112c89fc443686a5dcaa470dba67dae530db56411272b5892f6b539e6",
      "en": "「Your moves are truly easy to read.」"
    },
    "297:208": {
      "repository_source_sha256": "886de2574f349e77ed87874a25d60f17081059f1f6cfa68b53fc2e7631e944f8",
      "en": "「I've already given my warning.」"
    },
    "297:233": {
      "repository_source_sha256": "8515b24d4edca30be50be4cc59b8b12c9aef614a8a94a39b98d7015ecc4a34a0",
      "en": "「We can't overlook your existence.」"
    },
    "297:274": {
      "repository_source_sha256": "8f88bd75755e0adcaa986546d5f4fad02eb5b67c697fd6841dc98b7b0ab30480",
      "en": "「You'll be my playmates.」"
    },
    "297:303": {
      "repository_source_sha256": "c02a4f9319b8b5a641d21961ce7fd98b192dc35bda284c3b6ff2614b335f069b",
      "en": "「Resisting is pointless.」"
    },
    "297:328": {
      "repository_source_sha256": "bf13f97452e91e4d85b9f7343e24b8fbd9f78f7157198189fa2ec87c0dc5bae6",
      "en": "「Let's see if your justice holds up.」"
    },
    "297:1481": {
      "repository_source_sha256": "b70f8013b7e83b6f61c61ff48dd6a1a36a29f35ca7f568ac36ac0743035673e7",
      "en": "「I'd rather not be so unreasonable...」"
    },
    "297:1522": {
      "repository_source_sha256": "26c7407f903b068ae7810a914ad50501d7bb2d9fdf473a6dc3777bb8645ef40c",
      "en": "「If I'm doing it, I do it thoroughly.」"
    },
    "297:1553": {
      "repository_source_sha256": "de57a969b736d1106239c2725770d08a5b722fe2c74eba296f663c11dc1143cd",
      "en": "「I don't intend to make you suffer.」"
    },
    "297:1582": {
      "repository_source_sha256": "50f3c73bba62fcb799309790be00bd8e142b9e40a58a5d79627e6d5f71b69afe",
      "en": "「You've really become an eyesore...」"
    },
    "297:1621": {
      "repository_source_sha256": "e0f456d6a0a6a2e157dfb0695fa862e68120ecdb5d52326bcb1894fee6a07e5a",
      "en": "「Time for you to exit the stage.」"
    },
    "297:1654": {
      "repository_source_sha256": "191f4e4e682d70f1bc9992f4c8a11941338d7b544289fe22e8cdb5b6de90349d",
      "en": "「Thank you for your service so far.」"
    },
    "297:1679": {
      "repository_source_sha256": "64112d45667ff5ddcebc1ecc6dd2311f82bed44f49f580d8fa844d1e46c7ef8c",
      "en": "「Here is a taste of $$ベリアル$$'s power.」"
    },
    "297:1718": {
      "repository_source_sha256": "5673fdf1587421411e58dbf00e0ecfa9194f5dae7cc9f7b0bff79b718dc7d519",
      "en": "「Only a part, though.」"
    },
    "297:1743": {
      "repository_source_sha256": "ba04a240f06e89603e3313630a9ae14bc4c7eaf6ad4ad9d5fc3dd62bc1c48953",
      "en": "「Now, it's over.」"
    },
    "297:371": {
      "repository_source_sha256": "aef308f82f22a581a38d16b1baa2c5a14d3cb2c09fce45ce90b28f84196a2398",
      "en": "「You think distance keeps you safe?」"
    },
    "297:412": {
      "repository_source_sha256": "be5029332c9824002706b3c037ddca34b85c92fe166087b6af0a87570ea9c384",
      "en": "「Struggling is unsightly.」"
    }

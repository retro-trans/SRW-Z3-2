{
  "schema": 1,
  "rows": {
    "298:161": {
      "repository_source_sha256": "0eeac7e78ec5824974fc40cd30ecb8d720a6e032d0151c4f0a81fa80a6ff3c02",
      "en": "「Try to hold out a little, at least.」"
    },
    "298:190": {
      "repository_source_sha256": "5aa2bd980f2472d333dfe53cccc8a6f9fb5fab501d6f7ca935e8d5f30dddd0a1",
      "en": "「You've grown a bit, haven't you?」"
    },
    "298:229": {
      "repository_source_sha256": "19e762c7e0cb44a832590d61a1613d27a6627660005c29b478f6bef5501e770a",
      "en": "「Hinder the plan, and you're done.」"
    },
    "298:270": {
      "repository_source_sha256": "1d787d5e69e93533179451e651a35e13e44c7ed13310d7f4b22fccdeaf5d567a",
      "en": "「No restraint. I kill at full power.」"
    },
    "298:1258": {
      "repository_source_sha256": "59ac168993054ce9cd8a0824009cccdfdcaf7acfdd65b24b3273436e5169d770",
      "en": "「I figured you'd make it this far...!」"
    },
    "298:1301": {
      "repository_source_sha256": "62e7b179dbeb47f09724a6a2a1f30642a1dca0a7ab9b3e63d1c1792987c2c727",
      "en": "「Still as dense as ever...!」"
    },
    "298:1340": {
      "repository_source_sha256": "23007ae70796063a193dd29ca553fc11e16e652b002de4c7dd1243aa8eed6f98",
      "en": "「You talked big, so prove it,\\n$$相良$$!」"
    },
    "298:1391": {
      "repository_source_sha256": "cc02948ba9ec54c02ee8a85aa80ce110378b963a911f3c4c83dc1c0f4c22c8ad",
      "en": "「You were annoying to the very end,\\n$$相良宗介$$!」"
    },
    "298:1446": {
      "repository_source_sha256": "a2a83eaf8f5867a18ed6e3f946cb9805d3c37807b8a80e390b2d4e5f275f82f6",
      "en": "「Ruin it? Get in my way?\\nTry it, if you can!」"
    },
    "298:1511": {
      "repository_source_sha256": "5c7f6f36445f12ffc7365cacf002e3d3afe340dcd55e39f7b03275f6b64c71e6",
      "en": "「You think you can win, $$テレサ$$...!」"
    },
    "298:1550": {
      "repository_source_sha256": "e25897b6b755147545118f0dee1b46111ccac5dbf909f16a62716082868146b6",
      "en": "「Sensing the field won't help...!」"
    },
    "298:1581": {
      "repository_source_sha256": "697a628b1f94e1ff85d95d1efd2cb3e56c65cbf1409477b4fd82408acb1213e4",
      "en": "「Challenging me in an AS like that\\nhardly seems sane...!」"
    },
    "298:1638": {
      "repository_source_sha256": "296dd6ea7bb6ba791acdb22fe507fdadc475842bf4b779c38ce08e9ea404d4ce",
      "en": "「Quit being an eyesore, Gundam!」"
    },
    "298:1679": {
      "repository_source_sha256": "bc4cb714cb3b3161150f3837e54b031219d079e72784d9d9df7e7c3a3dfc90b3",
      "en": "「I'll wipe Gundams from this world!」"
    },
    "298:1716": {
      "repository_source_sha256": "c83ee6eed50a4b6069a40ffab359c9736493c4a10b23e1d7dcc8e12af72060fd",
      "en": "「As if talking could stop a war!」"
    },
    "298:1751": {
      "repository_source_sha256": "fb94135fbbc05f724fe4cbbaace248d9ab90c61362e8459ec4e98bdf83bde1ec",
      "en": "「Possibility is not given\\nto everyone equally!」"
    },
    "298:1804": {
      "repository_source_sha256": "1e5645fd84835e854e3bb4c2f8f109a0f93a92d631e84f77aa1583fbf8dec157",
      "en": "「However much light you show them,\\nfools stay fools!」"
    },
    "298:1853": {
      "repository_source_sha256": "cc2b02cac1823b7e952d0c4dd76519e1af1e3ba1ab455478f81e52a21dbd992e",
      "en": "「You wasted world-changing power!」"
    },
    "298:1896": {
      "repository_source_sha256": "4ee375d7837735c0c718012cb7e158761015cf6d9e3d00c18aa5bf858888e63c",
      "en": "「The old stays old\\nno matter how much time passes...!」"
    },
    "298:1951": {
      "repository_source_sha256": "2c92c1cc50bb42b3ef05c5a01c95d36cc69b6a932271a2596eb4316a1213ba93",
      "en": "「Miracles don't happen...!\\nSo I'll change the world myself!」"
    },
    "298:2006": {
      "repository_source_sha256": "d24da31942323004dbfd1953ac0f8f53055c161bac796eaeb4965242fbdc5316",
      "en": "「Stop me with talk, then,\\nNegotiator!」"
    },
    "298:2061": {
      "repository_source_sha256": "f820cb0cab9b215663d16b04f89203785d4ed4b0b6d3650764ae2de4272d13d8",
      "en": "「You can't stop me with force!」"
    },
    "298:2090": {
      "repository_source_sha256": "e9e39997629da79480349099567cac3bbd0b6ed575d210ca80d815602ad51df1",
      "en": "「Is even this machine's existence\\na prank of the parallel worlds...!」"
    },
    "298:2145": {
      "repository_source_sha256": "522a4ad220d52e614e958bf90a84d29f1615b44005cf63d3d3ccc0ec72604c83",
      "en": "「Take your love games elsewhere...!」"
    },
    "298:2188": {
      "repository_source_sha256": "e139877fbc4be6d0bc21b7f6fd365ea84e5cf8f2aeffc23ab410169b1e9089b3",
      "en": "「I'll do what even a Mechanical Angel\\ncan't do...!」"
    },
    "298:2241": {
      "repository_source_sha256": "d27cf89fd5f09cbbc83c78248ee2e5ede8ef741b85e456c97deb5558f29260fe",
      "en": "「Love won't change the world...!」"
    },
    "298:2284": {
      "repository_source_sha256": "d8351593d0c18adde8ccaea9ffe96cc7262d02d43ee5092a0d3e33d0b04baba8",
      "en": "「You blew your last chance yourself!」"
    },
    "298:2327": {
      "repository_source_sha256": "4dac19ef31299789f2dbed61d88b37487a02633b41882c8424cf791fde021063",
      "en": "「Admit it...! You want to help me!」"
    },
    "298:2370": {
      "repository_source_sha256": "fe07aed7418d329defcc9b611e284402116b8af8d795a79228d1713f357f6699",
      "en": "「If you'd followed me, I'd have made\\nthe world you wanted for you...!」"
    },
    "298:2429": {
      "repository_source_sha256": "437a2cf5054e3ba7e26118c73f92adf0672be186ef1574d94dc68f8c41acfdda",
      "en": "「You'd waste a chance to see your sister...!」"
    },
    "298:2470": {
      "repository_source_sha256": "0d625132ae58af5624daf677b1a0daf30971e912f95769375152f4981caac579",
      "en": "「I could even have erased\\nyour sins!」"
    },
    "298:2523": {
      "repository_source_sha256": "0aa98bc88230f41193509c4a73dd9a45205c614697b7bc6117402eff8cfd3e12",
      "en": "「You throw away a chance to redo\\na life full of regrets...!」"
    },
    "298:2584": {
      "repository_source_sha256": "087fe551f181c734449b8506def9b76a45499ea202e9d782a94fe43d204461be",
      "en": "「You'd refuse to save the life\\nof the woman you love...!」"
    },
    "298:2637": {
      "repository_source_sha256": "c1dfc57636aeb1d1fc6562a7c933ba1608cc1649ac1b281097bc6852e43c6c4f",
      "en": "「Without power, you're just a man...\\nThat suits you!」"
    },
    "298:2696": {
      "repository_source_sha256": "da308d33376ca9dcdb2832427d39efd48250abfe40166669ed598d1641e1c4fe",
      "en": "「Refusing to see your dead friends...\\nHeartless...!」"
    },
    "298:2747": {
      "repository_source_sha256": "7c514955e8d7254222cc6fd6b806ad078ad44780cdae6a9aa96bc01807b8989a",
      "en": "「Hand over the power you hold to me!」"
    },
    "298:2784": {
      "repository_source_sha256": "4a14101639ad3367a43fd611765499c350a0f01ccc0f3d2e98b089ace310b0e8",
      "en": "「I'll add that $$スフィア$$ to my plan!」"
    },
    "298:3280": {
      "repository_source_sha256": "29a0c9e3a4d420518397e10a44c3e048b7af20a3c7a3835ae61bbb5adafea89f",
      "en": "「It's my turn now...!」"
    },
    "298:3303": {
      "repository_source_sha256": "bae622d35f19d8520e8f7b71dc1116c0d16d6a2b4e9b5606146e4ac6c4f50bef",
      "en": "「Don't think you can get away...!」"
    },
    "298:3332": {
      "repository_source_sha256": "8408c69eb8c9747b37161c124a2c5a0893967de90001abd4190f0acf75979cb0",
      "en": "「Resist, and I'll break your will!」"
    },
    "298:3371": {
      "repository_source_sha256": "914163e7bfbeebf15d4cd1c31d9542a295bc4e494b15093d2b1d6dcde70643c6",
      "en": "「The old me might have let you go...!」"
    },
    "298:3414": {
      "repository_source_sha256": "fe09e231b70bb372974393b29ad3b9be805443c331b9aec528429b22ded16bf6",
      "en": "「I can catch up with ease...!」"
    },
    "298:3439": {
      "repository_source_sha256": "e6cf9d4d7128cb41ad08c7aab847294e32e1175b1425ce2adee94d246306e5f9",
      "en": "「I won't be satisfied with this...!」"
    },
    "298:3478": {
      "repository_source_sha256": "f02b06f00c2efc167e427d0d7513ac2e83014d0450680097245b687234fc5ac9",
      "en": "「You started this,\\nso of course this happens...!」"
    },
    "298:3533": {
      "repository_source_sha256": "92e108f088743e063db545dc8ea729dba3fa43a89c21a83d0535e4e167514d0f",
      "en": "「I'll deal with the instigator first!」"
    },
    "298:3566": {
      "repository_source_sha256": "f151817b2a4240da7e436d708bc381dd4c7abf5d4366f5e7d0d0ab5fc0e85dff",
      "en": "「This way is more efficient, too.」"
    },
    "298:3589": {
      "repository_source_sha256": "ffa0c61a1b9e7daef10af1fa260ac3feec2949e5f3c0f0235b52e7d30904f187",
      "en": "「I can't spend much time on this.」"
    },
    "298:3618": {
      "repository_source_sha256": "b1689370b1371b9eb36660e6fc2ac2e22e673c8f29d5ae9a1231d99344a386c3",
      "en": "「Struggling with enemies this weak.」"
    },
    "298:3651": {
      "repository_source_sha256": "31cc1e73c1d2f30c19628d68b8169729e2aea3fbf1f7bab115095db15f5e98e4",
      "en": "「Well done. Good work.」"
    },
    "298:1192": {
      "repository_source_sha256": "934b264451e9be884302e33ccaf3235718802c6946e4157d054b9c7452c85dde",
      "en": "「I'll hound you down thoroughly...!」"
    },
    "298:1223": {
      "repository_source_sha256": "74164636cc3701b7b64ef8a3c4847c58104b7f4b923ab2e76774f7215e1e42ce",
      "en": "「Just drop dead already...!」"
    },
    "298:1086": {
      "repository_source_sha256": "fcec9bf0a1cbca257b739d6829fa9914356f6a682e7c4027cd84930c207e5bc3",
      "en": "「I'll finish you off directly!」"
    },
    "298:1117": {
      "repository_source_sha256": "7c3bc6b4363c4a93f5ef0bafbacbd40608f87be837037af9d31ff7e745ca7ef8",
      "en": "「I'll take you down myself!」"
    },
    "298:1140": {
      "repository_source_sha256": "81dc10cb820aa5d9ddca83a66542441804f04aa51e7b5a5ce8fc4694f0a8c819",
      "en": "「I'll tear that armor apart!」"
    },
    "298:6578": {
      "repository_source_sha256": "2db5878a3367910bb80f0dcec19a7e52c8ecd3c3a8a959a0763ae4e18da2793e",
      "en": "「$$ＴＡＲＯＳ$$'s prediction was wrong...?」"
    },
    "298:6615": {
      "repository_source_sha256": "4bbf30bfe94492cc740ce2fc9027818a23cff8b3c6cdd66b432704b4c9a2bb25",
      "en": "「Tch... That's all for today.」"
    },
    "298:6642": {
      "repository_source_sha256": "68b051411fa141ba7953f9e4adf8f0c83f4ae71bb957ebfb149028b68305a644",
      "en": "「I-impossible...! I... I...!」"
    },
    "298:6679": {
      "repository_source_sha256": "26e550ed1858afb1b3a9e3a9bdf66c483e4bb922472f2ce38ac98c2d8b3d92d0",
      "en": "「I... lose...!? No... The world...!」"
    },
    "298:5496": {
      "repository_source_sha256": "4b5ccfbeb3c8f050275f15aa27a72de1c1fddf631432a78f31cdc2bfa9d809ef",
      "en": "「You got me good, $$相良$$...!」"
    },
    "298:5527": {
      "repository_source_sha256": "d665325e9977957f4b3589a890b1e0341a4f8388ca80aef2be6a86000cebe7a3",
      "en": "「You and that AS...!\\nI underestimated you a little!」"
    },
    "298:5578": {
      "repository_source_sha256": "a7b34ee85f859facb1d1d208c0d46616ce7d4e8c10562b40104336ac0288b7c3",
      "en": "「Is this the power of will\\nto take her back...!」"
    },
    "298:5629": {
      "repository_source_sha256": "bf9b41d16ecafe7cf76c9edd780f40e3df9d1757e94a6efea859ad7580097794",
      "en": "「$$テレサ$$...! You still resist!」"
    },
    "298:5666": {
      "repository_source_sha256": "0a2dd6c8a3e51ba4a91ac7f1eeaafd8adf97dd85c10b882db417f1f60b4412d4",
      "en": "「Big lump relying on raw power...!」"
    },
    "298:5697": {
      "repository_source_sha256": "f13ab25fc0058e735b7cf025fafab8d0934070ed098c2b23d0d1345dbf390e23",
      "en": "「Does it run on feelings too...!」"
    },
    "298:5732": {
      "repository_source_sha256": "620f6bd62cbae8fbca172a427f049841b3d0b326f4ec71ea17f7b7151c8737c3",
      "en": "「A power beyond parallel worlds...!」"
    },
    "298:5775": {
      "repository_source_sha256": "e45840b543fdea320a86751ccbcf69f3b8893ede9df1a624a0de277bd21eb740",
      "en": "「Tch...!\\nTheir mobility is better, of course!」"
    },
    "298:5824": {
      "repository_source_sha256": "166a85c1a8d00fa7c12c6dd5c0b7b916ddf43a4d6cf181b8f9b05e7d73508d67",
      "en": "「Why can you fight\\nfor a world like this...!?」"
    },
    "298:5875": {
      "repository_source_sha256": "3eae6e1e7939c3178c2564cc6895164eca38dca8539ebd20b2f21183460dff9f",
      "en": "「You tell me to throw away\\nthe chance to change the world...!」"
    },
    "298:5932": {
      "repository_source_sha256": "d25e91037d24870aad1fc37126402b05c0734960ba3164c5bcb645ddb8d57f1a",
      "en": "「Ugh...!\\nPushed back by $$スフィア$$ power...!」"
    },
    "298:5981": {
      "repository_source_sha256": "550d3b81d26431936564f75e4b2df0563bc5d172520fd5b52f30749b1f7ff399",
      "en": "「If I could master this power,\\nI could change the world...!」"
    },
    "298:6042": {
      "repository_source_sha256": "53134427e72fa8b9da088973b33caf9cee48bad6fe84fcc9f0147ebdb61468c4",
      "en": "「Enough of your games!」"
    },
    "298:6077": {
      "repository_source_sha256": "522a71faa0a1d40161261540a2d38e6afb86f8a9a7d34f72b8a684b50875e909",
      "en": "「You really intend to\\ninterfere with my plan!」"
    },
    "298:6126": {
      "repository_source_sha256": "8048c706fbdf63b5d1d0efa53fe84d7ac575b1de29c28a783e03c3098b69d5b9",
      "en": "「Right! If we can't coexist,\\nit's kill or be killed!」"
    },
    "298:6185": {
      "repository_source_sha256": "85dc76200da9dc3def3034b9f0c5fa594b5aa788e0835d9762fac31d0331cee9",
      "en": "「Power beyond my estimates...!\\nWhat are they!?」"
    },
    "298:6238": {
      "repository_source_sha256": "4c5c33c74717c4266c65a2b2215eb5dea8ca4bec5914ff5e6bbd66f2d39ea0da",
      "en": "「I knew it. Friendship with you lot\\nis impossible, forever...!」"
    },
    "298:6305": {
      "repository_source_sha256": "b8f31f0a41e885630aaf7457ecfb4ed52d53718ac2e5c19389ca9b5bde8a3341",
      "en": "「All I have to do is finish them off\\ncompletely next time...!」"
    },
    "298:6362": {
      "repository_source_sha256": "a1b29958cbdfd670cbbb4dfc7f268ceb132719f38c10dc6eb3dd0cdbd83fbd18",
      "en": "「You're fine with a wrong world,\\nall of you!?」"
    },
    "298:6417": {
      "repository_source_sha256": "1740089cc8ab7cb41b06a341bf41a60ecf86711dc0259ddb17668001bbe4fa13",
      "en": "「If you fight to the death,\\nthen I'll take you on...!」"
    },
    "298:6476": {
      "repository_source_sha256": "7e6fd5ad22d1f9f2ba4a55ffad12165e7118c7addec56b4738b87e0838cf2d1b",
      "en": "「Right, you're the twisted ones...!」"
    },
    "298:6515": {
      "repository_source_sha256": "522ea9f5c1bf965a91353067ce5f738d389da319b5d8ae4e24f0380a18e421c7",
      "en": "「Just a little more...! If I can hold\\nout a little longer, I win!」"
    }
  },

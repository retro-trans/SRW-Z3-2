{
  "schema": 1,
  "rows": {
    "303:124": {
      "repository_source_sha256": "3c19b140b30c5e94ef2ffbff5dbcc1fda766bb7973b6b146f6a1c7c8b66627e5",
      "en": "「Please act your age!」"
    },
    "303:163": {
      "repository_source_sha256": "deed963bad71ef857f6fcbb7e3f4a539d9284979fb1f17965e588018ab9f9410",
      "en": "「All right!\\nLet's try it, $$ホワイトドール$$!」"
    },
    "303:3090": {
      "repository_source_sha256": "ae0e50d17ae3f6c25eca4b3f2f60a84635d5c2888ea32d6cac7c9b272a34533a",
      "en": "「$$ホワイトドール$$ can stop it!」"
    },
    "303:3125": {
      "repository_source_sha256": "7d3b7613cd10b0617bd9d051133d5fe555a5b6e2b3771dd4cd4a2693b1c68167",
      "en": "「Don't anger $$ターンエー$$!」"
    },
    "303:3146": {
      "repository_source_sha256": "ce2e48eee5b8a3fd980f209f6b455968d90ade14227f66e5b0b3e6faef3bd106",
      "en": "「With a Gundam, I can do it too!」"
    },
    "303:3173": {
      "repository_source_sha256": "d081b23431ad1a28548c04fe16ed93a6af9302ccc19cd031a8967a36efb0fcfc",
      "en": "「With this machine... I can do it!」"
    },
    "303:3262": {
      "repository_source_sha256": "342942b7f1906a419919ff4e8a489d6be09cb1be78f612e7f45f2a1e6e5f8d80",
      "en": "「I won't let you run Earth your way!」"
    },
    "303:3303": {
      "repository_source_sha256": "8360ce52ade47fb1055c9650d8ee4f6aff001b64a0951716ea5665336e521135",
      "en": "「If you try to make Earth yours,\\nI will fight!」"
    },
    "303:3358": {
      "repository_source_sha256": "725da076f4461a33f2928809ee01690b202857b94ea35d239a8181107b09911c",
      "en": "「Even if it's a Gundam!」"
    },
    "303:3424": {
      "repository_source_sha256": "d1647a7ae0cdca77a8bc5ffec020b16a8654f6bb1fe18549b18093b18f60d84f",
      "en": "「Don't think you can\\ncontrol us as well!」"
    },
    "303:3475": {
      "repository_source_sha256": "46231ad35aae7b6c5a1fb2c9907460de87394b11653d54f728330cdffe4d9ab1",
      "en": "「To build a world where people\\ncan sleep in peace, I'll defeat you!」"
    },
    "303:4588": {
      "repository_source_sha256": "ac0ae8a097d6538d3f71dec92c89899545837b50ca43f759ea4f45afce80aa14",
      "en": "「This is what I must do...!」"
    },
    "303:4623": {
      "repository_source_sha256": "82d1846d1a205eef9c04254a7468c8caf44a47c086dd99bd4945556df6574154",
      "en": "「I'll fight too...!」"
    },
    "303:4646": {
      "repository_source_sha256": "1a8a7837e6e457df90a491d29848f5977a75a039bf6c09e4f8e05103e1c8b435",
      "en": "「My mind is already made up...!」"
    },
    "303:4677": {
      "repository_source_sha256": "4d966912d5c2b363f6e32abcb20e6e7e5731912a451a44db591b53c462acf316",
      "en": "「Let's go, $$ホワイトドール$$...!」"
    },
    "303:4708": {
      "repository_source_sha256": "5460e832fb8ff5ec1c0fa70d5fa63e0238d27c14fbcb87cfec2f39f321850cda",
      "en": "「With $$ホワイトドール$$'s power...!」"
    },
    "303:4739": {
      "repository_source_sha256": "962138fbba053289bec373c102cd60b4108285a21d44ad6d40c194e2b9b4a8cb",
      "en": "「$$ディアナ$$...! Here I go!」"
    },
    "303:5603": {
      "repository_source_sha256": "bd979f32b7d8ee37918ba339f10984eff3e39cb210f3ee9a8deecc4965f8a938",
      "en": "「What are you after?!」"
    },
    "303:5636": {
      "repository_source_sha256": "fa5143cf31d2f695a37ad3ded4e3965cf551a0aab0a5fd9451b8a14085db2b01",
      "en": "「Attacking without any discussion...!」"
    },
    "303:5673": {
      "repository_source_sha256": "1baac957aa66751f41e67634a97778849e0c6294746909fbd14b41253e1fc6d8",
      "en": "「They're trouble if they swarm us...!」"
    },
    "303:5708": {
      "repository_source_sha256": "caf84fbe27352ec4cb2545ea9b8bbdb1f2cf054c0a508d0a4351b2909388afe9",
      "en": "「Trying to wipe out humanity...!」"
    },
    "303:5741": {
      "repository_source_sha256": "91215fdd0c41f868966b64b93eab1f47517c284075695027288f4e453503315b",
      "en": "「I'll just sweep the calamity away!」"
    },
    "303:5770": {
      "repository_source_sha256": "5c74146265a576673540a4a40177c717b4490821ddfab250f90c7e7e1073ca4e",
      "en": "「If my foe is a space monster...!」"
    },
    "303:5797": {
      "repository_source_sha256": "fecdb47de8780fbc01f65ace1ecbb874ae9f4cb42890ec36c4c0a10272872625",
      "en": "「Why? Why would you do this...?!」"
    },
    "303:5838": {
      "repository_source_sha256": "52444984bf695888cab44ff343a8d776fcc86b4c6c482f18ba46265e6bef07fb",
      "en": "「Betrayal? That can't be...!」"
    },
    "303:5871": {
      "repository_source_sha256": "46c43b557da2b5bcfb1f1b959c44e8be6123553720f928b4f9fc522e88121d9d",
      "en": "「I knew it, it's a machine...!\\nIts movements have a pattern...!」"
    },
    "303:5924": {
      "repository_source_sha256": "717431271fef06fcfb3c176808798e6db31224ac005a8fc9fe5c770d8dc4a10f",
      "en": "「Not to something with no heart...!」"
    },
    "303:5953": {
      "repository_source_sha256": "a41add0c77cbcf1a131bdff981ece441e5538b0daaaf59a32c62fc0a86487ad1",
      "en": "「You too are a product of\\nhuman wisdom!」"
    },
    "303:6002": {
      "repository_source_sha256": "1a770470ac1694797493cb3f9f033f6f647683f2bc633a9f669b2ef9435c8c98",
      "en": "「Why do you attack people...?!」"
    },
    "303:6033": {
      "repository_source_sha256": "e4b537bf9f68ce236cddffaba86eb8cec3e0948abec055a1af7bb9271af99d68",
      "en": "「I'm sorry...!\\nThis is all I can do now!」"
    },
    "303:6082": {
      "repository_source_sha256": "f28738e6348932dc71e0c4d56cc77af2e7c45971abd2d0ee0106f41ab694f19b",
      "en": "「If our hearts could just connect,\\nnone of this would...!」"
    },
    "303:6135": {
      "repository_source_sha256": "5e0b362dd5dcceba849ba68307585c99a245e77be7626df5e17e428d41092766",
      "en": "「How long will you keep up this war?!」"
    },
    "303:6178": {
      "repository_source_sha256": "0d9536105a5e62c0439029fa3ad6ea99112f00007fe7d1572b9b336479077c34",
      "en": "「Even a hateful past\\ncan be overcome by people!」"
    },
    "303:6233": {
      "repository_source_sha256": "c8c248f4ff22fdd44ca7641b9d0272a91ae2b965c35902259befe1596bb1828c",
      "en": "「Even doing this won't satisfy\\nyour heart...!」"
    },
    "303:6286": {
      "repository_source_sha256": "22e0f75f10906ab33fffe41598c58a64578caf7fabea4613eadb82518a9c2111",
      "en": "「You...!\\nYou're no vessel to gather hearts!」"
    },
    "303:6341": {
      "repository_source_sha256": "372c9c5723df4bbc923b0159e290c5df006a55d7438dd83657215a5d09df5860",
      "en": "「Please listen to what $$ミネバ$$ says!」"
    },
    "303:6376": {
      "repository_source_sha256": "fee74b6ad32263266850e763aff86f37ce0db4ff1d66946363a803b88ad69e0a",
      "en": "「$$ハマーン・カーン$$!\\nYou must be a far kinder person!」"
    },
    "303:6439": {
      "repository_source_sha256": "d5308d665acb51a4e6a18d41c6ef01c3583d90855c5549c32d33c0a325e1dfd8",
      "en": "「This man's just toying with me...!」"
    },
    "303:6470": {
      "repository_source_sha256": "339025898036715a2c77aa2fd46f9dbe48d59bcf2c33c8b4bfc8cc1d887c4d3b",
      "en": "「Is this person enjoying the battle?!」"
    },
    "303:6509": {
      "repository_source_sha256": "abde465ea314a3318ee2b36a1d59114d3eaa93fdebe74500d088ec3bdc6704c6",
      "en": "「A battle-loving samurai, huh...!」"
    },
    "303:6546": {
      "repository_source_sha256": "33460d202a9adc1f87c1411f47b21499bbd751d2231c8469f1e3a817b609c3e4",
      "en": "「I can't fight this foe while\\nprotecting myself...!」"
    },
    "303:6597": {
      "repository_source_sha256": "512e553ae233daf812d2538ebe67476be3f6cdf68a705bf6963d457eb94477fa",
      "en": "「Longer fights mean more casualties!」"
    },
    "303:6640": {
      "repository_source_sha256": "6e5307cb775eb73be3d2ddbe1d0538187e87a2aa1872327047017f805b1bdab4",
      "en": "「Even a warship can be fought...!」"
    },
    "303:6679": {
      "repository_source_sha256": "38961d8282ef37559996b079d662967a7b1e8a55979e0bd77757489ba105a89a",
      "en": "「Just because it's big...!」"
    },
    "303:6708": {
      "repository_source_sha256": "7585121010696e5f10b9a8d3a1ac1927ac7bba6d82e55acb96bdbe65ab1e64bd",
      "en": "「Even if I can't match its speed...!」"
    },
    "303:6737": {
      "repository_source_sha256": "b6f5004f218723ac6bee1bb9c7ded20a37972d73132e1ee562d30ccada61813a",
      "en": "「Small and hard to target, but...!」"
    },
    "303:6772": {
      "repository_source_sha256": "2a445c30fb2cdf78524950640dcad3122c9fc5f8e2f12e4a9209bbb26dd32640",
      "en": "「You are an utter fool!」"
    },
    "303:6809": {
      "repository_source_sha256": "9a32e9ff96aa3c66bbac9478ee6b12e59769c84fb9d2540683c2807831bf4183",
      "en": "「I won't let you have your way!」"
    },
    "303:6848": {
      "repository_source_sha256": "4a454cf1df746f5d50faf21a0d3622183893b7561b5aba70c5c9f4ab1fe7b06b",
      "en": "「Forcing selfish feelings on people\\nwon't move them!」"
    },
    "303:6907": {
      "repository_source_sha256": "da1410aa5df40e71b11c38bb140fc54fb17f4551f109239ff671ddb15edec2cd",
      "en": "「Invaders who crush people by force!」"
    },
    "303:6946": {
      "repository_source_sha256": "5da70f3922fda1dc699c6a19bf1c80a08ef4179a721e74f5edb9a7da4d74f714",
      "en": "「$$サイデリアル$$!\\nDon't bring your war to Earth!」"
    },
    "303:6995": {
      "repository_source_sha256": "5f6d570477c749d6c92903dd139c53ca2e3368c56bd78e3c8214bed8f37d851f",
      "en": "「Give everyone's Earth back!」"
    },
    "303:7034": {
      "repository_source_sha256": "fe48a3dddc7337224203d4e18ad95224f354a3a1b682ebfef8ccc324be55d0d3",
      "en": "「Power like this...!\\nYou mustn't use it!」"
    },
    "303:7083": {
      "repository_source_sha256": "53990178df436f70bee1b738dd5027a6fa189b1ec2a383d53cf11adb4b3185bd",
      "en": "「Depending on how it's used, it can\\neven protect people!」"
    },
    "303:7140": {
      "repository_source_sha256": "419edacda23678f634d63be3938d527ca231f48b64644ba9aed430b0fd8cc7aa",
      "en": "「No further!\\nI won't let you spread that poison!」"
    },
    "303:7189": {
      "repository_source_sha256": "e9486f5ebe9a2481c11674a24cbaf365546d467504981da0ad9b001d8bc1c76c",
      "en": "「This person...! What bloodlust...!」"
    },
    "303:7222": {
      "repository_source_sha256": "78dfa50160e2b844bbb3651543684c1988066cf8b226a3b85acf5132b31f2329",
      "en": "「To turn the tide of battle,\\nI have to stop that person...!」"
    },
    "303:7277": {
      "repository_source_sha256": "e7508ade05086dfd48e6a8917489092c3ee3fc3313152d11f2d97ba52a37ab8c",
      "en": "「A woman enjoying battle...!」"
    },
    "303:7314": {
      "repository_source_sha256": "f6af7fb7baf824400e4ccafdff8d4e30e11671fd3dd4201f90b54b06ea96715e",
      "en": "「Those who crave battle must not\\nrule over people!」"
    },
    "303:7369": {
      "repository_source_sha256": "c057b355cacb38f3611f2d4f8981f346d0fc9a26aa1037b3459d7a7ea749bdc2",
      "en": "「Poor soul, you've lost your way...!」"
    },
    "303:7410": {
      "repository_source_sha256": "6dc5f33c4096d56e6ae6dfec0f71181a4e855b225a6d972e5c8456d4729110ef",
      "en": "「A god who stirs up war...!」"
    },
    "303:7441": {
      "repository_source_sha256": "d74fb1a2a5855216ed828b06a8b248c2bc02ac234ff347b7eee8a5b16c939ec7",
      "en": "「Why does an emissary of God\\ncommit such sacrilege?!」"
    },
    "303:7500": {
      "repository_source_sha256": "f999930914066345a435cd11bbb661408d4d8e6068cb1750a82db9efea9e71b4",
      "en": "「You have no right to judge people\\nwho are doing their best to live!」"
    },
    "303:7569": {
      "repository_source_sha256": "4c011db873b31f9c8f86c631e71aad77e75361dd41a9f4d997756b461c708cf5",
      "en": "「Judging someone out of anger,\\nthat's just wrong!」"
    },
    "303:7624": {
      "repository_source_sha256": "b5780389e91c64df3a9bba43050f7742dee9efbdb588c5367ac5a4993cdfe80c",
      "en": "「Thinking it's fun\\nto take someone's life...!」"
    },
    "303:7675": {
      "repository_source_sha256": "8559dfc800229fc498df0a5a69774db06119a4f0ea08f52b22c0b7aeb124fbe7",
      "en": "「Your joy\\nbrings someone else's sorrow!」"
    },
    "303:7726": {
      "repository_source_sha256": "5aa6d416b70ccf174bd23f808647011f7b7099abaf16e0ce8219586824c2d538",
      "en": "「Wake up!\\nYou're not servants of God!」"
    },
    "303:7781": {
      "repository_source_sha256": "05a2e544fbd0a5d984d5086af2cac02b47bd3370afca2f1cfd3b56908429a202",
      "en": "「Trying to destroy humanity\\njust because you were ordered...!」"
    },
    "303:7834": {
      "repository_source_sha256": "a02c79fec855f1b595000bbb5f17493e3f12544627ccbea9d71f2292631dd884",
      "en": "「I can stop you even if I can't win!」"
    },
    "303:7877": {
      "repository_source_sha256": "4748bceb2a154504db93c94cb2bbea9a182f99f2a06c109d34c8a0c14f99a7fd",
      "en": "「Do you know how many people were\\nmade unhappy by your selfishness?!」"
    },
    "303:7948": {
      "repository_source_sha256": "c989833efb79aee2c47b565e92f15f9baa7781f1942d873a67aba30fecea542b",
      "en": "「For the universe...! The world...!\\nTo welcome a new tomorrow!」"
    },
    "303:8007": {
      "repository_source_sha256": "d68ba84e3669a9f610bce09af39dc22badaab229810fd0d91ecbdb56b92d262e",
      "en": "「$$アドヴェント#pilot$$!\\nI won't hand you the future!」"
    },
    "303:8192": {
      "repository_source_sha256": "72a6c05647e45dc068cdfbecb1d45b2989dac775ebda330adf3b38088b52898f",
      "en": "「Now! Counterattack!」"
    },
    "303:8213": {
      "repository_source_sha256": "f46425625970cccf50d0faed5af2dc15f0e7c0ab744ac1d7fa0183805ffc01f3",
      "en": "「It's not that I'm hitting back\\njust because you hit me, but...!」"
    },
    "303:8266": {
      "repository_source_sha256": "504e2fbb8bd717d4afc6ea74ae967919a25e4a2ffbfb2842a7fcf9f84ad9bc73",
      "en": "「I can't let you get away!」"
    },
    "303:8295": {
      "repository_source_sha256": "8a7bd7e56954cdc45818481c9d953c8eaec1d5e55720a49e0430664b176e3fb3",
      "en": "「Good, I've caught up!」"
    },
    "303:8318": {
      "repository_source_sha256": "d5a9ce544d6d951473dfb522f856377ed4733e9a8d558d9616efbed098f28849",
      "en": "「To minimize the damage, here!」"
    },
    "303:8353": {
      "repository_source_sha256": "8bdc1f477bb29c2f40dfe3c0a14b5a8b8d16a760ec4c220f1067494e63083335",
      "en": "「I won't let you retreat!」"
    },
    "303:633": {
      "repository_source_sha256": "0cca6d5cf3e9fc2897a552e11ca7073b080d3ba876cee3f2f2701faca219ab96",
      "en": "「Sorry, but I'll follow up!」"
    },
    "303:664": {
      "repository_source_sha256": "e2c3960cec423915286815f9f0b22172826b7f592fe780b5ae370531827c7795",
      "en": "「I'll cover you!」"
    }
  },

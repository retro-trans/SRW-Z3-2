    },
    "303:4361": {
      "repository_source_sha256": "8caea5bd3dd72f0bd694079e71796da94af860b0a77b05e932e228d8d0a64690",
      "en": "「Players, everyone. Super Robot Wars is a game that really makes you want to see what happens next!」"
    },
    "303:4444": {
      "repository_source_sha256": "ec4ab67d3a0cfdb1007a99bfbaf7b46e178993b110976a2a0f3812fca652c9b6",
      "en": "「Hurry back!」"
    },
    "303:4465": {
      "repository_source_sha256": "0284da23b65427acb8aac18dea769e5f0ddd419c13ee1e12428ea73d0c8d6379",
      "en": "「Super Robot Wars is a game that really makes you want to see what happens next!」"
    },
    "303:4524": {
      "repository_source_sha256": "c9ffb55b403fb60b542c4e3580e32c36f9e33cf9ea6ce9d5ab5dcd47e63b8bce",
      "en": "「Everyone! Hurry baaaack!!」"
    },
    "303:10044": {
      "repository_source_sha256": "335d634cbd0a6a3ba4eff552c8e17bf1ddbc57950bd88fd590dd49e463479b4e",
      "en": "「People living on another planet came from far across space, attacked, and invaded Earth.」"
    },
    "303:10121": {
      "repository_source_sha256": "17f1a7cb7279fde90b7cf50c24c0830e0df9844819c6fcf751374afd86e55482",
      "en": "「To stop a great war that warps people's hearts, I decide to ride a mobile suit once more.」"
    },
    "303:10208": {
      "repository_source_sha256": "bca3a85f153873cad8a33e7b6fa7835d8a1139958cca85408a8312203e039ef9",
      "en": "「I hope we can somehow retake Earth...」"
    },
    "303:10253": {
      "repository_source_sha256": "f4ba6902b7935ee2c47a4f2b3c477aeb2e1331b78ae723db73e31727c4d5be22",
      "en": "「Next time, 'The Stolen Earth'. A wind that shook the dimensions blew...」"
    },
    "303:10308": {
      "repository_source_sha256": "87b37a5a71e468723584d68189196ac97fe22e75293b76a6f3a22dbc4cd59c87",
      "en": "「From the words of someone claiming to be an emissary of God, I learned that humanity is about to be destroyed.」"
    },
    "303:10385": {
      "repository_source_sha256": "65b69b0fe340ef3ba9879230c06cd57145088f8ca08c48c37fcc29dc686b3c29",
      "en": "「The feelings of the many people who wish for peace come together and grow into a great power.」"
    },
    "303:10454": {
      "repository_source_sha256": "3c98fe896e133a2d98241a0c1e1e86dd5461bc0164fd2ad66234edbcc17b5543",
      "en": "「And so we made up our minds...!」"
    },
    "303:10485": {
      "repository_source_sha256": "dc7d09828834a3779b8ea0fec4d648da2eae35bd883cd346b39881ecda94991f",
      "en": "「Next time, 'The Golden Galaxy'. The wind crosses the dimensions...」"
    },
    "303:2558": {
      "repository_source_sha256": "158cfc4910b7b60eabbf0ba20dcd00769bcebb5a69789ac8623304c495ea2cb2",
      "en": "「Ngh... I can't counterattack?!」"
    },
    "303:8980": {
      "repository_source_sha256": "40afa45e15ac4788be0763355ed24fef6c6abf28cc8194c36f1454a346e2ed0f",
      "en": "「Unable to attack? Why?!」"
    },
    "303:9007": {
      "repository_source_sha256": "da26a8bec9f0569b2ac836bae7a3435544337727c23fac84d451660be8dd6a30",
      "en": "「Giving the enemy an opening...」"
    },
    "303:2589": {
      "repository_source_sha256": "dd9b34eb1d6546dc624731233fa2defa2e417fb7d150df2c70685c0eff29598d",
      "en": "「An attack from long range...\\nI can't reach them from here.」"
    },
    "303:2638": {
      "repository_source_sha256": "949885400bbd70a80048f0545dfef71142b7af38041c8c1cc480633feedeb002",
      "en": "「Is the $$ホワイトドール$$ scaring them...?」"
    },
    "303:2519": {
      "repository_source_sha256": "4e910fcbedaf29c30fd0acbd979fc1ecb34905febfb706daa4ea6800b05860da",
      "en": "「Damn, I'm out of energy?!」"
    },
    "303:841": {
      "repository_source_sha256": "fe9533fe938491f705c5fe44b98fdfcf2a422002b7ddc084912708a6afcba4bd",
      "en": "「I'll take care of this here!」"
    },
    "303:872": {
      "repository_source_sha256": "0e19708195b932cf78069feea96617c2b01d523f6bee93038defec36b75148de",
      "en": "「I can't let you die!」"
    },
    "303:913": {
      "repository_source_sha256": "ff258f2e056f77477a68da94d36c0ab9e5d450c2e36c96c0fe73852214622c9c",
      "en": "「I'm your shield! Fall back now!」"
    },
    "303:3733": {
      "repository_source_sha256": "aa2b557e4c11b31c361892b25ce0874368647146584848f11028545229a5f86b",
      "en": "「Fall back, $$カミーユ$$!」"
    },
    "303:3758": {
      "repository_source_sha256": "60551bd638ae67385a8407a2a5a6c85c3c549e94cf1fce51b84cb895effe68cf",
      "en": "「You're too far out front, $$ガロード$$!」"
    },
    "303:3789": {
      "repository_source_sha256": "e7d138cc1031988e835a372a44233eec6bf09531ad97445908788cce19292b85",
      "en": "「$$シン$$! Look out!」"
    },
    "303:3810": {
      "repository_source_sha256": "be1b854ee6d44101d890bea317684e0e69fa1cb9ee38a8136a23ccb839bd1463",
      "en": "「$$キラ$$, get back, quickly!」"
    },
    "303:8538": {
      "repository_source_sha256": "d57fadc9119e493a538dc7cdecc55514d1acd9fc0c111b4e63fed349f46301a6",
      "en": "「Please don't throw your life away!」"
    },
    "303:8571": {
      "repository_source_sha256": "737f71e58348e0857d2f9a72a4776ad29dae42cac6f5b071d341452eda8d8550",
      "en": "「I can't afford to lose anyone...!」"
    },
    "303:8604": {
      "repository_source_sha256": "41004221c1b9447977e36d531ab73cc7febe1c79945b604b74255c639ab82171",
      "en": "「Why do you take such risks, $$ヒイロ$$!」"
    },
    "303:8641": {
      "repository_source_sha256": "1535eb75c02ead1bfe80405e23576f7672434852b18fe431fc0524438517465f",
      "en": "「Don't let your guard down, $$ガロード$$!」"
    },
    "303:8674": {
      "repository_source_sha256": "3eb193982e71f4eb6305ddb7412a9319bc76ab4fff730346de7852eddbf157e9",
      "en": "「$$ユニコーン$$, fall back!」"
    },
    "303:8699": {
      "repository_source_sha256": "b45b138e5143401b51524abee3b71fe02e05c670ec07ded201c3742535d0aafe",
      "en": "「If you're the $$赤い彗星$$, buck up!」"
    },
    "303:2756": {
      "repository_source_sha256": "4b14891c64e3d39dc99f99a11d0ab7ef3b8cca7354b30ddf2dd1dcdc4e87156a",
      "en": "「You people!」"
    },
    "303:2816": {
      "repository_source_sha256": "4d3c1a29efa93f4fd5f9c50e61f105eaff5c1d6efb79aa8ad6f59a526a936f71",
      "en": "「At this range, with this...!」"
    },
    "303:2845": {
      "repository_source_sha256": "503a3003a668f6f4602e47f520bc1f380ccb9a34d0d44c09333b49609c239ba1",
      "en": "「I must stop that unit at all costs!」"
    },
    "303:2884": {
      "repository_source_sha256": "c9b55812985f2b517c42df887899578df7350bef554c2ef2b02d8f965e64d59f",
      "en": "「If I don't defeat you,\\nsomeone will get hurt!」"
    },
    "303:2933": {
      "repository_source_sha256": "7948be3183ac011ade0eab8ba195855ca5e208e88c57e69f5e9ebc5e521b33a2",
      "en": "「Right now, I have to do it...!」"
    },
    "303:3387": {
      "repository_source_sha256": "ebfa0f0668adfa727ab9aeecc2c8e12df94d6bda81e86586a1363d18754a0dad",
      "en": "「To think a Gundam is here too...!」"
    },
    "303:4770": {
      "repository_source_sha256": "5fc6786b524c781509f6b31db87ed1bcbfbea4991742d77b5fb92fd06d919bb9",
      "en": "「Watching won't end the fighting!」"
    },
    "303:4809": {
      "repository_source_sha256": "fa58a2a3afadb48748a586392f7a8573387822dce8a07cd41d077ea8bdda5fb3",
      "en": "「Someone has to do it!」"
    },
    "303:4844": {
      "repository_source_sha256": "e17a224ba22e610128bf300100742d0278469afc8a0cec0bbada836389a3aac7",
      "en": "「I won't let the war spread further!」"
    },
    "303:4883": {
      "repository_source_sha256": "33a54a7d95a6d8f2731ac0abb3f12bcc854cb03ab866d8a6cff8bf3b996c31c0",
      "en": "「We can only hurt each other...!」"
    },
    "303:4924": {
      "repository_source_sha256": "86e9113c0dac7e94b085447e2f31f2c0d6b58e99666c8fc44ac35023682ca994",
      "en": "「To think this is all I can do...!」"
    },
    "303:4963": {
      "repository_source_sha256": "6b7beb5d0bd475cb800c6aea5bf0b685bf244c6f815813118e4e3dff95fe3c13",
      "en": "「Even as we speak,\\nsomeone is getting hurt...!」"
    },
    "303:5014": {
      "repository_source_sha256": "3c1b11d00203528d2501194096b65a74da12568115e472a796f050f1337b89b5",
      "en": "「I will stop this, I promise!」"
    },
    "303:5039": {
      "repository_source_sha256": "e7bbb5e592145f359a365e0fd3bb94e7ac5e85d8298faa4075404182ddd0300a",
      "en": "「Isn't there another way?!」"
    },
    "303:5068": {
      "repository_source_sha256": "e854eb020380b6e377e7890dfa4f0dd5c8a457c4d33a158d7b81d45f0658793a",
      "en": "「Only destruction lies ahead...!」"
    },
    "303:5109": {
      "repository_source_sha256": "d97a70427c754f79d8e5707bc160642227256c75aa82ea25a2e0cba7b0309b99",
      "en": "「Mind where you are!」"
    },
    "303:5132": {
      "repository_source_sha256": "ce6f158aa43b2207ca597dbacb3c4f471a124ea31eab403e16e389d580d58b96",
      "en": "「Fighting in the middle of a city...!」"
    },
    "303:5163": {
      "repository_source_sha256": "ed36975e73eb36b49b30ceb964c200492a1bbff7432a7956397d83d45968045f",
      "en": "「People live their lives here...!」"
    },
    "303:103": {
      "repository_source_sha256": "4a3d44b511ee0892ffe6310ce7d2ab4bd9c693924ad1ce9280088523c6622320",
      "en": "「If it's hand-to-hand!」"
    }

{
  "schema": 1,
  "rows": {
    "304:0": {
      "repository_source_sha256": "b7798f5aa7e551a8af1350f64ce9af0abc9dd798c02aa7e16995d167496a1cad",
      "en": "「I'm an omniscient, omnipotent god...」"
    },
    "304:73": {
      "repository_source_sha256": "5d58c647e70427d9158f4acc3bee3daef63d526f51295951e3065e9dcb0d6d81",
      "en": "「You will learn exactly who I am.」"
    },
    "304:104": {
      "repository_source_sha256": "a8b06b6b67ca0efbb984ec58a320db4a4354d1e0bd867ee68fb784f8f1ff93d6",
      "en": "「You still insist on defying me...」"
    },
    "304:174": {
      "repository_source_sha256": "86b59d0e986c6c6a15043c9da7dcfde6cda64c442f987d0f17b729cfd8520725",
      "en": "「I am a being beyond human wisdom.」"
    },
    "304:207": {
      "repository_source_sha256": "33eede878a680def3269236d194246aef2281c43a258c8beabae77b8151c39e4",
      "en": "「Everything is decided by my will.」"
    },
    "304:396": {
      "repository_source_sha256": "4dc81cd4c6d699263b689bae1374bf9732bb27081e4056a16eff6f53f62407b8",
      "en": "「You too will learn in time...\\nwhat your extraordinary power means.」"
    },
    "304:445": {
      "repository_source_sha256": "b0050efd113138166fcd9c4311c444185b8135cf9d7401465adafcd56d13e16d",
      "en": "「I'll nip your evolution in the bud.」"
    },
    "304:478": {
      "repository_source_sha256": "2e745633c3c74d2c5c367ed609d59f19fd0e9f3690a583d1223cd7e854163d32",
      "en": "「Bearer of power bound for the end...」"
    },
    "304:509": {
      "repository_source_sha256": "f6012e34b598c3b6b81d6897a429052ef329c9c14621a6d053531fc24095a66a",
      "en": "「You defy the universe's truth...」"
    },
    "304:546": {
      "repository_source_sha256": "9524757a64f4882553e58b9c5c75e15947418ad3793708aad75ef3fde1b25158",
      "en": "「Your song will ruin the universe...」"
    },
    "304:579": {
      "repository_source_sha256": "ecc71b2f66175263d29dbd9ee1f5f3e2b307bf4725d4e63d4b260877f270a28c",
      "en": "「You too will awaken to true power...」"
    },
    "304:1894": {
      "repository_source_sha256": "0518605db3f04ac905d48eee1b6c6771209f74e253d1b092490139cec3946652",
      "en": "「I have waited for this moment.」"
    },
    "304:1917": {
      "repository_source_sha256": "e0022ea0ee4b50bfe88ec00ae7c6b802b3e9a7efb6d4329c5cd8f883266ab25d",
      "en": "「The galactic ruling system is back.」"
    },
    "304:1954": {
      "repository_source_sha256": "35e90bf842f3e4599192bacbcd2319b0f949bcd717a591c6a04214c370fe89fe",
      "en": "「As long as the system exists,\\nI'll revive again and again.」"
    },
    "304:2003": {
      "repository_source_sha256": "bf02eefde13dba633820d9987056904309d6e29490a6dfecd16866c4a9e90dab",
      "en": "「Welcome, extraordinary ones.」"
    },
    "304:2030": {
      "repository_source_sha256": "452242c5eb00eff3808579495d3c66ac13800ec18a7048d3734e704ae2614a70",
      "en": "「I leave the galaxy to a true heir.」"
    },
    "304:2065": {
      "repository_source_sha256": "5ee5eb00febf45b1e2afde69a86b47a823a0458d6aaf4300a21ae1cbaed8c393",
      "en": "「A new galactic order will be born.」"
    },
    "304:2220": {
      "repository_source_sha256": "912efcee10151827bec6319bfb7a546bf44e752fec950ba2b0c3a8f532abf191",
      "en": "「I've waited for you, $$キリコ$$...」"
    },
    "304:2247": {
      "repository_source_sha256": "c36aa515fd86a50fdc284ad0322ce2440685cec1c3613867301c928f1141da71",
      "en": "「So you cast off $$マーティアル$$...」"
    },
    "304:2278": {
      "repository_source_sha256": "f3929838213d587b0dbd342e0c083f9df018b2c1b6f618129fedf38b9feb2d0d",
      "en": "「I have waited to meet you all again.」"
    },
    "304:622": {
      "repository_source_sha256": "d931987aa27f2fca519a7c72d3243a2c6a4ea72eecc4b5280ff0140accd77405",
      "en": "「Pay the price for defying a god.」"
    },
    "304:649": {
      "repository_source_sha256": "88b45f24e3e760455543093cfe2bc88e01ad7e8b371af63502e6e2c572799cb3",
      "en": "「This is the result of defying me.」"
    },
    "304:684": {
      "repository_source_sha256": "63d10294bcabc7b832fb8e7247cd223192050af2f2707676bb772514a1edf6d4",
      "en": "「This is the punishment I mete out.」"
    },
    "304:709": {
      "repository_source_sha256": "c26820fbbefe1189d1b598e75448d9ee6f714f8dca2afea326570f7ce118e9e6",
      "en": "「This is my answer.」"
    },
    "304:2317": {
      "repository_source_sha256": "4c127d787dd9140baaff97721b098bb31cd10b29d72a4340e3f680d5779c89b2",
      "en": "「So you defy a god after all...」"
    },
    "304:2340": {
      "repository_source_sha256": "57120bb88dfb7ca70ec3f897f44ff9862426f1f0d900a860066c884f20970212",
      "en": "「If you defy me to the very end」"
    },
    "304:236": {
      "repository_source_sha256": "b6429b20f2bde26687dba40742d2525e4678b1aa72a886d80ea91bef377f3a67",
      "en": "「I told you, I preside over war...」"
    },
    "304:23": {
      "repository_source_sha256": "e8a2e2e4988e8c8c4b64f69ddbbfe79894114f0da2d0bcf5da178699a7b6775e",
      "en": "「I shall punish you.」"
    },
    "304:46": {
      "repository_source_sha256": "c835661889f170f6d4b0a4ba830323f705af69f8d8e0df5db86218b4a0baac27",
      "en": "「Death is the punishment for fools.」"
    },
    "304:133": {
      "repository_source_sha256": "82aa7090f7178f35e6de277708363e654ed685d7fada88a4abc4e8e87644d327",
      "en": "「You have done what must not be done.」"
    },
    "304:271": {
      "repository_source_sha256": "ee3fac961af721c9e337140bc8581c0b4e3248f1c3616893095a140459453bf7",
      "en": "「You dare defy me, a god,\\n$$キリコ$$!」"
    },
    "304:322": {
      "repository_source_sha256": "33fbb318864ad02371d5447e6fab79e619cd922e3c83ec87404820e70c4370c2",
      "en": "「Obey me, or I will kill you!」"
    },
    "304:357": {
      "repository_source_sha256": "60da66ec8de4a2bc68faf04040a690baaed5bb287d1c2855c38f6e3f1bd279d9",
      "en": "「King's power bearer... I punish you.」"
    },
    "304:1807": {
      "repository_source_sha256": "b04f79451df81fecdab44bcba1cbbeba215df656f7431cf70a5cf213196b649e",
      "en": "「You've... done... the irreparable...」"
    },
    "304:1846": {
      "repository_source_sha256": "d98ae138f5b94005e96654f57365aad31c0b992fab97a749b1911166da986dc1",
      "en": "「I'm... a...fraid... a...fraid......」"
    },
    "304:1875": {
      "repository_source_sha256": "3ed47f14c4f998b1794bf72116f7d993c3e0c53f9bd18a191085c56ed756ea31",
      "en": "「Chi...rico......」"
    },
    "304:2894": {
      "repository_source_sha256": "b1d739a69df72f80ae59e6db87c5de5f62b9d2a52e3e48379bd37a2378ae8cea",
      "en": "「You... all of you... a god...」"
    },
    "304:2923": {
      "repository_source_sha256": "3d3991336cff6230335179e88c07433b3e3cb2afdc807cc47882aba364506c05",
      "en": "「What awaits a world without gods...\\nis endless... chaos...」"
    },
    "304:1147": {
      "repository_source_sha256": "b30a71c0d10d2e2f025d68de6d7b05d9cfdd9f1a16413c64bca5ec33e4cae678",
      "en": "「Don't you want my power!?\\nAren't you afraid of me!?」"
    },
    "304:1253": {
      "repository_source_sha256": "2be63df93e719542f4292f1ea2420d30ff41790a9c97f8179bd5cfddf53f5f68",
      "en": "「Stop, $$キリコ$$...」"
    },
    "304:1295": {
      "repository_source_sha256": "08efd4071ad9929c3a2431b1e96ae23590256739060c9ef108099fe028486899",
      "en": "「The power you hold is forbidden...」"
    },
    "304:1361": {
      "repository_source_sha256": "296f44164896fdfca398184ef186d413af8ab76b57c497ef84ee8fb9f04290c1",
      "en": "「You will regret it if you go on.」"
    },
    "304:1439": {
      "repository_source_sha256": "7fa29721be4130fa399b5623f34c89737bb0bf75f4f515c90d8510110e83ea4d",
      "en": "「You want to see the universe end...?」"
    },
    "304:1513": {
      "repository_source_sha256": "60dba44d1fb36edb59ac6b613f9aad5551a58c879c2a77541d2eef32a5ea66cf",
      "en": "「A modest start, 3,000 years ago...」"
    },
    "304:1556": {
      "repository_source_sha256": "ccd95643dd5518bd1da2e40ca26271f0d06358debaa786ae3d5d6d52a0bbc27a",
      "en": "「World's light... Mind's crystal...」"
    },
    "304:1589": {
      "repository_source_sha256": "568594b6169880ed1668f2f8577ed2e14684d8010b9daf0b3725014357483ded",
      "en": "「An imperfect succession...\\nnever produced a god, in the end...」"
    },
    "304:1646": {
      "repository_source_sha256": "b384c1cbce5767ac4c6d112aec7fe2ce0c784be98f25ebaa85448be33c6cafd3",
      "en": "「My memories... are already...」"
    },
    "304:1671": {
      "repository_source_sha256": "3c86899c05d4453c389c0b2f658fa342719011b73feaa9e32eed5cb57d8bfcbc",
      "en": "「Stop... Stop it...!」"
    },
    "304:1698": {
      "repository_source_sha256": "d9c97314d723d468d71c5e9aa34c13b4f470a5e62e76ec5b8ee3d5540bde21eb",
      "en": "「At this rate...\\nit will become irreparable...!」"
    },
    "304:1747": {
      "repository_source_sha256": "6d184b604a9d02d6f56fc22a9cf8120a2be6b95350a7d4b551dbd4b0c1528cd6",
      "en": "「You... a god...!」"
    },
    "304:1768": {
      "repository_source_sha256": "01e9a2d8629d9056851cba456c40d915a35ce9ca053912709e8d9c3e3b701cef",
      "en": "「Stop fighting... now... Stop...!」"
    },
    "304:2789": {
      "repository_source_sha256": "8c6a0355e0e76a30a05c31db78a9ee86cc660e0e5eeb74338c123cf0af34afb6",
      "en": "「Not just once, but twice,\\nyou would kill a god...!」"
    },
    "304:2840": {
      "repository_source_sha256": "193c9ffd9a0753a776a1d886f92d9eb8874065b78d390a2e729d6abe42100e2b",
      "en": "「Stop it, $$キリコ$$...!」"
    },
    "304:1036": {
      "repository_source_sha256": "5cd34ab5c20c2a2c88da1d7fb5711065e3e0064684534d518b0ee9241e31ab93",
      "en": "「Defying me... is unthinkable...!」"
    },
    "304:1071": {
      "repository_source_sha256": "748e83d7ac95e612f5e4873bc847a50a62236892a6bc7215fc61ee0e65e2d44d",
      "en": "「Stop this foolishness!」"
    },
    "304:1096": {
      "repository_source_sha256": "5bd44118705feab7d18e9e449e5dbc096abb555b2f224d6b1be2478f867a6486",
      "en": "「Do you have it?\\nThe resolve to kill a god...!」"
    },
    "304:2645": {
      "repository_source_sha256": "73483e900488cdda72db0d4510ea66331a052f90344e287ce9b6883526128ce9",
      "en": "「Why? Why do you deny order...」"
    },
    "304:2680": {
      "repository_source_sha256": "a0621019b2852d5ffe7d417e021ecb04fcb9922502a2aba76fe9fbae328d7316",
      "en": "「Do you know what you are doing...?」"
    },
    "304:2723": {
      "repository_source_sha256": "ffc460619e41bbce914ff167399e12d29f99a5617f2c62f99f1cd5c86f6c85ef",
      "en": "「Will you repeat your mistakes...?」"
    },
    "304:939": {
      "repository_source_sha256": "c0329247237401b5244d1bcb9b50df200922a4ddf123e694aa2d37e1bf509160",
      "en": "「It was all within my predictions.」"
    },
    "304:968": {
      "repository_source_sha256": "6df8e709d9b2b8bc66d50994a7b3907b72d8c39ea8609c6e8ed1513d0d40f615",
      "en": "「3,000 years of waiting, for this...」"
    },
    "304:1001": {
      "repository_source_sha256": "5428d83291bea06f1a1a87d4614b639a34c9f3a1f81d44219092d14d24c0cdd1",
      "en": "「Defy a god with such weak power...」"
    },
    "304:2544": {
      "repository_source_sha256": "899748d33e5c60ad614cbca861c3cac6dd11d5fedaa4366ca352b32072901a39",
      "en": "「Show me your power.」"
    },
    "304:2569": {
      "repository_source_sha256": "4930ee0d3408ab6af7664b2114dd5f2a765c56a25ed9b0d139d4d52704c97f17",
      "en": "「You'd defy a god with just this...」"
    },
    "304:2608": {
      "repository_source_sha256": "91ce6a66414511306a9d37e6a9d828b74967e0f21c2c4204fc9ed59a76da2941",
      "en": "「Defy me still, and steel yourself.」"
    },
    "304:808": {
      "repository_source_sha256": "695d359ef3e689b4bd2ae0087c1a0cf7bfa8f095da887e4e2a18a58b27c8da8f",
      "en": "「Your fate, too, lies under my rule.」"
    },
    "304:851": {
      "repository_source_sha256": "ac0d0c4466d09c7df6875e23497a0ecb9d7891b6ffbc6d261ca23309ccc78dd4",
      "en": "「Stop that pointless action at once.」"
    },
    "304:890": {
      "repository_source_sha256": "67637dcda7820585c6cf707e7f62e5c75eab5140d27caa76a19a4911d1a0de27",
      "en": "「You don't understand.\\nMy true power...」"
    },
    "304:2449": {
      "repository_source_sha256": "9587d87dde29be1355e7e14cf5f29415536fc4b89ba9638a5babb06c236d7b9b",
      "en": "「What's wrong? Do you fear a god?」"
    },
    "304:2484": {
      "repository_source_sha256": "1caef712d01645367826ab154bed7c68e7c234b49ff197e82c31ac6760aa6c3b",
      "en": "「Accept it. Accept a god...」"
    },
    "304:2511": {
      "repository_source_sha256": "5eed2384c446b06cb83382e4110d7d47e98e6e68bbe5ceeff1185fa269100110",
      "en": "「You have nowhere left to run.」"
    },
    "304:730": {
      "repository_source_sha256": "58bc542cbcf3fce1f0999495dd2f316876576562dfe4c3b9dfeccca332438914",
      "en": "「You'll learn how powerless you are.」"
    },
    "304:765": {
      "repository_source_sha256": "4d0a2cec6303ea908b20a7d24039364ae7f6d2d50db3b14945d0f983ced114f5",
      "en": "「Is that your last act of resistance?」"
    },
    "304:2371": {
      "repository_source_sha256": "12190a85e7e481c6cb6f546a8a6243d4b4eeff111386eaf4fbb57d7d6509f8f4",
      "en": "「Oh... you're good at petty tricks.」"
    },
    "304:2406": {
      "repository_source_sha256": "813f126e755bdb67cd0079cf4eac331574a06cf3f9a8db84d7380904f1c4590b",
      "en": "「Deceive a god...? Such cheap tricks.」"
    },
    "304:2100": {
      "repository_source_sha256": "004d599aa1c5860d3758b2ff9bca2f3cb7ea597ea677cee399ad33e15734aa91",
      "en": "「Cease to exist.」"
    },
    "304:2126": {
      "repository_source_sha256": "007fcdd301c7fe33f27afd08cfdb880d7a026655333aa237dd1728e6787d0408",
      "en": "「Receive your punishment.」"
    },
    "304:2152": {
      "repository_source_sha256": "dbb8bee38913459703bf692c346733e0a25c4ba01c2294ebf90fed764fc927b0",
      "en": "「Farewell.」"
    },
    "304:2165": {
      "repository_source_sha256": "73ee68730e5df50376ad15e8bfb94a73c23ee9a70f597ecff393121ea4ce5034",
      "en": "「It's time to part.」"
    },
    "304:2180": {
      "repository_source_sha256": "ffe9d3d8919e6632e6e77436530aedc330ed86b1715ff3cb4db4620edd48c964",
      "en": "「This is inevitable.」"
    }
  },
  "speakers": {

{
  "schema": 1,
  "rows": {
    "315:0": {
      "repository_source_sha256": "de2aaa0d9b108810a6a1f056af947f24ccc2c9914091bd47d78589d87c9780a6",
      "en": "「Gonna smash you to bits!」"
    },
    "315:21": {
      "repository_source_sha256": "df4d3218083de5b1edc8bd34f0482ec4138a5a0c6fc5e05f2cd65d131e9092a9",
      "en": "「I'll sink you in the sea!」"
    },
    "315:44": {
      "repository_source_sha256": "640c900d708ff3d4aa168db1133ae4b5e11b14f2ba6b353b63c6a151a12975f3",
      "en": "「Get ready to hurt!」"
    },
    "315:71": {
      "repository_source_sha256": "dff7f72d495ac51ac9d59faffd26f229da0f8cc9dfb26162474ef53a781fd398",
      "en": "「I'm gonna raise hell today!」"
    },
    "315:92": {
      "repository_source_sha256": "6393c176cd244e15fe5545bce29f6ef61ee12b7e6eb3da7f2552004b1c2f723d",
      "en": "「Outta my way, outta my way!」"
    },
    "315:113": {
      "repository_source_sha256": "84a8194f6c1e77f6a802e7a1d5ccfca71a7306b0a9404aeac9fb681447b3a2e5",
      "en": "「I'll beat you to a pulp!」"
    },
    "315:136": {
      "repository_source_sha256": "4fd8d0e514bd1f9c5626e06288160dac79382e9ab428b25ab9dcf9e5e3389f38",
      "en": "「I'll plunder you, pirate style!」"
    },
    "315:163": {
      "repository_source_sha256": "69bcff7bc206e3085ae9a0742f3cc35c5be7ac3bd553748bb030ec99776283ae",
      "en": "「Let's go flashy, pirate style!」"
    },
    "315:194": {
      "repository_source_sha256": "1884252e19be5ba456e5efba7d7b51c8d959f7c765f6e936d679e6ab7902de3d",
      "en": "「Drop dead!」"
    },
    "315:217": {
      "repository_source_sha256": "89b3592bd20c2e9ff0635df65731cf8d6f9a5952b7f97f11deb4633431d77114",
      "en": "「I'll hurt you good!」"
    },
    "315:246": {
      "repository_source_sha256": "280c4242be42f7ce1c3893330f5e1c0bd468ed7241989f595638caf3c2064bf3",
      "en": "「You won't get a turn to attack!」"
    },
    "315:279": {
      "repository_source_sha256": "f2c6e8af67e36bc1fb37f2586acc7e6fe021bd574d5f27173c4d20e47fe248a9",
      "en": "「You should've just surrendered!」"
    },
    "315:316": {
      "repository_source_sha256": "e2eb79105a10ea3bbcb2f149705c2bfc5ab71e62d7b7581a17f89b4afd309b42",
      "en": "「Turn into scrap!」"
    },
    "315:345": {
      "repository_source_sha256": "0041a4508e759520d1b7aa9b380f1e13ee06e63cdab674710c8b5b3ef97f9e5b",
      "en": "「I'll show you how pirates fight!」"
    },
    "315:378": {
      "repository_source_sha256": "a89782e396a2b56e28e6104e05a0ee3db115c5da21756ae2f82f647570d485e8",
      "en": "「I'll cut you up and sell the parts!」"
    },
    "315:415": {
      "repository_source_sha256": "b1087d204a6fcdcc9f227d57184352b72a1c290f3ec18a3f1d1fa5907bab7de2",
      "en": "「Don't act tough if you know\\nwhat's good for you!」"
    },
    "315:464": {
      "repository_source_sha256": "fcca0c2c285d7bb2ab680ef10fae7c855e7e538d38e482f31dacee0de5bf8b37",
      "en": "「Too late to surrender now!」"
    },
    "315:497": {
      "repository_source_sha256": "fb53679c7c8ba71a33320fbdf60f0368b69644ff9834e65ed915e4e935717301",
      "en": "「Nobody in this world can beat us!」"
    },
    "315:540": {
      "repository_source_sha256": "448fd82d616edcc8217c8105765c6da882f5d68c9d0b836c545ed1079cc2fc0b",
      "en": "「Bad luck, getting spotted\\nby the likes of us!」"
    },
    "315:638": {
      "repository_source_sha256": "57eba7a4fbf80561cdaba9615fb22bd81692eddfbb0ca0ed7308f9889d03f78a",
      "en": "「Give up! You can't run anymore!」"
    },
    "315:681": {
      "repository_source_sha256": "fc69963292284cee57093bdf517d7ddc5632e1d72a93988e80dffb156759fb0a",
      "en": "「I'll finish this in no time!」"
    },
    "315:710": {
      "repository_source_sha256": "1112773e046b288232007df5a4c83752e52e4696239bd204b1f30a4482f3f919",
      "en": "「The seagulls sing a devil's song!」"
    },
    "315:741": {
      "repository_source_sha256": "ae6c6e34cb91d249704a57c48e2c2aac85e2fe352bc269e38147d270f192aedb",
      "en": "「The sunset will light up your skull!」"
    },
    "315:776": {
      "repository_source_sha256": "5468eaaeccd979e5e9ad5ef7aefff4dc90a1082145a42734f153b42c80f9e055",
      "en": "「Don't think you can beat us at sea!」"
    },
    "315:815": {
      "repository_source_sha256": "7a2bd0b89b33777abc636c83dfb17c678e7495a0ff0afdadb1bbf89c09f86702",
      "en": "「$$ラケージ$$!\\nWatch me fight!」"
    },
    "315:866": {
      "repository_source_sha256": "5e25bd74f065927817dd41be20f84f48743a175da881bcfa5a1ce48fc2b194a0",
      "en": "「Don't you dare look down on\\nthe $$ラケージ$$ Pirates!」"
    },
    "315:921": {
      "repository_source_sha256": "dcac3ab8f30d7fce0c9ef4b963cf7bf240fc36a07873597907c892fda17da7c9",
      "en": "「Boys! Don't you dare disgrace\\n$$ラケージ$$!」"
    },
    "315:978": {
      "repository_source_sha256": "0bcc4754c71b2dcfe5c09dea8cfbf033e4275c66a177ee561d202a310ef49881",
      "en": "「Anyone who defies $$ラケージ$$\\nneeds a good punishment, huh!」"
    },
    "315:1572": {
      "repository_source_sha256": "43ecc6e86f6c85a64364b1f6524dac90a1be07fd63f04db1910b2d40ff736557",
      "en": "「That $$ユンボロ$$... it's flying!」"
    },
    "315:1611": {
      "repository_source_sha256": "146f90db69536c2fa209178700fa3b05bf92ebfafbd6ee63f5a2d1792f2ccc28",
      "en": "「That's the rumored flying $$ユンボロ$$!」"
    },
    "315:1646": {
      "repository_source_sha256": "1acf4854287800b9d954e6da9e28f4218561f6b5f5fb96d5338cbdbffa3c51ce",
      "en": "「Big-head! I'll knock you down!」"
    },
    "315:1689": {
      "repository_source_sha256": "bbba94558c605d870163898d8596bfaf0e6978e69c879fce477d1b313b765467",
      "en": "「This is Gargantia's secret weapon!」"
    },
    "315:1730": {
      "repository_source_sha256": "e0635176950c0f6dad06b128a9c16bda06103e02cd4e3c2574f959dcbd88d897",
      "en": "「Damn! What a huge $$ユンボロ$$!」"
    },
    "315:1773": {
      "repository_source_sha256": "d9fccace12fca0c57ff4e44bb61b9f054f96009d338fdd790eef256fa583c79d",
      "en": "「A fight isn't decided by size!」"
    },
    "315:1816": {
      "repository_source_sha256": "46d600b56507b2b6fa214bab3325f8ee9ee75d06fdd8176675587994f9da79a2",
      "en": "「Even if it's a huge $$ユンボロ$$,\\nit depends where you aim...!」"
    },
    "315:1867": {
      "repository_source_sha256": "9566b6e208b7afac76d333e1b55eb2666bcc03d53ea0b5392fed9e15ec77ef08",
      "en": "「N-No way, that guy...!\\nIs that the rumored $$ガンダム$$!?」"
    },
    "315:1918": {
      "repository_source_sha256": "f1ff8d59577f8db01ff0195840e867d2984b33479dd3deb4ae08323e9b41da7a",
      "en": "「To see the legendary $$ガンダム$$\\nwith my own eyes!」"
    },
    "315:1969": {
      "repository_source_sha256": "41bbc151e53be94c9d81f238b0be59522e515d9efca4ce6ff864ef639b45de84",
      "en": "「Here comes Gargantia's bodyguard!」"
    },
    "315:2012": {
      "repository_source_sha256": "2c4a92d2c8382a4165070080e9913c83d9e643e9e3fb08c4acc2b83c0ccd9cfa",
      "en": "「I'll pluck that mustache off!」"
    },
    "315:2043": {
      "repository_source_sha256": "b760d6bd8633c1317d9c405a746df2ffd8e28380cf5ff5e33e5abaac9fa8f90a",
      "en": "「Th-That's the rumored airplane, huh!」"
    },
    "315:2076": {
      "repository_source_sha256": "5aaf9471f5cd498672292dc8ecbdd8ae84213b6e545a42dcefe34bd9276ef1d9",
      "en": "「A bird!? Or that airplane thing!?」"
    },
    "315:2119": {
      "repository_source_sha256": "7d866ab348be6b697e90aa39cd490c6b7746e396b8b16ba701f42c7447f79e33",
      "en": "「Quit darting around!」"
    },
    "315:2154": {
      "repository_source_sha256": "7bbcdb3a6afaa1ba79b1a1205e22c647b42e2ae03d6b03895f71bb35dcdf07a3",
      "en": "「No way! A shape-shifting $$ユンボロ$$!」"
    },
    "315:2193": {
      "repository_source_sha256": "d03630fa451ed02eb22d33dadbddef667e59e021c4898d916fb20b1ae434388d",
      "en": "「It's like a seagull $$ユンボロ$$!」"
    },
    "315:2232": {
      "repository_source_sha256": "7fc9b515724ef81aebe3228cf33cced938d5cfae8a02be7b7bba3ab0a2027d32",
      "en": "「There's a bunch of similar\\n$$ユンボロ$$s around!」"
    },
    "315:2281": {
      "repository_source_sha256": "72a2974bb121586a99b5584b5a0ac297252ea71f236995012cf8a227e88ac6cd",
      "en": "「Even if we catch this one, it\\nwon't fetch a high price!」"
    },
    "315:2336": {
      "repository_source_sha256": "b79867a2bf48a0843416695156c80d9ab0a929bfcc7325231159eba401851cdc",
      "en": "「Even women and kids get no mercy!」"
    },
    "315:2371": {
      "repository_source_sha256": "cb6d7683e643b2fa268605f9a6ce847ff29318e6f9e363f5e301f51226e39cf7",
      "en": "「That one's unlike the rest...!\\nAn ace, huh...!」"
    },
    "315:2420": {
      "repository_source_sha256": "82c5692db2dcaa85b651cffa4308d8e43ccf0c9ccf7787a267b197282ff5eb14",
      "en": "「Take that one down and we win big!」"
    },
    "315:2453": {
      "repository_source_sha256": "51f151497a65bd7826fe2c28b826cec8e74cda1f940bbcd86dc757df3bf411b5",
      "en": "「Just sink the ship and we've won!」"
    },
    "315:2488": {
      "repository_source_sha256": "643748d8fcef449c084cf8c89bd4ab68dca509cdc072103120c044ab4294b057",
      "en": "「It's this big! It must be loaded\\nwith treasure!」"
    },
    "315:2553": {
      "repository_source_sha256": "6fafeb1901f13ef0363b24ef490c6f53bad593338dddc0aad6ed0d2105d8480f",
      "en": "「A ship that dives!? Never seen one!」"
    },
    "315:2596": {
      "repository_source_sha256": "a154c940fff18e15f7b70410e2f65265a247553578ea57277586351c59122957",
      "en": "「This thing! A whale-type $$ユンボロ$$!」"
    },
    "315:2633": {
      "repository_source_sha256": "882e1a1b549a5e37fa1131027e42c891a6246c4db11bb904115db5307282e3ed",
      "en": "「Huge! Even bigger than a whale!」"
    },
    "315:2674": {
      "repository_source_sha256": "91f6cf967cc5128098b090ab995bee9de8b91053db1367919fefef05f281a2ef",
      "en": "「This one flies too!?」"
    },
    "315:2711": {
      "repository_source_sha256": "cff410e46620554b20e49c1af75e5a70ffde8b614701f537d3def685a6d87429",
      "en": "「That thing...!\\nA $$ユンボロ$$ from beyond the sea!」"
    },
    "315:2762": {
      "repository_source_sha256": "75718bdc0f0958011ac18f6dbd7558dc06c102fd2553e4f1a76eebe4227ead7d",
      "en": "「Challenging me at sea takes guts!」"
    },
    "315:2803": {
      "repository_source_sha256": "bca101b6bc9fc0712aa7572e90ac07010a8708bf174fe82f8fa870d8f564bbdc",
      "en": "「No way I'll lose on this sea!」"
    },
    "316:872": {
      "repository_source_sha256": "8af47081e588f31d1c481bb6dc76fc31003d6a3aaeed71f4f1ea630b14cffed0",
      "en": "「Boys!\\nDon't disgrace $$ラケージ$$!」"
    },
    "315:2840": {
      "repository_source_sha256": "715fd8df2f05e37fc2121a47c00afb99559a3619162e4261532290e9922f7e7d",
      "en": "「Gotta pay you back!」"
    },
    "315:2865": {
      "repository_source_sha256": "5d435eaa50df247dd39646d852ec38970c5cc3bcde90f019f73d3c781c3502f9",
      "en": "「So that's where you were!」"
    },
    "315:2894": {
      "repository_source_sha256": "4ac237c71337e71b9321b618e085e063ca094c2243ae7325b1aa7e8a8acd14fb",
      "en": "「Fine! I'll take you on!」"
    },
    "315:2927": {
      "repository_source_sha256": "646dc575a3a1e87ee921648b42c8cfbdc54d46a0985cf318543e55aebb98e958",
      "en": "「Then I'm coming at you next!」"
    },
    "315:2964": {
      "repository_source_sha256": "48cb00f7d6b4f35842a78f4745e52839bf2e48b67ec1d6f9432ccc1273abcaee",
      "en": "「You're the one who started it!」"
    },
    "315:3003": {
      "repository_source_sha256": "74c3e9cb22d82cbf60f95f1e60cfa9223dccd1542f1bf7051989b114b1808108",
      "en": "「I can't end it being looked down on!」"
    },
    "315:3044": {
      "repository_source_sha256": "e58ede9e06e82608a3e568da41f6b627551376ae968168f29a7ba15d84015bc5",
      "en": "「I'll chase you to the horizon!」"
    },
    "315:3083": {
      "repository_source_sha256": "8fa675999574cda38d714780cad989fa02f1b183ebbea08edb48e21dda2053f0",
      "en": "「I'm no man if I just take it!」"
    },
    "315:3124": {
      "repository_source_sha256": "cb525769999327a56246fcfda5d45b00a6e12f6ee7cea7a57579129bd99a502f",
      "en": "「Bastard! Wait up!」"
    },
    "315:3151": {
      "repository_source_sha256": "b7bd94b671dbc60bc3395e8f8c3969ea182fe6943c173a70da9a0c93a5a9bdfd",
      "en": "「If that's how it is, then take this!」"
    },
    "315:3184": {
      "repository_source_sha256": "fd97af0eee3efe1bd358b7e0a3dec4262fdfdc2ae2c865fa125543a0408869ad",
      "en": "「Hold on! No hit-and-run!」"
    },
    "315:3225": {
      "repository_source_sha256": "3e3f8b8cdc3342af125b1973d5c234d20d038f0a1c2e3c73ff70a76a5e76a46b",
      "en": "「My anger won't settle like this!」"
    },
    "315:3266": {
      "repository_source_sha256": "f32ca2bf13a599e761ed039a06574f1096c443f690c4c458612e5a76d437d36a",
      "en": "「You can't run from me!」"
    },
    "315:3324": {
      "repository_source_sha256": "db08f3b668f7cbb0134a347c4bb1bcdbd53f4861bac7a2fd721e3adae8d2d3a2",
      "en": "「Too bad! It's my turn now!」"
    },
    "315:3361": {
      "repository_source_sha256": "9f2ca1acceba9d6ab0c0ccac297bc0eaa0adc781b07e9d1390c877a058b6eda7",
      "en": "「You hit me, I hit back!\\nThat's how pirates are!」"
    },
    "315:3422": {
      "repository_source_sha256": "4610337fbb6196f98e41bde10ec3434b8e75f804afc47b272bc25c15f1aac64c",
      "en": "「I'll lend you a hand, bro!」"
    },
    "315:3451": {
      "repository_source_sha256": "c20cd130df55f29fb1b1e891f5d396340acdd0e7605fb0736b10c91f6d425455",
      "en": "「I'm taking the best part!」"
    },
    "315:3480": {
      "repository_source_sha256": "bb545985134a520c48652ec347fa8a98923a9f0d01508de2daca1ee55f5bddec",
      "en": "「If you can't smash it, stand back!」"
    },
    "315:3515": {
      "repository_source_sha256": "7a61156d2df3f7326a145d4dd7a61d2ca0500e8b0df10de9446965e0c17daccc",
      "en": "「Move! It'll get away!」"
    },
    "315:3558": {
      "repository_source_sha256": "36bef57fd77daed6fd3bd4a8f7cef27f28b2fbb946f57b89f6c828819737a878",
      "en": "「$$ラケージ$$, leave the rest to me!」"
    },
    "315:3593": {
      "repository_source_sha256": "00af0fe49ea544b7be9fdb3de343a4d833532015cbb466ec4eeb212be09c630d",
      "en": "「I have to be useful to $$ラケージ$$!」"
    }
  },

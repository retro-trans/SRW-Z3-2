      "en": "「Ships can't move right in the water!」"
    },
    "315:4903": {
      "repository_source_sha256": "6613e4d1fdeb279bb32f6cb18f38fd0fb8fffe5797b650ce4d7130c620791005",
      "en": "「Amateurs can't beat me in the water!」"
    },
    "315:4940": {
      "repository_source_sha256": "2746adc482e1833b0feb25e4566174e26f7c196b155df1d25dcaa3aa7ca72cf2",
      "en": "「Nice moves, but what's the point\\nwith an attack like this!」"
    },
    "315:4993": {
      "repository_source_sha256": "1ebf28955804cb80fd3920959b49716d653ddc734be46f2aef8b3c1f792797f9",
      "en": "「Basically, a fight isn't about size!」"
    },
    "315:5036": {
      "repository_source_sha256": "561c793cf32b1230ebec174a6990e291b8fce3732e526f7e0e924fdb6952bcea",
      "en": "「Time to give up the $$ガンダム$$ name!」"
    },

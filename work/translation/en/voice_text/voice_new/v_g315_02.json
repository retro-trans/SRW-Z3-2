      "en": "「I've got the edge in the water!」"
    },
    "315:5157": {
      "repository_source_sha256": "223e711f26aa7622688490cb8d7a9be662eab2fd1418dd2eb0e246f95161107f",
      "en": "「A pirate, lose at sea? No way!」"
    },
    "315:5303": {
      "repository_source_sha256": "093909787f4a4d010a99b3d05b657125193ee13a73127c7f20c8c5ff0af3c1bb",
      "en": "「Huh? What's this?」"
    },
    "315:5328": {
      "repository_source_sha256": "98359986ac35db08eea50fa4a44abf328bcddd3909db3261eebca991b4381e07",
      "en": "「Come on, don't tell me that's all?」"
    },
    "315:5365": {
      "repository_source_sha256": "9b843e8df9a7327045500df5c4e43d8c1d18a03183a4af64849576ad5f7eedc8",
      "en": "「Looks like I've got nothing to fear」"
    },
    "315:5400": {
      "repository_source_sha256": "c90cf7556827b401618ccf1d8bdb501b25c15dff541ef4a1c5690b56939b731c",
      "en": "「Surrender now, while you still can」"
    },
    "315:5431": {
      "repository_source_sha256": "a25386f8d9ce6a1226ed30a0d766646fdb4dfa0045d24d2e998c1f96df4ef2b0",
      "en": "「Feel free to come at me for real」"
    },
    "315:5466": {
      "repository_source_sha256": "57958bb5a036dcf84126882b0c4c909f260221ee657727dc50c600e681ca3995",
      "en": "「You call that an attack!?」"
    },
    "315:5495": {
      "repository_source_sha256": "224aeb76a6569260376b13d942fd6646781130df222baef7b701660a4751e96e",
      "en": "「Ha!\\nYou think this can beat me!?」"
    },
    "315:5544": {
      "repository_source_sha256": "942057a49aa6118056fc9548c2c84fadda602c958a8b21ce5d017317d7b86b7b",
      "en": "「This thing's built pretty\\ntough, you know!」"
    },
    "315:5593": {
      "repository_source_sha256": "0038a584b12e913d0286fa8a4650670b6494715de2ec1c0ed6c2914e1cb02799",
      "en": "「Acting tough when you're so weak!」"
    },
    "315:5628": {
      "repository_source_sha256": "b875099fc4912c421f88a6499089615f9a5ce2be45944e4a2bc8e9d90775a44c",
      "en": "「I'm not taking it head-on, either!」"
    },
    "315:5671": {
      "repository_source_sha256": "65ab504709ff53a611f29d820eb95b0435aeba22f2922a5cb144b7eb370250b7",
      "en": "「I'm not some salvage $$ユンボロ$$!」"
    },
    "315:5714": {
      "repository_source_sha256": "44c87ddd43d997320eedf2047a5e493c45e77dab9ec6ef18fcbf104caef3a919",
      "en": "「Don't make me laugh!\\nAll looks, no substance!」"
    },
    "316:5022": {
      "repository_source_sha256": "a324e0c19cee2717aefb7ec3e734cbf63c909b100496519ec383b2db6b6a08c2",
      "en": "「Just flying\\ndoesn't mean you win!」"
    },
    "315:4430": {
      "repository_source_sha256": "abf18f1a0a7600ad92b8d8962879589f82eb87765cac2c44222e289432335d1f",
      "en": "「Too easy!」"
    },
    "315:4443": {
      "repository_source_sha256": "5380be79fc4e171abc4de7cf688d7f042c2afd3d9a86747dfbe7a16bbb5fe4c8",
      "en": "「Too slow, amateur!」"
    },
    "315:4472": {
      "repository_source_sha256": "e1ad94e1042451e974621395332bcaeae7e1aa2bfd6241e8a6138f553b9e9312",
      "en": "「That was close...! Just barely!」"
    },
    "315:4503": {
      "repository_source_sha256": "9e93b85854f89a9b5f9fdc3a75c7d75343c4808eb7cc1ec5861fa5e8bac3422a",
      "en": "「Lousy! Come back when you're better!」"
    },
    "315:4536": {
      "repository_source_sha256": "cef01493c28bff5e12270e976fb12c4873b99427937aee4e23090072830ca32a",
      "en": "「Too bad! Way off!」"
    },
    "315:4559": {
      "repository_source_sha256": "247d9d4273a0801cfd48464ef2efe9ba50428811b5d219aedcce1bfb4c5b852d",
      "en": "「That's how it's done!」"
    },
    "315:4584": {
      "repository_source_sha256": "b55408e4ce704388ab3ddf839b38fb3215d152223fc54effcfc8bc20d1848393",
      "en": "「Slow attacks like that won't hit me!」"
    },
    "315:4619": {
      "repository_source_sha256": "568f9d3730bd4c10bf10e4e7b43fe4c283c4b62d61be4796f0696eeadeef6cf0",
      "en": "「Can't screw up in front of $$ラケージ$$!」"
    },
    "315:4656": {
      "repository_source_sha256": "8d5fa9d2ebb94bd52016d25f22083f08fdc2014a36b42382b8cf633a2eeb7af6",
      "en": "「Are you even aiming!?」"
    },
    "315:4685": {
      "repository_source_sha256": "a316aceab8e1a26421fb668e08c8881b7025cdcbe3499b5dfca0fa9c8a0585ec",
      "en": "「Where're you looking! I'm over here!」"
    },
    "315:4724": {
      "repository_source_sha256": "4293c9f5f81c0007e89e0b7c05448a991adce89ec3cc241b3035fe89d4a0e447",
      "en": "「I'm a man who delivers when needed!」"
    },
    "315:4757": {
      "repository_source_sha256": "3a8bea75425d0fdc4e1a58ecba612932a7c34d08242067bcf9b3230b1a84434f",
      "en": "「Phew... my lucky guess paid off」"
    },
    "315:5184": {
      "repository_source_sha256": "28c4d0d8fe953a0afd3ebf235e7f866aa5dc0ed83fec33c239d371b7a79e30f0",
      "en": "「Like that'd ever work on me!」"
    },
    "315:5211": {
      "repository_source_sha256": "a2c18eb9fbd018a1c773550a0c750ba710bd43fac54958995e7bee03e02bad6b",
      "en": "「It hit, but it didn't hit,\\nhow about that!」"
    },
    "315:5260": {
      "repository_source_sha256": "bde0969c149a2a6319af337028bc808efba1c07cfa9f1f251ac23eaf560fc114",
      "en": "「Don't you get it? It's useless!」"
    },
    "315:4364": {
      "repository_source_sha256": "22adc912e9e7380c7fe0d323ec16fe52a571b323b6b81945d6fe6f7034ade1eb",
      "en": "「Where did that attack come from!?」"
    },
    "315:4399": {
      "repository_source_sha256": "284457969378715b45bf4f1f9841c8cac40c499564ee7b4d83c62314a20d3ad8",
      "en": "「Bastard...! Where are you!」"
    },
    "315:3634": {
      "repository_source_sha256": "dcbdd801dee46ca39aee3fe456c8a9e1700585fa61df11552bbeb55442d170b7",
      "en": "「You're helping with repairs later!」"
    },
    "315:3661": {
      "repository_source_sha256": "cb6aaaa77ef60c3cd640e0fc25e7a8d82c01d2e9e77107adb00d2bd79c434116",
      "en": "「Idiot! Don't stop moving!」"
    },
    "315:3692": {
      "repository_source_sha256": "889667316832a6a1db5c88579d66d40103b49b1582e436c0025d9bdcf27e0a12",
      "en": "「You owe me one, bro!」"
    },
    "315:3721": {
      "repository_source_sha256": "3735fa52f0f79c28017b808d48aaf6e68d6a9749375f650e4daee3d35e7481d5",
      "en": "「Geez! Quit giving me trouble!」"
    },
    "315:3760": {
      "repository_source_sha256": "fd8b24bf1aebb438efac19f2b77e3a8e6b7cde41924386d81b36558949c5b5fc",
      "en": "「Please get back, $$ラケージ$$!」"
    },
    "315:3795": {
      "repository_source_sha256": "fb7e631a0ae3f0af2825366f133a5523799d82296ba281bd3d86c33fbfc65157",
      "en": "「Hey! What are you doing to $$ラケージ$$!」"
    },
    "315:4116": {
      "repository_source_sha256": "6583cda82cd007b4c3b4501e6ec578c13f99576ffba34604fd831c3c0f25a4b4",
      "en": "「Damn it! Can't I hit back!?」"
    },
    "315:4153": {
      "repository_source_sha256": "ea377cb89e1a6a8ff98962c8e16dc74efdca4598609d85fc9915e1bb97e8235a",
      "en": "「Bastard...! Must be laughing by now!」"
    },
    "315:4196": {
      "repository_source_sha256": "1d8e743376a965f13b541a15822c56f693a9836887e2a6a774599361828b9cfd",
      "en": "「This is the only time I let you off!」"
    },
    "315:4235": {
      "repository_source_sha256": "c492b04a28245cd736be119a89b5c342c9e1bc8732148a6d0bf632ad5ff5c09f",
      "en": "「T-This is bad! Gotta act fast!」"
    },
    "315:4274": {
      "repository_source_sha256": "31074f0a790198d4bed18330af0e7b74e4a76f42697af8873dcc0d1df44a6df8",
      "en": "「What's going on!\\nI can't do anything!?」"
    },
    "315:4325": {
      "repository_source_sha256": "197d71f39163f458a0f21056cac805a1f003c5b713eb28f1b38d1a1ed6452f33",
      "en": "「Hate it, but they're a step ahead!」"
    },
    "315:1039": {
      "repository_source_sha256": "232626c560bf67b6f4b01237c2c5e7234d6490d8e8aff15355c9c86f3e31bb49",
      "en": "「You make a nice target!」"
    },
    "315:1062": {
      "repository_source_sha256": "50ca962e11d705e0c1e18caacbdd98a660856dc3e8f003621221d7d4bd5f70b7",
      "en": "「I'll shoot you down!」"
    },
    "315:1087": {
      "repository_source_sha256": "84566214deb730ed7a42b5b62d3a9461d9726f5a05f6f005df48cb6db693fba3",
      "en": "「I'll riddle you full of holes!」"
    },
    "315:1114": {
      "repository_source_sha256": "be34e00c51c52a7c36279dff9339cd50df230f5b760ce97eec969bd099d30982",
      "en": "「I'll hit you dead center!」"
    },
    "315:1145": {
      "repository_source_sha256": "d2431244e10c424a34dfd07fded925f59d9767ce3a5e0e1763583ffbd78c3df0",
      "en": "「Gonna blast away with this!」"
    },
    "315:1168": {
      "repository_source_sha256": "4690e805e3ea5e2be66a0224332ee2c2ae1cc7adf8755e7e160b31be815e6180",
      "en": "「One big bang, here I go!」"
    },
    "315:1195": {
      "repository_source_sha256": "c1974a3631dd690929bd4178d30dc33ab0d93d16352d5da56dbdeae08541ecbf",
      "en": "「I'm not holding back on ammo!」"
    },
    "315:1273": {
      "repository_source_sha256": "b68e1cfdcef7499894d448a72ae5b3f4da3c450080738229f8af043bf03f12fe",
      "en": "「Charge!」"
    },
    "315:1288": {
      "repository_source_sha256": "e7f8fcad565cbae243150d4b6eb23897a948914fcbd6ae8ac0c048286f3be81a",
      "en": "「It's a battle of power!」"
    },
    "315:1309": {
      "repository_source_sha256": "5a9b27608538831c35ae0aeab4c132fd4af3e9aae15591bfe22d3f265ca18f21",
      "en": "「I'll punch you out!」"
    },
    "315:1332": {
      "repository_source_sha256": "bd69bbbf16c13c7b606af79e62f1a418f7fa45f0cda3b87a97f65f50d7173efd",
      "en": "「I'll beat you black and blue!」"
    },
    "315:1359": {
      "repository_source_sha256": "73c728e52a8a6ed41ed5494fae31224cd8d8be4cdf320ebd1e1b71e0642b22f4",
      "en": "「I'll smash you flat!」"
    },
    "315:1382": {
      "repository_source_sha256": "27651275f0fd3a93064719e2b39d0caaf33de06eb37893638e461915f0893145",
      "en": "「I won't lose in a slugfest!」"
    },
    "315:1411": {
      "repository_source_sha256": "425bb86fd351f539d7f3fc9991462bba7996c7cae51e02f47281bd77f284a7a0",
      "en": "「Don't scoff at this thing's power!」"
    },
    "315:1444": {
      "repository_source_sha256": "07b1483bab5d22ae8aca74d1f9eefcd6f79f18202b5d61a4181a065f5a844828",
      "en": "「Get blown clear to the horizon!」"
    }

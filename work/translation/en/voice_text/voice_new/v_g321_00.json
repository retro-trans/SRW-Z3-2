    },
    "321:1835": {
      "repository_source_sha256": "32444c786ea6cf8ee7065c97146bdd6b4a49964b552fcecd99b19e2355f0c546",
      "en": "「$$傷だらけの獅子$$...」"
    },
    "321:1856": {
      "repository_source_sha256": "00f8365088863dcf78b5c74bd023f65439bb6c6b32261ca16cef6c569e1374b4",

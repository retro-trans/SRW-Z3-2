    },
    "321:1439": {
      "repository_source_sha256": "f3b1de1acdfa6d52ab404800277d6113c9498e1b5d0776c7c8ff5bc441e9c507",
      "en": "「No future lies beyond that drill.」"
    },
    "321:1470": {
      "repository_source_sha256": "453d4cae498d405c5196b62fac9a7e38cd92a39de8dafbf548f460f01916a789",

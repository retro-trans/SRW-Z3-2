    },
    "321:1713": {
      "repository_source_sha256": "239f5a0a98ddfadec7981bc2808da309ca8c95e2495776275b612211f5fdc3ed",
      "en": "「I'll strike their core force.」"
    },
    "321:1732": {
      "repository_source_sha256": "defab92ccc6d9bae6d0e982ee7f54352f8d0996094feac2faff0236735bfb167",
      "en": "「I'll crush the mothership.」"
    },
    "321:1747": {
      "repository_source_sha256": "132a81dcf98502311fc7ae457cc662a5f88fe01d8e1e50f901340f1141e47695",
      "en": "「I'll take away their home base.」"
    },
    "321:1764": {
      "repository_source_sha256": "2f5ce44fe7b69ece344c063f9dac050837d1d14da2dec84be6862095141ca08e",
      "en": "「A $$スフィア・リアクター$$, is it?」"
    },
    "321:1791": {
      "repository_source_sha256": "386b24c33d45b416b091aeeb41469ceeb278aa5def74be42d7a9ef84c39c146c",
      "en": "「I won't let you use that power.」"
    },
    "321:1814": {
      "repository_source_sha256": "8bd2d5936829859eabab51868597ac23dd155a43c99b8c7e9f7195ee6c8ca0b3",

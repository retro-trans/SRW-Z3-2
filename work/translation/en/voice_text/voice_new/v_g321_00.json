    "321:1487": {
      "repository_source_sha256": "4a91cb1d0761bcfe39bb17650650e62cc8748828a525a3c927ab4290c8e480d6",
      "en": "「The target's size doesn't matter.」"
    },
    "321:1514": {
      "repository_source_sha256": "f0293f8914fbe47a28b664622f9a0af591234ca0d5bec67d358254e455b502e4",
      "en": "「Once it hits, that's the end.」"
    },
    "321:1541": {
      "repository_source_sha256": "b45d72c7bbdbca6fc61186a193690f9f7c78353eb41e20c528ebab839fc9133c",
      "en": "「An $$異能生存体$$ is here.」"
    },
    "321:1564": {
      "repository_source_sha256": "29200c6696b4d6e989ecb7801db658fa1a778c30d6677bb55864661dbe84772d",
      "en": "「You may not use that power.」"
    },
    "321:1595": {
      "repository_source_sha256": "ffcf683f372cf58652f0367864fdab32878457ab417c3c0d5e949c64c3fc3bfa",

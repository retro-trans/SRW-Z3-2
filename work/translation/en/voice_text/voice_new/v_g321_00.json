    },
    "321:1614": {
      "repository_source_sha256": "b8e84659f67ee1d7ac2625381a75b76d770b8fe3a7d1be4086e7fb27b41c95cc",
      "en": "「I'll simply clip your wings.」"
    },
    "321:1633": {
      "repository_source_sha256": "f9a45c943b72c4ac117e414c674886691b01f8d7c2a0804f52b4d54c51cd94e3",
      "en": "「No room for clowns on a battlefield.」"
    },
    "321:1656": {
      "repository_source_sha256": "249c39b480f1a715314eb3ace4f78ad10b5c62c13ed4ee6edfe8e1c3d35476d7",

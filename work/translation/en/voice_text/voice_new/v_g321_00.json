    },
    "321:1875": {
      "repository_source_sha256": "4447295cb818bd7cb840351e4249b43d4b333197887470668909df0dc9f19010",
      "en": "「$$揺れる天秤$$...」"
    },
    "321:2140": {
      "repository_source_sha256": "896e387a6002b2830fb3e80c0770704fd76d41338db657b60d1ff98ee007b99d",
      "en": "「Beginning the counterattack.」"
    },
    "321:2159": {
      "repository_source_sha256": "8c942313c3aec1a788083f65cd3e92303044a6a71ef8f9f99e59c2064d11e413",
      "en": "「My turn.」"
    },
    "321:2172": {
      "repository_source_sha256": "51a8925ecd8de089054325cb3afe46e06bae918eec3c597aee6709290c8671bb",
      "en": "「Kill or be killed.」"
    },
    "321:2210": {
      "repository_source_sha256": "e1309f5a91c6dc83f3fd83d113091bfcd92c4ba70790e2dbd4d86bab99eb7127",
      "en": "「As you wish.」"
    },
    "321:2225": {
      "repository_source_sha256": "835fc07ddc8119d5785d9f7033e03981e11948b442f308d3d70596a2fd102fae",
      "en": "「I repay my debts.」"
    },
    "321:2240": {
      "repository_source_sha256": "8e0725c654010b8b7e575e79a10da63392868193a093a0af5a99ea88a8d22b02",
      "en": "「You reap what you sow.」"
    },
    "321:2255": {
      "repository_source_sha256": "4cea053824ac633094135ae875a9bd58e2358638525b67db062452f67652df68",
      "en": "「You went in too deep.」"
    },
    "321:2276": {
      "repository_source_sha256": "b55773ae7735efc0f1a47447ebcf4c18778964c379d43730b4a0dfd69656661d",
      "en": "「You'll pay for this.」"
    },
    "321:2299": {
      "repository_source_sha256": "cb7e69c457757e469902a0a24757078f2b524f865dd4cf7f545baaa40742da79",
      "en": "「The price will be steep.」"
    },
    "321:2318": {
      "repository_source_sha256": "4d775be471b60698413b4730f8e33276a5ce44a90ae92791e129ea863c8460bb",
      "en": "「If any remain...」"
    },
    "321:2337": {
      "repository_source_sha256": "e63180e9713f5062eda41f0b0e797d490c5d8641a8bf6e18cb60af276be9b91e",
      "en": "「If you're waiting for me...」"
    },
    "321:2360": {
      "repository_source_sha256": "1e005b28611ac36d0776be0abb8c761d7ad99bfabc5f142ba09139691e4e8d0a",
      "en": "「I'll simply finish it off.」"
    },
    "321:2383": {
      "repository_source_sha256": "7f856f23685d6c387fcd93972038326b329339a2752ad27adc0783fb82c468b3",
      "en": "「I'll handle the cleanup.」"
    },
    "321:2406": {
      "repository_source_sha256": "427da8ac7d87cd5a27ed163bf1bbd60de74d650177ff0578ec1d8b47b490ea3a",
      "en": "「Leave it to me, Lord $$尸空#pilot$$...」"
    },
    "321:2429": {
      "repository_source_sha256": "b7ef428cd50b2dfa95cee5c6c7abad19b6c0ce3624acf8bc54674d588f52a948",
      "en": "「Lady $$尸刻$$, I'll take over.」"
    },
    "321:873": {
      "repository_source_sha256": "6015bad863d71164a38e9d122237aa6cd3820f1b455a6814c95fe8eff288cc85",
      "en": "「It isn't over yet.」"
    },
    "321:896": {
      "repository_source_sha256": "0c9fe95b662f32f0c85de35f9ae3a440cc31424e4b71015113b4191b09ea5002",
      "en": "「If I missed the kill, once more.」"
    },
    "321:2655": {
      "repository_source_sha256": "bd65acee4b9d12bed23d022aeabd08fa6ad22a15b5b2b5bec71471400fac289f",
      "en": "「I'll go ahead.」"
    },
    "321:2681": {
      "repository_source_sha256": "4aeac290cce8ad949458501b8b67f22c8c8399e7c81a0f11e13e4a16942ecd2e",
      "en": "「Target confirmed.」"
    },
    "321:2696": {
      "repository_source_sha256": "03b03a2edc9772b59bf2d171feff2619378ee7e69a308b78f79609b37addaa0d",
      "en": "「I'll pin it down.」"
    },
    "321:2713": {
      "repository_source_sha256": "ff08488b0e713beef56f1f4f1c883cd255c1357d976e0c2d5d28a8638012fec9",
      "en": "「I leave the finishing blow to you.」"
    },
    "321:2542": {
      "repository_source_sha256": "133af327a291b4fa119ffbbe4e880ae9d240ed5f4df9b4ed40cf79543018b253",
      "en": "「I'll be your opponent.」"
    },
    "321:2561": {
      "repository_source_sha256": "e99fc3f5713aad91c186aecb81fed26abaea0c3f74e95e3aaa9c08af4b273313",
      "en": "「Let me handle this.」"
    },
    "321:2578": {
      "repository_source_sha256": "703a08370ce9cb238fce1be35efacbf407fdcbcb80f8bbabf914168a687ce741",
      "en": "「I complete the work I take on.」"
    },
    "321:2607": {
      "repository_source_sha256": "d3678e27159196ed68bf8795c6783cf70f84be5cd7c96d7492e4fe807454cd16",
      "en": "「I leave that one to you.」"
    },
    "321:2632": {
      "repository_source_sha256": "c172f479439e1ff8c305f8995628c0b0b886b3e0813db90a6915d450f2ca9571",
      "en": "「I'll take this one.」"
    },
    "321:4415": {
      "repository_source_sha256": "b67e1d2995ff91574d15226e7ba2de26a3fc1ee78a0ac5002c19689d391c6ab9",
      "en": "「I never expected this much...」"
    },
    "321:4436": {
      "repository_source_sha256": "1058b23929db6a43be79f0baf4d14fd4d23106440d043f9d2c156e3c63d23362",
      "en": "「Abandoning the unit.」"
    },
    "321:4455": {
      "repository_source_sha256": "bd7a8cc53c42d3f9334152227e4f60beb76ad214d1016c90655a58785130d63f",
      "en": "「Never thought it'd come to this...」"
    },
    "321:4482": {
      "repository_source_sha256": "00c5db507b7b0d32d2b2c73e925c7697b60c13f78eaaa1ebff8a83bfc8542c2e",
      "en": "「Results are everything...」"
    },
    "321:4503": {
      "repository_source_sha256": "05ceb6bf307ca2d1f60a1feaa7b0d1bffc121d629d983ef731043a9a20cea480",
      "en": "「I accept defeat.」"
    },
    "321:4526": {
      "repository_source_sha256": "27b42e1f8d9a955a57ba9fce2f84e82292b9ad2a4c05061bb216f149dd894422",
      "en": "「How regrettable...」"
    },
    "321:4539": {
      "repository_source_sha256": "0fdc7aeb3c2db17af17d7881b2b51a1a8d1d8173c3985dd9f785e26bfc54c8e0",
      "en": "「Me... in this state...?」"
    },
    "321:4562": {
      "repository_source_sha256": "dd4aa711f9de82aa763e5424c6a7ea65a75737d6c2e0c1e55bb75538a13800ca",
      "en": "「Well done, I'll say that much...」"
    }

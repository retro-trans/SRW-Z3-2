{
  "schema": 1,
  "rows": {
    "321:4587": {
      "repository_source_sha256": "00fc442ad320b9f8c5d0f84d0685873a4cf8b3faa785a14f6132152f290237fd",
      "en": "「Forgive me, $$尸冥爪$$...」"
    },
    "321:4606": {
      "repository_source_sha256": "3481596ab14f94da6ebf198aa36254317f510fcebd7e3402b6bbab4d45405c7f",
      "en": "「My $$尸冥爪$$ is...」"
    },
    "321:4625": {
      "repository_source_sha256": "8f799f6dcb858d5b93b4933bbf900d94e4643631ce3da0fd07e7b03b3d5729a4",
      "en": "「$$鬼宿$$'s history ends soon too...?」"
    },
    "321:4662": {
      "repository_source_sha256": "935fdc8aa03ee1e5db698a376d9668ecc4fa3f135c2cdf83c8bf62e23b187743",
      "en": "「We've no place in this universe...」"
    },
    "321:3721": {
      "repository_source_sha256": "d183314c578497754797dd5de952b4eb649f973964a6923a918e4ae5b71952af",
      "en": "「It's a $$ガンダム$$, as expected.」"
    },
    "321:3742": {
      "repository_source_sha256": "f08b62b7f5c5c657faa676a0a0fc9ad007f0a517056051ddd368c7c75ffcfca2",
      "en": "「Worthy of the $$ガンダム$$ name.」"
    },
    "321:3771": {
      "repository_source_sha256": "26214251f938609c8a99774ba0b528b1bb1a5d5324b5854c9373b6cf80ad15cf",
      "en": "「Their psychic waves are closing in.」"
    },
    "321:3798": {
      "repository_source_sha256": "415af8857391030cc72d7f3bd02dda9c540bbacd2465661e06cf2c6d3ac17f63",
      "en": "「Their pressure is pushing me back?」"
    },
    "321:3831": {
      "repository_source_sha256": "52fcf6fb0558cb6d7f18e1e287a1b10382b3387e02f5c2326709cfc011349966",
      "en": "「I see... So it's a Super Robot.」"
    },
    "321:3864": {
      "repository_source_sha256": "ac25c472bd103316cbd5ef1aa49cf5ee3dbedb142ed35ea8401dfb50fefb8219",
      "en": "「I can't match that power.」"
    },
    "321:3887": {
      "repository_source_sha256": "f0b39d1f8f67ccec28e0bcee8019bc03fd46c808962917d24c09f16e0cf6c4e5",
      "en": "「That's fast...」"
    },
    "321:3900": {
      "repository_source_sha256": "603f66f4105984e629afdbe16d53bf5107ba8aafa438c4269535f0721e81f9ae",
      "en": "「Impossible to follow it by eye?」"
    },
    "321:3925": {
      "repository_source_sha256": "c62b911c92419852273f8936baa9030dc62fede8bc0405a433a96fd34eb66ccb",
      "en": "「More power than it looks.」"
    },
    "321:3946": {
      "repository_source_sha256": "49b6fc81fbd2c5d39ede06e73dc755898bfce200730f7b4d24a484387949ca56",
      "en": "「You've mastered your $$スフィア$$.」"
    },
    "321:3979": {
      "repository_source_sha256": "0d86d7141083589108fd8f72e865f36093955128c2066bc6ee168cd0e65261c6",
      "en": "「As expected of you, $$スフィア・リアクター$$.」"
    },
    "321:4016": {
      "repository_source_sha256": "12be976ec825b165927f52df6af226c1fb3a4945268b56d1100ae85c6f779880",
      "en": "「Their strength is superior.」"
    },
    "321:4037": {
      "repository_source_sha256": "706ee15702dac731c2a583564a28b913619d472a382b6796281e87b5bd772270",
      "en": "「So this is clinging to life.」"
    },
    "321:4060": {
      "repository_source_sha256": "8384260ca262a688761873157df335932e9fdc8eab6cf61a25ffe400d2e82cf1",
      "en": "「You reject me... you reject fate?」"
    },
    "321:4083": {
      "repository_source_sha256": "77ff183ee46c4ea474c81c759d82b430dbaadb96944ab64716f6048ab3dccfdc",
      "en": "「So this is the power of life.」"
    },
    "321:4104": {
      "repository_source_sha256": "1ede6ef38416647f2409fb513216a11b159b4dca22cbc0477f3082b2ccf4493c",
      "en": "「My unit's output is dropping.」"
    },
    "321:4133": {
      "repository_source_sha256": "ea46e9001420907e1f28adbfb56bc68c94a284f17a52e82eccf1d053e4b5aead",
      "en": "「The damage is severe.」"
    },
    "321:4152": {
      "repository_source_sha256": "6a57eff65db13149e6ee212a8e8934a4b8e7ce510712b1443f08cc6e8370e201",
      "en": "「The drive system's been hit.」"
    },
    "321:4175": {
      "repository_source_sha256": "506a41f645ecbc952784db5bf6943769ed63c445d334d86308b5e56438c1f44c",
      "en": "「My unit is at its limit.」"
    },
    "321:4208": {
      "repository_source_sha256": "c71902ddec9946ce710eb4fcd309aab0cd11b8e9d1b10c546ddda7325fd3460c",
      "en": "「From here, it's kill or be killed.」"
    },
    "321:4243": {
      "repository_source_sha256": "0d52c02f6a8178eb37cb3a05d967aba1f2493f86ec5b055451903777532b2c22",
      "en": "「The feel of death right beside me...」"
    },
    "321:4268": {
      "repository_source_sha256": "c22f54b531b4adf08f6c669268cab193a5433a469aaa0e0348235b1e516c8f4b",
      "en": "「To $$鬼宿$$, death is close at hand.」"
    },
    "321:4301": {
      "repository_source_sha256": "3b8254c6f4f33850fa3a14ceeecaadf482d0b1f402c05c274a3e1de8ac640139",
      "en": "「The difference: send or be sent?」"
    },
    "321:4332": {
      "repository_source_sha256": "86bff6330c5974a54db6df73ecd904b84add7f62b4c4ba2a6529d9e5ae9bbcb2",
      "en": "「$$尸冥爪$$... Hold out a bit longer.」"
    },
    "321:4363": {
      "repository_source_sha256": "5c716ac2b29bac40caf5198c0dcda1c82de217a9c4f4d4f3b00de513b752a927",
      "en": "「Will $$尸冥爪$$'s claws break...?」"
    },
    "321:4390": {
      "repository_source_sha256": "ef21897a511a88a69a021e2d829dc5e9807b530e8f41ba2c4ba345d49403125a",
      "en": "「You can still fight, $$尸冥爪$$.」"
    },
    "321:3509": {
      "repository_source_sha256": "39866e85c563090a08fcba8c700a65f858357771788c7117e42c540661d355a9",
      "en": "「We're evenly matched.」"
    },
    "321:3526": {
      "repository_source_sha256": "fdad915bb03b4988e564024b004b87fdde8aeb1961eb0e15b193e67c332f6c16",
      "en": "「You just won't give up.」"
    },
    "321:3543": {
      "repository_source_sha256": "8becfb4e6646426ad7fb152591d346c589beef1d4a40c5efb04b8b4e4d2cb6c1",
      "en": "「Those instincts aren't bad.」"
    },
    "321:3562": {
      "repository_source_sha256": "d6240214d078c7ad77b63b74fe7034241cc2d0bb331e3f691d0b6bf1ff502406",
      "en": "「That's more like it.」"
    },
    "321:3579": {
      "repository_source_sha256": "2ac667cd585d533917fee5974e41b762709921890dc5fdbaa0bc34789f6e19b9",
      "en": "「You resist fate?」"
    },
    "321:3596": {
      "repository_source_sha256": "2fa94b3ffd6ee20886432477522c3a5fd9641fc90c623f4c773708079677ac7d",
      "en": "「Even so, it's still not enough.」"
    },
    "321:3623": {
      "repository_source_sha256": "790bcfb7fefe8b742c66f92481013da06eeed3f5cb247296c991822ce5807508",
      "en": "「I won't give you another opening.」"
    },
    "321:3642": {
      "repository_source_sha256": "f462955596b7bf347b7436f9c4f5911d824da78295de81c1c88a9fd93c94bd51",
      "en": "「Even I let my guard down.」"
    },
    "321:3667": {
      "repository_source_sha256": "fb4f0ee109f369a61eb439afe6c0943a873f969fb96941590913ad27675d2f11",
      "en": "「I won't make that mistake twice.」"
    },
    "321:3692": {
      "repository_source_sha256": "0e6a9d37aff12a919b1016c0b1413f8cb5f94c3c712d1cf2288672ea0c5fb646",
      "en": "「Am I losing ground, bit by bit...?」"
    },
    "321:3032": {
      "repository_source_sha256": "bc5bc16ce45a32ba43d4ec0ad00f09ff5e66d50e4af188f13dae041e9c72b89b",
      "en": "「This is a $$ガンダム$$?」"
    },
    "321:3055": {
      "repository_source_sha256": "5b0099b79c5bbcfca272d3f2beb4725546ae3da353d091eb74709ddcba401795",
      "en": "「Unworthy of the $$ガンダム$$ name.」"
    },
    "321:3086": {
      "repository_source_sha256": "61a3dac10f52a816dc22b7c0901d97af470ff80d60238837d7c9b7e48881c888",
      "en": "「All show, no substance.」"
    },
    "321:3105": {
      "repository_source_sha256": "def893894724451d15c7024347f1aaaaf65b578367273e876d5650ca825e9d30",
      "en": "「You don't know how to use your power」"
    },
    "321:3140": {
      "repository_source_sha256": "bd7cf7c3e1ed58cad42ff7176ad64678fe0a3754c3b26d220b90d5c95c091fcd",
      "en": "「Hard to believe you wield a $$スフィア$$.」"
    },
    "321:3173": {
      "repository_source_sha256": "c77b01a9db16bb9ead61b5d8ffb28b499d9dcb8ae7cbfee4d5a553f30bdd5903",
      "en": "「What an immature Reactor.」"
    },
    "321:3282": {
      "repository_source_sha256": "4982d5d732483fa7814b4fb2faa6d4f5d065303d9bf0fd2531d6e9791d780d56",
      "en": "「Evasion isn't necessary.」"
    },
    "321:3299": {
      "repository_source_sha256": "05ea9c4ba7a1984e0d9c810d397c510e369705809620df0e4ab70532d299c013",
      "en": "「Struggling, are you?」"
    },
    "321:3312": {
      "repository_source_sha256": "4bd8019b192a6cb90726f28939c33d49ed174eec487c0f08ec4cca9166952f0b",
      "en": "「Such futile resistance...」"
    },
    "321:3331": {
      "repository_source_sha256": "5896404a27be4f448714cb24b10a03da4c7b447ae1a4947a8eda2a47e30eafe5",
      "en": "「Recognize your folly.」"
    },
    "321:3354": {
      "repository_source_sha256": "453340d49609b2dfa850f0b0f1546da2c5a7e42f2e226e181a40a11b69e605cc",
      "en": "「Realize your weakness.」"
    },
    "321:3375": {
      "repository_source_sha256": "d82da3dbf6bfad0b78a870cecde1f147145ac50e1850c39462420ee6fe9af22d",
      "en": "「Its killing power is close to zero.」"
    },
    "321:3400": {
      "repository_source_sha256": "74c4367b2a28569ee6462ea766ad65d78e4cb8286722d548206fe486adf94eb7",
      "en": "「I'm being taken lightly.」"
    },
    "321:3423": {
      "repository_source_sha256": "c191c7d46510e0b7e4d80292316fcbad77a6154fc54b77a6be5aecbe4bb20415",
      "en": "「It won't work on $$尸冥爪$$.」"
    },
    "321:3444": {
      "repository_source_sha256": "2781e4d3af3477e51fcdf9c1ab09aa48e164761fca68acd4c9d257dc3828bf38",
      "en": "「Seems you can't pierce this armor.」"
    },
    "321:2895": {
      "repository_source_sha256": "661392693f6c1999c71c988ff8cd78c12f05fb3e1c7673e8cdd0c81b06084084",
      "en": "「Did you think that would hit?」"
    },
    "321:2916": {
      "repository_source_sha256": "fd1880f410ccb6242e573d3451dddedf54b3850dd77f9c39121de0f90ac34b2f",
      "en": "「Just as predicted.」"
    },
    "321:2931": {
      "repository_source_sha256": "bf9b9f050bc8a080957e0659877685da000e5922ee6bc1e326d31636dc730bd9",
      "en": "「You're easy to read.」"
    },
    "321:2950": {
      "repository_source_sha256": "987a75c0d43173e8f81a693aa98c880ba6e6c0d8ec476b23fd013a08ef36165e",
      "en": "「What are you trying to do?」"
    },
    "321:2969": {
      "repository_source_sha256": "1f94f3837c6265b0c188b49336c4b778da678a591a2f355d1a772058a88741b9",
      "en": "「You aren't seeing clearly.」"
    },
    "321:2992": {
      "repository_source_sha256": "6242750aaf9cd2a71abaa5b59d287df9c1f82c56dc75b4fd24a26a75979bfa00",
      "en": "「I sense impatience and anxiety.」"
    },
    "321:3198": {
      "repository_source_sha256": "3e593da21d28f8444f801a00a934ca4a0f02c63291c609204dde6e47ba582114",
      "en": "「I told you, it doesn't work.」"
    },
    "321:3223": {
      "repository_source_sha256": "04fc0e24ce73070ac650ab21bea21f8394f7cb372c125593a423f4686d944a54",
      "en": "「I'll simply nullify it.」"
    },
    "321:3244": {
      "repository_source_sha256": "f15f09375a54d7d7859763713a1e80f0f0bedad54aca41e9d3df912141a1b090",
      "en": "「Deploying the field.」"
    },
    "321:2787": {
      "repository_source_sha256": "001e89ec7f8452657ed84d9000557b702fc4fe557ec04730f779188446b32772",
      "en": "「My attack has been sealed.」"
    },
    "321:2831": {
      "repository_source_sha256": "c324985eb410e9461386ca309c5586e8ce58ff4ccce8a806c5b9b9e082df09cf",
      "en": "「This is a bad position.」"
    },
    "321:2450": {
      "repository_source_sha256": "964d0eb8c10b15de641b5418e23950c5e742ff321ea03b412ad6a70a65c5d563",
      "en": "「It's too early to die.」"
    },
    "321:2471": {
      "repository_source_sha256": "bb5c7c1ae6687eafedc6288cabe213f7e4ee6d8faa3e2f6c116d1b012a938ce3",
      "en": "「I'll take the hit.」"
    },
    "321:2490": {
      "repository_source_sha256": "aaffbe30ed054d32ea793b5e3ebb48103ee9269d49f96a5ce18d549b1ad2f3f1",
      "en": "「Please stand back, Lord $$尸空#pilot$$.」"
    },
    "321:2519": {
      "repository_source_sha256": "ff392be85517b159cc1b414015a83f78f660ec44b5909196602e7284f9521d16",
      "en": "「I will protect Lady $$尸刻$$.」"
    },
    "321:83": {
      "repository_source_sha256": "658c5215707ed197663d35f0071e138444509e90b103e6437801592f7784a0eb",
      "en": "「You will pass on now.」"
    },
    "321:100": {
      "repository_source_sha256": "61253b5e95f4f5d7375e4cc73c13867677ef09bdcb9b4e48f67142718a5130d6",
      "en": "「Pass on first.」"
    },
    "321:113": {
      "repository_source_sha256": "59f1c87035ace2c1ad684b8abc7f74cb70ff94b7fd3b45db920578dc789ed8df",
      "en": "「This is as far as you go.」"
    },
    "321:134": {
      "repository_source_sha256": "82e005db6394c5da598f665111abdcfcaaba2f4d74bc550f84ff3d130482b5a4",
      "en": "「You have no future left.」"
    },
    "321:151": {
      "repository_source_sha256": "19cd46be2845af4e87f00be578ba5e2ef0b54f38a64ec4529d4bff8430d7400d",
      "en": "「I'll eliminate you here.」"
    },
    "321:166": {
      "repository_source_sha256": "18ba85c3a566004126066442284c7141264b5d8cc0332a5dc1fdf0da78b4c628",
      "en": "「I'll send you off myself.」"
    },
    "321:183": {
      "repository_source_sha256": "3108bb4a9746016b34caedae95948c7b8d22f91f950c895ac721b85273442b96",
      "en": "「Curse your fate.」"
    },
    "321:198": {
      "repository_source_sha256": "e8078007db493a364697ac0ff91d995fd56d1ae77c2f42b080da16c89119e28c",
      "en": "「Remember your parents' faces.」"
    },
    "321:221": {
      "repository_source_sha256": "5af503139ad868a880e46cd47f214188a42a571e52325e97d3eb751f53045436",
      "en": "「I'm just doing my job.」"
    },
    "321:244": {
      "repository_source_sha256": "922d9392fde815e9f95228452fc8c7994a3fbc55ae41e050cc610f39c76f6400",
      "en": "「This is our job.」"
    }
  },

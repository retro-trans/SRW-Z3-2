{
  "schema": 1,
  "rows": {
    "324:0": {
      "repository_source_sha256": "e8390419699eb075d5256631957311f83c69fa22f1d922fb9e15a023400a2996",
      "en": "「$$桂$$...\\nI'll give it my all to the very end!」"
    },
    "324:6606": {
      "repository_source_sha256": "68758e5ca4810e22d6d2a54ba348e0b5835161e5212573fe7430491fbb3a2c6c",
      "en": "「You vanish before the universe does!」"
    },
    "324:6645": {
      "repository_source_sha256": "ab0b53c93be25f6842bf653d7173a3ed2b63b62ef8af68b66ec9d215153df5ef",
      "en": "「This world and us alike...\\nwe don't belong to you!」"
    },
    "324:7442": {
      "repository_source_sha256": "f09af0ed89ba629457e7ebfe8dc8261de75624453ee0bc9e37325be665b18528",
      "en": "「$$桂$$, it's the $$サイデリアル$$!」"
    },
    "324:7471": {
      "repository_source_sha256": "142f696758a6b197f322822274a5b2d24a6ab882f57c42b69e8b13e6dae8f167",
      "en": "「We're taking Earth back!」"
    },
    "324:8810": {
      "repository_source_sha256": "29098e28354056c1fbb1c053b9c6b1a984f37e58f66d98102977264e938b9e4a",
      "en": "「I can't waste this chance...!」"
    },
    "324:8845": {
      "repository_source_sha256": "7635bf9139287cc292816c5bc2dc6267c1e6fbc957a72c44ad5767801fea09cd",
      "en": "「Let's wrap this up quick...!」"
    },
    "324:8884": {
      "repository_source_sha256": "d8d2e2f227ecdf8c0f79648c45c507fb03bf3f8445fd1120c04382fb27227ec4",
      "en": "「Gulp! Now this is a nail-biter...!」"
    },
    "324:8921": {
      "repository_source_sha256": "59d775aa812880762533fc89421eeb320ae96dc1fccefc7bf08fc24a997475cf",
      "en": "「Guess I've got no time to play...!」"
    },
    "324:8989": {
      "repository_source_sha256": "75d8a99a940f7baaadb469ff5cf86c05e0dd64498f7f05eaaee50acb77cae0fa",
      "en": "「Loud and clear, as they say!」"
    },
    "324:9010": {
      "repository_source_sha256": "fab7ab1e27b46f82a93f8030ebe624cc41e3b275ea4c06ae1f4bc0fbbb4da077",
      "en": "「$$オーガス$$ is the name of a war god!\\nDid you know?」"
    },
    "324:9065": {
      "repository_source_sha256": "59fd5bba23ef48ebb28df3c6240073a0c912f456abdbaba498d0dcf0392de355",
      "en": "「Hey, customer, keep those eyes open!」"
    },
    "324:9106": {
      "repository_source_sha256": "a6760a0435d1fd58820d0110295815a23810ad1348c33012ab96fadc67a12a07",
      "en": "「No matter who it is, I gotta do it!」"
    },
    "324:9145": {
      "repository_source_sha256": "a8312b355f1dcd4012d96978d9af36ad362f9c2942578aa3120e6870412d4ad0",
      "en": "「I'm prepared too, you know!」"
    },
    "324:9178": {
      "repository_source_sha256": "05496db354a70e6b23ac4284e72755d43f388ec9f2b0b9c9a57a9552499b7a66",
      "en": "「Time to show what I can do!」"
    },
    "324:9207": {
      "repository_source_sha256": "2499c32d1c1bb2dac732bd38ab493bd5c6e3245899976bb49f840748e9c681cf",
      "en": "「Let's give 'em a little scare!」"
    },
    "324:9236": {
      "repository_source_sha256": "e73620c3f7d65af64b970d42326b4332f8c352ed26e4480f8553fe0b48712119",
      "en": "「Whatever it takes,\\nI'm going back to $$ミムジィ$$!」"
    },
    "324:9820": {
      "repository_source_sha256": "ddd4619ae64de909b47fe5dbfe3f0f32f10653bbe950010dac0aa3e1cb904633",
      "en": "「You're humanity's will? Get real!」"
    },
    "324:9863": {
      "repository_source_sha256": "d5cdd085ed88bc86f238145937dd56b9a284aeed3617de3902bd239bba4d88e1",
      "en": "「You're not $$赤い彗星$$ material!」"
    },
    "324:9900": {
      "repository_source_sha256": "eec6eb23be685e2b2a58a7b9195966975324e188ee3eaaea77d4380c3f23b03b",
      "en": "「I don't mind a girl who\\nwon't be honest, either...!」"
    },
    "324:9951": {
      "repository_source_sha256": "f5efd63144c40cf26202f912fcb42ad6306cb74c1ef4cf921763f90636322deb",
      "en": "「A system running solo? What a joke!」"
    },
    "324:9994": {
      "repository_source_sha256": "c5682ab063d5e798ffbca9f39961168b58f9ce75e9c87a442cbca39cd428f1c8",
      "en": "「Some robots are good, some bad,\\nand you're the latter!」"
    },
    "324:10055": {
      "repository_source_sha256": "8bf040ea4d912f0119cc0f8eba957dc8002bffca7cc16ea09651d5dcc0e03d08",
      "en": "「I won't allow a self-serving repair!」"
    },
    "324:10094": {
      "repository_source_sha256": "231b98c8d5cb37b72ffa30ebdbf11cc9074d4370d8fcdea1791d87eddf183c5d",
      "en": "「Looking backward is no way\\nto go repairing spacetime!」"
    },
    "324:10151": {
      "repository_source_sha256": "1c452345f41771f3bab4852cc83de026dedf3935024cd760fe530c5593eae7ce",
      "en": "「Just what are you people?!」"
    },
    "324:10184": {
      "repository_source_sha256": "2cc7e57b80fa97eefe36bc429f9fe454dcae64b7ccc343169e166cc86d93503a",
      "en": "「Whatever the reason,\\nnobody has the right to do this!」"
    },
    "324:10237": {
      "repository_source_sha256": "3517158caed529b4331929e3f0d75d23373ebad5c8be36ea625204088bb29f2f",
      "en": "「Some twist of fate made us enemies!」"
    },
    "324:10280": {
      "repository_source_sha256": "1bbd071551c7c38cc560c5f075fe717a7dce69eda150b80c4e08681c27801dc8",
      "en": "「I thought better of you!」"
    },
    "324:10307": {
      "repository_source_sha256": "b43d95b8e6449acf7f7dfc3b46ffa60a1cd9acb1e428afce13139639f4aff4cf",
      "en": "「Bear with me a little!\\nI'll save you right away!」"
    },
    "324:10358": {
      "repository_source_sha256": "ad5f904d10ae40fc7f5e98e0468dc6c03e021fd2c4d8809381b5212251014070",
      "en": "「Geez, you're so darn persistent!」"
    },
    "324:10397": {
      "repository_source_sha256": "9d11c540054fc76827a045b2f935cf8d24dcc7d2d2df1592b3bea99ec2d71660",
      "en": "「I don't have time to deal with you!」"
    },
    "324:10434": {
      "repository_source_sha256": "7c2df9caf7c1f5b884e5868caaf394857e5d525b11f4f8355a75eef3f51b0f6f",
      "en": "「\"No more war!\"\\nGuess now's not the time for that!」"
    },
    "324:10485": {
      "repository_source_sha256": "3c59b397577f36f841e18abcc58f5b14ecccdc2f1c927c600b976ae2aa9adc56",
      "en": "「I get how you feel, but\\nthere's a right way to do it!」"
    },
    "324:10544": {
      "repository_source_sha256": "c132d139f86a44348a113756c1930d49e8b64dfd27011197585519835a278376",
      "en": "「I'm not into little girls, though...」"
    },
    "324:10579": {
      "repository_source_sha256": "ec7b4e11844809210be7586a51b00466f81279e174ecf23aa0b7a7fd83749c1e",
      "en": "「I'll hit on you in a few years...!」"
    },
    "324:10622": {
      "repository_source_sha256": "9440bbc176f5a67313616101b1c06f372c7bd6725d047343d2f5507f7ca63ebc",
      "en": "「Well then, time to ask for a date!」"
    },
    "324:10663": {
      "repository_source_sha256": "dc6f7e6fbc3fea342693c62f3e2c7681ec13d1a773109dea065492a1c756e558",
      "en": "「Let me show you how cool I am!」"
    },
    "324:10702": {
      "repository_source_sha256": "cd6a416b457b89ccaffe2f15ddc59011881ef7e3cd48d2ccdfbfd86cf78c0dd9",
      "en": "「Sorry, but I've got no other choice!」"
    },
    "324:10739": {
      "repository_source_sha256": "b6822df3df52171d3e8986420d5160c06e28c431ab3b47e872eacf7f8fc92c6c",
      "en": "「I'd like us to understand\\neach other too, if we can!」"
    },
    "324:10792": {
      "repository_source_sha256": "731563cdb1c7260a7149dfaed4610a4608db960727f4662ae186e3a7f5ca5138",
      "en": "「Though the foes number thousands,\\njustice always wins, as they say!」"
    },
    "324:10841": {
      "repository_source_sha256": "31c38dabad5ddc7607d266ebc76edc959507562d756c847a888ba92e0ff90f8c",
      "en": "「Calamity? Extinction? No thanks!」"
    },
    "324:10872": {
      "repository_source_sha256": "0e00933e946b6a553323832add868c38374336cc05212b1358de93dfaab8475c",
      "en": "「$$宇宙怪獣$$? I go all out!」"
    },
    "324:10905": {
      "repository_source_sha256": "dd5f922023b2e430c99da2bc85d90898f51d9f6f06b10d83a8f9f6ca5f147bbb",
      "en": "「Good grief,\\nfighting a black hole?!」"
    },
    "324:10954": {
      "repository_source_sha256": "f1fd76a879622c74c7b27d11926f02cc1aecf1e25de2f99c864b1539eb1a2ec0",
      "en": "「Darkness, despair... that stuff\\njust isn't my thing!」"
    },
    "324:11009": {
      "repository_source_sha256": "d8c11ced0401004cf88ac635b8222dd0118b1107519dba88c9e90ce5bcafe807",
      "en": "「I'm not about to listen\\nto some evil god!」"
    },
    "324:11058": {
      "repository_source_sha256": "ce9bdc5d9b6445fc5765095578976d0c8fd649cf9bc2a61b94f442af123d7a58",
      "en": "「I'm sick of your twisted logic!」"
    },
    "324:11093": {
      "repository_source_sha256": "d0d7a48b1d7c6d17e5167cf0ae6cbf4f6657aeafe6415ced39af260112ad7c40",
      "en": "「Anyone who settles things by force\\ngets this!」"
    },
    "324:11142": {
      "repository_source_sha256": "f2dba193df499c1c9733774bfcc3767727141713a7a71d20dc55b5643e4663a3",
      "en": "「Time for the $$サイデリアル$$ to exit!」"
    },
    "324:11183": {
      "repository_source_sha256": "3fb9c208e8e5ea4c43fab9e196708c3719e22a137fd183e765842fb4c9227b2d",
      "en": "「Thanks for coming out to the sticks!」"
    },
    "324:11218": {
      "repository_source_sha256": "17c849a242e36973f26be3231a51cd8b46ab9587bdb79b9c6f1c75aff21eac20",
      "en": "「Of course we'd reclaim what's ours!」"
    },
    "324:11259": {
      "repository_source_sha256": "d324e9e9d823a2d4b85e8a00d3d7084a92c3dae6f6445fd6557e493d0d4ebbfe",
      "en": "「You're a nuisance to the world!\\nYour very existence!」"
    },
    "324:11308": {
      "repository_source_sha256": "a5179ba2c8836d117db9bebc6575acb3f5993e32503fde455fdd46672d7239c6",
      "en": "「Your lawless ways end here!」"
    },
    "324:11349": {
      "repository_source_sha256": "1edf827a6f28883a31442532af2ab5f85d4a6f8ebd3c7d30929393f2a1397565",
      "en": "「No using $$次元力$$, thanks!」"
    },
    "324:11390": {
      "repository_source_sha256": "90a9d21c8af34553277c7a9b9de9fc49226a4afe840c51599570a81de5d01dfc",
      "en": "「Swayed by power we don't deserve...\\nwe're in the same boat!」"
    },
    "324:11445": {
      "repository_source_sha256": "6bbd9fd427f7b5afd9637eeabd15603588e0a7d8ee24174cadca89af43528a38",
      "en": "「Ugh, I can't stand it...\\nhating and being hated!」"
    },
    "324:11496": {
      "repository_source_sha256": "4e16e383b3324598248ce67ae6d545f5e362558d3c6097ef25de49318e7528f9",
      "en": "「That bloodlust could swallow me...!」"
    },
    "324:11535": {
      "repository_source_sha256": "b4a555d7196bda6cf0875531785c7379031292788d1f473f942b8f46a3943a2c",
      "en": "「I'll rip the mask off\\nthat bluffing commander!」"
    },
    "324:11584": {
      "repository_source_sha256": "89db525e6c4543494de0c1c2dbf377296e666ca1c59b35f1192c8334abfa3550",
      "en": "「Mmm!\\nYou're way better out of that armor!」"
    },
    "324:11633": {
      "repository_source_sha256": "1045c2cfb8d1b06dfd7d083cd7b9ecd96bcf352c8b754ae31e4ae11f0ca9d568",
      "en": "「I'll crush the head, end the Empire!」"
    },
    "324:11676": {
      "repository_source_sha256": "aa6ab878a6010ebd81b66a5372f826c20bc6a9aa959df5a8002b87a35a6f4b41",
      "en": "「$$次元将$$ meets $$スフィア$$...!\\nNow that's a worthy foe!」"
    },
    "324:11739": {
      "repository_source_sha256": "589c50d48789694b12c3086101a93ea9bae2e7e2a053179ed0761bd24f5dae50",
      "en": "「People who call themselves great\\nare never any good!」"
    },
    "324:11794": {
      "repository_source_sha256": "cda7abd1d826336646671337216cdb221e90778cbe8dca203761cd1d53556891",
      "en": "「If this is an emissary of God,\\nI don't even feel like praying!」"
    },
    "324:11851": {
      "repository_source_sha256": "e791f1ddb5c2fcad83bfc0ed99fe0fa21da51e600a9a1d931720acc68b6e4ab0",
      "en": "「You're a god, yet what you do\\nis so petty!」"
    },
    "324:11900": {
      "repository_source_sha256": "7e3938167d770affa5ebdaac8b4a9aa4d666c5bfa55f922d9c4a511f1475c715",
      "en": "「What would a stiff-necked judge\\nknow about us?!」"
    },
    "324:11953": {
      "repository_source_sha256": "aeae91c68b43e094ee2a78ddf57f6ca9786fa722b0847002659802a4a6eef59a",
      "en": "「Even when you're just playing,\\nsome things are off limits!」"
    },
    "324:12010": {
      "repository_source_sha256": "e570c4879d9dbd9a83d3e4d418827b233ef7dbeedce4b02f8a1832e6bb9946b5",
      "en": "「I'll be blunt!\\nThat smile of yours is shady!」"
    },
    "324:12071": {
      "repository_source_sha256": "d9568bb9e65cf2171e042b30c7ca91ada1bcc126722f7f164fe23fc4db12e491",
      "en": "「We didn't fight all this time\\njust to please you!」"
    },
    "324:12128": {
      "repository_source_sha256": "b17c0e4920ccd1f3ea3bcb85921c72e44747e8acf69d74caadea812e2167acfb",
      "en": "「You sure look down on us, big shot!」"
    },
    "324:12165": {
      "repository_source_sha256": "cc129d68d4421e557961192cad640b14131611109f3a27ff8510bc9d90b69806",
      "en": "「If you think you're special humans,\\nyou're dead wrong!」"
    },
    "324:12218": {
      "repository_source_sha256": "3c776018cfc14506a203afcd651a3a152de94f596e1205076a7188071611d4ac",
      "en": "「I do feel for you... But!」"
    },
    "324:12251": {
      "repository_source_sha256": "0d662e636b2b771f6d9b00bf448e1550315e323e3e1b3d59a274e759483162a1",
      "en": "「$$アサキム$$!\\nTime we laid you to rest for good!」"
    },
    "324:12310": {
      "repository_source_sha256": "36a7fa55dbdc169648d28174c9202984a622a1eaff2a696fcbfc7768d979d2c6",
      "en": "「It's over, $$アドヴェント#pilot$$!\\nAnd now we start our future!」"
    },
    "324:12373": {
      "repository_source_sha256": "7f6b48250009ecd598cc1fd486a204ace725ddc0282dcb671121eb8d12cec44d",
      "en": "「$$ミムジィ$$... I'll do it!\\nFor you, the baby, and everyone!」"
    },
    "324:12434": {
      "repository_source_sha256": "8b435aeff76c60227dbbe3be4bf26b20d60984ddf8accde43b74d9c258496fed",
      "en": "「Me too, of course! Let's go, $$モーム$$!」"
    },
    "324:12770": {
      "repository_source_sha256": "c005a76d9bda97c4ddb15f540e8f2338b1043aa99595e2673e3fd60f6dd345ca",
      "en": "「No sin in paying you back!」"
    },
    "324:12807": {
      "repository_source_sha256": "92b2be273a1c080cfe81c59911017c00189cd8487861dbc6fe418c4bbc6c35a1",
      "en": "「Now we're even!」"
    },
    "324:12832": {
      "repository_source_sha256": "667086900d5e03c568e6716a466504ab98a436c4417a042715dc036d594c93e3",
      "en": "「That's what you get for not running!」"
    },
    "324:12867": {
      "repository_source_sha256": "f17c5c3e12b586fbd52a306776c454d70c2093ee54e9ca0011294205467f7be6",
      "en": "「Turns out I can catch up to you!」"
    },
    "324:12902": {
      "repository_source_sha256": "490b1445b73261e0062bed0a0e42911b3a65a9a7d8e29f5ee3e09c899ccb2a82",
      "en": "「Leave the ones you missed to me!」"
    },
    "324:12933": {
      "repository_source_sha256": "4a4afcb4307dc0742aa930c14c9abfa156d315e322e9c61195b8d78a0423e613",
      "en": "「Time to rack up my kill count!」"
    }
  },

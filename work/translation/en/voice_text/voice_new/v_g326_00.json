{
  "schema": 1,
  "rows": {
    "326:3334": {
      "repository_source_sha256": "750d31d2a3a5f201995f5c8bd8221052a90acdc2002fe815753ebedf7277b9a5",
      "en": "「I'll show my justice in battle...!」"
    },
    "326:3363": {
      "repository_source_sha256": "9e46d86e87c940f26423462bcdaa2da2de620ef41f3ac522b0ef228c1cc9a2d5",
      "en": "「A perfect chance...! Here I go!」"
    },
    "326:3394": {
      "repository_source_sha256": "1f46c1bd4f23f57e03a9e02938f9159a7bd4932557efd383c00d8b111f3ace60",
      "en": "「Time to show you how I fight...!」"
    },
    "326:3427": {
      "repository_source_sha256": "072121149deb28b9ab517683ae2e7e4dfa6432aad0000df9ccd7032314649666",
      "en": "「I'm $$張五飛$$! I won't run or hide!」"
    },
    "326:3468": {
      "repository_source_sha256": "84bdc9221f59fae186766b9688f79cead7744e643635b462b8abcd75736b6312",
      "en": "「$$ナタク$$, lend me your strength...!」"
    },
    "326:3505": {
      "repository_source_sha256": "f322c2746d834145b4ff916f9439e0f52afd1a1308f43ffd2384d047bcab0f01",
      "en": "「$$ナタク$$, guide me to the right path!」"
    },
    "326:3548": {
      "repository_source_sha256": "77513784265dff3bc2d91cf265ab636c1c03fabcda5e023f49b7166ab46bb527",
      "en": "「Come, $$ゼロ$$!\\nShow me all your power...!」"
    },
    "326:4317": {
      "repository_source_sha256": "2ba37761dd85f476af40ce725ddb1ee3cfc2472344382c100d5ab27ba07e89f2",
      "en": "「Who the hell are you...!?」"
    },
    "326:4348": {
      "repository_source_sha256": "9fd72dc146e166d0e54fe221a7e46069ef18bedcb4fb6e0874cdb25f6f9ab16e",
      "en": "「Why not state your aim and identity!」"
    },
    "326:4383": {
      "repository_source_sha256": "9afae87b70376827032ff66200df4d120480020571d210f3f59298ea6366d8a6",
      "en": "「However many come, I won't stop!」"
    },
    "326:4424": {
      "repository_source_sha256": "f475e9a2cb22678e428724e4c9212c3181e781ca2c4b0217e1c543fc5f63b753",
      "en": "「You'd overwhelm us with numbers...!」"
    },
    "326:4457": {
      "repository_source_sha256": "f6b0d5eec95a8b9e95ec8003e7cdd24f34d239ab3be9e043a78c00017d6b4d58",
      "en": "「I won't bow to a mere calamity!」"
    },
    "326:4494": {
      "repository_source_sha256": "009d405386fbc45a73e1b2e72e3fd7ddda1911da3fa77e6d067f61ef03439781",
      "en": "「I'll crush every $$宇宙怪獣$$!」"
    },
    "326:4523": {
      "repository_source_sha256": "3cf3de7f4f5a1fe70d923d83dd8577c5238fd15b21506a47792f2e52a5c70199",
      "en": "「Whatever the reason,\\nI don't trust turncoats!」"
    },
    "326:4572": {
      "repository_source_sha256": "b6210505615e64e4d44667857367cd959d0230626d2242d35f00ef4646a88a61",
      "en": "「Don't worry. I'll save you for sure.」"
    },
    "326:4599": {
      "repository_source_sha256": "e35f9f641d0be1115eb20b6f56c8ac34d7a3c68b4b16337f10095ac74dcedbd3",
      "en": "「A new model...! Interesting!」"
    },
    "326:4624": {
      "repository_source_sha256": "788961d720d9dd9e3e76ffee0fc3f238fc56dca8f6f0fe165428e970e8e617be",
      "en": "「Let's see how well it performs!」"
    },
    "326:4659": {
      "repository_source_sha256": "5c096939484878f71fe051251f7761e9dbec202125d46138d93de021932774ae",
      "en": "「Still not tired of pointless fights!」"
    },
    "326:4700": {
      "repository_source_sha256": "5f89e8e9adb90834d45ca3ab3c32eb20fa596209aaed4f5684cb93904257209a",
      "en": "「I'll determine for myself\\nwhether you're right!」"
    },
    "326:4755": {
      "repository_source_sha256": "7160d6fed37153ea157be1c048b19dd9a265a30951e3655312b3fb86efefcb78",
      "en": "「A worthy opponent!\\nLet's fight fair and square!」"
    },
    "326:4806": {
      "repository_source_sha256": "5f24148cc5acb896f4a48abc0360844bb173ce5ff09ec42ace54f301d74ebb26",
      "en": "「Basic tactics: hit the commander.」"
    },
    "326:4839": {
      "repository_source_sha256": "2867ebb5ed1b6cee994219ffb324c84ab5eecfc69de0ada3405aa952fd5e37c2",
      "en": "「I'll hit the battleship here!」"
    },
    "326:4862": {
      "repository_source_sha256": "60b95273b24c9ce44e2277f8ce813c5100f6614fa0151adaa5d75e036aed1301",
      "en": "「You're too big to turn on a dime!」"
    },
    "326:4897": {
      "repository_source_sha256": "96c1b22cc231db14cf19c00a658233ad3fdaff8355d0b4b28625c3debd4d4b9b",
      "en": "「Speed alone won't win this!」"
    },
    "326:4926": {
      "repository_source_sha256": "71d4c2d4117fe83504cf79bdda81ffa6ed2c20566c61db77fbe7632a4e5f74dd",
      "en": "「So you're saying you're not evil...!」"
    },
    "326:4967": {
      "repository_source_sha256": "5a487df508ec9edc468cf463c8c83f7b742a3f1873b3f6a4a8c2e339bfdf4b0b",
      "en": "「$$刹那$$! We've bet on you!」"
    },
    "326:5002": {
      "repository_source_sha256": "d920c7c4959d494ea4921b82ce69b103644ee157503ff7acf6e15ce3553a6c31",
      "en": "「Try reading my next move!」"
    },
    "326:5035": {
      "repository_source_sha256": "52a1f8d15548fed8e5f5bfeeef3278854f86ffb1911002cb3838a487572d5426",
      "en": "「People treated as weapons...!」"
    },
    "326:5068": {
      "repository_source_sha256": "01059b8ff82a7df7d336c939bf6fc456c445e0aa2c8a17242ca02af264aa8774",
      "en": "「$$フロンタル$$!\\nIf you're right, then defeat me!」"
    },
    "326:5129": {
      "repository_source_sha256": "ac847a4f0faf302cbdf1db00455b493a384bd26c3d1cdffc2a843a2fcc745227",
      "en": "「$$ハマーン$$! As I thought,\\nyou can't shed your naivety either!」"
    },
    "326:5188": {
      "repository_source_sha256": "a4f08ff4a3c0761cae1cfda2019fc62d3a5d9a6b6c992feb1e8c61fa6110db13",
      "en": "「A coward who won't face reality...!」"
    },
    "326:5223": {
      "repository_source_sha256": "bc2982044de76001c863a4d23377dd4608b7a24432973127d54824cdd2079454",
      "en": "「A woman...? That's why you're naive!」"
    },
    "326:5248": {
      "repository_source_sha256": "678c968c8d2f38acb0223e1cfdd6545f232fe87391b0f00dcadd7b9d6abb6f64",
      "en": "「Beings who only spread war\\nare not needed in space!」"
    },
    "326:5297": {
      "repository_source_sha256": "bd6ca46b25db046ccd719baf75449050b23a74a813ba70b6c133618a5fb0e461",
      "en": "「Not letting a puppet mock me...!」"
    },
    "326:5330": {
      "repository_source_sha256": "7917173737be6bd63b53513b3a4852454338409c037b9a35088214dce1186a47",
      "en": "「Don't brandish power with no heart!」"
    },
    "326:5361": {
      "repository_source_sha256": "2deb3ccf93eccaea1448e5cde63849737dd1a55c415e37ecc0ebad1a693f12e9",
      "en": "「My enemy is all the evil\\nthat brings war to the world!」"
    },
    "326:5410": {
      "repository_source_sha256": "cd0f750205a2dd12663ed6d19ac65c46fc96a3a8af76ba2832cac229305356c0",
      "en": "「You fight for nothing but your ego!」"
    },
    "326:5445": {
      "repository_source_sha256": "b8058e004daefc627325d26c0abc2f88ff08a53498ece57387b2b6916010a5c3",
      "en": "「I'll erase everyone\\nwho harbors evil intent!」"
    },
    "326:5496": {
      "repository_source_sha256": "c60df8938a3aab4e1a70bad7cb33a3885fd023e571078770e3e22737f323a9c3",
      "en": "「Invaders, $$サイデリアル$$!\\nYou are my enemy!」"
    },
    "326:5545": {
      "repository_source_sha256": "217b4553fd14c9cee9855a83417502110aac75574d55250ff21dc92cc24e8fb9",
      "en": "「You who brought war to Earth\\nare the true evil!」"
    },
    "326:5594": {
      "repository_source_sha256": "ad55c7a039cf2f6c9f1886ce762f6402569e44e03438ef178e04ab0fed1bd9af",
      "en": "「Anyone who uses such power in battle\\nis my enemy!」"
    },
    "326:5645": {
      "repository_source_sha256": "99f89ee51c63bea39f0042905ea44eac2518aaa97f6261b35a58cdff2b2e81be",
      "en": "「The evil power of the $$スフィア$$...!\\nI can't allow it!」"
    },
    "326:5700": {
      "repository_source_sha256": "65255676dfeccea5830ccd128d2b569e8b2ef0ee57eea3887acd7b85fe10ab21",
      "en": "「Even if it's $$スフィア$$ power,\\nmy justice won't be shattered!」"
    },
    "326:5753": {
      "repository_source_sha256": "ed4117351e7ca776291784c9b2c83afe21efa8f228132c5d2d18b5e71a59ac75",
      "en": "「Beyond human, you lost human hearts!」"
    },
    "326:5792": {
      "repository_source_sha256": "a91f366ab689c40712b7974e5f21e3676b7bedebf995e8964f401fef103dd10b",
      "en": "「I've never seen an enemy look\\nthis foul and huge!」"
    },
    "326:5843": {
      "repository_source_sha256": "58f6a97b5c51f6e588c4423d2d92991680665799cbe4fc404ee3bc53ee9a84f6",
      "en": "「Now, so-called emissary of God...!\\nShow me true justice!」"
    },
    "326:5904": {
      "repository_source_sha256": "638fe25f635935eaa7430d50eba4cb1c9d16341cab1c36bbb947abcbba835312",
      "en": "「Pay the price of betrayal\\nwith your body, $$アドヴェント#pilot$$!」"
    },
    "326:5955": {
      "repository_source_sha256": "4b17f2b2e1714c846fb5e06b69eb4b07e69747220a3f637c5c3c3ca039691307",
      "en": "「I won't accept your joy!」"
    },
    "326:5988": {
      "repository_source_sha256": "99b814dc300dbdca637f063a8e4a665cc973d871045cb1d2bd57406fb144cd07",
      "en": "「Not to one who only belittles!」"
    },
    "326:6027": {
      "repository_source_sha256": "f020a5e2ad5ac0d6c4e6cfb3a1a9808d079630537935a075b3c77e06dc89be14",
      "en": "「You who toady to the strong\\nare no enemy of mine!」"
    },
    "326:6078": {
      "repository_source_sha256": "420a988629d8edcd4597e87de8706afc238666fe498e0fecde184aafd7ae1b71",
      "en": "「$$アサキム・ドーウィン$$, prepare yourself!」"
    },
    "326:6111": {
      "repository_source_sha256": "a8c723e6d9ed209f611e06fb1b8a79ecbef9c3b13347bf166d2df4c7abca57e6",
      "en": "「$$アサキム$$!\\nI'll free you from that suffering!」"
    },
    "326:6166": {
      "repository_source_sha256": "f624e463be1016d9e6d674e39318b55d0a0ee9d59dff86e76a3547d401f89c61",
      "en": "「What humanity needs isn't salvation!\\nIt's the fight of living!」"
    },
    "326:6227": {
      "repository_source_sha256": "189a2fe80ae78f9b2b6c8dbcb6efa94377336b2c6df8b4a69cc66f1d033500e8",
      "en": "「$$アドヴェント#pilot$$! You are in no way\\njustice! An enemy to be defeated!」"
    },
    "326:6538": {
      "repository_source_sha256": "59fab89c77785dc28cd03b7c3a1e4ea8db24c878623faed8776926082a7e7fd4",
      "en": "「Catch! You left this behind!」"
    },
    "326:6563": {
      "repository_source_sha256": "8c2dadc9cef6a18f642f87d3a4b99da6f17b26d876f161c8e9949beac8d6bd89",
      "en": "「Fail to finish me, and this happens!」"
    },
    "326:6600": {
      "repository_source_sha256": "662032d8bd307949c10f7a3cf3a844f1843d770c37cae4a1b70997cebd52d4d2",
      "en": "「Looks like you were late retreating!」"
    },
    "326:6627": {
      "repository_source_sha256": "7cf4a233f6a3febfe69c126b66e05aae266db7f7ffc38c137aea0540a0ee0bc7",
      "en": "「I already know where you are!」"
    },
    "326:6654": {
      "repository_source_sha256": "7d279983ac020976a956887145694b9e80b40e64297431888ed4ad9bfbd27ec2",
      "en": "「I make a point of repaying debts!」"
    },
    "326:6683": {
      "repository_source_sha256": "e03e96a3e442508b5a757818ebad468f328f2ae37b044e29d654fc1dc2170ba2",
      "en": "「Good attack. I'll follow up...!」"
    },
    "326:6712": {
      "repository_source_sha256": "4b476a1e1a9fad8b26ee925e53d7a066093a9071359ee8a2e9318abc8587eb21",
      "en": "「Fall back! I'll handle the rest!」"
    },
    "326:6741": {
      "repository_source_sha256": "ccefe6ebc65dd83f72edce395624e201496ba80a6f5d25f8ce13c1bf792dd8af",
      "en": "「Hmph. As expected of you, $$ヒイロ$$.」"
    },
    "326:6770": {
      "repository_source_sha256": "28b7e73334b69967fb295dfaae2821480124f173edd54510c0686beeacb9d7b0",
      "en": "「You're sloppy at the finish, $$デュオ$$!」"
    },
    "326:6797": {
      "repository_source_sha256": "f63e783ee76e6a84181c39ee18f1990465c00388715a5a432e78ab6530aeadc0",
      "en": "「Good work, $$トロワ$$.」"
    },
    "326:6822": {
      "repository_source_sha256": "d5578ec3c02707ef0a0a82c593475dda2d0bcd2d83fd5d90556b6decc97c8eb1",
      "en": "「Show no mercy, $$カトル$$!」"
    },
    "326:6851": {
      "repository_source_sha256": "9a592597e1ec6d41829d5e6353e93fb43505970838f0d30f4e56423e2793aed0",
      "en": "「I've seen what you can do, $$ゼクス$$.」"
    },
    "326:6880": {
      "repository_source_sha256": "3224070ea5c323c677ffc0de5003e2f427182d9def93588afa9384070aad6063",
      "en": "「Not bad for a woman.」"
    },
    "326:6901": {
      "repository_source_sha256": "5fa02c7ad7872ab24137e468333892640bff6f352e91c8bef6921ace1a79cf28",
      "en": "「I'll work with you, $$カレン$$!」"
    },
    "326:6926": {
      "repository_source_sha256": "ec189626c5216cc864de01ef14858041ff48df8997d517797d02b21b028c6efa",
      "en": "「Leave the real combat to me, $$ゼロ$$!」"
    },
    "326:4247": {
      "repository_source_sha256": "af7b5582da5ecf7f1aeaab197750c2030b616ab5fd0451f6ffd504c1b1023caf",
      "en": "「Don't relax in battle, I said!」"
    },
    "326:4282": {
      "repository_source_sha256": "f5565a2bfa271f904c260f1e949950ed7b3bf8cdc72da0f8b73ce6fa87257a54",
      "en": "「I'll keep at it until you go down!」"
    },
    "326:7373": {
      "repository_source_sha256": "970369007e05af4f549f2be017860b55bb3323090dc60b36f33fd00a602bebf8",
      "en": "「I'm going ahead!」"
    },
    "326:7263": {
      "repository_source_sha256": "5ef6186f8459af6afd4eb0ee52c9100438c8b2b7b04dd3ed08bcedc87f37f126",
      "en": "「I walk my own path!」"
    },
    "326:7286": {
      "repository_source_sha256": "58c8bd889cc90d54d364bc54d16ee19010eadc01e81ee92e12efcd97d6a42ece",
      "en": "「I won't be bested one-on-one!」"
    },
    "326:7313": {
      "repository_source_sha256": "06d28e36bf764f477f9cbf3424de46270664cd75dce93cf060162b70b3bf5d14",
      "en": "「I'll do as I please.」"
    },
    "326:7344": {
      "repository_source_sha256": "d173235560e667f236a2c678b93e90351afe3e7bf3805c0952b332a0592f53d5",
      "en": "「I'll do my part without being told.」"
    },
    "326:8749": {
      "repository_source_sha256": "61bb969848d5cb681396baae5bfbe7836d867233a7a7025e1984b3123e734b47",
      "en": "「I... and justice... lost...」"
    },
    "326:8776": {
      "repository_source_sha256": "d07446794f0b39b9c026223a7000106fdc2782a8fda89c3eda4943e5d8e5149d",
      "en": "「Wait there! I'll surely come back!」"
    },
    "326:8352": {
      "repository_source_sha256": "4b720a78cb8b1a403e3e5ff326e40c9c8e63a2d01969d2ce5334583dd99a4a05",
      "en": "「Daaamn it!」"
    },
    "326:8373": {
      "repository_source_sha256": "3c6b86edd95a3b4000f09ef37b9d42b06fd69d96c3ff0b9b41d6c26af0401bf6",
      "en": "「Ngh...!\\nThe next move may decide the match!」"
    }
  },

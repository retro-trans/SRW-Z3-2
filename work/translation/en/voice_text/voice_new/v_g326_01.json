{
  "schema": 1,
  "rows": {
    "326:8428": {
      "repository_source_sha256": "dce6ede833912e48d52d282f08add728292b2df023afd1ddd7674ec3c5c6c888",
      "en": "「You're strong, but you're wrong!」"
    },
    "326:8467": {
      "repository_source_sha256": "9aeeb17e371179c9d53b624924e973b0933156538f4887692fed17adca54df96",
      "en": "「With that much power,\\nwhy do you misuse it!」"
    },
    "326:8520": {
      "repository_source_sha256": "1219c5986ce7f0093e2c1d3c1372de9ada4d996c62a6720b2546a1455aaaa83e",
      "en": "「Body and mech still move! I can fight!」"
    },
    "326:8563": {
      "repository_source_sha256": "6c81d2e5beb92060dc27681b4ca2ad71d7118e772d27ea20db6d30416f9db979",
      "en": "「Defeat them before my life ends...!\\nThat's all!」"
    },
    "326:8612": {
      "repository_source_sha256": "f523b727aa924685e4bac3048262e6f4d356d422385029d8ef724b7d1810a181",
      "en": "「Scold this pathetic me, $$ナタク$$...!」"
    },
    "326:8653": {
      "repository_source_sha256": "57395581369901a4330b1edfa43124621f51b3c73035f630f5594ed1004b97ee",
      "en": "「$$ナタク$$, we have to be strong...!」"
    },
    "326:8696": {
      "repository_source_sha256": "791e3476fcd8b990f661e2f1587f6900178957772eddd684c0187f2af0056bcb",
      "en": "「$$ナタク$$,\\nwe can't die yet!」"
    },
    "326:8140": {
      "repository_source_sha256": "9c1606b5a33a6e6644ecd7d5562c2aeed62ac3462ac26e09b8d18534f43c227e",
      "en": "「What's wrong! Is this your limit?」"
    },
    "326:8171": {
      "repository_source_sha256": "31d691003a62a01ab6d8c5aebeb5d49382b44243150459624e09800da7e8586f",
      "en": "「You're fairly good...!」"
    },
    "326:8200": {
      "repository_source_sha256": "59dafc84fbcac6b0e0fae359534bfb4429f5e9d8d37dc04f1273d0f137814bad",
      "en": "「So you're opponent enough...!」"
    },
    "326:8231": {
      "repository_source_sha256": "ed5ad6189ed3ccc152430b29d1d52d65a9750efeb4268b890b1619882a22bff9",
      "en": "「I'm not one to yield to pain!」"
    },
    "326:8260": {
      "repository_source_sha256": "5617125c7638c9298a044a98cc1b2e94e969b15ed1c9001f8257cd8bccd1620d",
      "en": "「Flesh for bone...! It starts now!」"
    },
    "326:8303": {
      "repository_source_sha256": "dcf8847be4fc51ff9deaca5c820adabf094e5d52e8dedd56bbdb7b230cd1817b",
      "en": "「You can't beat me down\\nwith something like this!」"
    },
    "326:7936": {
      "repository_source_sha256": "a0e78be2f551a7e68b3ffb29ce57da44010a652389c6e6203aa0c814854150cb",
      "en": "「Don't make me laugh!」"
    },
    "326:7953": {
      "repository_source_sha256": "ab6043241e8e59cdfef994220eef74dff8e8825282f1b2541f3e56dcfde7b7c6",
      "en": "「Leave now, while you still can!」"
    },
    "326:7984": {
      "repository_source_sha256": "8e9507b45b19bba0e29e9cbaa8ca6f83b1fc0ecc7e3457e7e524496e3a88c434",
      "en": "「An attack like this is nothing...!」"
    },
    "326:8021": {
      "repository_source_sha256": "dd43ff1422eacda0b9ce902fed63c339a900909ce67910ce9d0c4653dde4a0bc",
      "en": "「The weak shouldn't fight!」"
    },
    "326:8050": {
      "repository_source_sha256": "34bf3c014ffbc574541d01b489c8754c6d87efc7eed62b11596bfd28c69eafa6",
      "en": "「Why fight?\\nAgainst an enemy you can't beat...!」"
    },
    "326:8099": {
      "repository_source_sha256": "c1f7912afdbc45226a8d5b916fb976534e42908f899c70a96b19950a6fee20b0",
      "en": "「Is that all! You're no match for me!」"
    },
    "326:7638": {
      "repository_source_sha256": "1a8280bc2f569f2d1c30dd4a96dac38ff88abb89f09a836cf7a267d9dd1d1538",
      "en": "「I've already read that move.」"
    },
    "326:7665": {
      "repository_source_sha256": "123655c887a01341ffdb2f868a954a8c08d742801ecd5469d2180968972cb3c0",
      "en": "「You're weak.」"
    },
    "326:7680": {
      "repository_source_sha256": "18539f332919621ee3f54c24aaa7feef68297f9189b0c21adc7715d0c1b2d9cb",
      "en": "「Justice without power is powerless.」"
    },
    "326:7703": {
      "repository_source_sha256": "31f9938bdefdf30ea12d12c4de2d11a0239726c15a381fc3b790a2b83f765e1c",
      "en": "「You can't defeat me!」"
    },
    "326:7730": {
      "repository_source_sha256": "0832b2a0103c22f83fd5b52338d690ddac4a9f4cd5cbe4f456930507af142f4d",
      "en": "「Don't take battle lightly!」"
    },
    "326:7753": {
      "repository_source_sha256": "624b8f5c2c6b2d0c347e485135319876ac260cc55aa1879441654c7f4fadbf24",
      "en": "「What's wrong!\\nProve your justice to me!」"
    },
    "326:7802": {
      "repository_source_sha256": "e586fe3013baeb7a1b477dbcbbdbd3f34aaa3a46999309511c75dcfb1325c71d",
      "en": "「They underestimate $$ナタク$$...!」"
    },
    "326:7860": {
      "repository_source_sha256": "4f3f95d26ff55e6734eaaf027370ed7d24ea4199f7c6d13977093e4ad7d1cb22",
      "en": "「Why can't you see it's futile!」"
    },
    "326:7899": {
      "repository_source_sha256": "d9c9899e568a4b5868b9dc7ec8376d8cf761303ca29cb209debd8c0e0f7f6fd6",
      "en": "「As if that attack would work on me!」"
    },
    "326:2498": {
      "repository_source_sha256": "6377eddf08786ceb80855ee48f0d7373f27ddde78098c92717f4e953b2645f9c",
      "en": "「Now I can give up fighting too!\\nFarewell, $$トレーズ$$.」"
    },
    "326:2561": {
      "repository_source_sha256": "d350b049d26aaa4f4314d1e8c897bce8117da3eb7e1502c78d8f1820d01f41dd",
      "en": "「$$ナタク$$... Rest in peace.」"
    },
    "326:8815": {
      "repository_source_sha256": "5f0e7524cb174f0ab955e818c6dbb54ad52088eca669a65a0729781f737000a6",
      "en": "「A greater evil brings the player back! I'll be that evil!」"
    },
    "326:6955": {
      "repository_source_sha256": "21d3603298d007955371480a6fe492158eb5e97f6f3523d96b251a00591f1405",
      "en": "「The righteous must be strong!」"
    },
    "326:6990": {
      "repository_source_sha256": "b3a40aa4bc4eb9ded2c07bc3e2d63738776c890921b4e525a6aef3b198ababbf",
      "en": "「Fall back if you want to live!」"
    },
    "326:7021": {
      "repository_source_sha256": "5378ef71cdcc36a8a6ff8df311b23872a2ccf49ef68b6b332e4f7d6f17fe227a",
      "en": "「What are you doing, $$ヒイロ$$!」"
    },
    "326:7048": {
      "repository_source_sha256": "a11721d607fb05cacc9e2b3f1b66313c3059d6e19cda3b9edab5ec49e81ea1c8",
      "en": "「Don't let your guard down, $$デュオ$$!」"
    },
    "326:7073": {
      "repository_source_sha256": "33ed902cfff7c56d466390a8360958d9c49800bd039839b347ff53195d2553c3",
      "en": "「$$トロワ$$, I'll handle this!」"
    },
    "326:7104": {
      "repository_source_sha256": "fb47f7b1df06c393caa3ce0c01fd8020c8d61506fd5bfb2adecbe30a7fec84e8",
      "en": "「Regroup, $$カトル$$!」"
    },
    "326:7133": {
      "repository_source_sha256": "053c5d64c4e807785d537c92c9ea89b74a35d6de193a20b37e85032ab5d38d9a",
      "en": "「To push $$ゼクス$$ this far...!」"
    },
    "326:7170": {
      "repository_source_sha256": "4bd61d6a26fd7de5008beb2efb1a0dddba918809f39f8e1019c100376a3de76a",
      "en": "「Stay back, woman!」"
    },
    "326:7193": {
      "repository_source_sha256": "5f9a792f146b17b26f8aec3240149d8faf788b2f6a7b782d5644bbabff7dd446",
      "en": "「I'm repaying my debt, $$カレン$$.」"
    },
    "326:7224": {
      "repository_source_sha256": "d32c7769c69a05b3d1fb69d7d8fcf48ebdc2cbe97fea9fa5a667acbbe3a4df09",
      "en": "「$$ゼロ$$! Don't die without permission!」"
    },
    "326:7488": {
      "repository_source_sha256": "58bbd79f8d05c41e1695f07a9ca01637fd35712cca1206ba6f87637f190e9829",
      "en": "「I'm... powerless...!」"
    },
    "326:7509": {
      "repository_source_sha256": "da742183d9080b8ae40102c6d8cdc25b94c8b208001fa2bbf3d0cacd4c59de14",
      "en": "「Humiliating...! I'm helpless...!」"
    },
    "326:7548": {
      "repository_source_sha256": "3a8d2a6d7496e9f995fd4b2cff10abbf194ac6dbaa0659e6202a6ba40f30ea8d",
      "en": "「To have my counterattack sealed...!」"
    },
    "326:7585": {
      "repository_source_sha256": "6c9f72df8c11c8cdf7ca927535213c608ec6d0a5cf0966bd7ee5724ee664caac",
      "en": "「For now, I bide my time...\\nBut I'll repay this soon...!」"
    },
    "326:3603": {
      "repository_source_sha256": "20ec6e3879109b70265d726293ba45f35ed039d317d56c2a675a1351300e638c",
      "en": "「Are you in the right!?」"
    },
    "326:3630": {
      "repository_source_sha256": "7210b5a048e16e0b72f81c75d3a0ed23d0f8e7245c64dd11455fb8b81016dabd",
      "en": "「Take this strike!」"
    },
    "326:3657": {
      "repository_source_sha256": "78f3165f19c6f294d1027b1a09dc595c496203af538ae72296d68bd0f1e5de6f",
      "en": "「I'll crush you, will and all!」"
    },
    "326:3686": {
      "repository_source_sha256": "e91227ebcbf98d4ee27757db2df9ba60b142c25d881520c2e571f30a4c45bf00",
      "en": "「I'll finish this fast!」"
    },
    "326:3711": {
      "repository_source_sha256": "488192c368cea6a41daeeaaa652a8fb999fdd4dabc71033df1bc2168d91c59b9",
      "en": "「Now show me your power!」"
    },
    "326:3740": {
      "repository_source_sha256": "2ac6bacb0ab5970bfa67d7c1c9b8b6f06819c2c9be5b7ea550427e0009926104",
      "en": "「I'll just do my best right now...!」"
    },
    "326:3777": {
      "repository_source_sha256": "8079dd1a8b2c25e3f4afa42ad00e322f2f8b5f1e75c29d7e050e35a98f7c8306",
      "en": "「I fight for my own justice!」"
    },
    "326:3808": {
      "repository_source_sha256": "29108b0e02ea604a8b45c4fe0d421ea09ec9e539b8031eaede91961213207740",
      "en": "「Attack is the best defense!」"
    },
    "326:3942": {
      "repository_source_sha256": "a91adf3f75374ed8f3f06a3cffef896a73a23af1e3f8226161783a65488efd6e",
      "en": "「I won't let you in so easily...!」"
    },
    "326:3969": {
      "repository_source_sha256": "23336c8bf37810bf2657ae14e1a41deb6e492af1fb33e9cac199b9b7cab774ce",
      "en": "「You're far too defenseless...!」"
    },
    "326:3996": {
      "repository_source_sha256": "44bebeb2fe7208b0b9cda65784e447364848116ead24189e76583d1f6ded17c2",
      "en": "「Your mistake, dropping your guard!」"
    },
    "326:4027": {
      "repository_source_sha256": "46cd8d4f500d3a1c33dd57122405d03d70561087fbf7f45130124c92fecccf54",
      "en": "「Never relax on the battlefield!」"
    },
    "326:3862": {
      "repository_source_sha256": "b7834d64147e833134d85bcdcb05612bab7660ca94218f3417281046797475b1",
      "en": "「You're already locked on!」"
    },
    "326:3883": {
      "repository_source_sha256": "8d7206f7a7aea6043d8649dd252d9e3e84ecbb694b224e389519e376aa483ed5",
      "en": "「I'll land a direct hit, for sure!」"
    },
    "326:3906": {
      "repository_source_sha256": "e5c74ed823633c31bb61ee787b9f48eee4c8ff8afd8978a6639f3d792ac6763b",
      "en": "「Locked on!」"
    },
    "326:3925": {
      "repository_source_sha256": "aece6cc4bc156199ebe5aa91532ad3331eabe82682206056cd7aab396e454464",
      "en": "「I won't miss!」"
    },
    "326:4078": {
      "repository_source_sha256": "f548c61a1f0799a8b5f492aa4742f48f9deb2d61be617037ac2f7a51fee19e37",
      "en": "「Out of my sight!」"
    },
    "326:4129": {
      "repository_source_sha256": "3b43f66e7b0c29e0fbce13b19f091e5d5a2030197d622bfd9ea8c1bda3d78799",
      "en": "「There you are!!」"
    },
    "326:4150": {
      "repository_source_sha256": "c0f25cd223735298b14787017b37eacbf4abb508f5cbc235e239c8fc45969523",
      "en": "「Yaaaaaah!!」"
    },
    "326:7447": {
      "repository_source_sha256": "12860f84d09cd45f23e6ecf0f69fd8e9778e41fb5a8df21761843eb2591e8222",
      "en": "「This seems the quickest way...!」"
    },
    "326:6294": {
      "repository_source_sha256": "f8c071320c30bddd9aae5b6b20b96885725b769836e5d973b08087dc3c0f6513",
      "en": "「So the time to use this has come...!」"
    },
    "326:6344": {
      "repository_source_sha256": "7f87f33c750d41d288f1ac5092a1fd5f3940894e11c448ccc435e38de0238b0c",
      "en": "「Naturally.」"
    },
    "326:6363": {
      "repository_source_sha256": "54a45bf2f167f0aa540793acccd6c240be478249a688f1fc60efda29236e96ec",
      "en": "「I'll shoot through your very will!」"
    },
    "326:6413": {
      "repository_source_sha256": "5b68ec04246b244a0ef3825fc435e4ad9912b383f6793ac035175d46d85bf36d",
      "en": "「I... decide what justice is!」"
    },
    "326:6438": {
      "repository_source_sha256": "740d1fbe68820e94502e683aa411174a9695164ab2d6ae7de4f14b1b46aa604f",
      "en": "「I'll end this right now!」"
    },
    "326:6467": {
      "repository_source_sha256": "d58a85d0ce8ec833da067e1f2db601ccd27625aa214654b0013522de255aff80",
      "en": "「This is the end!」"
    },
    "326:6490": {
      "repository_source_sha256": "3b3bbeb0a49f3b9d2e104f6652aaed374c2933a82b52ae6bb00c71006a5a78b6",
      "en": "「Hmph, how fragile...」"
    },
    "326:4175": {
      "repository_source_sha256": "ac98bcba3cde690ff37e9df06d44faa94dbe96d43da3c56d268d26771465a314",
      "en": "「I'll simply uphold my own justice...」"
    },
    "326:4206": {
      "repository_source_sha256": "29984a7ddadf932a0e82993c8c75a5808ac6c09430b3ba85ca6dfc78a27a0b5f",
      "en": "「I'm $$張五飛$$, the man who beat you!」"
    }

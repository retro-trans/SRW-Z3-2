    },
    "336:15610": {
      "repository_source_sha256": "be32e48c736f1fd5d5d331c051ead4f29a5d57608cfdfda49bad2901be8b6431",
      "en": "「I'll do it for $$ナミ$$'s sake too...!」"
    },
    "336:15645": {
      "repository_source_sha256": "a38568e51e1f205ee0b75e74ea58d7d439376dc69be67569ef82ed1cb2983121",

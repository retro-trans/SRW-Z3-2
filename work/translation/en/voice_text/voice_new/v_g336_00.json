    },
    "336:4288": {
      "repository_source_sha256": "65189fe1b0137abe7d17c5e177cc734d2dd072156c556811e00a167462f1bc53",
      "en": "「No using that so-called $$スフィア$$!」"
    },
    "336:4325": {
      "repository_source_sha256": "2988b3612e81c9bb7aa08c783ec9e32a78bac3445375141de974c1359e720c5b",
      "en": "「Circumstance beat you. You're weak!」"
    },
    "336:4358": {
      "repository_source_sha256": "18538785496e5991712e322cb5f3e03f2b7e407ec6ee1dcdb87668b488e90919",
      "en": "「Sorry, but I have no sympathy in me!」"
    },
    "336:4393": {
      "repository_source_sha256": "b232892abc9aaa584d075996d01ee30d543212e3e67ea13ddcdc82ca51390316",

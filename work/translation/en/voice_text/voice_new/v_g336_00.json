    },
    "336:15711": {
      "repository_source_sha256": "2cb93a4a1610b399d0ae785c7923a4e481b76287a1c176a115fee0f6b56a0526",
      "en": "「I've come, $$千鳥$$!\\nI'm nearly there!」"
    },
    "336:15762": {
      "repository_source_sha256": "7f1a0719bea9e7c483fabeb3fac4a84bb957d0f345d99cc453289ea9d8c52a3c",
      "en": "「$$千鳥かなめ$$! Can you hear me?!」"
    },
    "336:15801": {
      "repository_source_sha256": "570292d9d50d432ece3b315fb415ac08b7cbcfa511f55d35b341a18cf4546885",
      "en": "「$$アマルガム$$! I'll repay every debt!」"
    },
    "336:15840": {
      "repository_source_sha256": "69a897afb76e54a927ec3b574cc11507be3f46e93f48a62fd479748c3cc44d60",
      "en": "「I'll stop your scheme at all costs!」"
    },

      "repository_source_sha256": "92e320d05ad85678bff3d0b0454df3d6730860d1f809814e7cbfb28bafc62a7b",
      "en": "「I'll never let it be transformed!」"
    },
    "336:15902": {
      "repository_source_sha256": "3dd4dd8b824af6e7167b5878c6094ac21e1476cee99f3312609fb6438219160a",
      "en": "「Selfish spacetime repair? I refuse!」"
    },
    "336:15941": {
      "repository_source_sha256": "ec8812582da5e06f70e2dd9ade84497f71319328e52690d06869dcd6eb103431",
      "en": "「I have a place to return to now...!」"
    },
    "336:15976": {
      "repository_source_sha256": "e83d57b0f5b3081462ecd679c5ef6b0a2f5e736c20ce16e52b9d8f0caeef89cf",
      "en": "「I'll return... Wait for me, $$千鳥$$!」"
    },

    "336:4147": {
      "repository_source_sha256": "55ed0452a7a9cb60f7049d501503083a017fdbf714aa8aa5a4ef761ba80fb6dd",
      "en": "「I'll eliminate you as Earth's trash!」"
    },
    "336:4186": {
      "repository_source_sha256": "2efbe10be268b5eccb00295a11070dd2021c8218cbdc50df4e67c09ce2c1741b",
      "en": "「Rulers always end up\\nbeing overthrown!」"
    },
    "336:4239": {
      "repository_source_sha256": "9bcac7cc740b612ace264d7236cb40dc737b9225ff2664390c5cb0356696e3cc",

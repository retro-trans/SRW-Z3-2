{
  "schema": 1,
  "rows": {
    "336:16446": {
      "repository_source_sha256": "477a2c6144021a043c13c80dfb6297673c5a075e6d73739c7bcc371c2642e4d1",
      "en": "「No choice but to do it. Focus.」"
    },
    "336:16754": {
      "repository_source_sha256": "6a0bac37d2c009c36f0c6c2c6958a6433cea631893a21096fcef2575563439a6",
      "en": "「Unknown or not, it can be beaten!」"
    },
    "336:16795": {
      "repository_source_sha256": "76e701bd95e5c40eb362042ebef60af98b73c225e9e40ae08d3a8059c5da9589",
      "en": "「Probing your aims can wait!」"
    },
    "336:16830": {
      "repository_source_sha256": "832b6cd5550a2bed31c9726ff60604f49271c646b96af142beefd6c66b078fef",
      "en": "「Burn up as a red shooting star!」"
    },
    "336:16859": {
      "repository_source_sha256": "ce4ae0cfbfd0c7063ee1231ec5b266a9dab33f6a21e8b76e13c0c6f8ac1587ce",
      "en": "「Come on, $$ハマーン・カーン$$!」"
    },
    "336:16896": {
      "repository_source_sha256": "eb001d126ab5cb5dc20933725c5dbacc215cbb1a0285112ba3a7dc390577f90d",
      "en": "「Just a soldier on orders...!」"
    },
    "336:16931": {
      "repository_source_sha256": "f88ee8ce2d1516d26054e57c4754d9cd9402e7faf2695088d2f226bd90085533",
      "en": "「What's past this war, you think...!」"
    },
    "336:16974": {
      "repository_source_sha256": "94e4db53ddfc368e08ba12ecc8ad5c0b0beafc8b907f96dc35159eea516ac22f",
      "en": "「I will stop you without fail,\\n$$レナード・テスタロッサ$$!」"
    },
    "336:17033": {
      "repository_source_sha256": "635b41a46e24f354e2486db6d0937821f5b54e651cdef7aa84129134e513f7a3",
      "en": "「If you insist on\\ndenying the world as it is!」"
    },
    "336:17082": {
      "repository_source_sha256": "391693dfec797c8e8af6311ae773befff2f9199d22a8bbe3eaaa560ddf999452",
      "en": "「Even if we can join hands, not now!」"
    },
    "336:17121": {
      "repository_source_sha256": "2405e1df0549f6a8bad4c009b187fd5153ff4326ff3cf5264ba9fafc2b6a3a9c",
      "en": "「You attack, we push back. Simple!」"
    },
    "336:17158": {
      "repository_source_sha256": "40ccc1d0f82dbf6550b500868abb87ebe6f40717862db0f780e42d280e9868df",
      "en": "「Now I can only trust $$刹那$$...!」"
    },
    "336:17189": {
      "repository_source_sha256": "d9037004b4484ada67fde8bc4863f0210a4e1c95b2f1a28461a129e8a32d99bc",
      "en": "「Lose to a lawless mob\\nwith no discipline...?!」"
    },
    "336:17240": {
      "repository_source_sha256": "b1d645592608345eabf61b31f4b9d83514c3b386e381d687649a0fd1f1f6780f",
      "en": "「High morale, but just bluster...!」"
    },
    "336:17281": {
      "repository_source_sha256": "bba7bad7f6ddea4de6a015c13f8122421f5ee856747862fba6362521b0602103",
      "en": "「They use the terrain well...!」"
    },
    "336:17312": {
      "repository_source_sha256": "8c826eb26ae909089bb0ed479225232e5180982abf0a7b54653867b4b624bc54",
      "en": "「Go cry your way back home!」"
    },
    "336:17349": {
      "repository_source_sha256": "5ebe53cb95bf0a67e86de903c8277ed29c5cb2499ce64fd34caa8426dc1e519e",
      "en": "「What's wrong, miss Mommy's milk?!」"
    },
    "336:17390": {
      "repository_source_sha256": "6841dc3b2be74e47a4cf89ebd720bfccadc3903667357252b3e852b81058dd64",
      "en": "「You're as persistent as a cockroach!」"
    },
    "336:17423": {
      "repository_source_sha256": "546e85b00d64ba3194c6262ce782dbc11f06e64369b89fbb800abf97a7a1f485",
      "en": "「Only your tenacity is first-rate!」"
    },
    "336:17454": {
      "repository_source_sha256": "0229ee342e3ab9ca1264b75b6a00be08ba6f3ae57a67ad2d13bd53738cf73ae9",
      "en": "「I said I'm sick of your faces!」"
    },
    "336:17495": {
      "repository_source_sha256": "db33bdc1c1702b7667f8722a54751986ef8882017f9d932a49ad99091da56196",
      "en": "「The Captain is not your princess!」"
    },
    "336:17532": {
      "repository_source_sha256": "4c7415b5c82f6cd172ea0e15a37281603ee21e9b75d1e260dfffde648da081ff",
      "en": "「As the trash collector, I can't\\nleave you lying around!」"
    },
    "336:17585": {
      "repository_source_sha256": "a6e67b37264e535679a08cd435cd582531603eecfb9b97601c2e9ef57e834503",
      "en": "「Commanders are priority targets...!」"
    },
    "336:17616": {
      "repository_source_sha256": "f6da86189f1cf40ba93e8bc516abaf473e66dc87ce894f9cefc249005c6cdc85",
      "en": "「Eliminate the enemy core ASAP!」"
    },
    "336:17659": {
      "repository_source_sha256": "0657dcc2a0f2792e043389422a46af4edbc2e7c26887c707c313859b7e1e7529",
      "en": "「I'm fairly used to dealing\\nwith big ones!」"
    },
    "336:17708": {
      "repository_source_sha256": "b45bbb82368663e10db9abcfb4771d93aed41127bcbe3c837b2818f3e1fd3e8e",
      "en": "「Our speed is even...! Then!」"
    },
    "336:17741": {
      "repository_source_sha256": "06a198390c093508cecf2e909dc9b7f878d7b3f34e0d70c7c3582de383649992",
      "en": "「Slowpoke!」"
    },
    "336:17756": {
      "repository_source_sha256": "54b924609d84a43100aea1e04989eb66e7ba3c1b7fd57bbf432a27d7f34fc334",
      "en": "「Flitting about won't keep you safe!」"
    },
    "336:17795": {
      "repository_source_sha256": "6141932e536cd4636008a5a4d5bb4dcc377839a51e3fdb9b64886519f005f5ce",
      "en": "「I must stop you with all I've got!」"
    },
    "336:17836": {
      "repository_source_sha256": "2bfa4d9ff1e9f038f97726afd437f3dd5753db240af03ccbad72e868bfe0f848",
      "en": "「I'll ruin all of\\nyour schemes!」"
    },
    "336:17885": {
      "repository_source_sha256": "0bce1c18fd7198d5579f718b508b0341ab71f0131cef9d457ef1fb75541541f8",
      "en": "「Too much ambition will ruin you!」"
    },
    "336:17922": {
      "repository_source_sha256": "6db5084bc45b4d4892a535a13c14980e42f465def6ae8bc7e1573bb5dcb1f880",
      "en": "「I'll smear your so-called ideals\\nwith germ-ridden crap!」"
    },
    "336:17985": {
      "repository_source_sha256": "e4463cc0cd881c077bc728512a53f93f13af44bfc609931aba72d292aab1b027",
      "en": "「A dictator ruled by megalomania...!」"
    },
    "336:18024": {
      "repository_source_sha256": "765614d446512cf2e1b347809c6373a5088ea5d98f4f978802349e68f3597c05",
      "en": "「Don't think your bluff\\nwill work forever...!」"
    },
    "336:18083": {
      "repository_source_sha256": "4282cb2204a3409193abf74a44e5b84c38597a1e882161ea1d6f3adbb1fae013",
      "en": "「So you're the Invader boss!」"
    },
    "336:18110": {
      "repository_source_sha256": "ba198fdeea7fb2aee83262221f598d78892fb6ac85904d1c91f095c8688972c1",
      "en": "「Whoever gets in the way of love,\\nI'll kick them for the horse!」"
    },
    "336:18165": {
      "repository_source_sha256": "0af3392350cc136e1adc6bacfa292e8ca5fc337b6ea29705165469ef6d37938d",
      "en": "「You're nothing but a Pilot Support\\nEnlightenment System!」"
    },
    "336:18218": {
      "repository_source_sha256": "dea8bec626f8e054fa0c64a839594cb4ea64c4d215a1ae024bb8983ca95fb0e4",
      "en": "「Next to you, my partner\\nis still several notches better!」"
    },
    "336:18271": {
      "repository_source_sha256": "61e9d602db6f23bb7e339c7ef4f24a0c4efe358b3b82a403b3441abf40f3cbb4",
      "en": "「Learn a thing or two from $$チェインバー#pilot$$!」"
    },
    "336:18314": {
      "repository_source_sha256": "b590ffd3924fe68cdaf8bdc3070511cb10b257dea794dc1114ef58ebe9a42d49",
      "en": "「No coward here will just\\nsit quietly and be destroyed!」"
    },
    "336:18373": {
      "repository_source_sha256": "e4ce124a4819f30fbd826d62f04a00eaaecbaa968a4aad257ac388990455f11b",
      "en": "「If you want to destroy humanity,\\nbeat me first!」"
    },
    "336:18422": {
      "repository_source_sha256": "4f9b3db772bae08f738e776d8b5e03cc59a42add24561cc7b6bee4bd4962e054",
      "en": "「What about you, huh? You!」"
    },
    "336:18453": {
      "repository_source_sha256": "81500f84631e2cac63465a542ddbb93b0a31100665600d9a27da9a1a7efebb18",
      "en": "「Okay, first we immobilize it!」"
    },
    "336:18484": {
      "repository_source_sha256": "218ad7cf017eb67029dfa8ce7a7b1ee8a31fa174df519af506c0127a32fc1c26",
      "en": "「Just land a hit first!\\nThen we talk!」"
    },
    "336:18533": {
      "repository_source_sha256": "9f0b2dcc0080e184b6c10fa66d8fc2533c9990af70aac6be05d5fefd0c301e03",
      "en": "「Hit them before they close in!」"
    },
    "336:18558": {
      "repository_source_sha256": "a12e4be6b39effb526cee300543a62b77c65061e6578efb78919224dfe6e0d65",
      "en": "「That size defies common sense...!」"
    },
    "336:18587": {
      "repository_source_sha256": "d453cd4612e24aecf0225a71c98d8734347434b572fc1fc7090ec061cc26f083",
      "en": "「I agree with you this time!」"
    },
    "336:18614": {
      "repository_source_sha256": "73fb4d70cc28d15658c4cc846b881640e2433da42eec3a99174b7f69aaafd207",
      "en": "「Invaders, your free rein ends here!」"
    },
    "336:18657": {
      "repository_source_sha256": "09e3eb2c1f4fe37291c01a730cee1c6ae22d145c21c97aa49b6e356dbc2491b4",
      "en": "「I'll obstruct you thoroughly!」"
    },
    "336:18694": {
      "repository_source_sha256": "696d2fc358614a751d4a04f869d1fb29044c71e6d0442cfdc78e1367bee6ebab",
      "en": "「$$サイデリアル$$...!\\nYou'll regret laying hands on Earth!」"
    },
    "336:18759": {
      "repository_source_sha256": "ea1da3326d878abc54c007002926b0538f70a3cccc4df8379a9a2da4274800d7",
      "en": "「No need to hold back on invaders!」"
    },
    "336:18788": {
      "repository_source_sha256": "c1131c4de9665fff64958c2c66a6837ebff42e511da7e0b05aea48b8d8fc8d78",
      "en": "「Whatever power you use,\\nskill decides in the end!」"
    },
    "336:18837": {
      "repository_source_sha256": "43b40ed2e1c6d044c751652958732e55add2897734a4c1a64923fd4f1309b955",
      "en": "「Show me the power of your $$スフィア$$!」"
    },
    "336:18876": {
      "repository_source_sha256": "fb3f32cb7fc00b735b4b3970de3eb5442593760411eb68a6b925d332273ed975",
      "en": "「A target right up our alley!」"
    },
    "336:18901": {
      "repository_source_sha256": "43d6f0c251d9be2333d4218ccfd3d7e31d5779121442fe36204c2a10b4e70240",
      "en": "「I don't intend to take that poison!」"
    },
    "336:18934": {
      "repository_source_sha256": "1a363b67cf3cee9b7d3acd132447fd5611e142bfd54d7a24bffa2d72b9df4f9f",
      "en": "「I won't lose to a gloomy,\\nsullen jerk!」"
    },
    "336:18987": {
      "repository_source_sha256": "638b37618ca4c34975fb2946f56cb1d0bf452f5cd9a8ae0ad1cb39031c26a56e",
      "en": "「A Supreme Commander on the field?\\nYou must be very sure of yourself!」"
    },
    "336:19044": {
      "repository_source_sha256": "3fd83e7b5460e473b21e9d4afd2f6e170db9f229526153e2cf4c8d43741fc456",
      "en": "「You shameless cow!」"
    },
    "336:19069": {
      "repository_source_sha256": "6f93ce1c097809cad37df168aa78688c58f173db83accce649dd01a5bd592117",
      "en": "「With the Emperor dragged out,\\nall that's left is to strike!」"
    },
    "336:19120": {
      "repository_source_sha256": "841f7ae77957a9aa4627f341f7e26883d38b61f08255bbff982cbfceffa53bb2",
      "en": "「$$次元将$$ with $$スフィア$$...!\\nDon't let your guard down!」"
    },
    "336:19177": {
      "repository_source_sha256": "9e2b5b4e7319cecae41e1cbe3e6464c3b751fb0bb70da1f920409c27d338be87",
      "en": "「Not another word out of you!」"
    },
    "336:19210": {
      "repository_source_sha256": "abae282feb63938746d037374c694c7158d029302f07fe58d2e4492d7e5fadc6",
      "en": "「$$アサキム・ドーウィン$$!\\nI'll deliver your last rites!」"
    },
    "336:19267": {
      "repository_source_sha256": "21bda655c3cbbdebbcdb4d156b55b5c24211af31b6589250dd438a64eb1dfad6",
      "en": "「Run off with your tail between legs\\nand whine to your god!」"
    },
    "336:19322": {
      "repository_source_sha256": "b4c41aa2f987c1c8291aef914ea84a761c50c3a495336272c30df6bce17b91b7",
      "en": "「An emissary of God strolling out?\\nThat's not very awe-inspiring!」"
    },
    "336:19383": {
      "repository_source_sha256": "f59101ae39244640bbef76450e652d28563b859136624357a54286a847abe4c2",
      "en": "「Idiot! Did you think I'd gratefully\\nreceive your divine oracle?!」"
    },
    "336:19450": {
      "repository_source_sha256": "0bc33b5fd4f58aef482b647b7d703e44c411bda7967799ca1e6f205b3c2607dd",
      "en": "「They claim to be emissaries of God.」"
    },
    "336:19485": {
      "repository_source_sha256": "a770208d2496e49a31d6d0df3d4d9e22a58ca9bba8ef9017fb0605e8a6100437",
      "en": "「We'll fiercely resist your judgment!」"
    },
    "336:19524": {
      "repository_source_sha256": "b8a1e20e0a8b57f3aeca2a4b462c742d696f8f7bb1dde7c51867e47727b1f620",
      "en": "「I'll play with you!\\nUntil you cry and beg forgiveness!」"
    },
    "336:19581": {
      "repository_source_sha256": "677d88ab33c0e1e496f7da3ec56efb618bd4dc35bc23f0b6778c3c356a4da135",
      "en": "「Pay for betrayal with your own body!」"
    },
    "336:19616": {
      "repository_source_sha256": "72bd23b27b8bac6b6df1ee00907a86ab81a924c0729a2c4b84e1995244ae8cae",
      "en": "「I won't amuse you any longer!」"
    },
    "336:19659": {
      "repository_source_sha256": "c320a2acce5ff4f3a424e9ddb8fe6a9da4c221753888d87a8313ea723c868b6a",
      "en": "「From now on, you'll be wiped out\\nby the inferior Earthling race!」"
    },
    "336:19712": {
      "repository_source_sha256": "cba859fcad7a5157fbd9009cfa960f42895ff49fd1223e06aacd0d962ad189fd",
      "en": "「Hurry up, tuck your tail and\\ngo call your $$御使い$$s!」"
    },
    "336:19767": {
      "repository_source_sha256": "19ad2c8de98cc6faa509c5cb13e553fb156cb3c6e2cee263bb7426b1ff58c816",
      "en": "「$$アドヴェント#pilot$$!\\nYou're history's worst hypocrite!」"
    },
    "336:19820": {
      "repository_source_sha256": "c1b8ecc239b6f0d528d4c16cace3cca1968059e9b3bfba90e2a6c4f0154fd8b8",
      "en": "「I'm keeping $$千鳥$$ waiting.\\nGet out of my way, now!」"
    },
    "336:19875": {
      "repository_source_sha256": "b00dd72fe5bf10fe954935820408a69a517515f0201fe9e87a23333fbb6ecefa",
      "en": "「Okay, let's scrap it in 5 minutes!」"
    },
    "336:19910": {
      "repository_source_sha256": "6af78bd7b293aa72849a418165ad0e5b50ae266be12232047c788c07a6c18a3e",
      "en": "「Exactly! Let's go, partner!」"
    },
    "336:19943": {
      "repository_source_sha256": "19c3fee418e002d0c1fa8df6d352e2090189d436f6b3d667f974775ee360584a",
      "en": "「Don't say I don't get a turn!」"
    },
    "336:19980": {
      "repository_source_sha256": "394720d12484a5ff67c0c7cd1c4c86668f8c2986f594c1b9b5c7127836cbd44f",
      "en": "「This is what you get for dawdling!」"
    },
    "336:20021": {
      "repository_source_sha256": "2c4142faf983719e6512ee83d63c5edbaf533794b295f89de6092c7ec7d29dab",
      "en": "「I'll take my revenge in full!」"
    },
    "336:20054": {
      "repository_source_sha256": "3d1b65fae32f157784495cd8eb090bb3f2d163e5a80e826a99f575797520d54a",
      "en": "「Don't think you can shake me off!」"
    }
  },

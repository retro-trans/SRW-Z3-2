{
  "schema": 1,
  "rows": {
    "336:20089": {
      "repository_source_sha256": "b32ab0ed65a1d0fcf025adfe78104448cf23e37007c140199d7d266599fdf340",
      "en": "「Now I'll take care of you!」"
    },
    "336:20120": {
      "repository_source_sha256": "c1e3ab328a74c934118aa646f966bb942184cd4370570babe3231da7dbdd535a",
      "en": "「Roles reversed! This is payback!」"
    },
    "336:12825": {
      "repository_source_sha256": "078200c974663f19196c7b759caa59528b93bdc88320ee8d576e454e0259e5b5",
      "en": "「Impressive, $$チェインバー#pilot$$.」"
    },
    "336:20159": {
      "repository_source_sha256": "d1f8caf2bf4352f9ca4b79a49f2e47e7d80b56b3c0d788809098dd780b43b8fe",
      "en": "「I'll take the rest of the feast!」"
    },
    "336:20196": {
      "repository_source_sha256": "b5b43b304a3555c47e769e6276a03c1dbc69b4702eb65c08d83ff2b626e8ffac",
      "en": "「Let's team up, $$レド$$!」"
    },
    "336:20221": {
      "repository_source_sha256": "5403463414552771612f67521d35bd0bba00c3785a74de54f4f86bd21bf304f2",
      "en": "「I'll back up our ally!」"
    },
    "336:20246": {
      "repository_source_sha256": "b8cc4371e4fa14e01b5fcd53e6fbda5acc1e4d1e0a57fef14df0f6d06d1d304f",
      "en": "「I'll follow your friend's lead!」"
    },
    "336:20467": {
      "repository_source_sha256": "37142b0dfe5275784a01adbd36fdd045f652ace4a4c5dfb9f09e8dbc1641778c",
      "en": "「I'll do my job right!」"
    },
    "336:20500": {
      "repository_source_sha256": "0087e9f07d6115a34c72be273f1bfbedadf5dfa55c5534dcb2024d52c49c3b94",
      "en": "「I'll leave the rest to you!」"
    },
    "336:20519": {
      "repository_source_sha256": "d3939b6a331de53191cfe506790799c412f901f942282f6878f22853f17c7db5",
      "en": "「Strike in five seconds!」"
    },
    "336:20405": {
      "repository_source_sha256": "64382c3096d82eea58ed8a2bfda8fe7a96f04ba28f0183546ab275505937f13b",
      "en": "「Trusted with this, I'll deliver!」"
    },
    "336:13653": {
      "repository_source_sha256": "838f4724d91ab13ca0665001baa35a0fdbc3f2847660ff3278fc5fcf493b625e",
      "en": "「Your decision, Sergeant.」"
    },
    "336:22718": {
      "repository_source_sha256": "abe3d78d8cec0cf8d75b2fd1ccf5b5a4995e09a18af16c1f9d8096a15897b1e8",
      "en": "「$$ウルズ$$ 7, withdrawing from the front!」"
    },
    "336:22749": {
      "repository_source_sha256": "b84470f8570b4254c2eec2c7dc1c1b491bb7ad4dc299fa996d7ddc4efaef38d7",
      "en": "「Sorry, $$ナミ$$...!」"
    },
    "336:22770": {
      "repository_source_sha256": "b84807609b77ec7ae25b81229ca502b94addccdcfb01fc21e449990b6203d4e2",
      "en": "「And she's right there...!」"
    },
    "336:22809": {
      "repository_source_sha256": "b9f61130b5a48f45c2d5ce9195afd22676660eed2469da6bd1119eb6689d87be",
      "en": "「Sorry, $$千鳥$$...!」"
    },
    "336:22830": {
      "repository_source_sha256": "3b986bdcd965f63e24c514e10677555bc4550b4a7811fc531392a7a18b5cc57a",
      "en": "「...Retreating.」"
    },
    "336:7948": {
      "repository_source_sha256": "3963432a6fc9f9e4a91fae90bdefe298ef2efacf657bfd6cec50048c3c416940",
      "en": "「That AS...! It's strong!」"
    },
    "336:7973": {
      "repository_source_sha256": "6f57d56a342fc2e785d4892c31dc6ee7e056677b1c15ec321f17dc4ac6eb305d",
      "en": "「What's wrong?!\\nThis won't kill me!」"
    },
    "336:13443": {
      "repository_source_sha256": "c4c40f36c8c462688d58f8168274cf6f5e7bd46ea44838e4a88751303b9e4587",
      "en": "「Prioritizing combat maneuvers,\\nAML will go dormant.」"
    },
    "336:13496": {
      "repository_source_sha256": "d0b14ae8f94d3aab08ad3fe983300c3c51dd7fd1ee29c3925bf9bb5b189acaed",
      "en": "「Extremely dangerous situation.」"
    },
    "336:13521": {
      "repository_source_sha256": "637bcbf5f4aab2acf7cd377c0b6c5018a4beeaca044f184ba24965efd1fbdc5f",
      "en": "「Recommend stopping combat moves now.」"
    },
    "336:13550": {
      "repository_source_sha256": "899c7aa0a31019ae3f51b93a0461f4298c8bd98be06ba89c58c06524448b53b9",
      "en": "「At this rate, the unit falls apart.」"
    },
    "336:13591": {
      "repository_source_sha256": "fcb4cdd8d02c50a6842d77688bbdf0fd53abd6bf1290aea20862b95f498c4ead",
      "en": "「One more is the limit, Sergeant.」"
    },
    "336:13620": {
      "repository_source_sha256": "4807be9133fabbe220c0d6f0006e49bb04407bb1310f042660dce56f0fc8e5dc",
      "en": "「Understood. I'll do what I can.」"
    },
    "336:22117": {
      "repository_source_sha256": "426ae3f258416e69f6b035f0e64ae200eb877bd17dbdb16099a9b93a2d579e47",
      "en": "「I'll survive...! No matter what!」"
    },
    "336:22156": {
      "repository_source_sha256": "8b76b4c9358fb2d4566e4b4a72bf0deb2736087ef96411c919fb48ab144f8bbc",
      "en": "「Serious damage to\\nthe Muscle Package?!」"
    },
    "336:22209": {
      "repository_source_sha256": "1b01ef513b564308218c5cb309f44824b83cc26a6620bf0ef89adf6b50871f77",
      "en": "「Whatever the situation,\\nI'll do all I can!」"
    },
    "336:22264": {
      "repository_source_sha256": "b70914c221425e737c03097bd82dfff0a877f3a1159d75f1a41b7ceeb6c628de",
      "en": "「Survival is a soldier's duty! Fight!」"
    },
    "336:22307": {
      "repository_source_sha256": "ce4ab46d5fc7856bdb38ffce27b50509959a2ec32aab164adc97275d14a922ac",
      "en": "「Control systems are shredded...!」"
    },
    "336:22344": {
      "repository_source_sha256": "d985c11eb9289ba6535723ad94719a9767e1ef834a291b14fedf6672f07ac2e2",
      "en": "「Hydraulics losing power?\\nAt a time like this...!」"
    },
    "336:22395": {
      "repository_source_sha256": "d81c6eb3b10456c3f64a96e87c22d78f4f9dd6cd1e774e21e7a6986ea5ad7134",
      "en": "「Not yet! This junker still moves!」"
    },
    "336:22434": {
      "repository_source_sha256": "1965dd9b8d2e5a671f906838b6c25fcc1547fa3787573b9d438ca1136ed79ff6",
      "en": "「I can't die before I get her back!」"
    },
    "336:22471": {
      "repository_source_sha256": "5b009e6aaf744fa082f1c076c54434fab7ad37a8ec2dcf383fba29fd49446699",
      "en": "「I promised to bring her back!\\nNot here...!」"
    },
    "336:22524": {
      "repository_source_sha256": "e04f7e8271b5224f6a98ddcf8500b3b37f04997a3bb4efd47f55b5dc753bf803",
      "en": "「Damage to the left thigh...!」"
    },
    "336:22553": {
      "repository_source_sha256": "b5d36c69c97d62e19bda637a557166aa4bee90abd181869b344a0283e7bf4cb4",
      "en": "「Make it work somehow!」"
    },
    "336:22584": {
      "repository_source_sha256": "79c80ef085f01d9adf478de3f2507f244fc88ae390d59938871d9cf30eb5be73",
      "en": "「You're still no good at jokes...!」"
    },
    "336:22625": {
      "repository_source_sha256": "c94e9210feb34f197661ae7d1ff4b9025864b2811018a4e93cbd269623054dfe",
      "en": "「Then pray the next round misses!」"
    },
    "336:22664": {
      "repository_source_sha256": "9f7c964961fcf7b4daaf4609f6d35b05f4752e8c55237e25cd033ddb466285c5",
      "en": "「One more time is all I need!」"
    },
    "336:22693": {
      "repository_source_sha256": "d54b394b39fab3a4725f3731deb1cce71df1f6e2f68141b8ad2977719a0ef62f",
      "en": "「Show me you can hold out!」"
    },
    "336:13358": {
      "repository_source_sha256": "24399d37e45541be6cc4e78cf85061a42834fd7b433a2a5e3eba0dd8b3b4a4d6",
      "en": "「ADC and AML activated.」"
    },
    "336:13385": {
      "repository_source_sha256": "f35d1b052bd9c9109a23ecaebb9f488a839d3ba4773e768817eb66e04b276374",
      "en": "「Situation unfavorable.」"
    },
    "336:13400": {
      "repository_source_sha256": "b0dd20c974366ce8d436bea93948685461e3059fdd47269e360a4e25a2b10568",
      "en": "「Then let's hustle, not be outdone.」"
    },
    "336:21719": {
      "repository_source_sha256": "69df05acaf780c2a4d7b9035101e3d3cd83e82143273dbbe9ac2c2e2d954b448",
      "en": "「Getting one over on me\\nis quite something...!」"
    },
    "336:21768": {
      "repository_source_sha256": "5690b3263dbcf58bed497c7f12482b7c135f77e2eef201947f3ec977b69f7bb1",
      "en": "「Guh...!\\nDid I overtrust the $$ラムダ・ドライバ$$?!」"
    },
    "336:21817": {
      "repository_source_sha256": "7d0d7e3591b4733a4646bbc9664768587a8b4fb7fee4ce37512f0064ce1751ec",
      "en": "「Damn it!\\nFalling for a feint is pathetic!」"
    },
    "336:21872": {
      "repository_source_sha256": "85745e01a4223f93898f8918756368d9c251316012a647e5775348d4d736270e",
      "en": "「An enemy who catches every slip...!」"
    },
    "336:21913": {
      "repository_source_sha256": "afe7a760c4dad9b543097216cde2ef0bd7000676a71b1470d22fd12706df6d74",
      "en": "「This is where this machine shines!」"
    },
    "336:21950": {
      "repository_source_sha256": "2ba32d809900453c995549c23f5db4f925174a64b4db44960ce3cbb6eedc38d8",
      "en": "「As long as the system's alive,\\nthere's a way!」"
    },
    "336:22001": {
      "repository_source_sha256": "d61048c0c5ce434337ed3f46683ba2911e2db4eaa3fd12a447b8356a2f549826",
      "en": "「Damn! The monitor's half dead...!」"
    },
    "336:22042": {
      "repository_source_sha256": "16c7bc64d2b3a3a66311c86b019cb0796b8a4b53b388050042ad7fc449a2c960",
      "en": "「Forget protecting the damaged part!」"
    },
    "336:22071": {
      "repository_source_sha256": "221179969d77f8c32b6588fa7649dfeba35781bee20196811448c2ba610fd25d",
      "en": "「I know!」"
    },
    "336:22088": {
      "repository_source_sha256": "3f9ed4f531b0600120a3d7c77e88b61f5e6115f5dbf964b03c21a95b66332960",
      "en": "「So you're plenty motivated.」"
    },
    "336:6829": {
      "repository_source_sha256": "cf2a4ed5cf0172c22ea95b1277af386dcdfc4758c103cf503e3ec6c74c847de9",
      "en": "「That AS is all looks, no bite!」"
    },
    "336:6858": {
      "repository_source_sha256": "ea69275759e8383acfda3e4fe3bc81b887c5c47f01e801f9c8b9104a578f0058",
      "en": "「I can't lose to you, of all people!」"
    },
    "336:13206": {
      "repository_source_sha256": "676fd627645b3848cf3b5d0c21ea620a7d0f886385eb6bbd0f83bd03171fb5c3",
      "en": "「I'm rather underwhelmed.」"
    },
    "336:13235": {
      "repository_source_sha256": "73f88666a206d7970cf2e9c15f56c9bdabc1a0d5dea9ae432f9f14e683add04f",
      "en": "「Is this what they call a joke?」"
    },
    "336:13278": {
      "repository_source_sha256": "9ab7da8add58d319f467e082658b5a79cd7d4b2736afbc1fc74ff3714b1676bf",
      "en": "「Ah, the 'not worth my time' kind.」"
    },
    "336:13319": {
      "repository_source_sha256": "016b0139595e46787c39fce6bc1864a74afb64740bc8fa74991e06c8646c77df",
      "en": "「The new armor is scratched already.」"
    },
    "336:21308": {
      "repository_source_sha256": "dcbb66fced038079acf8634d817ccb25e4e9c69d597c2e97f725e892dbddc9b5",
      "en": "「What's wrong, is this your best?!」"
    },
    "336:21343": {
      "repository_source_sha256": "6e061878126428fb8afd563a3dda783da5f89b1f763fd7f197d6813d59be0bf6",
      "en": "「This won't even slow me down!」"
    },
    "336:21376": {
      "repository_source_sha256": "c6280c997a70eeb262010eac8d5c85689d7a946f66e2da97e3422d3d6c42c377",
      "en": "「No problem if I avoid direct hits!」"
    },
    "336:21411": {
      "repository_source_sha256": "17b152e37cccb92796166c0768eaca7c21b4456f1f40acbb741a2d869abfb6c6",
      "en": "「Not enough guts! Come back stronger!」"
    },
    "336:21448": {
      "repository_source_sha256": "2738dd6763e3de5014d1a1feead7e9764aa78b751eff7d29cb61196b1e71cc1e",
      "en": "「Simple, yet tough...!\\nThat's this $$サベージ$$!」"
    },
    "336:21505": {
      "repository_source_sha256": "09e47c8031933074f44933e8bfe2f59e084158b30003eb070911c9c2c34a3bf2",
      "en": "「As expected of one of the greatest\\nArm Slaves ever built.」"
    },
    "336:21556": {
      "repository_source_sha256": "9a9b3dd919e76a8dd597d4861cf6d59fd61caa9e10901a744a189de7a7307425",
      "en": "「Got your habits. I'll dodge next!」"
    },
    "336:21593": {
      "repository_source_sha256": "2a7948265b3843030ca3ad7fc4eb9c4d302dede3fd5f83e82267aa5bf216f653",
      "en": "「Agreed.」"
    },
    "336:21604": {
      "repository_source_sha256": "ce87a4c1580d41e03248e72c21fce66b7f6fc709c7ae7ac46357bcecf7baca0d",
      "en": "「If so, all it gets is a sneer.」"
    },
    "336:21635": {
      "repository_source_sha256": "0daeebd2233482ff124a8aa87d95c2f8185e66d119c2d7e460e96c8cfba9d171",
      "en": "「Don't say that. Fight them all out.」"
    },
    "336:21670": {
      "repository_source_sha256": "62e1a385780264d1995ca41064393ed5d4fe3630ef3c3f7582f1d2e66a4b12f6",
      "en": "「Men, soldiers, and weapons alike,\\nlooks don't decide their worth.」"
    },
    "336:12965": {
      "repository_source_sha256": "0dc670e48c8a2101ec832795ccaec7e6847b9dc46c93cc679081a9978f24e22c",
      "en": "「No damage to the unit detected,\\nmain capacitor voltage stable too.」"
    },
    "336:13022": {
      "repository_source_sha256": "e748669f0884ebdf16140f5f970866308044fb24bd3e551a59f22f6eaaf701d1",
      "en": "「Roger.」"
    },
    "336:13035": {
      "repository_source_sha256": "b9eabbbd3f0caf4f25ed0852c73d469c2e79d53c1d9ae411b756272dd192530b",
      "en": "「I did not expect to dodge\\nin this manner.」"
    },
    "336:13084": {
      "repository_source_sha256": "1443d5fcb5fe7f886f144853955a66e9d077b3e266396985a748758eec71fe16",
      "en": "「Evasion successful. Orders?」"
    },
    "336:13105": {
      "repository_source_sha256": "4b57b57c43af4a79d613d878c43a0055e85769314bb36a69759ddc70059d1822",
      "en": "「No such equipment exists.」"
    },
    "336:13138": {
      "repository_source_sha256": "e792757af877db4d1d1b406ce28c2dddc6aa3da13cc69c16b24d85421c91cefc",
      "en": "「How do you like the new unit?」"
    },
    "336:20682": {
      "repository_source_sha256": "708ef895ca6e8b56b5b07f7f3f47d5d8d4c30239947ef2b38b8a8398b77112c4",
      "en": "「Are you blind?」"
    },
    "336:20705": {
      "repository_source_sha256": "d8db776c923cddd0e6afdd8f83d65d79d4e484efb90f3f3b4d336c57df31c3b2",
      "en": "「A fitting attack for trash like you.」"
    },
    "336:20734": {
      "repository_source_sha256": "ad06a2ef1e64abf6577c0ea57f63fd4b90e224e6180bd597f2d7737fb61c57bf",
      "en": "「Small fry can only do so much!」"
    },
    "336:20777": {
      "repository_source_sha256": "ffd84aefe072033e28255506a1fc3fd368b2483af0964161e809d9254f676649",
      "en": "「Go home and let Mommy comfort you!」"
    }
  },

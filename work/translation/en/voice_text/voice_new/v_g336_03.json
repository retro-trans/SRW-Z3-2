    "336:13697": {
      "repository_source_sha256": "5c866e8fce2b52a6f5a0f8438bbab3218208f3d276ba624fca97f2972180929b",
      "en": "「Affirmative. But I'm ARX-8 $$レーバテイン$$.」"
    },
    "336:13754": {
      "repository_source_sha256": "0b85e6d1aa6353a5b791be67c9fa1db9e3d808e7747f2bf2eb2049a7e0df4867",
      "en": "「Sergeant $$相良$$. Request permission for your return to war.」"
    },
    "336:13805": {
      "repository_source_sha256": "4950380e8766cbda067b9d6d08b8e27813dbac674d32aa63455dbed3fc6f8ae4",
      "en": "「Before I try it, I want to ask.」"
    },
    "336:13838": {
      "repository_source_sha256": "d2eb72d850a6533f306d880e3afd4221081e73109cadcc658dcb4fe41bcfb6d8",
      "en": "「Am I human, or a machine?」"
    },
    "336:13871": {
      "repository_source_sha256": "a1a5b712b38be885ee473f7349d178c5080be95ebd615fb45a299579c9a289ea",
      "en": "「Thank you.」"
    },
    "336:13886": {
      "repository_source_sha256": "3c997073028b97dde6e03c6ff3c55d57e5b77b01eccd301e07889e8c35131c8f",
      "en": "「I'll try it on my own.」"
    },
    "336:14338": {
      "repository_source_sha256": "12b09b29e9d39702be35e9cafeb8baee9d371b6fd6b44dfe64aa2e2539de28c8",
      "en": "「$$宗介$$... I love you.」"
    },
    "336:14363": {
      "repository_source_sha256": "00a75d3cd4c904ffadb1c93ddd82389d53ad2a84d8576ab81cfd2dfb0baf3de9",

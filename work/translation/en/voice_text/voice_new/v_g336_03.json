      "repository_source_sha256": "9e78cc12e4f855d935d6ad8ffc594422863db3ac65298c9fdd436c40528a278a",
      "en": "「Of course. Permission granted.」"
    },
    "336:25059": {
      "repository_source_sha256": "dacec18c9c92f3ed23b4c8d144f6b8c6e2ebc5aa9f5e3d0fb923cb5cdb149764",
      "en": "「Me too. I love you.」"
    },
    "336:25080": {
      "repository_source_sha256": "76cde5ac5f7780a87b1cdc1cd7e40e7b888ba764fde277e11e97cc2c56a65433",
      "en": "「Yeah. I promise.」"
    },
    "336:25099": {
      "repository_source_sha256": "0491c7af42f29a61c65912ab0236d6715aaeafc78565364755016580af1e12b9",
      "en": "「It's fine. I'll catch you for sure.」"
    },
    "336:25128": {

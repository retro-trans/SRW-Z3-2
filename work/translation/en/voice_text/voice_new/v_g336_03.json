    },
    "336:14380": {
      "repository_source_sha256": "11481a209ac3e80b8a2c78f2a55abc8482b36d5994a2f498c5b8dc1ac3497de8",
      "en": "「When we meet again, let's kiss for sure.」"
    },
    "336:14427": {
      "repository_source_sha256": "abbc2b7b48c62f8cc5f3d23235e0b8fa6714f6c29124abf41d7166dee14f7187",
      "en": "「A big one. Anywhere. Okay? Promise?」"
    },
    "336:14476": {
      "repository_source_sha256": "1b5f63c9bea2246a94d2a3beb104939240ab6049b8f525085e7f999409acbcc5",
      "en": "「I'll wait years, even centuries...」"
    },
    "336:14515": {
      "repository_source_sha256": "5bca4f65f8aca5d404979056b23a322785caef1aa1be9581dcfb83ae8e5fe26b",
      "en": "「...Don't let go, okay?」"
    },
    "336:14536": {
      "repository_source_sha256": "8311a6db4c9b0c411a0f14aa3e4c619e426181af5997ea84f43ec0e6496d0dc6",
      "en": "「Stay... by my side forever.」"
    },
    "336:25015": {
      "repository_source_sha256": "2aa98999168ba6af7bbc8e5278ba19ad55785612a079c7201dc4181db3cc9077",
      "en": "「...Is that you, $$アル$$?」"
    },

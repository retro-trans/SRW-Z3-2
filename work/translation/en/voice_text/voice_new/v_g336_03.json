    },
    "336:25205": {
      "repository_source_sha256": "e41b77b52dd8598f05721cb45b0f0ab2c13f0b76ebc956dbe340d8c852e7e209",
      "en": "「Yeah.」"
    },
    "336:25214": {
      "repository_source_sha256": "31c7c8f5cb48fede235c890ee5d18d3cc21796cca6ead31b6bfcdc920c3879bd",
      "en": "「Of course.」"
    },
    "336:25229": {
      "repository_source_sha256": "a9edd375c9326fe97eb047b8860d78cd403a3a75e8a1b5687bdc28782cc7df7a",
      "en": "「With you here, I need no weapons.」"
    },
    "336:8811": {
      "repository_source_sha256": "6f0812eeed7bc4d87ddd90d3c72e382d7ad769e072b5000aafece626c589ed14",

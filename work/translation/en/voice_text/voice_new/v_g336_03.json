      "repository_source_sha256": "dd821aef154c7022622a9a0bf85d9c0d57acff320571b838c933113f04dda2e2",
      "en": "「Sergeant, an ally is in danger.」"
    },
    "336:20271": {
      "repository_source_sha256": "df2611dd979483a12104e7719034d1a9227307d0f016fe4db576c5ed4bf75d28",
      "en": "「I won't let you do it!」"
    },
    "336:20300": {
      "repository_source_sha256": "e524fa7ec511e0c9731ba549b9a9c096e5f4fdb55b828e251d7c04a517e7730f",
      "en": "「Losing our president is a Volunteer Club loss!」"
    },
    "336:20343": {
      "repository_source_sha256": "601cad51967fde13220abf425183402dacdd95bbeea40b22d38ef1832f12044e",
      "en": "「$$レド$$! Pull $$チェインバー#robot$$ back!」"
    },
    "336:20382": {
      "repository_source_sha256": "d6f87811ba5d751fc1b301bfdc5fce4de709a0fe7a6e988dbfcbd2007fa703c8",
      "en": "「We'll be your shield!」"
    },

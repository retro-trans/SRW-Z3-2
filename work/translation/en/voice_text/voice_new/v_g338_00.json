{
  "schema": 1,
  "rows": {
    "338:0": {
      "repository_source_sha256": "242cdf6273e98805e260d26a3aaa5f3fb9b2ff0206ae9b03f1c935f1e36ea9f0",
      "en": "「I relay the words of God's emissary」"
    },
    "338:29": {
      "repository_source_sha256": "304952cdb37dbb371937da115f926b436440db36b5abc431889f6c0d60e56120",
      "en": "「We are the chosen people...」"
    },
    "338:52": {
      "repository_source_sha256": "16c52e4ad82e362007106d85604f05c38f1484cb9a3561cd769505153855d038",
      "en": "「Rejecters of salvation get no mercy」"
    },
    "338:87": {
      "repository_source_sha256": "bd0c5f2fd1a795c5fea18e669b1d6d014c7af1104ec71c2a64b9aade01247788",
      "en": "「I carry out the sentence」"
    },
    "338:104": {
      "repository_source_sha256": "26fa7286b3582f530c5564a565cb167ac069e051342de0dfede3c773f6da87ca",
      "en": "「Know your sins are your own doing」"
    },
    "338:135": {
      "repository_source_sha256": "0a3c8e3b36c11ca05f1a14c8161ef641dddf1ae8f81fea8c0ccba8376e20b1a9",
      "en": "「Sinful ones... Your name is Earthling」"
    },
    "338:164": {
      "repository_source_sha256": "ffb5c15897f9e26c268306353a4be05e341c1edcaa1d6a9919a3c136a20e56f4",
      "en": "「Divine punishment upon the foolish sinners...」"
    },
    "338:189": {
      "repository_source_sha256": "47d764a5c583590a48f077083219a0802ec90e2f1de2d752f632fcf51995d189",
      "en": "「We are the $$真徒$$s... Executors of God's will...」"
    },
    "338:226": {
      "repository_source_sha256": "29dc34707e46da71b15c692bedf5d33e7713e007bad2933233323b17d7c2450f",
      "en": "「We are the guardians of the law...!」"
    },
    "338:253": {
      "repository_source_sha256": "4cee3e2c9da8c399db781c194bc85d007c96c7f28beed7d3e86f948d3f78810b",
      "en": "「You are not permitted $$シンカ$$」"
    },
    "338:282": {
      "repository_source_sha256": "ad279624a90980b023ebd03f2f55e56c89637a060c1ef139c54253232e86e947",
      "en": "「The Exalted Ones decide your future」"
    },
    "338:319": {
      "repository_source_sha256": "6fd2b2a933938ec3c74a6bb98547daa463cdbcc311b24831e51e69293f158b3d",
      "en": "「You hopelessly foolish lot...!」"
    },
    "338:352": {
      "repository_source_sha256": "4d755e5d7242126bcb1384b07ebb8f3e1703b96708deda5e489e3b4cdeb1aefb",
      "en": "「You fool, defying fate」"
    },
    "338:379": {
      "repository_source_sha256": "410e84638b1ca63cf51f1e40b577fe525632f930954fa6a4aa4cec12b109a340",
      "en": "「The chosen purge the unchosen」"
    },
    "338:418": {
      "repository_source_sha256": "b79f41a76bd4cdef8e66a072d2b77c9ae2b2d57abdbdf64c8bb33b0f1dacf039",
      "en": "「Foreign matter upsetting cosmic peace」"
    },
    "338:447": {
      "repository_source_sha256": "687fa6529fc726be916b92db41d0d79134c5bac3d69a43542dba292af232d388",
      "en": "「This is the universe of the gods」"
    },
    "338:476": {
      "repository_source_sha256": "6f1e8e6628da20dca731955f231e1dafc432e42e7bfe47df48a7a0339f29339f",
      "en": "「Insolent wretch, trampling into the\\nuniverse where the gods dwell」"
    },
    "338:527": {
      "repository_source_sha256": "68904a0f1b9f92eef241aed1ef58a993da811e6cb4fca676f333137640ce5422",
      "en": "「We stand far above you」"
    },
    "338:562": {
      "repository_source_sha256": "5e051830819d094437b92d23473ddaa3c6ed3f10f79af00bfa4eca4cda0e66d1",
      "en": "「Take it as mercy. Perish here」"
    },
    "338:597": {
      "repository_source_sha256": "03de71a74d69ebec9ddf8ca3115073ae7f6400ce9c911a13449df82d03d45522",
      "en": "「No need to trouble the Exalted Ones」"
    },
    "338:638": {
      "repository_source_sha256": "0016b0eb705322c4be3c69debb69b8a011cff7087a8a4d50d37a0af88a0952ab",
      "en": "「Behold the power the Exalted Ones gave」"
    },
    "338:675": {
      "repository_source_sha256": "d05f8c56cd07baec626cb050ccd4354bd9c8aba31aa44549d76230eeca370b0e",
      "en": "「This radiance will purge your evil」"
    },
    "338:712": {
      "repository_source_sha256": "324adca2337d49eed718a1762821e9fa8f6c8c30f8a7c0d36d2df5ea60ca455d",
      "en": "「This proves the Exalted Ones' power...!」"
    },
    "338:747": {
      "repository_source_sha256": "3710d60313b52a6810ff685581a839d27cade36fc120bfe43e38223b36e05d4e",
      "en": "「Proof we received God's love...!」"
    },
    "338:1257": {
      "repository_source_sha256": "6818a75494c675ab03b6aefd8816494bcdad88772d5b5434f353ca7baf3f7d57",
      "en": "「Human-made inorganic constructs\\nare nothing to us!」"
    },
    "338:1308": {
      "repository_source_sha256": "631cb37e6cfe581e595904991ea15cf32f8b9c7610a0cdef541323e7b32f133a",
      "en": "「Don't think tools made by foolish\\nhumans can beat us!」"
    },
    "338:1361": {
      "repository_source_sha256": "9746165de0bc23ce5030a965aabb0c0124ba82ad657f3b38382f4b035f18bb01",
      "en": "「Human wit is futile before divine power!」"
    },
    "338:1404": {
      "repository_source_sha256": "a530b030d827860f27bb55e65e8f5e9bf2510e84d0bf096325a5eefe907476fe",
      "en": "「A product of fire's civilization, a Gundam!」"
    },
    "338:1437": {
      "repository_source_sha256": "76c7a9d567c20223840f60892dbd393a9e241c8a38892771f7773512f946322f",
      "en": "「The tool leading humanity to $$シンカ$$!」"
    },
    "338:1472": {
      "repository_source_sha256": "677c54be235907e5afd7e1ecf4998923f6e9113a6eea481b3ccd1a7ad311b2f5",
      "en": "「$$ガンダム$$!\\nA beacon existing across parallel worlds!」"
    },
    "338:1523": {
      "repository_source_sha256": "99b55815cca8bccf8047d625a6d1e2ce24d835c99989f1d6af278fd474897f3f",
      "en": "「I'll destroy the Gundams of all worlds!」"
    },
    "338:1560": {
      "repository_source_sha256": "fc4c566e4e7e104a8460857b9e634825757494bbdd150146a0eaec82d30e4e77",
      "en": "「You may go no further\\ndown the path of $$シンカ$$!」"
    },
    "338:1609": {
      "repository_source_sha256": "dca536885e14ede8cccb47943731ea77de3f1f750e93c60793790ca6325a5763",
      "en": "「Your evolution is merely\\nthe doorway to $$シンカ$$!」"
    },
    "338:1662": {
      "repository_source_sha256": "8b4da0b1955f9decea4e42707e1c00cb77713bec00caf9c878ed85f2aafe6ac7",
      "en": "「Are they to be humanity's forerunners?!」"
    },
    "338:1703": {
      "repository_source_sha256": "10e1e2bcfc878b53eaa0024cebd93216614dac234e3abcbabaeb39690a7e69f5",
      "en": "「Gods and humans need no dialogue!」"
    },
    "338:1742": {
      "repository_source_sha256": "231eaed3beb58a8d65d406dd1700e580bc6d19d38579c0659d9aa4919dc41ba6",
      "en": "「These too are sprouts of evolution...\\nNo, bearers of the seed!」"
    },
    "338:1793": {
      "repository_source_sha256": "2311f1b96e36b1c5173277adea0990de3fdb996305514877193dc7cefa8961b7",
      "en": "「Too weak to be a mechanical supergod!」"
    },
    "338:1830": {
      "repository_source_sha256": "aa8e1281fd7340c6f6b8d0f7f59b7404adeb6e22c4699a7799fad8ec39dfc48a",
      "en": "「Still just a human-made machine god!」"
    },
    "338:1865": {
      "repository_source_sha256": "9b1d99d8fa3a556eae09c3fb2e73028431d97de993eb9fe4d879b8128b765fa8",
      "en": "「Whatever feelings you pour in,\\nhuman civilization can't beat us!」"
    },
    "338:1930": {
      "repository_source_sha256": "ed92c4d5c6c2ccaacf08a4df722ecdbd09ff20a259dbffd6733ecd4f66fee7de",
      "en": "「A Demon God of Light can't match a true god!」"
    },
    "338:1971": {
      "repository_source_sha256": "7ffbdfd19c2ba9a730e25f0a179a698edc8c5395d2e4180c6944565c999be8ea",
      "en": "「Evolution through $$ゲッター線$$\\ncannot be accepted!」"
    },
    "338:2028": {
      "repository_source_sha256": "04692270ce2b2700badc9f54a812bdd26ff76ae3293cc0c01161f6e0f598ec07",
      "en": "「I'll sever the bud of possibility\\nhidden in the child here!」"
    },
    "338:2079": {
      "repository_source_sha256": "16267cca7f5ecdf87142a6da9f407533a93227382a39154816f1e5bdcff9dc3e",
      "en": "「Cower, child!\\nWe embody the will of God!」"
    },
    "338:2134": {
      "repository_source_sha256": "38886ffedfb007806ba46e4fa884e7d91aec492b0ebfb551332bc80a9982c89f",
      "en": "「Only the Exalted Ones may\\nraise the sun aloft!」"
    },
    "338:2189": {
      "repository_source_sha256": "16ac989349a580e51cb071955b3502b0ca94de4c84d10e96229e06f17e443b86",
      "en": "「Even the moonlight that lights\\nthe dark is denied to you!」"
    },
    "338:2240": {
      "repository_source_sha256": "ce0ea7237851417484fb16fec23b7ae2581a06863d607f6cf3544581942649a9",
      "en": "「Twin factors of light and dark end here!」"
    },
    "338:2279": {
      "repository_source_sha256": "13809d83678aaec9756fd7d1240df97966daaa1e14101c4b2b38638e347b3ef6",
      "en": "「Love has no power in this universe!」"
    },
    "338:2320": {
      "repository_source_sha256": "dd08819edd7ec800484d67f1d821b7194f6ff513ebfb612160b91716d606853c",
      "en": "「Shed all the blood of the beast here!」"
    },
    "338:2359": {
      "repository_source_sha256": "135f556ef076cda53e4245259dd3a6b7340afdab047347ac4e8a6fe9528c19d3",
      "en": "「Truly the one best suited to the words\\n'doesn't know their place'!」"
    },
    "338:2410": {
      "repository_source_sha256": "e678d44cbb0b0280bdae5dd8086efae47e9e5efd8b5832cec90277126e4b2530",
      "en": "「God doesn't recognize anything born\\nof the mingling of waters!」"
    },
    "338:2463": {
      "repository_source_sha256": "f8205ab53d4246679157bd4d40326882a377c731ed2433f2088b178a7f1599b1",
      "en": "「Avenging the $$天翅$$s' regret is impossible!」"
    },
    "338:2506": {
      "repository_source_sha256": "08535bc68e0756bc343d080afaf2fffebc727856fd177d2c93fa47ffb8221a1a",
      "en": "「Mediator of the world! Hold your tongue!」"
    },
    "338:2545": {
      "repository_source_sha256": "ed716f81bcb8d5c3da35157b9ff8b0ef96d422e1b72fba3e08c746a4dfc5ada4",
      "en": "「Insolent fool who bends God's will!」"
    },
    "338:2578": {
      "repository_source_sha256": "a6346b8e277bf310a20a66b84a83e037f1f98e198b128d1a8bbdb46d4cafe49d",
      "en": "「Miracles don't happen! I won't allow them!」"
    },
    "338:2621": {
      "repository_source_sha256": "1ba25ad36127b2056849d44ca486f31d972eb0f50e53486d3c454ffdcb7a06ff",
      "en": "「You who felled $$バアル$$ end here too!」"
    },
    "338:2662": {
      "repository_source_sha256": "879d5b96fad0ef33201dade8d8ec0b079bdb483b8b3f290fb2db53afa8b77753",
      "en": "「The wind's destination is beyond the causal horizon!」"
    },
    "338:2697": {
      "repository_source_sha256": "2c733267de85643a8fe5af4130f65f2f5ecc5e2b1aa89e93a68c939eb087b7ed",
      "en": "「I'll break that drill with God's will!」"
    },
    "338:2730": {
      "repository_source_sha256": "1d55b33f2f188f091c880032b7868a5148827c4979476019b781ced7f5084e4c",
      "en": "「Power to alter the natural order ends here!」"
    },
    "338:2771": {
      "repository_source_sha256": "9501213bc8a21d3e0db7affc5687c8ef5db3c5b24bbb5732e126cbb59ffeb766",
      "en": "「Pay for trying to bend divine providence!」"
    },
    "338:2814": {
      "repository_source_sha256": "139a83d3d159f6c53361bb17656e203609fe3e3c0a720fee616a9e61c0d291c9",
      "en": "「That power is not permitted to humanity!」"
    },
    "338:2847": {
      "repository_source_sha256": "b34dd056d1cb7954696f35e2667114452edb5ad9b75388fae78729367616b0fe",
      "en": "「Don't think tools of human wars\\ncan work on us!」"
    },
    "338:2900": {
      "repository_source_sha256": "4d2e5dd927aae4a9f30bfefa1076049e143ff369a9974134b3c7206ec419685c",
      "en": "「Weapons symbolize immature humanity!」"
    },
    "338:2937": {
      "repository_source_sha256": "0cc4e2d8bfeb35ac5074799f2be2ee053d5bbce5cba2498ebebf38e0b12223a2",
      "en": "「A song...! Life's power surging forth!」"
    },
    "338:2980": {
      "repository_source_sha256": "c0700ae94e1b12998a7538d10b2b056b06b11982f0c43c09240d518de6d8d5ea",
      "en": "「Wings that carry feelings...\\nI'll tear them off!」"
    },
    "338:3029": {
      "repository_source_sha256": "979dea7c682be904a9af54fdfe2923187d4a5a242f3dea516cc3373bc23c8a60",
      "en": "「$$始原の特異点$$, die here!」"
    },
    "338:3070": {
      "repository_source_sha256": "6fbb1b05575a37d4e2f7ef5e681dcd0d01130e99ff68c5a4b130fabaeec45677",
      "en": "「Impossible...!\\nA being beyond our understanding exists!」"
    },
    "338:3121": {
      "repository_source_sha256": "8dfdd2b6c69100ec87584be279dc39dd47bc0810db36abbc9b3d686cede9c364",
      "en": "「Seeing that animal unsettles me!」"
    },
    "338:3154": {
      "repository_source_sha256": "ccd2d6a98df57a08820d5d36dc37e7b9b1adf9bc533957c7fdfc8cb21f9dc9f7",
      "en": "「One qualified as heir!\\nProstrate yourself before us!」"
    },
    "338:3203": {
      "repository_source_sha256": "385b3105f8418894a75982ce83ed30efeca56921b6f46c85c3e19523575587b2",
      "en": "「I'll show you the fate of the fool\\nwho challenged God!」"
    },
    "338:3252": {
      "repository_source_sha256": "7c48b0cacc9ca8908d57b7c25340166223228527ff07c6a64f6c1ebb2ea9e7aa",
      "en": "「$$異能生存体$$!\\nI'll take your life!」"
    },
    "338:3301": {
      "repository_source_sha256": "e798c06bb092dba2791964860e5c472182be96bd0be5c4746b6f8a90344726ab",
      "en": "「The man who buried a grotesque god?!」"
    },
    "338:3334": {
      "repository_source_sha256": "e1cd42036151b851a0994b5964ca0d891e7d7b8256ac4e7786b15a4c2c464bbb",
      "en": "「A weapon may not seek a life\\nas a human!」"
    },
    "338:3391": {
      "repository_source_sha256": "a579839ef27a78187f4b40b65983f5288737250884d153da0a3abca07c96bc7c",
      "en": "「You who kill your own kind\\nare not worth saving!」"
    },
    "338:3442": {
      "repository_source_sha256": "088a661fba994451a2901170195c23864680e94a8db2bcb58d0d8d3ea24eefd5",
      "en": "「Offer that $$スフィア$$ to the Exalted Ones!」"
    },
    "338:3479": {
      "repository_source_sha256": "16019f2ebf347e9a1fe70cb2f304eb572e36b7d8de36177b2013a84af52a53e2",
      "en": "「When all the $$スフィア$$s gather,\\nthe universe is saved!」"
    },
    "338:3530": {
      "repository_source_sha256": "f4b60d908a424d0837d2faf853eb64627a7da7f2583db5b767c42142b56431cc",
      "en": "「Well done,\\nawakening $$スフィア$$ power this far!」"
    },
    "338:3583": {
      "repository_source_sha256": "d1d4c410160503ae954a6884dc1e41ff25310f29311298625af071bbcbb874d4",
      "en": "「Kneel, $$悲しみの乙女$$!」"
    },
    "338:3614": {
      "repository_source_sha256": "863157595e997494b652e369fc0824011f374aff6c3727eae066ed5115929f53",
      "en": "「Yield, $$傷だらけの獅子$$!」"
    },
    "338:3643": {
      "repository_source_sha256": "1739bbb516bb32233d39502b4f17f39bd8be84569e29d805d12eb32c4fcab328",
      "en": "「Submit, $$揺れる天秤$$!」"
    },
    "338:3670": {
      "repository_source_sha256": "359762dbb6f29c01fa5a4aa88ab8d73cf46fb573d0362461aaef5376c0b1d691",
      "en": "「Give up, $$いがみ合う双子$$!」"
    }
  },

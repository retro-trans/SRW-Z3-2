{
  "schema": 1,
  "rows": {
    "338:4093": {
      "repository_source_sha256": "e3327a91453355510575a23c7594e110a69cb1562685a2545acb42d76365ac02",
      "en": "「Pay for spitting at Heaven.」"
    },
    "338:4122": {
      "repository_source_sha256": "fa0ec997938ba540425547d68129207fc0e18b9eb24608bfc7c60fa065537fe6",
      "en": "「What I give you is divine wrath.」"
    },
    "338:4151": {
      "repository_source_sha256": "0765e51d3e7a28892c5c91a45b3d788ef7fa972a63702c41d8322af86eb57c64",
      "en": "「Learn what karmic retribution is.」"
    },
    "338:4186": {
      "repository_source_sha256": "a1d5e2179c54a9788f13418c042678a1510789e57f4bcae8fd13142b939843f9",
      "en": "「You had to know this would happen.」"
    },
    "338:4221": {
      "repository_source_sha256": "47f71cbe12f87cc06a77b936021c92514b0f068b12bd60cf026eca58a27f4f5b",
      "en": "「Your fate is already sealed.」"
    },
    "338:4254": {
      "repository_source_sha256": "31bda9b99315b9f22a4b22b6815a2e2496381e2df158a842114eac58b0ddb8c2",
      "en": "「It's what you brought on yourself.」"
    },
    "338:4279": {
      "repository_source_sha256": "e8a10e2a01a0a1b2696e94f7f1d63050b7dd803ed17bb933f55c1ec652cc8024",
      "en": "「Fool, you don't know your place.」"
    },
    "338:4308": {
      "repository_source_sha256": "d3ed2a083609eb25f68ac3b1d9f3aafcfcd6a54695ae7e8a88f14160061761d0",
      "en": "「I only show you the natural result.」"
    },
    "338:4337": {
      "repository_source_sha256": "5e23c20159fef4c62eb6b989bdae478caea87a63b7fba03a01df308d8d41f4f4",
      "en": "「Where do you think you're going?」"
    },
    "338:4362": {
      "repository_source_sha256": "70392c3b17529f5c4b3a8620589b685c7ffe890b57ed98558db8e3970b4de62e",
      "en": "「Your life has no future.」"
    },
    "338:4389": {
      "repository_source_sha256": "dcc082e54c5433ee9118aa82876e147b9af6d7278b593716c33ee242945b4fea",
      "en": "「Atone for the sin of attacking us.」"
    },
    "338:4420": {
      "repository_source_sha256": "3c4a70193a771c693e5895d371f284b2582143fce429ecf3b3c23df675b451cb",
      "en": "「Is that all? Then...!」"
    },
    "338:4449": {
      "repository_source_sha256": "e54422273adf94901073845f5e5b64c0cb901e2ae0df1862df09653ad03a8ca0",
      "en": "「If we unite our strength...」"
    },
    "338:4474": {
      "repository_source_sha256": "a603d3bc0fcc0b2b2cc3fc5e78f55b9fe8dc9728712bd5f8f8488eab95fa8266",
      "en": "「Comrade, let's go together!」"
    },
    "338:4499": {
      "repository_source_sha256": "2b5c601754a43503a9c07dbefc12f19df1d8fc0e2cc16f2ed21f60516b4c3e6d",
      "en": "「Leave the rest to me.」"
    },
    "338:4528": {
      "repository_source_sha256": "15c0bb54f5717bf6d412bc086ef1467c17647ffb26af03f0aa5affe6b34482e3",
      "en": "「I'll fight as a $$真徒$$ should.」"
    },
    "338:4571": {
      "repository_source_sha256": "74046ee63c96ce949a867bc0448d10d26ddc66138ff3e89264b6175d335d8859",
      "en": "「Helping an emissary of God\\nis my happiness.」"
    },
    "338:1185": {
      "repository_source_sha256": "a5975fd863a620684106331135a2765db991980fea5188e1e1c6db5f5d1271cb",
      "en": "「Attacks continue until you're gone!」"
    },
    "338:1226": {
      "repository_source_sha256": "fae35b0e66fe6c2410de010876ac8092b1231af8b3156d258e8418d5151e5f36",
      "en": "「Who said it was just one attack?」"
    },
    "338:4954": {
      "repository_source_sha256": "31f971a3b572944b12cd309101cd02d52320946cade3a8f9797d58316bd2e309",
      "en": "「Then I'll go first!」"
    },
    "338:4979": {
      "repository_source_sha256": "4eeb036b678714dcd364c982410f21a22b39b9bb8267c0f323fd855aa6c6903b",
      "en": "「First, I'll give you despair.」"
    },
    "338:5006": {
      "repository_source_sha256": "a89bd0bd8b1ffd89fc566ff909fc7f7e7c25ad74aa7f2f79f0849f3483bea40c",
      "en": "「Despair, then death as salvation!」"
    },
    "338:5045": {
      "repository_source_sha256": "42b806fb2d0156adbeab3d558a544fda227042bcca4ab751a7e0a2d70364205a",
      "en": "「Purging is your honor this time.」"
    },
    "338:5074": {
      "repository_source_sha256": "d56e1151637a1c94c1bda4d5fae8b65ada081c9b916671eda06e1294f9a09451",
      "en": "「No foe stands before our teamwork.」"
    },
    "338:4795": {
      "repository_source_sha256": "fd36a8c0d60a24d5bc700bf57b2e653e8f22814b2dd204ccb8985eb0c19ef8c6",
      "en": "「I'm the one to correct you.」"
    },
    "338:4818": {
      "repository_source_sha256": "fd66a54871e82c071c626cd018ec4df3a9825991c58f34d4fcf7cd3d3723ab09",
      "en": "「I'll personally punish you.」"
    },
    "338:4849": {
      "repository_source_sha256": "aa0b9657da3bcbc173905483da75bfe1b8e684fe6ca3c3d0d9a628a81e618c44",
      "en": "「Each of us is a one-man army.」"
    },
    "338:4880": {
      "repository_source_sha256": "e24da063412f39a418dfd33497fe5388238ce1983e0dbfca767029bf1c3996de",
      "en": "「Comrades and I will purge this fool!」"
    },
    "338:4913": {
      "repository_source_sha256": "874e8b13015b8bf097dffeff1174b303df6cf36dc5a36939a94e72827a8eb3bd",
      "en": "「No time to worry about your allies!」"
    },
    "338:9386": {
      "repository_source_sha256": "2ea9f3e94efa4dc74c66112d176a5d63ec0c16ec2628d8577f5a800a0f950775",
      "en": "「S-Salus! Waaaagh!」"
    },
    "338:9423": {
      "repository_source_sha256": "f324ee596f87ddd50a2b9ff76ff3f27e786d47b22e134daa55d5f5cc39e81784",
      "en": "「I-I'm a $$真徒$$...!\\nA being promised eternity...!」"
    },
    "338:9474": {
      "repository_source_sha256": "3d153bdb23493dd10ce7a1cf0adc4f0e52c0c14bcb9e4e1a5a32b44ea1c81a02",
      "en": "「Why!?\\nPlease tell us, our Lord!!」"
    },
    "338:9527": {
      "repository_source_sha256": "8e35c2459768b5d44544a7e5a917478060abed14012b26774cc5b4d080452ef0",
      "en": "「I beg you, salvation!\\nPlease sa-a-ave me...!」"
    },
    "338:9584": {
      "repository_source_sha256": "3c4aee4e9c1bbfeafe0431d17680587a2952e889f38c50a265df8414a714f99e",
      "en": "「Weren't we on the path of $$シンカ$$\\nall along!?」"
    },
    "338:9639": {
      "repository_source_sha256": "b486916a640f6188e6f597741315c3c03eefa1bc49d74cc446a04a748c7b5cce",
      "en": "「H-help me! I'm not yet...!」"
    },
    "338:9674": {
      "repository_source_sha256": "420dfb3fd76f9a59cd6232966b3242453beb02ca83d108ae54b311fe76eece41",
      "en": "「I'm a $$真徒$$! I really am!!」"
    },
    "338:9709": {
      "repository_source_sha256": "ec8bf2dc060791b332b8f78611dfa48c536e6964ae25c6912d71cad8b314dd70",
      "en": "「Lies!\\nWe were meant to pass myth's end...!」"
    },
    "338:7611": {
      "repository_source_sha256": "567cbf1cc059f63687ad6dd0e75469bd13f6c16f85ec3b291c95c9094cd70397",
      "en": "「$$ガンダム$$...! Guide of possibility!」"
    },
    "338:7648": {
      "repository_source_sha256": "687577ad6b34530c71b8fcc1441f9a220efb169074f463af9837f14c88c8e27f",
      "en": "「$$ガンダム$$! This much power...!」"
    },
    "338:7685": {
      "repository_source_sha256": "4b018ee16615fe09c18c62f2c0a077a1378f0de7cf945d74b66747bf7d7caa86",
      "en": "「Those psychic waves...! So forceful!」"
    },
    "338:7724": {
      "repository_source_sha256": "17f64c455ff28c4aeec77dcb8456bfb768588f7b99852c686031db26147b24e3",
      "en": "「Already starting $$シンカ$$, this one!?」"
    },
    "338:7765": {
      "repository_source_sha256": "746ddd3ae1cf1868dca18aae57e74493772f1a947c64c3823508df8207027e17",
      "en": "「Steel giant...! No, steel super-god!」"
    },
    "338:7804": {
      "repository_source_sha256": "3733e2dafd7310c90a5ab8eba0a95e0c4aaf01c40ac9b365752e382cf1536d21",
      "en": "「A Super Robot defending mankind...!」"
    },
    "338:7847": {
      "repository_source_sha256": "4478994a63edffc57d96afe63dee95021f6a33870765b241fd59b4069ac428d9",
      "en": "「This one's future possibility\\nis cornering us...!」"
    },
    "338:7898": {
      "repository_source_sha256": "10961fe0544e734eb148e9dc9c88c990ecca1cfe41f0d27dc8f332fedb29d9d9",
      "en": "「This brilliance...! The sun's power!」"
    },
    "338:7929": {
      "repository_source_sha256": "21c80a9aad67dc685a76873fe92c74d5dc9466f71b8df49015dc2e7a3be46d79",
      "en": "「It's mastered $$ゲッター線$$ power!?」"
    },
    "338:7972": {
      "repository_source_sha256": "d62069439433af24a7f76047e16e23df616df25a9462069b274c131d601ca5a7",
      "en": "「Demon God of Light! Fully awoken!?」"
    },
    "338:8015": {
      "repository_source_sha256": "e140100767437f16b019bcde29329e508abc5b82bfb950e8700d75cefe33e05a",
      "en": "「This is God's...\\nNo, that man's firm will and pride!」"
    },
    "338:8074": {
      "repository_source_sha256": "0beaa090bb8aa2320c0643f6c7e80d6b149b7069ffa87493e44918a5414fef09",
      "en": "「Wildness beyond reason!\\nThis cannot be stopped!」"
    },
    "338:8129": {
      "repository_source_sha256": "a971e40e762a85f533934af8b049c13673c984cf3a18f5e111db71c0f226d5aa",
      "en": "「Mingling of waters...!\\nA power that melds all into the new!」"
    },
    "338:8188": {
      "repository_source_sha256": "b43934e680bfe5ad09ed6fc76d336c17def2ff159002443b3e159606ddcc9baa",
      "en": "「This is the man who killed a god...!」"
    },
    "338:8215": {
      "repository_source_sha256": "1ecddcf07bba1acbe1f81d49026b2a09eaa7da70341ea4ca8eaf82b9aec6244f",
      "en": "「Now I'm being shown a miracle\\nthat humans make...!」"
    },
    "338:8266": {
      "repository_source_sha256": "a9698340efadd2c3ccfbeba57430102fce479a8b593ef3c5c47f9d94add3c2ba",
      "en": "「Hard work and guts...!\\nThat's human power seeking tomorrow!」"
    },
    "338:8323": {
      "repository_source_sha256": "a9ab9ca32c2cca02aca69530a78ef4b6d9847fda6ae409b414238331a3dce4c8",
      "en": "「No ceiling to Spiral power at all!?」"
    },
    "338:8366": {
      "repository_source_sha256": "2ebe31934b8558ac8077e7fa68c0aecdad5ad7a33e21bcd7c1d9fd1899d0d42b",
      "en": "「Those wings...! Carrying feelings!?」"
    },
    "338:8405": {
      "repository_source_sha256": "0753b2a85ac10e5b317a1a4258ded94cbd4522812e2a6dd76df2c556672ae806",
      "en": "「The power of life...!\\nTheir song shakes our hearts!」"
    },
    "338:8456": {
      "repository_source_sha256": "57628f999bdce7fd8a9064e9ef168befbb3f11aa3a042a62a9bac4b322ed028d",
      "en": "「Machine and human fuse,\\ncreating a new power!?」"
    },
    "338:8513": {
      "repository_source_sha256": "be2614fe36fe701ab89e61e89a6a6200043f8584a397186712641fecbfc1197c",
      "en": "「Humans...!\\nUsing that power isn't allowed!」"
    },
    "338:8564": {
      "repository_source_sha256": "404ac49d5e6a02370c73c36f8f24e0b0884526b6bb95a0c8731ff4451d826964",
      "en": "「So this is the true Sphere power!」"
    },
    "338:8595": {
      "repository_source_sha256": "9c043fe59c394985769e5a2205a41c1246b1c5beb4dbc516a3a3818b326e7617",
      "en": "「Spheres...\\nHuman feelings create great power!」"
    },
    "338:8644": {
      "repository_source_sha256": "7b249ded847bc8d7905f3a2ba9450b24e62bdd3c72ff762162974ae15258130e",
      "en": "「Impossible...!\\nThis situation cannot be!」"
    },
    "338:8693": {
      "repository_source_sha256": "3969fc7e1a9fee0b2be796c86a1f9eb3370d7bcebe6b55b0f370436445e1d1b3",
      "en": "「Unacceptable! We, to mere humans...!」"
    },
    "338:8736": {
      "repository_source_sha256": "c5bbd0c24044108a3ea94a312c3492e1f1b3276f0c5425923a557202c7e106c4",
      "en": "「Shameful, before the Exalted One...!」"
    },
    "338:8777": {
      "repository_source_sha256": "2ab843c7da640dfc712fa283eb0845783d8ae9e548329b61434a677f221afbcf",
      "en": "「We're $$真徒$$s! Perfect beings!」"
    },
    "338:8818": {
      "repository_source_sha256": "504c5cb8499f96449bd036fc68df479a7ef5348d79b26da6247ea3551e9c6875",
      "en": "「It's a dream! A nightmare, surely!」"
    },
    "338:8855": {
      "repository_source_sha256": "98a67aa83a817e34e393c6a080b5f233b89a8ca0ac8169ea9cd096764449eaf0",
      "en": "「God! Protect a poor wretch like me!」"
    },
    "338:8888": {
      "repository_source_sha256": "1711196e7f55fcb7d8eee14969546c42300822d1418c42dc9e22543395f68f52",
      "en": "「Tell me, God!\\nWho are they!?」"
    },
    "338:8943": {
      "repository_source_sha256": "11f61c497639a73442ee61a37356c7197803f53c2234b76a1adf6b2b1359c2f5",
      "en": "「Mere humans!\\nMere humaaaans!!」"
    },
    "338:8992": {
      "repository_source_sha256": "a39d4ca23c3deb1b01f61c8b7664c9387fa2b9c74c080131f660e429d14cf9b6",
      "en": "「Our victory should be assured!\\nSo why!?」"
    },
    "338:9049": {
      "repository_source_sha256": "6f2f9b7a0d642bcf5bc50eb5b4207de3d3ddf8964a41d3a6e91ba9ef6025d7f3",
      "en": "「Cosmic law! Order! Justice unravels!」"
    },
    "338:9092": {
      "repository_source_sha256": "6b6797dc4558f51a68b0b5807e1cf5588c0ae0694611f9f4fb720e987c86a5db",
      "en": "「I gave my life to the Exalted Ones!\\nI feel no fear!」"
    },
    "338:9155": {
      "repository_source_sha256": "67305092c7b03ceb6265aa7dbeb71d463866deb913f206a4f0206e1550c9550e",
      "en": "「A $$真徒$$ on the $$シンカ$$ path,\\nI'm a being beyond humanity!」"
    },
    "338:9222": {
      "repository_source_sha256": "c30f2bd6e744c7af75e0fc49907b68edcad99e0dabdcc1f5bd0800dcf086e645",
      "en": "「Feelings...the power binding humans!」"
    },
    "338:9257": {
      "repository_source_sha256": "72354f3331efce55f0e27ba6d3563bb34f143c329954acd15455469aac934052",
      "en": "「All around that one closes in on me!」"
    },
    "338:9300": {
      "repository_source_sha256": "ffc7bd49c94e79374ae4fc435ffb0888db0fe4a5650846e075e1986ab9d76eb2",
      "en": "「This is possibility...!\\nHumanity's infinite future!」"
    },
    "338:9349": {
      "repository_source_sha256": "dba201633ef6462ab14e2b7073dfc3986de673ec60f82e3b59ace82ba7b7a0cb",
      "en": "「Are they walking the $$シンカ$$ path!?」"
    },
    "338:6938": {
      "repository_source_sha256": "91d84795f9a64d9cd8e5b5a48404d7583f45d4fe5857762c7e3d17a87142932b",
      "en": "「I need to revise my view a little.」"
    },
    "338:6971": {
      "repository_source_sha256": "eb0b21d4017930887ef999f27bf71151fbc47080c0126f6beaf4bf6353c64996",
      "en": "「I see...\\nAs expected of one with the $$烙印$$.」"
    },
    "338:7020": {
      "repository_source_sha256": "bb20d0a9c27910e10c7db55a30e8df23f4ae1d6b3d883ec3758310031223507e",
      "en": "「It's been 2,208 cycles since\\nI had a real fight...」"
    },
    "338:7075": {
      "repository_source_sha256": "0f8dd2671b15c1506bc1ba43c7e83f6b048cbe2639b1b4369b77c346c3fc7947",
      "en": "「It's no fun unless it's like this!」"
    }
  },

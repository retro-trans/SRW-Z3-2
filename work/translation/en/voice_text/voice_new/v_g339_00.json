{
  "schema": 1,
  "rows": {
    "339:0": {
      "repository_source_sha256": "d28882383fb9c0a048b59eed441a4c8debf4afe824b77d27afaa417dcf4143ff",
      "en": "「I relay the words of the emissary of God!」"
    },
    "339:29": {
      "repository_source_sha256": "3f10436fc7931cc6c7777c3ba6f4a745fd4354c2f4385b5c3deb1215a78503d2",
      "en": "「We are the chosen people!」"
    },
    "339:54": {
      "repository_source_sha256": "61b3172d5540436ef9f9060fc916a990b773fdb772795b64dfdd1b860abc23d7",
      "en": "「There is no mercy for those who refused God's salvation!」"
    },
    "339:91": {
      "repository_source_sha256": "1a4ceef8daf90582f40a49f21f27858e69d3d2eb2f45291b4c7a6b1560f94811",
      "en": "「The sentence will now be carried out!」"
    },
    "339:110": {
      "repository_source_sha256": "df4a3236377d1082f800eb619f0373b1caeb964e7583e29ad7dfdbe66789d5f2",
      "en": "「Know that it was all brought on by your own sin!」"
    },
    "339:143": {
      "repository_source_sha256": "ec1e9ca444d07ec37c1ba4e5029068d74f3b7d64226d61833af2a35b6873a0ee",
      "en": "「Sinful ones... Earthlings!」"
    },
    "339:168": {
      "repository_source_sha256": "98f1a0437b6d3b4e7cabc7486c7f3231d5889880386603b2f784a62d20a61403",
      "en": "「Divine punishment upon the foolish sinner!」"
    },
    "339:193": {
      "repository_source_sha256": "750cb64144c674815caae425fbbd895525d34ac7e825df3ee75d0253aa3676d9",
      "en": "「We are $$真徒$$s. Executors of God's will!」"
    },
    "339:232": {
      "repository_source_sha256": "3d4906efcc55c4af54cc8c6c18847e0d4fd484f84af0f423811212a805d99a99",
      "en": "「We are the guardians of the law!」"
    },
    "339:259": {
      "repository_source_sha256": "0fdab1a1f191bdf0a4f4ed104000a40f4b4e0b540d31c92512ab1501d26124e6",
      "en": "「You are not permitted to attain $$シンカ$$!」"
    },
    "339:290": {
      "repository_source_sha256": "62de4bd732bf2fb3cdd6448637745779ee6d71c0f9fd3cba7860ef0af9563f79",
      "en": "「The Exalted Ones will decide your future!」"
    },
    "339:329": {
      "repository_source_sha256": "6fd2b2a933938ec3c74a6bb98547daa463cdbcc311b24831e51e69293f158b3d",
      "en": "「Hopeless fools...!」"
    },
    "339:362": {
      "repository_source_sha256": "debd388b653295033e9ce336dbfafa642378b4d15a0927dd44962e602763563c",
      "en": "「Fool who defies fate!」"
    },
    "339:391": {
      "repository_source_sha256": "894a07ea1f170e9591f9c3a3a8e113e07b2afa0a60b8aaf10468793b638cc661",
      "en": "「The chosen purge the unchosen!」"
    },
    "339:432": {
      "repository_source_sha256": "7c69de409e5890fe95181038a4e5d504adab5b367409bed3d5820b5e35c551b2",
      "en": "「Intruder disturbing the cosmic peace!」"
    },
    "339:463": {
      "repository_source_sha256": "6df0c0904dccfd5498130af99846e862aec8c182fa8862568a9ce5647ec214bf",
      "en": "「This is the universe where the gods dwell!」"
    },
    "339:494": {
      "repository_source_sha256": "34ae9ede79f77dd35157d0dd49da8aeb50db512ad9a6be7bc9d00ebcc1fb31e2",
      "en": "「Insolent trespasser, barging into\\nthe universe where the gods dwell!」"
    },
    "339:547": {
      "repository_source_sha256": "c9b1e2be185e30b013b5d83b1849157a078b1c0d5b68560b84d361243ae161ff",
      "en": "「We stand several levels above you!」"
    },
    "339:584": {
      "repository_source_sha256": "8c31ace992fad802457bfaa9044123c0dadd5cd820daa487ff5332699b2ee540",
      "en": "「Take it as mercy. Perish here!」"
    },
    "339:621": {
      "repository_source_sha256": "b4baf6acbbaa9565a0db5edb919308cdc2d24ea909216ba14f05703bd21afa8d",
      "en": "「No need to trouble the Exalted Ones!」"
    },
    "339:664": {
      "repository_source_sha256": "7538caec3e4a1a9864a0b6f98dc83e6deee4a73016d900f30b9ae2d7ccb6614c",
      "en": "「Behold the power the Exalted Ones gave us!」"
    },
    "339:703": {
      "repository_source_sha256": "ff2b26ec7013463ed46927fb74821beb9cac84e0a112e29bfbf696bc7c9f5eae",
      "en": "「This radiance destroys the evil that is you!」"
    },
    "339:742": {
      "repository_source_sha256": "1695e94ad98ca93a3cd4d44a78e952431aeb4b8aefd6b3e3caa370943a583779",
      "en": "「This is proof of the Exalted Ones' power!」"
    },
    "339:777": {
      "repository_source_sha256": "ac5adbda9ddbe0fe3f185c78336d3cee3daf1e07816b72a6577ff9ed3a8db4e6",
      "en": "「This is proof of God's love for us!」"
    },
    "339:1289": {
      "repository_source_sha256": "6818a75494c675ab03b6aefd8816494bcdad88772d5b5434f353ca7baf3f7d57",
      "en": "「Inorganic structures built by humans\\nare nothing to us!」"
    },
    "339:1340": {
      "repository_source_sha256": "631cb37e6cfe581e595904991ea15cf32f8b9c7610a0cdef541323e7b32f133a",
      "en": "「Don't think you can win with tools\\nmade by foolish humans!」"
    },
    "339:1393": {
      "repository_source_sha256": "9746165de0bc23ce5030a965aabb0c0124ba82ad657f3b38382f4b035f18bb01",
      "en": "「Human wisdom means nothing before God!」"
    },
    "339:1436": {
      "repository_source_sha256": "a530b030d827860f27bb55e65e8f5e9bf2510e84d0bf096325a5eefe907476fe",
      "en": "「A product of the civilization of fire... $$ガンダム$$!」"
    },
    "339:1469": {
      "repository_source_sha256": "76c7a9d567c20223840f60892dbd393a9e241c8a38892771f7773512f946322f",
      "en": "「The tool to guide humanity to $$シンカ$$ has come!」"
    },
    "339:1504": {
      "repository_source_sha256": "f7c6f9fe029641da6dc1cf4214d7d8464997564c5718e680a019985e8ddb7171",
      "en": "「$$ガンダム$$!\\nA guidepost across parallel worlds!」"
    },
    "339:1553": {
      "repository_source_sha256": "99b55815cca8bccf8047d625a6d1e2ce24d835c99989f1d6af278fd474897f3f",
      "en": "「I'll destroy every world's $$ガンダム$$!」"
    },
    "339:1590": {
      "repository_source_sha256": "fc4c566e4e7e104a8460857b9e634825757494bbdd150146a0eaec82d30e4e77",
      "en": "「You'll walk the path of $$シンカ$$\\nno further!」"
    },
    "339:1639": {
      "repository_source_sha256": "dca536885e14ede8cccb47943731ea77de3f1f750e93c60793790ca6325a5763",
      "en": "「Your evolution is merely\\nthe entrance to $$シンカ$$!」"
    },
    "339:1692": {
      "repository_source_sha256": "8b4da0b1955f9decea4e42707e1c00cb77713bec00caf9c878ed85f2aafe6ac7",
      "en": "「Will these ones be Earth's forerunners!?」"
    },
    "339:1733": {
      "repository_source_sha256": "10e1e2bcfc878b53eaa0024cebd93216614dac234e3abcbabaeb39690a7e69f5",
      "en": "「God and man need no dialogue!」"
    },
    "339:1772": {
      "repository_source_sha256": "231eaed3beb58a8d65d406dd1700e580bc6d19d38579c0659d9aa4919dc41ba6",
      "en": "「These ones too are sprouts of evolution...\\nNo, bearers of the seed!」"
    },
    "339:1823": {
      "repository_source_sha256": "2311f1b96e36b1c5173277adea0990de3fdb996305514877193dc7cefa8961b7",
      "en": "「Not enough to call yourself a machine super-god!」"
    },
    "339:1860": {
      "repository_source_sha256": "aa8e1281fd7340c6f6b8d0f7f59b7404adeb6e22c4699a7799fad8ec39dfc48a",
      "en": "「Just a machine god built by humans!」"
    },
    "339:1895": {
      "repository_source_sha256": "9b1d99d8fa3a556eae09c3fb2e73028431d97de993eb9fe4d879b8128b765fa8",
      "en": "「No matter the feelings you pour in,\\nhuman civilization can't beat us!」"
    },
    "339:1960": {
      "repository_source_sha256": "ed92c4d5c6c2ccaacf08a4df722ecdbd09ff20a259dbffd6733ecd4f66fee7de",
      "en": "「Even a Demon God of Light can't match a true god!」"
    },
    "339:2001": {
      "repository_source_sha256": "7ffbdfd19c2ba9a730e25f0a179a698edc8c5395d2e4180c6944565c999be8ea",
      "en": "「We can't accept evolution\\nby $$ゲッター線$$!」"
    },
    "339:2058": {
      "repository_source_sha256": "04692270ce2b2700badc9f54a812bdd26ff76ae3293cc0c01161f6e0f598ec07",
      "en": "「I'll cut down the bud of possibility\\nin that child right here!」"
    },
    "339:2109": {
      "repository_source_sha256": "15ca6278a58f5805656a05f7658969dbf44e0c6aaf113e22ccae24823ba852bd",
      "en": "「Cower, child!\\nWe embody the will of God!」"
    },
    "339:2162": {
      "repository_source_sha256": "38886ffedfb007806ba46e4fa884e7d91aec492b0ebfb551332bc80a9982c89f",
      "en": "「Only the Exalted Ones are permitted\\nto raise the sun aloft!」"
    },
    "339:2217": {
      "repository_source_sha256": "16ac989349a580e51cb071955b3502b0ca94de4c84d10e96229e06f17e443b86",
      "en": "「Even the moonlight that lights the dark\\nis not permitted to you!」"
    },
    "339:2268": {
      "repository_source_sha256": "ce0ea7237851417484fb16fec23b7ae2581a06863d607f6cf3544581942649a9",
      "en": "「The twin factors of light and dark end here!」"
    },
    "339:2307": {
      "repository_source_sha256": "13809d83678aaec9756fd7d1240df97966daaa1e14101c4b2b38638e347b3ef6",
      "en": "「The power of love won't work in this universe!」"
    },
    "339:2348": {
      "repository_source_sha256": "dd08819edd7ec800484d67f1d821b7194f6ff513ebfb612160b91716d606853c",
      "en": "「Spill all the blood of the beast right here!」"
    },
    "339:2387": {
      "repository_source_sha256": "135f556ef076cda53e4245259dd3a6b7340afdab047347ac4e8a6fe9528c19d3",
      "en": "「The best fit for the phrase\\n'not knowing your place'!」"
    },
    "339:2438": {
      "repository_source_sha256": "e678d44cbb0b0280bdae5dd8086efae47e9e5efd8b5832cec90277126e4b2530",
      "en": "「God doesn't accept what is born\\nfrom the mingling of waters!」"
    },
    "339:2491": {
      "repository_source_sha256": "f8205ab53d4246679157bd4d40326882a377c731ed2433f2088b178a7f1599b1",
      "en": "「Avenging the $$天翅$$s' bitter regret is impossible!」"
    },
    "339:2534": {
      "repository_source_sha256": "08535bc68e0756bc343d080afaf2fffebc727856fd177d2c93fa47ffb8221a1a",
      "en": "「World mediator! Shut your mouth!」"
    },
    "339:2573": {
      "repository_source_sha256": "ed716f81bcb8d5c3da35157b9ff8b0ef96d422e1b72fba3e08c746a4dfc5ada4",
      "en": "「Insolent one who bends God's will!」"
    },
    "339:2606": {
      "repository_source_sha256": "a6346b8e277bf310a20a66b84a83e037f1f98e198b128d1a8bbdb46d4cafe49d",
      "en": "「No miracles will happen! We won't allow it!」"
    },
    "339:2649": {
      "repository_source_sha256": "1ba25ad36127b2056849d44ca486f31d972eb0f50e53486d3c454ffdcb7a06ff",
      "en": "「Even you who felled $$バアル$$ end here!」"
    },
    "339:2690": {
      "repository_source_sha256": "879d5b96fad0ef33201dade8d8ec0b079bdb483b8b3f290fb2db53afa8b77753",
      "en": "「The wind's destination is beyond the causal horizon!」"
    },
    "339:2725": {
      "repository_source_sha256": "2c733267de85643a8fe5af4130f65f2f5ecc5e2b1aa89e93a68c939eb087b7ed",
      "en": "「I'll snap that drill with God's will!」"
    },
    "339:2758": {
      "repository_source_sha256": "1d55b33f2f188f091c880032b7868a5148827c4979476019b781ced7f5084e4c",
      "en": "「Power that changes the world's natural order ends here!」"
    },
    "339:2799": {
      "repository_source_sha256": "9501213bc8a21d3e0db7affc5687c8ef5db3c5b24bbb5732e126cbb59ffeb766",
      "en": "「Suffer for trying to bend God's providence!」"
    },
    "339:2842": {
      "repository_source_sha256": "139a83d3d159f6c53361bb17656e203609fe3e3c0a720fee616a9e61c0d291c9",
      "en": "「That power is not permitted to humanity!」"
    },
    "339:2875": {
      "repository_source_sha256": "b34dd056d1cb7954696f35e2667114452edb5ad9b75388fae78729367616b0fe",
      "en": "「Don't think tools of human-on-human war\\nwill work on us!」"
    },
    "339:2928": {
      "repository_source_sha256": "4d2e5dd927aae4a9f30bfefa1076049e143ff369a9974134b3c7206ec419685c",
      "en": "「Weapons symbolize immature humanity!」"
    },
    "339:2965": {
      "repository_source_sha256": "0cc4e2d8bfeb35ac5074799f2be2ee053d5bbce5cba2498ebebf38e0b12223a2",
      "en": "「A song...! Truly a surge of the power of life!」"
    },
    "339:3008": {
      "repository_source_sha256": "c0700ae94e1b12998a7538d10b2b056b06b11982f0c43c09240d518de6d8d5ea",
      "en": "「Wings that carry feelings?\\nI'll tear them off!」"
    },
    "339:3057": {
      "repository_source_sha256": "8b2e0ce0426a278692e4bd3e7adbb83bb2541012321e2eca23644e8ece790ed2",
      "en": "「$$始原の特異点$$! Die here!」"
    },
    "339:3098": {
      "repository_source_sha256": "691b892781082d035b508cfbba150f97a3a6d8d82033f48a16cddbc8298fb4bc",
      "en": "「Impossible...!\\nThere are beings beyond our understanding!」"
    },
    "339:3147": {
      "repository_source_sha256": "8dfdd2b6c69100ec87584be279dc39dd47bc0810db36abbc9b3d686cede9c364",
      "en": "「That animal disturbs my mind!」"
    },
    "339:3180": {
      "repository_source_sha256": "fee91e0dc429b442c6e694601933a19567119bfe64c9a98883a65bc785857d21",
      "en": "「You who qualify as a successor!\\nKneel before us!」"
    },
    "339:3227": {
      "repository_source_sha256": "385b3105f8418894a75982ce83ed30efeca56921b6f46c85c3e19523575587b2",
      "en": "「I'll teach you the fate of the foolish\\nman who challenged God!」"
    },
    "339:3276": {
      "repository_source_sha256": "985746ae06efd6b0747c7e77704da16eec7853e8a277c7b52e98ede34f5f8fe9",
      "en": "「$$異能生存体$$!\\nI'll take your life!」"
    },
    "339:3323": {
      "repository_source_sha256": "e798c06bb092dba2791964860e5c472182be96bd0be5c4746b6f8a90344726ab",
      "en": "「The man who buried a monstrous god!」"
    },
    "339:3356": {
      "repository_source_sha256": "e1cd42036151b851a0994b5964ca0d891e7d7b8256ac4e7786b15a4c2c464bbb",
      "en": "「Weapons are not permitted to seek\\nto live as humans!」"
    },
    "339:3413": {
      "repository_source_sha256": "a579839ef27a78187f4b40b65983f5288737250884d153da0a3abca07c96bc7c",
      "en": "「You who kill your own kind\\nare not worth saving!」"
    },
    "339:3464": {
      "repository_source_sha256": "d33d826b4fe5fa3ef37d6219b80e54f2591f26f7193a484cf3194ab8acdd1d9f",
      "en": "「Offer that $$スフィア$$ to the Exalted Ones!」"
    },
    "339:3501": {
      "repository_source_sha256": "16019f2ebf347e9a1fe70cb2f304eb572e36b7d8de36177b2013a84af52a53e2",
      "en": "「When all the $$スフィア$$s gather,\\nthe universe will be saved!」"
    },
    "339:3552": {
      "repository_source_sha256": "0bfdc30c28bb572e861f8862ba3b5f5169105c4e90fc045abc5d347b0a560593",
      "en": "「You've done well to awaken the power\\nof the $$スフィア$$ this far!」"
    },
    "339:3603": {
      "repository_source_sha256": "d1d4c410160503ae954a6884dc1e41ff25310f29311298625af071bbcbb874d4",
      "en": "「Kneel, $$悲しみの乙女$$!」"
    },
    "339:3634": {
      "repository_source_sha256": "863157595e997494b652e369fc0824011f374aff6c3727eae066ed5115929f53",
      "en": "「Yield, $$傷だらけの獅子$$!」"
    },
    "339:3663": {
      "repository_source_sha256": "1739bbb516bb32233d39502b4f17f39bd8be84569e29d805d12eb32c4fcab328",
      "en": "「Submit, $$揺れる天秤$$!」"
    },
    "339:3690": {
      "repository_source_sha256": "359762dbb6f29c01fa5a4aa88ab8d73cf46fb573d0362461aaef5376c0b1d691",
      "en": "「Give up, $$いがみ合う双子$$!」"
    }
  },
  "speakers": {
    "g339": {

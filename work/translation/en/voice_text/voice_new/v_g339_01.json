    },
    "339:9126": {
      "repository_source_sha256": "62801f803dbdb306fcd563269713d7bd657c77e3ef4971543ea33e6e16a1f59a",
      "en": "「I-I've offered my life\\nto the Exalted Ones! I know no fear!」"
    },
    "339:9189": {
      "repository_source_sha256": "67305092c7b03ceb6265aa7dbeb71d463866deb913f206a4f0206e1550c9550e",
      "en": "「I'm a $$真徒$$! On the $$シンカ$$ path,\\nI'm a being beyond humanity!」"
    },
    "339:9256": {
      "repository_source_sha256": "c30f2bd6e744c7af75e0fc49907b68edcad99e0dabdcc1f5bd0800dcf086e645",
      "en": "「Feelings... the force that binds humans!」"
    },
    "339:9291": {
      "repository_source_sha256": "72354f3331efce55f0e27ba6d3563bb34f143c329954acd15455469aac934052",
      "en": "「E-everything around them presses on me!」"
    },
    "339:9334": {
      "repository_source_sha256": "d13c30cd372fc30cfeac60149938a37855850551d39741ba248a5423d96e69b2",
      "en": "「This is possibility...!\\nThe infinite future humans hold!」"
    },
    "339:9381": {
      "repository_source_sha256": "dba201633ef6462ab14e2b7073dfc3986de673ec60f82e3b59ace82ba7b7a0cb",
      "en": "「Are they on the path to $$シンカ$$!?」"
    },
    "339:7008": {
      "repository_source_sha256": "91d84795f9a64d9cd8e5b5a48404d7583f45d4fe5857762c7e3d17a87142932b",
      "en": "「I may need to rethink this a little.」"
    },
    "339:7041": {
      "repository_source_sha256": "eb0b21d4017930887ef999f27bf71151fbc47080c0126f6beaf4bf6353c64996",
      "en": "「I see...\\nYou live up to the $$烙印$$ you bear.」"
    },
    "339:7090": {
      "repository_source_sha256": "bb20d0a9c27910e10c7db55a30e8df23f4ae1d6b3d883ec3758310031223507e",

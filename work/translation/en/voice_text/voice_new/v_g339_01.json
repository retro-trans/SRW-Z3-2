    },
    "339:8928": {
      "repository_source_sha256": "dd10a51cc6c1e7ae32be0d10850c34d060b62bcaa650bd99aef329932969564b",
      "en": "「Please tell me, O God!\\nWhat manner of beings are they!?」"
    },
    "339:8981": {
      "repository_source_sha256": "9a8cbc11cb68d5c4ff2fa8145ec6c9805d8362316de48b79669dbe78340cf5a7",
      "en": "「Mere humans!\\nMere humaaaaans!!」"
    },
    "339:9028": {
      "repository_source_sha256": "838f37e9ed90aa65a08e91d7b2fc38816cbde7b60ebd6103a5792f8b8d3e70e9",
      "en": "「Our victory was promised to us!\\nSo why!?」"
    },
    "339:9083": {
      "repository_source_sha256": "6f2f9b7a0d642bcf5bc50eb5b4207de3d3ddf8964a41d3a6e91ba9ef6025d7f3",

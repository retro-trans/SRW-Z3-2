{
  "schema": 1,
  "rows": {
    "365:1142": {
      "repository_source_sha256": "210c9b6f39d63ffd799f48f31d24df22ed4cb455f3235e8ca96e35724f696d59",
      "en": "「This is my job.」"
    },
    "365:1157": {
      "repository_source_sha256": "c90f287703c921e14e98f9ee39e468f8e832f85bf09b528632dcdb4bc2cd1223",
      "en": "「I'll make this quick.」"
    },
    "365:1176": {
      "repository_source_sha256": "a07a937c9b3d5fc75d390e0436409008941f1e7a6f88802fbb600fdc03d9e67c",
      "en": "「I'll open the gate.」"
    },
    "365:1189": {
      "repository_source_sha256": "1f60bd1ecd7c78b56c897fb877470a7902151a3a93c6f275246597f246bbed5f",
      "en": "「This will be over soon.」"
    },
    "365:1208": {
      "repository_source_sha256": "890268c9a018022c27bb79d8658b1c2de609a1fbccec24c9d62e28890595ed38",
      "en": "「Don't fight it.」"
    },
    "365:1219": {
      "repository_source_sha256": "8ccaf6ee263f1e0d71b860adda99547e798d4237d219d71a25fd79fb6060d0ef",
      "en": "「That was your misfortune.」"
    },
    "365:1236": {
      "repository_source_sha256": "2d179d9a98d58a8ef541ac4fd53c4bf217bf61aab502593c326ea99d0cb6fd66",
      "en": "「Such is the duty of $$鬼宿$$...」"
    },
    "365:1255": {
      "repository_source_sha256": "cebdc57c331888a5c82b02ced034d0140b60a0e98c8bb550658f66940517b7e2",
      "en": "「The flame goes out.」"
    },
    "365:1291": {
      "repository_source_sha256": "2ecd8448b570390f5c64aed2d55b505a2dc9460b7775e29b81f531006b641a79",
      "en": "「How cold the moonlight is.」"
    },
    "365:1310": {
      "repository_source_sha256": "a6b0bcd0f5874df9b8ddbcf0a936e16f7f7593af4f1e075eaa71f6b902a8479c",
      "en": "「You're dazzling.」"
    },
    "365:1333": {
      "repository_source_sha256": "0f2a8adf6ea3868c60513d1af3f07a950c9b9bee4bb4653eb0719bd25e0efedd",
      "en": "「So, a child.」"
    },
    "365:1344": {
      "repository_source_sha256": "6a5ba5c43c5452a2c6ccd84544a0d34459f46a0c384ede1f4f4f9aa54d84614e",
      "en": "「So my opponent is a doll.」"
    },
    "365:1361": {
      "repository_source_sha256": "dad2d6a171c6d822b39d64d74dfd1fb3c6c07a388e748a088fa82f98514d7ad5",
      "en": "「Love...? I know nothing of it.」"
    },
    "365:1382": {
      "repository_source_sha256": "2fdd51dfca975ef944c179764e0425269602ab54448010c32316f5aebe141303",
      "en": "「So death itself rejects you.」"
    },
    "365:1417": {
      "repository_source_sha256": "3fa750df6881936993b74e83f19d86710b800147afb722ae79eaeb636e06eacb",
      "en": "「A signpost born of the civilization of fire...」"
    },
    "365:1444": {
      "repository_source_sha256": "91fb8dff3b9aec5faeca7a144175ce157ca04d845507cdfb890f63ca86f5e9df",
      "en": "「$$ガンダム$$... How dangerous.」"
    },
    "365:1469": {
      "repository_source_sha256": "d95af1f64c633e9bf7439b387044f943e8af91d6c0349051fbd9314b55478f3f",
      "en": "「That which guides... $$ガンダム$$...」"
    },
    "365:1494": {
      "repository_source_sha256": "6118780c0d02716c582be07277111d5013dbe10587a14aa228a08a0cded716eb",
      "en": "「So I'm up against a beast.」"
    },
    "365:1513": {
      "repository_source_sha256": "3aee81b252339ce277c2c597e806d871a32306f55f5b63c2bf751282bec7e436",
      "en": "「So, the $$始原の特異点$$.」"
    },
    "365:1532": {
      "repository_source_sha256": "bc337daec17e6956548670b117e801078d4146a726f09265fc558d38b95d588e",
      "en": "「The three factors...」"
    },
    "365:1551": {
      "repository_source_sha256": "0f09013e8e35b185ad164175b80f2c43439da588203ef07cd815d7cff245af08",
      "en": "「That's a fine song.」"
    },
    "365:1566": {
      "repository_source_sha256": "fa65ff0b21793ccaa8855af2e609b8a1e913e5e4c2e620aed141b69cb79eee2b",
      "en": "「Is speed all you have?」"
    },
    "365:1581": {
      "repository_source_sha256": "5a3c7f114b28acbf8fe1693a6e1586cb96555f4578ab3d31596538ad170c2911",
      "en": "「So those wings are your power.」"
    },
    "365:1600": {
      "repository_source_sha256": "27129f9c15aee429ff37b76d3fa3160fdbd6871d925fbc4df934b1cc4c93800b",
      "en": "「So, the light of hope.」"
    },
    "365:1615": {
      "repository_source_sha256": "1882c929d48b429f7e8b209549fa2bbfdad3898040cddc820c048a2b90b41987",
      "en": "「Evolution and $$シンカ$$...」"
    },
    "365:1636": {
      "repository_source_sha256": "eb3989094e151dd2577e1707882242ce36ae16eb98c759a119b2347e5b95d995",
      "en": "「How noisy.」"
    },
    "365:1651": {
      "repository_source_sha256": "522343f8534870d5c10744bcd14afa7445ca58ca7934a8c40a361c2df9708c5c",
      "en": "「There's no room for negotiation.」"
    },
    "365:1672": {
      "repository_source_sha256": "bfb04732c8fe6cd455c98daadf75e681909e607459ff106fbee3197dd2531940",
      "en": "「Miracles don't exist.」"
    },
    "365:1689": {
      "repository_source_sha256": "11610f0fae19f16f71cca2942d28063337fc32c6a110af719238763794e2e151",
      "en": "「So, a soldier.」"
    },
    "365:1700": {
      "repository_source_sha256": "8555090b97c7d44eafaa09b3bd4e349f0ef3c4b4b1893e9b1cdfb8299affcd78",
      "en": "「That's a dangerous power.」"
    },
    "365:1717": {
      "repository_source_sha256": "6e9ce4614b24f9eb04abcd63490b1fe7b976d5f2dc96812608bbab773d845bef",
      "en": "「I don't understand...」"
    },
    "365:1732": {
      "repository_source_sha256": "eb848e2835d2516311e746831b717cd66c4215e80665ca723e05b912cef67f02",
      "en": "「The $$天翅$$s are dead.」"
    },
    "365:1749": {
      "repository_source_sha256": "dd522a862aec51de898ad37f87e9a9bbab2d08283ec3b5160607145c0f7e091b",
      "en": "「This too, the civilization of fire.」"
    },
    "365:1770": {
      "repository_source_sha256": "8caf3d7d51fbdda711adf0db05a4ef25e29656a9cd8de008dcf9ea5632b48e0f",
      "en": "「What a strange power.」"
    },
    "365:1785": {
      "repository_source_sha256": "30393b448bb8c42e730aed67d1c8cab0cdc1d3ac122e1509676f9e5c2e657bbf",
      "en": "「What an odd shape.」"
    },
    "365:1802": {
      "repository_source_sha256": "5651f7b197415cd082f31e8b6a5a71ccd99ad432354d60f89c7ee75666f4cc4f",
      "en": "「I've had a hole in me all along.」"
    },
    "365:1835": {
      "repository_source_sha256": "434102e10205899aa073a0c054b2b6ad8bb2689394c6ccbc109ad390cbc2e5e4",
      "en": "「How ominous.」"
    },
    "365:1848": {
      "repository_source_sha256": "a73416c0b649077e2db44f46798757a3e3d3a4bd192f6c5c9fefa748beff7637",
      "en": "「Not unlike the $$尸逝天$$, then.」"
    },
    "365:1877": {
      "repository_source_sha256": "edadeb633610b7a9d037bf9f5a55f4b2cd1fd17a4534906099f8fd221258e3d8",
      "en": "「Did you stray from the pack?」"
    },
    "365:1900": {
      "repository_source_sha256": "a962ab32f988167b5359bf9cce9703e19f9ee3154b02d556debc33579b44baf6",
      "en": "「Submit to us.」"
    },
    "365:1915": {
      "repository_source_sha256": "f7002a82db79b06dd28fab75e5b2ed6af9b50b6ad62c74a024a1e381699ed396",
      "en": "「You'd make a fine wielder.」"
    },
    "365:1942": {
      "repository_source_sha256": "ca8df5eb3e2e114c75a916d7d155ed63f199a4765c2f292c0a29f9a5b661885e",
      "en": "「Your sorrow doesn't reach me.」"
    },
    "365:1975": {
      "repository_source_sha256": "57d87c4aa98d978736bb36997cf9a0e85aae5298a63044af86eebbc0dcbd8fce",
      "en": "「I feel nothing, just like you.」"
    },
    "365:2006": {
      "repository_source_sha256": "43ddbc9d8256fcc5d6aa07b537bf4270a6383ac4a424bee0ae9812459eb4dbce",
      "en": "「$$揺れる天秤$$... You alone must fall.」"
    },
    "365:2047": {
      "repository_source_sha256": "51daa684cc1b60c9c0cb678e1e0a582c685560f767b9f9aaa2bfcb75c25cb1c5",
      "en": "「You... I don't care for.」"
    },
    "365:2072": {
      "repository_source_sha256": "85f52e0e506b51c44a0f2f0baf47b5b6d45087ff39e62991d50ae390f14722bf",
      "en": "「You're growing, at least.」"
    },
    "365:2093": {
      "repository_source_sha256": "779cb1729b0be8433d9f62fcccb4431d3a6c0bd07f70f66a86233a69cd0bf611",
      "en": "「You are valuable.」"
    },
    "365:2110": {
      "repository_source_sha256": "622057b95fc218b6a586583848e1410ddb8ea5b8e66d1b1bf6f5a3f134ff9ce4",
      "en": "「A worthy opponent for the $$尸逝天$$.」"
    },
    "365:2139": {
      "repository_source_sha256": "5fe149ab59ba36059527ad1355ddb727ac3896a1247b18a17f2206de9257cecb",
      "en": "「So the mothership is my target.」"
    },
    "365:2395": {
      "repository_source_sha256": "20779fe8d4cbd731edad4260f016b36394956be3d0c2d30ba84f75cc672de4f2",
      "en": "「If you want to run, run.」"
    },
    "365:2416": {
      "repository_source_sha256": "2cb9530b100ee0429f39f2c2678422c1598856ff98d61a692f72dc05c9b17709",
      "en": "「I'll return the favor.」"
    },
    "365:2427": {
      "repository_source_sha256": "727270b964cb6ad96512c22458ad0bc65b5688f735c9b4ea0ef27ff155f59520",
      "en": "「There you are.」"
    },
    "365:2444": {
      "repository_source_sha256": "6d39204134a5d83c452ea53862a3f0acb9db91dd9c242848e6c17bbb0f1d3f66",
      "en": "「Call it obligation.」"
    },
    "365:2455": {
      "repository_source_sha256": "09937abd2a84af7715467dbf116a72424e4127de0fe8eb7ae214260deb2c3379",
      "en": "「Naturally, it comes to this.」"
    },
    "365:2472": {
      "repository_source_sha256": "45bdd0bd630a39601015231f19f5531bdd549c6cb192f9453f63837e227bfc4b",
      "en": "「Wait a moment.」"
    },
    "365:2491": {
      "repository_source_sha256": "d97fb05b28b70109af3db2a6b19b7c8b8a309a6cd32223bd795aeb0d2fd29b2a",
      "en": "「Keep me company.」"
    },
    "365:2504": {
      "repository_source_sha256": "22a0dbfab6524c4c158517dac413cf5985c6cb548803e3990e29f38299d87616",
      "en": "「This is your retribution.」"
    },
    "365:2517": {
      "repository_source_sha256": "8ee43d414daaa57955bf4f798691c07f5591e2a8d16620b041324accb9c598cb",
      "en": "「I'm next.」"
    },
    "365:2530": {
      "repository_source_sha256": "7db216cf88cebe5193a3c7829048a48e8f7a11cd87343f414aa115a4c37c4d76",
      "en": "「Leave it to me, $$尸刻$$.」"
    },
    "365:2547": {
      "repository_source_sha256": "e3815fd387b21704d8100ee5e1acac994c34eae44c85ba931ecd784eca181edb",
      "en": "「Out of my way, $$バルビエル$$.」"
    },
    "365:2570": {
      "repository_source_sha256": "c844f2f77e085eb6dd3fc95a34996d9b8bc72cc3cc263c4b30e2b65dd1fdd98a",
      "en": "「Switch with me, $$ストラウス$$.」"
    },
    "365:2593": {
      "repository_source_sha256": "d77174c2a2921384b56c226cfee89b1bc83472af47e82616a36bb43db4bd15c9",
      "en": "「I'll do it, $$エルーナルーナ$$.」"
    },
    "365:2622": {
      "repository_source_sha256": "ad47999cf1fcf4c3e31870149541131be4291c053cad215a6fcadc4c2ae26f06",
      "en": "「I'll lend a hand, $$アウストラリス$$.」"
    },
    "365:1272": {
      "repository_source_sha256": "84a30af3a433cdf4b551a02a802a98c8d699dd75f64d698bd563f4b6a568afaa",
      "en": "「You're making this tedious.」"
    },
    "365:2839": {
      "repository_source_sha256": "810d00a51648e7cab706b47208b71ad92a24144e287543c999fb76f3c3e196c6",
      "en": "「I'll go first.」"
    },
    "365:2852": {
      "repository_source_sha256": "22ae19767fc14932cf5401649309ce6c50432079b15a0937c21e5139e056a875",
      "en": "「Follow me.」"
    },
    "365:2797": {
      "repository_source_sha256": "f5fa8ba050f807d17365af8c37ca1cc354c120f90dc42b31329cdf08c9d90ca4",
      "en": "「I'll take you on.」"
    },
    "365:2816": {
      "repository_source_sha256": "e664cdc0ebc795cd5f79c34e64403f5c344de1d26ea75bafc9e44c287e624c6b",
      "en": "「No need to hold back.」"
    },
    "365:4523": {
      "repository_source_sha256": "0707b85cae71f521f144e6947c32b262b6e194d5dee36af9d409a76b48678888",
      "en": "「So it's over, for now.」"
    },
    "365:4548": {
      "repository_source_sha256": "f19070d2244b7a8a90bc00e72394016f5f5dca96ca25fb9c1790b94b21e231f7",
      "en": "「This is the expected result.」"
    },
    "365:4569": {
      "repository_source_sha256": "989c696a93022d51fd024f28b7cdd6b6a97328160c210bc0bb59ca9026018fe1",
      "en": "「So my... fight is over too...」"
    },
    "365:3398": {
      "repository_source_sha256": "74889715db57723d3002572e3c391ffcb7c71fdc11320732ad17ad28ed5ce2b9",
      "en": "「Has the tide turned?」"
    },
    "365:3419": {
      "repository_source_sha256": "bd1b1622b500906806a46fd8b87009331990cc7a780cfa7c3d1eb2fe9427a1b0",
      "en": "「So we're evenly matched.」"
    },
    "365:3430": {
      "repository_source_sha256": "a41ebb368495712a90a8810aba2bf347d1188c0daf4253e3e2e0445a90b94140",
      "en": "「To think I'd take that hit.」"
    },
    "365:3453": {
      "repository_source_sha256": "e277a4d5f329f2faf8092b3e70d85c8960a23faf1e770a7787d91e964c718618",
      "en": "「I just have to hold out.」"
    },
    "365:3472": {
      "repository_source_sha256": "244a31f1d757c489f357589dc9f1a8a2ea8b79ee4e4633b46943171e49006a04",
      "en": "「There is no retreat.」"
    },
    "365:3487": {
      "repository_source_sha256": "49f362a5846eb219fc0dc49c1bc1c65c7416165a94dc600c4d488120e46ccd93",
      "en": "「My work isn't finished yet.」"
    },
    "365:3516": {
      "repository_source_sha256": "f35d958e5fce0073ba45c9e5a635462b7a59cceb4ce1f9d43ecb3482e2b60c4d",
      "en": "「$$鬼宿$$, reduced to this...」"
    },
    "365:3539": {
      "repository_source_sha256": "7f0d35f59b60854d10030929eb03e0e4f516cc54ea0f3f33772fdf34f13b704c",
      "en": "「How unbecoming.」"
    },
    "365:3556": {
      "repository_source_sha256": "bfc7c72489375fe7a8f5977f5b78cef396d4eb6e5b15816376dd72e6871fcadb",
      "en": "「Time to steel myself.」"
    }
  },

{
  "schema": 1,
  "rows": {
    "365:3575": {
      "repository_source_sha256": "f1825024218d1be829721fe8c6cd9e38023dbf3fa1c48129254fef9b85d506dc",
      "en": "「Hold together, $$尸逝天$$.」"
    },
    "365:3594": {
      "repository_source_sha256": "0749af88c093e7ee66a901afa15eb7b79bc69047d021c7ba77139f8ca08c4c56",
      "en": "「A feeling I haven't had in ages.」"
    },
    "365:3615": {
      "repository_source_sha256": "3bbbf73aeb33fce7ea0825eddb8a5efc50bc6a4736f8870cae60907e84d0e6e0",
      "en": "「I have sought this moment.」"
    },
    "365:3651": {
      "repository_source_sha256": "5bbae4398a04f95016a1fe20873168066a0120be15431d4991c1c03f310a945b",
      "en": "「Moonlight glows clear in the dark...」"
    },
    "365:3676": {
      "repository_source_sha256": "e01037cd00cbadeda1e14d300bd2e1932b73825577dadabae439edc52fe572ae",
      "en": "「The sun tears through the darkness?」"
    },
    "365:3697": {
      "repository_source_sha256": "6a79392eec949eb35d72e89e4b6ad3a6e568f20b7564dbf60ac9da157bae4304",
      "en": "「I can't call you a child anymore.」"
    },
    "365:3722": {
      "repository_source_sha256": "ea289930d8fff2f5de00d089492d761c0ec43c56f463dd0974fd3883b7aa8ea6",
      "en": "「A soul rides within that doll.」"
    },
    "365:3747": {
      "repository_source_sha256": "706491f900a05645e473f0be6243228a1536dff184991323a65292db211ef724",
      "en": "「Is this what they call love?」"
    },
    "365:3778": {
      "repository_source_sha256": "27740a0c1b06914a72d63b8df4df12df431c45ee8ce9c9786e11d0daacdceff9",
      "en": "「Truly a being that warps causality.」"
    },
    "365:3809": {
      "repository_source_sha256": "641d41e228d836b3175950263342e7c9bc0a2c78704fc435da4322574e230822",
      "en": "「Your skill is singular, too.」"
    },
    "365:3826": {
      "repository_source_sha256": "3cc6485477e5a7e526d204f33216ac770099e50a772fc3944fbb93f347212a4a",
      "en": "「Not bad, $$ガンダム$$.」"
    },
    "365:3847": {
      "repository_source_sha256": "4d36256915e0c287c86d56dbea1512ef3c548e1b94f5caad190cf9d1ecffaaba",
      "en": "「A pilot guided by the $$ガンダム$$.」"
    },
    "365:3878": {
      "repository_source_sha256": "98055760e286a494424c54f5a5eb302dd1de1ded3617514fd2c9d4beb06856c7",
      "en": "「You truly walk the path of $$シンカ$$.」"
    },
    "365:3911": {
      "repository_source_sha256": "82c475d1f1936a1169170af8478503ba41ed9cd27b30e393179d9e7493627700",
      "en": "「The blood of the beast is coming.」"
    },
    "365:3928": {
      "repository_source_sha256": "4daed7ab909085d3dadd119a4bb556b74a88a8fbd1335d0b32831487705f21d6",
      "en": "「My body burns...」"
    },
    "365:3945": {
      "repository_source_sha256": "e3a32379298c78fac72897a3b2669f0901137b20eab242f23c9ee74d09c8847e",
      "en": "「Wings that carry their feelings.」"
    },
    "365:3966": {
      "repository_source_sha256": "34b9a2f71a9f1a23758b88b030d3d6604347e3e8ac7b8d6a4803357a9639972a",
      "en": "「The light draws near.」"
    },
    "365:3979": {
      "repository_source_sha256": "e5a718a8773c4331343514663a47576f7c3af2871a00687f0bfabdec29d06151",
      "en": "「A warrior chosen by $$ゲッター線$$...」"
    },
    "365:4008": {
      "repository_source_sha256": "6a8d5f8ade3350592e7781fe61976ca7867ddcaf3989c37753c8bb8832461702",
      "en": "「Outdone by sheer spirit, huh.」"
    },
    "365:4023": {
      "repository_source_sha256": "e0f489beea5f193b5d800edbd7f3c56b5a5e0582ae5f1c1c02c150873c97b2b4",
      "en": "「So that's another way to negotiate.」"
    },
    "365:4054": {
      "repository_source_sha256": "5b8ac59adec21263ec875e6701e2a54502dcfd988b28a2126dbb176512e96b2c",
      "en": "「Are you saying this is a miracle?」"
    },
    "365:4077": {
      "repository_source_sha256": "cee511575b74649f2c5eceb0a90ee43b537e31fe6102f7cf22ceb900b72fdee5",
      "en": "「That power is dangerous.」"
    },
    "365:4100": {
      "repository_source_sha256": "e1d25e5a884a76c710adec77ff925f76f1e3f77e5864e902c6c7bb459028bacd",
      "en": "「My heart is stirring...」"
    },
    "365:4121": {
      "repository_source_sha256": "13252821a625460369a1d7a24c11a0f8c846d2b23bd9cab891eb47dd70f98b35",
      "en": "「The mingling of waters breeds power.」"
    },
    "365:4146": {
      "repository_source_sha256": "a2ed88cf59ba885d76e5d616ecd80115f8715ae6ed548b4ef5f7b10927e6b521",
      "en": "「Fire... No, a blaze...」"
    },
    "365:4169": {
      "repository_source_sha256": "e93dd08ef5e2776832d44da406f35f7db5cea3b38efc88b591204682734606c9",
      "en": "「So you've grown.」"
    },
    "365:4186": {
      "repository_source_sha256": "cb07a58682f57160b8e110d8711a9e8e19429bcb4c64353fd7140ce3c029c900",
      "en": "「Appearances fooled me.」"
    },
    "365:4209": {
      "repository_source_sha256": "1e88d583745d3de562754875246ed53466fab8d527e4b55fdc2dad52f649a4e3",
      "en": "「A fine drill.」"
    },
    "365:4226": {
      "repository_source_sha256": "e74bb16556f2823188d65bb1b55141f29d2076350241c51ca9d22c25ca063d7c",
      "en": "「Your very existence is dangerous.」"
    },
    "365:4249": {
      "repository_source_sha256": "9ab1505ff887e2573247b580f5d3120dacc61ab73172ab2acc601c951a0b860d",
      "en": "「You've gone beyond a soldier.」"
    },
    "365:4268": {
      "repository_source_sha256": "884a35381018ca3d15f9fdeb6163f1997207b30294d508a05ed4748e40fbf7bb",
      "en": "「Fully awakened, are you?」"
    },
    "365:4289": {
      "repository_source_sha256": "ebb4939cdbb9284a2a781108fea711f8135ab49d31a7638f7eb3ccba7c474181",
      "en": "「I won't hand over my $$スフィア$$.」"
    },
    "365:4316": {
      "repository_source_sha256": "c4cd71c77722c3875df393cf29af26babee032ce592fdc78bd3a513fdc43e2d9",
      "en": "「Because you overcame your sorrow?」"
    },
    "365:4339": {
      "repository_source_sha256": "487ec59039fe55763f2381e53c58c48e55e0d8cd894de36ed5746c090ad76255",
      "en": "「We're both covered in wounds.」"
    },
    "365:4362": {
      "repository_source_sha256": "c65f4b3e3af644fe29a13026efad2eb9538a32f1254eb076938db1817825fab4",
      "en": "「Not bad, $$クロウ・ブルースト$$...!」"
    },
    "365:4397": {
      "repository_source_sha256": "30fcca4c190f5e43eb267028187150cbbacf9ff15bcae09daa07a2377ec5e45a",
      "en": "「Very well.\\nI'll play along with your style...!」"
    },
    "365:4448": {
      "repository_source_sha256": "f6208f0c5cee2f1f9c317a172c099cefe8eae6959ea5548663b1c0195ce0d2e1",
      "en": "「Awakened, $$いがみ合う双子$$?」"
    },
    "365:4481": {
      "repository_source_sha256": "16392d8835b959543c101ebaa733da32d5bc5f82c21c89daeac109af93774058",
      "en": "「That power... We need it.」"
    },
    "365:3277": {
      "repository_source_sha256": "2e878ab8fa732cfb20f540d47c0372d4297b055897c8e011195c07699500be94",
      "en": "「So that's your move.」"
    },
    "365:3292": {
      "repository_source_sha256": "13f7a471643c2c658b6c54d4a6b54abb3f5608281adc270d108a40661e7df817",
      "en": "「Quite a jolt.」"
    },
    "365:3305": {
      "repository_source_sha256": "5a2e2e3b1323a099f9b3eeebc6a22a54168f02ac1b9feb3f3baf5fa7e0cfbeeb",
      "en": "「Not bad.」"
    },
    "365:3318": {
      "repository_source_sha256": "48f1722c804180387a18b41888328b51eadd37ecdcb61f0ca8c87c63ecef0424",
      "en": "「I'll acknowledge that.」"
    },
    "365:3337": {
      "repository_source_sha256": "2c586f515ff725841efdb493b0ed6eafd159e4cea57622290d770b71b8e8c0c0",
      "en": "「I need to revise my view.」"
    },
    "365:3358": {
      "repository_source_sha256": "6516764cabf8ae6310e99432743107177f772e0819f9e8187a1af5e1380ae03e",
      "en": "「Fine tenacity.」"
    },
    "365:3373": {
      "repository_source_sha256": "dd45b107dd80a552b53b3de76fbadcc329dbf28077ae92fdd725edda88ae2169",
      "en": "「Bit by bit, things are going off.」"
    },
    "365:2990": {
      "repository_source_sha256": "6df51411dd6c92b6eade72e4dee40fc3ce17b645fe55fe9d320cef11135c668c",
      "en": "「So you landed one.」"
    },
    "365:3003": {
      "repository_source_sha256": "3189560ade99642c23071839286004b5c5adba5ffdf49dc4e92b3e9b45ba5c18",
      "en": "「Meaningless.」"
    },
    "365:3018": {
      "repository_source_sha256": "f6498d282720173f724c5a919c9154c3ed49030a3c26daf1139a38cd76d55340",
      "en": "「That can't be called a wound.」"
    },
    "365:3037": {
      "repository_source_sha256": "e4060e29e4e3c9ad9a93fdbd9f3645fa89e87b15d6703ea533a8de982a357afb",
      "en": "「Nothing changes.」"
    },
    "365:3056": {
      "repository_source_sha256": "0d96e69d050072012837bc4516c842ef0fc4936b650e0c18be358fa7a1bf7f10",
      "en": "「Nothing happens.」"
    },
    "365:3073": {
      "repository_source_sha256": "6e494ebf4cdba16a445fec6f02a2e68428a6e3bfc8e10ab021bb76997a07771e",
      "en": "「No harm done, then.」"
    },
    "365:3088": {
      "repository_source_sha256": "47dfdbbde2a5405d5f4cd5b54509c6ee34b653add2bdd07165f5bbfee589cf69",
      "en": "「Is that the extent of your power?」"
    },
    "365:3117": {
      "repository_source_sha256": "ea49a33470e161adc071097c6549b60db068da64598fb9a6172aa379c0697c6b",
      "en": "「Did I misjudge you?」"
    },
    "365:3134": {
      "repository_source_sha256": "908321843c1a5472e32d4be329dd8489ba6e513ad5986d27432208e8808d2730",
      "en": "「This saddens me.」"
    },
    "365:3151": {
      "repository_source_sha256": "902002bea0396ba6336b3a1cf7e3f8e2cd1ca3511dff8f5236cdf53af05acbfc",
      "en": "「Is barking all you can do?」"
    },
    "365:3168": {
      "repository_source_sha256": "5da5fcea8407b06d34e6241d744b2dd03a0fa8c07ee8c8d437ee3c88ad5e745b",
      "en": "「Is that your will?」"
    },
    "365:3193": {
      "repository_source_sha256": "c9e42862f13e2609401b1c1c53c49e4a7d9fd052695afe7c96161b2fc9e23076",
      "en": "「Is that all, $$クロウ・ブルースト$$?」"
    },
    "365:3228": {
      "repository_source_sha256": "746224c050d9e09fca863bc7c016001e4a9a09d41107f816775f5a6979d5b508",
      "en": "「How disappointing.」"
    },
    "365:3245": {
      "repository_source_sha256": "e92b4599da5c81fb0889b44fe864b906805aae8d6fb994d6f805a8426d781b18",
      "en": "「Weaker than $$ガドライト#pilot$$?」"
    },
    "365:2899": {
      "repository_source_sha256": "0f375e88b86be718b39f0daec758545ccb58d84840f2e015a07d7af05ced14da",
      "en": "「I see.」"
    },
    "365:2910": {
      "repository_source_sha256": "db6f887d4fea3a0c50fca58ea973d266f9460990241e0d6b712506ed7d98aabf",
      "en": "「I'm over here.」"
    },
    "365:2927": {
      "repository_source_sha256": "a303fa99e2f4ee8c67f872338efe8de7374e4826abc61a1495f1516771c64934",
      "en": "「I don't understand.」"
    },
    "365:2944": {
      "repository_source_sha256": "95577cf76c84d7d66a212066758117ac8471941651698227ffc40d83da9de71a",
      "en": "「Led astray by the will-o'-wisp?」"
    },
    "365:2967": {
      "repository_source_sha256": "718044548b8662c9eea1fdfd5799aadc6a4eff40c205ee8e6860ad421619040f",
      "en": "「It won't reach $$尸逝天$$.」"
    },
    "365:4596": {
      "repository_source_sha256": "953337b8406735d5f49f892f02081103bbf598943a01b1412a4c19f24706672d",
      "en": "「I have nothing in particular to say.」"
    },
    "365:4617": {
      "repository_source_sha256": "dd7aedb43a29f09ba7582c6171f32b173a2ba023954a35142bcd7ac85e2e90a2",
      "en": "「But please keep playing. That's all.」"
    },
    "365:2865": {
      "repository_source_sha256": "55ebacf685a2c18c3e973985fabd39119e3164cc84b99fc93a19c9f224981f7b",
      "en": "「Bad position, huh.」"
    },
    "365:2653": {
      "repository_source_sha256": "5416d8bc0326b53b7cf6756c2ce4492451ffe4a5e7661563037e030d31609322",
      "en": "「Stay back.」"
    },
    "365:2670": {
      "repository_source_sha256": "fdc1be7d62d0184ab4a1483ee6f91d0f16d5259720e77cea0e372772aa6a3f3c",
      "en": "「Fall back, $$尸刻$$.」"
    },
    "365:2685": {
      "repository_source_sha256": "857d873ccf9d3051e899f46fef4083cb54a9f6d20b0aca1bf671d9ed3a8f57b1",
      "en": "「Pathetic, $$バルビエル$$.」"
    },
    "365:2710": {
      "repository_source_sha256": "8207ec8821f8fd483c76272ea2f7dee87ffd4f2072499088ec1ac4aa37fee199",
      "en": "「You overstep, $$ストラウス$$.」"
    },
    "365:2735": {
      "repository_source_sha256": "d6fe4c5e1dec2ec1fd22aac236249e075542c6bc2dde0bc970fceaf93de723cd",
      "en": "「Restrain yourself, $$エルーナルーナ$$.」"
    },
    "365:2764": {
      "repository_source_sha256": "53ef45630e137e48002af1bd6cff2b735abe2250252c27d8f7c955095ba3e093",
      "en": "「You must live, $$アウストラリス$$.」"
    },
    "365:2882": {
      "repository_source_sha256": "749c47e56d1c0a5574e00572d54b66a5404296b05cfa4faff6a74a0ea12ebf31",
      "en": "「That's not like me.」"
    },
    "365:403": {
      "repository_source_sha256": "9b2bfae4795a4253b72060fe4d3f275ad78984d590a98df571b0e4f69bc92c5b",
      "en": "「Kikoushou!」"
    },
    "365:522": {
      "repository_source_sha256": "5ae92bf391e9a6dfa11b9d55bb64d56ce32066d2e8c966f1d422b42986f7c908",
      "en": "「Perish.」"
    },
    "365:529": {
      "repository_source_sha256": "ef8d8491c1982b82c96efe26076a5f6d5b906f648639454ab238c75374fe7ee1",
      "en": "「Sever... shade... lesser... karma...」"
    },
    "365:550": {
      "repository_source_sha256": "ec2f5e4c5e224027b4eba958d9149f03c971845697734bc62bc630fc4e5b405c",
      "en": "「Prison... end.」"
    },
    "365:2171": {
      "repository_source_sha256": "5da61d627705adc3478875c4709674ced7a098a3e8bbdd62cf1bddaa13d3a915",
      "en": "「Bind.」"
    },
    "365:2178": {
      "repository_source_sha256": "3f4d02812b5d73ab562d574730d85234bc07de91d26e929824e384317d1b9f4f",
      "en": "「Devour them, $$尸逝天$$.」"
    }
  },

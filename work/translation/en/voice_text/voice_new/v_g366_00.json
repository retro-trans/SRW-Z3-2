{
  "schema": 1,
  "rows": {
    "366:11": {
      "repository_source_sha256": "f4f3c6500ff6df0dcf55641d2a8696bbf2466677b73b28e359898c4a6acb4d87",
      "en": "「There is no need for idle words.」"
    },
    "366:40": {
      "repository_source_sha256": "decea28e871d5ac0e565d24cb3fbd56f01b70def5fd5b62acdde7df13791f22f",
      "en": "「Fates that never intersect...\\nThat is what you and I are.」"
    },
    "366:91": {
      "repository_source_sha256": "2bb1a2dcfc38046b339db55838d1b1a5f15cdf6045b50251fcb57b83200027cb",
      "en": "「All who are born into this world\\nfollow the same fate.」"
    },
    "366:144": {
      "repository_source_sha256": "866b8defb5a1e4f05d4557de0870ebe52233e0f525e25963457fd88eebb28b57",
      "en": "「All is the flow of nature...\\nI am one who drifts upon it.」"
    },
    "366:197": {
      "repository_source_sha256": "2fba52f20cc58056e9b84d82d70d768c8f697b50e441220d044e07cd21a8dc7b",
      "en": "「The mission I was given\\nis to eliminate you.」"
    },
    "366:246": {
      "repository_source_sha256": "6cf5681ea6771b62128ca873cf3e58f27de14cdabfb85b9d62ea33e9beb42f77",
      "en": "「I simply carry out my mission.」"
    },
    "366:277": {
      "repository_source_sha256": "d55d9d1a01a76b43a7db80181794b11423bcc944a007cb453360d25a4c698cd3",
      "en": "「It is futile to beg me for mercy.」"
    },
    "366:308": {
      "repository_source_sha256": "18cd349a67b4bed273bbf1062ceea809de2c7caaf2fc6a1ab09f481c87f5230e",
      "en": "「I ask for a bout with you.」"
    },
    "366:335": {
      "repository_source_sha256": "af80ad242fce17761adb83837ae7f7fe02d5a283b937c3d250e02cfb289fe00c",
      "en": "「Your life's flame is flickering.」"
    },
    "366:374": {
      "repository_source_sha256": "a4801a791d5c8f128373af9801ada725e04e87cbb69661b2f3e91293a12e339f",
      "en": "「Your overflowing power of life...\\nAllow me to see it.」"
    },
    "366:423": {
      "repository_source_sha256": "ae5b5ebde454fbc22bee5d46fc397ee74c7f645bc8afb82e21a5f1848b7353fa",
      "en": "「I'll lead your soul to the underworld.」"
    },
    "366:460": {
      "repository_source_sha256": "892a414d488ad6003d10c989837199a2917a7c2289338f2ebe474891b78e3af5",
      "en": "「Your soul is lovely... and fleeting...」"
    },
    "366:499": {
      "repository_source_sha256": "2888bb5b0e51dfb3f831af0d0f4860641073363dca112c50f5f691343777a1d5",
      "en": "「I'll guide you to the next world.」"
    },
    "366:534": {
      "repository_source_sha256": "215cbfbed4673edadc9568db8ae31c5ec3aaf2c3c7d0bd36cd35ad7293ec4747",
      "en": "「Another frail life-flame goes out.」"
    },
    "366:573": {
      "repository_source_sha256": "88d683ca089ac73754215926ba2e7bf0533917a5c8c4de89f8c6081f64b63a07",
      "en": "「The Corpse vapor is enveloping you.」"
    },
    "366:610": {
      "repository_source_sha256": "7a62c1e7b5884de905529d7d4076f8bab64f123b3a3626243f3936866c19fe19",
      "en": "「I shall fulfill $$鬼宿$$'s duty.」"
    },
    "366:649": {
      "repository_source_sha256": "8a7eeeecdb2159e4cc5cd9a1f256d8a5b0c1f79e4304dad753460e88ca049a73",
      "en": "「I will no longer hold back at all.」"
    },
    "366:680": {
      "repository_source_sha256": "460f6e96927a0ed2acbb5f456459cff9a32d4f472bb4f086437538533348acc9",
      "en": "「You may be beings\\nwho bend the laws of nature.」"
    },
    "366:729": {
      "repository_source_sha256": "ca492fa6136578bbc87fb7e31ac549eaca32d5478b7a98f14b872a61d10216bd",
      "en": "「That attachment to life...\\nAllow me to sever it.」"
    },
    "366:778": {
      "repository_source_sha256": "ad5d97695df890a46ad39c98b5a33e6544366fbd81ff75bc056ce192265c5dd5",
      "en": "「Your dazzling lives\\nare melting into the darkness.」"
    },
    "366:895": {
      "repository_source_sha256": "396b7faf936f5f28e0445f48cb7847be3412bae0ebd7f3d454665b87af95db52",
      "en": "「Women or children, I show no mercy.」"
    },
    "366:926": {
      "repository_source_sha256": "d9309b9241eff2d1fc92bbc4ea9ff83024eb631e5ae513390d3414c3d8904577",
      "en": "「So you'd throw away your last years.」"
    },
    "366:967": {
      "repository_source_sha256": "46fc2eb9238477a75c9dd9db1c4131f11b6a736e82ccd7761b69d69ac448377f",
      "en": "「Power that beat darkness... Yet...」"
    },
    "366:1002": {
      "repository_source_sha256": "7730069dd971737fa319ac656f28d9e0aa474cd57a8f646bd50f229323e490ed",
      "en": "「Even power that warps causality\\ncannot defy the laws of nature.」"
    },
    "366:1057": {
      "repository_source_sha256": "715c4686596d69c8f9d9d3a83e7c5cca1e5aab4c268db0a8c4ad63a4f05195c1",
      "en": "「A being that warps space-time...\\nSuch a one is not human.」"
    },
    "366:1110": {
      "repository_source_sha256": "640ac3ce236bfe89267bb4b812c9a0c34d1a7d4fa6e6e9d810174d6f950c36fd",
      "en": "「Let me see the power of the $$ガンダム$$.」"
    },
    "366:1153": {
      "repository_source_sha256": "c942078a696899499e1505cea5b33ba3953ed6407a00095224184a5c9d318681",
      "en": "「$$ガンダム$$...\\nThe future it brings is meaningless.」"
    },
    "366:1204": {
      "repository_source_sha256": "9e78c6df309e4b5c82f911129e664052460fb611bd2c773956d704bdca17b4f9",
      "en": "「People die. Accept it.」"
    },
    "366:1241": {
      "repository_source_sha256": "c5b723d7a908add7eeee904ad1e2eaf2d24433dfd47a8f8212a6e1bfa8df8236",
      "en": "「Someone dear to you\\nawaits you in the eternal realm.」"
    },
    "366:1296": {
      "repository_source_sha256": "450272ea1f6e87f8bad451f222c7abf3b9f29d51f00595a67d1121728bfb3c9a",
      "en": "「Death is not loss, but peace.」"
    },
    "366:1333": {
      "repository_source_sha256": "14f488f837da6269ea03a70a73616fd7c452da455c5e8a089993d0d357acdf88",
      "en": "「You, who can feel people's hearts,\\nmust understand my role...」"
    },
    "366:1396": {
      "repository_source_sha256": "8e766358a0ba8f0ca926714562df4c96010de5ecda14154f4be2e3ad30ce1614",
      "en": "「Once they lose the vessel of flesh,\\npeople may understand one another.」"
    },
    "366:1455": {
      "repository_source_sha256": "e939dc94ea2fe350253b1063d3eed5a1d5b75c89754e9b144b9377f085ac0584",
      "en": "「That machine\\nis haunted by people's passions.」"
    },
    "366:1504": {
      "repository_source_sha256": "0946da3b3353ce08fe3e6e0d7df1def519ac614312889e8bc41f37348bd1e875",
      "en": "「Miracles do not happen.\\nAccept your fate.」"
    },
    "366:1553": {
      "repository_source_sha256": "4ffd39c112c61570fe80b60037fdab73f44d0117bd2d0d8999cb34e592676288",
      "en": "「This song... It's like life itself.」"
    },
    "366:1590": {
      "repository_source_sha256": "6f4269867aabd1ec9a6c53d413111e6df93296e03e2923a9887994b70e6eb5a4",
      "en": "「Wings... freedom... life...\\nThe time has come to cast them off.」"
    },
    "366:1641": {
      "repository_source_sha256": "cb3dd879ee295491b44f575548feed610aa40992c9ea5df7e3b9c7314976b042",
      "en": "「To resort to forbidden power...」"
    },
    "366:1672": {
      "repository_source_sha256": "b45334b0e9429850f7f427b5b90481491302e28d17b0d3cc5703125f2009a6df",
      "en": "「The God of Light's power, foe of $$ハーデス$$...?」"
    },
    "366:1713": {
      "repository_source_sha256": "e4de4bd5dbdeb54634d64201c88ac70ed374cbb3f99e50b5f0f6b258401673ed",
      "en": "「Everyone dies.\\nSoldier or civilian alike.」"
    },
    "366:1768": {
      "repository_source_sha256": "77ee0f7057e0691a6d795284af310d06354a6de97e9e5cac3fcbe62f34df1056",
      "en": "「The natural order of the world\\nwill not be changed by your words.」"
    },
    "366:1817": {
      "repository_source_sha256": "75c5153ccc1babe85a2406e053893d5b894ba9d17591a6836e67c1104998842b",
      "en": "「Your power seems beyond any human's.」"
    },
    "366:1860": {
      "repository_source_sha256": "b855735ed0dc28cfb7612aa36e9669a42bf2cb3ab9566d6cfff5ee6ebfc34c09",
      "en": "「You shall sink to beasts once more.」"
    },
    "366:1901": {
      "repository_source_sha256": "50263538bd0748636683ecc3b1d5ac7c20b5fc216fda21935850d7e80c0d2c85",
      "en": "「This artificial human... beyond the natural order.」"
    },
    "366:1944": {
      "repository_source_sha256": "4f4846825beae6b485dc6d31569dbb4ec9e9ea27816542c30df068371e1c2f63",
      "en": "「Even the sun's radiance\\ncannot light eternity's darkness.」"
    },
    "366:1993": {
      "repository_source_sha256": "c87e6b70076c384a583bb329200d5aa56efc8964cdb8dd310fa0d605efc52c8b",
      "en": "「Moonlight is at its finest\\nin the eternal realm's darkness.」"
    },
    "366:2046": {
      "repository_source_sha256": "ad6e6111b4061708d7124425886b19bd7f2970cbf4f47cf3b7b3188c7d212ea7",
      "en": "「Mechanical Angel...\\nSleep now in eternal darkness.」"
    },
    "366:2097": {
      "repository_source_sha256": "a5bd0232a14c40830323c9ebf208c45058f5b1451eda9f5eddf0e1d5764c9dac",
      "en": "「A soldier's future is eternal sleep.」"
    },
    "366:2136": {
      "repository_source_sha256": "518dc5f901ce8cf54a75ada1afc7c476d84723540c1837695c59a83c126504de",
      "en": "「Let me see how much you have grown.」"
    },
    "366:2179": {
      "repository_source_sha256": "25eb669cc74ac7fc7a54a8722920a58761eb53a19fa891b81e8fa5b40d2f6143",
      "en": "「Beyond even the reach of sorrow...\\na deep, black darkness, for you...」"
    },
    "366:2232": {
      "repository_source_sha256": "4f3434f883dbfa586488cfa30b89aacaff122c614d297adfe2605a75108adfa7",
      "en": "「Rest now, $$傷だらけの獅子$$.」"
    },
    "366:2269": {
      "repository_source_sha256": "dbbf0bb0962e189d49127ea1bebf9f7db7023fe2818ba3ce0c84ed02f7da083a",
      "en": "「$$揺れる天秤$$...\\nI shall still your swaying forever.」"
    },
    "366:2322": {
      "repository_source_sha256": "20b796e4b7d9eea60ccd3a9e785a0d1afc9de92a024a735439cd667613f645b0",
      "en": "「It seems you are someone\\nspecial to $$尸空#pilot$$.」"
    },
    "366:2371": {
      "repository_source_sha256": "e95de36a6975840f3b9d1783245d81239ee516179383732da5d86c5c1d4b53e0",
      "en": "「The power that defeated $$ガドライト#pilot$$...\\nAllow me to see it.」"
    },
    "366:2420": {
      "repository_source_sha256": "93cd2c1c194952ee2444ecc99cdd64b9c627b3599e46874103d4565d01186282",
      "en": "「The strong and the fierce alike\\nall end up in the same place.」"
    },
    "366:2469": {
      "repository_source_sha256": "a99a03b5d8bd2d4836350665e18127d567557ab5c34eee33bdb807447f9510e5",
      "en": "「No matter how much power you have,\\nsome things cannot be resisted.」"
    },
    "366:2534": {
      "repository_source_sha256": "46e368106672642c3778b9b438d38c8d29c36de0a7e485bfd77edcf8ab696270",
      "en": "「I will defeat you, then lead\\nyour whole unit to the underworld.」"
    },
    "366:2587": {
      "repository_source_sha256": "c3eaec0c4440348a8ed11a9a72fd0212ea5990be5568d7260529edc670b793ff",
      "en": "「Attack target set: the battleship.」"
    },
    "366:3101": {
      "repository_source_sha256": "55875842a986fae90e2f21d0d881c058c10844910e84cafd48afa736de7b2df8",
      "en": "「Then allow me to attack as well.」"
    },
    "366:3136": {
      "repository_source_sha256": "8d93fc35cf11b5862e409f66de910d2f9a62878ad71e943a6c96ec5a81fe78d5",
      "en": "「Allow me to return the favor.」"
    },
    "366:3167": {
      "repository_source_sha256": "88c3686b41628a47f7f2f81fa3770e2c2708a35c7771f5ffea835fcb08791449",
      "en": "「This is simply the way of things.」"
    },
    "366:3202": {
      "repository_source_sha256": "c1ca136f0c35b0a5e0e93502ca6ea9d6ba80a5d5a69b4fc0371f07f5f084a568",
      "en": "「Yin and yang... Attack and counter are one.」"
    },
    "366:3241": {
      "repository_source_sha256": "364b89616aa50332d8f88928a0a7d3c5d8958437f5779915c7563f01236b7412",
      "en": "「I cannot let that pass.」"
    },
    "366:3272": {
      "repository_source_sha256": "92c38cd104854798c6eb503f7c550d8391aaae5506f19517235d9b54b7bd198a",
      "en": "「And where do you intend to flee?」"
    },
    "366:3307": {
      "repository_source_sha256": "ec9413c1354fa216a0ea7f5227338b446d5e757be5beb48b9507329604484e3a",
      "en": "「I, too, have something to give you.」"
    },
    "366:3346": {
      "repository_source_sha256": "86027749c9b6f5b4b57478c01505ccbb3458adcd6f5deb7a637124c3518de90c",
      "en": "「The moment you tried to touch me,\\nthis outcome was decided.」"
    },
    "366:3403": {
      "repository_source_sha256": "e2420a8ab0526f474017feb1a39b95fbdb635abeb3ed2ce1a221eeb0c71d2ea8",
      "en": "「Allow me to continue.」"
    },
    "366:3434": {
      "repository_source_sha256": "c77a2da065c351673894783f738243612537d285d1210ce2f6e63d06566c082f",
      "en": "「I simply take the surer approach.」"
    },
    "366:3467": {
      "repository_source_sha256": "52a3714f5a166acf31dc5b08bbb7831baff5d7bf7e4a62d8821cbdd9277f98ab",
      "en": "「You hardly need my help, but...」"
    },
    "366:3496": {
      "repository_source_sha256": "003e5de7e97279f9c424b9eed3b8f9bde63f9e7b1485ba37616413a211d80265",
      "en": "「I will take it from here.」"
    },
    "366:831": {
      "repository_source_sha256": "c32493c7fbf74ccbf3a65f35dfcf0176bc576fdbc9f7f04a3f5903bba6ff6ced",
      "en": "「That was not the end.」"
    },
    "366:862": {
      "repository_source_sha256": "6a5c02b1b431e4dc4f95f463062ee363e1afe0e0897e6d461cb7e993c12a7520",
      "en": "「If I failed, then once more.」"
    },
    "366:3789": {
      "repository_source_sha256": "45272faf48116620db3c7717dc35c09a3f3a35f002031605520b2268c79566ea",
      "en": "「I shall draw the enemy's eye.」"
    },
    "366:3818": {
      "repository_source_sha256": "bfbae5a21e9878aea01f90382f34c7ebd926b41fc670eb87a6e0cad0c3e7d1be",
      "en": "「Leave stalling them to me, please.」"
    },
    "366:3849": {
      "repository_source_sha256": "058e30a8404689bc25b201f3418569af07355503af641024102961405e801cd0",
      "en": "「Then I shall go first.」"
    },
    "366:3876": {
      "repository_source_sha256": "40692f513325992e252442b7b6bf1e96b4c43303db17891ac208a5c8c641ed88",
      "en": "「Please follow after me.」"
    },
    "366:3643": {
      "repository_source_sha256": "a7af7793b382c30e4664512961c159b41c7fcf5731314b904446af9c1402a8c1",
      "en": "「You and I... Such is our fate, then.」"
    },
    "366:3684": {
      "repository_source_sha256": "acde71ab68a128214e344ad033f32e9015a6552b4c530bb730f1eb127354a0d3",
      "en": "「Attack target confirmed.」"
    },
    "366:3713": {
      "repository_source_sha256": "fe1fc7245c5e9bf443b3a82b58920cf968a013ebb0f0153fafafed0e1ca8379b",
      "en": "「I will play my own part.」"
    },
    "366:3750": {
      "repository_source_sha256": "38cd98fb28cd1b47349a96da2e97d49be653663b77e65b0e3924b7f0333cb884",
      "en": "「Then please be my opponent.」"
    },
    "366:5315": {
      "repository_source_sha256": "0aad0fa1982a45814e93216bf4c042520c0a92eced8d31bdb3c4966072ffd2a1",
      "en": "「Your power of life...\\nis shaking my soul...」"
    }
  },

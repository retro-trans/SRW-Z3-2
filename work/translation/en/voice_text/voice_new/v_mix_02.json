{
  "schema": 1,
  "rows": {
    "89:2054": {
      "repository_source_sha256": "fe2ece604bbd7ec7f60980425775cec8234cefc49303a6b1e1b0d5f5639eb661",
      "en": "「What good is reviving $$ジオン$$ now?!」"
    },
    "89:2091": {
      "repository_source_sha256": "bf9d5b6961f7bdde77af7dbfa7d4d43fad18e9ad8b9869c062741345d1ee735a",
      "en": "「I won't lose to puppets\\ndancing for $$フロンタル$$...!」"
    },
    "89:2192": {
      "repository_source_sha256": "c4027e2930c20e4f8716eb70f8bc44819f9b6888997f187ab003d2f5ee5780d9",
      "en": "「I already know how you people work!」"
    },
    "89:2233": {
      "repository_source_sha256": "f42f7ed3f92b63ae48008d79d6ab2b93a7f59eccb88307d8e26a166fc48d7005",
      "en": "「I watched you up close!\\nI know your habits!」"
    },
    "89:2284": {
      "repository_source_sha256": "ac1188c9abedbde020f92cd11392ee687fd798634f5ed213076c5f7b4d900229",
      "en": "「This is war...! Don't hate me!」"
    },
    "89:2450": {
      "repository_source_sha256": "53c46af39a54d61b90f1f3a92c482134d73e8edf8758896798f08fe6d53b4d2d",
      "en": "「In the end you're just like\\nthe Colonel, an egoist!」"
    },
    "89:2505": {
      "repository_source_sha256": "05c86ac44269a2b07f3a4276c106e7fed896c5b9e141dcf79d86a3f63c26d47f",
      "en": "「That kind of thing is outdated!」"
    },
    "89:2540": {
      "repository_source_sha256": "05bcb252fc0f5259dcf8dda591683979c38ff2339d465ab54f99128355979e70",
      "en": "「I've finally made it this far!\\nWatch me, $$クェス$$...!」"
    },
    "89:2597": {
      "repository_source_sha256": "bd554a9ad3811514adb358ae4eae7a75edd3953ec8bcca8bcd2598f6648ef708",
      "en": "「You've had your way long enough!\\nIt ends right here!」"
    },
    "89:5216": {
      "repository_source_sha256": "d23f3266bc618ab0c8a20506f4a6a4af15b109daaa52b0efb84b41a7c8d39970",
      "en": "「Ugh, Funnels! The hottest missile!」"
    },
    "89:5294": {
      "repository_source_sha256": "1d772151034b709351d7911b286f19ffc0218656ef63ff943db26299310c01e3",
      "en": "「If you hear this, you recruited me.」"
    },
    "89:5353": {
      "repository_source_sha256": "9b0a9ac975264c9d6377c1ac1069600282c9ee88e94c573c5e548da5aa5f2a41",
      "en": "「Then I have a favor to ask you.」"
    },
    "89:5386": {
      "repository_source_sha256": "c38d81a7468722a6193b07f0b2ee43ee4da26d0291fe3bec5450a7437c949914",
      "en": "「For $$クェス$$ too, I must prove I top the Colonel and $$アムロ$$.」"
    },
    "89:5467": {
      "repository_source_sha256": "b6b23673963492f45fac1b2434dd191949d9faba65f6f00bd2ae4a74de3720ff",
      "en": "「Not just them. I can't lose to $$カミーユ$$, $$ヒイロ$$, $$ガロード$$, $$ロラン$$, $$キラ$$, $$シン$$, $$刹那$$ or $$バナージ$$ either!」"
    },
    "89:5592": {
      "repository_source_sha256": "c501aa4da777573ab9f4973bf2e508038c26fbfe2d92ea766532d8e64071b59c",
      "en": "「So use me. I'm counting on you!」"
    },
    "89:2891": {
      "repository_source_sha256": "b905604972d5d2fd07de740f6982f0f14d42c67049a826313f1e05fab8ad8ede",
      "en": "「Do I really have to use this thing?!」"
    },
    "89:2924": {
      "repository_source_sha256": "86a349a000c5d303a1a90ef64c909fc98739b5653aaa49f9e808bf17c132fa2b",
      "en": "「Activating the $$月光蝶$$!」"
    },
    "91:526": {
      "repository_source_sha256": "f35f20c7dcc9078456b72d24f5123cb80ff7470333aaf4dbdc575c37e31642c4",
      "en": "「It won't go the way you want.」"
    },
    "91:2880": {
      "repository_source_sha256": "e64dfed0faa12c456813c5b2ae86df9311153d68dc337f94110648f0573bc1b2",
      "en": "「Revived? Then I'll kill you again.」"
    },
    "91:2917": {
      "repository_source_sha256": "6d8459b7cc9dbbd5dc9703023823e3075e332db4bafaa8f3ba80d7ea678d3b3d",
      "en": "「You and I are no different.」"
    },
    "91:3066": {
      "repository_source_sha256": "c7264a39e6733078acc03551c4981ea9aaaa707ffc31a94ce6e631ab12a0b273",
      "en": "「I'll just take back what was stolen.」"
    },
    "91:3103": {
      "repository_source_sha256": "f2002a5b472f0b48b29a03cfdae8f9ac8fe707a979ac8cb09903c8de7e4caea5",
      "en": "「I dislike powers I can't understand.」"
    },
    "91:3138": {
      "repository_source_sha256": "49fbf22faa25fbc0826e8609f63c8b7a34785b2c2a0ba34441362db4f2cca2e6",
      "en": "「A god... And what does that matter?」"
    },
    "91:3173": {
      "repository_source_sha256": "fced08d0c57ea723dbb41f7e454ebbaff2eabf09e4739691efe5cb229f06e475",
      "en": "「So that today leads to tomorrow...」"
    },
    "91:3325": {
      "repository_source_sha256": "e7afc4f5e6151f53a5b692555039182a7298e9bfad1bc7a7a2c034c1098c0477",
      "en": "「Leave the rest to me, $$テイタニア$$.」"
    },
    "91:4271": {
      "repository_source_sha256": "0c77014a4014e98cdfb9aa98ce39ffdb854b353a6c185027dfa94dd0206ebd7b",
      "en": "「...$$フィアナ$$!!」"
    },
    "91:2150": {
      "repository_source_sha256": "f3334456901e745ce04cb4dbdd76c12c43965dd537ff774077b63add66c89554",
      "en": "「...You should rest too...」"
    },
    "91:2169": {
      "repository_source_sha256": "a4b7b1b910fbe740253381178c0e0266084e6c12481c24412ec3af764b6080f3",
      "en": "「Wave after wave of reinforcements... An endless battle had worn everyone out.」"
    },
    "91:2234": {
      "repository_source_sha256": "518392169f107d985b25d51e1d1bb51b252a87c41b182b44e1f30c98e6c3fb79",
      "en": "「Fatigue dulls judgment and invites grave mistakes. Before I knew it, I was in a dead end with no way out.」"
    },
    "91:2319": {
      "repository_source_sha256": "da74e6a115d11bf935babf93d1b0fe574f984e35baef964c7adae0a183654b6a",
      "en": "「No allies anywhere in sight... Yes... once again, I had stepped into hell alone.」"
    },
    "91:2402": {
      "repository_source_sha256": "2b27634c40117096725f12eeb7747c706b3954f8e223b9df613fc7e508ef5222",
      "en": "「...If you don't want to end up like that, rest now and then. At least for a today that leads to tomorrow...」"
    },
    "91:3459": {
      "repository_source_sha256": "4a370dcf7f08a7b344613e8ed7015ad253b7039198e1c805de2194915bd9e927",
      "en": "「No need to push through the pain.」"
    },
    "93:553": {
      "repository_source_sha256": "2807546d93d8f7392f10a39af96afccd9ac2b557087f2ccd23e5c70cc76b7ba6",
      "en": "「Impossible! Impossiiiible!!」"
    },
    "93:592": {
      "repository_source_sha256": "b12c88b54df47531f8a0010e074cca8eaa0c1aecd645be2bdb034d679ebb6a67",
      "en": "「I am...!\\n$$ギルター・ベローネ$$!!」"
    },
    "93:11": {
      "repository_source_sha256": "ce5730ee05089fbf64c47f53f9c631ecff39a3b345036a68fc1a12a36d9deb6b",
      "en": "「You...! Youuuuu!!」"
    },
    "93:48": {
      "repository_source_sha256": "a21d2c44f1f6a25dfa87540db61a0d3db6f1546d6e40c92a259bddf079e7a3a7",
      "en": "「I-I am $$ギルター・ベローネ$$, I tell you!」"
    },
    "93:89": {
      "repository_source_sha256": "08d96765b704fc864a89b13adab70652a239fad9097632fc08c9a4050e4835e5",
      "en": "「I hate it...! I hate everything!!」"
    },
    "93:118": {
      "repository_source_sha256": "28ba220ec8de73846b1db17ba98fc3feabe700ec8c7eda5b7d9731eab41cab1e",
      "en": "「I'll erase it all!\\nEveryone who defies me!!」"
    },
    "93:169": {
      "repository_source_sha256": "defb1a2e25a443c9914a88109a3e6c81c96b54d90b77d58caf019f1f392fd6a9",
      "en": "「I hate, hate, hate, hate, hate...!\\nI hate it all!」"
    },
    "93:218": {
      "repository_source_sha256": "e135e894024cda09ea859de3baec7165f712f67823ab568d6ecbdbdfbfa885de",
      "en": "「Out of my way!\\nI am $$ギルター・ベローネ$$!!」"
    },
    "93:271": {
      "repository_source_sha256": "bae39d91f5ec5429f783b1af84d232f8ee2b68503c3f7e16568817469ca8f108",
      "en": "「Don't mock me!\\nI am $$ギルター$$!」"
    },
    "93:320": {
      "repository_source_sha256": "3fdf8fa6b25b7e18620d57ac7282c3cc1611b9080ff2eab25c8d0871db0cf4f6",
      "en": "「Damn youuu!\\nI'll kill youuu!!」"
    },
    "93:369": {
      "repository_source_sha256": "72bf35d017b8707872ac4a5bd1adc763fe1bbef4438b8a8f36c34b8078ad21fd",
      "en": "「Hahahaha! Diiiiie!!」"
    },
    "93:408": {
      "repository_source_sha256": "525070faad5dccbbfef2537ea5f484f78c04c36f5c7ae5e2d002061bbf151630",
      "en": "「Every last one of you!\\nAlways getting in my way!!」"
    },
    "93:457": {
      "repository_source_sha256": "08c70f00b2575f848bf53625115af419856ff101273973811dcdcb76cb751d75",
      "en": "「I'm a genius! Beloved by the gods!!」"
    },
    "93:500": {
      "repository_source_sha256": "b1276b0fdff3060355394a1845a82871cf4a4523462b8a420cbfa1c4047d5d31",
      "en": "「Unforgivable!\\nI'll destroy all who mocked me!!」"
    },
    "98:3881": {
      "repository_source_sha256": "48d0fe34861fbcde6daceadbfe9249f7338d45e080ece04d1257405e34fad7a8",
      "en": "「There's someone like $$ギュネイ$$!」"
    },
    "98:4966": {
      "repository_source_sha256": "1c46c11a553af2bd2da83547009d1e38c72cb09adb3042519c528a81518bf788",
      "en": "「You look meek, but you're good!」"
    },
    "98:407": {
      "repository_source_sha256": "79abc1d221dd4822b58c7b6df93005513350c727ddc5164c58c8604e4141fc02",
      "en": "「Why you!\\nThis much won't bring me down!!」"
    },
    "98:454": {
      "repository_source_sha256": "1ca2be20081439f5821724800de011be6f0a374af757befd01c1619a84a93fc4",
      "en": "「Agh!\\nI-I won't go down to this!」"
    },
    "98:7049": {
      "repository_source_sha256": "b3c79d42e80d0ee4d3dd61325a35e5fcf85c74d8ec66ab18325dea3aadd448c0",
      "en": "「Awful woman! But for you, I'd still be with $$アムロ$$!」"
    },
    "98:5226": {
      "repository_source_sha256": "f4be48c2373d21e6c915ebc37b27c3d02425254e6ffc6b229a89b56055134661",
      "en": "「$$ロラン$$, fall back!」"
    },
    "98:4537": {
      "repository_source_sha256": "9738072f6dc27a7620b48bcb7dd07d6fada4bfbe907d8021c01b20ca6b272c14",
      "en": "「I'm using the $$月光蝶$$!」"
    },
    "98:4566": {
      "repository_source_sha256": "b71a1ac05880ac4232100b219f34ddf42589fcf9d1d55eb4d038099051e14194",
      "en": "「I'll swallow it all up!」"
    },
    "102:3430": {
      "repository_source_sha256": "267fbb3c1ac00955a054bb8e3355254d5d316b853377c0e6e8fec2048b82cd81",
      "en": "「If I just destroy the $$インプラント$$ round!」"
    },
    "102:3467": {
      "repository_source_sha256": "be0119ec831fcc7510f5e3a270fa7c0dea4efda53898af4d9c3cb639777efade",
      "en": "「I'll set your heart free right away!」"
    },
    "102:3502": {
      "repository_source_sha256": "1974aefa9237064590bd726edfb73fb85b1015c20de54d77f23dbfd1ca5db7b3",
      "en": "「Controlling even the $$バジュラ$$\\nwith $$インプラント$$s...!」"
    },
    "102:3551": {
      "repository_source_sha256": "73c5f5205f30bbcb1cbf46c575a975cc03a06464b9c43372ccb3257f0274bbd6",
      "en": "「$$ブレラ・スターン$$!\\nRecall your cause and warrior pride!」"
    },
    "102:3616": {
      "repository_source_sha256": "9101b6b5781ab5b3efd738d76f9bc58460527656193cb6ba6003b7da6cf9ab7a",
      "en": "「Your schemes end here!」"
    },
    "102:3647": {
      "repository_source_sha256": "cfab0fa3fbd416b8ba987748c13e3a1a74e979262be76f0a29801b73ef9cd350",
      "en": "「The galaxy isn't yours to toy with!」"
    },
    "102:3766": {
      "repository_source_sha256": "62eb9cb6961f96708d9e7cfeb9750b8a16fdfbf007136ea68f14d50cb59d64b2",
      "en": "「No brain and no organs, it seems...!」"
    },
    "102:3801": {
      "repository_source_sha256": "4fbdafe1a8b8633bdd8ad88826bfd671ba673fe0dcba28efeceff43043aeb66b",
      "en": "「Can our words really reach them...!」"
    },
    "102:3842": {
      "repository_source_sha256": "845a812fe5c3feea6465391fb68fa14f2292ba86ec97b3ec788fdf5c4221e92a",
      "en": "「So they really were beings\\nwe could communicate with...!」"
    },
    "102:4095": {
      "repository_source_sha256": "fbfc52b18a0bd941575b91c3a66a272443eacac5a4ef74364503d9a3271a44ae",
      "en": "「Supporting $$アンタレス$$ 1!」"
    },
    "102:4161": {
      "repository_source_sha256": "bc0e342b5ff46c2943611a13be3bb2463b4306c14af4650ac14ce504fc463440",
      "en": "「$$アンタレス$$ 1, you're too far ahead!」"
    },
    "105:1132": {
      "repository_source_sha256": "16db204f1499c64d5229de1fdb0d2b5a56fabe4f1c12d38052b10a3fcfaf7d70",
      "en": "「$$ミコノ・スズシロ$$.\\nYour power to connect...!」"
    },
    "105:2030": {
      "repository_source_sha256": "e327de15de2576b6df017b8e5dbbe5a6fc677a6b5ef73197df90360fbe535580",
      "en": "「I will put an end to your rule.」"
    },
    "105:2063": {
      "repository_source_sha256": "6c562b30dffb27bf9c237d03ff8902fca1a0fb499c6be7b78eef968d9235fb47",
      "en": "「Return this planet to its people.」"
    },
    "105:2102": {
      "repository_source_sha256": "dbed630398cbe74ae8d6758814ad3ed6dc966ded60ce2bd684c454114c64eb05",
      "en": "「$$スフィア$$... Seduced by cursed power...」"
    },
    "105:2145": {
      "repository_source_sha256": "eff1139cbf606b0b3782ff0159a913f517d64a99aa74f93f5eab6cb51de66b39",
      "en": "「Your despair...\\nAllow me to end it here.」"
    },
    "105:2200": {
      "repository_source_sha256": "1a0d87f2de8321a46a7e700129b0e5ce8ee01cef3d406fe373040a9896a55c55",
      "en": "「This world's future\\nwe'll forge with our own hands.」"
    },
    "105:2251": {
      "repository_source_sha256": "379ced578fee7c990c928bee313bbafb88a0985d1215ec410a70dd04d7ec243d",
      "en": "「Allow me to show you\\nthe human power you feared...!」"
    },
    "105:2687": {
      "repository_source_sha256": "3c7a6c05fd44672fde6f54e630750b86a86dae84fca01029db5974f1f41d8ca8",
      "en": "「Supporting the $$神話型アクエリオン$$.」"
    },
    "105:5667": {
      "repository_source_sha256": "3fa57324d5af59335caf6c60ea1824c844d60416f127f7ce1bbaa6ad5ccef440",
      "en": "「This is what $$不動$$ sought: to cross time and write a myth together...!」"
    },
    "105:2788": {
      "repository_source_sha256": "692712658813f59e2a70e5806ed64cbdba63c7c2e262e77091a170b549496e7e",
      "en": "「I'll guard the $$神話型アクエリオン$$.」"
    }
  },

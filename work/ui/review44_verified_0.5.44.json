  "dialogue": [
    {
      "id": "598:t_1:3",
      "english": "　\n　\n　　　～ Cheyenne Base Underground　Colony Laser Control Room ～"
    },
    {
      "id": "598:t_1:8",
      "english": "Martha\n「They were merely a scouting force... Our real weapon is\n　the Colony Laser the Space Revolutionary Army prepared\n　during the Multiverse War...」"
    },
    {
      "id": "598:t_1:12",
      "english": "Ronan\n「If they become embroiled in battle, all the better. We'll\n　dispose of the Box and the troublemakers together with\n　the Colony Laser.」"
    },
    {
      "id": "598:t_1:45",
      "english": "Alberto\n「You'll operate the Colony Laser from Earth and wipe out\n　$c and Neo Zeon at once...! If you do that,\n　humanity's future will...」"
    },
    {
      "id": "598:t_1:51",
      "english": "Martha\n「The Colony Laser the Space Revolutionary Army built\n　during the Multiverse War...」"
    },
    {
      "id": "598:t_1:55",
      "english": "Ronan\n「If they become embroiled in battle, all the better. We'll\n　dispose of the Box and the troublemakers together with\n　the Colony Laser.」"
    },
    {
      "id": "604:t_1:53",
      "english": "　\n　\n　　　～Cheyenne Base Underground　Colony Laser Control Room～"
    },
    {
      "id": "604:t_1:55",
      "english": "Ronan\n「The Colony Laser is ready to fire. All that remains is to\n　authorize it.」"
    },
    {
      "id": "604:t_1:64",
      "english": "Ronan\n「Then I authorize the firing of the Colony Laser.」"
    },
    {
      "id": "604:t_1:68",
      "english": "Martha\n「Whatever you say, it's no use, Alberto. The Colony Laser\n　has been authorized to fire... We can no longer stop it.」"
    },
    {
      "id": "604:t_7:3",
      "english": "　\n　\n　　　～Cheyenne Base Underground　Colony Laser Control Room～"
    },
    {
      "id": "605:t_008:6",
      "english": "Ambriel\n「It's a Colony Laser.」"
    },
    {
      "id": "605:t_009:3",
      "english": "Liam\n「You're going to block the Colony Laser?!」"
    }
  ],
